sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s3);
sampler2D PuddleMaskSampler : register(s2);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c202);
float bumpiness : register(c198);
float fresnelRolloff : register(c200);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
float4 gWaterGlobals : register(c64);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float reflectivePower : register(c199);
float specularColorFactor : register(c197);
float specularFactor : register(c196);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float2 texcoord6 : TEXCOORD6;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color2 : COLOR2;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	float2 r5;
	r0.x = saturate(-1 + i.color.x);
	r0.y = saturate(gWaterGlobals.y);
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2.xyz = r1.xyz * WetDarken.xyz + -r1.xyz;
	r0.yzw = r0.yyy * r2.xyz + r1.xyz;
	r2.xy = WetDarken.ww * i.texcoord6.xy;
	r2 = tex2D(PuddleMaskSampler, r2.xy);
	r2.x = r2.x + gWaterGlobals.y;
	r2.x = saturate(r2.x + -i.color.y);
	r2.yzw = r1.xyz * WetDarken.xyz;
	r0.yzw = (-r2.xxx >= 0) ? r0.yzw : r2.yzw;
	r0.yzw = (-i.color.yyy >= 0) ? r1.xyz : r0.yzw;
	r1.x = r1.w * i.color.w;
	r1.x = r1.x * globalScalars.x;
	o.color.xyz = r0.xxx * globalScalars2.zzz + r0.yzw;
	r0.xy = 0.3 * i.texcoord6.xy;
	r0 = tex2D(WaterRainRippleNormalSampler, r0.xy);
	r0.xyz = r0.xyz * 2 + -1;
	r3 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r3.w + 1;
	r0.w = -r3.x + r0.w;
	r1.yz = (r0.ww >= 0) ? r3.wy : r3.xy;
	r1.yz = r1.yz * 2 + -1;
	r3.xy = r1.yz * bumpiness.xx;
	r0.w = dot(r3.xy, -r3.xy) + 1;
	r1.y = max(r0.w, 0);
	r0.w = rsqrt(r1.y);
	r3.z = 1 / r0.w;
	r0.xyz = r0.xyz * i.texcoord1.zzz + -r3.xyz;
	r0.xyz = r2.xxx * r0.xyz + r3.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r4 = normalize(r0.xyz);
	r0.xyz = (-r2.xxx >= 0) ? r3.xyz : r4.xyz;
	r0.xyz = (-i.color.yyy >= 0) ? r3.xyz : r0.xyz;
	r1.yzw = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r1.yzw;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r3.xyz = normalize(r0.xyz);
	o.color1.xyz = r3.xyz * 0.5 + 0.5;
	r0.z = gWaterGlobals.z;
	r4.x = lerp(specularColorFactor.x, r0.z, r2.x);
	r0.x = 1;
	r5.y = max(r0.x, specularFactor.x);
	r4.y = lerp(r5.y, gWaterGlobals.w, r2.x);
	r5.x = specularColorFactor.x;
	r0.yz = (-r2.xx >= 0) ? r5.xy : r4.xy;
	r0.yz = (-i.color.yy >= 0) ? r5.xy : r0.yz;
	r0.z = saturate(r0.z * 0.0051020407);
	o.color2.x = r0.y;
	r0.y = rsqrt(r0.z);
	r0.y = 1 / r0.y;
	r0.y = rsqrt(r0.y);
	o.color2.y = 1 / r0.y;
	o.color2.z = gAmbientOcclusionEffect.w * i.color.x;
	r0.yzw = 1E-05 + i.texcoord3.xyz;
	r2.xyz = normalize(r0.yzw);
	r0.y = dot(-r2.xyz, r3.xyz);
	r0.y = r0.y + r0.y;
	r0.yzw = r3.xyz * -r0.yyy + -r2.xyz;
	r1.y = saturate(dot(r2.xyz, r3.xyz));
	r1.y = -r1.y + 1.00001;
	r0.yzw = r0.yzw + 1E-05;
	r0.z = dot(r0.yzw, r0.yzw);
	r0.z = rsqrt(r0.z);
	r0.yz = r0.yw * r0.zz + 1;
	r0.yz = r0.yz * -0.5;
	r2 = tex2D(EnvironmentSampler, r0.yz);
	r0.y = r1.y * r1.y;
	r0.y = r0.y * r0.y;
	r0.y = r0.y * r1.y;
	r0.x = r0.x + -fresnelRolloff.x;
	r0.x = fresnelRolloff.x * r0.y + r0.x;
	r0.xyz = r0.xxx * r2.xyz;
	r0.xyz = r0.xyz * reflectivePower.xxx;
	r0.xyz = r0.xyz * globalScalars.www;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.color3.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.color3.z = 1 / r0.y;
	o.color3.y = 1 / r0.x;
	o.color.w = r1.x;
	o.color1.w = r1.x;
	o.color2.w = r1.x;
	o.color3.w = gStencil.x;

	return o;
}
