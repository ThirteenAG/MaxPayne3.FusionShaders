float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.w = r0.w * i.color.w;
	r0.xyz = r0.xyz * r0.xyz;
	o.w = r0.w * globalScalars.x;
	r1.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r1.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r1.xyz;
	r1.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r1.xyz;
	r1.xyz = r1.xyz + gShadowMatrix[3].xyz;
	r2.xy = r1.xy + -gShadowParam18192021.zw;
	r2.zw = r2.xx + -gCascadeXMaxThresholds.xy;
	r2.zw = (r2.zw >= 0) ? 1 : 0;
	r3.xy = -r2.xx + gCascadeXMinThresholds.xy;
	r3.xy = (r3.xy >= 0) ? 1 : 0;
	r2.zw = r2.zw + r3.xy;
	r3.xy = r2.yy + -gCascadeYMaxThresholds.xy;
	r3.xy = (r3.xy >= 0) ? 1 : 0;
	r2.zw = r2.zw + r3.xy;
	r3.xy = -r2.yy + gCascadeYMinThresholds.xy;
	r3.xy = (r3.xy >= 0) ? 1 : 0;
	r3.yz = saturate(r2.zw + r3.xy);
	r3.x = 1;
	r4.x = dot(r3.xyz, gShadowParam0123.xyz);
	r4.y = dot(r3.xyz, gShadowParam4567.xyz);
	r4.z = dot(r3.xyz, gCascadeZScales.xyz);
	r5.x = dot(r3.xyz, gShadowParam891113.xyz);
	r5.y = dot(r3.xyz, gShadowParam14151617.xyz);
	r5.z = dot(r3.xyz, gCascadeZOffsets.xyz);
	r1.xyz = r1.zxy * r4.zxy + r5.zxy;
	r1.x = saturate(r1.x);
	r3 = tex2D(gShadowZSamplerDir, r1.yz);
	r0.w = -r1.x + 1;
	r0.w = -r3.x + r0.w;
	r0.w = (r0.w >= 0) ? -1 : -0;
	r1.x = -gCascadeXMinThresholds.w;
	r1.y = -gCascadeXMaxThresholds.w;
	r1.xy = saturate(abs(r2.xy) * 4 + r1.xy);
	r2.x = max(r1.x, r1.y);
	r0.w = r0.w + r2.x;
	r0.w = saturate(r0.w + 1);
	r1.xyz = r0.www * gDirectionalColour.xyz;
	r2.xyz = 1E-05 + i.texcoord1.xyz;
	r3.xyz = normalize(r2.xyz);
	r0.w = dot(r3.xyz, -gDirectionalLight.xyz);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r1.xyz = r0.www * r1.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r2.yz = float2(0.15, 1);
	r1.w = saturate(AmbientLightingParams.x * -r2.y + r2.z);
	r1.w = saturate(r1.w + 0.2);
	r1.w = r1.w * AmbientLightingParams.y;
	r1.w = i.color.x * r1.w + -i.color.x;
	r1.w = gAmbientOcclusionEffect.x * r1.w + i.color.x;
	r4.xyz = gLightAmbient0.xyz;
	r2.xyw = -r4.xyz + gLightAmbient1.xyz;
	r3.w = saturate(r3.z * -0.5 + 0.5);
	r2.xyw = r3.www * r2.xyw + gLightAmbient0.xyz;
	r2.xyw = r2.xyw * gAmbientOcclusionEffect.yyy;
	r2.xyw = r1.www * r2.xyw;
	r1.xyz = r2.xyw * r0.www + r1.xyz;
	r4 = gLightPosX + -i.texcoord6.x;
	r5 = r4 * r4;
	r6 = gLightPosY + -i.texcoord6.y;
	r5 = r6 * r6 + r5;
	r7 = gLightPosZ + -i.texcoord6.z;
	r5 = r7 * r7 + r5;
	r8 = r5 * -gLightFallOff + r2.z;
	r5 = r5 + 1E-05;
	r9 = max(r8, 0);
	r8 = r9 * r9;
	r8 = r8 * r8 + -0.1;
	r9 = r8 * 1.1111112;
	r8 = (r8 >= 0) ? r9 : 0;
	r9 = r3.x * r4;
	r4 = r4 * -gLightDirX;
	r4 = r6 * -gLightDirY + r4;
	r6 = r6 * r3.y + r9;
	r6 = r7 * r3.z + r6;
	r4 = r7 * -gLightDirZ + r4;
	r6 = r8 * r6;
	r7.x = rsqrt(r5.x);
	r7.y = rsqrt(r5.y);
	r7.z = rsqrt(r5.z);
	r7.w = rsqrt(r5.w);
	r5 = saturate(r6 * r7);
	r4 = r4 * r7;
	r6 = gLightConeScale;
	r4 = saturate(r4 * r6 + gLightConeOffset);
	r4 = r5 * r4;
	r5.x = dot(gLightColR, r4);
	r5.y = dot(gLightColG, r4);
	r5.z = dot(gLightColB, r4);
	r1.xyz = r1.xyz + r5.xyz;
	r4 = gLightPointPosX + -i.texcoord6.x;
	r5 = r3.x * r4;
	r6 = gLightPointPosY + -i.texcoord6.y;
	r5 = r6 * r3.y + r5;
	r7 = gLightPointPosZ + -i.texcoord6.z;
	r3 = r7 * r3.z + r5;
	r5 = r4 * r4;
	r4 = r4 * -gLightDir2X;
	r4 = r6 * -gLightDir2Y + r4;
	r5 = r6 * r6 + r5;
	r5 = r7 * r7 + r5;
	r4 = r7 * -gLightDir2Z + r4;
	r2 = r5 * -gLightPointFallOff + r2.z;
	r5 = r5 + 1E-05;
	r6 = max(r2, 0);
	r2 = r6 * r6;
	r2 = r2 * r2 + -0.1;
	r6 = r2 * 1.1111112;
	r2 = (r2 >= 0) ? r6 : 0;
	r2 = r2 * r3;
	r3.x = rsqrt(r5.x);
	r3.y = rsqrt(r5.y);
	r3.z = rsqrt(r5.z);
	r3.w = rsqrt(r5.w);
	r2 = saturate(r2 * r3);
	r3 = r3 * r4;
	r4 = gLightConeScale2;
	r3 = saturate(r3 * r4 + gLightConeOffset2);
	r2 = r2 * r3;
	r3.x = dot(gLightPointColR, r2);
	r3.y = dot(gLightPointColG, r2);
	r3.z = dot(gLightPointColB, r2);
	r1.xyz = r1.xyz + r3.xyz;
	r0.xyz = r0.xyz * r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	r0.xyz = saturate(r2.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;

	return o;
}
