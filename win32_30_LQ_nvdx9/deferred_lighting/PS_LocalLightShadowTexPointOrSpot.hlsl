sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
row_major float4x4 dShadowMatrix : register(c197);
float4 dShadowParam0123 : register(c196);
float gDeferredLightConeAngle : register(c211);
float gDeferredLightConeOffset : register(c212);
float3 gDeferredLightDirection : register(c204);
sampler2D gDeferredLightSampler : register(s0);
float3 gDeferredLightTangent : register(c205);
float gDeferredLightType : register(c202);
float4 gDeferredProjParams : register(c216);
sampler2D gShadowZSamplerCache : register(s14);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float2 vpos : VPOS;
	float4 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r1.xyz = r1.wxy * 255 + 0.5;
	r2.xyz = frac(r1.xyz);
	r1.xyz = r1.xyz + -r2.xyz;
	r0.z = dot(r1.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r0.z = r0.z * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2.xyz = i.texcoord.xyz * -r0.zzz + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r2 = tex2D(GBufferTextureSampler1, r0.xy);
	r2.xyz = r2.xyz * 2 + -1;
	r4.xyz = normalize(r2.xyz);
	r2.xyz = r4.xyz * 0.1 + r1.xyz;
	r5.xyz = r2.yyy * dShadowMatrix[1].xyz;
	r2.xyw = r2.xxx * dShadowMatrix[0].xyz + r5.xyz;
	r2.xyz = r2.zzz * dShadowMatrix[2].xyz + r2.xyw;
	r2.xyz = r2.xyz + dShadowMatrix[3].xyz;
	r2.w = -abs(r2.z);
	r0.z = dot(r2.xyw, r2.xyw);
	r0.z = rsqrt(r0.z);
	r0.z = 1 / r0.z;
	r0.w = abs(r2.z) + r0.z;
	r0.z = r0.z * -dShadowParam0123.w;
	r0.w = 1 / r0.w;
	r2.xy = r0.ww * r2.xy;
	r2.zw = (-r2.zz >= 0) ? float2(1, 0) : float2(0, 1);
	r2.xy = r2.xy * float2(0.5, -0.5) + 0.5;
	r5 = tex2D(gShadowZSamplerCache, r2.xy);
	r0.z = dot(r5.xy, r2.zw) + -r0.z;
	r0.w = 1;
	r0.w = r0.w + -dShadowParam0123.z;
	r0.w = r0.w * 0.33333334;
	r0.z = (r0.z >= 0) ? 0 : r0.w;
	r0.z = r0.z + dShadowParam0123.z;
	r2.xyz = -r1.xyz + i.texcoord2.xyz;
	r1.xyz = r1.xyz + -i.texcoord2.xyz;
	r0.w = dot(r2.xyz, r2.xyz);
	r2.xyz = r2.xyz + 1E-05;
	r5.xyz = normalize(r2.xyz);
	r0.w = saturate(r0.w * -i.texcoord1.y + 1);
	r0.w = r0.w + 1E-05;
	r1.w = pow(r0.w, 4.00001);
	r0.w = r1.w + -0.1;
	r1.w = r0.w * 1.1111112;
	r2.xyz = r1.www * i.texcoord4.xyz;
	r1.w = dot(r5.xyz, i.texcoord3.xyz);
	r1.w = saturate(r1.w * i.texcoord1.w + i.texcoord1.z);
	r2.xyz = r1.www * r2.xyz;
	r2.xyz = r0.zzz * r2.xyz;
	r2.xyz = (r0.www >= 0) ? r2.xyz : 0;
	r0.z = dot(r3.xyz, r4.xyz);
	r0.z = r0.z + r0.z;
	r3.xyz = r4.xyz * -r0.zzz + r3.xyz;
	r0.z = saturate(dot(r5.xyz, r4.xyz));
	r0.w = saturate(dot(r5.xyz, r3.xyz));
	r0.w = r0.w + 1E-05;
	r3 = tex2D(GBufferTextureSampler2, r0.xy);
	r4 = tex2D(GBufferTextureSampler0, r0.xy);
	r4.xyz = r4.xyz * r4.xyz;
	r0.x = r3.y * r3.y;
	r0.x = r0.x * r0.x;
	r0.x = r0.x * 196 + 1E-05;
	r1.w = pow(r0.w, r0.x);
	r0.x = saturate(r0.z * 2 + -0.5);
	r0.yzw = r0.zzz * r2.xyz;
	r0.x = r0.x * r1.w;
	r2.xyz = r0.xxx * r2.xyz;
	r2.xyz = r3.xxx * r2.xyz;
	r0.x = dot(r1.xyz, r1.xyz);
	r0.x = rsqrt(r0.x);
	r1.w = dot(-gDeferredLightDirection.xyz, r1.xyz);
	r2.w = r1.w * -r0.x + 1;
	r0.x = 1 / r0.x;
	r0.x = r2.w * r0.x;
	r0.x = 1 / r0.x;
	r3.xyz = gDeferredLightDirection.xyz;
	r5.xyz = -r3.zxy * gDeferredLightTangent.yzx;
	r3.xyz = -r3.yzx * gDeferredLightTangent.zxy + -r5.xyz;
	r3.x = dot(r3.xyz, r1.xyz);
	r3.y = dot(gDeferredLightTangent.xyz, r1.xyz);
	r1.xy = r0.xx * r3.xy;
	r0.x = abs(gDeferredLightConeOffset.x);
	r0.x = r0.x + 60;
	r0.x = 1 / r0.x;
	r0.x = r0.x * gDeferredLightConeAngle.x;
	r0.x = r0.x * 120;
	r0.x = r0.x * r0.x;
	r0.x = r1.w * r0.x;
	r0.x = 1 / r0.x;
	r1.zw = -r0.xx * r3.xy;
	r2.w = -2;
	r0.x = r2.w + gDeferredLightType.x;
	r1.xy = (-abs(r0.xx) >= 0) ? r1.zw : r1.xy;
	r1.xy = r1.xy * 0.5 + 0.5;
	r1.zw = 0;
	r1 = tex2Dlod(gDeferredLightSampler, r1);
	r1.xyz = r1.xyz * r4.xyz;
	o.xyz = r1.xyz * r0.yzw + r2.xyz;
	o.w = 1;

	return o;
}
