sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSamplerDepth : register(s10);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDeferredLightColourAndIntensity : register(c214);
float4 gDeferredLightRadiusProjShearParams : register(c206);
sampler2D gDeferredLightSampler : register(s0);
sampler2D gDeferredLightSampler1 : register(s1);
float4 gDeferredLightVolumeParams : register(c218);
float4 gDeferredProjParams : register(c216);
float4 gDirectionalLight : register(c19);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float3 r6;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r0 = tex2D(GBufferTextureSampler0, r0.xy);
	r0.xyz = r0.xyz * r0.xyz;
	r1.xyz = r1.wxy * 255 + 0.5;
	r2.xyz = frac(r1.xyz);
	r1.xyz = r1.xyz + -r2.xyz;
	r0.w = dot(r1.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r0.w = r0.w * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.w = r0.w * i.texcoord.w;
	r0.w = 1 / r0.w;
	r1.xyz = i.texcoord.xyz * -r0.www + gViewInverse[3].xyz;
	r2 = -r1.z + gDeferredLightVolumeParams.x;
	r3 = r2;
	clip(r3);
	r2.xyz = r1.yyy * gShadowMatrix[1].xyz;
	r2.xyz = r1.xxx * gShadowMatrix[0].xyz + r2.xyz;
	r2.xyz = r1.zzz * gShadowMatrix[2].xyz + r2.xyz;
	r1.xy = gDirectionalLight.xy * r1.zz + r1.xy;
	r1.xy = r1.xy * gDeferredLightVolumeParams.ww;
	r1.xy = frac(r1.xy);
	r2.xyz = r2.xyz + gShadowMatrix[3].xyz;
	r3.xy = r2.xy + -gShadowParam18192021.zw;
	r4.xy = r3.xx + -gCascadeXMaxThresholds.xy;
	r4.zw = -r3.xx + gCascadeXMinThresholds.xy;
	r4 = (r4 >= 0) ? 1 : 0;
	r4.xy = r4.zw + r4.xy;
	r4.zw = r3.yy + -gCascadeYMaxThresholds.xy;
	r4.zw = (r4.zw >= 0) ? 1 : 0;
	r4.xy = r4.zw + r4.xy;
	r4.zw = -r3.yy + gCascadeYMinThresholds.xy;
	r4.zw = (r4.zw >= 0) ? 1 : 0;
	r4.yz = saturate(r4.zw + r4.xy);
	r4.x = 1;
	r5.x = dot(r4.xyz, gShadowParam0123.xyz);
	r5.y = dot(r4.xyz, gShadowParam4567.xyz);
	r5.z = dot(r4.xyz, gCascadeZScales.xyz);
	r6.x = dot(r4.xyz, gShadowParam891113.xyz);
	r6.y = dot(r4.xyz, gShadowParam14151617.xyz);
	r6.z = dot(r4.xyz, gCascadeZOffsets.xyz);
	r2.xyz = r2.zxy * r5.zxy + r6.zxy;
	r4 = tex2D(gShadowZSamplerDir, r2.yz);
	r2.x = saturate(r2.x);
	r0.w = -r2.x + 1;
	r2.xyz = r4.wxy * 255 + 0.5;
	r4.xyz = frac(r2.xyz);
	r2.xyz = r2.xyz + -r4.xyz;
	r2.x = dot(r2.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r0.w = -r0.w + r2.x;
	r0.w = (r0.w >= 0) ? 0 : 0.33333334;
	r2.x = -gCascadeXMinThresholds.w;
	r2.y = -gCascadeXMaxThresholds.w;
	r2.xy = saturate(abs(r3.xy) * 4 + r2.xy);
	r3.x = max(r2.x, r2.y);
	r0.w = r0.w + r3.x;
	r0.w = r0.w + -0.4;
	r0.w = saturate(r0.w * 1.6666666);
	r2.x = r0.w * -2 + 3;
	r0.w = r0.w * r0.w;
	r0.w = r0.w * r2.x;
	r2.x = saturate(r3.w * gDeferredLightVolumeParams.z);
	r2.y = -r2.w * gDeferredLightVolumeParams.y;
	r2.y = r2.y * 1.442695;
	r2.y = exp2(r2.y);
	r3.x = min(r2.y, 65504);
	r1.w = r2.x * 4;
	r1.z = 0;
	r2 = tex2Dbias(gDeferredLightSampler, r1);
	r1 = tex2Dbias(gDeferredLightSampler1, r1);
	r3.yzw = lerp(r2.xyz, r1.xyz, gDeferredLightRadiusProjShearParams.xxx);
	r1.xyz = r3.yzw * gDeferredLightColourAndIntensity.xyz;
	r1.xyz = r1.xyz * gDeferredLightColourAndIntensity.www;
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = r3.xxx * r1.xyz;
	o.xyz = r0.xyz * r1.xyz;
	o.w = 1;

	return o;
}
