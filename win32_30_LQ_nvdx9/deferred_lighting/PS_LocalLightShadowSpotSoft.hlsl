sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
float4 gDeferredProjParams : register(c216);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float2 vpos : VPOS;
	float4 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r1.xyz = r1.wxy * 255 + 0.5;
	r2.xyz = frac(r1.xyz);
	r1.xyz = r1.xyz + -r2.xyz;
	r0.z = dot(r1.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r0.z = r0.z * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2.xyz = i.texcoord.xyz * -r0.zzz + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r2 = r1.y * gShadowMatrix[1];
	r2 = r1.x * gShadowMatrix[0] + r2;
	r2 = r1.z * gShadowMatrix[2] + r2;
	r1.xyz = -r1.xyz + i.texcoord2.xyz;
	r2 = r2 + gShadowMatrix[3];
	r0.z = 1 / r2.w;
	r2.xy = r2.xy * r0.zz + 1;
	r0.z = r2.z * r0.z + -gShadowParam0123.x;
	r2.x = r2.x * 0.5;
	r2.z = r2.y * -0.5 + 1;
	r2 = tex2D(gShadowZSamplerDir, r2.xz);
	r2.xyz = r2.wxy * 255 + 0.5;
	r4.xyz = frac(r2.xyz);
	r2.xyz = r2.xyz + -r4.xyz;
	r0.w = dot(r2.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r0.z = -r0.z + r0.w;
	r0.w = 1;
	r0.z = (r0.z >= 0) ? r0.w : gShadowParam0123.y;
	r0.w = dot(r1.xyz, r1.xyz);
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r0.w = saturate(r0.w * -i.texcoord1.y + 1);
	r0.w = r0.w + 1E-05;
	r1.x = pow(r0.w, 4.00001);
	r0.w = r1.x + -0.1;
	r1.x = r0.w * 1.1111112;
	r1.xyz = r1.xxx * i.texcoord4.xyz;
	r1.w = dot(r2.xyz, i.texcoord3.xyz);
	r1.w = saturate(r1.w * i.texcoord1.w + i.texcoord1.z);
	r1.xyz = r1.www * r1.xyz;
	r1.xyz = r0.zzz * r1.xyz;
	r1.xyz = (r0.www >= 0) ? r1.xyz : 0;
	r4 = tex2D(GBufferTextureSampler1, r0.xy);
	r4.xyz = r4.xyz * 2 + -1;
	r5 = normalize(r4.xyz);
	r0.z = dot(r3.xyz, r5.xyz);
	r0.z = r0.z + r0.z;
	r3.xyz = r5.xyz * -r0.zzz + r3.xyz;
	r0.z = saturate(dot(r2.xyz, r5.xyz));
	r0.w = saturate(dot(r2.xyz, r3.xyz));
	r0.w = r0.w + 1E-05;
	r2 = tex2D(GBufferTextureSampler2, r0.xy);
	r3 = tex2D(GBufferTextureSampler0, r0.xy);
	r3.xyz = r3.xyz * r3.xyz;
	r0.x = r2.y * r2.y;
	r0.x = r0.x * r0.x;
	r0.x = r0.x * 196 + 1E-05;
	r1.w = pow(r0.w, r0.x);
	r0.x = saturate(r0.z * 2 + -0.5);
	r0 = r0.xzzz * r1.wxyz;
	r1.xyz = r0.xxx * r1.xyz;
	r1.xyz = r1.xyz * r2.xxx;
	o.xyz = r3.xyz * r0.yzw + r1.xyz;
	o.w = 1;

	return o;
}
