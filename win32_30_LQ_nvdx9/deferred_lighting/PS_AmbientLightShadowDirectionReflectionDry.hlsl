sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
sampler2D gDeferredLightSampler0P : register(s3);
float4 gDeferredProjParams : register(c216);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightAmbientDir0 : register(c72);
float4 gLightAmbientDir1 : register(c73);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);

struct PS_IN
{
	float4 texcoord1 : TEXCOORD1;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float3 r3;
	float3 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r1.xyz = r1.wxy * 255 + 0.5;
	r2.xyz = frac(r1.xyz);
	r1.xyz = r1.xyz + -r2.xyz;
	r0.z = dot(r1.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r0.z = r0.z * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord1.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord1.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2.xyz = i.texcoord1.xyz * -r0.zzz + 1E-05;
	r3 = normalize(r2.xyz);
	r2.xyz = r1.yyy * gShadowMatrix[1].xyz;
	r1.xyw = r1.xxx * gShadowMatrix[0].xyz + r2.xyz;
	r1.xyz = r1.zzz * gShadowMatrix[2].xyz + r1.xyw;
	r1.xyz = r1.xyz + gShadowMatrix[3].xyz;
	r0.zw = r1.xy + -gShadowParam18192021.zw;
	r2.xy = r0.zz + -gCascadeXMaxThresholds.xy;
	r2.zw = -r0.zz + gCascadeXMinThresholds.xy;
	r2 = (r2 >= 0) ? 1 : 0;
	r2.xy = r2.zw + r2.xy;
	r2.zw = r0.ww + -gCascadeYMaxThresholds.xy;
	r2.zw = (r2.zw >= 0) ? 1 : 0;
	r2.xy = r2.zw + r2.xy;
	r2.zw = -r0.ww + gCascadeYMinThresholds.xy;
	r2.zw = (r2.zw >= 0) ? 1 : 0;
	r2.yz = saturate(r2.zw + r2.xy);
	r2.x = 1;
	r4.x = dot(r2.xyz, gShadowParam0123.xyz);
	r4.y = dot(r2.xyz, gShadowParam4567.xyz);
	r4.z = dot(r2.xyz, gCascadeZScales.xyz);
	r5.x = dot(r2.xyz, gShadowParam891113.xyz);
	r5.y = dot(r2.xyz, gShadowParam14151617.xyz);
	r5.z = dot(r2.xyz, gCascadeZOffsets.xyz);
	r1.xyz = r1.zxy * r4.zxy + r5.zxy;
	r2 = tex2D(gShadowZSamplerDir, r1.yz);
	r1.x = saturate(r1.x);
	r1.x = -r1.x + 1;
	r1.yzw = r2.wxy * 255 + 0.5;
	r2.xyz = frac(r1.yzw);
	r1.yzw = r1.yzw + -r2.xyz;
	r1.y = dot(r1.yzw, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r1.x = -r1.x + r1.y;
	r1.x = (r1.x >= 0) ? 0 : 0.33333334;
	r2.x = -gCascadeXMinThresholds.w;
	r2.y = -gCascadeXMaxThresholds.w;
	r0.zw = saturate(abs(r0.zw) * 4 + r2.xy);
	r1.y = max(r0.z, r0.w);
	r0.z = r1.y + r1.x;
	r0.z = r0.z + -0.4;
	r0.z = saturate(r0.z * 1.6666666);
	r0.w = r0.z * -2 + 3;
	r0.z = r0.z * r0.z;
	r0.z = r0.z * r0.w;
	r1.xyz = r0.zzz * gDirectionalColour.xyz;
	r2 = tex2D(GBufferTextureSampler1, r0.xy);
	r2.xyz = r2.xyz * 2 + -1;
	r4 = normalize(r2.xyz);
	r0.z = dot(r4.xyz, -gDirectionalLight.xyz);
	r0.w = saturate(r0.z + -0.25);
	r0.z = saturate(r0.z * 2 + -0.5);
	r0.w = r0.w * 1.3333334;
	r2.xyz = r0.www * r1.xyz;
	r0.w = dot(gLightAmbientDir1.xyz, r4.xyz);
	r0.w = saturate(r0.w + gLightAmbientDir0.w);
	r5.xyz = r0.www * gLightAmbient1.xyz;
	r0.w = dot(gLightAmbientDir0.xyz, r4.xyz);
	r0.w = saturate(r0.w + gLightAmbientDir0.w);
	r5.xyz = r0.www * gLightAmbient0.xyz + r5.xyz;
	r6 = tex2D(GBufferTextureSampler2, r0.xy);
	r5.xyz = r5.xyz * r6.zzz;
	r0.w = rsqrt(r6.z);
	r0.w = 1 / r0.w;
	r2.xyz = r2.xyz * r0.www + r5.xyz;
	r0.w = dot(r2.xyz, 0.33333334);
	r0.w = r0.w + 0.015;
	r5 = tex2D(gDeferredLightSampler0P, r0.xy);
	r7 = tex2D(GBufferTextureSampler0, r0.xy);
	r7.xyz = r7.xyz * r7.xyz;
	r5.xyz = r5.xyz * r5.xyz;
	r5.xyz = r5.xyz * 16;
	r0.xyw = r0.www * r5.xyz;
	r1.w = dot(r3.xyz, r4.xyz);
	r1.w = r1.w + r1.w;
	r3 = r4.xyz * -r1.www + r3.xyz;
	r1.w = saturate(dot(-gDirectionalLight.xyz, r3.xyz));
	r1.w = r1.w + 1E-05;
	r2.w = r6.y * r6.y;
	r2.w = r2.w * r2.w;
	r2.w = r2.w * 196 + 1E-05;
	r3.x = pow(r1.w, r2.w);
	r0.z = r0.z * r3.x;
	r1.xyz = r0.zzz * r1.xyz;
	r0.xyz = r1.xyz * r6.xxx + r0.xyw;
	o.xyz = r7.xyz * r2.xyz + r0.xyz;
	o.w = 1;

	return o;
}
