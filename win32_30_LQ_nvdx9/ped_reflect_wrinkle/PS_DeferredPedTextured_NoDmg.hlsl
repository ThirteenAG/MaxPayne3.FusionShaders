sampler2D BumpSampler : register(s5);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s1);
sampler2D SpecSampler : register(s6);
sampler3D VolumeSampler : register(s7);
sampler2D WrinkleMaskSampler_0 : register(s8);
sampler2D WrinkleMaskSampler_1 : register(s9);
sampler2D WrinkleSampler_A : register(s10);
sampler2D WrinkleSampler_B : register(s11);
float bumpiness : register(c200);
float4 detailSettings : register(c207);
float fresnelRolloff : register(c199);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float reflectivePower : register(c197);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c198);
float specularFactor : register(c202);
float4 wrinkleMaskStrengths0 : register(c210);
float4 wrinkleMaskStrengths1 : register(c211);
float4 wrinkleMaskStrengths2 : register(c212);
float4 wrinkleMaskStrengths3 : register(c213);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color2 : COLOR2;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float4 r6;
	r0 = tex2D(SpecSampler, i.texcoord.xy);
	r1.x = r0.z * 16;
	r1.y = frac(r1.x);
	r1.x = r1.x + -r1.y;
	r1.y = (-r1.y >= 0) ? 0 : 1;
	r1.y = (r0.z >= 0) ? 0 : r1.y;
	r1.x = r1.y + r1.x;
	r1.x = r1.x + 0.5;
	r1.z = r1.x * 0.0625;
	r1.xy = detailSettings.zw * i.texcoord.xy;
	r1 = tex3D(VolumeSampler, r1.xyz);
	r1.xyz = r1.yzx * 2 + -1;
	r1.w = detailSettings.x * i.texcoord2.w;
	r1.z = r1.z * r1.w + 1;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2.xyz = r2.xyz * matMaterialColorScale.xxx;
	r1.w = r2.w * i.texcoord2.w;
	r1.w = r1.w * globalScalars.x;
	o.color.xyz = r1.zzz * r2.xyz;
	r2 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r2.z = -r2.w + 1;
	r2.z = -r2.x + r2.z;
	r2.xy = (r2.zz >= 0) ? r2.wy : r2.xy;
	r3 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r2.z = -r3.w + 1;
	r2.z = -r3.x + r2.z;
	r2.zw = (r2.zz >= 0) ? r3.wy : r3.xy;
	r2 = r2 + -0.5;
	r3 = tex2D(BumpSampler, i.texcoord.xy);
	r3.z = -r3.w + 1;
	r3.z = -r3.x + r3.z;
	r3.xy = (r3.zz >= 0) ? r3.wy : r3.xy;
	r3.zw = r3.xy + -0.5;
	r3.xy = r3.xy * 2 + -1;
	r3 = r3 * bumpiness.x;
	r3.zw = r3.zw + r3.zw;
	r2.zw = r2.zw * 2 + -r3.zw;
	r4 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r5.x = dot(wrinkleMaskStrengths0, r4);
	r4.x = dot(wrinkleMaskStrengths2, r4);
	r6 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r4.y = dot(wrinkleMaskStrengths1, r6);
	r4.z = dot(wrinkleMaskStrengths3, r6);
	r4.x = r4.z + r4.x;
	r4.y = r4.y + r5.x;
	r2.zw = r4.yy * r2.zw + r3.zw;
	r2.xy = r2.xy * 2 + -r2.zw;
	r2.xy = r4.xx * r2.xy + r2.zw;
	r2.w = dot(r2.xy, -r2.xy) + 1;
	r3.z = max(r2.w, 0);
	r2.w = rsqrt(r3.z);
	r2.z = 1 / r2.w;
	r2.xyz = r2.xyz + 1E-05;
	r4.xyz = normalize(r2.xyz);
	r2.xyz = r4.xxx * i.texcoord4.xyz;
	r2.xyz = i.texcoord1.xyz * r4.zzz + r2.xyz;
	r2.xyz = i.texcoord5.xyz * r4.yyy + r2.xyz;
	r2.xyz = r2.xyz + 1E-05;
	r2.w = dot(r2.xyz, r2.xyz);
	r2.w = rsqrt(r2.w);
	r4.xyz = r2.xyz * r2.www + 1E-05;
	r2.xyz = r2.www * r2.xyz;
	r5 = normalize(r4.xyz);
	r4.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r4.xyz = r4.xyz + 1E-05;
	r6.xyz = normalize(r4.xyz);
	r2.w = dot(r6.xyz, r5.xyz);
	r3.z = r2.w * 1.5 + 1;
	r2.w = (-r2.w >= 0) ? r3.z : 1;
	r3.z = r2.w * i.texcoord2.y;
	r3.w = saturate(dot(r0.xyz, specMapIntMask.xyz));
	r4.x = r3.w * matMaterialColorScale.w;
	r4.x = saturate(r4.x * 5);
	r3.z = r3.z * r4.x;
	r0.w = dot(r0, specMapExpMask);
	r0.x = dot(r0.xyz, specMapReflectMask.xyz);
	r0.y = r0.w * specularFactor.x;
	r4.x = max(1, r0.y);
	r0.y = r4.x * matMaterialColorScale.w;
	r0.z = saturate(r0.y * -0.01 + 1);
	r4.x = r0.y * 0.0051020407;
	r4.x = saturate(r4.x);
	r0.y = rsqrt(r4.x);
	r0.y = 1 / r0.y;
	r0.y = rsqrt(r0.y);
	o.color2.y = 1 / r0.y;
	r0.y = r3.z * r0.z;
	r0.y = (r2.w >= 0) ? r0.y : 0;
	r0.y = r3.w * matMaterialColorScale.w + r0.y;
	o.color2.x = saturate(r1.z * r0.y);
	r0.yzw = r1.yyy * i.texcoord5.xyz;
	r0.yzw = i.texcoord4.xyz * r1.xxx + r0.yzw;
	r0.yzw = r0.yzw * detailSettings.yyy;
	r0.yzw = r0.yzw * i.texcoord2.www + r2.xyz;
	r0.yzw = r0.yzw + 1E-05;
	r1.xyz = normalize(r0.yzw);
	o.color1.xyz = r1.xyz * 0.5 + 0.5;
	r0.y = saturate(gAmbientOcclusionEffect.z);
	r0.y = saturate(r0.y + i.texcoord2.x);
	o.color2.z = r0.y * gAmbientOcclusionEffect.w;
	r0.y = dot(r3.xy, -r3.xy) + 1;
	r1.x = max(r0.y, 0);
	r0.y = rsqrt(r1.x);
	r0.y = 1 / r0.y;
	r1.xyz = r3.xxx * i.texcoord4.xyz;
	r0.yzw = r0.yyy * i.texcoord1.xyz + r1.xyz;
	r0.yzw = r3.yyy * i.texcoord5.xyz + r0.yzw;
	r0.yzw = r0.yzw + 1E-05;
	r1.xyz = normalize(r0.yzw);
	r0.yzw = 1E-05 + i.texcoord3.xyz;
	r2.xyz = normalize(r0.yzw);
	r0.y = dot(-r2.xyz, r1.xyz);
	r0.y = r0.y + r0.y;
	r0.yzw = r1.xyz * -r0.yyy + -r2.xyz;
	r1.x = saturate(dot(r2.xyz, r1.xyz));
	r1.x = -r1.x + 1.00001;
	r0.yzw = r0.yzw + 1E-05;
	r2.xyz = normalize(r0.yzw);
	r0.y = saturate(r2.z);
	r0.y = r0.y + 1;
	r0.y = r0.y + r0.y;
	r0.y = 1 / r0.y;
	r0.yz = r2.xy * r0.yy + 0.5;
	r2.xy = -r0.yz + 1;
	r2.zw = 0;
	r2 = tex2Dlod(EnvironmentSampler, r2);
	r0.yzw = r2.xyz * r2.xyz;
	r0.yzw = r0.yzw * 16;
	r1.y = r1.x * r1.x;
	r1.y = r1.y * r1.y;
	r1.x = r1.y * r1.x;
	r2.x = 1;
	r1.y = r2.x + -fresnelRolloff.x;
	r1.x = fresnelRolloff.x * r1.x + r1.y;
	r0.yzw = r0.yzw * r1.xxx;
	r2 = tex2D(EnvironmentSampler, i.texcoord.xy);
	r0.yzw = r0.yzw * r2.www;
	r0.yzw = r0.yzw * reflectivePower.xxx;
	r0.xyz = r0.xxx * r0.yzw;
	r0.xyz = r0.xyz * ColorCorrectTopAndPedReflectScale.www;
	r0.xyz = r0.xyz * matMaterialColorScale.zzz;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.color3.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.color3.z = 1 / r0.y;
	o.color3.y = 1 / r0.x;
	o.color.w = r1.w;
	o.color1.w = r1.w;
	o.color2.w = r1.w;
	o.color3.w = gStencil.x;

	return o;
}
