sampler2D BloodSampler : register(s3);
sampler2D BumpSampler : register(s5);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s1);
sampler2D SpecSampler : register(s6);
sampler3D VolumeSampler : register(s7);
sampler2D WrinkleMaskSampler_0 : register(s8);
sampler2D WrinkleMaskSampler_1 : register(s9);
sampler2D WrinkleSampler_A : register(s10);
sampler2D WrinkleSampler_B : register(s11);
float bumpiness : register(c200);
float4 detailSettings : register(c207);
float fresnelRolloff : register(c199);
float4 gAmbientOcclusionEffect : register(c63);
float4 gBloodData : register(c206);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float reflectivePower : register(c197);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c198);
float specularFactor : register(c202);
float4 wrinkleMaskStrengths0 : register(c210);
float4 wrinkleMaskStrengths1 : register(c211);
float4 wrinkleMaskStrengths2 : register(c212);
float4 wrinkleMaskStrengths3 : register(c213);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color2 : COLOR2;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.zw = r0.xy * 2 + -1;
	r0.zw = r0.zw * bumpiness.xx;
	r2.x = dot(r0.zw, -r0.zw) + 1;
	r3.x = max(r2.x, 0);
	r2.x = rsqrt(r3.x);
	r2.x = 1 / r2.x;
	r3 = tex2D(SpecSampler, i.texcoord.xy);
	r2.y = dot(r3, specMapExpMask);
	r2.y = r2.y * specularFactor.x;
	r2.z = saturate(dot(r3.xyz, specMapIntMask.xyz));
	r3.w = max(1, r2.y);
	r4.xyz = r0.zzz * i.texcoord4.xyz;
	r2.xyw = r2.xxx * i.texcoord1.xyz + r4.xyz;
	r2.xyw = r0.www * i.texcoord5.xyz + r2.xyw;
	r2.xyw = r2.xyw + 1E-05;
	r4.xyz = normalize(r2.xyw);
	r2.xyw = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r2.xyw);
	r0.z = dot(-r5.xyz, r4.xyz);
	r0.z = r0.z + r0.z;
	r2.xyw = r4.xyz * -r0.zzz + -r5.xyz;
	r2.xyw = r2.xyw + 1E-05;
	r6.xyz = normalize(r2.xyw);
	r0.z = saturate(r6.z);
	r0.z = r0.z + 1;
	r0.z = r0.z + r0.z;
	r0.z = 1 / r0.z;
	r0.zw = r6.xy * r0.zz + 0.5;
	r6.xy = -r0.zw + 1;
	r6.zw = 0;
	r6 = tex2Dlod(EnvironmentSampler, r6);
	r2.xyw = r6.xyz * r6.xyz;
	r2.xyw = r2.xyw * 16;
	r0.z = saturate(dot(r5.xyz, r4.xyz));
	r4.xw = float2(1, 0);
	r0.w = r4.x + -fresnelRolloff.x;
	r0.z = -r0.z + 1.00001;
	r4.x = r0.z * r0.z;
	r4.x = r4.x * r4.x;
	r0.z = r0.z * r4.x;
	r0.z = fresnelRolloff.x * r0.z + r0.w;
	r2.xyw = r0.zzz * r2.xyw;
	r5 = tex2D(EnvironmentSampler, i.texcoord.xy);
	r2.xyw = r2.xyw * r5.www;
	r2.xyw = r2.xyw * reflectivePower.xxx;
	r0.z = dot(r3.xyz, specMapReflectMask.xyz);
	r2.xyw = r0.zzz * r2.xyw;
	r2.xyw = r2.xyw * ColorCorrectTopAndPedReflectScale.www;
	r5 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r6 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r0.z = dot(wrinkleMaskStrengths0, r5);
	r0.w = dot(wrinkleMaskStrengths1, r6);
	r0.z = r0.w + r0.z;
	r0.w = dot(wrinkleMaskStrengths2, r5);
	r3.x = dot(wrinkleMaskStrengths3, r6);
	r0.w = r0.w + r3.x;
	r0.xy = r0.xy + -0.5;
	r0.xy = r0.xy * bumpiness.xx;
	r0.xy = r0.xy + r0.xy;
	r5 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r3.x = -r5.w + 1;
	r3.x = -r5.x + r3.x;
	r3.xy = (r3.xx >= 0) ? r5.wy : r5.xy;
	r3.xy = r3.xy + -0.5;
	r5 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r4.x = -r5.w + 1;
	r4.x = -r5.x + r4.x;
	r4.xy = (r4.xx >= 0) ? r5.wy : r5.xy;
	r4.xy = r4.xy + -0.5;
	r3.xy = r3.xy * 2 + -r0.xy;
	r0.xy = r0.zz * r3.xy + r0.xy;
	r3.xy = r4.xy * 2 + -r0.xy;
	r0.xy = r0.ww * r3.xy + r0.xy;
	r0.w = dot(r0.xy, -r0.xy) + 1;
	r3.x = max(r0.w, 0);
	r0.w = rsqrt(r3.x);
	r0.z = 1 / r0.w;
	r0.xyz = r0.xyz + 1E-05;
	r4.xyz = normalize(r0.xyz);
	r0.xyz = r4.xxx * i.texcoord4.xyz;
	r0.xyz = i.texcoord1.xyz * r4.zzz + r0.xyz;
	r0.xyz = i.texcoord5.xyz * r4.yyy + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	if (-gBloodData.w < r4.w) {
		r4 = tex2D(BloodSampler, i.texcoord.zw);
		r5.z = min(r4.y, r4.x);
		r3.x = saturate(r4.x * 0.5 + r4.w);
		r5.xy = r4.xy;
		r4.xyz = lerp(r1.xyz, r5.xyz, r3.xxx);
		r1.xyz = r4.xyz;
	}
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r4.xyz = r0.www * r0.xyz;
	r1.w = r1.w * i.texcoord2.w;
	r1.xyz = r1.xyz * matMaterialColorScale.xxx;
	r2.xyw = r2.xyw * matMaterialColorScale.zzz;
	r3.x = r2.z * matMaterialColorScale.w;
	r3.y = r3.w * matMaterialColorScale.w;
	r5.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r5.xyz = r5.xyz + 1E-05;
	r6.xyz = normalize(r5.xyz);
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r5.xyz = normalize(r0.xyz);
	r0.x = dot(r6.xyz, r5.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.z = saturate(r3.x * 5);
	r0.y = r0.z * r0.y;
	r3.x = r3.y * 0.0051020407;
	r0.z = saturate(r3.y * -0.01 + 1);
	r0.y = r0.y * r0.z;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r2.z * matMaterialColorScale.w + r0.x;
	r0.y = r3.z * 16;
	r0.z = frac(r0.y);
	r0.y = r0.y + -r0.z;
	r0.z = (-r0.z >= 0) ? 0 : 1;
	r0.z = (r3.z >= 0) ? 0 : r0.z;
	r0.y = r0.z + r0.y;
	r5.xy = detailSettings.zw * i.texcoord.xy;
	r0.y = r0.y + 0.5;
	r5.z = r0.y * 0.0625;
	r5 = tex3D(VolumeSampler, r5.xyz);
	r0.yzw = r5.yzx * 2 + -1;
	r2.z = detailSettings.x * i.texcoord2.w;
	r0.w = r0.w * r2.z + 1;
	o.color.xyz = r0.www * r1.xyz;
	r1.xyz = r0.zzz * i.texcoord5.xyz;
	r1.xyz = i.texcoord4.xyz * r0.yyy + r1.xyz;
	r1.xyz = r1.xyz * detailSettings.yyy;
	r1.xyz = r1.xyz * i.texcoord2.www + r4.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r4.xyz = normalize(r1.xyz);
	o.color2.x = saturate(r0.w * r0.x);
	r0.x = saturate(gAmbientOcclusionEffect.z);
	r0.x = saturate(r0.x + i.texcoord2.x);
	o.color1.xyz = r4.xyz * 0.5 + 0.5;
	r3.x = saturate(r3.x);
	r0.y = rsqrt(r3.x);
	r0.y = 1 / r0.y;
	r0.y = rsqrt(r0.y);
	o.color2.y = 1 / r0.y;
	o.color2.z = r0.x * gAmbientOcclusionEffect.w;
	r0.x = r1.w * globalScalars.x;
	r0.yzw = saturate(r2.xyw * 0.0625);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	r0.w = rsqrt(r0.w);
	o.color3.x = 1 / r0.y;
	o.color3.y = 1 / r0.z;
	o.color3.z = 1 / r0.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3.w = gStencil.x;

	return o;
}
