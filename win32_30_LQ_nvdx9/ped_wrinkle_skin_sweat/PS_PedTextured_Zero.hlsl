sampler2D BumpSampler : register(s4);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s5);
sampler2D WrinkleMaskSampler_0 : register(s7);
sampler2D WrinkleMaskSampler_1 : register(s8);
sampler2D WrinkleSampler_A : register(s9);
sampler2D WrinkleSampler_B : register(s10);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float specularFactor : register(c202);
float4 wrinkleMaskStrengths0 : register(c210);
float4 wrinkleMaskStrengths1 : register(c211);
float4 wrinkleMaskStrengths2 : register(c212);
float4 wrinkleMaskStrengths3 : register(c213);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	o.w = globalScalars.x * i.texcoord7.w;
	r0.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r0.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r0.xyz;
	r0.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gShadowMatrix[3].xyz;
	r1.xy = r0.xy + -gShadowParam18192021.zw;
	r1.zw = r1.xx + -gCascadeXMaxThresholds.xy;
	r1.zw = (r1.zw >= 0) ? 1 : 0;
	r2.xy = -r1.xx + gCascadeXMinThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r1.zw = r1.zw + r2.xy;
	r2.xy = r1.yy + -gCascadeYMaxThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r1.zw = r1.zw + r2.xy;
	r2.xy = -r1.yy + gCascadeYMinThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r2.yz = saturate(r1.zw + r2.xy);
	r2.x = 1;
	r3.x = dot(r2.xyz, gShadowParam0123.xyz);
	r3.y = dot(r2.xyz, gShadowParam4567.xyz);
	r3.z = dot(r2.xyz, gCascadeZScales.xyz);
	r4.x = dot(r2.xyz, gShadowParam891113.xyz);
	r4.y = dot(r2.xyz, gShadowParam14151617.xyz);
	r4.z = dot(r2.xyz, gCascadeZOffsets.xyz);
	r0.xyz = r0.zxy * r3.zxy + r4.zxy;
	r2 = tex2D(gShadowZSamplerDir, r0.yz);
	r0.x = saturate(r0.x);
	r0.x = -r0.x + 1;
	r0.yzw = r2.wxy * 255 + 0.5;
	r2.xyz = frac(r0.yzw);
	r0.yzw = r0.yzw + -r2.xyz;
	r0.y = dot(r0.yzw, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r0.x = -r0.x + r0.y;
	r0.x = (r0.x >= 0) ? 0 : 0.33333334;
	r2.x = -gCascadeXMinThresholds.w;
	r2.y = -gCascadeXMaxThresholds.w;
	r0.yz = saturate(abs(r1.xy) * 4 + r2.xy);
	r1.x = max(r0.y, r0.z);
	r0.x = r0.x + r1.x;
	r0.x = r0.x + -0.4;
	r0.x = saturate(r0.x * 1.6666666);
	r0.y = r0.x * -2 + 3;
	r0.x = r0.x * r0.x;
	r0.x = r0.x * r0.y;
	r0.xyz = r0.xxx * gDirectionalColour.xyz;
	r1 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r0.w = -r1.w + 1;
	r0.w = -r1.x + r0.w;
	r1.xy = (r0.ww >= 0) ? r1.wy : r1.xy;
	r2 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r0.w = -r2.w + 1;
	r0.w = -r2.x + r0.w;
	r1.zw = (r0.ww >= 0) ? r2.wy : r2.xy;
	r1 = r1 + -0.5;
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r2.w + 1;
	r0.w = -r2.x + r0.w;
	r2.xy = (r0.ww >= 0) ? r2.wy : r2.xy;
	r2.xy = r2.xy + -0.5;
	r2.xy = r2.xy * bumpiness.xx;
	r2.xy = r2.xy + r2.xy;
	r1.zw = r1.zw * 2 + -r2.xy;
	r3 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r0.w = dot(wrinkleMaskStrengths0, r3);
	r2.z = dot(wrinkleMaskStrengths2, r3);
	r3 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r2.w = dot(wrinkleMaskStrengths1, r3);
	r3.x = dot(wrinkleMaskStrengths3, r3);
	r2.z = r2.z + r3.x;
	r0.w = r0.w + r2.w;
	r1.zw = r0.ww * r1.zw + r2.xy;
	r1.xy = r1.xy * 2 + -r1.zw;
	r1.xy = r2.zz * r1.xy + r1.zw;
	r0.w = dot(r1.xy, -r1.xy) + 1;
	r1.w = max(r0.w, 0);
	r0.w = rsqrt(r1.w);
	r1.z = 1 / r0.w;
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r1.xyz = r2.xxx * i.texcoord4.xyz;
	r1.xyz = i.texcoord1.xyz * r2.zzz + r1.xyz;
	r1.xyz = i.texcoord5.xyz * r2.yyy + r1.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r1.xyz = 1E-05 + i.texcoord3.xyz;
	r3.xyz = normalize(r1.xyz);
	r0.w = dot(-r3.xyz, r2.xyz);
	r0.w = r0.w + r0.w;
	r1.xyz = r2.xyz * -r0.www + -r3.xyz;
	r0.w = saturate(dot(-gDirectionalLight.xyz, r1.xyz));
	r0.w = r0.w + 1E-05;
	r1 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r1, specMapExpMask);
	r1.x = dot(r1.xyz, specMapIntMask.xyz);
	r3.x = 1;
	r1.y = r1.w * -specularFactor.x + r3.x;
	r3.x = 1E-05;
	r1.z = r1.w * specularFactor.x + r3.x;
	r1.y = (r1.y >= 0) ? 1.00001 : r1.z;
	r2.w = pow(r0.w, r1.y);
	r0.w = dot(r2.xyz, -gDirectionalLight.xyz);
	r1.y = saturate(r2.z * -0.5 + 0.5);
	r1.z = saturate(r0.w * 2 + -0.5);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r2.xyz = r0.www * r0.xyz;
	r0.w = r1.z * r2.w;
	r0.xyz = r0.www * r0.xyz;
	r0.xyz = r0.xyz * gDirectionalLight.www;
	r0.xyz = r1.xxx * r0.xyz;
	r3.xyz = gLightAmbient0.xyz;
	r1.xzw = -r3.xyz + gLightAmbient1.xyz;
	r1.xyz = r1.yyy * r1.xzw + gLightAmbient0.xyz;
	r1.xyz = r1.xyz * gAmbientOcclusionEffect.yyy;
	r1.xyz = r1.xyz * i.texcoord7.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r1.xyz * r0.www + r2.xyz;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2.xyz = r2.xyz * r2.xyz;
	r0.xyz = r2.xyz * r1.xyz + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.y = -r1.x + 1;
	r1.x = r1.y * gDepthFxParams.y + r1.x;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = r0.w * -1.442695;
	r1.y = exp2(r1.y);
	r1.z = r1.y + -65504;
	r1.y = -r1.y + 1;
	r1.y = (r1.z >= 0) ? -65503 : r1.y;
	r1.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r1.y = r1.z * r1.y;
	r1.y = r1.y * r1.x;
	r0.w = (r0.w >= 0) ? r1.x : r1.y;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o.xyz = r2.xyz * matMaterialColorScale.xxx;

	return o;
}
