sampler2D BumpSampler : register(s4);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s5);
sampler2D WrinkleMaskSampler_0 : register(s7);
sampler2D WrinkleMaskSampler_1 : register(s8);
sampler2D WrinkleSampler_A : register(s9);
sampler2D WrinkleSampler_B : register(s10);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float specularFactor : register(c202);
float4 wrinkleMaskStrengths0 : register(c210);
float4 wrinkleMaskStrengths1 : register(c211);
float4 wrinkleMaskStrengths2 : register(c212);
float4 wrinkleMaskStrengths3 : register(c213);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	o.w = globalScalars.x * i.texcoord7.w;
	r0 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r0.z = -r1.w + 1;
	r0.z = -r1.x + r0.z;
	r0.zw = (r0.zz >= 0) ? r1.wy : r1.xy;
	r0 = r0 + -0.5;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r1.z = -r1.w + 1;
	r1.z = -r1.x + r1.z;
	r1.xy = (r1.zz >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy + -0.5;
	r1.xy = r1.xy * bumpiness.xx;
	r1.xy = r1.xy + r1.xy;
	r0.zw = r0.zw * 2 + -r1.xy;
	r2 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r1.z = dot(wrinkleMaskStrengths0, r2);
	r1.w = dot(wrinkleMaskStrengths2, r2);
	r2 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r3.x = dot(wrinkleMaskStrengths1, r2);
	r2.x = dot(wrinkleMaskStrengths3, r2);
	r1.w = r1.w + r2.x;
	r1.z = r1.z + r3.x;
	r0.zw = r1.zz * r0.zw + r1.xy;
	r0.xy = r0.xy * 2 + -r0.zw;
	r0.xy = r1.ww * r0.xy + r0.zw;
	r0.w = dot(r0.xy, -r0.xy) + 1;
	r1.x = max(r0.w, 0);
	r0.w = rsqrt(r1.x);
	r0.z = 1 / r0.w;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0.xyz = r1.xxx * i.texcoord4.xyz;
	r0.xyz = i.texcoord1.xyz * r1.zzz + r0.xyz;
	r0.xyz = i.texcoord5.xyz * r1.yyy + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0 = gLightPosX + -i.texcoord2.x;
	r2 = r0 * r0;
	r3 = gLightPosY + -i.texcoord2.y;
	r2 = r3 * r3 + r2;
	r4 = gLightPosZ + -i.texcoord2.z;
	r2 = r4 * r4 + r2;
	r5 = r2 + 1E-05;
	r6.x = 1;
	r2 = saturate(r2 * -gLightFallOff + r6.x);
	r2 = r2 * r2;
	r2 = r2 * r2 + -0.1;
	r6.x = rsqrt(r5.x);
	r6.y = rsqrt(r5.y);
	r6.z = rsqrt(r5.z);
	r6.w = rsqrt(r5.w);
	r0 = r0 * r6;
	r5 = r1.x * r0;
	r3 = r3 * r6;
	r4 = r4 * r6;
	r5 = r3 * r1.y + r5;
	r5 = r4 * r1.z + r5;
	r6 = r2 * 1.1111112;
	r2 = (r2 >= 0) ? r6 : 0;
	r2 = saturate(r2 * r5);
	r5 = r0 * -gLightDirX;
	r5 = r3 * -gLightDirY + r5;
	r5 = r4 * -gLightDirZ + r5;
	r6 = gLightConeScale;
	r5 = saturate(r5 * r6 + gLightConeOffset);
	r2 = r2 * r5;
	r5.xyz = 1E-05 + i.texcoord3.xyz;
	r6.xyz = normalize(r5.xyz);
	r1.w = dot(-r6.xyz, r1.xyz);
	r1.w = r1.w + r1.w;
	r5.xyz = r1.xyz * -r1.www + -r6.xyz;
	r0 = r0 * r5.x;
	r0 = r5.y * r3 + r0;
	r0 = saturate(r5.z * r4 + r0);
	r1.w = saturate(dot(-gDirectionalLight.xyz, r5.xyz));
	r1.w = r1.w + 1E-05;
	r0 = r0 + 1E-05;
	r3.x = log2(r0.x);
	r3.y = log2(r0.y);
	r3.z = log2(r0.z);
	r3.w = log2(r0.w);
	r0 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r0, specMapExpMask);
	r0.x = dot(r0.xyz, specMapIntMask.xyz);
	r0.y = r0.w * specularFactor.x;
	r4.x = max(1, r0.y);
	r0.y = r4.x * 0.25 + 1E-05;
	r0.z = r4.x + 1E-05;
	r4.x = pow(r1.w, r0.z);
	r3 = r3 * r0.y;
	r5.x = exp2(r3.x);
	r5.y = exp2(r3.y);
	r5.z = exp2(r3.z);
	r5.w = exp2(r3.w);
	r3 = r2 * r5;
	r5.x = dot(gLightColR, r3);
	r5.y = dot(gLightColG, r3);
	r5.z = dot(gLightColB, r3);
	r0.y = dot(r1.xyz, -gDirectionalLight.xyz);
	r0.z = saturate(r1.z * -0.5 + 0.5);
	r0.w = saturate(r0.y * 2 + -0.5);
	r0.y = saturate(r0.y + -0.25);
	r0.y = r0.y * 1.3333334;
	r0.w = r0.w * r4.x;
	r1.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r1.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r1.xyz;
	r1.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r1.xyz;
	r1.xyz = r1.xyz + gShadowMatrix[3].xyz;
	r3.xy = r1.xy + -gShadowParam18192021.zw;
	r3.zw = r3.xx + -gCascadeXMaxThresholds.xy;
	r3.zw = (r3.zw >= 0) ? 1 : 0;
	r4.xy = -r3.xx + gCascadeXMinThresholds.xy;
	r4.xy = (r4.xy >= 0) ? 1 : 0;
	r3.zw = r3.zw + r4.xy;
	r4.xy = r3.yy + -gCascadeYMaxThresholds.xy;
	r4.xy = (r4.xy >= 0) ? 1 : 0;
	r3.zw = r3.zw + r4.xy;
	r4.xy = -r3.yy + gCascadeYMinThresholds.xy;
	r4.xy = (r4.xy >= 0) ? 1 : 0;
	r4.yz = saturate(r3.zw + r4.xy);
	r4.x = 1;
	r6.x = dot(r4.xyz, gShadowParam0123.xyz);
	r6.y = dot(r4.xyz, gShadowParam4567.xyz);
	r6.z = dot(r4.xyz, gCascadeZScales.xyz);
	r7.x = dot(r4.xyz, gShadowParam891113.xyz);
	r7.y = dot(r4.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r4.xyz, gCascadeZOffsets.xyz);
	r1.xyz = r1.zxy * r6.zxy + r7.zxy;
	r4 = tex2D(gShadowZSamplerDir, r1.yz);
	r1.x = saturate(r1.x);
	r1.x = -r1.x + 1;
	r1.yzw = r4.wxy * 255 + 0.5;
	r4.xyz = frac(r1.yzw);
	r1.yzw = r1.yzw + -r4.xyz;
	r1.y = dot(r1.yzw, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r1.x = -r1.x + r1.y;
	r1.x = (r1.x >= 0) ? 0 : 0.33333334;
	r4.x = -gCascadeXMinThresholds.w;
	r4.y = -gCascadeXMaxThresholds.w;
	r1.yz = saturate(abs(r3.xy) * 4 + r4.xy);
	r3.x = max(r1.y, r1.z);
	r1.x = r1.x + r3.x;
	r1.x = r1.x + -0.4;
	r1.x = saturate(r1.x * 1.6666666);
	r1.y = r1.x * -2 + 3;
	r1.x = r1.x * r1.x;
	r1.x = r1.x * r1.y;
	r1.xyz = r1.xxx * gDirectionalColour.xyz;
	r3.xyz = r0.www * r1.xyz;
	r1.xyz = r0.yyy * r1.xyz;
	r3.xyz = r3.xyz * gDirectionalLight.www + r5.xyz;
	r0.xyw = r0.xxx * r3.xyz;
	r3.xyz = gLightAmbient0.xyz;
	r3.xyz = -r3.xyz + gLightAmbient1.xyz;
	r3.xyz = r0.zzz * r3.xyz + gLightAmbient0.xyz;
	r3.xyz = r3.xyz * gAmbientOcclusionEffect.yyy;
	r3.xyz = r3.xyz * i.texcoord7.xxx;
	r0.z = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r3.xyz * r0.zzz + r1.xyz;
	r3.x = dot(gLightColR, r2);
	r3.y = dot(gLightColG, r2);
	r3.z = dot(gLightColB, r2);
	r1.xyz = r1.xyz + r3.xyz;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2.xyz = r2.xyz * r2.xyz;
	r0.xyz = r2.xyz * r1.xyz + r0.xyw;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.y = -r1.x + 1;
	r1.x = r1.y * gDepthFxParams.y + r1.x;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = r0.w * -1.442695;
	r1.y = exp2(r1.y);
	r1.z = r1.y + -65504;
	r1.y = -r1.y + 1;
	r1.y = (r1.z >= 0) ? -65503 : r1.y;
	r1.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r1.y = r1.z * r1.y;
	r1.y = r1.y * r1.x;
	r0.w = (r0.w >= 0) ? r1.x : r1.y;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o.xyz = r2.xyz * matMaterialColorScale.xxx;

	return o;
}
