float4 gLightPointPosY : register(c80);
float4 gLightPointPosZ : register(c81);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord6 : TEXCOORD6;
	float3 texcoord5 : TEXCOORD5;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0.x = saturate(i.texcoord4.z * -0.5 + 0.5);
	r1.xyz = gLightAmbient0.xyz;
	r0.yzw = -r1.xyz + gLightAmbient1.xyz;
	r0.xyz = r0.xxx * r0.yzw + gLightAmbient0.xyz;
	r0.xyz = r0.xyz * gAmbientOcclusionEffect.yyy;
	r0.w = dot(i.texcoord4.xyz, -gDirectionalLight.xyz);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r1.xyz = r0.www * gDirectionalColour.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r0.xyz = r0.xyz * r0.www + r1.xyz;
	r1 = gLightPosX + -i.texcoord3.x;
	r2 = r1 * r1;
	r3 = gLightPosY + -i.texcoord3.y;
	r2 = r3 * r3 + r2;
	r4 = gLightPosZ + -i.texcoord3.z;
	r2 = r4 * r4 + r2;
	r5.y = 1;
	r6 = r2 * -gLightFallOff + r5.y;
	r2 = r2 + 1E-05;
	r7 = max(r6, 0);
	r6 = r7 * r7;
	r6 = r6 * r6 + -0.1;
	r7 = r6 * 1.1111112;
	r8 = r1 * i.texcoord4.x;
	r1 = r1 * -gLightDirX;
	r1 = r3 * -gLightDirY + r1;
	r3 = r3 * i.texcoord4.y + r8;
	r3 = r4 * i.texcoord4.z + r3;
	r1 = r4 * -gLightDirZ + r1;
	r3 = r7 * r3;
	r4.x = rsqrt(r2.x);
	r4.y = rsqrt(r2.y);
	r4.z = rsqrt(r2.z);
	r4.w = rsqrt(r2.w);
	r2 = saturate(r3 * r4);
	r1 = r1 * r4;
	r3 = gLightConeScale;
	r1 = saturate(r1 * r3 + gLightConeOffset);
	r1 = r2 * r1;
	r1 = (r6 >= 0) ? r1 : 0;
	r2.x = dot(gLightColR, r1);
	r2.y = dot(gLightColG, r1);
	r2.z = dot(gLightColB, r1);
	r0.xyz = r0.xyz + r2.xyz;
	r1 = gLightPointPosX + -i.texcoord3.x;
	r2 = r1 * r1;
	r3 = gLightPointPosY + -i.texcoord3.y;
	r2 = r3 * r3 + r2;
	r4 = gLightPointPosZ + -i.texcoord3.z;
	r2 = r4 * r4 + r2;
	r5 = r2 * -gLightPointFallOff + r5.y;
	r2 = r2 + 1E-05;
	r6 = max(r5, 0);
	r5 = r6 * r6;
	r5 = r5 * r5 + -0.1;
	r6 = r5 * 1.1111112;
	r7 = r1 * i.texcoord4.x;
	r1 = r1 * -gLightDir2X;
	r1 = r3 * -gLightDir2Y + r1;
	r3 = r3 * i.texcoord4.y + r7;
	r3 = r4 * i.texcoord4.z + r3;
	r1 = r4 * -gLightDir2Z + r1;
	r3 = r6 * r3;
	r4.x = rsqrt(r2.x);
	r4.y = rsqrt(r2.y);
	r4.z = rsqrt(r2.z);
	r4.w = rsqrt(r2.w);
	r2 = saturate(r3 * r4);
	r1 = r1 * r4;
	r3 = gLightConeScale2;
	r1 = saturate(r1 * r3 + gLightConeOffset2);
	r1 = r2 * r1;
	r1 = (r5 >= 0) ? r1 : 0;
	r2.x = dot(gLightPointColR, r1);
	r2.y = dot(gLightPointColG, r1);
	r2.z = dot(gLightPointColB, r1);
	r0.xyz = r0.xyz + r2.xyz;
	r0.xyz = r0.xyz * i.texcoord6.xyz;
	r1 = tex2D(TextureSampler_layer0, i.texcoord.xy);
	r2 = tex2D(TextureSampler_layer1, i.texcoord.zw);
	r1.w = r2.w * i.texcoord5.y;
	r3.xyz = lerp(r1.xyz, r2.xyz, r1.www);
	r1 = tex2D(TextureSampler_layer2, i.texcoord1.xy);
	r1.w = r1.w * i.texcoord5.z;
	r2.xyz = lerp(r3.xyz, r1.xyz, r1.www);
	r0.w = globalScalars.x * i.texcoord6.w;
	r2.w = 1;
	r0 = r0 * r2;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = r1.x + 1E-05;
	r1.x = abs(r1.x) + 1E-05;
	r1.y = saturate(-i.texcoord4.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.z = -r1.y + 1;
	r1.y = r1.z * gDepthFxParams.y + r1.y;
	r1.y = r1.y + -0.99999;
	r2.x = pow(r1.x, r1.y);
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	o.w = r0.w;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord3.xyz;
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = r0.w * -1.442695;
	r1.y = exp2(r1.y);
	r1.z = r1.y + -65504;
	r1.y = -r1.y + 1;
	r1.y = (r1.z >= 0) ? -65503 : r1.y;
	r1.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r1.y = r1.z * r1.y;
	r1.y = r1.y * r1.x;
	r0.w = (r0.w >= 0) ? r1.x : r1.y;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o.xyz = r2.xyz * globalScalars.yyy;

	return o;
}
