sampler2D InitPositionTexSampler : register(s6);
sampler2D InitVelocityTexSampler : register(s7);
sampler2D NoiseTexSampler : register(s5);
sampler2D ParticleCollisionSampler : register(s4);
sampler2D ParticlePosXYTexSampler : register(s0);
sampler2D ParticlePosZWTexSampler : register(s1);
float3 gBoxCentreOffset : register(c213);
float3 gBoxSize : register(c214);
row_major float4x4 gBoxTransform : register(c206);
row_major float4x4 gDepthViewProjMtx : register(c202);
float3 gGravity : register(c210);
float2 gLifeMinMax : register(c215);
float2 gSplashLifeMinMax : register(c216);
float gTimeStep : register(c211);
float3 gVelocityMax : register(c218);
float3 gVelocityMin : register(c217);

struct PS_OUT
{
	float4 color1 : COLOR1;
	float4 color : COLOR;
};

PS_OUT main(float2 texcoord : TEXCOORD)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float3 r9;
	float4 r10;
	float3 r11;
	float3 r12;
	if (gSplashLifeMinMax.y < gSplashLifeMinMax.x) {
		r0 = tex2D(InitPositionTexSampler, texcoord.xy);
		r1 = tex2D(InitVelocityTexSampler, texcoord.xy);
		r2.x = r0.w;
		r2.y = r1.w;
	} else {
		r0 = tex2D(ParticlePosXYTexSampler, texcoord.xy);
		r1 = tex2D(ParticlePosZWTexSampler, texcoord.xy);
		r2.x = r0.w;
		r2.y = r1.w;
	}
	r0.w = frac(r2.x);
	r1.w = -r0.w + r2.x;
	r3.z = r0.w * 100;
	r0.w = r2.y + -10000;
	r2.x = (r0.w >= 0) ? r0.w : r2.y;
	r2.y = frac(r2.x);
	r2.x = -r2.y + r2.x;
	r3.w = r2.y * 100;
	r2.zw = float2(-1, 0);
	r4.xyz = r2.zzw * gBoxTransform[2].xyz;
	r2.y = dot(r4.xy, r4.xy) + 0;
	r2.y = rsqrt(r2.y);
	r4.xyz = r2.yyy * r4.xyz;
	r5.xyz = abs(r2.zzw) * gBoxTransform[0].xyz;
	r2.y = dot(r5.xy, r5.xy) + 0;
	r2.y = rsqrt(r2.y);
	r5.xyz = r2.yyy * r5.xyz;
	r3.x = gBoxCentreOffset.x;
	r6.xyz = r3.xxx * r5.xyz + gBoxTransform[3].xyz;
	r6.xyz = gBoxCentreOffset.yyy * r4.xyz + r6.xyz;
	r2.yzw = gBoxCentreOffset.zzz * abs(r2.wwz) + r6.xyz;
	r3.x = 0.01;
	r3.y = r1.w * r3.x + -gTimeStep.x;
	r6.xy = r0.xy * 0.0625 + texcoord.xy;
	r6 = tex2D(NoiseTexSampler, r6.xy);
	r7 = tex2D(NoiseTexSampler, texcoord.xy);
	r8.xyz = r6.wzy + -0.5;
	r9 = r5.xyz * gBoxSize.xxx;
	r10.xyz = r9.xyz * r8.xxx + r2.yzw;
	r11 = r4.xyz * gBoxSize.yyy;
	r10.xyz = r11.xyz * r8.yyy + r10.xyz;
	r8.w = 1;
	r8.xyw = r8.zzw * gBoxSize.zzz;
	r12 = r8.zzz * float3(0, 0, 1);
	r8.xyz = r8.xyw * r12.xyz + r10.xyz;
	r4.zw = r8.yy * gDepthViewProjMtx[1].xy;
	r4.zw = r8.xx * gDepthViewProjMtx[0].xy + r4.zw;
	r4.zw = r8.zz * gDepthViewProjMtx[2].xy + r4.zw;
	r10.xy = r4.zw + gDepthViewProjMtx[3].xy;
	r10.z = -r10.y + 1;
	r10 = tex2D(ParticleCollisionSampler, r10.xz);
	r1.w = -r10.x + 1;
	r1.w = r1.w + -gDepthViewProjMtx[3].z;
	r2.w = 1 / gDepthViewProjMtx[2].z;
	r8.w = r1.w * r2.w;
	r10.xyz = gVelocityMin.xyz;
	r10.xyz = -r10.xyz + gVelocityMax.xyz;
	r7.xyz = r10.xyz * r7.xyz + gVelocityMin.xyz;
	r10.yz = lerp(gLifeMinMax.xx, gLifeMinMax.yy, r6.ww);
	r0.xyz = (-r3.yyy >= 0) ? r8.xyw : r0.xyz;
	r1.xyz = (-r3.yyy >= 0) ? r7.xyz : r1.xyz;
	r10.w = r6.x;
	r3.yzw = (-r3.yyy >= 0) ? r10.yzw : r3.yzw;
	r0.xyz = r1.xyz * gTimeStep.xxx + r0.xyz;
	r2.yz = -r2.yz + r0.xy;
	r1.w = dot(r5.xy, r2.yz) + 0;
	r2.y = dot(r4.xy, r2.yz) + 0;
	r2.z = 1 / gBoxSize.x;
	r1.w = r1.w * r2.z + -0.5;
	r2.z = frac(-r1.w);
	r1.w = r1.w + r2.z;
	r4.xyz = r9.xyz * -r1.www + r0.xyz;
	r1.w = 1 / gBoxSize.y;
	r1.w = r2.y * r1.w + -0.5;
	r2.y = frac(-r1.w);
	r1.w = r1.w + r2.y;
	r4.xyz = r11.xyz * -r1.www + r4.xyz;
	r0.xyz = -r0.xyz + r4.xyz;
	r0.xyz = (-abs(r0.xyz) >= 0) ? 0 : 1;
	r0.x = r0.y + r0.x;
	r0.x = (-r0.x >= 0) ? 0 : 1;
	r0.x = r0.z + r0.x;
	r0.x = (-r0.x >= 0) ? 0 : 1;
	r5.xyz = r4.yyy * gDepthViewProjMtx[1].xyz;
	r5.xyz = r4.xxx * gDepthViewProjMtx[0].xyz + r5.xyz;
	r5.xyz = r4.zzz * gDepthViewProjMtx[2].xyz + r5.xyz;
	r5.xyz = r5.xyz + gDepthViewProjMtx[3].xyz;
	r5.w = -r5.y + 1;
	r6 = tex2D(ParticleCollisionSampler, r5.xw);
	r0.y = -r6.x + 1;
	r0.z = -r5.z + r0.y;
	r0.z = (r0.z >= 0) ? 1 : 0;
	r0.x = r0.x + r0.z;
	r0.y = r0.y + -gDepthViewProjMtx[3].z;
	r3.x = r2.w * r0.y;
	r0.y = r0.y * r2.w + -r4.z;
	r0.y = -r0.y + 1;
	r4.w = 0;
	r0.yz = (r0.yy >= 0) ? r3.xy : r4.zw;
	r3.x = r4.z;
	r0.xy = (-r0.xx >= 0) ? r3.xy : r0.yz;
	r3.x = gTimeStep.x;
	o.color1.xyz = gGravity.xyz * r3.xxx + r1.xyz;
	r0.y = r0.y * 100;
	r0.z = frac(r0.y);
	r0.y = -r0.z + r0.y;
	o.color.w = r3.z * 0.01 + r0.y;
	r0.y = (r0.w >= 0) ? 10000 : 0;
	r0.z = frac(r2.x);
	r0.z = -r0.z + r2.x;
	r0.y = r0.z + r0.y;
	o.color1.w = r3.w * 0.01 + r0.y;
	o.color.xy = r4.xy;
	o.color.z = r0.x;

	return o;
}
