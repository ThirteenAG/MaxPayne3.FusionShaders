struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float4 r10;
	float4 r11;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r1.xyz = 1E-05 + i.texcoord7.xyz;
	r0.z = dot(r1.xyz, r1.xyz);
	r0.z = rsqrt(r0.z);
	r1.xy = r0.zz * r1.xy;
	r1.xy = -r1.xy * parallaxScaleBias.xx;
	r1.zw = i.texcoord.xy;
	r2.x = 1;
	r2.yzw = r0.xyw;
	for (int i0 = 0; i0 < 2; i0++) {
		r0.z = -r2.x + r2.w;
		r3.x = r2.x + -0.5;
		r4.xy = r1.xy * 0.5 + r1.zw;
		r5 = tex2D(BumpSampler, r4.xy);
		r1.zw = (r0.zz >= 0) ? r1.zw : r4.xy;
		r3.yzw = r5.xyw;
		r2 = (r0.z >= 0) ? r2 : r3;
	}
	r0 = tex2D(DiffuseSampler, r1.zw);
	r1.xy = r2.yz * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r1.z = dot(r1.xy, -r1.xy) + 1;
	r2.x = max(r1.z, 0);
	r1.z = rsqrt(r2.x);
	r1.z = 1 / r1.z;
	r3.z = 1;
	r1.w = max(r3.z, specularFactor.x);
	r3.xyw = r1.xxx * i.texcoord4.xyz;
	r3.xyw = r1.zzz * i.texcoord1.xyz + r3.xyw;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r3.xyw;
	r1.xyz = r1.xyz + 1E-05;
	r4.xyz = normalize(r1.xyz);
	r1.x = dot(r2.yz, r2.yz) + -0.002;
	r1.x = (r1.x >= 0) ? 1 : 0;
	r0.xyz = r0.xyz * r1.xxx;
	r1.y = r1.x * i.color.x;
	r1.x = r1.x * specularColorFactor.x;
	r0.xyz = r0.xyz * r0.xyz;
	r0.w = r0.w * i.color.w;
	r2.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r2.xyz);
	r1.z = saturate(r4.z * -0.5 + 0.5);
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r2.xyz = r1.zzz * r2.xyz + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r1.yyy * r2.xyz;
	r1.y = 1 / gAmbientOcclusionEffect.y;
	r1.z = dot(-r5.xyz, r4.xyz);
	r1.z = r1.z + r1.z;
	r3.xyw = r4.xyz * -r1.zzz + -r5.xyz;
	r1.z = dot(r4.xyz, -gDirectionalLight.xyz);
	r2.w = saturate(r1.z + -0.25);
	r2.w = r2.w * 1.3333334;
	r4.w = saturate(dot(-gDirectionalLight.xyz, r3.xyw));
	r4.w = r4.w + 1E-05;
	r5.x = r1.w + 1E-05;
	r6.x = pow(r4.w, r5.x);
	r1.z = saturate(r1.z * 2 + -0.5);
	r1.z = r1.z * r6.x;
	r5.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r5.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r5.xyz;
	r5.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r5.xyz;
	r5.xyz = r5.xyz + gShadowMatrix[3].xyz;
	r6.xy = r5.xy + -gShadowParam18192021.zw;
	r6.zw = r6.xx + -gCascadeXMaxThresholds.xy;
	r6.zw = (r6.zw >= 0) ? 1 : 0;
	r7.xy = -r6.xx + gCascadeXMinThresholds.xy;
	r7.zw = r6.yy + -gCascadeYMaxThresholds.xy;
	r7 = (r7 >= 0) ? 1 : 0;
	r8.xy = -r6.yy + gCascadeYMinThresholds.xy;
	r8.xy = (r8.xy >= 0) ? 1 : 0;
	r6.zw = r6.zw + r7.xy;
	r6.zw = r7.zw + r6.zw;
	r7.yz = saturate(r8.xy + r6.zw);
	r7.x = 1;
	r8.x = dot(r7.xyz, gShadowParam0123.xyz);
	r8.y = dot(r7.xyz, gShadowParam4567.xyz);
	r8.z = dot(r7.xyz, gCascadeZScales.xyz);
	r9.x = dot(r7.xyz, gShadowParam891113.xyz);
	r9.y = dot(r7.xyz, gShadowParam14151617.xyz);
	r9.z = dot(r7.xyz, gCascadeZOffsets.xyz);
	r5.xyz = r5.zxy * r8.zxy + r9.zxy;
	r5.x = saturate(r5.x);
	r7.x = -gCascadeXMinThresholds.w;
	r7.y = -gCascadeXMaxThresholds.w;
	r6.xy = saturate(abs(r6.xy) * 4 + r7.xy);
	r4.w = max(r6.x, r6.y);
	r5.x = -r5.x + 1;
	r6 = tex2D(gShadowZSamplerDir, r5.yz);
	r5.x = r5.x + -r6.x;
	r5.x = (r5.x >= 0) ? -1 : -0;
	r4.w = r4.w + r5.x;
	r4.w = saturate(r4.w + 1);
	r5.xyz = r4.www * gDirectionalColour.xyz;
	r6.xyz = r1.zzz * r5.xyz;
	r5.xyz = r2.www * r5.xyz;
	r2.xyz = r2.xyz * r1.yyy + r5.xyz;
	r5 = gLightPosX + -i.texcoord6.x;
	r7 = gLightPosY + -i.texcoord6.y;
	r8 = gLightPosZ + -i.texcoord6.z;
	r9 = r5 * r5;
	r9 = r7 * r7 + r9;
	r9 = r8 * r8 + r9;
	r10 = r9 + 1E-05;
	r11.x = rsqrt(r10.x);
	r11.y = rsqrt(r10.y);
	r11.z = rsqrt(r10.z);
	r11.w = rsqrt(r10.w);
	r5 = r5 * r11;
	r7 = r7 * r11;
	r8 = r8 * r11;
	r9 = saturate(r9 * -gLightFallOff + r3.z);
	r9 = r9 * r9;
	r9 = r9 * r9 + -0.1;
	r10 = r9 * 1.1111112;
	r9 = (r9 >= 0) ? r10 : 0;
	r10 = r4.x * r5;
	r10 = r7 * r4.y + r10;
	r4 = r8 * r4.z + r10;
	r4 = saturate(r9 * r4);
	r9 = r5 * -gLightDirX;
	r9 = r7 * -gLightDirY + r9;
	r9 = r8 * -gLightDirZ + r9;
	r10 = gLightConeScale;
	r9 = saturate(r9 * r10 + gLightConeOffset);
	r4 = r4 * r9;
	r5 = r3.x * r5;
	r5 = r3.y * r7 + r5;
	r3 = saturate(r3.w * r8 + r5);
	r3 = r3 + 1E-05;
	r1.y = r1.w * 0.25 + 1E-05;
	r5.x = log2(r3.x);
	r5.y = log2(r3.y);
	r5.z = log2(r3.z);
	r5.w = log2(r3.w);
	r3 = r1.y * r5;
	r5.x = exp2(r3.x);
	r5.y = exp2(r3.y);
	r5.z = exp2(r3.z);
	r5.w = exp2(r3.w);
	r3 = r4 * r5;
	r5.x = dot(gLightColR, r4);
	r5.y = dot(gLightColG, r4);
	r5.z = dot(gLightColB, r4);
	r4.x = dot(gLightColR, r3);
	r4.y = dot(gLightColG, r3);
	r4.z = dot(gLightColB, r3);
	r1.yzw = r2.xyz + r5.xyz;
	r2.xyz = r6.xyz * gDirectionalLight.www + r4.xyz;
	r2.xyz = r1.xxx * r2.xyz;
	r0.xyz = r0.xyz * r1.yzw + r2.xyz;
	r1.w = r0.w * globalScalars.x;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r2.x = 1E-05 + i.texcoord9.y;
	r3.x = pow(r0.w, r2.x);
	r2.xyz = r0.xyz * r3.xxx;
	r0.xyz = r0.xyz * -r3.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r2.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r2.x = r2.x * deSatContrastGamma.x;
	r1.xyz = lerp(r0.www, r0.xyz, r2.xxx);
	o = min(r1, float4(8, 8, 8, 1));

	return o;
}
