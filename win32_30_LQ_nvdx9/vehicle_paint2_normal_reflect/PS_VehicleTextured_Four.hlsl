	r6.y = dot(r6.yzw, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r6.x = -r6.x + r6.y;
	r6.x = (r6.x >= 0) ? 0 : 0.33333334;
	r5.w = r5.w + r6.x;
	r5.w = r5.w + -0.4;
