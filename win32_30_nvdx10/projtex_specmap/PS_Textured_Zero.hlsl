sampler2D BumpSampler : register(s2);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s3);
float bumpiness : register(c202);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float parallaxScaleBias : register(c197);
float4 specMapExpMask : register(c201);
float3 specMapIntMask : register(c200);
float specularFactor : register(c199);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r0.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r0.xyz;
	r0.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gShadowMatrix[3].xyz;
	r1.xy = r0.xy + -gShadowParam18192021.zw;
	r1.zw = r1.xx + -gCascadeXMaxThresholds.xy;
	r1.zw = (r1.zw >= 0) ? 1 : 0;
	r2.xy = -r1.xx + gCascadeXMinThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r1.zw = r1.zw + r2.xy;
	r2.xy = r1.yy + -gCascadeYMaxThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r1.zw = r1.zw + r2.xy;
	r2.xy = -r1.yy + gCascadeYMinThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r2.yz = saturate(r1.zw + r2.xy);
	r2.x = 1;
	r3.x = dot(r2.xyz, gShadowParam0123.xyz);
	r3.y = dot(r2.xyz, gShadowParam4567.xyz);
	r3.z = dot(r2.xyz, gCascadeZScales.xyz);
	r4.x = dot(r2.xyz, gShadowParam891113.xyz);
	r4.y = dot(r2.xyz, gShadowParam14151617.xyz);
	r4.z = dot(r2.xyz, gCascadeZOffsets.xyz);
	r0.xyz = r0.zxy * r3.zxy + r4.zxy;
	r0.x = saturate(r0.x);
	r2 = tex2D(gShadowZSamplerDir, r0.yz);
	r0.x = -r0.x + 1;
	r0.x = -r2.x + r0.x;
	r0.x = (r0.x >= 0) ? -1 : -0;
	r2.x = -gCascadeXMinThresholds.w;
	r2.y = -gCascadeXMaxThresholds.w;
	r0.yz = saturate(abs(r1.xy) * 4 + r2.xy);
	r1.x = max(r0.y, r0.z);
	r0.x = r0.x + r1.x;
	r0.x = saturate(r0.x + 1);
	r0.xyz = r0.xxx * gDirectionalColour.xyz;
	r1.xyz = 1E-05 + i.texcoord7.xyz;
	r0.w = dot(r1.xyz, r1.xyz);
	r0.w = rsqrt(r0.w);
	r1.xy = r0.ww * r1.xy;
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r3.xyw = float3(1E-05, 0.5, -1);
	r0.w = r3.y * parallaxScaleBias.x;
	r0.w = r2.w * parallaxScaleBias.x + -r0.w;
	r1.xy = saturate(r0.ww * r1.xy + i.texcoord.xy);
	r2 = tex2D(BumpSampler, r1.xy);
	r1 = tex2D(DiffuseSampler, r1.xy);
	r2.zw = r2.xy * 2 + -1;
	r0.w = dot(r2.xy, r2.xy) + -0.002;
	r0.w = (r0.w >= 0) ? 1 : 0;
	r2.xy = r2.zw * bumpiness.xx;
	r2.z = dot(r2.xy, -r2.xy) + 1;
	r3.y = max(r2.z, 0);
	r2.z = rsqrt(r3.y);
	r2.z = 1 / r2.z;
	r4.xyz = r2.xxx * i.texcoord4.xyz;
	r2.xzw = r2.zzz * i.texcoord1.xyz + r4.xyz;
	r2.xyz = r2.yyy * i.texcoord5.xyz + r2.xzw;
	r2.xyz = r2.xyz + 1E-05;
	r4.xyz = normalize(r2.xyz);
	r2.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r2.xyz);
	r2.x = dot(-r5.xyz, r4.xyz);
	r2.x = r2.x + r2.x;
	r2.xyz = r4.xyz * -r2.xxx + -r5.xyz;
	r2.x = saturate(dot(-gDirectionalLight.xyz, r2.xyz));
	r2.x = r2.x + 1E-05;
	r5 = tex2D(SpecSampler, i.texcoord.xy);
	r2.y = dot(r5, specMapExpMask);
	r2.z = dot(r5.xyz, specMapIntMask.xyz);
	r2.z = r0.w * r2.z;
	r2.w = r2.y * -specularFactor.x + -r3.w;
	r2.y = r2.y * specularFactor.x + r3.x;
	r2.y = (r2.w >= 0) ? 1.00001 : r2.y;
	r3.x = pow(r2.x, r2.y);
	r2.x = dot(r4.xyz, -gDirectionalLight.xyz);
	r2.y = saturate(r4.z * -0.5 + 0.5);
	r2.w = saturate(r2.x * 2 + -0.5);
	r2.x = saturate(r2.x + -0.25);
	r2.x = r2.x * 1.3333334;
	r3.yzw = r0.xyz * r2.xxx;
	r2.x = r2.w * r3.x;
	r0.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * gDirectionalLight.www;
	r0.xyz = r2.zzz * r0.xyz;
	r4.xyz = gLightAmbient0.xyz;
	r2.xzw = -r4.xyz + gLightAmbient1.xyz;
	r2.xyz = r2.yyy * r2.xzw + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.w = r0.w * i.color.x;
	r1.xyz = r0.www * r1.xyz;
	r0.w = r1.w * i.color.w;
	r4.w = r0.w * globalScalars.x;
	r1.xyz = r1.xyz * r1.xyz;
	r2.xyz = r2.www * r2.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r2.xyz = r2.xyz * r0.www + r3.yzw;
	r0.xyz = r1.xyz * r2.xyz + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r4.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o = min(r4, float4(8, 8, 8, 1));

	return o;
}
