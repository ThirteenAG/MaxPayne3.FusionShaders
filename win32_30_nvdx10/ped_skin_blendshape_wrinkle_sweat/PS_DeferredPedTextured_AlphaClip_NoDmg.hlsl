sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
float4 SkinParams : register(c218);
sampler2D SpecSampler : register(s5);
float4 SubColor : register(c196);
float SubScatWidth : register(c198);
float SubScatWrap : register(c197);
sampler2D SweatMapSampler : register(s11);
sampler3D VolumeSampler : register(s6);
sampler2D WrinkleMaskSampler_0 : register(s7);
sampler2D WrinkleMaskSampler_1 : register(s8);
sampler2D WrinkleSampler_A : register(s9);
sampler2D WrinkleSampler_B : register(s10);
float bumpiness : register(c203);
float4 detailSettings : register(c211);
float fresnelRolloff : register(c202);
float4 gAmbientOcclusionEffect : register(c63);
float4 gDirectionalLight : register(c19);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c209);
float reflectivePower : register(c200);
float4 specMapExpMask : register(c207);
float3 specMapIntMask : register(c206);
float3 specMapReflectMask : register(c201);
float specularFactor : register(c205);
float4 vNoiseParams : register(c217);
float4 vSkinSweat : register(c219);
float4 wrinkleMaskStrengths0 : register(c213);
float4 wrinkleMaskStrengths1 : register(c214);
float4 wrinkleMaskStrengths2 : register(c215);
float4 wrinkleMaskStrengths3 : register(c216);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color2 : COLOR2;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	float3 r8;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.z = dot(r2, specMapExpMask);
	r0.z = r0.z * specularFactor.x;
	r0.w = dot(r2.xyz, specMapIntMask.xyz);
	r2.w = max(1, r0.z);
	r3.xyz = float3(1, 0, 2);
	if (-reflectivePower.x < r3.y) {
		r3.yw = r0.xy * 2 + -1;
		r3.yw = r3.yw * bumpiness.xx;
		r0.z = dot(r3.yw, -r3.yw) + 1;
		r4.x = max(r0.z, 0);
		r0.z = rsqrt(r4.x);
		r0.z = 1 / r0.z;
		r4.xyz = r3.yyy * i.texcoord4.xyz;
		r4.xyz = r0.zzz * i.texcoord1.xyz + r4.xyz;
		r4.xyz = r3.www * i.texcoord5.xyz + r4.xyz;
		r4.xyz = r4.xyz + 1E-05;
		r5.xyz = normalize(r4.xyz);
		r0.z = saturate(r2.w * 0.015625);
		r4.w = r0.z * -4 + 4;
		r6.xyz = 1E-05 + i.texcoord3.xyz;
		r7 = normalize(r6.xyz);
		r0.z = dot(-r7.xyz, r5.xyz);
		r0.z = r0.z + r0.z;
		r6.xyz = r5.xyz * -r0.zzz + -r7.xyz;
		r6.xyz = r6.xyz + 1E-05;
		r8 = normalize(r6.xyz);
		r0.z = saturate(r8.z);
		r0.z = r0.z + 1;
		r0.z = r0.z + r0.z;
		r0.z = 1 / r0.z;
		r3.yw = r8.xy * r0.zz + 0.5;
		r4.xy = -r3.yw + 1;
		r4.z = 0;
		r4 = tex2Dlod(DynamicEnvironmentSampler, r4);
		r4.xyz = r4.xyz * r4.xyz;
		r4.xyz = r4.xyz * 16;
		r0.z = saturate(dot(r7.xyz, r5.xyz));
		r3.y = r3.x + -fresnelRolloff.x;
		r0.z = -r0.z + 1.00001;
		r3.w = r0.z * r0.z;
		r3.w = r3.w * r3.w;
		r0.z = r0.z * r3.w;
		r0.z = fresnelRolloff.x * r0.z + r3.y;
		r4.xyz = r0.zzz * r4.xyz;
	} else {
		r4.xyz = 0;
	}
	r4.xyz = r4.xyz * reflectivePower.xxx;
	r0.z = dot(r2.xyz, specMapReflectMask.xyz);
	r4.xyz = r0.zzz * r4.xyz;
	r4.xyz = r4.xyz * ColorCorrectTopAndPedReflectScale.www;
	r5 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r6 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r0.z = dot(wrinkleMaskStrengths0, r5);
	r2.x = dot(wrinkleMaskStrengths1, r6);
	r0.z = r0.z + r2.x;
	r2.x = dot(wrinkleMaskStrengths2, r5);
	r2.y = dot(wrinkleMaskStrengths3, r6);
	r2.x = r2.y + r2.x;
	r0.xy = r0.xy + -0.5;
	r0.xy = r0.xy * bumpiness.xx;
	r0.xy = r0.xy + r0.xy;
	r5 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r2.y = -r5.w + 1;
	r2.y = -r5.x + r2.y;
	r3.yw = (r2.yy >= 0) ? r5.wy : r5.xy;
	r3.yw = r3.yw + -0.5;
	r5 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r2.y = -r5.w + 1;
	r2.y = -r5.x + r2.y;
	r5.xy = (r2.yy >= 0) ? r5.wy : r5.xy;
	r5.xy = r5.xy + -0.5;
	r3.yw = r3.yw * 2 + -r0.xy;
	r0.xy = r0.zz * r3.yw + r0.xy;
	r3.yw = r5.xy * 2 + -r0.xy;
	r0.xy = r2.xx * r3.yw + r0.xy;
	r2.x = dot(r0.xy, -r0.xy) + 1;
	r3.y = max(r2.x, 0);
	r2.x = rsqrt(r3.y);
	r0.z = 1 / r2.x;
	r0.xyz = r0.xyz + 1E-05;
	r5.xyz = normalize(r0.xyz);
	r0.xyz = r5.xxx * i.texcoord4.xyz;
	r0.xyz = i.texcoord1.xyz * r5.zzz + r0.xyz;
	r0.xyz = i.texcoord5.xyz * r5.yyy + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r2.x = dot(r0.xyz, r0.xyz);
	r2.x = rsqrt(r2.x);
	r5.xyz = r0.xyz * r2.xxx;
	r2.y = dot(gDirectionalLight.xyz, r5.xyz);
	r2.y = r2.y + SubScatWrap.x;
	r3.x = r3.x + SubScatWrap.x;
	r3.x = 1 / r3.x;
	r2.y = r2.y * r3.x;
	r3.x = max(r2.y, 0);
	r2.y = 1 / SubScatWidth.x;
	r2.y = saturate(r2.y * r3.x);
	r3.y = r2.y * -2 + 3;
	r2.y = r2.y * r2.y;
	r2.y = r2.y * r3.y;
	r3.x = SubScatWidth.x * -r3.z + r3.x;
	r3.y = 1 / -SubScatWidth.x;
	r3.x = saturate(r3.y * r3.x);
	r3.y = r3.x * -2 + 3;
	r3.x = r3.x * r3.x;
	r3.x = r3.x * r3.y;
	r2.y = r2.y * r3.x;
	r3.xyz = r2.yyy * SubColor.xyz;
	r3.xyz = r1.www * r3.xyz;
	r1.xyz = r3.xyz * 0.5 + r1.xyz;
	r1.xyz = r1.xyz * matMaterialColorScale.xxx;
	r3.xyz = r4.xyz * matMaterialColorScale.zzz;
	r1.w = r0.w * matMaterialColorScale.w;
	r2.y = r2.w * matMaterialColorScale.w;
	r4.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r4.xyz = r4.xyz + 1E-05;
	r6.xyz = normalize(r4.xyz);
	r0.xyz = r0.xyz * r2.xxx + 1E-05;
	r4.xyz = normalize(r0.xyz);
	r0.x = dot(r6.xyz, r4.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.z = saturate(r1.w * 5);
	r0.y = r0.z * r0.y;
	r0.z = saturate(r2.y * -0.01 + 1);
	r0.y = r0.y * r0.z;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r0.w * matMaterialColorScale.w + r0.x;
	r0.y = r2.z * 16;
	r0.z = frac(r0.y);
	r0.y = r0.y + -r0.z;
	r0.z = (-r0.z >= 0) ? 0 : 1;
	r0.z = (r2.z >= 0) ? 0 : r0.z;
	r0.y = r0.z + r0.y;
	r4.xy = detailSettings.zw * i.texcoord.xy;
	r0.y = r0.y + 0.5;
	r4.z = r0.y * 0.0625;
	r4 = tex3D(VolumeSampler, r4.xyz);
	r0.yzw = r4.yzx * 2 + -1;
	r1.w = detailSettings.x * i.texcoord2.w;
	r0.w = r0.w * r1.w + 1;
	o.color.xyz = r0.www * r1.xyz;
	r1.xyz = r0.zzz * i.texcoord5.xyz;
	r1.xyz = i.texcoord4.xyz * r0.yyy + r1.xyz;
	r1.xyz = r1.xyz * detailSettings.yyy;
	r1.xyz = r1.xyz * i.texcoord2.www + r5.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r4.xyz = normalize(r1.xyz);
	r0.x = saturate(r0.w * r0.x);
	r1.x = vSkinSweat.x;
	r0.x = SkinParams.x * r1.x + r0.x;
	r2.y = SkinParams.y * r1.x + r2.y;
	r0.yz = r1.xx * vNoiseParams.zw;
	r0.y = r0.w * r0.y + r0.z;
	r2.x = r0.y + r0.x;
	r0 = tex2D(SweatMapSampler, i.texcoord.xy);
	r0.w = -r0.z + vSkinSweat.y;
	r1.xy = r0.zz + -vSkinSweat.zy;
	r0.z = 1 / vSkinSweat.w;
	r0.z = saturate(r0.z * r1.y);
	r1.yz = lerp(r2.xy, vNoiseParams.xy, r0.zz);
	r0.xy = r0.xy + -0.5;
	r0.xy = r0.xy * SkinParams.zz;
	r0.xy = r0.xy + r0.xy;
	r1.w = dot(r0.xy, -r0.xy) + 1;
	r2.z = max(r1.w, 0);
	r1.w = rsqrt(r2.z);
	r1.w = 1 / r1.w;
	r5.xyz = r0.xxx * i.texcoord4.xyz;
	r5.xyz = i.texcoord1.xyz * r1.www + r5.xyz;
	r5.xyz = r0.yyy * i.texcoord5.xyz + r5.xyz;
	r5.xyz = r5.xyz + 1E-05;
	r0.x = dot(r5.xyz, r5.xyz);
	r0.x = rsqrt(r0.x);
	r5.xyz = r5.xyz * r0.xxx + -r4.xyz;
	r0.xyz = r0.zzz * r5.xyz + r4.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r5.xyz = normalize(r0.xyz);
	r0.x = (r1.x >= 0) ? -0 : -1;
	r0.x = (r0.w >= 0) ? -0 : r0.x;
	r0.yzw = (r0.xxx >= 0) ? r4.xyz : r5.xyz;
	r1.xy = (r0.xx >= 0) ? r2.xy : r1.yz;
	r0.x = saturate(gAmbientOcclusionEffect.z);
	r0.x = saturate(r0.x + i.texcoord2.x);
	o.color1.xyz = r0.yzw * 0.5 + 0.5;
	r0.y = saturate(r1.y * 0.0051020407);
	r0.y = rsqrt(r0.y);
	r0.y = 1 / r0.y;
	r0.y = rsqrt(r0.y);
	o.color2.y = 1 / r0.y;
	o.color2.z = r0.x * gAmbientOcclusionEffect.w;
	r0.x = globalScalars.x * i.texcoord2.w;
	r0.yzw = saturate(r3.xyz * 0.0625);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	r0.w = rsqrt(r0.w);
	o.color3.x = 1 / r0.y;
	o.color3.y = 1 / r0.z;
	o.color3.z = 1 / r0.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.x = r1.x;
	o.color2.w = r0.x;
	o.color3.w = gStencil.x;

	return o;
}
