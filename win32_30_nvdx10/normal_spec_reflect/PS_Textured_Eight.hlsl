	r3.xyz = r3.xyz * i.color.xxx;
	r2.x = 1 / gAmbientOcclusionEffect.y;
	r1.yzw = r3.xyz * r2.xxx + r1.yzw;
	r3.x = dot(gLightColR, r6);
	r3.y = dot(gLightColG, r6);
	r3.z = dot(gLightColB, r6);
	r1.yzw = r1.yzw + r3.xyz;
	r3.x = dot(gLightPointColR, r5);
	r3.y = dot(gLightPointColG, r5);
	r3.z = dot(gLightPointColB, r5);
	r1.yzw = r1.yzw + r3.xyz;
	r2.x = dot(r1.yzw, 0.33333334);
	r2.x = r2.x + 0.015;
	r3.x = r0.w * r0.w;
	r3.x = r3.x * r3.x;
	r0.w = r0.w * r3.x;
	r1.x = r1.x + -fresnelRolloff.x;
	r0.w = fresnelRolloff.x * r0.w + r1.x;
	r1.x = dot(r2.yzw, r2.yzw);
	r1.x = rsqrt(r1.x);
	r2.yz = r2.yw * r1.xx + 1;
	r2.yz = r2.yz * -0.5;
	r3 = tex2D(EnvironmentSampler, r2.yz);
	r2.yzw = r0.www * r3.xyz;
	r2.yzw = r2.yzw * reflectivePower.xxx;
	r0.w = dot(r4.xyz, specMapReflectMask.xyz);
	r1.x = dot(r4.xyz, specMapIntMask.xyz);
	r2.yzw = r0.www * r2.yzw;
	r2.yzw = r2.yzw * globalScalars.www;
	r3 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.w = r3.w * i.color.w + -0.01;
	r3.w = r3.w * i.color.w;
	r3.xyz = r3.xyz * r3.xyz;
	r4.x = 1 / r3.w;
	r5.w = r3.w * globalScalars.x;
	r0.w = (r0.w >= 0) ? r4.x : 100;
	r2.yzw = r0.www * r2.yzw;
	r2.xyz = r2.xxx * r2.yzw;
	r0.xyz = r0.xyz * r1.xxx + r2.xyz;
	r0.xyz = r3.xyz * r1.yzw + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
