	r10.x = rsqrt(r9.x);
	r10.y = rsqrt(r9.y);
	r10.z = rsqrt(r9.z);
	r10.w = rsqrt(r9.w);
	r5 = r5 * r10;
	r9 = r2.x * r5;
	r7 = r7 * r10;
	r8 = r8 * r10;
	r9 = r7 * r2.y + r9;
	r9 = r8 * r2.z + r9;
	r10 = r6 * 1.1111112;
	r6 = (r6 >= 0) ? r10 : 0;
	r6 = saturate(r6 * r9);
	r9 = r5 * -gLightDirX;
	r5 = r3.x * r5;
	r5 = r3.y * r7 + r5;
	r7 = r7 * -gLightDirY + r9;
	r7 = r8 * -gLightDirZ + r7;
	r5 = saturate(r3.z * r8 + r5);
	r5 = r5 + 1E-05;
	r8 = gLightConeScale;
	r7 = saturate(r7 * r8 + gLightConeOffset);
	r6 = r6 * r7;
	r7.x = log2(r5.x);
	r7.y = log2(r5.y);
	r7.z = log2(r5.z);
	r7.w = log2(r5.w);
	r5 = r4.w * r7;
	r7.x = exp2(r5.x);
	r7.y = exp2(r5.y);
	r7.z = exp2(r5.z);
	r7.w = exp2(r5.w);
	r5 = r6 * r7;
	r7.x = dot(gLightColR, r5);
	r7.y = dot(gLightColG, r5);
	r7.z = dot(gLightColB, r5);
	r0.xyz = r0.xyz * gDirectionalLight.www + r7.xyz;
	r5 = gLightPointPosX + -i.texcoord6.x;
	r7 = r5 * r5;
	r8 = gLightPointPosY + -i.texcoord6.y;
	r7 = r8 * r8 + r7;
	r9 = gLightPointPosZ + -i.texcoord6.z;
	r7 = r9 * r9 + r7;
	r10 = r7 + 1E-05;
	r7 = saturate(r7 * -gLightPointFallOff + r1.x);
	r7 = r7 * r7;
	r7 = r7 * r7 + -0.1;
	r11.x = rsqrt(r10.x);
	r11.y = rsqrt(r10.y);
	r11.z = rsqrt(r10.z);
	r11.w = rsqrt(r10.w);
	r5 = r5 * r11;
	r10 = r2.x * r5;
	r8 = r8 * r11;
	r9 = r9 * r11;
	r10 = r8 * r2.y + r10;
	r10 = r9 * r2.z + r10;
	r2.x = saturate(r2.z * -0.5 + 0.5);
	r11 = r7 * 1.1111112;
	r7 = (r7 >= 0) ? r11 : 0;
	r7 = saturate(r7 * r10);
	r10 = r5 * -gLightDir2X;
	r5 = r3.x * r5;
	r5 = r3.y * r8 + r5;
	r8 = r8 * -gLightDir2Y + r10;
	r8 = r9 * -gLightDir2Z + r8;
	r5 = saturate(r3.z * r9 + r5);
	r2.yzw = r3.xyz + 1E-05;
	r3 = r5 + 1E-05;
	r5 = gLightConeScale2;
	r5 = saturate(r8 * r5 + gLightConeOffset2);
	r5 = r7 * r5;
	r7.x = log2(r3.x);
	r7.y = log2(r3.y);
	r7.z = log2(r3.z);
	r7.w = log2(r3.w);
	r3 = r4.w * r7;
	r7.x = exp2(r3.x);
	r7.y = exp2(r3.y);
	r7.z = exp2(r3.z);
	r7.w = exp2(r3.w);
	r3 = r5 * r7;
	r7.x = dot(gLightPointColR, r3);
	r7.y = dot(gLightPointColG, r3);
	r7.z = dot(gLightPointColB, r3);
