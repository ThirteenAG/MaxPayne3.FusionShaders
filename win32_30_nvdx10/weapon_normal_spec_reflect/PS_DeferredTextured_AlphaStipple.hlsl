sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s3);
sampler2D SpecSampler : register(s2);
float bumpiness : register(c203);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float goldFactor : register(c210);
float goldFresnelRolloff : register(c207);
float3 goldReflectColorBase : register(c211);
float3 goldReflectColorOverlay : register(c212);
float goldReflectivePower : register(c205);
float3 goldSpecMapIntMask : register(c201);
float goldSpecularFactor : register(c199);
float normFresnelRolloff : register(c206);
float normReflectivePower : register(c204);
float3 normSpecMapIntMask : register(c200);
float normSpecularFactor : register(c198);
float4 specMapExpMask : register(c202);
float3 specMapReflectMask : register(c209);
float4 stipplePattern : register(c62);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float2 vpos : VPOS;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	float3 r5;
	float4 r6;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.w = r0.w * i.color.w;
	r1.x = r0.w * globalScalars.x;
	r1.yz = 0.5 * i.vpos.xy;
	r1.yz = frac(abs(r1.yz));
	r1.yz = (i.vpos.xy >= 0) ? r1.yz : -r1.yz;
	r1.yz = r1.yz + r1.yz;
	r2.xy = frac(r1.yz);
	r1.yz = r1.yz + -r2.xy;
	r1.y = r1.z * 2 + r1.y;
	r2 = r1.y + float4(-0, -1, -2, -3);
	r2 = (-abs(r2) >= 0) ? 1 : 0;
	r1.y = dot(stipplePattern, r2);
	r0.w = r0.w * -globalScalars.x + r1.y;
	r2 = (r0.w >= 0) ? -1 : -0;
	clip(r2);
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r2.w + 1;
	r0.w = -r2.x + r0.w;
	r1.yz = (r0.ww >= 0) ? r2.wy : r2.xy;
	r2.xyz = -r0.xyz + goldReflectColorBase.xyz;
	r0.xyz = goldFactor.xxx * r2.xyz + r0.xyz;
	r1.yz = r1.yz * 2 + -1;
	r1.yz = r1.yz * bumpiness.xx;
	r0.w = dot(r1.yz, -r1.yz) + 1;
	r1.w = max(r0.w, 0);
	r0.w = rsqrt(r1.w);
	r0.w = 1 / r0.w;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r3 = -r2 + 1;
	r2 = goldFactor.x * r3 + r2;
	r1.w = dot(r2, specMapExpMask);
	r3.x = normSpecularFactor.x;
	r2.w = -r3.x + goldSpecularFactor.x;
	r2.w = goldFactor.x * r2.w + r3.x;
	r3.x = r1.w * r2.w;
	r4 = normSpecMapIntMask.xyz;
	r3.yzw = -r4.xyz + goldSpecMapIntMask.xyz;
	r3.yzw = goldFactor.xxx * r3.yzw + r4.xyz;
	o.color2.x = dot(r2.xyz, r3.yzw);
	r1.w = r1.w * -r2.w + 1;
	r3.yzw = r1.yyy * i.texcoord4.xyz;
	r3.yzw = r0.www * i.texcoord1.xyz + r3.yzw;
	r3.yzw = r1.zzz * i.texcoord5.xyz + r3.yzw;
	r3.yzw = r3.yzw + 1E-05;
	r4 = normalize(r3.yzw);
	r3.yzw = 1E-05 + i.texcoord3.xyz;
	r5 = normalize(r3.yzw);
	r0.w = dot(-r5.xyz, r4.xyz);
	r0.w = r0.w + r0.w;
	r3.yzw = r4.xyz * -r0.www + -r5.xyz;
	r3.yzw = r3.yzw + 1E-05;
	r0.w = dot(r3.yzw, r3.yzw);
	r0.w = rsqrt(r0.w);
	r1.yz = r3.yw * r0.ww + 1;
	r1.yz = r1.yz * -0.5;
	r6 = tex2D(EnvironmentSampler, r1.yz);
	r3.yzw = r6.xyz * goldReflectColorOverlay.xyz + -r6.xyz;
	r3.yzw = goldFactor.xxx * r3.yzw + r6.xyz;
	r0.w = saturate(dot(r5.xyz, r4.xyz));
	r5.x = normFresnelRolloff.x;
	r1.y = -r5.x + goldFresnelRolloff.x;
	r1.y = goldFactor.x * r1.y + r5.x;
	r1.z = -r1.y + 1;
	r0.w = -r0.w + 1.00001;
	r2.w = r0.w * r0.w;
	r2.w = r2.w * r2.w;
	r0.w = r0.w * r2.w;
	r0.w = r1.y * r0.w + r1.z;
	r3.yzw = r0.www * r3.yzw;
	r5.x = normReflectivePower.x;
	r0.w = -r5.x + goldReflectivePower.x;
	r0.w = goldFactor.x * r0.w + r5.x;
	r3.yzw = r0.www * r3.yzw;
	r0.w = dot(r2.xyz, specMapReflectMask.xyz);
	r2.xyz = r0.www * r3.yzw;
	r1.z = 1;
	r5.x = goldFactor.x;
	r0.w = lerp(globalScalars.w, r1.z, r5.x);
	r2.xyz = r0.www * r2.xyz;
	r0.w = saturate(-1 + i.color.x);
	o.color.xyz = r0.www * globalScalars2.zzz + r0.xyz;
	o.color1.xyz = r4.xyz * 0.5 + 0.5;
	r0.x = saturate(r3.x * 0.0051020407);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	o.color2.y = (r1.w >= 0) ? 0.26726124 : r0.x;
	o.color2.z = gAmbientOcclusionEffect.w * i.color.x;
	r0.xyz = saturate(r2.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	o.color3.x = 1 / r0.x;
	o.color3.y = 1 / r0.y;
	o.color3.z = 1 / r0.z;
	o.color.w = r1.x;
	o.color1.w = r1.x;
	o.color2.w = r1.x;
	o.color3.w = gStencil.x;

	return o;
}
