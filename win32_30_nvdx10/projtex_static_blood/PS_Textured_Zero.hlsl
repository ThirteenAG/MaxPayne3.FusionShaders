sampler2D BumpSampler : register(s2);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float fresnelRolloff : register(c202);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float reflectivePower : register(c201);
float specularColorFactor : register(c199);
float specularFactor : register(c198);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	r0.xy = saturate(i.texcoord.xy);
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r1.w + 1;
	r0.z = -r1.x + r0.z;
	r0.zw = (r0.zz >= 0) ? r1.wy : r1.xy;
	r1 = tex2D(DiffuseSampler, r0.xy);
	r0.xy = r0.zw * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.z, 0);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r2.xw = float2(1, 0);
	r0.w = max(r2.x, specularFactor.x);
	r3.xyz = r0.xxx * i.texcoord4.xyz;
	r3.xyz = r0.zzz * i.texcoord1.xyz + r3.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r3.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r3.xyz = normalize(r0.xyz);
	if (-reflectivePower.x < r2.w) {
		r0.x = saturate(r0.w * 0.015625);
		r4.w = r0.x * -4 + 4;
		r0.xyz = 1E-05 + i.texcoord3.xyz;
		r5.xyz = normalize(r0.xyz);
		r0.x = dot(-r5.xyz, r3.xyz);
		r0.x = r0.x + r0.x;
		r0.xyz = r3.xyz * -r0.xxx + -r5.xyz;
		r0.xyz = r0.xyz + 1E-05;
		r6.xyz = normalize(r0.xyz);
		r0.x = saturate(r6.z);
		r0.x = r0.x + 1;
		r0.x = r0.x + r0.x;
		r0.x = 1 / r0.x;
		r0.xy = r6.xy * r0.xx + 0.5;
		r4.xy = -r0.xy + 1;
		r4.z = 0;
		r4 = tex2Dlod(DynamicEnvironmentSampler, r4);
		r0.xyz = r4.xyz * r4.xyz;
		r0.xyz = r0.xyz * 16;
		r2.y = saturate(dot(r5.xyz, r3.xyz));
		r2.x = r2.x + -fresnelRolloff.x;
		r2.y = -r2.y + 1.00001;
		r2.z = r2.y * r2.y;
		r2.z = r2.z * r2.z;
		r2.y = r2.z * r2.y;
		r2.x = fresnelRolloff.x * r2.y + r2.x;
		r0.xyz = r0.xyz * r2.xxx;
	} else {
		r0.xyz = 0;
	}
	r0.xyz = r0.xyz * reflectivePower.xxx;
	r0.xyz = r0.xyz * globalScalars.www;
	r1.xyz = r1.xyz * r1.xyz;
	r2.x = r1.w * i.color.w;
	r2.yzw = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r2.yzw);
	r2.y = saturate(r3.z * -0.5 + 0.5);
	r5.xyz = gLightAmbient0.xyz;
	r5.xyz = -r5.xyz + gLightAmbient1.xyz;
	r2.yzw = r2.yyy * r5.xyz + gLightAmbient0.xyz;
	r2.yzw = r2.yzw * gAmbientOcclusionEffect.yyy;
	r2.yzw = r2.yzw * i.color.xxx;
	r3.w = 1 / gAmbientOcclusionEffect.y;
	r4.w = dot(-r4.xyz, r3.xyz);
	r4.w = r4.w + r4.w;
	r4.xyz = r3.xyz * -r4.www + -r4.xyz;
	r3.x = dot(r3.xyz, -gDirectionalLight.xyz);
	r3.y = saturate(r3.x + -0.25);
	r3.y = r3.y * 1.3333334;
	r3.z = saturate(dot(-gDirectionalLight.xyz, r4.xyz));
	r3.z = r3.z + 1E-05;
	r0.w = r0.w + 1E-05;
	r4.x = pow(r3.z, r0.w);
	r0.w = saturate(r3.x * 2 + -0.5);
	r0.w = r0.w * r4.x;
	r4.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r4.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r4.xyz;
	r4.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r4.xyz;
	r4.xyz = r4.xyz + gShadowMatrix[3].xyz;
	r3.xz = r4.xy + -gShadowParam18192021.zw;
	r5.xy = r3.xx + -gCascadeXMaxThresholds.xy;
	r5.zw = -r3.xx + gCascadeXMinThresholds.xy;
	r5 = (r5 >= 0) ? 1 : 0;
	r6.xy = r3.zz + -gCascadeYMaxThresholds.xy;
	r6.zw = -r3.zz + gCascadeYMinThresholds.xy;
	r6 = (r6 >= 0) ? 1 : 0;
	r5.xy = r5.zw + r5.xy;
	r5.xy = r6.xy + r5.xy;
	r5.yz = saturate(r6.zw + r5.xy);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r4.xyz = r4.zxy * r6.zxy + r7.zxy;
	r4.x = saturate(r4.x);
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r3.xz = saturate(abs(r3.xz) * 4 + r5.xy);
	r4.w = max(r3.x, r3.z);
	r3.x = -r4.x + 1;
	r5 = tex2D(gShadowZSamplerDir, r4.yz);
	r3.x = r3.x + -r5.x;
	r3.x = (r3.x >= 0) ? -1 : -0;
	r3.x = r3.x + r4.w;
	r3.x = saturate(r3.x + 1);
	r4.xyz = r3.xxx * gDirectionalColour.xyz;
	r5.xyz = r0.www * r4.xyz;
	r3.xyz = r3.yyy * r4.xyz;
	r4.xyz = r5.xyz * gDirectionalLight.www;
	r2.yzw = r2.yzw * r3.www + r3.xyz;
	r0.w = r1.w * i.color.w + -0.01;
	r1.w = 1 / r2.x;
	r0.w = (r0.w >= 0) ? r1.w : 100;
	r0.xyz = r0.www * r0.xyz;
	r0.w = dot(r2.yzw, 0.33333334);
	r0.w = r0.w + 0.015;
	r0.xyz = r0.www * r0.xyz;
	r0.xyz = r4.xyz * specularColorFactor.xxx + r0.xyz;
	r0.xyz = r1.xyz * r2.yzw + r0.xyz;
	r1.w = r2.x * globalScalars.x;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r2.x = 1E-05 + i.texcoord9.y;
	r3.x = pow(r0.w, r2.x);
	r2.xyz = r0.xyz * r3.xxx;
	r0.xyz = r0.xyz * -r3.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r2.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r2.x = r2.x * deSatContrastGamma.x;
	r1.xyz = lerp(r0.www, r0.xyz, r2.xxx);
	o = min(r1, float4(8, 8, 8, 1));

	return o;
}
