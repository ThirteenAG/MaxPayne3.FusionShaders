sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s3);
sampler2D PuddleMaskSampler : register(s2);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c203);
float bumpiness : register(c199);
float fresnelRolloff : register(c201);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
float4 gWaterGlobals : register(c64);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float parallaxScaleBias : register(c196);
float reflectivePower : register(c200);
float specularColorFactor : register(c198);
float specularFactor : register(c197);
float4 stipplePattern : register(c62);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float2 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
	float2 vpos : VPOS;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float3 r8;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.xyz = 1E-05 + i.texcoord7.xyz;
	r0.z = dot(r0.xyz, r0.xyz);
	r0.z = rsqrt(r0.z);
	r0.xy = r0.zz * r0.xy;
	r1.yw = float2(0.5, -1);
	r0.z = r1.y * parallaxScaleBias.x;
	r0.z = r0.w * parallaxScaleBias.x + -r0.z;
	r0.xy = r0.zz * r0.xy + i.texcoord.xy;
	r2 = tex2D(DiffuseSampler, r0.xy);
	r0.z = r2.w * i.color.w;
	r0.w = r0.z * globalScalars.x;
	r1.xy = 0.5 * i.vpos.xy;
	r1.xy = frac(abs(r1.xy));
	r1.xy = (i.vpos.xy >= 0) ? r1.xy : -r1.xy;
	r1.xy = r1.xy + r1.xy;
	r3.xy = frac(r1.xy);
	r1.xy = r1.xy + -r3.xy;
	r1.x = r1.y * 2 + r1.x;
	r3 = r1.x + float4(-0, -1, -2, -3);
	r3 = (-abs(r3) >= 0) ? 1 : 0;
	r1.x = dot(stipplePattern, r3);
	r0.z = r0.z * -globalScalars.x + r1.x;
	r3 = (r0.z >= 0) ? -1 : -0;
	clip(r3);
	r3 = tex2D(BumpSampler, r0.xy);
	r0.xy = r3.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r1.x = dot(r0.xy, -r0.xy) + 1;
	r2.w = max(r1.x, 0);
	r1.x = rsqrt(r2.w);
	r0.z = 1 / r1.x;
	r4.y = max(-r1.w, specularFactor.x);
	r1.xy = WetDarken.ww * i.texcoord6.xy;
	r5 = tex2D(PuddleMaskSampler, r1.xy);
	r1.x = r5.x + gWaterGlobals.y;
	r1.x = saturate(r1.x + -i.color.y);
	r5.xyz = r2.xyz * WetDarken.xyz;
	r1.z = gWaterGlobals.z;
	r6.x = lerp(specularColorFactor.x, r1.z, r1.x);
	r6.y = lerp(r4.y, gWaterGlobals.w, r1.x);
	r1.yz = 0.3 * i.texcoord6.xy;
	r7 = tex2D(WaterRainRippleNormalSampler, r1.yz);
	r7.xyz = r7.xyz * 2 + -1;
	r7.xyz = r7.xyz * i.texcoord1.zzz + -r0.xyz;
	r7.xyz = r1.xxx * r7.xyz + r0.xyz;
	r7.xyz = r7.xyz + 1E-05;
	r8 = normalize(r7.xyz);
	r1.y = saturate(gWaterGlobals.y);
	r7.xyz = r2.xyz * WetDarken.xyz + -r2.xyz;
	r7.xyz = r1.yyy * r7.xyz + r2.xyz;
	r5.xyz = (-r1.xxx >= 0) ? r7.xyz : r5.xyz;
	r7.xyz = (-r1.xxx >= 0) ? r0.xyz : r8.xyz;
	r4.x = specularColorFactor.x;
	r1.xy = (-r1.xx >= 0) ? r4.xy : r6.xy;
	r0.xyz = (-i.color.yyy >= 0) ? r0.xyz : r7.xyz;
	r2.xyz = (-i.color.yyy >= 0) ? r2.xyz : r5.xyz;
	r1.xy = (-i.color.yy >= 0) ? r4.xy : r1.xy;
	r4 = r0.xxx * i.texcoord4.xyz;
	r4 = r0.zzz * i.texcoord1.xyz + r4.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r4.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r4 = normalize(r0.xyz);
	r0.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r0.xyz);
	r0.x = dot(-r5.xyz, r4.xyz);
	r0.x = r0.x + r0.x;
	r0.xyz = r4.xyz * -r0.xxx + -r5.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r0.y = dot(r0.xyz, r0.xyz);
	r0.y = rsqrt(r0.y);
	r0.xy = r0.xz * r0.yy + 1;
	r0.xy = r0.xy * -0.5;
	r6 = tex2D(EnvironmentSampler, r0.xy);
	r0.x = saturate(dot(r5.xyz, r4.xyz));
	r0.y = -r1.w + -fresnelRolloff.x;
	r0.x = -r0.x + 1.00001;
	r0.z = r0.x * r0.x;
	r0.z = r0.z * r0.z;
	r0.x = r0.z * r0.x;
	r0.x = fresnelRolloff.x * r0.x + r0.y;
	r0.xyz = r0.xxx * r6.xyz;
	r0.xyz = r0.xyz * reflectivePower.xxx;
	r0.xyz = r0.xyz * globalScalars.www;
	r1.z = dot(r3.xy, r3.xy) + -0.002;
	r1.z = (r1.z >= 0) ? 1 : 0;
	r1.w = r1.z * i.color.x;
	o.color2.x = r1.z * r1.x;
	r1.x = saturate(i.color.x * r1.z + -1);
	r1.x = r1.x * globalScalars2.z;
	o.color.xyz = r2.xyz * r1.zzz + r1.xxx;
	o.color1.xyz = r4.xyz * 0.5 + 0.5;
	r1.x = saturate(r1.y * 0.0051020407);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = rsqrt(r1.x);
	o.color2.y = 1 / r1.x;
	o.color2.z = r1.w * gAmbientOcclusionEffect.w;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	o.color3.x = 1 / r0.x;
	o.color3.y = 1 / r0.y;
	o.color3.z = 1 / r0.z;
	o.color.w = r0.w;
	o.color1.w = r0.w;
	o.color2.w = r0.w;
	o.color3.w = gStencil.x;

	return o;
}
