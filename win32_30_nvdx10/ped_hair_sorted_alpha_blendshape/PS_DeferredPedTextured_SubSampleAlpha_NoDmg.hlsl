sampler2D AnisoNoiseSpecSampler : register(s3);
sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
float HardAlphaBlend : register(c196);
sampler2D SpecSampler : register(s2);
sampler3D VolumeSampler : register(s4);
float2 WetAnisotropicSpecular : register(c218);
float4 WetAnisotropicSpecularColour : register(c217);
float4 anisotropicSpecularColour : register(c207);
float2 anisotropicSpecularExponent : register(c206);
float2 anisotropicSpecularIntensity : register(c205);
float bumpiness : register(c199);
float4 detailSettings : register(c210);
float4 gAmbientOcclusionEffect : register(c63);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c204);
float4 specMapExpMask : register(c203);
float3 specMapIntMask : register(c202);
float specularFactor : register(c201);
float4 specularNoiseMapUVScaleFactor : register(c209);
float4 vHairParams : register(c219);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
	float2 vpos : VPOS;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	r0.xyz = gViewInverse[3].xyz + -i.texcoord7.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0 = specularNoiseMapUVScaleFactor * i.texcoord.xyxy;
	r2 = tex2D(AnisoNoiseSpecSampler, r0.zw);
	r0 = tex2D(AnisoNoiseSpecSampler, r0.xy);
	r0.yz = r2.xy * 2 + -1;
	r2.xyz = r0.yyy * i.texcoord1.xyz;
	r3.xyz = 1E-05 + i.texcoord4.xyz;
	r4 = normalize(r3.xyz);
	r2.xyz = r2.xyz * 0.1 + r4.xyz;
	r0.yzw = i.texcoord1.xyz * r0.zzz + r4.xyz;
	r0.yzw = r0.yzw + 1E-05;
	r3.xyz = normalize(r0.yzw);
	r0.yzw = r2.xyz + 1E-05;
	r2.xyz = normalize(r0.yzw);
	r0.y = dot(r1.xyz, r2.xyz);
	r0.z = dot(r1.xyz, r3.xyz);
	r0.w = r0.y * -r0.y + 1;
	r1.x = max(r0.w, 0);
	r0.w = rsqrt(r1.x);
	r0.w = 1 / r0.w;
	r1.x = 1E-05;
	r1.xyz = r1.xxx + gViewInverse[2].xyz;
	r4 = normalize(r1.xyz);
	r1.x = dot(r4.xyz, r2.xyz);
	r1.y = dot(r4.xyz, r3.xyz);
	r1.z = r1.x * -r1.x + 1;
	r0.y = r0.y * r1.x;
	r2.x = max(r1.z, 0);
	r1.x = rsqrt(r2.x);
	r1.x = 1 / r1.x;
	r0.y = r0.w * r1.x + -r0.y;
	r0.y = abs(r0.y) + 1E-05;
	r2.xy = anisotropicSpecularExponent.xy;
	r1.xz = -r2.xy + WetAnisotropicSpecular.xy;
	r1.xz = vHairParams.xx * r1.xz + r2.xy;
	r1.xz = r1.xz + float2(8.00001, 16.00001);
	r2.x = pow(r0.y, r1.x);
	r0.y = r0.z * -r0.z + 1;
	r0.z = r0.z * r1.y;
	r0.w = r1.y * -r1.y + 1;
	r1.x = max(r0.w, 0);
	r0.w = rsqrt(r1.x);
	r0.w = 1 / r0.w;
	r1.x = max(r0.y, 0);
	r0.y = rsqrt(r1.x);
	r0.y = 1 / r0.y;
	r0.y = r0.y * r0.w + -r0.z;
	r0.y = abs(r0.y) + 1E-05;
	r2.y = pow(r0.y, r1.z);
	r0.y = r2.y + r2.x;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r1.w + 1;
	r0.z = -r1.x + r0.z;
	r0.zw = (r0.zz >= 0) ? r1.wy : r1.xy;
	r0.zw = r0.zw * 2 + -1;
	r0.zw = r0.zw * bumpiness.xx;
	r1.x = dot(r0.zw, -r0.zw) + 1;
	r2.x = max(r1.x, 0);
	r1.x = rsqrt(r2.x);
	r1.x = 1 / r1.x;
	r1.yzw = r0.zzz * i.texcoord4.xyz;
	r1.xyz = r1.xxx * i.texcoord1.xyz + r1.yzw;
	r1.xyz = r0.www * i.texcoord5.xyz + r1.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r0.z = dot(r1.xyz, r1.xyz);
	r0.z = rsqrt(r0.z);
	r2.xzw = r1.xyz * r0.zzz + 1E-05;
	r1.xyz = r0.zzz * r1.xyz;
	r3.xyz = normalize(r2.xzw);
	r2.xzw = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r2.xzw = r2.xzw + 1E-05;
	r4 = normalize(r2.xzw);
	r0.z = dot(r4.xyz, r3.xyz);
	r0.w = r0.z * 1.5 + 1;
	r0.z = (-r0.z >= 0) ? r0.w : 1;
	r0.w = r0.z * i.texcoord2.y;
	r3 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r3.xyz, specMapIntMask.xyz);
	r2.x = r1.w * matMaterialColorScale.w;
	r2.x = saturate(r2.x * 5);
	r0.w = r0.w * r2.x;
	r2.x = dot(r3, specMapExpMask);
	r2.x = r2.x * specularFactor.x;
	r3.x = max(1, r2.x);
	r2.x = r3.x * matMaterialColorScale.w;
	r2.z = saturate(r2.x * -0.01 + 1);
	r2.x = r2.x * 0.0051020407;
	r2.x = saturate(r2.x);
	r2.x = rsqrt(r2.x);
	r2.x = 1 / r2.x;
	r2.x = rsqrt(r2.x);
	o.color2.y = 1 / r2.x;
	r0.w = r0.w * r2.z;
	r0.z = (r0.z >= 0) ? r0.w : 0;
	r0.z = r1.w * matMaterialColorScale.w + r0.z;
	r0.w = r3.z * 16;
	r1.w = frac(r0.w);
	r0.w = r0.w + -r1.w;
	r1.w = (-r1.w >= 0) ? 0 : 1;
	r1.w = (r3.z >= 0) ? 0 : r1.w;
	r0.w = r0.w + r1.w;
	r0.w = r0.w + 0.5;
	r3.z = r0.w * 0.0625;
	r3.xy = detailSettings.zw * i.texcoord.xy;
	r3 = tex3D(VolumeSampler, r3.xyz);
	r2.xzw = r3.yzx * 2 + -1;
	r0.w = detailSettings.x * i.texcoord2.w;
	r0.w = r2.w * r0.w + 1;
	r0.z = saturate(r0.w * r0.z);
	r0.y = r0.y * r0.z;
	r1.w = 0.2;
	r0.z = r1.w + anisotropicSpecularIntensity.x;
	r0.y = r0.z * r0.y;
	o.color2.x = r0.x * r0.y;
	r0.xyz = anisotropicSpecularColour.xyz;
	r3.xyz = -r0.xyz + WetAnisotropicSpecularColour.xyz;
	r0.xyz = vHairParams.xxx * r3.xyz + r0.xyz;
	r0.xyz = r2.yyy * r0.xyz;
	r0.xyz = r0.xyz * 0.5;
	r3 = tex2D(DiffuseSampler, i.texcoord.xy);
	r3.xyz = r3.xyz * matMaterialColorScale.xxx;
	r1.w = r3.w * i.texcoord2.w;
	r0.xyz = r3.xyz * r0.www + r0.xyz;
	r0.w = 1.5 * i.texcoord2.x;
	o.color.xyz = r0.www * r0.xyz;
	r0.xyz = r2.zzz * i.texcoord5.xyz;
	r0.xyz = i.texcoord4.xyz * r2.xxx + r0.xyz;
	r0.xyz = r0.xyz * detailSettings.yyy;
	r0.xyz = r0.xyz * i.texcoord2.www + r1.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	o.color1.xyz = r1.xyz * 0.5 + 0.5;
	r0.x = saturate(gAmbientOcclusionEffect.z);
	r0.x = saturate(r0.x + i.texcoord2.x);
	o.color2.z = r0.x * gAmbientOcclusionEffect.w;
	r0.x = i.vpos.y + i.vpos.x;
	r0.y = frac(r0.x);
	r0.z = (-r0.y >= 0) ? 0 : 1;
	r0.y = r0.x + -r0.y;
	r0.x = (r0.x >= 0) ? 0 : r0.z;
	r0.x = r0.x + r0.y;
	r0.yz = (r0.xx >= 0) ? float2(2, 0.5) : float2(-2, -0.5);
	r0.x = r0.z * r0.x;
	r0.x = frac(r0.x);
	r0.x = r0.x * r0.y;
	r0.y = frac(r0.x);
	r0.z = (-r0.y >= 0) ? 0 : 1;
	r0.y = r0.x + -r0.y;
	r0.x = (r0.x >= 0) ? 0 : r0.z;
	r0.x = r0.x + r0.y;
	r0.z = -0.003921569;
	r0.y = r1.w * globalScalars.x + r0.z;
	r0.z = r1.w * globalScalars.x;
	r0.y = r0.y * 10.039371 + -r0.z;
	r0.y = HardAlphaBlend.x * r0.y + r0.z;
	r0.yw = -r0.yy + float2(0.9, 0.003921569);
	r0.yw = (r0.yw >= 0) ? 1 : 0;
	r0.x = (-abs(r0.x) >= 0) ? r0.y : 0;
	r0.x = r0.w + r0.x;
	r1 = (-r0.x >= 0) ? -0 : -1;
	clip(r1);
	o.color.w = r0.z;
	o.color1.w = r0.z;
	o.color2.w = r0.z;
	o.color3 = 0;

	return o;
}
