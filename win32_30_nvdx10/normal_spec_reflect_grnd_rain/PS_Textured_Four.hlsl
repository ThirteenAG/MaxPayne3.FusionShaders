sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s4);
sampler2D PuddleMaskSampler : register(s2);
sampler2D SpecSampler : register(s3);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c204);
float bumpiness : register(c199);
float4 deSatContrastGamma : register(c46);
float fresnelRolloff : register(c201);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 gWaterGlobals : register(c64);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float reflectivePower : register(c200);
float4 specMapExpMask : register(c198);
float3 specMapIntMask : register(c197);
float3 specMapReflectMask : register(c202);
float specularFactor : register(c196);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float3 r8;
	float3 r9;
	r0.xy = 0.3 * i.texcoord6.xy;
	r0 = tex2D(WaterRainRippleNormalSampler, r0.xy);
	r0.xyz = r0.xyz * 2 + -1;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r1.w + 1;
	r0.w = -r1.x + r0.w;
	r1.xy = (r0.ww >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r0.w = dot(r1.xy, -r1.xy) + 1;
	r1.w = max(r0.w, 0);
	r0.w = rsqrt(r1.w);
	r1.z = 1 / r0.w;
	r0.xyz = r0.xyz * i.texcoord1.zzz + -r1.xyz;
	r2.xy = WetDarken.ww * i.texcoord6.xy;
	r2 = tex2D(PuddleMaskSampler, r2.xy);
	r0.w = r2.x + gWaterGlobals.y;
	r0.w = saturate(r0.w + -i.color.y);
	r0.xyz = r0.www * r0.xyz + r1.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r2.xyz = normalize(r0.xyz);
	r0.xyz = (-r0.www >= 0) ? r1.xyz : r2.xyz;
	r0.xyz = (-i.color.yyy >= 0) ? r1.xyz : r0.xyz;
	r1.xyz = r0.xxx * i.texcoord4.xyz;
	r1.xyz = r0.zzz * i.texcoord1.xyz + r1.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r1.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r2 = gLightPosX + -i.texcoord6.x;
	r3 = r2 * r2;
	r4 = gLightPosY + -i.texcoord6.y;
	r3 = r4 * r4 + r3;
	r5 = gLightPosZ + -i.texcoord6.z;
	r3 = r5 * r5 + r3;
	r6 = r3 + 1E-05;
	r0.x = 1;
	r3 = saturate(r3 * -gLightFallOff + r0.x);
	r3 = r3 * r3;
	r3 = r3 * r3 + -0.1;
	r7.x = rsqrt(r6.x);
	r7.y = rsqrt(r6.y);
	r7.z = rsqrt(r6.z);
	r7.w = rsqrt(r6.w);
	r2 = r2 * r7;
	r6 = r1.x * r2;
	r4 = r4 * r7;
	r5 = r5 * r7;
	r6 = r4 * r1.y + r6;
	r6 = r5 * r1.z + r6;
	r7 = r3 * 1.1111112;
	r3 = (r3 >= 0) ? r7 : 0;
	r3 = saturate(r3 * r6);
	r6 = r2 * -gLightDirX;
	r6 = r4 * -gLightDirY + r6;
	r6 = r5 * -gLightDirZ + r6;
	r7 = gLightConeScale;
	r6 = saturate(r6 * r7 + gLightConeOffset);
	r3 = r3 * r6;
	r6.xyz = 1E-05 + i.texcoord3.xyz;
	r7.xyz = normalize(r6.xyz);
	r0.y = dot(-r7.xyz, r1.xyz);
	r0.y = r0.y + r0.y;
	r6.xyz = r1.xyz * -r0.yyy + -r7.xyz;
	r0.y = saturate(dot(r7.xyz, r1.xyz));
	r0.y = -r0.y + 1.00001;
	r2 = r2 * r6.x;
	r2 = r6.y * r4 + r2;
	r2 = saturate(r6.z * r5 + r2);
	r2 = r2 + 1E-05;
	r4.x = log2(r2.x);
	r4.y = log2(r2.y);
	r4.z = log2(r2.z);
	r4.w = log2(r2.w);
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.z = dot(r2, specMapExpMask);
	r0.z = r0.z * specularFactor.x;
	r5.y = max(1, r0.z);
	r5.x = dot(r2.xyz, specMapIntMask.xyz);
	r0.z = dot(r2.xyz, specMapReflectMask.xyz);
	r2.xy = lerp(r5.xy, gWaterGlobals.zw, r0.ww);
	r2.xy = (-r0.ww >= 0) ? r5.xy : r2.xy;
	r2.xy = (-i.color.yy >= 0) ? r5.xy : r2.xy;
	r1.w = r2.y * 0.25 + 1E-05;
	r4 = r4 * r1.w;
	r5.x = exp2(r4.x);
	r5.y = exp2(r4.y);
	r5.z = exp2(r4.z);
	r5.w = exp2(r4.w);
	r4 = r3 * r5;
	r5.x = dot(gLightColR, r4);
	r5.y = dot(gLightColG, r4);
	r5.z = dot(gLightColB, r4);
	r4.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r4.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r4.xyz;
	r4.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r4.xyz;
	r4.xyz = r4.xyz + gShadowMatrix[3].xyz;
	r2.zw = r4.xy + -gShadowParam18192021.zw;
	r7.xy = r2.zz + -gCascadeXMaxThresholds.xy;
	r7.zw = -r2.zz + gCascadeXMinThresholds.xy;
	r7 = (r7 >= 0) ? 1 : 0;
	r7.xy = r7.zw + r7.xy;
	r7.zw = r2.ww + -gCascadeYMaxThresholds.xy;
	r7.zw = (r7.zw >= 0) ? 1 : 0;
	r7.xy = r7.zw + r7.xy;
	r7.zw = -r2.ww + gCascadeYMinThresholds.xy;
	r7.zw = (r7.zw >= 0) ? 1 : 0;
	r7.yz = saturate(r7.zw + r7.xy);
	r7.x = 1;
	r8.x = dot(r7.xyz, gShadowParam0123.xyz);
	r8.y = dot(r7.xyz, gShadowParam4567.xyz);
	r8.z = dot(r7.xyz, gCascadeZScales.xyz);
	r9.x = dot(r7.xyz, gShadowParam891113.xyz);
	r9.y = dot(r7.xyz, gShadowParam14151617.xyz);
	r9.z = dot(r7.xyz, gCascadeZOffsets.xyz);
	r4.xyz = r4.zxy * r8.zxy + r9.zxy;
	r4.x = saturate(r4.x);
	r7 = tex2D(gShadowZSamplerDir, r4.yz);
	r1.w = -r4.x + 1;
	r1.w = -r7.x + r1.w;
	r1.w = (r1.w >= 0) ? -1 : -0;
	r4.x = -gCascadeXMinThresholds.w;
	r4.y = -gCascadeXMaxThresholds.w;
	r2.zw = saturate(abs(r2.zw) * 4 + r4.xy);
	r4.x = max(r2.z, r2.w);
	r1.w = r1.w + r4.x;
	r1.w = saturate(r1.w + 1);
	r4.xyz = r1.www * gDirectionalColour.xyz;
	r1.w = saturate(dot(-gDirectionalLight.xyz, r6.xyz));
	r6.xyz = r6.xyz + 1E-05;
	r1.w = r1.w + 1E-05;
	r2.y = r2.y + 1E-05;
	r4.w = pow(r1.w, r2.y);
	r1.x = dot(r1.xyz, -gDirectionalLight.xyz);
	r1.y = saturate(r1.z * -0.5 + 0.5);
	r1.z = saturate(r1.x * 2 + -0.5);
	r1.x = saturate(r1.x + -0.25);
	r1.x = r1.x * 1.3333334;
	r2.yzw = r1.xxx * r4.xyz;
	r1.x = r1.z * r4.w;
	r1.xzw = r1.xxx * r4.xyz;
	r1.xzw = r1.xzw * gDirectionalLight.www + r5.xyz;
	r4.xyz = gLightAmbient0.xyz;
	r4.xyz = -r4.xyz + gLightAmbient1.xyz;
	r4.xyz = r1.yyy * r4.xyz + gLightAmbient0.xyz;
	r4.xyz = r4.xyz * gAmbientOcclusionEffect.yyy;
	r4.xyz = r4.xyz * i.color.xxx;
	r1.y = 1 / gAmbientOcclusionEffect.y;
	r2.yzw = r4.xyz * r1.yyy + r2.yzw;
	r4.x = dot(gLightColR, r3);
	r4.y = dot(gLightColG, r3);
	r4.z = dot(gLightColB, r3);
	r2.yzw = r2.yzw + r4.xyz;
	r1.y = dot(r2.yzw, 0.33333334);
	r1.y = r1.y + 0.015;
	r3.x = dot(r6.xyz, r6.xyz);
	r3.x = rsqrt(r3.x);
	r3.xy = r6.xz * r3.xx + 1;
	r3.xy = r3.xy * -0.5;
	r3 = tex2D(EnvironmentSampler, r3.xy);
	r3.w = r0.y * r0.y;
	r3.w = r3.w * r3.w;
	r0.y = r0.y * r3.w;
	r0.x = r0.x + -fresnelRolloff.x;
	r0.x = fresnelRolloff.x * r0.y + r0.x;
	r3.xyz = r0.xxx * r3.xyz;
	r3.xyz = r3.xyz * reflectivePower.xxx;
	r0.xyz = r0.zzz * r3.xyz;
	r0.xyz = r0.xyz * globalScalars.www;
	r3 = tex2D(DiffuseSampler, i.texcoord.xy);
	r4.x = r3.w * i.color.w;
	r4.y = 1 / r4.x;
	r5.w = r4.x * globalScalars.x;
	r3.w = r3.w * i.color.w + -0.01;
	r3.w = (r3.w >= 0) ? r4.y : 100;
	r0.xyz = r0.xyz * r3.www;
	r0.xyz = r1.yyy * r0.xyz;
	r0.xyz = r1.xzw * r2.xxx + r0.xyz;
	r1.x = saturate(gWaterGlobals.y);
	r1.yzw = r3.xyz * WetDarken.xyz + -r3.xyz;
	r1.xyz = r1.xxx * r1.yzw + r3.xyz;
	r4.xyz = r3.xyz * WetDarken.xyz;
	r1.xyz = (-r0.www >= 0) ? r1.xyz : r4.xyz;
	r1.xyz = (-i.color.yyy >= 0) ? r3.xyz : r1.xyz;
	r1.xyz = r1.xyz * r1.xyz;
	r0.xyz = r1.xyz * r2.yzw + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r5.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o = min(r5, float4(8, 8, 8, 1));

	return o;
}
