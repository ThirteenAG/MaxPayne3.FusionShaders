sampler2D DiffuseSampler : register(s0);
sampler2D DiffuseSampler2 : register(s2);
sampler2D DirtSampler : register(s3);
sampler2D SpecSampler : register(s4);
float4 deSatContrastGamma : register(c46);
float3 dirtColor : register(c200);
float dirtLevel : register(c199);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float3 matDiffuseColor : register(c197);
float4 matDiffuseColor2 : register(c198);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float specularColorFactor : register(c202);
float specularFactor : register(c201);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float4 texcoord6 : TEXCOORD6;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1 = tex2D(DiffuseSampler2, i.texcoord.zw);
	r2.xyz = 1E-05 + i.texcoord1.xyz;
	r3.xyz = normalize(r2.xyz);
	r2 = tex2D(SpecSampler, i.texcoord.zw);
	r2.w = dot(r2, specMapExpMask);
	r2.x = dot(r2.xyz, specMapIntMask.xyz);
	r2.x = r2.x * specularColorFactor.x;
	r4.xyz = float3(1E-05, 1, 0);
	r2.y = r2.w * -specularFactor.x + r4.y;
	r5.xyz = r0.xyz * r0.xyz;
	r5.xyz = r5.xyz * matDiffuseColor.xyz;
	r1.w = r1.w * matDiffuseColor2.w;
	r1.xyz = r1.xyz * matDiffuseColor2.xyz + -r5.xyz;
	r0.xyz = r1.www * r1.xyz + r5.xyz;
	r0 = r0 * i.texcoord6;
	r1.x = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.y = gAmbientOcclusionEffect.y;
	r1.y = r1.y * globalScalars.z;
	r1.x = r1.y * r1.x;
	if (-dirtLevel.x < r4.z) {
		r5 = tex2D(DirtSampler, i.texcoord.xy);
		r1.y = r5.x * dirtLevel.x;
		r6.x = r5.x * -dirtLevel.x + r4.y;
		r6.yzw = lerp(r0.xyz, dirtColor.xyz, r1.yyy);
		r7 = r0.xxyz * float4(0, 1, 1, 1) + float4(1, 0, 0, 0);
		r5 = (-r5.x >= 0) ? r7 : r6;
		r0.xyz = r5.yzw;
	} else {
		r5.x = 1;
	}
	r1.y = r2.x * r5.x;
	r4.yzw = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r4.yzw);
	r1.z = saturate(r3.z * -0.5 + 0.5);
	r6.xyz = gLightAmbient0.xyz;
	r4.yzw = -r6.xyz + gLightAmbient1.xyz;
	r4.yzw = r1.zzz * r4.yzw + gLightAmbient0.xyz;
	r4.yzw = r4.yzw * gAmbientOcclusionEffect.yyy;
	r1.xzw = r1.xxx * r4.yzw;
	r2.x = 1 / gAmbientOcclusionEffect.y;
	r2.z = dot(-r5.xyz, r3.xyz);
	r2.z = r2.z + r2.z;
	r4.yzw = r3.xyz * -r2.zzz + -r5.xyz;
	r2.z = dot(r3.xyz, -gDirectionalLight.xyz);
	r3.x = saturate(r2.z + -0.25);
	r3.x = r3.x * 1.3333334;
	r3.y = saturate(dot(-gDirectionalLight.xyz, r4.yzw));
	r3.y = r3.y + 1E-05;
	r2.w = r2.w * specularFactor.x + r4.x;
	r2.y = (r2.y >= 0) ? 1.00001 : r2.w;
	r4.x = pow(r3.y, r2.y);
	r2.y = saturate(r2.z * 2 + -0.5);
	r2.y = r2.y * r4.x;
	r3.yzw = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r3.yzw = i.texcoord2.xxx * gShadowMatrix[0].xyz + r3.yzw;
	r3.yzw = i.texcoord2.zzz * gShadowMatrix[2].xyz + r3.yzw;
	r3.yzw = r3.yzw + gShadowMatrix[3].xyz;
	r2.zw = r3.yz + -gShadowParam18192021.zw;
	r4.xy = r2.zz + -gCascadeXMaxThresholds.xy;
	r4.zw = -r2.zz + gCascadeXMinThresholds.xy;
	r4 = (r4 >= 0) ? 1 : 0;
	r5.xy = r2.ww + -gCascadeYMaxThresholds.xy;
	r5.zw = -r2.ww + gCascadeYMinThresholds.xy;
	r5 = (r5 >= 0) ? 1 : 0;
	r4.xy = r4.zw + r4.xy;
	r4.xy = r5.xy + r4.xy;
	r4.yz = saturate(r5.zw + r4.xy);
	r4.x = 1;
	r5.x = dot(r4.xyz, gShadowParam0123.xyz);
	r5.y = dot(r4.xyz, gShadowParam4567.xyz);
	r5.z = dot(r4.xyz, gCascadeZScales.xyz);
	r6.x = dot(r4.xyz, gShadowParam891113.xyz);
	r6.y = dot(r4.xyz, gShadowParam14151617.xyz);
	r6.z = dot(r4.xyz, gCascadeZOffsets.xyz);
	r3.yzw = r3.wyz * r5.zxy + r6.zxy;
	r3.y = saturate(r3.y);
	r4.x = -gCascadeXMinThresholds.w;
	r4.y = -gCascadeXMaxThresholds.w;
	r2.zw = saturate(abs(r2.zw) * 4 + r4.xy);
	r4.x = max(r2.z, r2.w);
	r2.z = -r3.y + 1;
	r5 = tex2D(gShadowZSamplerDir, r3.zw);
	r2.z = r2.z + -r5.x;
	r2.z = (r2.z >= 0) ? -1 : -0;
	r2.z = r2.z + r4.x;
	r2.z = saturate(r2.z + 1);
	r3.yzw = r2.zzz * gDirectionalColour.xyz;
	r2.yzw = r2.yyy * r3.yzw;
	r3.xyz = r3.xxx * r3.yzw;
	r2.yzw = r2.yzw * gDirectionalLight.www;
	r1.xzw = r1.xzw * r2.xxx + r3.xyz;
	r2.xyz = r1.yyy * r2.yzw;
	r0.xyz = r0.xyz * r1.xzw + r2.xyz;
	o.w = r0.w * globalScalars.x;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.w = r1.z + -65504;
	r1.z = -r1.z + 1;
	r1.z = (r1.w >= 0) ? -65503 : r1.z;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.xyz = lerp(r1.xxx, r0.xyz, r0.www);
	r0.xyz = saturate(r2.xyz * 0.000625);
	r0.x = rsqrt(r0.x);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	o.x = 1 / r0.x;
	o.y = 1 / r0.y;
	o.z = 1 / r0.z;

	return o;
}
