sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
sampler2D gDeferredLightShadowMap0 : register(s4);
sampler2D gDeferredLightShadowMap1 : register(s5);
float4 gDeferredProjParams : register(c216);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float4 r6;
	float4 r7;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r0.z = r1.x * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2.xyz = r1.yzx + -i.texcoord4.yzx;
	r3.xyz = r2.xyz * float3(1, -1, 1);
	r0.zw = (-r2.zz >= 0) ? float2(1, 0) : float2(0, 1);
	r3.w = -abs(r3.z);
	r1.w = dot(r3.xyw, r3.xyw);
	r1.w = rsqrt(r1.w);
	r1.w = 1 / r1.w;
	r2.x = abs(r3.z) + r1.w;
	r2.x = 1 / r2.x;
	r2.xy = r2.xx * r3.xy;
	r2.xy = r2.xy * float2(0.5, -0.5) + 0.5;
	r2 = tex2D(gDeferredLightShadowMap1, r2.xy);
	r2.z = rsqrt(i.texcoord4.w);
	r2.z = 1 / r2.z;
	r1.w = saturate(r1.w * r2.z);
	r0.z = dot(r2.xy, r0.zw) + -r1.w;
	r2.xyz = -r1.xyz + i.texcoord4.xyz;
	r0.w = dot(r2.xyz, r2.xyz);
	r1.w = r0.w + 1E-05;
	r0.w = saturate(r0.w * -i.texcoord4.w + 1);
	r0.w = r0.w * r0.w;
	r0.w = r0.w * r0.w + -0.1;
	r1.w = rsqrt(r1.w);
	r2.xyz = r1.www * r2.xyz;
	r3 = tex2D(GBufferTextureSampler1, r0.xy);
	r3.xyz = r3.xyz * 2 + -1;
	r4.xyz = normalize(r3.xyz);
	r1.w = saturate(dot(r2.xyz, r4.xyz));
	r3.xyz = r1.www * i.texcoord5.xyz;
	r1.w = dot(r2.xyz, i.texcoord6.xyz);
	r2.w = i.texcoord5.w;
	r1.w = saturate(-r1.w * r2.w + i.texcoord6.w);
	r3.xyz = r1.www * r3.xyz;
	r1.w = r0.w * 1.1111112;
	r3.xyz = r1.www * r3.xyz;
	r3.xyz = (r0.zzz >= 0) ? r3.xyz : 0;
	r3.xyz = (r0.www >= 0) ? r3.xyz : 0;
	r5 = 1E-05 + i.texcoord.xyz;
	r6.xyz = normalize(r5.xyz);
	r0.z = dot(r6.xyz, r4.xyz);
	r0.z = r0.z + r0.z;
	r5 = r4.xyz * -r0.zzz + r6.xyz;
	r0.z = saturate(dot(r2.xyz, r5.xyz));
	r0.z = r0.z + 1E-05;
	r2 = tex2D(GBufferTextureSampler2, r0.xy);
	r6 = tex2D(GBufferTextureSampler0, r0.xy);
	r0.xyw = r6.xyz * r6.xyz;
	r1.w = r2.y * r2.y;
	r1.w = r1.w * r1.w;
	r1.w = r1.w * 196 + 1E-05;
	r2.y = pow(r0.z, r1.w);
	r2.yzw = r2.yyy * r3.xyz;
	r6.xyz = r1.yzx + -i.texcoord1.yzx;
	r1.xyz = -r1.xyz + i.texcoord1.xyz;
	r7.xyz = r6.xyz * float3(1, -1, 1);
	r6.xy = (-r6.zz >= 0) ? float2(1, 0) : float2(0, 1);
	r7.w = -abs(r7.z);
	r0.z = dot(r7.xyw, r7.xyw);
	r0.z = rsqrt(r0.z);
	r0.z = 1 / r0.z;
	r3.w = abs(r7.z) + r0.z;
	r3.w = 1 / r3.w;
	r6.zw = r3.ww * r7.xy;
	r6.zw = r6.zw * float2(0.5, -0.5) + 0.5;
	r7 = tex2D(gDeferredLightShadowMap0, r6.zw);
	r3.w = rsqrt(i.texcoord1.w);
	r3.w = 1 / r3.w;
	r0.z = saturate(r0.z * r3.w);
	r0.z = dot(r7.xy, r6.xy) + -r0.z;
	r3.w = dot(r1.xyz, r1.xyz);
	r4.w = r3.w + 1E-05;
	r3.w = saturate(r3.w * -i.texcoord1.w + 1);
	r3.w = r3.w * r3.w;
	r3.w = r3.w * r3.w + -0.1;
	r4.w = rsqrt(r4.w);
	r1.xyz = r1.xyz * r4.www;
	r4.x = saturate(dot(r1.xyz, r4.xyz));
	r4.xyz = r4.xxx * i.texcoord2.xyz;
	r4.w = dot(r1.xyz, i.texcoord3.xyz);
	r1.x = saturate(dot(r1.xyz, r5.xyz));
	r1.x = r1.x + 1E-05;
	r5.x = pow(r1.x, r1.w);
	r1.w = i.texcoord2.w;
	r1.x = saturate(-r4.w * r1.w + i.texcoord3.w);
	r1.xyz = r1.xxx * r4.xyz;
	r1.w = r3.w * 1.1111112;
	r1.xyz = r1.www * r1.xyz;
	r1.xyz = (r0.zzz >= 0) ? r1.xyz : 0;
	r1.xyz = (r3.www >= 0) ? r1.xyz : 0;
	r2.yzw = r1.xyz * r5.xxx + r2.yzw;
	r1.xyz = r3.xyz + r1.xyz;
	r2.xyz = r2.yzw * r2.xxx;
	o.xyz = r0.xyw * r1.xyz + r2.xyz;
	o.w = 1;

	return o;
}
