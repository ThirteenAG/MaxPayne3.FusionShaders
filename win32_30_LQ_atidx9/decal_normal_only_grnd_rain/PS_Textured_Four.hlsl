sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D PuddleMaskSampler : register(s2);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c202);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 gWaterGlobals : register(c64);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float specularColorFactor : register(c199);
float specularFactor : register(c198);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	r0.xy = 0.3 * i.texcoord6.xy;
	r0 = tex2D(WaterRainRippleNormalSampler, r0.xy);
	r0.xyz = r0.xyz * 2 + -1;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r1.w + 1;
	r0.w = -r1.x + r0.w;
	r1.xy = (r0.ww >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r0.w = dot(r1.xy, -r1.xy) + 1;
	r1.w = max(r0.w, 0);
	r0.w = rsqrt(r1.w);
	r1.z = 1 / r0.w;
	r0.xyz = r0.xyz * i.texcoord1.zzz + -r1.xyz;
	r2.xy = WetDarken.ww * i.texcoord6.xy;
	r2 = tex2D(PuddleMaskSampler, r2.xy);
	r0.w = r2.x + gWaterGlobals.y;
	r0.w = saturate(r0.w + -i.color.y);
	r0.xyz = r0.www * r0.xyz + r1.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r2.xyz = normalize(r0.xyz);
	r0.xyz = (-r0.www >= 0) ? r1.xyz : r2.xyz;
	r0.xyz = (-i.color.yyy >= 0) ? r1.xyz : r0.xyz;
	r1.xyz = r0.xxx * i.texcoord4.xyz;
	r1.xyz = r0.zzz * i.texcoord1.xyz + r1.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r1.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r2 = gLightPosX + -i.texcoord6.x;
	r3 = r2 * r2;
	r4 = gLightPosY + -i.texcoord6.y;
	r3 = r4 * r4 + r3;
	r5 = gLightPosZ + -i.texcoord6.z;
	r3 = r5 * r5 + r3;
	r6 = r3 + 1E-05;
	r0.x = 1;
	r3 = saturate(r3 * -gLightFallOff + r0.x);
	r3 = r3 * r3;
	r3 = r3 * r3 + -0.1;
	r7.x = rsqrt(r6.x);
	r7.y = rsqrt(r6.y);
	r7.z = rsqrt(r6.z);
	r7.w = rsqrt(r6.w);
	r2 = r2 * r7;
	r6 = r1.x * r2;
	r4 = r4 * r7;
	r5 = r5 * r7;
	r6 = r4 * r1.y + r6;
	r6 = r5 * r1.z + r6;
	r7 = r3 * 1.1111112;
	r3 = (r3 >= 0) ? r7 : 0;
	r3 = saturate(r3 * r6);
	r6 = r2 * -gLightDirX;
	r6 = r4 * -gLightDirY + r6;
	r6 = r5 * -gLightDirZ + r6;
	r7 = gLightConeScale;
	r6 = saturate(r6 * r7 + gLightConeOffset);
	r3 = r3 * r6;
	r0.z = gWaterGlobals.z;
	r6.x = lerp(specularColorFactor.x, r0.z, r0.w);
	r7.y = max(r0.x, specularFactor.x);
	r6.y = lerp(r7.y, gWaterGlobals.w, r0.w);
	r7.x = specularColorFactor.x;
	r0.xy = (-r0.ww >= 0) ? r7.xy : r6.xy;
	r0.xy = (-i.color.yy >= 0) ? r7.xy : r0.xy;
	r0.z = r0.y * 0.25 + 1E-05;
	r6.xyz = 1E-05 + i.texcoord3.xyz;
	r7.xyz = normalize(r6.xyz);
	r1.w = dot(-r7.xyz, r1.xyz);
	r1.w = r1.w + r1.w;
	r6.xyz = r1.xyz * -r1.www + -r7.xyz;
	r2 = r2 * r6.x;
	r2 = r6.y * r4 + r2;
	r2 = saturate(r6.z * r5 + r2);
	r1.w = saturate(dot(-gDirectionalLight.xyz, r6.xyz));
	r1.w = r1.w + 1E-05;
	r2 = r2 + 1E-05;
	r4.x = log2(r2.x);
	r4.y = log2(r2.y);
	r4.z = log2(r2.z);
	r4.w = log2(r2.w);
	r2 = r0.z * r4;
	r4.x = exp2(r2.x);
	r4.y = exp2(r2.y);
	r4.z = exp2(r2.z);
	r4.w = exp2(r2.w);
	r2 = r3 * r4;
	r4.x = dot(gLightColR, r2);
	r4.y = dot(gLightColG, r2);
	r4.z = dot(gLightColB, r2);
	r0.y = r0.y + 1E-05;
	r2.x = pow(r1.w, r0.y);
	r0.y = dot(r1.xyz, -gDirectionalLight.xyz);
	r0.z = saturate(r1.z * -0.5 + 0.5);
	r1.x = saturate(r0.y * 2 + -0.5);
	r0.y = saturate(r0.y + -0.25);
	r0.y = r0.y * 1.3333334;
	r1.x = r1.x * r2.x;
	r1.yzw = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r1.yzw = i.texcoord6.xxx * gShadowMatrix[0].xyz + r1.yzw;
	r1.yzw = i.texcoord6.zzz * gShadowMatrix[2].xyz + r1.yzw;
	r1.yzw = r1.yzw + gShadowMatrix[3].xyz;
	r2.xy = r1.yz + -gShadowParam18192021.zw;
	r2.zw = r2.xx + -gCascadeXMaxThresholds.xy;
	r2.zw = (r2.zw >= 0) ? 1 : 0;
	r5.xy = -r2.xx + gCascadeXMinThresholds.xy;
	r5.xy = (r5.xy >= 0) ? 1 : 0;
	r2.zw = r2.zw + r5.xy;
	r5.xy = r2.yy + -gCascadeYMaxThresholds.xy;
	r5.xy = (r5.xy >= 0) ? 1 : 0;
	r2.zw = r2.zw + r5.xy;
	r5.xy = -r2.yy + gCascadeYMinThresholds.xy;
	r5.xy = (r5.xy >= 0) ? 1 : 0;
	r5.yz = saturate(r2.zw + r5.xy);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r1.yzw = r1.wyz * r6.zxy + r7.zxy;
	r1.y = saturate(r1.y);
	r5 = tex2D(gShadowZSamplerDir, r1.zw);
	r1.y = -r1.y + 1;
	r1.y = -r5.x + r1.y;
	r1.y = (r1.y >= 0) ? -1 : -0;
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r1.zw = saturate(abs(r2.xy) * 4 + r5.xy);
	r2.x = max(r1.z, r1.w);
	r1.y = r1.y + r2.x;
	r1.y = saturate(r1.y + 1);
	r1.yzw = r1.yyy * gDirectionalColour.xyz;
	r2.xyz = r1.xxx * r1.yzw;
	r1.xyz = r0.yyy * r1.yzw;
	r2.xyz = r2.xyz * gDirectionalLight.www + r4.xyz;
	r2.xyz = r0.xxx * r2.xyz;
	r4.xyz = gLightAmbient0.xyz;
	r4.xyz = -r4.xyz + gLightAmbient1.xyz;
	r0.xyz = r0.zzz * r4.xyz + gLightAmbient0.xyz;
	r0.xyz = r0.xyz * gAmbientOcclusionEffect.yyy;
	r0.xyz = r0.xyz * i.color.xxx;
	r1.w = 1 / gAmbientOcclusionEffect.y;
	r0.xyz = r0.xyz * r1.www + r1.xyz;
	r1.x = dot(gLightColR, r3);
	r1.y = dot(gLightColG, r3);
	r1.z = dot(gLightColB, r3);
	r0.xyz = r0.xyz + r1.xyz;
	r1.x = saturate(gWaterGlobals.y);
	r3 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.yzw = r3.xyz * WetDarken.xyz + -r3.xyz;
	r1.xyz = r1.xxx * r1.yzw + r3.xyz;
	r4.xyz = r3.xyz * WetDarken.xyz;
	r1.xyz = (-r0.www >= 0) ? r1.xyz : r4.xyz;
	r1.xyz = (-i.color.yyy >= 0) ? r3.xyz : r1.xyz;
	r1.xyz = r1.xyz * r1.xyz;
	r0.xyz = r1.xyz * r0.xyz + r2.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	r2.w = globalScalars.x * i.color.w;
	o = min(r2, float4(8, 8, 8, 1));

	return o;
}
