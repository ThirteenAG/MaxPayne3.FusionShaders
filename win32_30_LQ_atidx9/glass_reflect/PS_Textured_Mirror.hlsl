	r1.x = r1.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	r0.xyz = saturate(r2.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;

	return o;
}
