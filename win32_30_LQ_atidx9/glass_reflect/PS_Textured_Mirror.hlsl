	r10 = (r10 >= 0) ? r11 : 0;
	r11.x = rsqrt(r7.x);
	r11.y = rsqrt(r7.y);
	r11.z = rsqrt(r7.z);
	r11.w = rsqrt(r7.w);
	r7 = r8 * r11;
	r6 = r6 * r11;
	r8 = r9 * r11;
	r9 = r5.x * r6;
	r9 = r7 * r5.y + r9;
	r9 = r8 * r5.z + r9;
	r9 = saturate(r10 * r9);
	r10 = r6 * -gLightDirX;
	r6 = r3.x * r6;
	r6 = r3.y * r7 + r6;
	r7 = r7 * -gLightDirY + r10;
	r7 = r8 * -gLightDirZ + r7;
	r6 = saturate(r3.z * r8 + r6);
	r6 = r6 + 1E-05;
	r8 = gLightConeScale;
	r7 = saturate(r7 * r8 + gLightConeOffset);
	r7 = r9 * r7;
	r8.x = log2(r6.x);
	r8.y = log2(r6.y);
	r8.z = log2(r6.z);
	r8.w = log2(r6.w);
	r6 = r0.w * r8;
	r8.x = exp2(r6.x);
	r8.y = exp2(r6.y);
	r8.z = exp2(r6.z);
	r8.w = exp2(r6.w);
	r6 = r7 * r8;
	r8.x = dot(gLightColR, r6);
	r8.y = dot(gLightColG, r6);
	r8.z = dot(gLightColB, r6);
	r1.xyz = r1.xyz * gDirectionalLight.www + r8.xyz;
	r6 = gLightPointPosX + -i.texcoord6.x;
	r8 = r6 * r6;
	r9 = gLightPointPosY + -i.texcoord6.y;
	r8 = r9 * r9 + r8;
	r10 = gLightPointPosZ + -i.texcoord6.z;
	r8 = r10 * r10 + r8;
	r11 = r8 + 1E-05;
	r8 = saturate(r8 * -gLightPointFallOff + r2.y);
	r8 = r8 * r8;
	r8 = r8 * r8 + -0.1;
	r12.x = rsqrt(r11.x);
	r12.y = rsqrt(r11.y);
	r12.z = rsqrt(r11.z);
	r12.w = rsqrt(r11.w);
	r6 = r6 * r12;
	r11 = r5.x * r6;
	r9 = r9 * r12;
	r10 = r10 * r12;
	r11 = r9 * r5.y + r11;
	r11 = r10 * r5.z + r11;
	r1.w = saturate(r5.z * -0.5 + 0.5);
	r5 = r8 * 1.1111112;
	r5 = (r8 >= 0) ? r5 : 0;
	r5 = saturate(r5 * r11);
	r8 = r6 * -gLightDir2X;
	r6 = r3.x * r6;
	r6 = r3.y * r9 + r6;
	r3 = saturate(r3.z * r10 + r6);
	r3 = r3 + 1E-05;
	r6 = r9 * -gLightDir2Y + r8;
	r6 = r10 * -gLightDir2Z + r6;
	r8 = gLightConeScale2;
	r6 = saturate(r6 * r8 + gLightConeOffset2);
	r5 = r5 * r6;
	r6.x = log2(r3.x);
	r6.y = log2(r3.y);
	r6.z = log2(r3.z);
	r6.w = log2(r3.w);
	r3 = r0.w * r6;
	r6.x = exp2(r3.x);
	r6.y = exp2(r3.y);
	r6.z = exp2(r3.z);
	r6.w = exp2(r3.w);
	r3 = r5 * r6;
	r6.x = dot(gLightPointColR, r3);
	r6.y = dot(gLightPointColG, r3);
	r6.z = dot(gLightPointColB, r3);
	r1.xyz = r1.xyz + r6.xyz;
	r1.xyz = r1.xyz * specularColorFactor.xxx;
	r3.xyz = gLightAmbient0.xyz;
	r3.xyz = -r3.xyz + gLightAmbient1.xyz;
	r3.xyz = r1.www * r3.xyz + gLightAmbient0.xyz;
	r3.xyz = r3.xyz * gAmbientOcclusionEffect.yyy;
	r0.w = saturate(AmbientLightingParams.x * -r2.z + r2.y);
	r0.w = saturate(r0.w + 0.2);
	r0.w = r0.w * AmbientLightingParams.y;
	r0.w = i.color.x * r0.w + -i.color.x;
	r0.w = gAmbientOcclusionEffect.x * r0.w + i.color.x;
	r2.xyz = r3.xyz * r0.www + r4.xyz;
	r3.x = dot(gLightColR, r7);
	r3.y = dot(gLightColG, r7);
	r3.z = dot(gLightColB, r7);
	r2.xyz = r2.xyz + r3.xyz;
	r3.x = dot(gLightPointColR, r5);
	r3.y = dot(gLightPointColG, r5);
	r3.z = dot(gLightPointColB, r5);
	r2.xyz = r2.xyz + r3.xyz;
	r0.xyz = r0.xyz * r2.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
