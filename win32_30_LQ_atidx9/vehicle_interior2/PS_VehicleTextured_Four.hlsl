float specularFactor : register(c199);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float4 texcoord6 : TEXCOORD6;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	float3 r8;
	float3 r9;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.xyz = r0.xyz * r0.xyz;
	r0.xyz = r1.xyz * matDiffuseColor.xyz;
	r0 = r0 * i.texcoord6;
	o.w = r0.w * globalScalars.x;
	r1 = gLightPosX + -i.texcoord2.x;
	r2 = r1 * r1;
	r3 = gLightPosY + -i.texcoord2.y;
	r2 = r3 * r3 + r2;
	r4 = gLightPosZ + -i.texcoord2.z;
	r2 = r4 * r4 + r2;
	r5 = r2 + 1E-05;
	r6.y = 1;
	r2 = saturate(r2 * -gLightFallOff + r6.y);
	r2 = r2 * r2;
	r2 = r2 * r2 + -0.1;
	r6.x = rsqrt(r5.x);
	r6.y = rsqrt(r5.y);
	r6.z = rsqrt(r5.z);
	r6.w = rsqrt(r5.w);
	r1 = r1 * r6;
	r5 = r1 * -gLightDirX;
	r3 = r3 * r6;
	r4 = r4 * r6;
	r5 = r3 * -gLightDirY + r5;
	r5 = r4 * -gLightDirZ + r5;
	r6 = gLightConeScale;
	r5 = saturate(r5 * r6 + gLightConeOffset);
	r6 = r2 * 1.1111112;
	r2 = (r2 >= 0) ? r6 : 0;
	r6.xyz = 1E-05 + i.texcoord1.xyz;
	r7 = normalize(r6.xyz);
	r6 = r1 * r7.x;
	r6 = r3 * r7.y + r6;
	r6 = r4 * r7.z + r6;
	r2 = saturate(r2 * r6);
	r2 = r2 * r5;
	r5.xyz = 1E-05 + i.texcoord3.xyz;
	r6.xyz = normalize(r5.xyz);
	r0.w = dot(-r6.xyz, r7.xyz);
	r0.w = r0.w + r0.w;
	r5.xyz = r7.xyz * -r0.www + -r6.xyz;
	r1 = r1 * r5.x;
	r1 = r5.y * r3 + r1;
	r1 = saturate(r5.z * r4 + r1);
	r0.w = saturate(dot(-gDirectionalLight.xyz, r5.xyz));
	r0.w = r0.w + 1E-05;
	r1 = r1 + 1E-05;
	r3.x = log2(r1.x);
	r3.y = log2(r1.y);
	r3.z = log2(r1.z);
	r3.w = log2(r1.w);
	r1 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r1, specMapExpMask);
	r1.x = dot(r1.xyz, specMapIntMask.xyz);
	r1.x = r1.x * specularColorFactor.x;
	r1.y = r1.w * specularFactor.x;
	r4.x = max(1, r1.y);
	r1.y = r4.x * 0.25 + 1E-05;
	r1.z = r4.x + 1E-05;
	r4.x = pow(r0.w, r1.z);
	r3 = r3 * r1.y;
	r5.x = exp2(r3.x);
	r5.y = exp2(r3.y);
	r5.z = exp2(r3.z);
	r5.w = exp2(r3.w);
	r3 = r2 * r5;
	r5.x = dot(gLightColR, r3);
	r5.y = dot(gLightColG, r3);
	r5.z = dot(gLightColB, r3);
	r1.yzw = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r1.yzw = i.texcoord2.xxx * gShadowMatrix[0].xyz + r1.yzw;
	r1.yzw = i.texcoord2.zzz * gShadowMatrix[2].xyz + r1.yzw;
	r1.yzw = r1.yzw + gShadowMatrix[3].xyz;
	r3.xy = r1.yz + -gShadowParam18192021.zw;
	r3.zw = r3.xx + -gCascadeXMaxThresholds.xy;
	r3.zw = (r3.zw >= 0) ? 1 : 0;
	r4.yz = -r3.xx + gCascadeXMinThresholds.xy;
	r4.yz = (r4.yz >= 0) ? 1 : 0;
	r3.zw = r3.zw + r4.yz;
	r4.yz = r3.yy + -gCascadeYMaxThresholds.xy;
	r4.yz = (r4.yz >= 0) ? 1 : 0;
	r3.zw = r3.zw + r4.yz;
	r4.yz = -r3.yy + gCascadeYMinThresholds.xy;
	r4.yz = (r4.yz >= 0) ? 1 : 0;
	r6.yz = saturate(r3.zw + r4.yz);
	r6.x = 1;
	r8.x = dot(r6.xyz, gShadowParam0123.xyz);
	r8.y = dot(r6.xyz, gShadowParam4567.xyz);
	r8.z = dot(r6.xyz, gCascadeZScales.xyz);
	r9.x = dot(r6.xyz, gShadowParam891113.xyz);
	r9.y = dot(r6.xyz, gShadowParam14151617.xyz);
	r9.z = dot(r6.xyz, gCascadeZOffsets.xyz);
	r1.yzw = r1.wyz * r8.zxy + r9.zxy;
	r1.y = saturate(r1.y);
	r6 = tex2D(gShadowZSamplerDir, r1.zw);
	r0.w = -r1.y + 1;
	r0.w = -r0.w + r6.x;
	r0.w = (r0.w >= 0) ? 0 : 0.33333334;
	r6.x = -gCascadeXMinThresholds.w;
	r6.y = -gCascadeXMaxThresholds.w;
	r1.yz = saturate(abs(r3.xy) * 4 + r6.xy);
	r3.x = max(r1.y, r1.z);
	r0.w = r0.w + r3.x;
	r0.w = r0.w + -0.4;
	r0.w = saturate(r0.w * 1.6666666);
	r1.y = r0.w * -2 + 3;
	r0.w = r0.w * r0.w;
	r0.w = r0.w * r1.y;
	r1.yzw = r0.www * gDirectionalColour.xyz;
	r0.w = dot(r7.xyz, -gDirectionalLight.xyz);
	r3.x = saturate(r7.z * -0.5 + 0.5);
	r3.y = saturate(r0.w * 2 + -0.5);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r4.yzw = r0.www * r1.yzw;
	r0.w = r3.y * r4.x;
	r1.yzw = r0.www * r1.yzw;
	r1.yzw = r1.yzw * gDirectionalLight.www + r5.xyz;
	r1.xyz = r1.xxx * r1.yzw;
	r5.xyz = gLightAmbient0.xyz;
	r3.yzw = -r5.xyz + gLightAmbient1.xyz;
	r3.xyz = r3.xxx * r3.yzw + gLightAmbient0.xyz;
	r3.xyz = r3.xyz * gAmbientOcclusionEffect.yyy;
	r0.w = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r5.y = gAmbientOcclusionEffect.y;
	r1.w = r5.y * globalScalars.z;
	r0.w = r0.w * r1.w;
	r3.xyz = r0.www * r3.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r3.xyz = r3.xyz * r0.www + r4.yzw;
	r4.x = dot(gLightColR, r2);
	r4.y = dot(gLightColG, r2);
	r4.z = dot(gLightColB, r2);
	r2.xyz = r3.xyz + r4.xyz;
	r0.xyz = r0.xyz * r2.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.y = -r1.x + 1;
	r1.x = r1.y * gDepthFxParams.y + r1.x;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = r0.w * -1.442695;
	r1.y = exp2(r1.y);
	r1.z = r1.y + -65504;
	r1.y = -r1.y + 1;
	r1.y = (r1.z >= 0) ? -65503 : r1.y;
	r1.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r1.y = r1.z * r1.y;
	r1.y = r1.y * r1.x;
	r0.w = (r0.w >= 0) ? r1.x : r1.y;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.xyz = -r0.www + r0.xyz;
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	o.xyz = r1.xxx * r0.xyz + r0.www;

	return o;
}
