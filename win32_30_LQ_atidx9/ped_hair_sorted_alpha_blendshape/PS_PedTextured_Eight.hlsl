sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s2);
float bumpiness : register(c199);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c204);
float4 specMapExpMask : register(c203);
float3 specMapIntMask : register(c202);
float specularFactor : register(c201);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float3 r8;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.w = r0.w * i.texcoord7.w;
	r0.xyz = r0.xyz * r0.xyz;
	o.w = r0.w * globalScalars.x;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r1.w + 1;
	r0.w = -r1.x + r0.w;
	r1.xy = (r0.ww >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r0.w = dot(r1.xy, -r1.xy) + 1;
	r1.z = max(r0.w, 0);
	r0.w = rsqrt(r1.z);
	r0.w = 1 / r0.w;
	r1.xzw = r1.xxx * i.texcoord4.xyz;
	r1.xzw = r0.www * i.texcoord1.xyz + r1.xzw;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r1.xzw;
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r1 = gLightPosX + -i.texcoord2.x;
	r3 = r1 * r1;
	r4 = gLightPosY + -i.texcoord2.y;
	r3 = r4 * r4 + r3;
	r5 = gLightPosZ + -i.texcoord2.z;
	r3 = r5 * r5 + r3;
	r6 = r3 + 1E-05;
	r7.x = 1;
	r3 = saturate(r3 * -gLightFallOff + r7.x);
	r3 = r3 * r3;
	r3 = r3 * r3 + -0.1;
	r7.x = rsqrt(r6.x);
	r7.y = rsqrt(r6.y);
	r7.z = rsqrt(r6.z);
	r7.w = rsqrt(r6.w);
	r1 = r1 * r7;
	r6 = r2.x * r1;
	r4 = r4 * r7;
	r5 = r5 * r7;
	r6 = r4 * r2.y + r6;
	r6 = r5 * r2.z + r6;
	r7 = r3 * 1.1111112;
	r3 = (r3 >= 0) ? r7 : 0;
	r3 = saturate(r3 * r6);
	r6 = r1 * -gLightDirX;
	r6 = r4 * -gLightDirY + r6;
	r6 = r5 * -gLightDirZ + r6;
	r7 = gLightConeScale;
	r6 = saturate(r6 * r7 + gLightConeOffset);
	r3 = r3 * r6;
	r6.xyz = 1E-05 + i.texcoord3.xyz;
	r7.xyz = normalize(r6.xyz);
	r0.w = dot(-r7.xyz, r2.xyz);
	r0.w = r0.w + r0.w;
	r6.xyz = r2.xyz * -r0.www + -r7.xyz;
	r1 = r1 * r6.x;
	r1 = r6.y * r4 + r1;
	r1 = saturate(r6.z * r5 + r1);
	r0.w = saturate(dot(-gDirectionalLight.xyz, r6.xyz));
	r0.w = r0.w + 1E-05;
	r1 = r1 + 1E-05;
	r4.x = log2(r1.x);
	r4.y = log2(r1.y);
	r4.z = log2(r1.z);
	r4.w = log2(r1.w);
	r1 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r1, specMapExpMask);
	r1.x = dot(r1.xyz, specMapIntMask.xyz);
	r1.y = r1.w * specularFactor.x;
	r2.w = max(1, r1.y);
	r1.y = r2.w * 0.25 + 1E-05;
	r1.z = r2.w + 1E-05;
	r2.w = pow(r0.w, r1.z);
	r4 = r4 * r1.y;
	r5.x = exp2(r4.x);
	r5.y = exp2(r4.y);
	r5.z = exp2(r4.z);
	r5.w = exp2(r4.w);
	r4 = r3 * r5;
	r5.x = dot(gLightColR, r4);
	r5.y = dot(gLightColG, r4);
	r5.z = dot(gLightColB, r4);
	r0.w = dot(r2.xyz, -gDirectionalLight.xyz);
	r1.y = saturate(r2.z * -0.5 + 0.5);
	r0.w = saturate(r0.w + -0.25);
	r1.z = saturate(r0.w * 2 + -0.5);
	r0.w = r0.w * 1.3333334;
	r1.z = r1.z * r2.w;
	r2.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r2.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r2.xyz;
	r2.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r2.xyz;
	r2.xyz = r2.xyz + gShadowMatrix[3].xyz;
	r4.xy = r2.xy + -gShadowParam18192021.zw;
	r4.zw = r4.xx + -gCascadeXMaxThresholds.xy;
	r4.zw = (r4.zw >= 0) ? 1 : 0;
	r6.xy = -r4.xx + gCascadeXMinThresholds.xy;
	r6.xy = (r6.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r6.xy;
	r6.xy = r4.yy + -gCascadeYMaxThresholds.xy;
	r6.xy = (r6.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r6.xy;
	r6.xy = -r4.yy + gCascadeYMinThresholds.xy;
	r6.xy = (r6.xy >= 0) ? 1 : 0;
	r6.yz = saturate(r4.zw + r6.xy);
	r6.x = 1;
	r7.x = dot(r6.xyz, gShadowParam0123.xyz);
	r7.y = dot(r6.xyz, gShadowParam4567.xyz);
	r7.z = dot(r6.xyz, gCascadeZScales.xyz);
	r8.x = dot(r6.xyz, gShadowParam891113.xyz);
	r8.y = dot(r6.xyz, gShadowParam14151617.xyz);
	r8.z = dot(r6.xyz, gCascadeZOffsets.xyz);
	r2.xyz = r2.zxy * r7.zxy + r8.zxy;
	r2.x = saturate(r2.x);
	r6 = tex2D(gShadowZSamplerDir, r2.yz);
	r1.w = -r2.x + 1;
	r1.w = -r1.w + r6.x;
	r1.w = (r1.w >= 0) ? 0 : 0.33333334;
	r2.x = -gCascadeXMinThresholds.w;
	r2.y = -gCascadeXMaxThresholds.w;
	r2.xy = saturate(abs(r4.xy) * 4 + r2.xy);
	r4.x = max(r2.x, r2.y);
	r1.w = r1.w + r4.x;
	r1.w = r1.w + -0.4;
	r1.w = saturate(r1.w * 1.6666666);
	r2.x = r1.w * -2 + 3;
	r1.w = r1.w * r1.w;
	r1.w = r1.w * r2.x;
	r2.xyz = r1.www * gDirectionalColour.xyz;
	r4.xyz = r1.zzz * r2.xyz;
	r2.xyz = r0.www * r2.xyz;
	r4.xyz = r4.xyz * gDirectionalLight.www + r5.xyz;
	r1.xzw = r1.xxx * r4.xyz;
	r4.xyz = gLightAmbient0.xyz;
	r4.xyz = -r4.xyz + gLightAmbient1.xyz;
	r4.xyz = r1.yyy * r4.xyz + gLightAmbient0.xyz;
	r4.xyz = r4.xyz * gAmbientOcclusionEffect.yyy;
	r4.xyz = r4.xyz * i.texcoord7.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r2.xyz = r4.xyz * r0.www + r2.xyz;
	r4.x = dot(gLightColR, r3);
	r4.y = dot(gLightColG, r3);
	r4.z = dot(gLightColB, r3);
	r2.xyz = r2.xyz + r4.xyz;
	r0.xyz = r0.xyz * r2.xyz + r1.xzw;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.y = -r1.x + 1;
	r1.x = r1.y * gDepthFxParams.y + r1.x;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = r0.w * -1.442695;
	r1.y = exp2(r1.y);
	r1.z = r1.y + -65504;
	r1.y = -r1.y + 1;
	r1.y = (r1.z >= 0) ? -65503 : r1.y;
	r1.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r1.y = r1.z * r1.y;
	r1.y = r1.y * r1.x;
	r0.w = (r0.w >= 0) ? r1.x : r1.y;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o.xyz = r2.xyz * matMaterialColorScale.xxx;

	return o;
}
