float4 wrinkleMaskStrengths1 : register(c211);
float4 wrinkleMaskStrengths2 : register(c212);
float4 wrinkleMaskStrengths3 : register(c213);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.z = dot(r2, specMapExpMask);
	r0.z = r0.z * specularFactor.x;
	r0.w = dot(r2.xyz, specMapIntMask.xyz);
	r2.w = max(1, r0.z);
	r3.xy = float2(1, 0);
	if (-reflectivePower.x < r3.y) {
		r3.yz = r0.xy * 2 + -1;
		r3.yz = r3.yz * bumpiness.xx;
		r0.z = dot(r3.yz, -r3.yz) + 1;
		r3.w = max(r0.z, 0);
		r0.z = rsqrt(r3.w);
		r0.z = 1 / r0.z;
		r4.xyz = r3.yyy * i.texcoord4.xyz;
		r4.xyz = r0.zzz * i.texcoord1.xyz + r4.xyz;
		r3.yzw = r3.zzz * i.texcoord5.xyz + r4.xyz;
		r3.yzw = r3.yzw + 1E-05;
		r4.xyz = normalize(r3.yzw);
		r0.z = saturate(r2.w * 0.015625);
		r5.w = r0.z * -4 + 4;
		r3.yzw = 1E-05 + i.texcoord3.xyz;
		r6.xyz = normalize(r3.yzw);
		r0.z = dot(-r6.xyz, r4.xyz);
		r0.z = r0.z + r0.z;
		r3.yzw = r4.xyz * -r0.zzz + -r6.xyz;
		r3.yzw = r3.yzw + 1E-05;
		r7 = normalize(r3.yzw);
		r0.z = saturate(r7.z);
		r0.z = r0.z + 1;
		r0.z = r0.z + r0.z;
		r0.z = 1 / r0.z;
		r3.yz = r7.xy * r0.zz + 0.5;
		r5.xy = -r3.yz + 1;
		r5.z = 0;
		r5 = tex2Dlod(DynamicEnvironmentSampler, r5);
		r3.yzw = r5.xyz * r5.xyz;
		r3.yzw = r3.yzw * 16;
		r0.z = saturate(dot(r6.xyz, r4.xyz));
		r3.x = r3.x + -fresnelRolloff.x;
		r0.z = -r0.z + 1.00001;
		r4.x = r0.z * r0.z;
		r4.x = r4.x * r4.x;
		r0.z = r0.z * r4.x;
		r0.z = fresnelRolloff.x * r0.z + r3.x;
		r3.xyz = r0.zzz * r3.yzw;
	} else {
		r3.xyz = 0;
	}
	r3.xyz = r3.xyz * reflectivePower.xxx;
	r0.z = dot(r2.xyz, specMapReflectMask.xyz);
	r2.xyz = r0.zzz * r3.xyz;
	r2.xyz = r2.xyz * ColorCorrectTopAndPedReflectScale.www;
	r3 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r4 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r0.z = dot(wrinkleMaskStrengths0, r3);
	r5.x = dot(wrinkleMaskStrengths1, r4);
	r0.z = r0.z + r5.x;
	r3.x = dot(wrinkleMaskStrengths2, r3);
	r3.y = dot(wrinkleMaskStrengths3, r4);
	r3.x = r3.y + r3.x;
	r0.xy = r0.xy + -0.5;
	r0.xy = r0.xy * bumpiness.xx;
	r0.xy = r0.xy + r0.xy;
	r4 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r3.y = -r4.w + 1;
	r3.y = -r4.x + r3.y;
	r3.yz = (r3.yy >= 0) ? r4.wy : r4.xy;
	r3.yz = r3.yz + -0.5;
	r4 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r3.w = -r4.w + 1;
	r3.w = -r4.x + r3.w;
	r4.xy = (r3.ww >= 0) ? r4.wy : r4.xy;
	r4.xy = r4.xy + -0.5;
	r3.yz = r3.yz * 2 + -r0.xy;
	r0.xy = r0.zz * r3.yz + r0.xy;
	r3.yz = r4.xy * 2 + -r0.xy;
	r0.xy = r3.xx * r3.yz + r0.xy;
	r3.x = dot(r0.xy, -r0.xy) + 1;
	r4.x = max(r3.x, 0);
	r3.x = rsqrt(r4.x);
	r0.z = 1 / r3.x;
	r0.xyz = r0.xyz + 1E-05;
	r3.xyz = normalize(r0.xyz);
	r0.xyz = r3.xxx * i.texcoord4.xyz;
	r0.xyz = i.texcoord1.xyz * r3.zzz + r0.xyz;
	r0.xyz = i.texcoord5.xyz * r3.yyy + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r3.xyz = normalize(r0.xyz);
	r0.xyz = r1.xyz * r1.xyz;
	r1.x = r1.w * i.texcoord7.w;
	r1.yzw = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r1.yzw);
	r1.y = saturate(r3.z * -0.5 + 0.5);
	r5.xyz = gLightAmbient0.xyz;
	r5.xyz = -r5.xyz + gLightAmbient1.xyz;
	r1.yzw = r1.yyy * r5.xyz + gLightAmbient0.xyz;
	r1.yzw = r1.yzw * gAmbientOcclusionEffect.yyy;
	r1.yzw = r1.yzw * i.texcoord7.xxx;
	r3.w = 1 / gAmbientOcclusionEffect.y;
	r4.w = dot(-r4.xyz, r3.xyz);
	r4.w = r4.w + r4.w;
	r4.xyz = r3.xyz * -r4.www + -r4.xyz;
	r3.x = dot(r3.xyz, -gDirectionalLight.xyz);
	r3.y = saturate(r3.x + -0.25);
	r3.y = r3.y * 1.3333334;
	r3.z = saturate(dot(-gDirectionalLight.xyz, r4.xyz));
	r3.z = r3.z + 1E-05;
	r2.w = r2.w + 1E-05;
	r4.x = pow(r3.z, r2.w);
	r2.w = saturate(r3.x * 2 + -0.5);
	r2.w = r2.w * r4.x;
	r4.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r4.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r4.xyz;
	r4.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r4.xyz;
	r4.xyz = r4.xyz + gShadowMatrix[3].xyz;
	r3.xz = r4.xy + -gShadowParam18192021.zw;
	r5.xy = r3.xx + -gCascadeXMaxThresholds.xy;
	r5.zw = -r3.xx + gCascadeXMinThresholds.xy;
	r5 = (r5 >= 0) ? 1 : 0;
	r6.xy = r3.zz + -gCascadeYMaxThresholds.xy;
	r6.zw = -r3.zz + gCascadeYMinThresholds.xy;
	r6 = (r6 >= 0) ? 1 : 0;
	r5.xy = r5.zw + r5.xy;
	r5.xy = r6.xy + r5.xy;
	r5.yz = saturate(r6.zw + r5.xy);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r4.xyz = r4.zxy * r6.zxy + r7.zxy;
	r4.x = saturate(r4.x);
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r3.xz = saturate(abs(r3.xz) * 4 + r5.xy);
	r4.w = max(r3.x, r3.z);
	r3.x = -r4.x + 1;
	r5 = tex2D(gShadowZSamplerDir, r4.yz);
	r3.x = -r3.x + r5.x;
	r3.x = (r3.x >= 0) ? 0 : 0.33333334;
	r3.x = r4.w + r3.x;
	r3.x = r3.x + -0.4;
	r3.x = saturate(r3.x * 1.6666666);
	r3.z = r3.x * -2 + 3;
	r3.x = r3.x * r3.x;
	r3.x = r3.x * r3.z;
	r4.xyz = r3.xxx * gDirectionalColour.xyz;
	r5.xyz = r2.www * r4.xyz;
	r3.xyz = r3.yyy * r4.xyz;
	r4.xyz = r5.xyz * gDirectionalLight.www;
	r1.yzw = r1.yzw * r3.www + r3.xyz;
	r2.w = dot(r1.yzw, 0.33333334);
	r2.w = r2.w + 0.015;
	r2.xyz = r2.www * r2.xyz;
	r2.xyz = r4.xyz * r0.www + r2.xyz;
	r0.xyz = r0.xyz * r1.yzw + r2.xyz;
	o.w = r1.x * globalScalars.x;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.w = r1.z + -65504;
	r1.z = -r1.z + 1;
	r1.z = (r1.w >= 0) ? -65503 : r1.z;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.xyz = lerp(r1.xxx, r0.xyz, r0.www);
	o.xyz = r2.xyz * matMaterialColorScale.xxx;

	return o;
}
