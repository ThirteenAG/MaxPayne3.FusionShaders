sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s3);
sampler2D SpecSampler : register(s2);
float bumpiness : register(c203);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float goldFactor : register(c210);
float goldFresnelRolloff : register(c207);
float3 goldReflectColorBase : register(c211);
float3 goldReflectColorOverlay : register(c212);
float goldReflectivePower : register(c205);
float3 goldSpecMapIntMask : register(c201);
float goldSpecularFactor : register(c199);
float normFresnelRolloff : register(c206);
float normReflectivePower : register(c204);
float3 normSpecMapIntMask : register(c200);
float normSpecularFactor : register(c198);
float4 specMapExpMask : register(c202);
float3 specMapReflectMask : register(c209);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float3 r3;
	float4 r4;
	float4 r5;
	float r6;
	float4 r7;
	float r8;
	r0.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r0.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r0.xyz;
	r0.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gShadowMatrix[3].xyz;
	r1.xy = r0.xy + -gShadowParam18192021.zw;
	r1.zw = r1.xx + -gCascadeXMaxThresholds.xy;
	r1.zw = (r1.zw >= 0) ? 1 : 0;
	r2.xy = -r1.xx + gCascadeXMinThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r1.zw = r1.zw + r2.xy;
	r2.xy = r1.yy + -gCascadeYMaxThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r1.zw = r1.zw + r2.xy;
	r2.xy = -r1.yy + gCascadeYMinThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r2.yz = saturate(r1.zw + r2.xy);
	r2.x = 1;
	r3.x = dot(r2.xyz, gShadowParam0123.xyz);
	r3.y = dot(r2.xyz, gShadowParam4567.xyz);
	r3.z = dot(r2.xyz, gCascadeZScales.xyz);
	r4.x = dot(r2.xyz, gShadowParam891113.xyz);
	r4.y = dot(r2.xyz, gShadowParam14151617.xyz);
	r4.z = dot(r2.xyz, gCascadeZOffsets.xyz);
	r0.xyz = r0.zxy * r3.zxy + r4.zxy;
	r0.x = saturate(r0.x);
	r2 = tex2D(gShadowZSamplerDir, r0.yz);
	r0.x = -r0.x + 1;
	r0.x = -r2.x + r0.x;
	r0.x = (r0.x >= 0) ? -1 : -0;
	r2.x = -gCascadeXMinThresholds.w;
	r2.y = -gCascadeXMaxThresholds.w;
	r0.yz = saturate(abs(r1.xy) * 4 + r2.xy);
	r1.x = max(r0.y, r0.z);
	r0.x = r0.x + r1.x;
	r0.x = saturate(r0.x + 1);
	r0.xyz = r0.xxx * gDirectionalColour.xyz;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r1.w + 1;
	r0.w = -r1.x + r0.w;
	r1.xy = (r0.ww >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r0.w = dot(r1.xy, -r1.xy) + 1;
	r1.z = max(r0.w, 0);
	r0.w = rsqrt(r1.z);
	r0.w = 1 / r0.w;
	r1.xzw = r1.xxx * i.texcoord4.xyz;
	r1.xzw = r0.www * i.texcoord1.xyz + r1.xzw;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r1.xzw;
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r0.w = dot(r2.xyz, -gDirectionalLight.xyz);
	r1.x = saturate(r0.w + -0.25);
	r0.w = saturate(r0.w * 2 + -0.5);
	r1.x = r1.x * 1.3333334;
	r1.xyz = r0.xyz * r1.xxx;
	r1.w = saturate(r2.z * -0.5 + 0.5);
	r3 = gLightAmbient0.xyz;
	r3 = -r3.xyz + gLightAmbient1.xyz;
	r3 = r1.www * r3.xyz + gLightAmbient0.xyz;
	r3 = r3.xyz * gAmbientOcclusionEffect.yyy;
	r3 = r3.xyz * i.color.xxx;
	r1.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r3.xyz * r1.www + r1.xyz;
	r1.w = dot(r1.xyz, 0.33333334);
	r1.w = r1.w + 0.015;
	r3 = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r3.xyz);
	r2.w = dot(-r4.xyz, r2.xyz);
	r2.w = r2.w + r2.w;
	r3 = r2.xyz * -r2.www + -r4.xyz;
	r2.x = saturate(dot(r4.xyz, r2.xyz));
	r2.x = -r2.x + 1.00001;
	r2.yzw = r3.xyz + 1E-05;
	r3.x = saturate(dot(-gDirectionalLight.xyz, r3.xyz));
	r3.x = r3.x + 1E-05;
	r2.z = dot(r2.yzw, r2.yzw);
	r2.z = rsqrt(r2.z);
	r2.yz = r2.yw * r2.zz + 1;
	r2.yz = r2.yz * -0.5;
	r4 = tex2D(EnvironmentSampler, r2.yz);
	r2.yzw = r4.xyz * goldReflectColorOverlay.xyz + -r4.xyz;
	r2.yzw = goldFactor.xxx * r2.yzw + r4.xyz;
	r3.y = r2.x * r2.x;
	r3.y = r3.y * r3.y;
	r2.x = r2.x * r3.y;
	r4.x = normFresnelRolloff.x;
	r3.y = -r4.x + goldFresnelRolloff.x;
	r3.y = goldFactor.x * r3.y + r4.x;
	r3.z = -r3.y + 1;
	r2.x = r3.y * r2.x + r3.z;
	r2.xyz = r2.xxx * r2.yzw;
	r4.x = normReflectivePower.x;
	r2.w = -r4.x + goldReflectivePower.x;
	r2.w = goldFactor.x * r2.w + r4.x;
	r2.xyz = r2.www * r2.xyz;
	r4 = tex2D(SpecSampler, i.texcoord.xy);
	r5 = -r4 + 1;
	r4 = goldFactor.x * r5 + r4;
	r2.w = dot(r4.xyz, specMapReflectMask.xyz);
	r2.xyz = r2.www * r2.xyz;
	r5.x = 1;
	r6 = goldFactor.x;
	r2.w = lerp(globalScalars.w, r5.x, r6.x);
	r2.xyz = r2.www * r2.xyz;
	r5 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2.w = r5.w * i.color.w;
	r3.y = 1 / r2.w;
	r7.w = r2.w * globalScalars.x;
	r2.w = r5.w * i.color.w + -0.01;
	r2.w = (r2.w >= 0) ? r3.y : 100;
	r2.xyz = r2.www * r2.xyz;
	r2.xyz = r1.www * r2.xyz;
	r1.w = dot(r4, specMapExpMask);
	r8 = normSpecularFactor.x;
	r2.w = -r8.x + goldSpecularFactor.x;
	r2.w = r6.x * r2.w + normSpecularFactor.x;
	r3.y = r1.w * -r2.w + 1;
	r1.w = r1.w * r2.w + 1E-05;
	r1.w = (r3.y >= 0) ? 1.00001 : r1.w;
	r2.w = pow(r3.x, r1.w);
	r0.w = r0.w * r2.w;
	r0.xyz = r0.www * r0.xyz;
	r0.xyz = r0.xyz * gDirectionalLight.www;
	r3 = normSpecMapIntMask.xyz;
	r3 = -r3.xyz + goldSpecMapIntMask.xyz;
	r3 = r6.xxx * r3.xyz + normSpecMapIntMask.xyz;
	r0.w = dot(r4.xyz, r3.xyz);
	r0.xyz = r0.xyz * r0.www + r2.xyz;
	r2.xyz = -r5.xyz + goldReflectColorBase.xyz;
	r2.xyz = goldFactor.xxx * r2.xyz + r5.xyz;
	r2.xyz = r2.xyz * r2.xyz;
	r0.xyz = r2.xyz * r1.xyz + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r7.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o = min(r7, float4(8, 8, 8, 1));

	return o;
}
