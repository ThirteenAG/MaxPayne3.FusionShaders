float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float3 matDiffuseColor : register(c197);
float4 matDiffuseColor2 : register(c198);
float reflectivePower : register(c210);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c212);
float specularColorFactor : register(c202);
float specularFactor : register(c201);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = tex2D(DiffuseSampler2, i.texcoord.zw);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r3.x = max(r0.z, 0);
	r0.z = rsqrt(r3.x);
	r0.z = 1 / r0.z;
	r3 = tex2D(SpecSampler, i.texcoord.zw);
	r0.w = dot(r3, specMapExpMask);
	r3.w = dot(r3.xyz, specMapIntMask.xyz);
	r3.w = r3.w * specularColorFactor.x;
	r4.xw = float2(1, 0);
	r4.y = r0.w * -specularFactor.x + r4.x;
	r5.xyz = r0.xxx * i.texcoord4.xyz;
	r5.xyz = r0.zzz * i.texcoord1.xyz + r5.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r5.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r5.xyz = normalize(r0.xyz);
	r0.xyz = 1E-05 + i.texcoord3.xyz;
	r6.xyz = normalize(r0.xyz);
	r0.x = dot(-r6.xyz, r5.xyz);
	r0.x = r0.x + r0.x;
	r0.xyz = r5.xyz * -r0.xxx + -r6.xyz;
	r7.xyz = r0.xyz + 1E-05;
	r4.z = dot(r7.xyz, r7.xyz);
	r4.z = rsqrt(r4.z);
	r7.xy = r7.xz * r4.zz + 1;
	r7.xy = r7.xy * -0.5;
	r7 = tex2D(EnvironmentSampler, r7.xy);
	r4.z = saturate(dot(r6.xyz, r5.xyz));
	r5.w = r4.x + -fresnelRolloff.x;
	r4.z = -r4.z + 1.00001;
	r6.x = r4.z * r4.z;
	r6.x = r6.x * r6.x;
	r4.z = r4.z * r6.x;
	r4.z = fresnelRolloff.x * r4.z + r5.w;
	r6.xyz = r4.zzz * r7.xyz;
	r6.xyz = r6.xyz * reflectivePower.xxx;
	r3.x = dot(r3.xyz, specMapReflectMask.xyz);
	r3.xyz = r3.xxx * r6.xyz;
	r3.xyz = r3.xyz * globalFogColorN.www;
	r6.xyz = r1.xyz * r1.xyz;
	r6.xyz = r6.xyz * matDiffuseColor.xyz;
	r2.w = r2.w * matDiffuseColor2.w;
	r2.xyz = r2.xyz * matDiffuseColor2.xyz + -r6.xyz;
	r1.xyz = r2.www * r2.xyz + r6.xyz;
	r1 = r1 * i.texcoord6;
	r2.x = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.y = gAmbientOcclusionEffect.y;
	r2.y = r2.y * globalScalars.z;
	r2.x = r2.y * r2.x;
	if (-dirtLevel.x < r4.w) {
		r6 = tex2D(DirtSampler, i.texcoord.xy);
		r2.y = r6.x * dirtLevel.x;
		r7.x = r6.x * -dirtLevel.x + r4.x;
		r7.yzw = lerp(r1.xyz, dirtColor.xyz, r2.yyy);
		r8 = r1.xxyz * float4(0, 1, 1, 1) + float4(1, 0, 0, 0);
		r6 = (-r6.x >= 0) ? r8 : r7;
		r1.xyz = r6.yzw;
	} else {
		r6.x = 1;
	}
	r2.y = r3.w * r6.x;
	r2.z = saturate(r5.z * -0.5 + 0.5);
	r6.xyz = gLightAmbient0.xyz;
	r6.xyz = -r6.xyz + gLightAmbient1.xyz;
	r6.xyz = r2.zzz * r6.xyz + gLightAmbient0.xyz;
	r6.xyz = r6.xyz * gAmbientOcclusionEffect.yyy;
	r2.xzw = r2.xxx * r6.xyz;
	r3.w = 1 / gAmbientOcclusionEffect.y;
	r4.x = dot(r5.xyz, -gDirectionalLight.xyz);
	r4.w = saturate(r4.x + -0.25);
	r4.w = r4.w * 1.3333334;
	r0.x = saturate(dot(-gDirectionalLight.xyz, r0.xyz));
	r0.x = r0.x + 1E-05;
	r5.x = 1E-05;
	r0.y = r0.w * specularFactor.x + r5.x;
	r0.y = (r4.y >= 0) ? 1.00001 : r0.y;
	r4.y = pow(r0.x, r0.y);
	r0.x = saturate(r4.x * 2 + -0.5);
	r0.x = r0.x * r4.y;
	r0.yzw = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r0.yzw = i.texcoord2.xxx * gShadowMatrix[0].xyz + r0.yzw;
	r0.yzw = i.texcoord2.zzz * gShadowMatrix[2].xyz + r0.yzw;
	r0.yzw = r0.yzw + gShadowMatrix[3].xyz;
	r4.xy = r0.yz + -gShadowParam18192021.zw;
	r5.xy = r4.xx + -gCascadeXMaxThresholds.xy;
	r5.zw = -r4.xx + gCascadeXMinThresholds.xy;
	r5 = (r5 >= 0) ? 1 : 0;
	r6.xy = r4.yy + -gCascadeYMaxThresholds.xy;
	r6.zw = -r4.yy + gCascadeYMinThresholds.xy;
	r6 = (r6 >= 0) ? 1 : 0;
	r5.xy = r5.zw + r5.xy;
	r5.xy = r6.xy + r5.xy;
	r5.yz = saturate(r6.zw + r5.xy);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r0.yzw = r0.wyz * r6.zxy + r7.zxy;
	r0.y = saturate(r0.y);
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r4.xy = saturate(abs(r4.xy) * 4 + r5.xy);
	r5.x = max(r4.x, r4.y);
	r0.y = -r0.y + 1;
	r6 = tex2D(gShadowZSamplerDir, r0.zw);
	r0.y = -r0.y + r6.x;
	r0.y = (r0.y >= 0) ? 0 : 0.33333334;
	r0.y = r5.x + r0.y;
	r0.y = r0.y + -0.4;
	r0.y = saturate(r0.y * 1.6666666);
	r0.z = r0.y * -2 + 3;
	r0.y = r0.y * r0.y;
	r0.y = r0.y * r0.z;
	r0.yzw = r0.yyy * gDirectionalColour.xyz;
	r5.xyz = r0.xxx * r0.yzw;
	r0.xyz = r4.www * r0.yzw;
	r4.xyw = r5.xyz * gDirectionalLight.www;
	r0.xyz = r2.xzw * r3.www + r0.xyz;
	r4.z = saturate(r4.z);
	r2.xzw = r3.xyz * r4.zzz;
	r0.w = dot(r0.xyz, 0.33333334);
	r0.w = r0.w + 0.015;
	r2.xzw = r0.www * r2.xzw;
	r2.xyz = r4.xyw * r2.yyy + r2.xzw;
	r0.xyz = r1.xyz * r0.xyz + r2.xyz;
	o.w = r1.w * globalScalars.x;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.w = r1.z + -65504;
	r1.z = -r1.z + 1;
	r1.z = (r1.w >= 0) ? -65503 : r1.z;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.xyz = r0.xyz + -r1.xxx;
	o.xyz = r0.www * r0.xyz + r1.xxx;

	return o;
}
