sampler2D BumpSampler : register(s3);
sampler2D DiffuseSampler : register(s0);
sampler2D DirtSampler : register(s2);
sampler2D EnvironmentSampler : register(s5);
sampler2D SpecSampler : register(s4);
float bumpiness : register(c209);
float4 deSatContrastGamma : register(c46);
float3 dirtColor : register(c200);
float dirtLevel : register(c199);
float fresnelRolloff : register(c211);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float3 matDiffuseColor : register(c197);
float reflectivePower : register(c210);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c212);
float specularColorFactor : register(c202);
float specularFactor : register(c201);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
	float2 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float3 r8;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.z, 0);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r2, specMapExpMask);
	r2.w = dot(r2.xyz, specMapIntMask.xyz);
	r2.w = r2.w * specularColorFactor.x;
	r3.xw = float2(1, 0);
	r3.y = r0.w * -specularFactor.x + r3.x;
	r4.xyz = r0.xxx * i.texcoord4.xyz;
	r4.xyz = r0.zzz * i.texcoord1.xyz + r4.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r4.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r4.xyz = normalize(r0.xyz);
	r0.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r0.xyz);
	r0.x = dot(-r5.xyz, r4.xyz);
	r0.x = r0.x + r0.x;
	r0.xyz = r4.xyz * -r0.xxx + -r5.xyz;
	r6.xyz = r0.xyz + 1E-05;
	r3.z = dot(r6.xyz, r6.xyz);
	r3.z = rsqrt(r3.z);
	r6.xy = r6.xz * r3.zz + 1;
	r6.xy = r6.xy * -0.5;
	r6 = tex2D(EnvironmentSampler, r6.xy);
	r3.z = saturate(dot(r5.xyz, r4.xyz));
	r4.w = r3.x + -fresnelRolloff.x;
	r3.z = -r3.z + 1.00001;
	r5.x = r3.z * r3.z;
	r5.x = r5.x * r5.x;
	r3.z = r3.z * r5.x;
	r3.z = fresnelRolloff.x * r3.z + r4.w;
	r5.xyz = r3.zzz * r6.xyz;
	r5.xyz = r5.xyz * reflectivePower.xxx;
	r2.x = dot(r2.xyz, specMapReflectMask.xyz);
	r2.xyz = r2.xxx * r5.xyz;
	r2.xyz = r2.xyz * globalFogColorN.www;
	r5.xyz = r1.xyz * r1.xyz;
	r1.xyz = r5.xyz * matDiffuseColor.xyz;
	r1 = r1 * i.texcoord6;
	r4.w = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r5.y = gAmbientOcclusionEffect.y;
	r5.x = r5.y * globalScalars.z;
	r4.w = r4.w * r5.x;
	if (-dirtLevel.x < r3.w) {
		r5 = tex2D(DirtSampler, i.texcoord7.xy);
		r3.w = r5.x * dirtLevel.x;
		r6.x = r5.x * -dirtLevel.x + r3.x;
		r6.yzw = lerp(r1.xyz, dirtColor.xyz, r3.www);
		r7 = r1.xxyz * float4(0, 1, 1, 1) + float4(1, 0, 0, 0);
		r5 = (-r5.x >= 0) ? r7 : r6;
		r1.xyz = r5.yzw;
	} else {
		r5.x = 1;
	}
	r2.w = r2.w * r5.x;
	r3.x = saturate(r4.z * -0.5 + 0.5);
	r5.xyz = gLightAmbient0.xyz;
	r5.xyz = -r5.xyz + gLightAmbient1.xyz;
	r5.xyz = r3.xxx * r5.xyz + gLightAmbient0.xyz;
	r5.xyz = r5.xyz * gAmbientOcclusionEffect.yyy;
	r5.xyz = r4.www * r5.xyz;
	r3.x = 1 / gAmbientOcclusionEffect.y;
	r3.w = dot(r4.xyz, -gDirectionalLight.xyz);
	r4.x = saturate(r3.w + -0.25);
	r4.x = r4.x * 1.3333334;
	r0.x = saturate(dot(-gDirectionalLight.xyz, r0.xyz));
	r0.x = r0.x + 1E-05;
	r6.x = 1E-05;
	r0.y = r0.w * specularFactor.x + r6.x;
	r0.y = (r3.y >= 0) ? 1.00001 : r0.y;
	r3.y = pow(r0.x, r0.y);
	r0.x = saturate(r3.w * 2 + -0.5);
	r0.x = r0.x * r3.y;
	r0.yzw = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r0.yzw = i.texcoord2.xxx * gShadowMatrix[0].xyz + r0.yzw;
	r0.yzw = i.texcoord2.zzz * gShadowMatrix[2].xyz + r0.yzw;
	r0.yzw = r0.yzw + gShadowMatrix[3].xyz;
	r3.yw = r0.yz + -gShadowParam18192021.zw;
	r4.yz = r3.yy + -gCascadeXMaxThresholds.xy;
	r4.yz = (r4.yz >= 0) ? 1 : 0;
	r6.xy = -r3.yy + gCascadeXMinThresholds.xy;
	r6.zw = r3.ww + -gCascadeYMaxThresholds.xy;
	r6 = (r6 >= 0) ? 1 : 0;
	r7.xy = -r3.ww + gCascadeYMinThresholds.xy;
	r7.xy = (r7.xy >= 0) ? 1 : 0;
	r4.yz = r4.yz + r6.xy;
	r4.yz = r6.zw + r4.yz;
	r6.yz = saturate(r7.xy + r4.yz);
	r6.x = 1;
	r7.x = dot(r6.xyz, gShadowParam0123.xyz);
	r7.y = dot(r6.xyz, gShadowParam4567.xyz);
	r7.z = dot(r6.xyz, gCascadeZScales.xyz);
	r8.x = dot(r6.xyz, gShadowParam891113.xyz);
	r8.y = dot(r6.xyz, gShadowParam14151617.xyz);
	r8.z = dot(r6.xyz, gCascadeZOffsets.xyz);
	r0.yzw = r0.wyz * r7.zxy + r8.zxy;
	r0.y = saturate(r0.y);
	r6.x = -gCascadeXMinThresholds.w;
	r6.y = -gCascadeXMaxThresholds.w;
	r3.yw = saturate(abs(r3.yw) * 4 + r6.xy);
	r4.y = max(r3.y, r3.w);
	r0.y = -r0.y + 1;
	r6 = tex2D(gShadowZSamplerDir, r0.zw);
	r0.y = -r0.y + r6.x;
	r0.y = (r0.y >= 0) ? 0 : 0.33333334;
	r0.y = r4.y + r0.y;
	r0.y = r0.y + -0.4;
	r0.y = saturate(r0.y * 1.6666666);
	r0.z = r0.y * -2 + 3;
	r0.y = r0.y * r0.y;
	r0.y = r0.y * r0.z;
	r0.yzw = r0.yyy * gDirectionalColour.xyz;
	r4.yzw = r0.xxx * r0.yzw;
	r0.xyz = r4.xxx * r0.yzw;
	r4.xyz = r4.yzw * gDirectionalLight.www;
	r0.xyz = r5.xyz * r3.xxx + r0.xyz;
	r3.z = saturate(r3.z);
	r2.xyz = r2.xyz * r3.zzz;
	r0.w = dot(r0.xyz, 0.33333334);
	r0.w = r0.w + 0.015;
	r2.xyz = r0.www * r2.xyz;
	r2.xyz = r4.xyz * r2.www + r2.xyz;
	r0.xyz = r1.xyz * r0.xyz + r2.xyz;
	o.w = r1.w * globalScalars.x;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.w = r1.z + -65504;
	r1.z = -r1.z + 1;
	r1.z = (r1.w >= 0) ? -65503 : r1.z;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.xyz = r0.xyz + -r1.xxx;
	o.xyz = r0.www * r0.xyz + r1.xxx;

	return o;
}
