float HybridAdd : register(c196);
float gAmbientAmount : register(c207);
float4 gAmbientOcclusionEffect : register(c63);
float4 gAspectRatio : register(c17);
float gBiasToCamera : register(c200);
float gDiffuse : register(c203);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float gNormalArc : register(c209);
float gSuperAlpha : register(c208);
float4 gTexCoordScaleOffset0 : register(c214);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float gWrapBias : register(c202);
float gWrapScale : register(c201);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float3 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	r0.zw = 0;
	r1.x = i.normal.z * 0.15915494 + 0.5;
	r1.x = frac(r1.x);
	r1.x = r1.x * 6.2831855 + -3.1415927;
	sincos(r1.x, r2.y, r2.x);
	r1.xyz = r2.yyx * i.normal.yxy;
	r0.x = i.normal.x * r2.x + -r1.x;
	r0.y = r1.z + r1.y;
	r1.xz = float2(0.1, 0.5);
	r1.x = r1.x * gBiasToCamera.x;
	r2 = lerp(i.position.xyz, gViewInverse[3].xyz, r1.xxx);
	r3 = r2.y * gWorldViewProj[1];
	r3 = r2.x * gWorldViewProj[0] + r3;
	r3 = r2.z * gWorldViewProj[2] + r3;
	r3 = r3 + gWorldViewProj[3];
	o.position = r0 * gAspectRatio + r3;
	r0.zw = r0.xy * gAspectRatio.xy;
	r3.zw = float2(1E-05, 1);
	r0.xy = r0.xy * gAspectRatio.xy + r3.zz;
	r0.zw = r0.zw * r0.zw;
	r0.z = r0.w + r0.z;
	r0.z = rsqrt(r0.z);
	r0.z = 1 / r0.z;
	r0.z = (-r0.z < r0.z) ? 1 : 0;
	r1.xy = r0.xy * r0.xy;
	r0.w = r1.y + r1.x;
	r0.w = rsqrt(r0.w);
	r0.xy = r0.ww * r0.xy;
	r0.xy = r0.xy * r0.zz;
	r1.xyw = r2.yyy * gWorldView[1].xyz;
	r1.xyw = r2.xxx * gWorldView[0].xyz + r1.xyw;
	r1.xyw = r2.zzz * gWorldView[2].xyz + r1.xyw;
	r1.xyw = r1.xyw + gWorldView[3].xyz;
	r3.xyz = -r1.xyw + 1E-05;
	r4.xyz = normalize(r3.xyz);
	r3.xyz = r4.zxy * float3(-1, 0, 0);
	r3.xyz = r4.yzx * float3(0, 0, -1) + -r3.xyz;
	r3.xyz = r3.xyz + 1E-05;
	r5.xyz = normalize(r3.xyz);
	r3.xyz = r4.zxy * r5.yzx;
	r3.xyz = r4.yzx * r5.zxy + -r3.xyz;
	r0.yzw = r0.yyy * r3.xyz;
	r0.xyz = r5.xyz * r0.xxx + r0.yzw;
	r0.xyz = r4.xyz * gNormalArc.xxx + r0.xyz;
	r3.xyz = r0.xyz + 1E-05;
	r0.w = dot(r3.xyz, r3.xyz);
	r0.w = rsqrt(r0.w);
	r3.xyz = lerp(-r0.xyz, 1E-05, r0.www);
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r0.w = 1 / r0.w;
	r0.w = (-r0.w < r0.w) ? 1 : 0;
	r0.xyz = r0.www * r3.xyz + r0.xyz;
	r4 = -r1.x + gLightPosX;
	r5 = r4 * -gLightDirX;
	r6 = -r1.y + gLightPosY;
	r7 = -r1.w + gLightPosZ;
	r5 = r6 * -gLightDirY + r5;
	r5 = r7 * -gLightDirZ + r5;
	r8 = r4 * r4;
	r8 = r6 * r6 + r8;
	r8 = r7 * r7 + r8;
	r9 = r8 + 1E-05;
	r3 = r8 * -gLightFallOff + r3.w;
	r3 = max(r3, 0);
	r3 = r3 * r3;
	r3 = r3 * r3 + -0.1;
	r3 = max(r3, 0);
	r8.x = rsqrt(r9.x);
	r8.y = rsqrt(r9.y);
	r8.z = rsqrt(r9.z);
	r8.w = rsqrt(r9.w);
	r5 = r5 * r8;
	r9 = gLightConeScale;
	r5 = saturate(r5 * r9 + gLightConeOffset);
	r3 = r3 * r8;
	r3 = r3 * 1.1111112;
	r3 = min(r3, 1);
	r3 = r3 * r5;
	r3 = r8 * r3;
	r4 = r3 * r4;
	r4 = r0.x * r4;
	r5 = r3 * r6;
	r4 = r0.y * r5 + r4;
	r5 = r3 * r7;
	r0.w = r3.x * gWrapBias.x;
	r3 = saturate(r0.z * r5 + r4);
	r4.x = dot(gLightColR, r3);
	r4.y = dot(gLightColG, r3);
	r4.z = dot(gLightColB, r3);
	r1.x = dot(r0.xyz, -gDirectionalLight.xyz);
	r0.x = dot(r0.xyz, gWorldView[2].xyz);
	r0.x = saturate(r0.x * -0.5 + 0.5);
	r0.y = saturate(r1.x * gWrapScale.x + r0.w);
	r0.yzw = r0.yyy * gDirectionalColour.xyz + r4.xyz;
	r3.xyz = gLightAmbient0.xyz;
	r1.xyw = -r3.xyz + gLightAmbient1.xyz;
	r1.xyw = r0.xxx * r1.xyw + gLightAmbient0.xyz;
	r1.xyw = r1.xyw * gAmbientOcclusionEffect.yyy;
	r1.xyw = r1.xyw * gAmbientAmount.xxx;
	r0.x = 1 / gAmbientOcclusionEffect.y;
	r0.xyz = r1.xyw * r0.xxx + r0.yzw;
	r0.xyz = r0.xyz * gDiffuse.xxx;
	o.texcoord.xyz = r0.xyz * i.color.xyz;
	o.texcoord.w = saturate(gSuperAlpha.x * i.color.w);
	r0.xyz = r2.xyz + -gViewInverse[3].xyz;
	r0.w = r0.z * globalFogParams.x;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * globalFogParams.z;
	r0.y = r0.w * -1.442695;
	r0.y = exp2(r0.y);
	r0.y = min(r0.y, 65504);
	r0.y = -r0.y + 1;
	r0.z = 1 / r0.w;
	r0.w = (0.0001 < abs(r0.w)) ? 1 : 0;
	r0.y = r0.z * r0.y;
	r0.y = r0.x * r0.y + -r0.x;
	r0.x = r0.w * r0.y + r0.x;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = exp2(r0.x);
	r0.x = min(r0.x, 65504);
	o.texcoord4.w = -r0.x + 1;
	r0.x = (r1.z < HybridAdd.x) ? 1 : 0;
	o.texcoord3.z = r0.x * -i.texcoord3.x + 1;
	r0 = r2.y * gWorldView[1];
	r0 = r2.x * gWorldView[0] + r0;
	r0 = r2.z * gWorldView[2] + r0;
	o.texcoord7 = r0 + gWorldView[3];
	o.texcoord1 = i.texcoord * gTexCoordScaleOffset0.xyxy + gTexCoordScaleOffset0.zwzw;
	o.texcoord3.xy = float2(1, 0) * i.texcoord2.zz;
	o.texcoord3.w = i.texcoord3.y;
	o.texcoord4.xyz = globalFogColorN.xyz;

	return o;
}
