float SegmentSize : register(c200);
float4 approxTangent[20] : register(c121);
float4 curveCoeffs[57] : register(c64);
float4 gDepthFxParams : register(c18);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorld : register(c0);
row_major float4x4 gWorldViewProj : register(c8);
float4 globalFogParams : register(c37);
float radius : register(c201);
float4 ropeColor : register(c203);
float3 uvScales : register(c202);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
	float4 texcoord9 : TEXCOORD9;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	int2 a0;
	float4 r2;
	float3 r3;
	float3 r4;
	float3 r5;
	r0.x = SegmentSize.x * i.position.y;
	r0.y = frac(r0.x);
	r0.z = r0.x + -r0.y;
	r0.y = (-r0.y < r0.y) ? 1 : 0;
	r0.x = (r0.x < -r0.x) ? 1 : 0;
	r0.x = r0.x * r0.y + r0.z;
	r0.y = r0.x * 3;
	r1.y = i.position.y * SegmentSize.x + -r0.x;
	a0 = r0.yx;
	r0.x = r1.y + 0.001;
	r2.z = r0.x * r0.x;
	r2.w = r0.x * r2.z;
	r1.x = 1;
	r2.xy = r1.xy + float2(0, 0.001);
	r0.x = dot(curveCoeffs[a0.x], r2);
	r0.y = dot(curveCoeffs[a0.x + 1], r2);
	r0.z = dot(curveCoeffs[a0.x + 2], r2);
	r1.z = r1.y * r1.y;
	r1.w = r1.y * r1.z;
	r2.x = dot(curveCoeffs[a0.x], r1);
	r2.y = dot(curveCoeffs[a0.x + 1], r1);
	r2.z = dot(curveCoeffs[a0.x + 2], r1);
	r0.xyz = r0.xyz + -r2.xyz;
	r3 = normalize(r0.xyz);
	r0.xyz = r1.yyy * approxTangent[a0.y + 1].yzx;
	r0.w = -r1.y + 1;
	r0.xyz = approxTangent[a0.y].yzx * r0.www + r0.xyz;
	r1.xyz = r0.xyz * r3.zxy;
	r0.xyz = r3.yzx * r0.yzx + -r1.xyz;
	r1.xyz = normalize(r0.xyz);
	r0.xyz = r3.yzx * r1.zxy;
	r0.xyz = r1.yzx * r3.zxy + -r0.xyz;
	r4 = normalize(r0.xyz);
	r0.xyz = r1.xyz * i.normal.zzz;
	r0.xyz = r4.xyz * i.normal.xxx + r0.xyz;
	r0.xyz = r3.xyz * i.normal.yyy + r0.xyz;
	r5 = r0.yyy * gWorld[1].xyz;
	r0.xyw = r0.xxx * gWorld[0].xyz + r5.xyz;
	r0.xyz = r0.zzz * gWorld[2].xyz + r0.xyw;
	r5 = normalize(r0.xyz);
	r0.xyz = r1.xyz * i.texcoord.zzz;
	r1.xyz = r1.xyz * i.position.zzz;
	r1.xyz = r1.xyz * radius.xxx;
	r0.xyz = r4.xyz * i.texcoord.xxx + r0.xyz;
	r4 = r4.xyz * i.position.xxx;
	r1.xyz = r4.xyz * radius.xxx + r1.xyz;
	r1.xyz = r2.xyz + r1.xyz;
	r0.xyz = r3.xyz * i.texcoord.yyy + r0.xyz;
	r2.xyz = r0.yyy * gWorld[1].xyz;
	r0.xyw = r0.xxx * gWorld[0].xyz + r2.xyz;
	r0.xyz = r0.zzz * gWorld[2].xyz + r0.xyw;
	r2.xyz = normalize(r0.xyz);
	r0.xyz = r2.yzx * r5.zxy;
	r0.xyz = r5.yzx * r2.zxy + -r0.xyz;
	o.texcoord1.xyz = r5.xyz;
	o.texcoord4 = r2.xyz;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	o.texcoord5 = r0.www * r0.xyz;
	o.texcoord = uvScales.xy * i.texcoord1.xy;
	r0.xyz = r1.yyy * gWorld[1].xyz;
	r0.xyz = r1.xxx * gWorld[0].xyz + r0.xyz;
	r0.xyz = r1.zzz * gWorld[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gWorld[3].xyz;
	r2.xyz = -r0.xyz + gViewInverse[3].xyz;
	r0.w = dot(r2.xyz, r2.xyz);
	r0.w = rsqrt(r0.w);
	o.texcoord3 = r0.www * r2.xyz;
	r2.xyz = r0.xyz + -gViewInverse[3].xyz;
	o.texcoord6.xyz = r0.xyz;
	r0.x = r2.z * globalFogParams.x;
	r0.y = dot(r2.xyz, r2.xyz);
	r0.y = rsqrt(r0.y);
	r0.y = 1 / r0.y;
	r0.y = r0.y * globalFogParams.z;
	r0.z = r0.x * -1.442695;
	r0.z = exp2(r0.z);
	r0.z = min(r0.z, 65504);
	r0.z = -r0.z + 1;
	r0.w = 1 / r0.x;
	r0.x = (0.0001 < abs(r0.x)) ? 1 : 0;
	r0.z = r0.w * r0.z;
	r0.z = r0.y * r0.z + -r0.y;
	r0.x = r0.x * r0.z + r0.y;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = exp2(r0.x);
	r0.x = min(r0.x, 65504);
	o.texcoord9.x = -r0.x + 1;
	r0 = r1.y * gWorldViewProj[1];
	r0 = r1.x * gWorldViewProj[0] + r0;
	r0 = r1.z * gWorldViewProj[2] + r0;
	r0 = r0 + gWorldViewProj[3];
	r1.x = saturate(-r0.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.y = -r1.x + 1;
	r1.x = r1.y * gDepthFxParams.y + r1.x;
	o.texcoord9.y = r1.x + -1;
	o.position = r0;
	o.texcoord1.w = r0.w;
	r0.yw = float2(1, 0);
	o.color = ropeColor.xyzx * r0.yyyw + r0.wwwy;
	o.texcoord6.w = 1;
	o.texcoord9.zw = 0;

	return o;
}
