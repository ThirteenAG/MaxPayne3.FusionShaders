sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
sampler2D SpecSampler : register(s5);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float fresnelRolloff : register(c199);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float reflectivePower : register(c197);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c198);
float specularFactor : register(c202);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r0.z = dot(i.texcoord7.xyz, float3(0.3, 0.6, 0.1));
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = i.texcoord7.xyzx * float4(1, 1, 1, 0) + float4(0, 0, 0, 1);
	r1 = r1 * r2;
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.w = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.w, 0);
	r0.w = rsqrt(r2.x);
	r0.w = 1 / r0.w;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r2.w = dot(r2, specMapExpMask);
	r2.w = r2.w * specularFactor.x;
	r3.x = dot(r2.xyz, specMapIntMask.xyz);
	r3.y = max(1, r2.w);
	r4.xyz = r0.xxx * i.texcoord4.xyz;
	r4.xyz = r0.www * i.texcoord1.xyz + r4.xyz;
	r0.xyw = r0.yyy * i.texcoord5.xyz + r4.xyz;
	r0.xyw = r0.xyw + 1E-05;
	r4.xyz = normalize(r0.xyw);
	r0.y = 0;
	if (-reflectivePower.x < r0.y) {
		r0.x = saturate(r3.y * 0.015625);
		r5.w = r0.x * -4 + 4;
		r0.xyw = 1E-05 + i.texcoord3.xyz;
		r6.xyz = normalize(r0.xyw);
		r0.x = dot(-r6.xyz, r4.xyz);
		r0.x = r0.x + r0.x;
		r0.xyw = r4.xyz * -r0.xxx + -r6.xyz;
		r0.xyw = r0.xyw + 1E-05;
		r7 = normalize(r0.xyw);
		r0.x = saturate(r7.z);
		r0.x = r0.x + 1;
		r0.x = r0.x + r0.x;
		r0.x = 1 / r0.x;
		r0.xy = r7.xy * r0.xx + 0.5;
		r5.xy = -r0.xy + 1;
		r5.z = 0;
		r5 = tex2Dlod(DynamicEnvironmentSampler, r5);
		r0.xyw = r5.xyz * r5.xyz;
		r0.xyw = r0.xyw * 16;
		r2.w = saturate(dot(r6.xyz, r4.xyz));
		r5.x = 1;
		r3.z = r5.x + -fresnelRolloff.x;
		r2.w = -r2.w + 1.00001;
		r3.w = r2.w * r2.w;
		r3.w = r3.w * r3.w;
		r2.w = r2.w * r3.w;
		r2.w = fresnelRolloff.x * r2.w + r3.z;
		r0.xyw = r0.xyw * r2.www;
	} else {
		r0.xyw = 0;
	}
	r0.xyw = r0.xyw * reflectivePower.xxx;
	r2.x = dot(r2.xyz, specMapReflectMask.xyz);
	r0.xyw = r0.xyw * r2.xxx;
	r0.xyw = r0.xyw * ColorCorrectTopAndPedReflectScale.www;
	r1.xyz = r1.xyz * r1.xyz;
	r1.w = r1.w * i.texcoord7.w;
	r2.x = 1;
	r0.z = r0.z * globalScalars.z + -r2.x;
	r0.z = gAmbientOcclusionEffect.x * r0.z + r2.x;
	r2.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r2.xyz);
	r2.x = saturate(r4.z * -0.5 + 0.5);
	r6.xyz = gLightAmbient0.xyz;
	r2.yzw = -r6.xyz + gLightAmbient1.xyz;
	r2.xyz = r2.xxx * r2.yzw + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r0.zzz * r2.xyz;
	r0.z = 1 / gAmbientOcclusionEffect.y;
	r2.w = dot(-r5.xyz, r4.xyz);
	r2.w = r2.w + r2.w;
	r5.xyz = r4.xyz * -r2.www + -r5.xyz;
	r2.w = dot(r4.xyz, -gDirectionalLight.xyz);
	r3.z = saturate(r2.w + -0.25);
	r3.z = r3.z * 1.3333334;
	r3.w = saturate(dot(-gDirectionalLight.xyz, r5.xyz));
	r3.w = r3.w + 1E-05;
	r3.y = r3.y + 1E-05;
	r4.x = pow(r3.w, r3.y);
	r2.w = saturate(r2.w * 2 + -0.5);
	r2.w = r2.w * r4.x;
	r4.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r4.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r4.xyz;
	r4.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r4.xyz;
	r4.xyz = r4.xyz + gShadowMatrix[3].xyz;
	r3.yw = r4.xy + -gShadowParam18192021.zw;
	r5.xy = r3.yy + -gCascadeXMaxThresholds.xy;
	r5.zw = -r3.yy + gCascadeXMinThresholds.xy;
	r5 = (r5 >= 0) ? 1 : 0;
	r6.xy = r3.ww + -gCascadeYMaxThresholds.xy;
	r6.zw = -r3.ww + gCascadeYMinThresholds.xy;
	r6 = (r6 >= 0) ? 1 : 0;
	r5.xy = r5.zw + r5.xy;
	r5.xy = r6.xy + r5.xy;
	r5.yz = saturate(r6.zw + r5.xy);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r4.xyz = r4.zxy * r6.zxy + r7.zxy;
	r4.x = saturate(r4.x);
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r3.yw = saturate(abs(r3.yw) * 4 + r5.xy);
	r4.w = max(r3.y, r3.w);
	r3.y = -r4.x + 1;
	r5 = tex2D(gShadowZSamplerDir, r4.yz);
	r3.y = -r3.y + r5.x;
	r3.y = (r3.y >= 0) ? 0 : 0.33333334;
	r3.y = r4.w + r3.y;
	r3.y = r3.y + -0.4;
	r3.y = saturate(r3.y * 1.6666666);
	r3.w = r3.y * -2 + 3;
	r3.y = r3.y * r3.y;
	r3.y = r3.y * r3.w;
	r4.xyz = r3.yyy * gDirectionalColour.xyz;
	r5.xyz = r2.www * r4.xyz;
	r3.yzw = r3.zzz * r4.xyz;
	r4.xyz = r5.xyz * gDirectionalLight.www;
	r2.xyz = r2.xyz * r0.zzz + r3.yzw;
	r0.z = dot(r2.xyz, 0.33333334);
	r0.z = r0.z + 0.015;
	r0.xyz = r0.zzz * r0.xyw;
	r0.xyz = r4.xyz * r3.xxx + r0.xyz;
	r0.xyz = r1.xyz * r2.xyz + r0.xyz;
	o.w = r1.w * globalScalars.x;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.w = r1.z + -65504;
	r1.z = -r1.z + 1;
	r1.z = (r1.w >= 0) ? -65503 : r1.z;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.xyz = lerp(r1.xxx, r0.xyz, r0.www);
	o.xyz = r2.xyz * matMaterialColorScale.xxx;

	return o;
}
