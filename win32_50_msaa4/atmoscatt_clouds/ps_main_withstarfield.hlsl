cbuffer _Globals : register(b1)
{
	float4 SunDirection : packoffset(c132);
	float3 SkyColor : packoffset(c133);
	float3 AzimuthColor : packoffset(c134);
	float3 SunColor : packoffset(c135);
	float UnderLightStrength : packoffset(c136);
	float3 gtaSkyDomeFade : packoffset(c137);
	float3 gtaWaterColor : packoffset(c138);
	float MoonGlow : packoffset(c139);
	float2 SunAxias : packoffset(c140);
	float3 AzimuthColorEast : packoffset(c141);
	float AzimuthHeight : packoffset(c142);
	float4 CloudColor : packoffset(c143);
	float4 SunsetColor : packoffset(c144);
	float AzimuthStrength : packoffset(c145);
	float CloudThreshold : packoffset(c146);
	float CloudBias : packoffset(c147);
	float CloudFadeOut : packoffset(c148);
	float TopCloudHeight : packoffset(c149);
	float TopCloudDetail : packoffset(c150);
	float TopCloudThreshold : packoffset(c151);
	float4 TopCloudBiasDetailThresholdHeight : packoffset(c152);
	float3 TopCloudColor : packoffset(c153);
	float TopCloudLight : packoffset(c154);
	float CloudShadowStrength : packoffset(c155);
	float CloudShadowOffset : packoffset(c156);
	float4 CloudThicknessEdgeSmoothDetailScaleStrength : packoffset(c157);
	float CloudInscatteringRange : packoffset(c158);
	float4 StarFieldBrightness : packoffset(c159);
	float StarFieldUVRepeat : packoffset(c160);
	float2 GalaxyOffset : packoffset(c161);
	float4 MoonTexPosition : packoffset(c162);
	float4 MoonLight : packoffset(c163);
	float StarThreshold : packoffset(c164);
	float MoonVisiblity : packoffset(c165);
	float4 MoonColorConstant : packoffset(c166);
	float3 MoonPosition : packoffset(c167);
	float3 MoonXVector : packoffset(c168);
	float3 MoonYVector : packoffset(c169);
	float2 DetailOffset : packoffset(c170);
	float SunSize : packoffset(c171);
	float TimeOfDay : packoffset(c172);
	float HDRExposure : packoffset(c173);
	float3 HDRSunExposure : packoffset(c174);
	float3 HDRExposureClamp : packoffset(c175);
};

cbuffer Sun : register(b4)
{
	float3 SunCentre : packoffset(c0);
};

SamplerState StarFieldSampler : register(s4);
SamplerState GalaxySampler : register(s5);
SamplerState PerlinNoiseSampler : register(s6);
SamplerState HighDetailNoiseSampler : register(s7);
Texture2D StarFieldSampler_tex : register(t4);
Texture2D GalaxySampler_tex : register(t5);
Texture2D PerlinNoiseSampler_tex : register(t6);
Texture2D HighDetailNoiseSampler_tex : register(t7);

struct PS_IN
{
	float4 sv_position : SV_Position;
	float3 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
};

float4 main(PS_IN i) : SV_Target
{
	float4 o;

	float4 r0;
	float4 r1;
	int4 r2;
	float4 r3;
	r0.yz = float2(0.9375, 0.5);
	r0.w = saturate(1 + -(HDRSunExposure.y));
	r0.x = r0.w * -11.6163721;
	r1.xyz = i.texcoord1.xyz + float3(0.00000999999975, 0.00000999999975, 0.00000999999975);
	r1.w = dot(r1.xyz, r1.xyz);
	r1.w = rsqrt(r1.w);
	r1.xyz = r1.www * r1.xyz;
	r2.y = asint(dot(r1.xyz, SunDirection.xyz));
	r1.x = saturate(r1.y * 4 + -(CloudFadeOut));
	r2.x = asint(r0.w * asfloat(r2.y));
	r0.xyz = saturate(asfloat(r2.xyy) * float3(12.5799999, -0.0625, 0.5) + r0.xyz);
	r0.xy = r0.xy + float2(0.00000999999975, 0.00000999999975);
	r0.xy = log2(r0.xy);
	r0.xy = r0.xy * float2(32.0000114, 3.00001001);
	r0.xy = exp2(r0.xy);
	r0.w = saturate(0.600000024 + SunDirection.w);
	r0.x = -(r0.y) * r0.w + r0.x;
	r0.x = r0.z * SunSize + r0.x;
	r0.y = saturate(r0.z * SunCentre.y + SunCentre.x);
	r0.x = saturate(r0.x * 0.5);
	r0.z = r0.y * r0.y;
	r0.y = r0.y * -2 + 3;
	r0.y = r0.y * r0.z;
	r0.y = r0.y * SunCentre.z;
	r0.x = r0.x * 4 + r0.y;
	r0.yzw = r0.xxx * SunColor.xyz;
	r0.yzw = abs(r0.yzw) + float3(0.00000999999975, 0.00000999999975, 0.00000999999975);
	r0.yzw = log2(r0.yzw);
	r0.yzw = r0.yzw * float3(4.00001001, 4.00001001, 4.00001001);
	r0.yzw = exp2(r0.yzw);
	r0.yzw = r0.xxx * SunColor.xyz + r0.yzw;
	r0.x = saturate(-(r0.x) + 1);
	r0.x = r0.x * HDRSunExposure.x;
	r1.yzw = saturate(r0.xxx * i.texcoord5.xyz);
	r0.xyz = r0.yzw * HDRSunExposure.xxx + r1.yzw;
	r1.yzw = StarFieldSampler_tex.Sample(StarFieldSampler, i.texcoord3.xy).xyz;
	r1.yzw = r1.yzw * StarFieldBrightness.xxx + -(StarFieldBrightness.zzz);
	r2.xzw = asint(GalaxySampler_tex.Sample(GalaxySampler, i.texcoord3.zw).xyz);
	r3.xyz = asfloat(r2.xzw) * StarFieldBrightness.yyy;
	r0.w = dot(r3.xyz, float3(1.20000005, 1.20000005, 1.20000005));
	r1.yzw = r1.yzw * r0.www + r1.yzw;
	r1.yzw = saturate(asfloat(r2.xzw) * StarFieldBrightness.yyy + r1.yzw);
	r0.xyz = r0.xyz + r1.yzw;
	r0.w = asfloat(r2.y) * 0.25 + 0.349999994;
	r1.y = asfloat(r2.y) * asfloat(r2.y);
	r1.zw = i.texcoord2.xy * CloudThicknessEdgeSmoothDetailScaleStrength.zz;
	r1.z = HighDetailNoiseSampler_tex.Sample(HighDetailNoiseSampler, r1.zw).x;
	r1.z = r1.z * CloudThicknessEdgeSmoothDetailScaleStrength.w;
	r1.w = PerlinNoiseSampler_tex.Sample(PerlinNoiseSampler, i.texcoord2.xy).x;
	r1.z = r1.z * 0.200000003 + r1.w;
	r1.z = CloudThreshold * r1.z + -(CloudBias);
	r1.z = saturate(r1.z * CloudShadowStrength);
	r1.w = -(r1.z) + 1;
	r2.x = asint(0.00000999999975 + CloudThicknessEdgeSmoothDetailScaleStrength.x);
	r2.yz = asint(PerlinNoiseSampler_tex.Sample(PerlinNoiseSampler, i.texcoord.xy).xz);
	r2.w = asint(HighDetailNoiseSampler_tex.Sample(HighDetailNoiseSampler, i.texcoord2.zw).x);
	r2.w = asint(asfloat(r2.w) + -0.5);
	r2.y = asint(asfloat(r2.w) * CloudThicknessEdgeSmoothDetailScaleStrength.w + asfloat(r2.y));
	r2.z = asint(saturate(asfloat(r2.w) * 0.200000003 + asfloat(r2.z)));
	r2.w = asint(asfloat(r2.w) * CloudThicknessEdgeSmoothDetailScaleStrength.w);
	r2.y = asint(saturate(CloudThreshold * asfloat(r2.y) + -(CloudBias)));
	r3.x = asfloat(r2.y) + 0.00000999999975;
	r2.y = asint(saturate(asfloat(r2.y) * CloudThicknessEdgeSmoothDetailScaleStrength.y));
	r3.x = log2(r3.x);
	r2.x = asint(asfloat(r2.x) * r3.x);
	r2.x = asint(exp2(asfloat(r2.x)));
	r3.x = asfloat(r2.y) * asfloat(r2.x);
	r2.x = asint(-(asfloat(r2.x)) * asfloat(r2.y) + 1);
	r1.w = r1.w * r3.x;
	r1.w = r1.w * asfloat(r2.z) + asfloat(r2.z);
	r0.w = r0.w * r1.w;
	r1.w = -(r1.z) * 0.5 + asfloat(r2.x);
	r1.w = max(r1.w, 0);
	r1.y = r1.w * r1.y;
	r1.y = r1.y * CloudInscatteringRange + 1;
	r1.yzw = saturate(r1.yyy * CloudColor.xyz + -(r1.zzz));
	r1.yzw = SunsetColor.xyz * r0.www + r1.yzw;
	r3.yzw = -(r1.yzw) + TopCloudColor.xyz;
	r0.w = PerlinNoiseSampler_tex.Sample(PerlinNoiseSampler, i.texcoord4.xy).y;
	r0.w = asfloat(r2.w) * TopCloudBiasDetailThresholdHeight.y + r0.w;
	r0.w = saturate(TopCloudBiasDetailThresholdHeight.z * r0.w + -(TopCloudBiasDetailThresholdHeight.x));
	r0.w = r0.w * i.texcoord4.z;
	r0.w = asfloat(r2.x) * r0.w;
	r2.x = asint(asfloat(r2.x) * r0.w + r3.x);
	r1.yzw = r0.www * r3.yzw + r1.yzw;
	r1.yzw = -(r0.xyz) + r1.yzw;
	r0.w = r1.x * asfloat(r2.x);
	r0.xyz = r0.www * r1.yzw + r0.xyz;
	r0.xyz = r0.xyz * HDRExposure;
	r0.xyz = min(r0.xyz, HDRExposureClamp.xyz);
	r0.xyz = min(r0.xyz, HDRExposureClamp.xyz);
	r1.xyz = abs(r0.xyz) + float3(0.00000999999975, 0.00000999999975, 0.00000999999975);
	r1.xyz = log2(r1.xyz);
	r1.xyz = r1.xyz * float3(0.250010014, 0.250010014, 0.250010014);
	r1.xyz = exp2(r1.xyz);
	r2.xyz = (r0.xyz < float3(1, 1, 1)) ? -1 : 0;
	r0.xyz = (r2.xyz != 0) ? r1.xyz : r0.xyz;
	r1.xyz = -(r0.xyz) + gtaWaterColor.xyz;
	r0.w = -(i.texcoord1.y) + gtaSkyDomeFade.x;
	r0.w = saturate(r0.w * gtaSkyDomeFade.y);
	o.xyz = r0.www * r1.xyz + r0.xyz;
	o.w = 1;

	return o;
}
