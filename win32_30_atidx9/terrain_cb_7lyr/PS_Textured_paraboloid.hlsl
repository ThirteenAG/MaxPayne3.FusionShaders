sampler2D BumpSampler_layer0 : register(s1);
sampler2D BumpSampler_layer1 : register(s3);
sampler2D BumpSampler_layer2 : register(s5);
sampler2D BumpSampler_layer3 : register(s7);
sampler2D BumpSampler_layer4 : register(s9);
sampler2D BumpSampler_layer5 : register(s11);
sampler2D BumpSampler_layer6 : register(s13);
float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectBottomOffsetScreenEdge : register(c67);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorCorrectTopScreenEdge : register(c66);
float4 ColorShift : register(c45);
sampler2D TextureSampler_layer0 : register(s0);
sampler2D TextureSampler_layer1 : register(s2);
sampler2D TextureSampler_layer2 : register(s4);
sampler2D TextureSampler_layer3 : register(s6);
sampler2D TextureSampler_layer4 : register(s8);
sampler2D TextureSampler_layer5 : register(s10);
sampler2D TextureSampler_layer6 : register(s12);
float bumpiness : register(c2);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightAmbientDir0 : register(c72);
float4 gLightAmbientDir1 : register(c73);
float4 globalFogColor : register(c38);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 globalScalars4 : register(c51);
float4 globalScreenSize : register(c41);
sampler2D lookupSampler : register(s14);
float specularColorFactor : register(c1);
float specularFactor : register(c0);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float2 vpos : VPOS;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color1 : COLOR1;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	r0 = float4(-512, 1E-05, 1E-05, 1E-05) + i.texcoord4.zxyz;
	r1 = r0.x;
	r2.xyz = normalize(r0.yzw);
	clip(r1);
	r0 = tex2D(BumpSampler_layer6, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(BumpSampler_layer5, i.texcoord.xy);
	r0.z = -r1.w + 1;
	r0.z = -r1.x + r0.z;
	r0.zw = (r0.zz >= 0) ? r1.wy : r1.xy;
	r1 = tex2D(BumpSampler_layer4, i.texcoord.xy);
	r1.z = -r1.w + 1;
	r1.z = -r1.x + r1.z;
	r1.xy = (r1.zz >= 0) ? r1.wy : r1.xy;
	r3 = tex2D(BumpSampler_layer3, i.texcoord.xy);
	r1.z = -r3.w + 1;
	r1.z = -r3.x + r1.z;
	r1.zw = (r1.zz >= 0) ? r3.wy : r3.xy;
	r3 = tex2D(BumpSampler_layer2, i.texcoord.xy);
	r2.w = -r3.w + 1;
	r2.w = -r3.x + r2.w;
	r3.xy = (r2.ww >= 0) ? r3.wy : r3.xy;
	r4 = tex2D(BumpSampler_layer0, i.texcoord.xy);
	r2.w = -r4.w + 1;
	r2.w = -r4.x + r2.w;
	r3.zw = (r2.ww >= 0) ? r4.wy : r4.xy;
	r4 = tex2D(BumpSampler_layer1, i.texcoord.xy);
	r2.w = -r4.w + 1;
	r2.w = -r4.x + r2.w;
	r4.xy = (r2.ww >= 0) ? r4.wy : r4.xy;
	r5 = tex2D(lookupSampler, i.texcoord.zw);
	r6 = -r5.xyz + 1;
	r2.w = r6.y * r6.x;
	r4.z = r5.z * r2.w;
	r2.w = r6.z * r2.w;
	r4.xy = r4.zz * r4.xy;
	r3.zw = r3.zw * r2.ww + r4.xy;
	r4.xy = r5.yx * r6.xy;
	r6.xy = r6.zz * r4.xy;
	r4.xy = r5.zz * r4.yx;
	r4.w = r5.y * r5.x;
	r4.w = r6.z * r4.w;
	r3.xy = r3.xy * r6.xx + r3.zw;
	r1.zw = r1.zw * r4.yy + r3.xy;
	r1.xy = r1.xy * r6.yy + r1.zw;
	r0.zw = r0.zw * r4.xx + r1.xy;
	r0.xy = r0.xy * r4.ww + r0.zw;
	r0.xy = r0.xy + -0.5;
	r0.xy = r0.xy * bumpiness.xx;
	r0.xy = r0.xy + r0.xy;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r1.x = max(r0.z, 0);
	r0.z = rsqrt(r1.x);
	r0.z = 1 / r0.z;
	r1.xyz = r0.xxx * i.texcoord5.xyz;
	r0.xzw = i.texcoord2.xyz * r0.zzz + r1.xyz;
	r0.xyz = r0.yyy * i.texcoord6.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0.x = dot(r2.xyz, r1.xyz);
	r0.x = r0.x + r0.x;
	r0.xyz = r1.xyz * -r0.xxx + r2.xyz;
	r0.x = saturate(dot(-gDirectionalLight.xyz, r0.xyz));
	r0.x = r0.x + 1E-05;
	r0.y = 1E-05;
	r0.y = r0.y + specularFactor.x;
	r1.w = pow(r0.x, r0.y);
	r0.xyz = gDirectionalColour.www * gDirectionalColour.xyz;
	r2.xyz = r1.www * r0.xyz;
	r2.xyz = r2.xyz * gDirectionalLight.www;
	r2.xyz = r2.xyz * specularColorFactor.xxx;
	r0.w = dot(gLightAmbientDir0.xyz, r1.xyz);
	r0.w = r0.w + gLightAmbientDir0.w;
	r0.w = saturate(r0.w * gLightAmbientDir1.w);
	r3.xyz = r0.www * gLightAmbient0.xyz;
	r3.xyz = r3.xyz * i.texcoord3.xxx;
	r0.w = dot(gLightAmbientDir1.xyz, r1.xyz);
	r1.x = dot(r1.xyz, -gDirectionalLight.xyz);
	r1.x = r1.x + -0.25;
	r1.x = saturate(r1.x * 1.3333334);
	r0.w = r0.w + gLightAmbientDir0.w;
	r0.w = saturate(r0.w * gLightAmbientDir1.w);
	r1.yzw = r0.www * gLightAmbient1.xyz;
	r1.yzw = r1.yzw * i.texcoord3.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.yzw = r0.www * r1.yzw;
	r1.yzw = r3.xyz * r0.www + r1.yzw;
	r0.xyz = r0.xyz * r1.xxx + r1.yzw;
	r1 = i.texcoord.xyxx * float4(1, 1, 0, 0) + float4(0, 0, 0, -1.3);
	r3 = tex2Dbias(TextureSampler_layer1, r1);
	r3.xyz = r4.zzz * r3.xyz;
	r5 = tex2Dbias(TextureSampler_layer0, r1);
	r3.xyz = r5.xyz * r2.www + r3.xyz;
	r5 = tex2Dbias(TextureSampler_layer2, r1);
	r3.xyz = r5.xyz * r6.xxx + r3.xyz;
	r5 = tex2Dbias(TextureSampler_layer3, r1);
	r3.xyz = r5.xyz * r4.yyy + r3.xyz;
	r5 = tex2Dbias(TextureSampler_layer4, r1);
	r3.xyz = r5.xyz * r6.yyy + r3.xyz;
	r5 = tex2Dbias(TextureSampler_layer5, r1);
	r1 = tex2Dbias(TextureSampler_layer6, r1);
	r3.xyz = r5.xyz * r4.xxx + r3.xyz;
	r1.xyz = r1.xyz * r4.www + r3.xyz;
	r0.xyz = r1.xyz * r0.xyz + r2.xyz;
	r0.w = -globalFogParams.x + globalFogParams.y;
	r0.w = 1 / r0.w;
	r1.x = -globalFogParams.x + i.texcoord2.w;
	r0.w = saturate(r0.w * r1.x);
	r1.xyz = lerp(r0.xyz, globalFogColor.xyz, r0.www);
	r0.x = dot(r1.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r0.y = r2.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.xxx, r1.xyz, r0.yyy);
	r0.y = r0.x * ColorCorrectBottomOffset.w;
	r0.x = r0.x * ColorShift.w;
	r1.xyz = globalScalars4.yzw * -r0.yyy + r2.xyz;
	r2.xyz = ColorShift.xyz * -r0.xxx + r2.xyz;
	r3.xyz = r0.yyy * globalScalars4.yzw;
	r0.y = saturate(r0.y);
	r0.yzw = r0.yyy * r1.xyz + r3.xyz;
	r1.x = 1 / globalScreenSize.y;
	r1.y = r1.x * i.vpos.y;
	r3 = ColorCorrectTopScreenEdge;
	r3.xyz = r1.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r3.xyz;
	r4.xyz = r0.yzw * r3.xyz;
	r0.yzw = r0.xxx * ColorShift.xyz;
	r0.x = saturate(r0.x);
	r0.xyz = r0.xxx * r2.xyz + r0.yzw;
	r2.xyz = ColorCorrectBottomOffset.xyz;
	r2.xyz = r1.yyy * r2.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r0.xyz * r2.xyz;
	r1.z = 1 / globalScreenSize.x;
	r1.x = r1.z * i.vpos.x;
	r1.xy = r1.xy + -0.5;
	r1.x = dot(r1.xy, r1.xy) + 0;
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.y = r3.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r1.y = (r1.y >= 0) ? -r1.y : -0;
	r1.x = r1.y + r1.x;
	r1.y = r1.y + ColorCorrectTopScreenEdge.w;
	r1.y = 1 / r1.y;
	r1.y = saturate(r1.y * r1.x);
	r1.x = (r1.x >= 0) ? r1.y : 0;
	r1.y = globalScalars.x * globalScalars.x;
	r0.w = r1.y * i.texcoord3.w;
	r4.w = r0.w;
	r2 = lerp(r0, r4, r1.x);
	r0 = (ColorCorrectTopScreenEdge.w >= 0) ? r2 : r0;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.color.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.color.z = 1 / r0.y;
	o.color.y = 1 / r0.x;
	r0.x = 64 + -i.texcoord2.w;
	r0.x = saturate(r0.x * 0.25);
	o.color.w = r0.x * r0.w;
	r0 = i.texcoord2.w * float4(0.125, 0.125, 0.125, 0) + float4(0, 0, 0, 1);
	o.color1 = max(r0, 0);

	return o;
}
