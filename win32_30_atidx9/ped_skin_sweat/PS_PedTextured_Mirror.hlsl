float3 AmbientLightingParams : register(c212);
sampler2D BumpSampler : register(s4);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s5);
float bumpiness : register(c203);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c209);
float4 specMapExpMask : register(c207);
float3 specMapIntMask : register(c206);
float specularFactor : register(c205);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float4 r10;
	o.w = globalScalars.x * i.texcoord7.w;
	r0.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r0.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r0.xyz;
	r0.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gShadowMatrix[3].xyz;
	r1.xy = r0.xy + -gShadowParam18192021.zw;
	r2.xyz = r1.xxx + -gCascadeXMaxThresholds.xyz;
	r2.xyz = (r2.xyz >= 0) ? 1 : 0;
	r3.xyz = -r1.xxx + gCascadeXMinThresholds.xyz;
	r3.xyz = (r3.xyz >= 0) ? 1 : 0;
	r2.xyz = r2.xyz + r3.xyz;
	r3.xyz = r1.yyy + -gCascadeYMaxThresholds.xyz;
	r3.xyz = (r3.xyz >= 0) ? 1 : 0;
	r2.xyz = r2.xyz + r3.xyz;
	r3.xyz = -r1.yyy + gCascadeYMinThresholds.xyz;
	r3.xyz = (r3.xyz >= 0) ? 1 : 0;
	r2.yzw = saturate(r2.xyz + r3.xyz);
	r2.x = 1;
	r3.x = dot(r2, gShadowParam0123);
	r3.y = dot(r2, gShadowParam4567);
	r3.z = dot(r2, gCascadeZScales);
	r4.x = dot(r2, gShadowParam891113);
	r4.y = dot(r2, gShadowParam14151617);
	r4.z = dot(r2, gCascadeZOffsets);
	r0.xyz = r0.zxy * r3.zxy + r4.zxy;
	r0.x = saturate(r0.x);
	r3 = tex2D(gShadowZSamplerDir, r0.yz);
	r0.x = -r0.x + 1;
	r0.x = -r3.x + r0.x;
	r0.x = (r0.x >= 0) ? -1 : -0;
	r2.x = abs(gCascadeXMinThresholds.w);
	r2.y = abs(gCascadeYMinThresholds.w);
	r3.x = abs(gCascadeXMaxThresholds.w);
	r3.y = abs(gCascadeYMaxThresholds.w);
	r0.yz = max(r2.xy, r3.xy);
	r1.zw = r0.yz + -0.25;
	r0.yz = r0.yz + -r1.zw;
	r1.xy = -r1.zw + abs(r1.xy);
	r2.x = 1 / r0.y;
	r2.y = 1 / r0.z;
	r0.yz = saturate(r1.xy * r2.xy);
	r1.xy = r0.yz * -2 + 3;
	r0.yz = r0.yz * r0.yz;
	r0.yz = r0.yz * r1.xy;
	r1.x = max(r0.y, r0.z);
	r0.y = r2.w + r1.x;
	r0.x = r0.x + r0.y;
	r0.x = saturate(r0.x + 1);
	r0.yzw = gDirectionalColour.www * gDirectionalColour.xyz;
	r0.xyz = r0.xxx * r0.yzw;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r1.w + 1;
	r0.w = -r1.x + r0.w;
	r1.xy = (r0.ww >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r0.w = dot(r1.xy, -r1.xy) + 1;
	r1.z = max(r0.w, 0);
	r0.w = rsqrt(r1.z);
	r0.w = 1 / r0.w;
	r1.xzw = r1.xxx * i.texcoord4.xyz;
	r1.xzw = r0.www * i.texcoord1.xyz + r1.xzw;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r1.xzw;
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r1.xyz = 1E-05 + i.texcoord3.xyz;
	r3.xyz = normalize(r1.xyz);
	r0.w = dot(-r3.xyz, r2.xyz);
	r0.w = r0.w + r0.w;
	r1.xyz = r2.xyz * -r0.www + -r3.xyz;
	r0.w = saturate(dot(-gDirectionalLight.xyz, r1.xyz));
	r0.w = r0.w + 1E-05;
	r3 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r3, specMapExpMask);
	r2.w = dot(r3.xyz, specMapIntMask.xyz);
	r1.w = r1.w * specularFactor.x;
	r3.x = max(1, r1.w);
	r1.w = r3.x + 1E-05;
	r3.x = r3.x * 0.25 + 1E-05;
	r3.y = pow(r0.w, r1.w);
	r0.w = dot(r2.xyz, -gDirectionalLight.xyz);
	r1.w = saturate(r0.w * 2 + -0.5);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r4 = r0.www * r0.xyz;
	r0.w = r1.w * r3.y;
	r0.xyz = r0.www * r0.xyz;
	r5 = gLightPosX + -i.texcoord2.x;
	r6 = r5 * r5;
	r7 = gLightPosY + -i.texcoord2.y;
	r6 = r7 * r7 + r6;
	r8 = gLightPosZ + -i.texcoord2.z;
	r6 = r8 * r8 + r6;
	r9 = r6 + 1E-05;
	r10.x = 1;
	r6 = saturate(r6 * -gLightFallOff + r10.x);
	r6 = r6 * r6;
	r6 = r6 * r6 + -0.1;
	r10.x = rsqrt(r9.x);
	r10.y = rsqrt(r9.y);
	r10.z = rsqrt(r9.z);
	r10.w = rsqrt(r9.w);
	r5 = r5 * r10;
	r9 = r2.x * r5;
	r7 = r7 * r10;
	r8 = r8 * r10;
	r9 = r7 * r2.y + r9;
	r9 = r8 * r2.z + r9;
	r0.w = saturate(r2.z * -0.5 + 0.5);
	r10 = r6 * 1.1111112;
	r6 = (r6 >= 0) ? r10 : 0;
	r6 = saturate(r6 * r9);
	r9 = r5 * -gLightDirX;
	r5 = r1.x * r5;
	r5 = r1.y * r7 + r5;
	r1 = saturate(r1.z * r8 + r5);
	r1 = r1 + 1E-05;
	r5 = r7 * -gLightDirY + r9;
	r5 = r8 * -gLightDirZ + r5;
	r7 = gLightConeScale;
	r5 = saturate(r5 * r7 + gLightConeOffset);
	r5 = r6 * r5;
	r6.x = log2(r1.x);
	r6.y = log2(r1.y);
	r6.z = log2(r1.z);
	r6.w = log2(r1.w);
	r1 = r3.x * r6;
	r3.x = exp2(r1.x);
	r3.y = exp2(r1.y);
	r3.z = exp2(r1.z);
	r3.w = exp2(r1.w);
	r1 = r5 * r3;
	r2.x = dot(gLightColR, r1);
	r2.y = dot(gLightColG, r1);
	r2.z = dot(gLightColB, r1);
	r0.xyz = r0.xyz * gDirectionalLight.www + r2.xyz;
	r0.xyz = r2.www * r0.xyz;
	r1.xyz = gLightAmbient0.xyz;
	r1.xyz = -r1.xyz + gLightAmbient1.xyz;
	r1.xyz = r0.www * r1.xyz + gLightAmbient0.xyz;
	r2.yz = float2(0.15, 1);
	r0.w = saturate(AmbientLightingParams.x * -r2.y + r2.z);
	r0.w = saturate(r0.w + 0.2);
	r0.w = r0.w * AmbientLightingParams.y;
	r0.w = i.texcoord7.x * r0.w + -i.texcoord7.x;
	r0.w = gAmbientOcclusionEffect.x * r0.w + i.texcoord7.x;
	r1.xyz = r0.www * r1.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r1.xyz * r0.www + r4.xyz;
	r2.x = dot(gLightColR, r5);
	r2.y = dot(gLightColG, r5);
	r2.z = dot(gLightColB, r5);
	r1.xyz = r1.xyz + r2.xyz;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2.xyz = r2.xyz * r2.xyz;
	r0.xyz = r2.xyz * r1.xyz + r0.xyz;
	r0.xyz = r0.xyz * matMaterialColorScale.xxx;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;

	return o;
}
