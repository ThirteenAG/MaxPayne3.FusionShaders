sampler2D BloodSampler : register(s2);
sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s5);
sampler3D VolumeSampler : register(s6);
sampler2D WrinkleMaskSampler_0 : register(s7);
sampler2D WrinkleMaskSampler_1 : register(s8);
sampler2D WrinkleSampler_A : register(s9);
sampler2D WrinkleSampler_B : register(s10);
float bumpiness : register(c197);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c204);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gBloodData : register(c203);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c202);
float4 specMapExpMask : register(c201);
float3 specMapIntMask : register(c200);
float specularFactor : register(c199);
float4 wrinkleMaskStrengths0 : register(c206);
float4 wrinkleMaskStrengths1 : register(c207);
float4 wrinkleMaskStrengths2 : register(c209);
float4 wrinkleMaskStrengths3 : register(c210);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r1, specMapExpMask);
	r1.w = r1.w * specularFactor.x;
	r1.x = dot(r1.xyz, specMapIntMask.xyz);
	r2.x = max(1, r1.w);
	r3 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r4 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r1.y = dot(wrinkleMaskStrengths0, r3);
	r1.w = dot(wrinkleMaskStrengths1, r4);
	r1.y = r1.w + r1.y;
	r1.w = dot(wrinkleMaskStrengths2, r3);
	r2.y = dot(wrinkleMaskStrengths3, r4);
	r1.w = r1.w + r2.y;
	r3 = tex2D(BumpSampler, i.texcoord.xy);
	r2.y = -r3.w + 1;
	r2.y = -r3.x + r2.y;
	r2.yz = (r2.yy >= 0) ? r3.wy : r3.xy;
	r2.yz = r2.yz + -0.5;
	r2.yz = r2.yz * bumpiness.xx;
	r2.yz = r2.yz + r2.yz;
	r3 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r2.w = -r3.w + 1;
	r2.w = -r3.x + r2.w;
	r3.xy = (r2.ww >= 0) ? r3.wy : r3.xy;
	r4 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r2.w = -r4.w + 1;
	r2.w = -r4.x + r2.w;
	r3.zw = (r2.ww >= 0) ? r4.wy : r4.xy;
	r3 = r3 + -0.5;
	r3.xy = r3.xy * 2 + -r2.yz;
	r2.yz = r1.yy * r3.xy + r2.yz;
	r3.xy = r3.zw * 2 + -r2.yz;
	r3.xy = r1.ww * r3.xy + r2.yz;
	r1.y = dot(r3.xy, -r3.xy) + 1;
	r2.y = max(r1.y, 0);
	r1.y = rsqrt(r2.y);
	r3.z = 1 / r1.y;
	r2.yzw = r3.xyz + 1E-05;
	r3.xyz = normalize(r2.yzw);
	r2.yzw = r3.xxx * i.texcoord4.xyz;
	r2.yzw = i.texcoord1.xyz * r3.zzz + r2.yzw;
	r2.yzw = i.texcoord5.xyz * r3.yyy + r2.yzw;
	r2.yzw = r2.yzw + 1E-05;
	r1.y = dot(r2.yzw, r2.yzw);
	r1.y = rsqrt(r1.y);
	r3.xw = float2(1, 0);
	if (-gBloodData.w < r3.w) {
		r4 = tex2D(BloodSampler, i.texcoord.zw);
		r5.z = min(r4.y, r4.x);
		r1.w = saturate(r4.x * 0.5 + r4.w);
		r5.xy = r4.xy;
		r3.y = -r0.x + r5.x;
		r3.y = r1.w * r3.y;
		r4.xyz = lerp(r0.xyz, r5.xyz, r1.www);
		r1.w = dot(r4.xyz, float3(0.2125, 0.7154, 0.0721));
		r5.xyz = lerp(r1.www, r4.xyz, gAdrenoFXVars.yyy);
		r1.w = saturate(r3.y * gAmbientOcclusionEffect.z);
		r0.xyz = lerp(r4.xyz, r5.xyz, r1.www);
	}
	r2.yzw = r2.yzw * r1.yyy + 1E-05;
	r1.y = dot(r2.yzw, r2.yzw);
	r1.y = rsqrt(r1.y);
	r4.xyz = r1.yyy * r2.yzw;
	r0.w = r0.w * i.texcoord2.w;
	r0.xyz = r0.xyz * matMaterialColorScale.xxx;
	r1.w = r1.x * matMaterialColorScale.w;
	r2.x = r2.x * matMaterialColorScale.w;
	r5.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r5.xyz = r5.xyz + 1E-05;
	r6 = normalize(r5.xyz);
	r2.yzw = r2.yzw * r1.yyy + 1E-05;
	r5.xyz = normalize(r2.yzw);
	r1.y = dot(r6.xyz, r5.xyz);
	r2.y = r1.y * 1.5 + 1;
	r1.y = (-r1.y >= 0) ? r2.y : 1;
	r2.y = r1.y * i.texcoord2.y;
	r1.w = saturate(r1.w * 5);
	r1.w = r1.w * r2.y;
	r5.x = r2.x * 0.015625;
	r2.x = saturate(r2.x * -0.01 + 1);
	r1.w = r1.w * r2.x;
	r1.y = (r1.y >= 0) ? r1.w : 0;
	r1.x = r1.x * matMaterialColorScale.w + r1.y;
	r1.y = r1.z * 16;
	r1.w = frac(r1.y);
	r1.y = r1.y + -r1.w;
	r1.w = (-r1.w >= 0) ? 0 : 1;
	r1.z = (r1.z >= 0) ? 0 : r1.w;
	r1.y = r1.z + r1.y;
	r2.xy = detailSettings.zw * i.texcoord.xy;
	r1.y = r1.y + 0.5;
	r2.z = r1.y * 0.0625;
	r2 = tex3D(VolumeSampler, r2.xyz);
	r1.yzw = r2.yzx * 2 + -1;
	r2.x = detailSettings.x * i.texcoord2.w;
	r1.w = r1.w * r2.x + 1;
	r2.xyz = r0.xyz * r1.www;
	r5.yzw = r1.zzz * i.texcoord5.xyz;
	r5.yzw = i.texcoord4.xyz * r1.yyy + r5.yzw;
	r5.yzw = r5.yzw * detailSettings.yyy;
	r4.xyz = r5.yzw * i.texcoord2.www + r4.xyz;
	r4.xyz = r4.xyz + 1E-05;
	r6 = normalize(r4.xyz);
	o.color2.x = saturate(r1.w * r1.x);
	r1.x = dot(r2.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.z = 0.1;
	r1.y = saturate(r1.z + deSatContrastGamma.x);
	r1.y = 1 / r1.y;
	r1.y = r1.y * gAdrenoFXVars.z;
	r0.xyz = r0.xyz * r1.www + -r1.xxx;
	r0.xyz = r1.yyy * r0.xyz + r1.xxx;
	r1.xyz = saturate(r3.xxx + -ColorCorrectTopAndPedReflectScale.xyz);
	r1.xyz = r1.xyz * 0.25 + 1;
	r1.w = saturate(gAmbientOcclusionEffect.z);
	r0.xyz = r0.xyz * r1.xyz + -r2.xyz;
	o.color.xyz = r1.www * r0.xyz + r2.xyz;
	o.color2.z = saturate(r1.w + i.texcoord2.x);
	o.color1.xyz = r6.xyz * 0.5 + 0.5;
	r5.x = saturate(r5.x);
	r0.x = rsqrt(r5.x);
	o.color2.y = 1 / r0.x;
	r0.x = r0.w * globalScalars.x;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3 = r3.wwwx * gStencil.x;

	return o;
}
