sampler2D DepthMapPointSampler : register(s4);
sampler2D LowResDepthMapPointSampler : register(s5);
float4 TexelSize : register(c197);
sampler2D TransparentSrcMapSampler : register(s3);
float g_fBilateralCoefficient : register(c199);

float4 main(float2 texcoord : TEXCOORD) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	r0.xy = float2(0.5, -0.5);
	r1 = texcoord.xyxy * TexelSize.zwzw + r0.x;
	r2 = frac(r1.zwzw);
	r1 = r1 + -r2;
	r0.zw = r1.zw * -TexelSize.xy + texcoord.xy;
	r2 = r0.yyxx * TexelSize.xyxy;
	r3.x = 1 / r2.z;
	r3.y = 1 / r2.w;
	r2 = r1 * TexelSize.xyxy + r2;
	r1.xy = r1.zw * TexelSize.xy;
	r1 = TexelSize.xyxy * r0.xyyx + r1.xyxy;
	r0.xy = r0.zw * r3.xy;
	r0.xy = r0.xy * 0.5 + 0.5;
	r0.z = -r0.x + 1;
	r0.z = -r0.y + r0.z;
	r0.z = r0.x * r0.y + r0.z;
	r3 = tex2D(LowResDepthMapPointSampler, r2.xy);
	r0.w = -r0.z + 0.5;
	r0.w = (r0.w >= 0) ? -0 : -1;
	r4 = tex2D(DepthMapPointSampler, texcoord.xy);
	r3.y = -r3.x + r4.x;
	r0.w = (r3.y >= 0) ? -0 : r0.w;
	r0.w = (r0.w >= 0) ? r3.x : r4.x;
	r0.w = -r4.x + r0.w;
	r3.x = 1 / g_fBilateralCoefficient.x;
	r0.w = abs(r0.w) * r3.x;
	r0.w = r0.w * r0.w;
	r0.w = r0.w * -0.7213475;
	r0.w = exp2(r0.w);
	r3.y = r0.z * r0.w;
	r5 = tex2D(TransparentSrcMapSampler, r1.xy);
	r6 = tex2D(LowResDepthMapPointSampler, r1.xy);
	r1.xy = r0.xx * -r0.yy + r0.xy;
	r3.zw = -r1.xy + 0.5;
	r3.zw = (r3.zw >= 0) ? -0 : -1;
	r4.y = r4.x + -r6.x;
	r3.z = (r4.y >= 0) ? -0 : r3.z;
	r3.z = (r3.z >= 0) ? r6.x : r4.x;
	r3.z = -r4.x + r3.z;
	r3.z = r3.x * abs(r3.z);
	r3.z = r3.z * r3.z;
	r3.z = r3.z * -0.7213475;
	r3.z = exp2(r3.z);
	r1.x = r1.x * r3.z;
	r5 = r1.x * r5;
	r0.z = r0.w * r0.z + r1.x;
	r6 = tex2D(TransparentSrcMapSampler, r2.xy);
	r5 = r6 * r3.y + r5;
	r6 = tex2D(TransparentSrcMapSampler, r1.zw);
	r7 = tex2D(LowResDepthMapPointSampler, r1.zw);
	r0.w = r4.x + -r7.x;
	r0.w = (r0.w >= 0) ? -0 : r3.w;
	r0.w = (r0.w >= 0) ? r7.x : r4.x;
	r0.w = -r4.x + r0.w;
	r0.w = r3.x * abs(r0.w);
	r0.w = r0.w * r0.w;
	r0.w = r0.w * -0.7213475;
	r0.w = exp2(r0.w);
	r1.x = r1.y * r0.w;
	r0.z = r0.w * r1.y + r0.z;
	r1 = r6 * r1.x + r5;
	r0.w = r0.x * -r0.y + 0.5;
	r0.x = r0.y * r0.x;
	r0.y = (r0.w >= 0) ? -0 : -1;
	r5 = tex2D(LowResDepthMapPointSampler, r2.zw);
	r2 = tex2D(TransparentSrcMapSampler, r2.zw);
	r0.w = r4.x + -r5.x;
	r0.y = (r0.w >= 0) ? -0 : r0.y;
	r0.y = (r0.y >= 0) ? r5.x : r4.x;
	r0.y = -r4.x + r0.y;
	r0.y = r3.x * abs(r0.y);
	r0.y = r0.y * r0.y;
	r0.y = r0.y * -0.7213475;
	r0.y = exp2(r0.y);
	r0.w = r0.x * r0.y;
	r0.x = r0.y * r0.x + r0.z;
	r1 = r2 * r0.w + r1;
	r0.y = frac(-r0.x);
	r0.y = r0.y + r0.x;
	r0.x = r0.x + -1;
	r0.x = r0.y * r0.x + 1;
	r0.x = 1 / r0.x;
	o = r0.x * r1;

	return o;
}
