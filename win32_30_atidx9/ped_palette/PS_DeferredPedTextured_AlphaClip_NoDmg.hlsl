sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s5);
sampler2D TextureSamplerDiffPal : register(s6);
sampler3D VolumeSampler : register(s7);
float bumpiness : register(c197);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c205);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c202);
float paletteSelector : register(c204);
float4 specMapExpMask : register(c201);
float3 specMapIntMask : register(c200);
float specularFactor : register(c199);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r1.x = max(r0.z, 0);
	r0.z = rsqrt(r1.x);
	r0.z = 1 / r0.z;
	r1.xyz = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r1.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r1.xyz = r0.xyz * r0.www + 1E-05;
	r0.xyz = r0.www * r0.xyz;
	r2.xyz = normalize(r1.xyz);
	r1.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r3.xyz = normalize(r1.xyz);
	r0.w = dot(r3.xyz, r2.xyz);
	r1.x = r0.w * 1.5 + 1;
	r0.w = (-r0.w >= 0) ? r1.x : 1;
	r1.x = r0.w * i.texcoord2.y;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r1.y = dot(r2.xyz, specMapIntMask.xyz);
	r1.z = r1.y * matMaterialColorScale.w;
	r1.z = saturate(r1.z * 5);
	r1.x = r1.z * r1.x;
	r1.z = dot(r2, specMapExpMask);
	r1.z = r1.z * specularFactor.x;
	r2.x = max(1, r1.z);
	r1.z = r2.x * matMaterialColorScale.w;
	r1.w = saturate(r1.z * -0.01 + 1);
	r2.x = r1.z * 0.015625;
	r2.x = saturate(r2.x);
	r1.z = rsqrt(r2.x);
	o.color2.y = 1 / r1.z;
	r1.x = r1.x * r1.w;
	r0.w = (r0.w >= 0) ? r1.x : 0;
	r0.w = r1.y * matMaterialColorScale.w + r0.w;
	r1.x = r2.z * 16;
	r1.y = frac(r1.x);
	r1.x = r1.x + -r1.y;
	r1.y = (-r1.y >= 0) ? 0 : 1;
	r1.y = (r2.z >= 0) ? 0 : r1.y;
	r1.x = r1.y + r1.x;
	r1.x = r1.x + 0.5;
	r1.z = r1.x * 0.0625;
	r1.xy = detailSettings.zw * i.texcoord.xy;
	r1 = tex3D(VolumeSampler, r1.xyz);
	r1.xyz = r1.yzx * 2 + -1;
	r1.w = detailSettings.x * i.texcoord2.w;
	r1.z = r1.z * r1.w + 1;
	o.color2.x = saturate(r0.w * r1.z);
	r2.y = paletteSelector.x;
	r3 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.w = r3.w * 255.01;
	r1.w = frac(r0.w);
	r0.w = r0.w + -r1.w;
	r1.w = r0.w + -32;
	r0.w = -r0.w + 160;
	r0.w = (r0.w >= 0) ? -1 : -0;
	r0.w = (r1.w >= 0) ? r0.w : -0;
	r2.x = r1.w * 0.0078125;
	r2 = tex2D(TextureSamplerDiffPal, r2.xy);
	r4.xyz = lerp(r3.xyz, r2.xyz, r2.www);
	r4.w = 1;
	r2 = (r0.w >= 0) ? r3 : r4;
	r2.xyz = r2.xyz * matMaterialColorScale.xxx;
	r0.w = r2.w * i.texcoord2.w;
	r0.w = r0.w * globalScalars.x;
	r3.xyz = r1.zzz * r2.xyz;
	r1.w = dot(r3.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.xyz = r2.xyz * r1.zzz + -r1.www;
	r1.z = 0.1;
	r1.z = saturate(r1.z + deSatContrastGamma.x);
	r1.z = 1 / r1.z;
	r1.z = r1.z * gAdrenoFXVars.z;
	r2.xyz = r1.zzz * r2.xyz + r1.www;
	r4.xw = float2(1, 0);
	r5 = saturate(r4.xxx + -ColorCorrectTopAndPedReflectScale.xyz);
	r5 = r5.xyz * 0.25 + 1;
	r2.xyz = r2.xyz * r5.xyz + -r3.xyz;
	r1.z = saturate(gAmbientOcclusionEffect.z);
	o.color.xyz = r1.zzz * r2.xyz + r3.xyz;
	o.color2.z = saturate(r1.z + i.texcoord2.x);
	r1.yzw = r1.yyy * i.texcoord5.xyz;
	r1.xyz = i.texcoord4.xyz * r1.xxx + r1.yzw;
	r1.xyz = r1.xyz * detailSettings.yyy;
	r0.xyz = r1.xyz * i.texcoord2.www + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	o.color1.xyz = r1.xyz * 0.5 + 0.5;
	o.color.w = r0.w;
	o.color1.w = r0.w;
	o.color2.w = r0.w;
	o.color3 = r4.wwwx * gStencil.x;

	return o;
}
