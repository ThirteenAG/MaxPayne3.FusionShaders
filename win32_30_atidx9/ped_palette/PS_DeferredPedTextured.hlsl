sampler2D BloodSampler : register(s2);
sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s5);
sampler2D TextureSamplerDiffPal : register(s6);
sampler3D VolumeSampler : register(s7);
float bumpiness : register(c197);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c205);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gBloodData : register(c203);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c202);
float paletteSelector : register(c204);
float4 specMapExpMask : register(c201);
float3 specMapIntMask : register(c200);
float specularFactor : register(c199);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.z, 0);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r2, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r2.x = dot(r2.xyz, specMapIntMask.xyz);
	r2.y = max(1, r0.w);
	r3.xyz = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r3.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r2.w = r1.w * 255.01;
	r3.x = frac(r2.w);
	r2.w = r2.w + -r3.x;
	r3.x = r2.w + -32;
	r2.w = -r2.w + 160;
	r4.x = r3.x * 0.0078125;
	r4.y = paletteSelector.x;
	r4 = tex2D(TextureSamplerDiffPal, r4.xy);
	r5.xyz = lerp(r1.xyz, r4.xyz, r4.www);
	r2.w = (r2.w >= 0) ? -1 : -0;
	r2.w = (r3.x >= 0) ? r2.w : -0;
	r5.w = 1;
	r1 = (r2.w >= 0) ? r1 : r5;
	r3.xw = float2(1, 0);
	if (-gBloodData.w < r3.w) {
		r4 = tex2D(BloodSampler, i.texcoord.zw);
		r5.z = min(r4.y, r4.x);
		r2.w = saturate(r4.x * 0.5 + r4.w);
		r5.xy = r4.xy;
		r3.y = -r1.x + r5.x;
		r3.y = r2.w * r3.y;
		r4.xyz = lerp(r1.xyz, r5.xyz, r2.www);
		r2.w = dot(r4.xyz, float3(0.2125, 0.7154, 0.0721));
		r5.xyz = lerp(r2.www, r4.xyz, gAdrenoFXVars.yyy);
		r2.w = saturate(r3.y * gAmbientOcclusionEffect.z);
		r1.xyz = lerp(r4.xyz, r5.xyz, r2.www);
	}
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r4.xyz = r0.www * r0.xyz;
	r1.w = r1.w * i.texcoord2.w;
	r1.xyz = r1.xyz * matMaterialColorScale.xxx;
	r2.yw = r2.yx * matMaterialColorScale.ww;
	r5.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r5.xyz = r5.xyz + 1E-05;
	r6 = normalize(r5.xyz);
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r5.xyz = normalize(r0.xyz);
	r0.x = dot(r6.xyz, r5.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.z = saturate(r2.w * 5);
	r0.y = r0.z * r0.y;
	r5.x = r2.y * 0.015625;
	r0.z = saturate(r2.y * -0.01 + 1);
	r0.y = r0.y * r0.z;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r2.x * matMaterialColorScale.w + r0.x;
	r0.y = r2.z * 16;
	r0.z = frac(r0.y);
	r0.y = r0.y + -r0.z;
	r0.z = (-r0.z >= 0) ? 0 : 1;
	r0.z = (r2.z >= 0) ? 0 : r0.z;
	r0.y = r0.z + r0.y;
	r2.xy = detailSettings.zw * i.texcoord.xy;
	r0.y = r0.y + 0.5;
	r2.z = r0.y * 0.0625;
	r2 = tex3D(VolumeSampler, r2.xyz);
	r0.yzw = r2.yzx * 2 + -1;
	r2.x = detailSettings.x * i.texcoord2.w;
	r0.w = r0.w * r2.x + 1;
	r2.xyz = r0.www * r1.xyz;
	r5.yzw = r0.zzz * i.texcoord5.xyz;
	r5.yzw = i.texcoord4.xyz * r0.yyy + r5.yzw;
	r5.yzw = r5.yzw * detailSettings.yyy;
	r4.xyz = r5.yzw * i.texcoord2.www + r4.xyz;
	r4.xyz = r4.xyz + 1E-05;
	r6 = normalize(r4.xyz);
	o.color2.x = saturate(r0.w * r0.x);
	r0.x = dot(r2.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.y = 0.1;
	r0.y = saturate(r0.y + deSatContrastGamma.x);
	r0.y = 1 / r0.y;
	r0.y = r0.y * gAdrenoFXVars.z;
	r1.xyz = r1.xyz * r0.www + -r0.xxx;
	r0.xyz = r0.yyy * r1.xyz + r0.xxx;
	r1.xyz = saturate(r3.xxx + -ColorCorrectTopAndPedReflectScale.xyz);
	r1.xyz = r1.xyz * 0.25 + 1;
	r0.w = saturate(gAmbientOcclusionEffect.z);
	r0.xyz = r0.xyz * r1.xyz + -r2.xyz;
	o.color.xyz = r0.www * r0.xyz + r2.xyz;
	o.color2.z = saturate(r0.w + i.texcoord2.x);
	o.color1.xyz = r6.xyz * 0.5 + 0.5;
	r5.x = saturate(r5.x);
	r0.x = rsqrt(r5.x);
	o.color2.y = 1 / r0.x;
	r0.x = r1.w * globalScalars.x;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3 = r3.wwwx * gStencil.x;

	return o;
}
