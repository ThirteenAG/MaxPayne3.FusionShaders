float4 NearFarPlane : register(c128);
float gAmbientAmount : register(c105);
float4 gAmbientOcclusionEffect : register(c63);
float4 gAspectRatio : register(c17);
float gBiasToCamera : register(c98);
float4 gDepthFxParams : register(c18);
float gDiffuse : register(c103);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float gNormalArc : register(c107);
float gScaleFade : register(c108);
float gSuperAlpha : register(c106);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float gWrapBias : register(c102);
float gWrapScale : register(c101);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord8 : TEXCOORD8;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float3 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float4 r10;
	r0.x = i.normal.z * 0.15915494 + 0.5;
	r0.x = frac(r0.x);
	r0.x = r0.x * 6.2831855 + -3.1415927;
	sincos(r0.x, r1.y, r1.x);
	r0.x = (1E-06 >= i.color.w) ? 1 : 0;
	r0.y = 1 / gScaleFade.x;
	r2.x = 0.1;
	r0.z = r2.x * gBiasToCamera.x;
	r2 = lerp(i.position.xyz, gViewInverse[3].xyz, r0.zzz);
	r3 = r2.y * gWorldViewProj[1];
	r3 = r2.x * gWorldViewProj[0] + r3;
	r3 = r2.z * gWorldViewProj[2] + r3;
	r3 = r3 + gWorldViewProj[3];
	r0.z = r3.w + -NearFarPlane.x;
	r0.y = saturate(r0.y * r0.z);
	r0.x = r0.x * -r0.y + r0.y;
	r0.yz = r0.xx * i.normal.xy;
	r0.x = r0.x * i.color.w;
	o.texcoord.w = saturate(r0.x * gSuperAlpha.x);
	r1.yzw = r1.yyx * r0.zyz;
	r4.x = r0.y * r1.x + -r1.y;
	o.texcoord8.xy = r0.yz;
	r4.y = r1.w + r1.z;
	r0.xy = r4.xy * gAspectRatio.xy;
	r0.xy = r0.xy * r0.xy;
	r0.x = r0.y + r0.x;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = (-r0.x < r0.x) ? 1 : 0;
	r0.w = 1E-05;
	r0.yz = r4.xy * gAspectRatio.xy + r0.ww;
	r1.xy = r0.yz * r0.yz;
	r0.w = r1.y + r1.x;
	r0.w = rsqrt(r0.w);
	r0.yz = r0.ww * r0.yz;
	r0.xy = r0.yz * r0.xx;
	r1.xyz = r2.yyy * gWorldView[1].xyz;
	r1.xyz = r2.xxx * gWorldView[0].xyz + r1.xyz;
	r1.xyz = r2.zzz * gWorldView[2].xyz + r1.xyz;
	r1.xyz = r1.xyz + gWorldView[3].xyz;
	r5.xyz = -r1.xyz + 1E-05;
	r6.xyz = normalize(r5.xyz);
	r5.xyz = r6.zxy * float3(-1, 0, 0);
	r5.xyz = r6.yzx * float3(0, 0, -1) + -r5.xyz;
	r5.xyz = r5.xyz + 1E-05;
	r7.xyz = normalize(r5.xyz);
	r5.xyz = r6.zxy * r7.yzx;
	r5.xyz = r6.yzx * r7.zxy + -r5.xyz;
	r0.yzw = r0.yyy * r5.xyz;
	r0.xyz = r7.xyz * r0.xxx + r0.yzw;
	r0.xyz = r6.xyz * gNormalArc.xxx + r0.xyz;
	r5.xyz = r0.xyz + 1E-05;
	r0.w = dot(r5.xyz, r5.xyz);
	r0.w = rsqrt(r0.w);
	r5.xyz = lerp(-r0.xyz, 1E-05, r0.www);
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r0.w = 1 / r0.w;
	r0.w = (-r0.w < r0.w) ? 1 : 0;
	r0.xyz = r0.www * r5.xyz + r0.xyz;
	r5 = -r1.x + gLightPosX;
	r6 = r5 * -gLightDirX;
	r7 = -r1.y + gLightPosY;
	r1 = -r1.z + gLightPosZ;
	r6 = r7 * -gLightDirY + r6;
	r6 = r1 * -gLightDirZ + r6;
	r8 = r5 * r5;
	r8 = r7 * r7 + r8;
	r8 = r1 * r1 + r8;
	r9 = r8 + 1E-05;
	r10.z = 1;
	r8 = r8 * -gLightFallOff + r10.z;
	r8 = max(r8, 0);
	r8 = r8 * r8;
	r8 = r8 * r8 + -0.1;
	r8 = max(r8, 0);
	r10.x = rsqrt(r9.x);
	r10.y = rsqrt(r9.y);
	r10.z = rsqrt(r9.z);
	r10.w = rsqrt(r9.w);
	r6 = r6 * r10;
	r9 = gLightConeScale;
	r6 = saturate(r6 * r9 + gLightConeOffset);
	r8 = r8 * r10;
	r8 = r8 * 1.1111112;
	r8 = min(r8, 1);
	r6 = r6 * r8;
	r6 = r10 * r6;
	r5 = r5 * r6;
	r5 = r0.x * r5;
	r7 = r6 * r7;
	r5 = r0.y * r7 + r5;
	r1 = r1 * r6;
	r0.w = r6.x * gWrapBias.x;
	r1 = saturate(r0.z * r1 + r5);
	r5.x = dot(gLightColR, r1);
	r5.y = dot(gLightColG, r1);
	r5.z = dot(gLightColB, r1);
	r1.x = dot(r0.xyz, -gDirectionalLight.xyz);
	r0.x = dot(r0.xyz, gWorldView[2].xyz);
	r0.x = saturate(r0.x * -0.5 + 0.5);
	r0.y = saturate(r1.x * gWrapScale.x + r0.w);
	r0.yzw = r0.yyy * gDirectionalColour.xyz;
	r0.yzw = r0.yzw * gDirectionalColour.www + r5.xyz;
	r1.xyz = gLightAmbient0.xyz;
	r1.xyz = -r1.xyz + gLightAmbient1.xyz;
	r1.xyz = r0.xxx * r1.xyz + gLightAmbient0.xyz;
	r1.xyz = r1.xyz * gAmbientAmount.xxx;
	r0.x = 1 / gAmbientOcclusionEffect.y;
	r0.xyz = r1.xyz * r0.xxx + r0.yzw;
	r0.xyz = r0.xyz * gDiffuse.xxx;
	o.texcoord.xyz = r0.xyz * i.color.xyz;
	r4.zw = 0;
	r0 = r4 * gAspectRatio + r3;
	r1.x = saturate(-r0.w * gDepthFxParams.z + gDepthFxParams.w);
	o.position = r0;
	r0.x = -r1.x + 1;
	o.texcoord2.zw = r0.xx * gDepthFxParams.xy + r1.xx;
	r0.xyz = r2.xyz + -gViewInverse[3].xyz;
	r0.w = r0.z * globalFogParams.x;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * globalFogParams.z;
	r0.y = r0.w * -1.442695;
	r0.y = exp2(r0.y);
	r0.y = min(r0.y, 65504);
	r0.y = -r0.y + 1;
	r0.z = 1 / r0.w;
	r0.w = (0.0001 < abs(r0.w)) ? 1 : 0;
	r0.y = r0.z * r0.y;
	r0.y = r0.x * r0.y + -r0.x;
	r0.x = r0.w * r0.y + r0.x;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = exp2(r0.x);
	r0.x = min(r0.x, 65504);
	o.texcoord4.w = -r0.x + 1;
	r0 = r2.y * gWorldView[1];
	r0 = r2.x * gWorldView[0] + r0;
	r0 = r2.z * gWorldView[2] + r0;
	o.texcoord7 = r0 + gWorldView[3];
	o.texcoord8.zw = i.normal.zw;
	o.texcoord1 = i.texcoord;
	o.texcoord2.xy = i.texcoord1.xy;
	o.texcoord3 = float4(1, 0, 0, 0) * i.texcoord2.z;
	o.texcoord4.xyz = globalFogColorN.xyz;
	o.texcoord5 = i.texcoord3;

	return o;
}
