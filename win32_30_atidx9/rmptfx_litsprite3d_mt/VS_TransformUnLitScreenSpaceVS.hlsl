float4 gActiveUnit : register(c200);
float4 gDepthFxParams : register(c18);
float4 gInterpolationFactor : register(c217);
float4 gPositionScale : register(c219);
float gSuperAlpha : register(c210);
float4 gTextureAngleRads : register(c216);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScreenSize : register(c41);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord8 : TEXCOORD8;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	r0.x = abs(gViewInverse[2].z);
	r0.y = r0.x * -0.0187293 + 0.074261;
	r0.y = r0.y * r0.x + -0.2121144;
	r0.y = r0.y * r0.x + 1.5707288;
	r0.x = -r0.x + 1;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * r0.y;
	r0.y = r0.x * -2 + 3.1415927;
	r0.z = (gViewInverse[2].z < -gViewInverse[2].z) ? 1 : 0;
	r0.x = r0.y * r0.z + r0.x;
	r0.x = -r0.x + 1.5707964;
	r0 = abs(r0.x) + -gTextureAngleRads;
	r0 = r0 * 0.15915494 + 0.5;
	r0 = frac(r0);
	r0 = r0 * 6.2831855 + -3.1415927;
	r0 = r0 * r0;
	r1 = r0 * -2.523985E-07 + 2.47609E-05;
	r1 = r0 * r1 + -0.0013888397;
	r1 = r0 * r1 + 0.04166664;
	r1 = r0 * r1 + -0.5;
	r0 = r0 * r1 + 1;
	r0 = abs(r0) + 1E-05;
	r1.x = log2(r0.x);
	r1.y = log2(r0.y);
	r1.z = log2(r0.z);
	r1.w = log2(r0.w);
	r0.x = 1E-05;
	r2 = r0.x + gInterpolationFactor;
	r1 = r1 * r2;
	r2.x = exp2(r1.x);
	r2.y = exp2(r1.y);
	r2.z = exp2(r1.z);
	r2.w = exp2(r1.w);
	r0 = r2 * gActiveUnit + r0.x;
	r1.x = dot(r0, r0);
	r1.x = rsqrt(r1.x);
	r0 = r0 * r1.x;
	r1.x = dot(r0, gPositionScale);
	o.texcoord6 = r0;
	r0 = r1.x * i.normal.xyxy;
	r1.x = i.normal.z * 0.15915494 + 0.5;
	r1.x = frac(r1.x);
	r1.x = r1.x * 6.2831855 + -3.1415927;
	sincos(r1.x, r2.y, r2.x);
	r0.yzw = r0.yzw * r2.yyx;
	r0.x = r0.x * r2.x + -r0.y;
	r0.y = r0.w + r0.z;
	r0.z = 1 / globalScreenSize.y;
	r1.y = r0.z * globalScreenSize.x;
	r1.x = 1;
	r0.xy = r0.xy * r1.xy;
	r0.z = -1 + i.normal.w;
	r0.z = (-abs(r0.z) >= abs(r0.z)) ? 1 : 0;
	r0.xy = r0.xy * r0.zz;
	r0.z = 0;
	o.position.xyz = i.position.xyx * float3(1, 1, 0) + r0.xyz;
	o.texcoord.w = saturate(gSuperAlpha.x * i.color.w);
	r0.x = saturate(gDepthFxParams.w + -gDepthFxParams.z);
	r0.y = -r0.x + 1;
	o.texcoord2.zw = r0.yy * gDepthFxParams.xy + r0.xx;
	r0.xyz = -gViewInverse[3].xyz + i.position.xyz;
	r0.w = r0.z * globalFogParams.x;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * globalFogParams.z;
	r0.y = r0.w * -1.442695;
	r0.y = exp2(r0.y);
	r0.y = min(r0.y, 65504);
	r0.y = -r0.y + 1;
	r0.z = 1 / r0.w;
	r0.w = (0.0001 < abs(r0.w)) ? 1 : 0;
	r0.y = r0.z * r0.y;
	r0.y = r0.x * r0.y + -r0.x;
	r0.x = r0.w * r0.y + r0.x;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = exp2(r0.x);
	r0.x = min(r0.x, 65504);
	o.texcoord4.w = -r0.x + 1;
	r0 = gWorldView[1] * i.position.y;
	r0 = i.position.x * gWorldView[0] + r0;
	r0 = i.position.z * gWorldView[2] + r0;
	o.texcoord7 = r0 + gWorldView[3];
	o.position.w = 1;
	o.texcoord.xyz = i.color.xyz;
	o.texcoord8 = i.normal;
	o.texcoord1 = i.texcoord;
	o.texcoord2.xy = i.texcoord1.xy;
	o.texcoord3 = float4(1, 0, 0, 0) * i.texcoord2.z;
	o.texcoord4.xyz = globalFogColorN.xyz;
	o.texcoord5 = i.texcoord3;

	return o;
}
