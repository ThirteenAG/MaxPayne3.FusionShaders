sampler2D BumpSampler : register(s1);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s2);
sampler3D VolumeSampler : register(s3);
float bumpiness : register(c198);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c204);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c203);
float4 specMapExpMask : register(c202);
float3 specMapIntMask : register(c201);
float specularFactor : register(c200);
float4 stipplePattern : register(c62);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
	float2 vpos : VPOS;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float3 r3;
	float2 r4;
	float3 r5;
	float3 r6;
	float3 r7;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.xy = 0.5 * i.vpos.xy;
	r1.xy = frac(abs(r1.xy));
	r1.xy = (i.vpos.xy >= 0) ? r1.xy : -r1.xy;
	r1.xy = r1.xy + r1.xy;
	r1.zw = frac(r1.xy);
	r1.xy = -r1.zw + r1.xy;
	r1.x = r1.y * 2 + r1.x;
	r1 = r1.x + float4(-0, -1, -2, -3);
	r1 = (-abs(r1) >= 0) ? 1 : 0;
	r1.x = dot(stipplePattern, r1);
	r1.x = -r0.w + r1.x;
	r1 = (r1.x >= 0) ? -1 : -0;
	clip(r1);
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r1.z = -r1.w + 1;
	r1.z = -r1.x + r1.z;
	r1.xy = (r1.zz >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r1.z = dot(r1.xy, -r1.xy) + 1;
	r2.x = max(r1.z, 0);
	r1.z = rsqrt(r2.x);
	r1.z = 1 / r1.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r2, specMapExpMask);
	r1.w = r1.w * specularFactor.x;
	r2.x = dot(r2.xyz, specMapIntMask.xyz);
	r2.y = max(1, r1.w);
	r3 = r1.xxx * i.texcoord4.xyz;
	r1.xzw = r1.zzz * i.texcoord1.xyz + r3.xyz;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r1.xzw;
	r1.xyz = r1.xyz + 1E-05;
	r1.w = dot(r1.xyz, r1.xyz);
	r1.w = rsqrt(r1.w);
	r3 = r1.www * r1.xyz;
	r0.w = r0.w * i.texcoord2.w;
	r0.xyz = r0.xyz * matMaterialColorScale.xxx;
	r2.w = r2.x * matMaterialColorScale.w;
	r4.y = r2.y * matMaterialColorScale.w;
	r5 = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r5 = r5.xyz + 1E-05;
	r6 = normalize(r5.xyz);
	r1.xyz = r1.xyz * r1.www + 1E-05;
	r5 = normalize(r1.xyz);
	r1.x = dot(r6.xyz, r5.xyz);
	r1.y = r1.x * 1.5 + 1;
	r1.x = (-r1.x >= 0) ? r1.y : 1;
	r1.y = r1.x * i.texcoord2.y;
	r1.z = saturate(r2.w * 5);
	r1.y = r1.z * r1.y;
	r1.z = saturate(r4.y * -0.01 + 1);
	r1.y = r1.y * r1.z;
	r1.x = (r1.x >= 0) ? r1.y : 0;
	r1.x = r2.x * matMaterialColorScale.w + r1.x;
	r1.y = r2.z * 16;
	r1.z = frac(r1.y);
	r1.y = r1.y + -r1.z;
	r1.z = (-r1.z >= 0) ? 0 : 1;
	r1.z = (r2.z >= 0) ? 0 : r1.z;
	r1.y = r1.z + r1.y;
	r2.xy = detailSettings.zw * i.texcoord.xy;
	r1.y = r1.y + 0.5;
	r2.z = r1.y * 0.0625;
	r2 = tex3D(VolumeSampler, r2.xyz);
	r1.yzw = r2.yzx * 2 + -1;
	r2.x = detailSettings.x * i.texcoord2.w;
	r1.w = r1.w * r2.x + 1;
	r2.xyz = r0.xyz * r1.www;
	r5 = r1.zzz * i.texcoord5.xyz;
	r5 = i.texcoord4.xyz * r1.yyy + r5.xyz;
	r5 = r5.xyz * detailSettings.yyy;
	r3 = r5.xyz * i.texcoord2.www + r3.xyz;
	r3 = r3.xyz + 1E-05;
	r5 = normalize(r3.xyz);
	o.color2.x = saturate(r1.w * r1.x);
	r1.xyz = gViewInverse[3].xyz + -i.texcoord7.xyz;
	r3 = 1E-05 + i.texcoord4.xyz;
	r6 = normalize(r3.xyz);
	r3 = 1E-05 + i.texcoord5.xyz;
	r7 = normalize(r3.xyz);
	r1.xyz = r1.xyz + 1E-05;
	r3 = normalize(r1.xyz);
	r1.x = dot(r3.xyz, r6.xyz);
	r1.y = dot(r3.xyz, r7.xyz);
	r3.xy = r1.xy * r1.xy;
	r4.x = 1;
	r1.x = dot(r3.xy, r4.xy) + 0;
	r1.y = dot(r3.xy, r4.xy) + -1;
	r0.w = saturate(r0.w * 1.7);
	r1.z = dot(r2.xyz, float3(0.2125, 0.7154, 0.0721));
	r3.z = 0.1;
	r2.w = saturate(r3.z + deSatContrastGamma.x);
	r2.w = 1 / r2.w;
	r2.w = r2.w * gAdrenoFXVars.z;
	r0.xyz = r0.xyz * r1.www + -r1.zzz;
	r0.xyz = r2.www * r0.xyz + r1.zzz;
	r1.zw = float2(1, 0);
	r3 = saturate(r1.zzz + -ColorCorrectTopAndPedReflectScale.xyz);
	r3 = r3.xyz * 0.25 + 1;
	r2.w = saturate(gAmbientOcclusionEffect.z);
	r0.xyz = r0.xyz * r3.xyz + -r2.xyz;
	o.color.xyz = r2.www * r0.xyz + r2.xyz;
	o.color2.z = saturate(r2.w + i.texcoord2.x);
	o.color1.xyz = r5.xyz * 0.5 + 0.5;
	r0.x = saturate(r1.x * 0.015625);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	o.color2.y = (r1.y >= 0) ? r0.x : 0.125;
	r0.x = r0.w * globalScalars.x;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3 = r1.wwwz * gStencil.x;

	return o;
}
