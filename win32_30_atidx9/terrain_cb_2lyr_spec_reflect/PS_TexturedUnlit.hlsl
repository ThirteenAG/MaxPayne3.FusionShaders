float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectBottomOffsetScreenEdge : register(c67);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorCorrectTopScreenEdge : register(c66);
float4 ColorShift : register(c45);
sampler2D TextureSampler_layer0 : register(s0);
sampler2D TextureSampler_layer1 : register(s3);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gDepthFxParams : register(c18);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 globalScalars4 : register(c51);
float4 globalScreenSize : register(c41);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 color : COLOR;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord3 : TEXCOORD3;
	float2 vpos : VPOS;
	float4 texcoord2 : TEXCOORD2;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0.xyz = -gViewInverse[3].xyz + i.texcoord1.xyz;
	r0.w = r0.z * globalFogParams.x;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * globalFogParams.z;
	r0.y = r0.w * -1.442695;
	r0.y = exp2(r0.y);
	r0.z = r0.y + -65504;
	r0.y = -r0.y + 1;
	r0.y = (r0.z >= 0) ? -65503 : r0.y;
	r0.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r0.y = r0.z * r0.y;
	r0.y = r0.y * r0.x;
	r0.x = (r0.w >= 0) ? r0.x : r0.y;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = saturate(exp2(r0.x));
	r0.yzw = 1 + -i.color.xyz;
	r0.y = r0.z * r0.y;
	r0.z = r0.w * r0.y;
	r0.y = r0.y * i.color.z;
	r1 = i.texcoord.xyxx * float4(1, 1, 0, 0) + float4(0, 0, 0, -1.3);
	r2 = tex2Dbias(TextureSampler_layer1, r1);
	r1 = tex2Dbias(TextureSampler_layer0, r1);
	r2.xyz = r0.yyy * r2.xyz;
	r1.xyz = r1.xyz * r0.zzz + r2.xyz;
	r2.w = globalScalars.x * i.texcoord3.w;
	r1.w = 1;
	r2.xyz = i.texcoord3.xyz;
	r3 = r1 * r2;
	r0.y = dot(r3.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.xyz = r2.xyz * r1.xyz + -r0.yyy;
	r0.z = saturate(-i.texcoord2.w * gDepthFxParams.z + gDepthFxParams.w);
	r0.w = -r0.z + 1;
	r0.zw = r0.ww * gDepthFxParams.xy + r0.zz;
	r1.xyz = r0.zzz * r1.xyz + r0.yyy;
	r0.y = r0.y + 1E-05;
	r0.y = abs(r0.y) + 1E-05;
	r0.z = r0.w + -0.99999;
	r1.w = pow(r0.y, r0.z);
	r3.xyz = globalFogColorN.xyz;
	r1.xyz = r1.xyz * r1.www + -r3.xyz;
	r1.w = 0;
	r0 = r0.x * r1 + r3;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r1.y = r2.x * deSatContrastGamma.x;
	r2.xyz = lerp(r1.xxx, r0.xyz, r1.yyy);
	r1.y = r1.x * ColorCorrectBottomOffset.w;
	r1.x = r1.x * ColorShift.w;
	r3.xyz = globalScalars4.yzw * -r1.yyy + r2.xyz;
	r2.xyz = ColorShift.xyz * -r1.xxx + r2.xyz;
	r4.xyz = r1.yyy * globalScalars4.yzw;
	r1.y = saturate(r1.y);
	r1.yzw = r1.yyy * r3.xyz + r4.xyz;
	r2.w = 1 / globalScreenSize.y;
	r3.y = r2.w * i.vpos.y;
	r4 = ColorCorrectTopScreenEdge;
	r4.xyz = r3.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r4.xyz;
	r5.xyz = r1.yzw * r4.xyz;
	r5.w = r0.w;
	r1.yzw = r1.xxx * ColorShift.xyz;
	r1.x = saturate(r1.x);
	r1.xyz = r1.xxx * r2.xyz + r1.yzw;
	r2.xyz = ColorCorrectBottomOffset.xyz;
	r2.xyz = r3.yyy * r2.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r1.xyz * r2.xyz;
	r1.x = 1 / globalScreenSize.x;
	r3.x = r1.x * i.vpos.x;
	r1.xy = r3.xy + -0.5;
	r1.x = dot(r1.xy, r1.xy) + 0;
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.y = r4.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r1.y = (r1.y >= 0) ? -r1.y : -0;
	r1.x = r1.y + r1.x;
	r1.y = r1.y + ColorCorrectTopScreenEdge.w;
	r1.y = 1 / r1.y;
	r1.y = saturate(r1.y * r1.x);
	r1.x = (r1.x >= 0) ? r1.y : 0;
	r2 = lerp(r0, r5, r1.x);
	o = (ColorCorrectTopScreenEdge.w >= 0) ? r2 : r0;

	return o;
}
