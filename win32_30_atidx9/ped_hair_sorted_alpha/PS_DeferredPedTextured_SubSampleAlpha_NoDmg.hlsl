sampler2D AnisoNoiseSpecSampler : register(s3);
sampler2D BumpSampler : register(s1);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
float HardAlphaBlend : register(c196);
sampler2D SpecSampler : register(s2);
sampler3D VolumeSampler : register(s4);
float4 anisotropicSpecularColour : register(c211);
float2 anisotropicSpecularExponent : register(c210);
float2 anisotropicSpecularIntensity : register(c209);
float bumpiness : register(c202);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c213);
float fresnelRolloff : register(c201);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c207);
float reflectivePower : register(c199);
float4 specMapExpMask : register(c206);
float3 specMapIntMask : register(c205);
float3 specMapReflectMask : register(c200);
float specularFactor : register(c204);
float4 specularNoiseMapUVScaleFactor : register(c212);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
	float2 vpos : VPOS;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float4 r7;
	float3 r8;
	float3 r9;
	float3 r10;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.z, 0);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r2, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r2.w = dot(r2.xyz, specMapIntMask.xyz);
	r3.x = max(1, r0.w);
	r3.yzw = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r3.yzw;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r3.yzw = r0.www * r0.xyz;
	r4.xw = float2(1, 0);
	if (-reflectivePower.x < r4.w) {
		r4.y = saturate(r3.x * 0.015625);
		r5.w = r4.y * -4 + 4;
		r4.yzw = 1E-05 + i.texcoord3.xyz;
		r6 = normalize(r4.yzw);
		r4.y = dot(-r6.xyz, r3.yzw);
		r4.y = r4.y + r4.y;
		r4.yzw = r3.yzw * -r4.yyy + -r6.xyz;
		r4.yzw = r4.yzw + 1E-05;
		r7.xyz = normalize(r4.yzw);
		r4.y = saturate(r7.z);
		r4.y = r4.y + 1;
		r4.y = r4.y + r4.y;
		r4.y = 1 / r4.y;
		r4.yz = r7.xy * r4.yy + 0.5;
		r5.xy = -r4.yz + 1;
		r5.z = 0;
		r5 = tex2Dlod(DynamicEnvironmentSampler, r5);
		r4.yzw = r5.xyz * r5.xyz;
		r4.yzw = r4.yzw * 16;
		r5.x = saturate(dot(r6.xyz, r3.yzw));
		r5.y = r4.x + -fresnelRolloff.x;
		r5.x = -r5.x + 1.00001;
		r6.x = pow(r5.x, 5.00001);
		r5.x = fresnelRolloff.x * r6.x + r5.y;
		r4.yzw = r4.yzw * r5.xxx;
	} else {
		r4.yzw = 0;
	}
	r4.yzw = r4.yzw * reflectivePower.xxx;
	r2.x = dot(r2.xyz, specMapReflectMask.xyz);
	r4.yzw = r2.xxx * r4.yzw;
	r4.yzw = r4.yzw * ColorCorrectTopAndPedReflectScale.www;
	r1.w = r1.w * i.texcoord2.w;
	r1.xyz = r1.xyz * matMaterialColorScale.xxx;
	r4.yzw = r4.yzw * matMaterialColorScale.zzz;
	r2.x = r2.w * matMaterialColorScale.w;
	r2.y = r3.x * matMaterialColorScale.w;
	r5.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r5.xyz = r5.xyz + 1E-05;
	r6 = normalize(r5.xyz);
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r5.xyz = normalize(r0.xyz);
	r0.x = dot(r6.xyz, r5.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.z = saturate(r2.x * 5);
	r0.y = r0.z * r0.y;
	r2.x = r2.y * 0.015625;
	r0.z = saturate(r2.y * -0.01 + 1);
	r0.y = r0.y * r0.z;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r2.w * matMaterialColorScale.w + r0.x;
	r0.y = r2.z * 16;
	r0.z = frac(r0.y);
	r0.y = r0.y + -r0.z;
	r0.z = (-r0.z >= 0) ? 0 : 1;
	r0.z = (r2.z >= 0) ? 0 : r0.z;
	r0.y = r0.z + r0.y;
	r5.xy = detailSettings.zw * i.texcoord.xy;
	r0.y = r0.y + 0.5;
	r5.z = r0.y * 0.0625;
	r5 = tex3D(VolumeSampler, r5.xyz);
	r0.yzw = r5.yzx * 2 + -1;
	r2.y = detailSettings.x * i.texcoord2.w;
	r0.w = r0.w * r2.y + 1;
	r2.yzw = r0.zzz * i.texcoord5.xyz;
	r2.yzw = i.texcoord4.xyz * r0.yyy + r2.yzw;
	r2.yzw = r2.yzw * detailSettings.yyy;
	r2.yzw = r2.yzw * i.texcoord2.www + r3.yzw;
	r2.yzw = r2.yzw + 1E-05;
	r3.xyz = normalize(r2.yzw);
	r0.x = saturate(r0.w * r0.x);
	r2.yzw = gViewInverse[3].xyz + -i.texcoord7.xyz;
	r5.xyz = 1E-05 + i.texcoord4.xyz;
	r6 = normalize(r5.xyz);
	r5 = specularNoiseMapUVScaleFactor * i.texcoord.xyxy;
	r7 = tex2D(AnisoNoiseSpecSampler, r5.xy);
	r5 = tex2D(AnisoNoiseSpecSampler, r5.zw);
	r2.yzw = r2.yzw + 1E-05;
	r8 = normalize(r2.yzw);
	r9.x = 1E-05;
	r2.yzw = r9.xxx + gViewInverse[2].xyz;
	r9 = normalize(r2.yzw);
	r0.yz = r5.xy * 2 + -1;
	r2.yzw = r0.yyy * i.texcoord1.xyz;
	r2.yzw = r2.yzw * 0.1 + r6.xyz;
	r2.yzw = r2.yzw + 1E-05;
	r5.xyz = normalize(r2.yzw);
	r0.y = dot(r8.xyz, r5.xyz);
	r2.y = dot(r9.xyz, r5.xyz);
	r2.z = r0.y * -r0.y + 1;
	r3.w = max(r2.z, 0);
	r2.z = rsqrt(r3.w);
	r2.z = 1 / r2.z;
	r2.w = r2.y * -r2.y + 1;
	r3.w = max(r2.w, 0);
	r2.w = rsqrt(r3.w);
	r2.w = 1 / r2.w;
	r0.y = r0.y * r2.y;
	r0.y = r2.z * r2.w + -r0.y;
	r0.y = abs(r0.y) + 1E-05;
	r5 = float4(0.1, 8.00001, 16.00001, 0.2);
	r2.yz = r5.yz + anisotropicSpecularExponent.xy;
	r3.w = pow(r0.y, r2.y);
	r6 = i.texcoord1.xyz * r0.zzz + r6.xyz;
	r6 = r6.xyz + 1E-05;
	r10 = normalize(r6.xyz);
	r0.y = dot(r8.xyz, r10.xyz);
	r0.z = dot(r9.xyz, r10.xyz);
	r2.y = r0.y * -r0.y + 1;
	r5.y = max(r2.y, 0);
	r2.y = rsqrt(r5.y);
	r2.y = 1 / r2.y;
	r2.w = r0.z * -r0.z + 1;
	r5.y = max(r2.w, 0);
	r2.w = rsqrt(r5.y);
	r2.w = 1 / r2.w;
	r0.y = r0.z * r0.y;
	r0.y = r2.y * r2.w + -r0.y;
	r0.y = abs(r0.y) + 1E-05;
	r5.y = pow(r0.y, r2.z);
	r0.y = r3.w + r5.y;
	r0.x = r0.y * r0.x;
	r0.y = r5.w + anisotropicSpecularIntensity.x;
	r0.x = r0.y * r0.x;
	o.color2.x = r7.x * r0.x;
	r0.xyz = r5.yyy * anisotropicSpecularColour.xyz;
	r0.xyz = r0.xyz * 0.5;
	r0.xyz = r1.xyz * r0.www + r0.xyz;
	r0.w = 1.5 * i.texcoord2.x;
	r1.xyz = r0.www * r0.xyz;
	r2.y = dot(r1.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.z = saturate(r5.x + deSatContrastGamma.x);
	r2.z = 1 / r2.z;
	r2.z = r2.z * gAdrenoFXVars.z;
	r0.xyz = r0.xyz * r0.www + -r2.yyy;
	r0.xyz = r2.zzz * r0.xyz + r2.yyy;
	r2.yzw = saturate(r4.xxx + -ColorCorrectTopAndPedReflectScale.xyz);
	r2.yzw = r2.yzw * 0.25 + 1;
	r0.w = saturate(gAmbientOcclusionEffect.z);
	r0.xyz = r0.xyz * r2.yzw + -r1.xyz;
	o.color.xyz = r0.www * r0.xyz + r1.xyz;
	o.color2.z = saturate(r0.w + i.texcoord2.x);
	o.color1.xyz = r3.xyz * 0.5 + 0.5;
	r2.x = saturate(r2.x);
	r0.x = rsqrt(r2.x);
	o.color2.y = 1 / r0.x;
	r0.x = r1.w * globalScalars.x;
	r0.yzw = saturate(r4.yzw * 0.0625);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	r0.w = rsqrt(r0.w);
	o.color3.x = 1 / r0.y;
	o.color3.y = 1 / r0.z;
	o.color3.z = 1 / r0.w;
	r0.w = -0.003921569;
	r0.y = r1.w * globalScalars.x + r0.w;
	r0.y = r0.y * 10.039371 + -r0.x;
	r0.y = HardAlphaBlend.x * r0.y + r0.x;
	r0.z = i.vpos.y + i.vpos.x;
	r0.w = frac(r0.z);
	r1.x = r0.z + -r0.w;
	r0.w = (-r0.w >= 0) ? 0 : 1;
	r0.z = (r0.z >= 0) ? 0 : r0.w;
	r0.z = r0.z + r1.x;
	r1.xy = (r0.zz >= 0) ? float2(2, 0.5) : float2(-2, -0.5);
	r0.z = r0.z * r1.y;
	r0.z = frac(r0.z);
	r0.z = r0.z * r1.x;
	r0.w = frac(r0.z);
	r1.x = r0.z + -r0.w;
	r0.w = (-r0.w >= 0) ? 0 : 1;
	r0.z = (r0.z >= 0) ? 0 : r0.w;
	r0.z = r0.z + r1.x;
	r0.yw = -r0.yy + float2(0.95, 0.003921569);
	r0.yw = (r0.yw >= 0) ? 1 : 0;
	r0.y = (-abs(r0.z) >= 0) ? r0.y : 0;
	r0.y = r0.w + r0.y;
	r1 = (-r0.y >= 0) ? -0 : -1;
	clip(r1);
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3.w = 0;

	return o;
}
