float CloudBias : register(c147);
float4 CloudColor : register(c143);
float CloudFadeOut : register(c148);
float CloudInscatteringRange : register(c158);
float CloudShadowStrength : register(c155);
float4 CloudThicknessEdgeSmoothDetailScaleStrength : register(c157);
float CloudThreshold : register(c146);
sampler2D GalaxySampler : register(s5);
float HDRExposure : register(c173);
float3 HDRExposureClamp : register(c175);
float3 HDRSunExposure : register(c174);
sampler2D HighDetailNoiseSampler : register(s7);
float4 MoonColorConstant : register(c166);
float MoonGlow : register(c139);
sampler2D MoonGlowSampler : register(s3);
float4 MoonLight : register(c163);
float3 MoonPosition : register(c167);
sampler2D MoonSampler : register(s2);
float MoonVisiblity : register(c165);
float3 MoonXVector : register(c168);
float3 MoonYVector : register(c169);
sampler2D PerlinNoiseSampler : register(s6);
float4 StarFieldBrightness : register(c159);
sampler2D StarFieldSampler : register(s4);
float3 SunCentre : register(c130);
float3 SunColor : register(c135);
float4 SunDirection : register(c132);
float SunSize : register(c171);
float4 SunsetColor : register(c144);
float4 TopCloudBiasDetailThresholdHeight : register(c152);
float3 TopCloudColor : register(c153);
float3 gtaSkyDomeFade : register(c137);
float3 gtaWaterColor : register(c138);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	r0.w = SunDirection.w;
	r0.x = saturate(r0.w + 0.6);
	r1.yz = float2(0.9375, 0.5);
	r2.xy = float2(1E-05, 1);
	r0.y = saturate(r2.y + -HDRSunExposure.y);
	r1.x = r0.y * -11.616372;
	r3.xyz = 1E-05 + i.texcoord1.xyz;
	r0.z = dot(r3.xyz, r3.xyz);
	r0.z = rsqrt(r0.z);
	r4.xyz = r0.zzz * r3.xyz;
	r3.xyz = r3.xyz * r0.zzz + -MoonPosition.xyz;
	r3.xyz = r3.xyz + -MoonXVector.xyz;
	r3.xyz = r3.xyz + -MoonYVector.xyz;
	r5.y = dot(r4.xyz, SunDirection.xyz);
	r4.x = 4;
	r0.z = saturate(r4.y * r4.x + -CloudFadeOut.x);
	r5.x = r0.y * r5.y;
	r1.xyz = saturate(r5.xyy * float3(12.58, -0.0625, 0.5) + r1.xyz);
	r0.yw = r1.xy + 1E-05;
	r1.x = pow(r0.y, 32.00001);
	r1.y = pow(r0.w, 3.00001);
	r0.x = r1.y * -r0.x + r1.x;
	r0.x = r1.z * SunSize.x + r0.x;
	r0.y = saturate(r1.z * SunCentre.y + SunCentre.x);
	r0.x = saturate(r0.x * 0.5);
	r0.w = r0.y * r0.y;
	r0.y = r0.y * -2 + 3;
	r0.y = r0.y * r0.w;
	r0.y = r0.y * SunCentre.z;
	r0.x = r0.x * 4 + r0.y;
	r1.xyz = r0.xxx * SunColor.xyz;
	r1.xyz = abs(r1.xyz) + 1E-05;
	r4.x = log2(r1.x);
	r4.y = log2(r1.y);
	r4.z = log2(r1.z);
	r1.xyz = r4.xyz * 4.00001;
	r4.x = exp2(r1.x);
	r4.y = exp2(r1.y);
	r4.z = exp2(r1.z);
	r1.xyz = r0.xxx * SunColor.xyz + r4.xyz;
	r0.x = saturate(-r0.x + 1);
	r0.x = r0.x * HDRSunExposure.x;
	r0.xyw = saturate(r0.xxx * i.texcoord5.xyz);
	r0.xyw = r1.xyz * HDRSunExposure.xxx + r0.xyw;
	r1.x = dot(MoonXVector.xyz, r3.xyz);
	r1.y = dot(MoonYVector.xyz, r3.xyz);
	r1.zw = -r1.xy + 1;
	r1.zw = (r1.zw >= 0) ? 0 : 1;
	r2.zw = (r1.xy >= 0) ? 0 : 1;
	r1.zw = r1.zw + r2.zw;
	r1.zw = (-r1.zw >= 0) ? 0 : 1;
	r1.z = saturate(r1.w + r1.z);
	r1.z = -r1.z + 1;
	r2.zw = r1.xy * MoonLight.xy + MoonLight.zw;
	r3 = r1.xyxy + -0.5;
	r3 = r3 * 0.9 + float4(0.5, 0.5, 0.49, 0.49);
	r4 = tex2D(MoonSampler, r2.zw);
	r1 = r1.z * r4;
	r4.xyz = r1.www * MoonColorConstant.xyz;
	r2.zw = r3.xy * MoonLight.xy + MoonLight.zw;
	r6 = tex2D(MoonGlowSampler, r2.zw);
	r5.xzw = r2.yyy + MoonColorConstant.xyz;
	r5.xzw = r5.xzw * r6.xxx;
	r5.xzw = r5.xzw * MoonGlow.xxx;
	r1.xyz = r1.xyz * r4.xyz + r5.xzw;
	r2.z = dot(r0.xyw, float3(0.3, 0.7, 0.17));
	r2.z = saturate(r2.z * -MoonVisiblity.x + r2.y);
	r2.z = r2.z * r2.z;
	r4 = tex2D(PerlinNoiseSampler, i.texcoord4.xy);
	r6 = tex2D(HighDetailNoiseSampler, i.texcoord2.zw);
	r2.w = r6.x + -0.5;
	r4.x = r2.w * CloudThicknessEdgeSmoothDetailScaleStrength.w;
	r4.x = r4.x * TopCloudBiasDetailThresholdHeight.y + r4.y;
	r4.x = saturate(TopCloudBiasDetailThresholdHeight.z * r4.x + -TopCloudBiasDetailThresholdHeight.x);
	r4.x = r4.x * i.texcoord4.z;
	r6 = tex2D(PerlinNoiseSampler, i.texcoord.xy);
	r4.y = r2.w * CloudThicknessEdgeSmoothDetailScaleStrength.w + r6.x;
	r2.w = saturate(r2.w * 0.2 + r6.z);
	r6.x = CloudThreshold.x;
	r4.y = saturate(r6.x * r4.y + -CloudBias.x);
	r4.z = r4.y + 1E-05;
	r4.y = saturate(r4.y * CloudThicknessEdgeSmoothDetailScaleStrength.y);
	r2.x = r2.x + CloudThicknessEdgeSmoothDetailScaleStrength.x;
	r6.y = pow(r4.z, r2.x);
	r2.x = r6.y * -r4.y + 1;
	r4.y = r4.y * r6.y;
	r4.x = r2.x * r4.x;
	r4.z = r2.x * r4.x + r4.y;
	r6.yz = -r4.zz + float2(1, 1.4);
	r0.z = r0.z * r4.z;
	r2.z = r2.z * r6.y;
	r1.xyz = r1.xyz * r2.zzz + r0.xyw;
	r5.xzw = r2.zzz * r5.xzw;
	r5.xzw = r5.xzw * r6.zzz + 1;
	r3.xy = -r3.xy + 0.99;
	r3 = (r3 >= 0) ? 0 : 1;
	r3.xy = r3.xy + r3.zw;
	r3.xy = (-r3.xy >= 0) ? 0 : 1;
	r2.z = r3.y + r3.x;
	r0.xyw = (-r2.zzz >= 0) ? r1.xyz : r0.xyw;
	r3.w = 64;
	r1.x = saturate(r3.w * MoonColorConstant.w);
	r1.x = r1.w * -r1.x + 1;
	r3 = tex2D(StarFieldSampler, i.texcoord3.xy);
	r1.yzw = r3.xyz * StarFieldBrightness.xxx + -StarFieldBrightness.zzz;
	r3 = tex2D(GalaxySampler, i.texcoord3.zw);
	r6.yzw = r3.xyz * StarFieldBrightness.yyy;
	r3.w = dot(r6.yzw, 1.2);
	r1.yzw = r1.yzw * r3.www + r1.yzw;
	r1.yzw = saturate(r3.xyz * StarFieldBrightness.yyy + r1.yzw);
	r3.xyz = r1.xxx * r1.yzw;
	r1.xyz = (-r2.zzz >= 0) ? r3.xyz : r1.yzw;
	r0.xyw = r0.xyw + r1.xyz;
	r1.xy = CloudThicknessEdgeSmoothDetailScaleStrength.zz * i.texcoord2.xy;
	r1 = tex2D(HighDetailNoiseSampler, r1.xy);
	r1.x = r1.x * CloudThicknessEdgeSmoothDetailScaleStrength.w;
	r3 = tex2D(PerlinNoiseSampler, i.texcoord2.xy);
	r1.x = r1.x * 0.2 + r3.x;
	r1.x = r6.x * r1.x + -CloudBias.x;
	r1.x = saturate(r1.x * CloudShadowStrength.x);
	r1.y = -r1.x + 1;
	r1.y = r4.y * r1.y;
	r1.y = r1.y * r2.w + r2.w;
	r1.z = r5.y * 0.25 + 0.35;
	r1.w = r5.y * r5.y;
	r1.y = r1.z * r1.y;
	r1.z = r1.x * -0.5 + r2.x;
	r2.x = max(r1.z, 0);
	r1.z = r1.w * r2.x;
	r1.z = r1.z * CloudInscatteringRange.x + r2.y;
	r1.xzw = saturate(r1.zzz * CloudColor.xyz + -r1.xxx);
	r1.xyz = SunsetColor.xyz * r1.yyy + r1.xzw;
	r2.xyw = lerp(r1.xyz, TopCloudColor.xyz, r4.xxx);
	r1.xyz = r5.xzw * r2.xyw;
	r1.xyz = (-r2.zzz >= 0) ? r1.xyz : r2.xyw;
	r2.xyz = half3(lerp(r0.xyw, r1.xyz, r0.zzz));
	r0.xyz = r2.xyz * HDRExposure.xxx;
	r1.xyz = min(r0.xyz, HDRExposureClamp.xyz);
	r0.xyz = min(HDRExposureClamp.xyz, r1.xyz);
	r1.xyz = r0.xyz + -1;
	r2.xyz = abs(r0.xyz) + 1E-05;
	r3.x = log2(r2.x);
	r3.y = log2(r2.y);
	r3.z = log2(r2.z);
	r2.xyz = r3.xyz * 0.25001;
	r3.x = exp2(r2.x);
	r3.y = exp2(r2.y);
	r3.z = exp2(r2.z);
	r0.xyz = (r1.xyz >= 0) ? r0.xyz : r3.xyz;
	r1.xyz = -r0.xyz + gtaWaterColor.xyz;
	r0.w = gtaSkyDomeFade.x + -i.texcoord1.y;
	r0.w = saturate(r0.w * gtaSkyDomeFade.y);
	o.xyz = r0.www * r1.xyz + r0.xyz;
	o.w = 1;

	return o;
}
