sampler2D BloodSampler : register(s3);
sampler2D BumpSampler : register(s5);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s1);
sampler2D SpecSampler : register(s6);
sampler3D VolumeSampler : register(s7);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c207);
float fresnelRolloff : register(c199);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gBloodData : register(c206);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float reflectivePower : register(c197);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c198);
float specularFactor : register(c202);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.z, 0);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r2, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r2.w = saturate(dot(r2.xyz, specMapIntMask.xyz));
	r3.x = max(1, r0.w);
	r3.yzw = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r3.yzw;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r3.yzw = r0.www * r0.xyz;
	r4.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r4.xyz);
	r4.x = dot(-r5.xyz, r3.yzw);
	r4.x = r4.x + r4.x;
	r4.xyz = r3.yzw * -r4.xxx + -r5.xyz;
	r4.xyz = r4.xyz + 1E-05;
	r6.xyz = normalize(r4.xyz);
	r4.x = saturate(r6.z);
	r4.x = r4.x + 1;
	r4.x = r4.x + r4.x;
	r4.x = 1 / r4.x;
	r4.xy = r6.xy * r4.xx + 0.5;
	r4.xy = -r4.xy + 1;
	r4.zw = 0;
	r4 = tex2Dlod(EnvironmentSampler, r4);
	r4.xyz = r4.xyz * r4.xyz;
	r4.xyz = r4.xyz * 16;
	r3.y = saturate(dot(r5.xyz, r3.yzw));
	r5.xw = float2(1, 0);
	r3.z = r5.x + -fresnelRolloff.x;
	r3.y = -r3.y + 1.00001;
	r4.w = pow(r3.y, 5.00001);
	r3.y = fresnelRolloff.x * r4.w + r3.z;
	r3.yzw = r3.yyy * r4.xyz;
	r4 = tex2D(EnvironmentSampler, i.texcoord.xy);
	r3.yzw = r3.yzw * r4.www;
	r3.yzw = r3.yzw * reflectivePower.xxx;
	r2.x = dot(r2.xyz, specMapReflectMask.xyz);
	r3.yzw = r2.xxx * r3.yzw;
	r3.yzw = r3.yzw * ColorCorrectTopAndPedReflectScale.www;
	if (-gBloodData.w < r5.w) {
		r4 = tex2D(BloodSampler, i.texcoord.zw);
		r6.z = min(r4.y, r4.x);
		r2.x = saturate(r4.x * 0.5 + r4.w);
		r6.xy = r4.xy;
		r2.y = -r1.x + r6.x;
		r2.y = r2.y * r2.x;
		r4.xyz = lerp(r1.xyz, r6.xyz, r2.xxx);
		r2.x = dot(r4.xyz, float3(0.2125, 0.7154, 0.0721));
		r5.yzw = lerp(r2.xxx, r4.xyz, gAdrenoFXVars.yyy);
		r2.x = saturate(r2.y * gAmbientOcclusionEffect.z);
		r1.xyz = lerp(r4.xyz, r5.yzw, r2.xxx);
	}
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r4.xyz = r0.www * r0.xyz;
	r1.w = r1.w * i.texcoord2.w;
	r1.xyz = r1.xyz * matMaterialColorScale.xxx;
	r3.yzw = r3.yzw * matMaterialColorScale.zzz;
	r2.x = r2.w * matMaterialColorScale.w;
	r2.y = r3.x * matMaterialColorScale.w;
	r5.yzw = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r5.yzw = r5.yzw + 1E-05;
	r6.xyz = normalize(r5.yzw);
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r7 = normalize(r0.xyz);
	r0.x = dot(r6.xyz, r7.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.z = saturate(r2.x * 5);
	r0.y = r0.z * r0.y;
	r2.x = r2.y * 0.015625;
	r0.z = saturate(r2.y * -0.01 + 1);
	r0.y = r0.y * r0.z;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r2.w * matMaterialColorScale.w + r0.x;
	r0.y = r2.z * 16;
	r0.z = frac(r0.y);
	r0.y = r0.y + -r0.z;
	r0.z = (-r0.z >= 0) ? 0 : 1;
	r0.z = (r2.z >= 0) ? 0 : r0.z;
	r0.y = r0.z + r0.y;
	r6.xy = detailSettings.zw * i.texcoord.xy;
	r0.y = r0.y + 0.5;
	r6.z = r0.y * 0.0625;
	r6 = tex3D(VolumeSampler, r6.xyz);
	r0.yzw = r6.yzx * 2 + -1;
	r2.y = detailSettings.x * i.texcoord2.w;
	r0.w = r0.w * r2.y + 1;
	r2.yzw = r0.www * r1.xyz;
	r5.yzw = r0.zzz * i.texcoord5.xyz;
	r5.yzw = i.texcoord4.xyz * r0.yyy + r5.yzw;
	r5.yzw = r5.yzw * detailSettings.yyy;
	r4.xyz = r5.yzw * i.texcoord2.www + r4.xyz;
	r4.xyz = r4.xyz + 1E-05;
	r6.xyz = normalize(r4.xyz);
	o.color2.x = saturate(r0.w * r0.x);
	r0.x = dot(r2.yzw, float3(0.2125, 0.7154, 0.0721));
	r4.w = 0.1;
	r0.y = saturate(r4.w + deSatContrastGamma.x);
	r0.y = 1 / r0.y;
	r0.y = r0.y * gAdrenoFXVars.z;
	r1.xyz = r1.xyz * r0.www + -r0.xxx;
	r0.xyz = r0.yyy * r1.xyz + r0.xxx;
	r1.xyz = saturate(r5.xxx + -ColorCorrectTopAndPedReflectScale.xyz);
	r1.xyz = r1.xyz * 0.25 + 1;
	r0.w = saturate(gAmbientOcclusionEffect.z);
	r0.xyz = r0.xyz * r1.xyz + -r2.yzw;
	o.color.xyz = r0.www * r0.xyz + r2.yzw;
	o.color2.z = saturate(r0.w + i.texcoord2.x);
	o.color1.xyz = r6.xyz * 0.5 + 0.5;
	r2.x = saturate(r2.x);
	r0.x = rsqrt(r2.x);
	o.color2.y = 1 / r0.x;
	r0.x = r1.w * globalScalars.x;
	r0.yzw = saturate(r3.yzw * 0.0625);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	r0.w = rsqrt(r0.w);
	o.color3.x = 1 / r0.y;
	o.color3.y = 1 / r0.z;
	o.color3.z = 1 / r0.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3.w = gStencil.x;

	return o;
}
