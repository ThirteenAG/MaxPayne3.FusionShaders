sampler2D BumpSampler : register(s5);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s1);
sampler2D SpecSampler : register(s6);
sampler3D VolumeSampler : register(s7);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c207);
float fresnelRolloff : register(c199);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float reflectivePower : register(c197);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c198);
float specularFactor : register(c202);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r1.x = max(r0.z, 0);
	r0.z = rsqrt(r1.x);
	r0.z = 1 / r0.z;
	r1.xyz = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r1.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r1.xyz = r0.xyz * r0.www + 1E-05;
	r0.xyz = r0.www * r0.xyz;
	r2.xyz = normalize(r1.xyz);
	r1.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r3.xyz = normalize(r1.xyz);
	r0.w = dot(r3.xyz, r2.xyz);
	r1.x = r0.w * 1.5 + 1;
	r0.w = (-r0.w >= 0) ? r1.x : 1;
	r1.x = r0.w * i.texcoord2.y;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r1.y = saturate(dot(r2.xyz, specMapIntMask.xyz));
	r1.z = r1.y * matMaterialColorScale.w;
	r1.z = saturate(r1.z * 5);
	r1.x = r1.z * r1.x;
	r1.z = dot(r2, specMapExpMask);
	r1.z = r1.z * specularFactor.x;
	r2.w = max(1, r1.z);
	r1.z = r2.w * matMaterialColorScale.w;
	r1.w = saturate(r1.z * -0.01 + 1);
	r3.x = r1.z * 0.015625;
	r3.x = saturate(r3.x);
	r1.z = rsqrt(r3.x);
	o.color2.y = 1 / r1.z;
	r1.x = r1.x * r1.w;
	r0.w = (r0.w >= 0) ? r1.x : 0;
	r0.w = r1.y * matMaterialColorScale.w + r0.w;
	r1.x = r2.z * 16;
	r1.y = frac(r1.x);
	r1.x = r1.x + -r1.y;
	r1.y = (-r1.y >= 0) ? 0 : 1;
	r1.y = (r2.z >= 0) ? 0 : r1.y;
	r1.z = dot(r2.xyz, specMapReflectMask.xyz);
	r1.x = r1.y + r1.x;
	r1.x = r1.x + 0.5;
	r2.z = r1.x * 0.0625;
	r2.xy = detailSettings.zw * i.texcoord.xy;
	r2 = tex3D(VolumeSampler, r2.xyz);
	r1.xyw = r2.yzx * 2 + -1;
	r2.x = detailSettings.x * i.texcoord2.w;
	r1.w = r1.w * r2.x + 1;
	o.color2.x = saturate(r0.w * r1.w);
	r0.w = 0.1;
	r0.w = saturate(r0.w + deSatContrastGamma.x);
	r0.w = 1 / r0.w;
	r0.w = r0.w * gAdrenoFXVars.z;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2.xyz = r2.xyz * matMaterialColorScale.xxx;
	r2.w = r2.w * i.texcoord2.w;
	r2.w = r2.w * globalScalars.x;
	r3.xyz = r1.www * r2.xyz;
	r3.w = dot(r3.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.xyz = r2.xyz * r1.www + -r3.www;
	r2.xyz = r0.www * r2.xyz + r3.www;
	r4.x = 1;
	r4.yzw = saturate(r4.xxx + -ColorCorrectTopAndPedReflectScale.xyz);
	r4.yzw = r4.yzw * 0.25 + 1;
	r2.xyz = r2.xyz * r4.yzw + -r3.xyz;
	r0.w = saturate(gAmbientOcclusionEffect.z);
	o.color.xyz = r0.www * r2.xyz + r3.xyz;
	o.color2.z = saturate(r0.w + i.texcoord2.x);
	r2.xyz = r1.yyy * i.texcoord5.xyz;
	r1.xyw = i.texcoord4.xyz * r1.xxx + r2.xyz;
	r1.xyw = r1.xyw * detailSettings.yyy;
	r1.xyw = r1.xyw * i.texcoord2.www + r0.xyz;
	r1.xyw = r1.xyw + 1E-05;
	r2.xyz = normalize(r1.xyw);
	o.color1.xyz = r2.xyz * 0.5 + 0.5;
	r1.xyw = 1E-05 + i.texcoord3.xyz;
	r2.xyz = normalize(r1.xyw);
	r0.w = dot(-r2.xyz, r0.xyz);
	r0.w = r0.w + r0.w;
	r1.xyw = r0.xyz * -r0.www + -r2.xyz;
	r0.x = saturate(dot(r2.xyz, r0.xyz));
	r0.x = -r0.x + 1.00001;
	r2.x = pow(r0.x, 5.00001);
	r0.xyz = r1.xyw + 1E-05;
	r3.xyz = normalize(r0.xyz);
	r0.x = saturate(r3.z);
	r0.x = r0.x + 1;
	r0.x = r0.x + r0.x;
	r0.x = 1 / r0.x;
	r0.xy = r3.xy * r0.xx + 0.5;
	r0.xy = -r0.xy + 1;
	r0.zw = 0;
	r0 = tex2Dlod(EnvironmentSampler, r0);
	r0.xyz = r0.xyz * r0.xyz;
	r0.xyz = r0.xyz * 16;
	r0.w = r4.x + -fresnelRolloff.x;
	r0.w = fresnelRolloff.x * r2.x + r0.w;
	r0.xyz = r0.www * r0.xyz;
	r3 = tex2D(EnvironmentSampler, i.texcoord.xy);
	r0.xyz = r0.xyz * r3.www;
	r0.xyz = r0.xyz * reflectivePower.xxx;
	r0.xyz = r1.zzz * r0.xyz;
	r0.xyz = r0.xyz * ColorCorrectTopAndPedReflectScale.www;
	r0.xyz = r0.xyz * matMaterialColorScale.zzz;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.color3.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.color3.z = 1 / r0.y;
	o.color3.y = 1 / r0.x;
	o.color.w = r2.w;
	o.color1.w = r2.w;
	o.color2.w = r2.w;
	o.color3.w = gStencil.x;

	return o;
}
