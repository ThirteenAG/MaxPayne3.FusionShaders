	r3.w = r3.w * specularFactor.x;
	r4.w = max(1, r3.w);
	r3.w = r4.w + 1E-05;
	r4.w = r4.w * 0.25 + 1E-05;
	r5.w = pow(r0.w, r3.w);
	r0.w = r1.w * r5.w;
	r1.xyz = r0.www * r1.xyz;
	r6 = gLightPosX + -i.texcoord2.x;
	r7 = r6 * r6;
	r8 = gLightPosY + -i.texcoord2.y;
	r7 = r8 * r8 + r7;
	r9 = gLightPosZ + -i.texcoord2.z;
	r7 = r9 * r9 + r7;
	r10 = r7 + 1E-05;
	r11 = 1;
	r7 = saturate(r7 * -gLightFallOff + r11.x);
	r7 = r7 * r7;
	r7 = r7 * r7 + -0.1;
	r12.x = rsqrt(r10.x);
	r12.y = rsqrt(r10.y);
	r12.z = rsqrt(r10.z);
	r12.w = rsqrt(r10.w);
	r6 = r6 * r12;
	r10 = r3.x * r6;
	r8 = r8 * r12;
	r9 = r9 * r12;
	r10 = r8 * r3.y + r10;
	r10 = r9 * r3.z + r10;
	r0.w = saturate(r3.z * -0.5 + 0.5);
	r3 = r7 * 1.1111112;
	r3 = (r7 >= 0) ? r3 : 0;
	r3 = saturate(r3 * r10);
	r7 = r6 * -gLightDirX;
	r6 = r4.x * r6;
	r6 = r4.y * r8 + r6;
	r7 = r8 * -gLightDirY + r7;
	r7 = r9 * -gLightDirZ + r7;
	r6 = saturate(r4.z * r9 + r6);
	r4.xyz = r4.xyz + 1E-05;
	r8.xyz = normalize(r4.xyz);
	r6 = r6 + 1E-05;
	r9 = gLightConeScale;
	r7 = saturate(r7 * r9 + gLightConeOffset);
	r3 = r3 * r7;
	r7.x = log2(r6.x);
	r7.y = log2(r6.y);
	r7.z = log2(r6.z);
	r7.w = log2(r6.w);
	r4 = r4.w * r7;
	r6.x = exp2(r4.x);
	r6.y = exp2(r4.y);
	r6.z = exp2(r4.z);
	r6.w = exp2(r4.w);
	r4 = r3 * r6;
	r6.x = dot(gLightColR, r4);
	r6.y = dot(gLightColG, r4);
	r6.z = dot(gLightColB, r4);
	r1.xyz = r1.xyz * gDirectionalLight.www + r6.xyz;
	r1.w = saturate(r8.z);
	r1.w = r1.w + 1;
	r1.w = r1.w + r1.w;
	r1.w = 1 / r1.w;
	r4.xy = r8.xy * r1.ww + 0.5;
	r4.xy = -r4.xy + 1;
	r4.zw = 0;
	r4 = tex2Dlod(EnvironmentSampler, r4);
	r4.xyz = r4.xyz * r4.xyz;
	r4.xyz = r4.xyz * 16;
	r1.w = r11.x + -fresnelRolloff.x;
	r1.w = fresnelRolloff.x * r2.w + r1.w;
	r4.xyz = r1.www * r4.xyz;
	r6 = tex2D(EnvironmentSampler, i.texcoord.xy);
	r4.xyz = r4.xyz * r6.www;
	r4.xyz = r4.xyz * reflectivePower.xxx;
	r1.w = dot(r5.xyz, specMapReflectMask.xyz);
	r2.w = saturate(dot(r5.xyz, specMapIntMask.xyz));
	r4.xyz = r1.www * r4.xyz;
	r4.xyz = r4.xyz * ColorCorrectTopAndPedReflectScale.www;
	r5.xyz = gLightAmbient0.xyz;
	r5.xyz = -r5.xyz + gLightAmbient1.xyz;
	r5.xyz = r0.www * r5.xyz + gLightAmbient0.xyz;
	r6.yz = float2(0.15, 1);
	r0.w = saturate(AmbientLightingParams.x * -r6.y + r6.z);
	r0.w = saturate(r0.w + 0.2);
	r0.w = r0.w * AmbientLightingParams.y;
	r0.w = i.texcoord7.x * r0.w + -i.texcoord7.x;
	r0.w = gAmbientOcclusionEffect.x * r0.w + i.texcoord7.x;
	r5.xyz = r0.www * r5.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r2.xyz = r5.xyz * r0.www + r2.xyz;
	r5.x = dot(gLightColR, r3);
	r5.y = dot(gLightColG, r3);
	r5.z = dot(gLightColB, r3);
	r2.xyz = r2.xyz + r5.xyz;
	r0.w = dot(r2.xyz, 0.33333334);
	r3.xyz = r0.www * r4.xyz;
	r1.xyz = r1.xyz * r2.www + r3.xyz;
	r0.xyz = r0.xyz * r2.xyz + r1.xyz;
	r0.xyz = r0.xyz * matMaterialColorScale.xxx;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;

	return o;
}
