	r0.w = dot(r3.xyz, -gDirectionalLight.xyz);
	r1.w = saturate(r0.w * 2 + -0.5);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r2.xyz = r0.www * r1.xyz;
	r4.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r4.xyz);
	r0.w = dot(-r5.xyz, r3.xyz);
	r0.w = r0.w + r0.w;
	r4.xyz = r3.xyz * -r0.www + -r5.xyz;
	r0.w = saturate(dot(r5.xyz, r3.xyz));
	r0.w = -r0.w + 1.00001;
	r2.w = pow(r0.w, 5.00001);
	r0.w = saturate(dot(-gDirectionalLight.xyz, r4.xyz));
	r0.w = r0.w + 1E-05;
	r5 = tex2D(SpecSampler, i.texcoord.xy);
