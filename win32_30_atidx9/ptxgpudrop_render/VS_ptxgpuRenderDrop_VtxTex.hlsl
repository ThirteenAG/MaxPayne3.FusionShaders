sampler2D PositionTexSampler : register(s2);
sampler2D VelocityTexSampler : register(s3);
float gAmbientAmount : register(c101);
float4 gAmbientOcclusionEffect : register(c63);
float4 gColour : register(c105);
float4 gColourSplash : register(c106);
float gDiffuse : register(c100);
float gDirectional : register(c110);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float2 gLifeFade : register(c93);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float4 gSizeMinMax : register(c103);
float2 gSplashFrames : register(c107);
float2 gSplashSizeMinMax : register(c104);
float2 gTextureRowsCols : register(c102);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float gWrapBias : register(c99);
float gWrapScale : register(c98);

struct VS_IN
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float3 r10;
	float3 r11;
	float4 r12;
	r0 = tex2Dlod(PositionTexSampler, i.position);
	r1 = tex2Dlod(VelocityTexSampler, i.position);
	r2.x = (r1.w >= 10000) ? 1 : 0;
	r1.w = frac(r1.w);
	r2.y = r1.w * 1000;
	r2.y = frac(r2.y);
	if (0 >= r2.x) {
		r3.xy = lerp(gSizeMinMax.xy, gSizeMinMax.zw, r2.yy);
		r2.z = frac(r0.w);
		r2.w = r0.w + -r2.z;
		r2.w = r2.w * 0.01;
		r2.z = r2.z * 100;
		r3.zw = -0.5 + i.texcoord.xy;
		r4.z = 0;
		if (r4.z < gDirectional.x) {
			r4.xyz = -r0.yzx + gViewInverse[3].yzx;
			r5.xyz = normalize(r1.xyz);
			r1.x = dot(r4.xyz, r4.xyz);
			r1.x = rsqrt(r1.x);
			r1.xyz = r1.xxx * r4.xyz;
			r4.xyz = r1.xyz * r5.zxy;
			r1.xyz = r5.yzx * r1.yzx + -r4.xyz;
			r4.xyz = normalize(r1.xyz);
			r1.xyz = r3.yyy * r5.xyz;
			r4.xyz = r3.xxx * r4.xyz;
			r4.w = 0.7 + -i.texcoord.y;
			r1.xyz = -r1.xyz * r4.www;
			r1.xyz = r3.zzz * r4.xyz + r1.xyz;
		} else {
			r4.xyz = normalize(-gViewInverse[1].xyz);
			r5.xyz = normalize(gViewInverse[0].xyz);
			r4.xyz = r3.yyy * r4.xyz;
			r5.xyz = r3.xxx * r5.xyz;
			r3.xyw = r3.www * r4.xyz;
			r1.xyz = r3.zzz * r5.xyz + r3.xyw;
		}
		r3.xyz = normalize(r1.xyz);
		r1.xyz = r0.xyz + r1.xyz;
		r4 = r1.y * gWorldViewProj[1];
		r4 = r1.x * gWorldViewProj[0] + r4;
		r4 = r1.z * gWorldViewProj[2] + r4;
		o.position = r4 + gWorldViewProj[3];
		r3.w = 0.1;
		r3.w = r3.w + gColour.w;
		r4.x = gTextureRowsCols.y * gTextureRowsCols.x;
		r1.w = r1.w * r4.x;
		r1.w = r1.w * 99.9;
		r4.x = frac(r1.w);
		r1.w = r1.w + -r4.x;
		r4.x = 1 / gTextureRowsCols.y;
		r1.w = r1.w * r4.x;
		r4.z = frac(abs(r1.w));
		r4.w = (r1.w >= -r1.w) ? 1 : 0;
		r5.x = lerp(-r4.z, r4.z, r4.w);
		r5.x = r5.x * gTextureRowsCols.y;
		r4.z = frac(r1.w);
		r5.y = r1.w + -r4.z;
		r4.y = 1 / gTextureRowsCols.x;
		r4.zw = r5.xy + i.texcoord.xy;
		o.texcoord = r4.xy * r4.zw;
		r4.xyz = gColour.xyz;
	} else {
		r1.w = lerp(gSplashSizeMinMax.x, gSplashSizeMinMax.y, r2.y);
		r2.y = frac(r0.w);
		r0.w = r0.w + -r2.y;
		r2.w = r0.w * 0.01;
		r2.z = r2.y * 100;
		r5.xy = -0.5 + i.texcoord.xy;
		r6.xyz = normalize(-gViewInverse[1].xyz);
		r7.xyz = normalize(gViewInverse[0].xyz);
		r6.xyz = r1.www * r6.xyz;
		r7.xyz = r1.www * r7.xyz;
		r5.yzw = r5.yyy * r6.xyz;
		r5.xyz = r5.xxx * r7.xyz + r5.yzw;
		r3.xyz = normalize(r5.xyz);
		r1.xyz = r0.xyz + r5.xyz;
		r5 = r1.y * gWorldViewProj[1];
		r5 = r1.x * gWorldViewProj[0] + r5;
		r5 = r1.z * gWorldViewProj[2] + r5;
		o.position = r5 + gWorldViewProj[3];
		r0.w = 1 / r2.z;
		r0.w = r0.w * r2.w;
		r0.w = r0.w * gSplashFrames.x;
		r1.w = frac(r0.w);
		r0.w = r0.w + -r1.w;
		r1.w = gSplashFrames.y * i.texcoord.x;
		r0.w = r0.w * gSplashFrames.y + r1.w;
		o.texcoord.x = r0.w + -10;
		r0.w = 0.1;
		r3.w = r0.w + gColourSplash.w;
		r4.xyz = gColourSplash.xyz;
		o.texcoord.y = i.texcoord.y;
	}
	r5 = -r1.x + gLightPosX;
	r6 = -r1.y + gLightPosY;
	r1 = -r1.z + gLightPosZ;
	r7 = r5 * r5;
	r7 = r6 * r6 + r7;
	r7 = r1 * r1 + r7;
	r8 = r7 + 1E-05;
	r9.x = rsqrt(r8.x);
	r9.y = rsqrt(r8.y);
	r9.z = rsqrt(r8.z);
	r9.w = rsqrt(r8.w);
	r0.w = 1;
	r7 = r7 * -gLightFallOff + r0.w;
	r7 = max(r7, 0);
	r7 = r7 * r7;
	r7 = r7 * r7 + -0.1;
	r7 = max(r7, 0);
	r7 = r7 * 1.1111112;
	r7 = min(r7, 1);
	r8.x = r5.x;
	r8.y = r6.x;
	r8.z = r1.x;
	r8.xyz = r8.xyz + 1E-05;
	r10 = normalize(r8.xyz);
	r8.x = r5.y;
	r8.y = r6.y;
	r8.z = r1.y;
	r8.xyz = r8.xyz + 1E-05;
	r11 = normalize(r8.xyz);
	r1.x = r5.z;
	r1.y = r6.z;
	r5.xyz = r1.xyz + 1E-05;
	r8.xyz = normalize(r5.xyz);
	r1.x = r5.w;
	r1.y = r6.w;
	r1.xyz = r1.xyw + 1E-05;
	r5.xyz = normalize(r1.xyz);
	r1.x = r10.x;
	r1.y = r11.x;
	r1.z = r8.x;
	r1.w = r5.x;
	r6 = r1 * -gLightDirX;
	r12.x = r10.y;
	r12.y = r11.y;
	r12.z = r8.y;
	r12.w = r5.y;
	r6 = r12 * -gLightDirY + r6;
	r8.x = r10.z;
	r8.y = r11.z;
	r8.w = r5.z;
	r5 = r8 * -gLightDirZ + r6;
	r6 = gLightConeScale;
	r5 = saturate(r5 * r6 + gLightConeOffset);
	r5 = r7 * r5;
	r5 = r9 * r5;
	r1 = r1 * r5;
	r6 = r5 * r12;
	r7 = r5 * r8;
	r0.w = r5.x * gWrapBias.x;
	r2.y = dot(r3.xyz, -gDirectionalLight.xyz);
	r0.w = saturate(r2.y * gWrapScale.x + r0.w);
	r5.yzw = r0.www * gDirectionalColour.xyz;
	r1 = r1 * r3.x;
	r1 = r3.y * r6 + r1;
	r1 = r3.z * r7 + r1;
	r1 = saturate(gWrapBias.x * r5.x + r1);
	r6.x = dot(gLightColR, r1);
	r6.y = dot(gLightColG, r1);
	r6.z = dot(gLightColB, r1);
	r1.xyz = r5.yzw * gDirectionalColour.www + r6.xyz;
	r0.w = dot(r3.xyz, gWorldView[2].xyz);
	r0.w = saturate(r0.w * -0.5 + 0.5);
	r3.xyz = gLightAmbient0.xyz;
	r3.xyz = -r3.xyz + gLightAmbient1.xyz;
	r3.xyz = r0.www * r3.xyz + gLightAmbient0.xyz;
	r3.xyz = r3.xyz * gAmbientAmount.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r3.xyz * r0.www + r1.xyz;
	r1.xyz = r1.xyz * gDiffuse.xxx;
	o.color.xyz = r1.xyz * r4.xyz;
	r0.xyz = -r0.xyz + gViewInverse[3].xyz;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * 0.6666667;
	r0.y = r0.x * r0.x;
	r0.x = r0.x * r0.y;
	r0.x = min(r0.x, 1);
	r0.y = r0.x * r3.w;
	r0.z = -r2.w + r2.z;
	r0.w = 1 / gLifeFade.x;
	r0.z = saturate(r0.w * r0.z);
	r0.w = 1 / gLifeFade.y;
	r0.w = saturate(r0.w * r2.w);
	r0.z = r0.w * r0.z;
	r0.y = r0.z * r0.y;
	r0.x = r3.w * r0.x + -r0.y;
	o.color.w = r2.x * r0.x + r0.y;

	return o;
}
