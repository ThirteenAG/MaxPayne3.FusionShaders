sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s3);
sampler2D SpecSampler : register(s2);
float bumpiness : register(c203);
float4 colorize : register(c47);
float fresnelRolloff : register(c205);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float reflectivePower : register(c204);
float4 specMapExpMask : register(c202);
float3 specMapIntMask : register(c201);
float3 specMapReflectMask : register(c206);
float specularFactor : register(c200);
float4 stipplePattern : register(c62);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float2 vpos : VPOS;
	float4 color : COLOR;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float3 r6;
	float4 r7;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1 = r0 * colorize;
	r0.w = r1.w * i.color.w;
	r1.w = r0.w * globalScalars.x;
	r2.xy = 0.5 * i.vpos.xy;
	r2.xy = frac(abs(r2.xy));
	r2.xy = (i.vpos.xy >= 0) ? r2.xy : -r2.xy;
	r2.xy = r2.xy + r2.xy;
	r2.zw = frac(r2.xy);
	r2.xy = -r2.zw + r2.xy;
	r2.x = r2.y * 2 + r2.x;
	r2 = r2.x + float4(-0, -1, -2, -3);
	r2 = (-abs(r2) >= 0) ? 1 : 0;
	r2.x = dot(stipplePattern, r2);
	r0.w = r0.w * -globalScalars.x + r2.x;
	r2 = (r0.w >= 0) ? -1 : -0;
	clip(r2);
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r2.w + 1;
	r0.w = -r2.x + r0.w;
	r2.xy = (r0.ww >= 0) ? r2.wy : r2.xy;
	r2.xy = r2.xy * 2 + -1;
	r2.xy = r2.xy * bumpiness.xx;
	r0.w = dot(r2.xy, -r2.xy) + 1;
	r2.z = max(r0.w, 0);
	r0.w = rsqrt(r2.z);
	r0.w = 1 / r0.w;
	r3 = tex2D(SpecSampler, i.texcoord.xy);
	r2.z = dot(r3, specMapExpMask);
	r2.w = r2.z * specularFactor.x;
	o.color2.x = dot(r3.xyz, specMapIntMask.xyz);
	r4.z = 1;
	r2.z = r2.z * -specularFactor.x + r4.z;
	r4.xyw = r2.xxx * i.texcoord4.xyz;
	r4.xyw = r0.www * i.texcoord1.xyz + r4.xyw;
	r4.xyw = r2.yyy * i.texcoord5.xyz + r4.xyw;
	r4.xyw = r4.xyw + 1E-05;
	r5 = normalize(r4.xyw);
	r4.xyw = 1E-05 + i.texcoord3.xyz;
	r6 = normalize(r4.xyw);
	r0.w = dot(-r6.xyz, r5.xyz);
	r0.w = r0.w + r0.w;
	r4.xyw = r5.xyz * -r0.www + -r6.xyz;
	r4.xyw = r4.xyw + 1E-05;
	r0.w = dot(r4.xyw, r4.xyw);
	r0.w = rsqrt(r0.w);
	r2.xy = r4.xw * r0.ww + 1;
	r2.xy = r2.xy * -0.5;
	r7 = tex2D(EnvironmentSampler, r2.xy);
	r0.w = saturate(dot(r6.xyz, r5.xyz));
	r2.x = r4.z + -fresnelRolloff.x;
	r0.w = -r0.w + 1.00001;
	r2.y = pow(r0.w, 5.00001);
	r0.w = fresnelRolloff.x * r2.y + r2.x;
	r4.xyw = r0.www * r7.xyz;
	r4.xyw = r4.xyw * reflectivePower.xxx;
	r0.w = dot(r3.xyz, specMapReflectMask.xyz);
	r3.xyz = r0.www * r4.xyw;
	r3.xyz = r3.xyz * globalScalars.www;
	r0.w = dot(r1.xyz, float3(0.2125, 0.7154, 0.0721));
	r4.xyw = r0.xyz * colorize.xyz + -r0.www;
	r4.xyw = gAdrenoFXVars.xxx * r4.xyw + r0.www;
	r0.w = saturate(gAmbientOcclusionEffect.z + gAmbientOcclusionEffect.z);
	r0.xyz = r0.xyz * -colorize.xyz + r4.xyw;
	r0.xyz = r0.www * r0.xyz + r1.xyz;
	r0.w = saturate(-r4.z + globalScalars.z);
	o.color.xyz = r0.www * globalScalars2.zzz + r0.xyz;
	o.color1.xyz = r5.xyz * 0.5 + 0.5;
	r0.x = saturate(r2.w * 0.0051020407);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	o.color2.y = (r2.z >= 0) ? 0.071428575 : r0.x;
	r0.xyz = saturate(r3.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	o.color3.x = 1 / r0.x;
	o.color3.y = 1 / r0.y;
	o.color3.z = 1 / r0.z;
	o.color.w = r1.w;
	o.color1.w = r1.w;
	o.color2.z = globalScalars.z;
	o.color2.w = r1.w;
	o.color3.w = gStencil.x;

	return o;
}
