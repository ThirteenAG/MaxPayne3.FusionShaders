sampler2D BumpSampler : register(s4);
sampler2D DiffuseSampler : register(s0);
sampler2D DiffuseSampler2 : register(s2);
sampler2D DirtSampler : register(s3);
sampler2D EnvironmentSampler : register(s6);
sampler2D SpecSampler : register(s5);
float bumpiness : register(c209);
float3 dirtColor : register(c200);
float dirtLevel : register(c199);
float fresnelRolloff : register(c211);
float4 gAmbientOcclusionEffect : register(c63);
float4 gDirectionalLight : register(c19);
float4 gStencil : register(c61);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float3 matDiffuseColor : register(c197);
float4 matDiffuseColor2 : register(c198);
float reflectivePower : register(c210);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c212);
float3 specular2Color : register(c207);
float specular2ColorIntensity : register(c206);
float specular2Factor : register(c205);
float specularColorFactor : register(c202);
float specularFactor : register(c201);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = tex2D(DiffuseSampler2, i.texcoord.zw);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r3.x = max(r0.z, 0);
	r0.z = rsqrt(r3.x);
	r0.z = 1 / r0.z;
	r3 = tex2D(SpecSampler, i.texcoord.zw);
	r0.w = dot(r3, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r3.w = dot(r3.xyz, specMapIntMask.xyz);
	r3.w = r3.w * specularColorFactor.x;
	r4.x = max(1, r0.w);
	r4.yzw = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r4.yzw;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r5 = normalize(r0.xyz);
	r0.xyz = 1E-05 + i.texcoord3.xyz;
	r6.xyz = normalize(r0.xyz);
	r0.x = dot(-r6.xyz, r5.xyz);
	r0.x = r0.x + r0.x;
	r0.xyz = r5.xyz * -r0.xxx + -r6.xyz;
	r4.yzw = r0.xyz + 1E-05;
	r0.w = dot(r4.yzw, r4.yzw);
	r0.w = rsqrt(r0.w);
	r4.yz = r4.yw * r0.ww + 1;
	r4.yz = r4.yz * -0.5;
	r7 = tex2D(EnvironmentSampler, r4.yz);
	r0.w = saturate(dot(r6.xyz, r5.xyz));
	r6.xw = float2(1, 0);
	r4.y = r6.x + -fresnelRolloff.x;
	r0.w = -r0.w + 1.00001;
	r4.z = pow(r0.w, 5.00001);
	r0.w = fresnelRolloff.x * r4.z + r4.y;
	r4.yzw = r0.www * r7.xyz;
	r4.yzw = r4.yzw * reflectivePower.xxx;
	r0.w = dot(r3.xyz, specMapReflectMask.xyz);
	r3.xyz = r0.www * r4.yzw;
	r3.xyz = r3.xyz * globalFogColorN.www;
	r4.yzw = r1.xyz * matDiffuseColor.xyz;
	r0.w = r2.w * matDiffuseColor2.w;
	r2.xyz = r2.xyz * matDiffuseColor2.xyz + -r4.yzw;
	r1.xyz = r0.www * r2.xyz + r4.yzw;
	r1 = r1 * i.texcoord2;
	r0.w = dot(i.texcoord2.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.z = globalScalars.z;
	r2.x = r2.z * gAmbientOcclusionEffect.y;
	r2.y = r0.w * r2.x;
	if (-dirtLevel.x < r6.w) {
		r7 = tex2D(DirtSampler, i.texcoord.xy);
		r2.z = r7.x * dirtLevel.x;
		r6.x = r7.x * -dirtLevel.x + r6.x;
		r6.yzw = lerp(r1.xyz, dirtColor.xyz, r2.zzz);
		r8 = r1.xxyz * float4(0, 1, 1, 1) + float4(1, 0, 0, 0);
		r6 = (-r7.x >= 0) ? r8 : r6;
		r1.xyz = r6.yzw;
	} else {
		r6.x = 1;
	}
	r2.z = r3.w * r6.x;
	r2.w = 1 / specularFactor.x;
	r2.w = r2.w * r4.x;
	r4.y = 1 / specularColorFactor.x;
	r3.w = r3.w * r4.y;
	r4.y = specular2ColorIntensity.x * specular2ColorIntensity.x;
	r3.w = r3.w * r4.y;
	r4.yzw = r3.www * specular2Color.xyz;
	r3.w = dot(r5.xyz, -gDirectionalLight.xyz);
	r0.x = saturate(dot(-gDirectionalLight.xyz, r0.xyz));
	r0.x = r0.x + 1E-05;
	r7.x = 1E-05;
	r0.y = specular2Factor.x * r2.w + r7.x;
	r2.w = pow(r0.x, r0.y);
	r0.x = saturate(r3.w * 2 + -0.5);
	r0.x = (r3.w >= 0) ? r0.x : 0;
	r0.x = r0.x * r2.w;
	r0.xyz = r0.xxx * r4.yzw;
	r0.xyz = r0.xyz * r1.xyz;
	r0.xyz = r0.xyz * r6.xxx + r3.xyz;
	r0.xyz = (-specular2ColorIntensity.xxx >= 0) ? r3.xyz : r0.xyz;
	o.color2.x = r2.z * matDiffuseColor2.w;
	r2.z = r4.x * matDiffuseColor2.w;
	r0.xyz = r0.xyz * matDiffuseColor2.www;
	r0.w = saturate(r0.w * r2.x + -1);
	o.color.xyz = r0.www * globalScalars2.zzz + r1.xyz;
	o.color1.xyz = r5.xyz * 0.5 + 0.5;
	r0.w = saturate(r2.z * 0.0051020407);
	r0.w = rsqrt(r0.w);
	o.color2.y = 1 / r0.w;
	r0.w = r1.w * globalScalars.x;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	o.color3.x = 1 / r0.x;
	o.color3.y = 1 / r0.y;
	o.color3.z = 1 / r0.z;
	o.color.w = r0.w;
	o.color1.w = r0.w;
	o.color2.w = r0.w;
	o.color2.z = r2.y;
	o.color3.w = gStencil.x;

	return o;
}
