sampler2D GBufferTextureSamplerDepth : register(s10);
float3 gDeferredLightPosition : register(c203);
float gDeferredLightRadius : register(c206);
float4 gDeferredProjParams : register(c216);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float3 r2;
	float3 r3;
	r0.xyz = -gDeferredLightPosition.xyz + i.texcoord3.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0.xyz = -gViewInverse[3].xyz + i.texcoord3.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r2 = normalize(r0.xyz);
	r0.x = dot(r1.xyz, r2.xyz);
	r1.xyz = i.texcoord3.xyz;
	r0.yzw = r1.xyz + -i.texcoord4.xyz;
	r0.yzw = r0.yzw + 1E-05;
	r1.xyz = normalize(r0.yzw);
	r0.yzw = -gViewInverse[3].xyz + i.texcoord4.xyz;
	r0.yzw = r0.yzw + 1E-05;
	r2 = normalize(r0.yzw);
	r0.y = dot(r1.xyz, r2.xyz);
	r0.z = 1.2 * i.texcoord2.w;
	r0.w = 1 / i.texcoord1.w;
	r0.z = saturate(r0.z * r0.w + -abs(r0.y));
	r0.z = r0.z * 3 + 1;
	r0.x = r0.z * r0.x;
	r0.x = saturate(abs(r0.x) + -i.texcoord4.w);
	r0.x = saturate(-r0.x + abs(r0.y));
	r0.x = r0.x * i.texcoord1.w;
	r0.x = r0.x * 0.85;
	r0.x = i.texcoord1.w * 0.15 + r0.x;
	r0.y = saturate(i.texcoord2.w * -r0.w + 1);
	r0.z = i.texcoord2.w * r0.w + 0.5;
	r0.x = r0.y * r0.x;
	r0.yw = 0.51 + i.vpos.xy;
	r0.yw = r0.yw * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.yw);
	r0.y = r1.x * -gDeferredProjParams.z + gDeferredProjParams.w;
	r0.y = r0.y * i.texcoord.w;
	r0.y = 1 / r0.y;
	r0.y = saturate(-r0.y);
	r0.y = r0.y + 1E-05;
	r1.xyz = i.texcoord1.xyz;
	r2 = r1.zxy * i.texcoord.xyz;
	r1.xyz = i.texcoord.zxy * r1.xyz + -r2.xyz;
	r2 = r1.xyz * i.texcoord1.zxy;
	r1.xyz = i.texcoord1.yzx * r1.yzx + -r2.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r2 = normalize(r1.xyz);
	r0.w = dot(r2.xyz, i.texcoord.xyz);
	r1.x = r0.w + -gDeferredLightRadius.x;
	r1.x = (r1.x >= 0) ? 0 : 1;
	r1.y = gDeferredLightRadius.x * gDeferredLightRadius.x;
	r0.w = r0.w * -r0.w + r1.y;
	r1.y = 1 / r1.y;
	r0.w = rsqrt(abs(r0.w));
	r0.w = 1 / r0.w;
	r1.z = r0.w * r1.x + 1E-05;
	r0.w = r1.x * r0.w;
	r2.x = pow(r0.y, r1.z);
	r0.y = r2.x * r2.x;
	r0.x = r0.x * r0.y;
	r0.y = r0.z + -r2.x;
	r0.y = saturate(r0.y + 1);
	r0.y = r0.y * i.texcoord1.w;
	r0.y = 1 / r0.y;
	r0.x = r0.y * r0.x;
	r1.xzw = 1E-05 + i.texcoord1.xyz;
	r3 = normalize(r1.xzw);
	r0.y = dot(r3.xyz, i.texcoord1.xyz);
	r0.z = dot(r3.xyz, i.texcoord.xyz);
	r0.y = r0.y * r2.x + r0.z;
	r1.x = max(r0.z, -r0.w);
	r2.x = min(r0.w, r1.x);
	r1.x = max(r0.y, -r0.w);
	r2.y = min(r0.w, r1.x);
	r0.y = -r2.x + r2.y;
	r0.y = r0.w * 0.25 + r0.y;
	r0.x = r0.x * r0.y;
	r0.x = r0.x * r0.x;
	r0.x = r1.y * r0.x;
	o.xyz = r0.xxx * i.texcoord2.xyz;
	o.w = 0;

	return o;
}
