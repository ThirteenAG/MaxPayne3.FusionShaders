	r2.xyz = normalize(r1.xyz);
	r0.w = saturate(r0.w * -i.texcoord1.y + 1);
	r0.w = r0.w + 1E-05;
	r1.x = pow(r0.w, 2.00001);
	r0.w = r1.x + -0.33333334;
	r1.x = r0.w * 1.5;
	r1.y = dot(r2.xyz, i.texcoord3.xyz);
	r1.z = dot(r3.xyz, r2.xyz);
	r1.z = r1.z + -0.33333334;
