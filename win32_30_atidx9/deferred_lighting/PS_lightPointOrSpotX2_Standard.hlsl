sampler2D GBufferStencilTextureSampler : register(s11);
sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
float4 gDeferredProjParams : register(c216);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);
sampler2D materialIdSampler : register(s9);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float4 r6;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r0.z = r1.x * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2.xyz = -r1.xyz + i.texcoord4.xyz;
	r1.xyz = -r1.xyz + i.texcoord1.xyz;
	r0.z = dot(r2.xyz, r2.xyz);
	r0.w = r0.z + 1E-05;
	r0.z = saturate(r0.z * -i.texcoord4.w + 1);
	r0.z = r0.z * r0.z;
	r0.z = r0.z * r0.z + -0.1;
	r0.w = rsqrt(r0.w);
	r2.xyz = r0.www * r2.xyz;
	r3.xyz = 1E-05 + i.texcoord.xyz;
	r4.xyz = normalize(r3.xyz);
	r3 = tex2D(GBufferTextureSampler1, r0.xy);
	r3.xyz = r3.xyz * 2 + -1;
	r5 = normalize(r3.xyz);
	r0.w = dot(r4.xyz, r5.xyz);
	r0.w = r0.w + r0.w;
	r3.xyz = r5.xyz * -r0.www + r4.xyz;
	r0.w = saturate(dot(r2.xyz, r3.xyz));
	r0.w = r0.w + 1E-05;
	r4 = tex2D(GBufferStencilTextureSampler, r0.xy);
	r4 = tex2D(materialIdSampler, r4.ww);
	r1.w = r4.w * -132 + 196;
	r4 = tex2D(GBufferTextureSampler2, r0.xy);
	r6 = tex2D(GBufferTextureSampler0, r0.xy);
	r6.xyz = r6.xyz * r6.xyz;
	r0.x = r4.y * r4.y;
	r0.x = r0.x * r1.w + 1E-05;
	r1.w = pow(r0.w, r0.x);
	r0.y = saturate(dot(r2.xyz, r5.xyz));
	r0.w = dot(r2.xyz, i.texcoord6.xyz);
	r2.w = i.texcoord5.w;
	r0.w = saturate(-r0.w * r2.w + i.texcoord6.w);
	r2.xyz = r0.yyy * i.texcoord5.xyz;
	r2.xyz = r0.www * r2.xyz;
	r0.y = r0.z * 1.1111112;
	r2.xyz = r0.yyy * r2.xyz;
	r0.yzw = (r0.zzz >= 0) ? r2.xyz : 0;
	r2.xyz = r1.www * r0.yzw;
	r1.w = dot(r1.xyz, r1.xyz);
	r2.w = r1.w + 1E-05;
	r1.w = saturate(r1.w * -i.texcoord1.w + 1);
	r1.w = r1.w * r1.w;
	r1.w = r1.w * r1.w + -0.1;
	r2.w = rsqrt(r2.w);
	r1.xyz = r1.xyz * r2.www;
	r2.w = saturate(dot(r1.xyz, r3.xyz));
	r2.w = r2.w + 1E-05;
	r3.x = pow(r2.w, r0.x);
	r0.x = saturate(dot(r1.xyz, r5.xyz));
	r1.x = dot(r1.xyz, i.texcoord3.xyz);
	r2.w = i.texcoord2.w;
	r1.x = saturate(-r1.x * r2.w + i.texcoord3.w);
	r3.yzw = r0.xxx * i.texcoord2.xyz;
	r1.xyz = r1.xxx * r3.yzw;
	r0.x = r1.w * 1.1111112;
	r1.xyz = r0.xxx * r1.xyz;
	r1.xyz = (r1.www >= 0) ? r1.xyz : 0;
	r2.xyz = r1.xyz * r3.xxx + r2.xyz;
	r0.xyz = r0.yzw + r1.xyz;
	r1.xyz = r2.xyz * r4.xxx;
	o.xyz = r6.xyz * r0.xyz + r1.xyz;
	o.w = 1;

	return o;
}
