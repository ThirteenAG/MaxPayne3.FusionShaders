sampler2D GBufferStencilTextureSampler : register(s11);
sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
float4 dReflectionParams : register(c132);
float4 gAmbientOcclusionEffect : register(c63);
sampler2D gDeferredLightSampler0P : register(s3);
float4 gDeferredProjParams : register(c216);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightAmbientDir0 : register(c72);
float4 gLightAmbientDir1 : register(c73);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);
sampler2D materialIdSampler : register(s9);

struct PS_IN
{
	float4 texcoord1 : TEXCOORD1;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r0.z = r1.x * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord1.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord1.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2.xyz = i.texcoord1.xyz * -r0.zzz + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r1.xyz = -r1.xyz + gViewInverse[3].xyz;
	r2.xyz = normalize(r1.xyz);
	r1 = tex2D(GBufferTextureSampler1, r0.xy);
	r1.xyz = r1.xyz * 2 + -1;
	r4.xyz = normalize(r1.xyz);
	r0.z = dot(r2.xyz, r4.xyz);
	r0.zw = -abs(r0.zz) + float2(1, 1.00001);
	r1.x = pow(r0.w, 5.00001);
	r0.w = r1.x * 0.8 + 0.2;
	r0.z = (r0.z >= 0) ? r0.w : 0.2;
	r1 = tex2D(GBufferStencilTextureSampler, r0.xy);
	r2 = tex2D(materialIdSampler, r1.ww);
	r0.w = r2.y * 64;
	r1.x = r2.w * -132 + 196;
	r0.w = r1.w * 255 + -r0.w;
	r0.w = -r0.w + 0.1;
	r1.y = saturate(r4.z * 4);
	r1.y = r1.y * dReflectionParams.y;
	r0.w = (r0.w >= 0) ? r1.y : 0;
	r2 = tex2D(GBufferTextureSampler2, r0.xy);
	r1.y = r2.y * r2.y;
	r1.z = r1.y * -r1.x + 512;
	r1.x = r1.x * r1.y;
	r1.y = saturate(r1.z * 0.001953125);
	r1.y = r0.w * r1.y;
	r1.y = r0.z * r1.y;
	r1.x = r1.y * 512 + r1.x;
	r1.x = r1.x + 1E-05;
	r1.y = dot(r3.xyz, r4.xyz);
	r1.y = r1.y + r1.y;
	r1.yzw = r4.xyz * -r1.yyy + r3.xyz;
	r1.y = saturate(dot(-gDirectionalLight.xyz, r1.yzw));
	r1.y = r1.y + 1E-05;
	r2.y = pow(r1.y, r1.x);
	r1.x = dot(r4.xyz, -gDirectionalLight.xyz);
	r1.y = saturate(r1.x * 2 + -0.5);
	r1.x = saturate(r1.x + -0.25);
	r1.x = r1.x * 1.3333334;
	r1.y = r1.y * r2.y;
	r3.xyz = gDirectionalColour.www * gDirectionalColour.xyz;
	r1.yzw = r1.yyy * r3.xyz;
	r3.xyz = r1.xxx * r3.xyz;
	r1.x = dot(gLightAmbientDir0.xyz, r4.xyz);
	r2.y = dot(gLightAmbientDir1.xyz, r4.xyz);
	r2.y = r2.y + gLightAmbientDir0.w;
	r2.y = saturate(r2.y * gLightAmbientDir1.w);
	r4.xyz = r2.yyy * gLightAmbient1.xyz;
	r4.xyz = r2.zzz * r4.xyz;
	r1.x = r1.x + gLightAmbientDir0.w;
	r1.x = saturate(r1.x * gLightAmbientDir1.w);
	r5 = r1.xxx * gLightAmbient0.xyz;
	r5 = r2.zzz * r5.xyz;
	r1.x = 1 / gAmbientOcclusionEffect.y;
	r4.xyz = r1.xxx * r4.xyz;
	r4.xyz = r5.xyz * r1.xxx + r4.xyz;
	r1.x = rsqrt(r2.z);
	r1.x = 1 / r1.x;
	r2.yzw = r3.xyz * r1.xxx + r4.xyz;
	r1.x = dot(r2.yzw, 0.33333334);
	r3 = tex2D(gDeferredLightSampler0P, r0.xy);
	r4 = tex2D(GBufferTextureSampler0, r0.xy);
	r4.xyz = r4.xyz * r4.xyz;
	r3.xyz = r3.xyz * r3.xyz;
	r3.xyz = r3.xyz * 16;
	r3.xyz = r1.xxx * r3.xyz;
	r0.x = saturate(-r2.x + 1);
	r0.x = r0.w * r0.x;
	r0.x = r0.x * r0.z + r2.x;
	r0.xyz = r1.yzw * r0.xxx + r3.xyz;
	o.xyz = r4.xyz * r2.yzw + r0.xyz;
	o.w = 1;

	return o;
}
