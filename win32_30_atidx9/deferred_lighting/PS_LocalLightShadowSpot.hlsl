float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float3 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r0.z = r1.x * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2.xyz = i.texcoord.xyz * -r0.zzz + 1E-05;
	r3 = normalize(r2.xyz);
	r2 = r1.y * gShadowMatrix[1];
	r2 = r1.x * gShadowMatrix[0] + r2;
	r2 = r1.z * gShadowMatrix[2] + r2;
	r1.xyz = -r1.xyz + i.texcoord2.xyz;
	r2 = r2 + gShadowMatrix[3];
	r0.z = 1 / r2.w;
	r0.w = r2.z * r0.z + -gShadowParam0123.x;
	r2.xy = r2.xy * r0.zz + 1;
	r4.yzw = float3(1, 0, -1);
	r5 = gShadowParam0123.z * r4.wzyz + r4.zyzy;
	r6.xy = r2.xy * 0.5;
	r6.z = r2.y * -0.5 + 1;
	r6.w = -r6.y;
	r2 = r5 + r6.xwxw;
	r5 = tex2D(gShadowZSamplerDir, r2.xy);
	r2 = tex2D(gShadowZSamplerDir, r2.zw);
	r5.z = r2.x;
	r2 = tex2D(gShadowZSamplerDir, r6.xz);
	r5.y = r2.x;
	r2.xyz = -r0.www + r5.xyz;
	r2.xyz = (r2.xyz >= 0) ? 1 : 0;
	r5.x = 1 / gShadowParam0123.z;
	r5.y = 1 / gShadowParam0123.w;
	r5.xy = r5.xy * r6.xz;
	r5.xy = frac(r5.xy);
	r5.zw = r5.xx * float2(-1, 0) + 1;
	r0.z = dot(r2.zxy, r5.xzw);
	r2.xyz = r5.xwx * float3(-1, 1, 1) + float3(1, 0, 0);
	r5.xz = r6.xz + -gShadowParam0123.zw;
	r7 = tex2D(gShadowZSamplerDir, r5.xz);
	r8 = gShadowParam0123.wwzw * r4.zwyw + r6.xzxz;
	r9 = tex2D(gShadowZSamplerDir, r8.xy);
	r8 = tex2D(gShadowZSamplerDir, r8.zw);
	r7.z = r8.x;
	r7.y = r9.x;
	r5.xzw = -r0.www + r7.xyz;
	r5.xzw = (r5.xzw >= 0) ? 1 : 0;
	r1.w = dot(r5.xzw, r2.xyz);
	r2.w = -r5.y + 1;
	r0.z = r1.w * r2.w + r0.z;
	r5.xz = r6.xz + gShadowParam0123.zw;
	r4 = gShadowParam0123.zwww * r4.wyzy + r6.xzxz;
	r6 = tex2D(gShadowZSamplerDir, r5.xz);
	r6.z = r6.x;
	r7 = tex2D(gShadowZSamplerDir, r4.xy);
	r4 = tex2D(gShadowZSamplerDir, r4.zw);
	r6.y = r4.x;
	r6.x = r7.x;
	r4.xyz = -r0.www + r6.xyz;
	r4.xyz = (r4.xyz >= 0) ? 1 : 0;
	r0.w = dot(r4.xyz, r2.xyz);
	r0.z = r0.w * r5.y + r0.z;
	r0.z = r0.z * 0.33333334;
	r0.w = 1;
	r1.w = lerp(gShadowParam0123.y, r0.w, r0.z);
	r0.z = dot(r1.xyz, r1.xyz);
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r0.z = saturate(r0.z * -i.texcoord1.y + 1);
	r0.z = r0.z + 1E-05;
	r1.x = pow(r0.z, 4.00001);
	r0.z = r1.x + -0.1;
	r0.w = r0.z * 1.1111112;
	r1.xyz = r0.www * i.texcoord4.xyz;
	r0.w = dot(r2.xyz, i.texcoord3.xyz);
	r0.w = saturate(r0.w * i.texcoord1.w + i.texcoord1.z);
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = (r0.zzz >= 0) ? r1.xyz : 0;
	r1.xyz = r1.www * r1.xyz;
	r4 = tex2D(GBufferTextureSampler1, r0.xy);
	r4.xyz = r4.xyz * 2 + -1;
	r5.xyz = normalize(r4.xyz);
	r0.z = dot(r3.xyz, r5.xyz);
	r0.z = r0.z + r0.z;
	r3 = r5.xyz * -r0.zzz + r3.xyz;
	r0.z = saturate(dot(r2.xyz, r5.xyz));
	r0.w = saturate(dot(r2.xyz, r3.xyz));
	r0.w = r0.w + 1E-05;
	r2 = tex2D(GBufferStencilTextureSampler, r0.xy);
	r2 = tex2D(materialIdSampler, r2.ww);
	r1.w = r2.w * -132 + 196;
	r2 = tex2D(GBufferTextureSampler2, r0.xy);
	r2.y = r2.y * r2.y;
	r1.w = r2.y * r1.w + 1E-05;
	r2.y = pow(r0.w, r1.w);
	r0.w = saturate(r0.z * 2 + -0.5);
	r3 = r0.zzz * r1.xyz;
	r0.z = r0.w * r2.y;
	r1.xyz = r0.zzz * r1.xyz;
	r1.xyz = r1.xyz * r2.xxx;
	r2 = tex2D(GBufferTextureSampler0, r0.xy);
	r0 = tex2D(gDeferredLightSampler0P, r0.xy);
	r0.xyz = r0.xyz * r0.xyz;
	r0.xyz = r0.xyz * 16;
	r2.xyz = r2.xyz * r2.xyz;
	r1.xyz = r2.xyz * r3.xyz + r1.xyz;
	r0.w = dot(r3.xyz, 0.33333334);
	o.xyz = r0.xyz * r0.www + r1.xyz;
	o.w = 1;

	return o;
}
