float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectBottomOffsetScreenEdge : register(c67);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorCorrectTopScreenEdge : register(c66);
float4 ColorShift : register(c45);
sampler2D GBufferTextureSamplerDepth : register(s10);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float3 gDeferredLightPosition : register(c203);
float gDeferredLightRadius : register(c206);
float4 gDeferredProjParams : register(c216);
float4 globalScalars4 : register(c51);
float4 globalScreenSize : register(c41);
float4 gooDeferredLightScreenSize : register(c215);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float3 r2;
	float4 r3;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r0 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r0.x = r0.x * -gDeferredProjParams.z + gDeferredProjParams.w;
	r0.x = r0.x * i.texcoord.w;
	r0.x = 1 / r0.x;
	r0.x = saturate(-r0.x);
	r0.yzw = 1E-05 + i.texcoord1.xyz;
	r1.xyz = normalize(r0.yzw);
	r0.y = dot(r1.xyz, i.texcoord1.xyz);
	r0.z = dot(r1.xyz, i.texcoord.xyz);
	r0.x = r0.y * r0.x + r0.z;
	r1.xyz = i.texcoord1.xyz;
	r2 = r1.zxy * i.texcoord.xyz;
	r1.xyz = i.texcoord.zxy * r1.xyz + -r2.xyz;
	r2 = r1.xyz * i.texcoord1.zxy;
	r1.xyz = i.texcoord1.yzx * r1.yzx + -r2.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r2 = normalize(r1.xyz);
	r0.y = dot(r2.xyz, i.texcoord.xyz);
	r0.w = r0.y + -gDeferredLightRadius.x;
	r0.w = (r0.w >= 0) ? 0 : 1;
	r1.x = gDeferredLightRadius.x * gDeferredLightRadius.x;
	r0.y = r0.y * -r0.y + r1.x;
	r1.x = 1 / r1.x;
	r0.y = rsqrt(abs(r0.y));
	r0.y = 1 / r0.y;
	r0.y = r0.w * r0.y;
	r1.y = max(r0.x, -r0.y);
	r2.x = min(r0.y, r1.y);
	r1.y = max(r0.z, -r0.y);
	r2.y = min(r0.y, r1.y);
	r0.x = -r2.y + r2.x;
	r0.yzw = -gDeferredLightPosition.xyz + i.texcoord3.xyz;
	r0.yzw = r0.yzw + 1E-05;
	r2 = normalize(r0.yzw);
	r0.yzw = 1E-05 + i.texcoord.xyz;
	r3.xyz = normalize(r0.yzw);
	r0.y = dot(r2.xyz, r3.xyz);
	r0.y = saturate(abs(r0.y) + -0.25);
	r0.x = r0.y * r0.x;
	r0.x = r0.x * r0.x;
	r0.x = r1.x * r0.x;
	r0.yzw = r0.xxx * i.texcoord2.xyz;
	r0.y = dot(r0.yzw, float3(0.2125, 0.7154, 0.0721));
	r0.xzw = i.texcoord2.xyz * r0.xxx + -r0.yyy;
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r0.xzw = r1.xxx * r0.xzw + r0.yyy;
	r1.x = r0.y * ColorCorrectBottomOffset.w;
	r0.y = r0.y * ColorShift.w;
	r1.yzw = globalScalars4.yzw * -r1.xxx + r0.xzw;
	r0.xzw = ColorShift.xyz * -r0.yyy + r0.xzw;
	r2 = r1.xxx * globalScalars4.yzw;
	r1.x = saturate(r1.x);
	r1.xyz = r1.xxx * r1.yzw + r2.xyz;
	r1.w = 1 / globalScreenSize.y;
	r2.y = r1.w * i.vpos.y;
	r3 = ColorCorrectTopScreenEdge;
	r3.xyz = r2.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r3.xyz;
	r1.xyz = r1.xyz * r3.xyz;
	r3.xyz = r0.yyy * ColorShift.xyz;
	r0.y = saturate(r0.y);
	r0.xyz = r0.yyy * r0.xzw + r3.xyz;
	r3.xyz = ColorCorrectBottomOffset.xyz;
	r3.xyz = r2.yyy * r3.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r0.xyz * r3.xyz;
	r0.w = 1 / globalScreenSize.x;
	r2.x = r0.w * i.vpos.x;
	r2.xy = r2.xy + -0.5;
	r0.w = dot(r2.xy, r2.xy) + 0;
	r0.w = rsqrt(r0.w);
	r0.w = 1 / r0.w;
	r1.w = r3.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r1.w = (r1.w >= 0) ? -r1.w : -0;
	r0.w = r0.w + r1.w;
	r1.w = r1.w + ColorCorrectTopScreenEdge.w;
	r1.w = 1 / r1.w;
	r1.w = saturate(r0.w * r1.w);
	r0.w = (r0.w >= 0) ? r1.w : 0;
	r2 = lerp(r0.xyz, r1.xyz, r0.www);
	o.xyz = (ColorCorrectTopScreenEdge.www >= 0) ? r2.xyz : r0.xyz;
	o.w = 0;

	return o;
}
