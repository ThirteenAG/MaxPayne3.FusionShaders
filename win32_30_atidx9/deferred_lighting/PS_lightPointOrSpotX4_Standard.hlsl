sampler2D GBufferStencilTextureSampler : register(s11);
sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
float4 gDeferredProjParams : register(c216);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);
sampler2D materialIdSampler : register(s9);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord8 : TEXCOORD8;
	float4 texcoord9 : TEXCOORD9;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r0.z = r1.x * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord.xyz * -r0.zzz + 1E-05;
	r2.xyz = i.texcoord.xyz * -r0.zzz + gViewInverse[3].xyz;
	r3.xyz = normalize(r1.xyz);
	r1 = tex2D(GBufferTextureSampler1, r0.xy);
	r1.xyz = r1.xyz * 2 + -1;
	r4.xyz = normalize(r1.xyz);
	r0.z = dot(-r3.xyz, r4.xyz);
	r0.z = r0.z + r0.z;
	r1.xyz = r4.xyz * -r0.zzz + -r3.xyz;
	r3 = -r2.x + i.texcoord1;
	r5 = r3 * r3;
	r6 = -r2.y + i.texcoord2;
	r2 = -r2.z + i.texcoord3;
	r5 = r6 * r6 + r5;
	r5 = r2 * r2 + r5;
	r7 = r5 + 1E-05;
	r5 = saturate(r5 * -i.texcoord7 + 1);
	r5 = r5 * r5;
	r5 = r5 * r5 + -0.1;
	r8.x = rsqrt(r7.x);
	r8.y = rsqrt(r7.y);
	r8.z = rsqrt(r7.z);
	r8.w = rsqrt(r7.w);
	r3 = r3 * r8;
	r7 = r1.x * r3;
	r6 = r6 * r8;
	r2 = r2 * r8;
	r7 = r1.y * r6 + r7;
	r1 = saturate(r1.z * r2 + r7);
	r1 = r1 + 1E-05;
	r7.x = log2(r1.x);
	r7.y = log2(r1.y);
	r7.z = log2(r1.z);
	r7.w = log2(r1.w);
	r1 = tex2D(GBufferStencilTextureSampler, r0.xy);
	r1 = tex2D(materialIdSampler, r1.ww);
	r0.z = r1.w * -132 + 196;
	r1 = tex2D(GBufferTextureSampler2, r0.xy);
	r8 = tex2D(GBufferTextureSampler0, r0.xy);
	r0.xyw = r8.xyz * r8.xyz;
	r1.y = r1.y * r1.y;
	r0.z = r1.y * r0.z + 1E-05;
	r7 = r7 * r0.z;
	r8.x = exp2(r7.x);
	r8.y = exp2(r7.y);
	r8.z = exp2(r7.z);
	r8.w = exp2(r7.w);
	r7 = r4.x * r3;
	r7 = r6 * r4.y + r7;
	r4 = r2 * r4.z + r7;
	r7 = r5 * 1.1111112;
	r5 = (r5 >= 0) ? r7 : 0;
	r4 = saturate(r4 * r5);
	r5 = frac(i.texcoord4);
	r7 = r5 * 4 + -1;
	r5 = -r5 + i.texcoord4;
	r5 = r5 * 0.00390625;
	r3 = r3 * -r7;
	r7 = frac(i.texcoord5);
	r9 = r7 * 4 + -1;
	r7 = -r7 + i.texcoord5;
	r7 = r7 * 0.00390625;
	r3 = r6 * -r9 + r3;
	r6 = frac(i.texcoord6);
	r9 = r6 * 4 + -1;
	r6 = -r6 + i.texcoord6;
	r6 = r6 * 0.00390625;
	r2 = r2 * -r9 + r3;
	r3 = i.texcoord8;
	r2 = saturate(r2 * r3 + i.texcoord9);
	r2 = r4 * r2;
	r3 = r2 * r8;
	r4.x = dot(r5, r3);
	r5.x = dot(r5, r2);
	r4.y = dot(r7, r3);
	r5.y = dot(r7, r2);
	r5.z = dot(r6, r2);
	r4.z = dot(r6, r3);
	r1.xyz = r1.xxx * r4.xyz;
	o.xyz = r0.xyw * r5.xyz + r1.xyz;
	o.w = 1;

	return o;
}
