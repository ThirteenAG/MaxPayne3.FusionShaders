sampler2D GBufferStencilTextureSampler : register(s11);
sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
float4 gDeferredProjParams : register(c216);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);
sampler2D materialIdSampler : register(s9);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord8 : TEXCOORD8;
	float4 texcoord9 : TEXCOORD9;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float4 r6;
	float3 r7;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r0.z = r1.x * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2.xyz = i.texcoord.xyz * -r0.zzz + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r2.xyz = -r1.xyz + i.texcoord7.xyz;
	r0.z = dot(r2.xyz, r2.xyz);
	r0.w = r0.z + 1E-05;
	r0.z = saturate(r0.z * -i.texcoord7.w + 1);
	r0.z = r0.z * r0.z;
	r0.z = r0.z * r0.z + -0.1;
	r0.w = rsqrt(r0.w);
	r2.xyz = r0.www * r2.xyz;
	r0.w = dot(r2.xyz, i.texcoord9.xyz);
	r1.w = i.texcoord8.w;
	r0.w = saturate(-r0.w * r1.w + i.texcoord9.w);
	r4 = tex2D(GBufferTextureSampler1, r0.xy);
	r4.xyz = r4.xyz * 2 + -1;
	r5 = normalize(r4.xyz);
	r1.w = saturate(dot(r2.xyz, r5.xyz));
	r4.xyz = r1.www * i.texcoord8.xyz;
	r4.xyz = r0.www * r4.xyz;
	r0.w = r0.z * 1.1111112;
	r4.xyz = r0.www * r4.xyz;
	r4.xyz = (r0.zzz >= 0) ? r4.xyz : 0;
	r0.z = dot(-r3.xyz, r5.xyz);
	r0.z = r0.z + r0.z;
	r3.xyz = r5.xyz * -r0.zzz + -r3.xyz;
	r0.z = saturate(dot(r2.xyz, r3.xyz));
	r0.z = r0.z + 1E-05;
	r2 = tex2D(GBufferStencilTextureSampler, r0.xy);
	r2 = tex2D(materialIdSampler, r2.ww);
	r0.w = r2.w * -132 + 196;
	r2 = tex2D(GBufferTextureSampler2, r0.xy);
	r6 = tex2D(GBufferTextureSampler0, r0.xy);
	r6.xyz = r6.xyz * r6.xyz;
	r0.x = r2.y * r2.y;
	r0.x = r0.x * r0.w + 1E-05;
	r1.w = pow(r0.z, r0.x);
	r0.yzw = r1.www * r4.xyz;
	r2.yzw = -r1.xyz + i.texcoord4.xyz;
	r1.xyz = -r1.xyz + i.texcoord1.xyz;
	r1.w = dot(r2.yzw, r2.yzw);
	r3.w = r1.w + 1E-05;
	r1.w = saturate(r1.w * -i.texcoord4.w + 1);
	r1.w = r1.w * r1.w;
	r1.w = r1.w * r1.w + -0.1;
	r3.w = rsqrt(r3.w);
	r2.yzw = r2.yzw * r3.www;
	r3.w = saturate(dot(r2.yzw, r5.xyz));
	r7 = r3.www * i.texcoord5.xyz;
	r3.w = dot(r2.yzw, i.texcoord6.xyz);
	r2.y = saturate(dot(r2.yzw, r3.xyz));
	r2.y = r2.y + 1E-05;
	r4.w = pow(r2.y, r0.x);
	r2.w = i.texcoord5.w;
	r2.y = saturate(-r3.w * r2.w + i.texcoord6.w);
	r2.yzw = r2.yyy * r7.xyz;
	r3.w = r1.w * 1.1111112;
	r2.yzw = r2.yzw * r3.www;
	r2.yzw = (r1.www >= 0) ? r2.yzw : 0;
	r0.yzw = r2.yzw * r4.www + r0.yzw;
	r2.yzw = r4.xyz + r2.yzw;
	r1.w = dot(r1.xyz, r1.xyz);
	r3.w = r1.w + 1E-05;
	r1.w = saturate(r1.w * -i.texcoord1.w + 1);
	r1.w = r1.w * r1.w;
	r1.w = r1.w * r1.w + -0.1;
	r3.w = rsqrt(r3.w);
	r1.xyz = r1.xyz * r3.www;
	r3.w = saturate(dot(r1.xyz, r5.xyz));
	r4.xyz = r3.www * i.texcoord2.xyz;
	r3.w = dot(r1.xyz, i.texcoord3.xyz);
	r1.x = saturate(dot(r1.xyz, r3.xyz));
	r1.x = r1.x + 1E-05;
	r3.x = pow(r1.x, r0.x);
	r4.w = i.texcoord2.w;
	r0.x = saturate(-r3.w * r4.w + i.texcoord3.w);
	r1.xyz = r0.xxx * r4.xyz;
	r0.x = r1.w * 1.1111112;
	r1.xyz = r0.xxx * r1.xyz;
	r1.xyz = (r1.www >= 0) ? r1.xyz : 0;
	r0.xyz = r1.xyz * r3.xxx + r0.yzw;
	r1.xyz = r2.yzw + r1.xyz;
	r0.xyz = r0.xyz * r2.xxx;
	o.xyz = r6.xyz * r1.xyz + r0.xyz;
	o.w = 1;

	return o;
}
