float3 AmbientLightingParams : register(c207);
float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectBottomOffsetScreenEdge : register(c67);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorCorrectTopScreenEdge : register(c66);
float4 ColorShift : register(c45);
sampler2D DiffuseSampler : register(s0);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightAmbientDir0 : register(c72);
float4 gLightAmbientDir1 : register(c73);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 globalScalars4 : register(c51);
float4 globalScreenSize : register(c41);
float specularColorFactor : register(c199);
float specularFactor : register(c198);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	float4 r5;
	r0 = float4(-512, 0, 0, -512) + -i.texcoord3.zxyz;
	r1 = r0.x;
	clip(r1);
	r0.x = r0.w * globalFogParams.x;
	r0.y = dot(r0.yzw, r0.yzw);
	r0.y = rsqrt(r0.y);
	r0.y = 1 / r0.y;
	r0.y = r0.y * globalFogParams.z;
	r0.z = r0.x * -1.442695;
	r0.z = exp2(r0.z);
	r0.w = r0.z + -65504;
	r0.z = -r0.z + 1;
	r0.z = (r0.w >= 0) ? -65503 : r0.z;
	r0.w = 1 / r0.x;
	r0.x = -abs(r0.x) + 0.0001;
	r0.z = r0.w * r0.z;
	r0.z = r0.z * r0.y;
	r0.x = (r0.x >= 0) ? r0.y : r0.z;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = saturate(exp2(r0.x));
	r1.xy = float2(0.15, 1);
	r0.y = saturate(AmbientLightingParams.x * -r1.x + r1.y);
	r0.y = saturate(r0.y + 0.2);
	r0.y = r0.y * AmbientLightingParams.y;
	r0.y = i.color.x * r0.y + -i.color.x;
	r0.y = gAmbientOcclusionEffect.x * r0.y + i.color.x;
	r1.xyz = 1E-05 + i.texcoord1.xyz;
	r2.xyz = normalize(r1.xyz);
	r0.z = dot(gLightAmbientDir0.xyz, r2.xyz);
	r0.z = r0.z + gLightAmbientDir0.w;
	r0.z = saturate(r0.z * gLightAmbientDir1.w);
	r1.xyz = r0.zzz * gLightAmbient0.xyz;
	r1.xyz = r0.yyy * r1.xyz;
	r0.z = dot(gLightAmbientDir1.xyz, r2.xyz);
	r0.z = r0.z + gLightAmbientDir0.w;
	r0.z = saturate(r0.z * gLightAmbientDir1.w);
	r3.xyz = r0.zzz * gLightAmbient1.xyz;
	r0.yzw = r0.yyy * r3.xyz;
	r1.w = 1 / gAmbientOcclusionEffect.y;
	r0.yzw = r0.yzw * r1.www;
	r0.yzw = r1.xyz * r1.www + r0.yzw;
	r1.xyz = gDirectionalColour.www * gDirectionalColour.xyz;
	r1.w = dot(r2.xyz, -gDirectionalLight.xyz);
	r2.w = saturate(r1.w + -0.25);
	r1.w = saturate(r1.w * 2 + -0.5);
	r2.w = r2.w * 1.3333334;
	r0.yzw = r1.xyz * r2.www + r0.yzw;
	r3.xyz = 1E-05 + i.texcoord3.xyz;
	r4 = normalize(r3.xyz);
	r2.w = dot(r4.xyz, r2.xyz);
	r2.w = r2.w + r2.w;
	r2.xyz = r2.xyz * -r2.www + r4.xyz;
	r2.x = saturate(dot(-gDirectionalLight.xyz, r2.xyz));
	r2.x = r2.x + 1E-05;
	r2.z = 1E-05;
	r2.y = r2.z + specularFactor.x;
	r3.x = pow(r2.x, r2.y);
	r1.w = r1.w * r3.x;
	r1.xyz = r1.www * r1.xyz;
	r1.xyz = r1.xyz * gDirectionalLight.www;
	r1.xyz = r1.xyz * specularColorFactor.xxx;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = abs(r2) + 1E-05;
	r3.x = log2(r2.x);
	r3.y = log2(r2.y);
	r3.z = log2(r2.z);
	r3.w = log2(r2.w);
	r2 = r3 * 2.20001;
	r3.x = exp2(r2.x);
	r3.y = exp2(r2.y);
	r3.z = exp2(r2.z);
	r1.w = exp2(r2.w);
	r1.w = r1.w * i.color.w;
	r2.w = r1.w * globalScalars.x;
	r0.yzw = r3.xyz * r0.yzw + r1.xyz;
	r1.x = dot(r0.yzw, float3(0.2125, 0.7154, 0.0721));
	r1.y = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.z = -r1.y + 1;
	r1.yz = r1.zz * gDepthFxParams.xy + r1.yy;
	r3.xyz = lerp(r1.xxx, r0.yzw, r1.yyy);
	r0.y = r1.x + 1E-05;
	r0.y = abs(r0.y) + 1E-05;
	r0.z = r1.z + -0.99999;
	r1.x = pow(r0.y, r0.z);
	r2.xyz = globalFogColorN.xyz;
	r1.xyz = r3.xyz * r1.xxx + -r2.xyz;
	r1.w = 0;
	r0 = r0.x * r1 + r2;
	r1.w = r0.w;
	r2.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r3.x = gAdrenoFXVars.x;
	r2.y = r3.x * deSatContrastGamma.x;
	r3.xyz = lerp(r2.xxx, r0.xyz, r2.yyy);
	r2.y = r2.x * ColorCorrectBottomOffset.w;
	r2.x = r2.x * ColorShift.w;
	r4 = globalScalars4.yzw * -r2.yyy + r3.xyz;
	r3.xyz = ColorShift.xyz * -r2.xxx + r3.xyz;
	r5.xyz = r2.yyy * globalScalars4.yzw;
	r2.y = saturate(r2.y);
	r2.yzw = r2.yyy * r4.xyz + r5.xyz;
	r3.w = 1 / globalScreenSize.y;
	r4.y = r3.w * i.vpos.y;
	r5 = ColorCorrectTopScreenEdge;
	r5.xyz = r4.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r5.xyz;
	r1.xyz = r2.yzw * r5.xyz;
	r2.yzw = r2.xxx * ColorShift.xyz;
	r2.x = saturate(r2.x);
	r2.xyz = r2.xxx * r3.xyz + r2.yzw;
	r3.xyz = ColorCorrectBottomOffset.xyz;
	r3.xyz = r4.yyy * r3.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r2.xyz * r3.xyz;
	r2.x = 1 / globalScreenSize.x;
	r4.x = r2.x * i.vpos.x;
	r2.xy = r4.xy + -0.5;
	r2.x = dot(r2.xy, r2.xy) + 0;
	r2.x = rsqrt(r2.x);
	r2.x = 1 / r2.x;
	r2.y = r5.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r2.y = (r2.y >= 0) ? -r2.y : -0;
	r2.x = r2.y + r2.x;
	r2.y = r2.y + ColorCorrectTopScreenEdge.w;
	r2.y = 1 / r2.y;
	r2.y = saturate(r2.y * r2.x);
	r2.x = (r2.x >= 0) ? r2.y : 0;
	r3 = lerp(r0, r1, r2.x);
	r0 = (ColorCorrectTopScreenEdge.w >= 0) ? r3 : r0;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;
	r0.x = 64 + -i.texcoord1.w;
	r0.x = saturate(r0.x * 0.25);
	o.w = r0.x * r0.w;

	return o;
}
