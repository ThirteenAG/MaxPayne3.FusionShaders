sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
float4 SkinParams : register(c215);
sampler2D SpecSampler : register(s5);
float4 SubColor : register(c196);
float SubScatWidth : register(c198);
float SubScatWrap : register(c197);
sampler2D SweatMapSampler : register(s11);
sampler3D VolumeSampler : register(s6);
sampler2D WrinkleMaskSampler_0 : register(s7);
sampler2D WrinkleMaskSampler_1 : register(s8);
sampler2D WrinkleSampler_A : register(s9);
sampler2D WrinkleSampler_B : register(s10);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c207);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gDirectionalLight : register(c19);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float specularFactor : register(c202);
float4 vNoiseParams : register(c214);
float4 vSkinSweat : register(c216);
float4 wrinkleMaskStrengths0 : register(c210);
float4 wrinkleMaskStrengths1 : register(c211);
float4 wrinkleMaskStrengths2 : register(c212);
float4 wrinkleMaskStrengths3 : register(c213);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color2 : COLOR2;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float3 r7;
	r0 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r0.z = -r1.w + 1;
	r0.z = -r1.x + r0.z;
	r0.zw = (r0.zz >= 0) ? r1.wy : r1.xy;
	r0 = r0 + -0.5;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r1.z = -r1.w + 1;
	r1.z = -r1.x + r1.z;
	r1.xy = (r1.zz >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy + -0.5;
	r1.xy = r1.xy * bumpiness.xx;
	r1.xy = r1.xy + r1.xy;
	r0.zw = r0.zw * 2 + -r1.xy;
	r2 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r1.z = dot(wrinkleMaskStrengths0, r2);
	r1.w = dot(wrinkleMaskStrengths2, r2);
	r2 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r3.x = dot(wrinkleMaskStrengths1, r2);
	r2.x = dot(wrinkleMaskStrengths3, r2);
	r1.w = r1.w + r2.x;
	r1.z = r1.z + r3.x;
	r0.zw = r1.zz * r0.zw + r1.xy;
	r0.xy = r0.xy * 2 + -r0.zw;
	r0.xy = r1.ww * r0.xy + r0.zw;
	r0.w = dot(r0.xy, -r0.xy) + 1;
	r1.x = max(r0.w, 0);
	r0.w = rsqrt(r1.x);
	r0.z = 1 / r0.w;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0.xyz = r1.xxx * i.texcoord4.xyz;
	r0.xyz = i.texcoord1.xyz * r1.zzz + r0.xyz;
	r0.xyz = i.texcoord5.xyz * r1.yyy + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r1.xyz = r0.www * r0.xyz;
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r2.xyz = normalize(r0.xyz);
	r0.x = dot(gDirectionalLight.xyz, r1.xyz);
	r0.x = r0.x + SubScatWrap.x;
	r3.xzw = float3(1, 2, 0);
	r0.y = r3.x + SubScatWrap.x;
	r0.y = 1 / r0.y;
	r0.x = r0.y * r0.x;
	r1.w = max(r0.x, 0);
	r0.x = SubScatWidth.x * -r3.z + r1.w;
	r0.y = 1 / -SubScatWidth.x;
	r0.x = saturate(r0.y * r0.x);
	r0.y = r0.x * -2 + 3;
	r0.x = r0.x * r0.x;
	r0.x = r0.x * r0.y;
	r0.y = 1 / SubScatWidth.x;
	r0.y = saturate(r0.y * r1.w);
	r0.z = r0.y * -2 + 3;
	r0.y = r0.y * r0.y;
	r0.y = r0.y * r0.z;
	r0.x = r0.x * r0.y;
	r0.xyz = r0.xxx * SubColor.xyz;
	r4 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.xyz = r0.xyz * r4.www;
	r0.xyz = r0.xyz * 0.5 + r4.xyz;
	r0.xyz = r0.xyz * matMaterialColorScale.xxx;
	r4 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = r4.z * 16;
	r1.w = frac(r0.w);
	r0.w = r0.w + -r1.w;
	r1.w = (-r1.w >= 0) ? 0 : 1;
	r1.w = (r4.z >= 0) ? 0 : r1.w;
	r0.w = r0.w + r1.w;
	r0.w = r0.w + 0.5;
	r5.z = r0.w * 0.0625;
	r5.xy = detailSettings.zw * i.texcoord.xy;
	r5 = tex3D(VolumeSampler, r5.xyz);
	r5.xyz = r5.yzx * 2 + -1;
	r0.w = detailSettings.x * i.texcoord2.w;
	r0.w = r5.z * r0.w + 1;
	r6 = r0.www * r0.xyz;
	r1.w = dot(r6.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.xyz = r0.xyz * r0.www + -r1.www;
	r2.w = 0.1;
	r2.w = saturate(r2.w + deSatContrastGamma.x);
	r2.w = 1 / r2.w;
	r2.w = r2.w * gAdrenoFXVars.z;
	r0.xyz = r2.www * r0.xyz + r1.www;
	r7 = saturate(r3.xxx + -ColorCorrectTopAndPedReflectScale.xyz);
	r7 = r7.xyz * 0.25 + 1;
	r0.xyz = r0.xyz * r7.xyz + -r6.xyz;
	r1.w = saturate(gAmbientOcclusionEffect.z);
	o.color.xyz = r1.www * r0.xyz + r6.xyz;
	o.color2.z = saturate(r1.w + i.texcoord2.x);
	r0.xyz = r5.yyy * i.texcoord5.xyz;
	r0.xyz = i.texcoord4.xyz * r5.xxx + r0.xyz;
	r0.xyz = r0.xyz * detailSettings.yyy;
	r0.xyz = r0.xyz * i.texcoord2.www + r1.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r5 = tex2D(SweatMapSampler, i.texcoord.xy);
	r0.xy = r5.xy + -0.5;
	r0.xy = r0.xy * SkinParams.zz;
	r0.xy = r0.xy + r0.xy;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r1.w = max(r0.z, 0);
	r0.z = rsqrt(r1.w);
	r0.z = 1 / r0.z;
	r5.xyw = r0.xxx * i.texcoord4.xyz;
	r5.xyw = i.texcoord1.xyz * r0.zzz + r5.xyw;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r5.xyw;
	r0.xyz = r0.xyz + 1E-05;
	r1.w = dot(r0.xyz, r0.xyz);
	r1.w = rsqrt(r1.w);
	r0.xyz = r0.xyz * r1.www + -r1.xyz;
	r1.w = 1 / vSkinSweat.w;
	r3.yz = r5.zz + -vSkinSweat.zy;
	r2.w = -r5.z + vSkinSweat.y;
	r1.w = saturate(r1.w * r3.z);
	r3.y = (r3.y >= 0) ? -0 : -1;
	r2.w = (r2.w >= 0) ? -0 : r3.y;
	r0.xyz = r1.www * r0.xyz + r1.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r5.xyz = normalize(r0.xyz);
	r0.xyz = (r2.www >= 0) ? r1.xyz : r5.xyz;
	o.color1.xyz = r0.xyz * 0.5 + 0.5;
	r0.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0.x = dot(r1.xyz, r2.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.z = dot(r4.xyz, specMapIntMask.xyz);
	r1.x = dot(r4, specMapExpMask);
	r1.x = r1.x * specularFactor.x;
	r2.x = max(1, r1.x);
	r1.x = r2.x * matMaterialColorScale.w;
	r1.y = r0.z * matMaterialColorScale.w;
	r1.y = saturate(r1.y * 5);
	r0.y = r0.y * r1.y;
	r1.y = saturate(r1.x * -0.01 + 1);
	r2.x = vSkinSweat.x;
	r4.y = SkinParams.y * r2.x + r1.x;
	r0.y = r0.y * r1.y;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r0.z * matMaterialColorScale.w + r0.x;
	r0.x = saturate(r0.w * r0.x);
	r0.x = SkinParams.x * r2.x + r0.x;
	r0.yz = r2.xx * vNoiseParams.zw;
	r0.y = r0.w * r0.y + r0.z;
	r4.x = r0.y + r0.x;
	r0.xy = lerp(r4.xy, vNoiseParams.xy, r1.ww);
	r0.xy = (r2.ww >= 0) ? r4.xy : r0.xy;
	r0.y = saturate(r0.y * 0.015625);
	o.color2.x = r0.x;
	r0.x = rsqrt(r0.y);
	o.color2.y = 1 / r0.x;
	r0.x = globalScalars.x * i.texcoord2.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3 = r3.wwwx * gStencil.x;

	return o;
}
