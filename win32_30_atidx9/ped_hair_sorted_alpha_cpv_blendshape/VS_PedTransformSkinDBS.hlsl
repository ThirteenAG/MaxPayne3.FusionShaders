float4 AirResist : register(c224);
float WindStr : register(c225);
row_major float3x4 gBoneMtx[40] : register(c76);
row_major float4x4 gViewInverse : register(c12);
float4 gWindParams : register(c223);
row_major float4x4 gWorld : register(c0);
row_major float4x4 gWorldViewProj : register(c8);
float4 globalScalars2 : register(c36);
float4 globalScalars3 : register(c49);
float4 globalScalars4 : register(c51);

struct VS_IN
{
	float4 position : POSITION;
	float4 blendweight : BLENDWEIGHT;
	float4 blendindices : BLENDINDICES;
	float4 texcoord : TEXCOORD;
	float4 normal : NORMAL;
	float4 tangent : TANGENT;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 position1 : POSITION1;
	float4 normal1 : NORMAL1;
	float4 tangent1 : TANGENT1;
};

struct VS_OUT
{
	float4 position : POSITION;
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	int4 a0;
	float4 r1;
	float3 r2;
	float3 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	r0 = 765.00586 * i.blendindices;
	a0 = r0.yxzw;
	r1 = i.blendweight.y * gBoneMtx[a0.x / 3][1];
	r1 = gBoneMtx[a0.y / 3][1] * i.blendweight.x + r1;
	r0 = gBoneMtx[a0.z / 3][1] * i.blendweight.z + r1;
	r0 = gBoneMtx[a0.w / 3][1] * i.blendweight.w + r0;
	r1.xyz = i.position.xyz;
	r1.xyz = r1.xyz + i.position1.xyz;
	r1.w = 1;
	r2.y = dot(r0, r1);
	r3 = r2.yyy * gWorld[1].xyz;
	r4 = i.blendweight.y * gBoneMtx[a0.x / 3][0];
	r5 = i.blendweight.y * gBoneMtx[a0.x / 3][2];
	r5 = gBoneMtx[a0.y / 3][2] * i.blendweight.x + r5;
	r4 = gBoneMtx[a0.y / 3][0] * i.blendweight.x + r4;
	r4 = gBoneMtx[a0.z / 3][0] * i.blendweight.z + r4;
	r5 = gBoneMtx[a0.z / 3][2] * i.blendweight.z + r5;
	r5 = gBoneMtx[a0.w / 3][2] * i.blendweight.w + r5;
	r4 = gBoneMtx[a0.w / 3][0] * i.blendweight.w + r4;
	r2.x = dot(r4, r1);
	r2.z = dot(r5, r1);
	r1.xyz = r2.xxx * gWorld[0].xyz + r3.xyz;
	r1.xyz = r2.zzz * gWorld[2].xyz + r1.xyz;
	r1.xyz = r1.xyz + gWorld[3].xyz;
	o.texcoord3 = -r1.xyz + gViewInverse[3].xyz;
	o.texcoord7 = r1.xyz;
	r1.xyz = i.normal.xyz;
	r1.xyz = r1.xyz + i.normal1.xyz;
	r0.w = dot(r0.xyz, r1.xyz);
	r3 = r0.www * gWorld[1].xyz;
	r0.w = dot(r4.xyz, r1.xyz);
	r3 = r0.www * gWorld[0].xyz + r3.xyz;
	r0.w = dot(r5.xyz, r1.xyz);
	r3 = r0.www * gWorld[2].xyz + r3.xyz;
	r6 = i.tangent;
	r6 = r6 + i.tangent1;
	r0.x = dot(r0.xyz, r6.xyz);
	r0.xyz = r0.xxx * gWorld[1].xyz;
	r0.w = dot(r4.xyz, r6.xyz);
	r0.xyz = r0.www * gWorld[0].xyz + r0.xyz;
	r0.w = dot(r5.xyz, r6.xyz);
	r0.xyz = r0.www * gWorld[2].xyz + r0.xyz;
	r4.xyz = r3.yzx * r0.zxy;
	r4.xyz = r0.yzx * r3.zxy + -r4.xyz;
	o.texcoord1.xyz = r3.xyz;
	o.texcoord4 = r0.xyz;
	o.texcoord5.xyz = r6.www * r4.xyz;
	o.texcoord5.w = r6.w;
	o.texcoord2.y = globalScalars2.w * i.color.y;
	r0.yzw = float3(1, 0.01, 1E-05);
	r3.x = r0.w + globalScalars3.z;
	r3.y = r0.w + globalScalars4.z;
	r3.z = 1E-05;
	r4.xyz = normalize(r3.xyz);
	r0.x = dot(r4.xyz, r1.xyz);
	r0.x = max(r0.x, 0.25);
	r0.x = min(r0.x, 1);
	r0.w = AirResist.w * i.color1.z;
	r0.w = r0.w * 5;
	r3.z = -r0.w;
	r3.xy = -i.color1.xx;
	r1.xyz = r1.xyz * r3.xyz;
	r1.xyz = r0.xxx * r1.xyz;
	r3 = r2.xxz * float3(6, 10, 10);
	r0.x = AirResist.w * r0.z + r0.y;
	r0.y = globalScalars3.y * r0.x + r3.x;
	r0.z = r3.z + r3.y;
	r0.z = r2.y * 10 + r0.z;
	r0.x = r0.x * globalScalars3.y;
	r0.y = r0.y * 0.15915494 + 0.5;
	r0.y = frac(r0.y);
	r0.y = r0.y * 6.2831855 + -3.1415927;
	r3.y = sin(r0.y);
	r0.y = saturate(WindStr.x);
	r0.y = abs(r3.y) * r0.y;
	r0.z = r0.x * gWindParams.z + r0.z;
	r0.z = r0.z * 0.15915494 + 0.5;
	r0.z = frac(r0.z);
	r0.z = r0.z * 6.2831855 + -3.1415927;
	r3.y = sin(r0.z);
	r0.y = r0.y * abs(r3.y);
	r0.z = r2.y * 4;
	r0.x = r0.x * gWindParams.w + r0.z;
	r0.x = r0.x * 0.15915494 + 0.5;
	r0.x = frac(r0.x);
	r0.x = r0.x * 6.2831855 + -3.1415927;
	r3.y = sin(r0.x);
	r0.x = r0.y * abs(r3.y);
	r0.xyz = r1.xyz * r0.xxx + r2.xyz;
	r1 = r0.y * gWorldViewProj[1];
	r1 = r0.x * gWorldViewProj[0] + r1;
	r0 = r0.z * gWorldViewProj[2] + r1;
	r0 = r0 + gWorldViewProj[3];
	o.position = r0;
	o.texcoord1.w = r0.w;
	o.texcoord = i.texcoord.xy;
	o.texcoord2.xzw = i.color.xzw;

	return o;
}
