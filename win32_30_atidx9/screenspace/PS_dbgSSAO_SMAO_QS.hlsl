	r3.y = 0.5;
	r2.xyz = r0.zzz * r3.xyz;
	r3 = ddx(r2.yzx);
	r2.xyz = ddy(r2.xyz);
	r4.xyz = r2.xyz * r3.xyz;
	r2.xyz = r3.zxy * r2.yzx + -r4.xyz;
	r3 = normalize(r2.xyz);
	r2 = tex2D(gDeferredLightSampler0P, texcoord.xy);
	r0.z = dot(r2.yzw, float3(255, 1, 0.003921569));
	o.yz = r2.yz;
	r2.xy = -0.5 + texcoord.yx;
	r2.xz = r2.xy * gDeferredProjParams.yx;
	r2.y = 0.5;
	r4.xyz = r0.zzz * r2.xyz;
	r5.xyz = ddx(r4.yzx);
	r4.xyz = ddy(r4.xyz);
	r6 = r4.xyz * r5.xyz;
	r4.xyz = r5.zxy * r4.yzx + -r6.xyz;
	r0.w = dot(r4.xyz, r4.xyz);
	r0.w = rsqrt(r0.w);
	r3 = r4.xyz * r0.www + r3.xyz;
	r1.xyz = r1.xyz * r1.www + r3.xyz;
	r3 = normalize(r1.xyz);
	r0.w = 1 / r0.z;
	r1.xy = globalScreenSize.xy * texcoord.xy;
	r1.xy = r1.xy * 0.5;
	r1.x = dot(r1.xy, float2(9, 29.814)) + 0;
	r1.x = r1.x * 0.15915494 + 0.5;
	r1.x = frac(r1.x);
	r1.x = r1.x * 6.2831855 + -3.1415927;
	sincos(r1.x, r4.y, r4.x);
	r1.x = saturate(r0.w * g_fSSAOKernelScale.x);
	r1.x = r1.x * 37 + 3;
	r1.yz = globalScreenSize.zw + globalScreenSize.zw;
	r1.xy = r1.xx * r1.yz;
	r1.zw = r1.xy * r4.yx;
	r1.zw = r1.zw * 0.75 + texcoord.xy;
	r0.xy = r0.xy * 0.5;
	r1.zw = r1.zw * r0.xy;
	r4.zw = frac(r1.zw);
	r1.zw = r1.zw + -r4.zw;
	r4.zw = r1.zw + 0.5;
	r5.x = 1 / r0.x;
	r5.y = 1 / r0.y;
	r4.zw = r4.zw * r5.xy;
	r6.xy = lerp(-0.5, r1.zw, r5.xy);
	r6.xy = r6.xy * gDeferredProjParams.xy;
	r7 = tex2D(gDeferredLightSampler0P, r4.zw);
	r7.y = dot(r7.yzw, float3(255, 1, 0.003921569));
	r1.zw = r1.xy * -r4.yx;
	r4 = r4.xyxy * float4(1, -1, -1, 1);
	r1.zw = r1.zw * 0.25 + texcoord.xy;
	r1.zw = r0.xy * r1.zw;
	r5.zw = frac(r1.zw);
	r1.zw = r1.zw + -r5.zw;
	r5.zw = r1.zw + 0.5;
	r5.zw = r5.xy * r5.zw;
	r8.xy = lerp(-0.5, r1.zw, r5.xy);
	r8.xy = r8.xy * gDeferredProjParams.xy;
	r9 = tex2D(gDeferredLightSampler0P, r5.zw);
	r7.w = dot(r9.yzw, float3(255, 1, 0.003921569));
	r1.zw = r1.xy * r4.zw;
	r1.xy = r4.xy * r1.xy + texcoord.xy;
	r1.xy = r0.xy * r1.xy;
	r1.zw = r1.zw * 0.5 + texcoord.xy;
	r0.xy = r0.xy * r1.zw;
	r1.zw = frac(r0.xy);
	r0.xy = r0.xy + -r1.zw;
	r1.zw = r0.xy + 0.5;
	r1.zw = r5.xy * r1.zw;
	r4.xy = lerp(-0.5, r0.xy, r5.xy);
	r4.xy = r4.xy * gDeferredProjParams.xy;
	r9 = tex2D(gDeferredLightSampler0P, r1.zw);
	r7.z = dot(r9.yzw, float3(255, 1, 0.003921569));
	r0.xy = frac(r1.xy);
	r0.xy = -r0.xy + r1.xy;
	r1.xy = r0.xy + 0.5;
	r1.xy = r5.xy * r1.xy;
	r1.zw = lerp(-0.5, r0.xy, r5.xy);
	r5.xy = r1.zw * gDeferredProjParams.xy;
	r1 = tex2D(gDeferredLightSampler0P, r1.xy);
	r7.x = dot(r1.yzw, float3(255, 1, 0.003921569));
	r1 = r0.w * r7;
	r5.z = 0.5;
	r0.xyw = r5.xyz * r1.xxx + -r2.zxy;
	r1.x = dot(r0.xyw, r0.xyw);
	r1.x = rsqrt(r1.x);
	r0.xyw = r0.xyw * r1.xxx;
	r5.x = 1 / r1.x;
	r7.x = dot(r0.xyw, -r3.xyz);
	r6.z = 0.5;
	r0.xyw = r6.xyz * r1.yyy + -r2.zxy;
	r1.x = dot(r0.xyw, r0.xyw);
	r1.x = rsqrt(r1.x);
	r0.xyw = r0.xyw * r1.xxx;
	r5.y = 1 / r1.x;
	r7.y = dot(r0.xyw, -r3.xyz);
	r4.z = 0.5;
	r0.xyw = r4.xyz * r1.zzz + -r2.zxy;
	r1.x = dot(r0.xyw, r0.xyw);
	r1.x = rsqrt(r1.x);
	r0.xyw = r0.xyw * r1.xxx;
	r5.z = 1 / r1.x;
	r7.z = dot(r0.xyw, -r3.xyz);
	r8.z = 0.5;
	r0.xyw = r8.xyz * r1.www + -r2.zxy;
	r1.x = dot(r0.xyw, r0.xyw);
	r1.x = rsqrt(r1.x);
	r0.xyw = r0.xyw * r1.xxx;
	r5.w = 1 / r1.x;
	r7.w = dot(r0.xyw, -r3.xyz);
	r1 = -r7 + 1;
	r0 = r0.z * r5;
	r5 = saturate(r5);
	r0 = r0 + r0;
	r2 = saturate(max(r0, r1));
	r0.x = dot(r2, 0.25);
	r0.y = max(r5.z, r5.w);
	r1.x = max(r5.y, r0.y);
	r0.y = max(r5.x, r1.x);
	r0.y = r0.y * 0.5;
	r1.x = lerp(r0.x, 1, r0.y);
	r0.x = r1.x + 1E-05;
	r0.w = 1E-05;
	r0.y = r0.w + gDeferredLightColourAndIntensity.w;
	r1.x = pow(r0.x, r0.y);
	r0.x = r1.x * AmbientLightingParams.y;
	r0.yz = float2(0.15, 1);
	r0.y = saturate(AmbientLightingParams.x * -r0.y + r0.z);
	r1 = tex2D(gDeferredLightSampler1, texcoord.xy);
	r0.z = r1.y + 0.2;
	o.w = r1.x;
	r0.y = saturate(r0.y + r0.z);
	o.x = r0.y * r0.x;

	return o;
}
