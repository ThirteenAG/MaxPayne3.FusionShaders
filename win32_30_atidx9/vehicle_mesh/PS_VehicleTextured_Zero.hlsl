float specularFactor : register(c201);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
	float2 texcoord7 : TEXCOORD7;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	float3 r8;
	float3 r9;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.xy = r0.xy * 2 + -1;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.z, 0);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r2, specMapExpMask);
	r2.x = dot(r2.xyz, specMapIntMask.xyz);
	r2.x = r2.x * specularColorFactor.x;
	r3.xw = float2(1, 0);
	r2.y = r0.w * -specularFactor.x + r3.x;
	r4.xyz = r0.xxx * i.texcoord4.xyz;
	r4.xyz = r0.zzz * i.texcoord1.xyz + r4.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r4.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r4.xyz = normalize(r0.xyz);
	r0.xyz = r1.xyz * r1.xyz;
	r1.xyz = r0.xyz * matDiffuseColor.xyz;
	r1 = r1 * i.texcoord6;
	r0.x = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.z = globalScalars.z;
	r0.y = r0.z * gAmbientOcclusionEffect.y;
	r0.x = r0.y * r0.x;
	if (-dirtLevel.x < r3.w) {
		r5 = tex2D(DirtSampler, i.texcoord7.xy);
		r0.y = r5.x * dirtLevel.x;
		r3.x = r5.x * -dirtLevel.x + r3.x;
		r3.yzw = lerp(r1.xyz, dirtColor.xyz, r0.yyy);
		r6 = r1.xxyz * float4(0, 1, 1, 1) + float4(1, 0, 0, 0);
		r3 = (-r5.x >= 0) ? r6 : r3;
		r1.xyz = r3.yzw;
	} else {
		r3.x = 1;
	}
	r0.y = r2.x * r3.x;
	r2.xzw = 1E-05 + i.texcoord3.xyz;
	r3.xyz = normalize(r2.xzw);
	r0.z = saturate(r4.z * -0.5 + 0.5);
	r5.xyz = gLightAmbient0.xyz;
	r2.xzw = -r5.xyz + gLightAmbient1.xyz;
	r2.xzw = r0.zzz * r2.xzw + gLightAmbient0.xyz;
	r2.xzw = r0.xxx * r2.xzw;
	r0.x = 1 / gAmbientOcclusionEffect.y;
	r0.z = dot(-r3.xyz, r4.xyz);
	r0.z = r0.z + r0.z;
	r3.xyz = r4.xyz * -r0.zzz + -r3.xyz;
	r5.xyz = gDirectionalColour.www * gDirectionalColour.xyz;
	r0.z = dot(r4.xyz, -gDirectionalLight.xyz);
	r3.w = saturate(r0.z + -0.25);
	r3.w = r3.w * 1.3333334;
	r3.x = saturate(dot(-gDirectionalLight.xyz, r3.xyz));
	r3.x = r3.x + 1E-05;
	r4.x = 1E-05;
	r0.w = r0.w * specularFactor.x + r4.x;
	r0.w = (r2.y >= 0) ? 1.00001 : r0.w;
	r2.y = pow(r3.x, r0.w);
	r0.z = saturate(r0.z * 2 + -0.5);
	r0.z = r0.z * r2.y;
	r3.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r3.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r3.xyz;
	r3.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r3.xyz;
	r3.xyz = r3.xyz + gShadowMatrix[3].xyz;
	r4.xy = r3.xy + -gShadowParam18192021.zw;
	r6.xyz = r4.xxx + -gCascadeXMaxThresholds.xyz;
	r6.xyz = (r6.xyz >= 0) ? 1 : 0;
	r7 = -r4.xxx + gCascadeXMinThresholds.xyz;
	r7 = (r7.xyz >= 0) ? 1 : 0;
	r8 = r4.yyy + -gCascadeYMaxThresholds.xyz;
	r8 = (r8.xyz >= 0) ? 1 : 0;
	r9 = -r4.yyy + gCascadeYMinThresholds.xyz;
	r9 = (r9.xyz >= 0) ? 1 : 0;
	r6.xyz = r6.xyz + r7.xyz;
	r6.xyz = r8.xyz + r6.xyz;
	r6.yzw = saturate(r9.xyz + r6.xyz);
	r6.x = 1;
	r7.x = dot(r6, gShadowParam0123);
	r7.y = dot(r6, gShadowParam4567);
	r7.z = dot(r6, gCascadeZScales);
	r8.x = dot(r6, gShadowParam891113);
	r8.y = dot(r6, gShadowParam14151617);
	r8.z = dot(r6, gCascadeZOffsets);
	r3.xyz = r3.zxy * r7.zxy + r8.zxy;
	r3.x = saturate(r3.x);
	r6.x = abs(gCascadeXMinThresholds.w);
	r6.y = abs(gCascadeYMinThresholds.w);
	r7.x = abs(gCascadeXMaxThresholds.w);
	r7.y = abs(gCascadeYMaxThresholds.w);
	r4.zw = max(r6.xy, r7.xy);
	r6.xy = r4.zw + -0.25;
	r4.zw = r4.zw + -r6.xy;
	r4.xy = abs(r4.xy) + -r6.xy;
	r6.x = 1 / r4.z;
	r6.y = 1 / r4.w;
	r4.xy = saturate(r4.xy * r6.xy);
	r4.zw = r4.xy * -2 + 3;
	r4.xy = r4.xy * r4.xy;
	r4.xy = r4.xy * r4.zw;
	r0.w = max(r4.x, r4.y);
	r0.w = r6.w + r0.w;
	r2.y = -r3.x + 1;
	r4 = tex2D(gShadowZSamplerDir, r3.yz);
	r2.y = r2.y + -r4.x;
	r2.y = (r2.y >= 0) ? -1 : -0;
	r0.w = r0.w + r2.y;
	r0.w = saturate(r0.w + 1);
	r3.xyz = r0.www * r5.xyz;
	r4.xyz = r0.zzz * r3.xyz;
	r3.xyz = r3.www * r3.xyz;
	r4.xyz = r4.xyz * gDirectionalLight.www;
	r0.xzw = r2.xzw * r0.xxx + r3.xyz;
	r2.xyz = r0.yyy * r4.xyz;
	r0.xyz = r1.xyz * r0.xzw + r2.xyz;
	r1.w = r1.w * globalScalars.x;
	r0.w = 1 / globalScreenSize.y;
	r2.y = r0.w * i.vpos.y;
	r3.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r2.z = -r0.w + 1;
	r2.zw = r2.zz * gDepthFxParams.xy + r0.ww;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r4.xyz = lerp(r0.www, r0.xyz, r2.zzz);
	r0.x = r0.w + 1E-05;
	r0.x = abs(r0.x) + 1E-05;
	r0.y = r2.w + -0.99999;
	r2.z = pow(r0.x, r0.y);
	r0.x = r3.z * globalFogParams.x;
	r0.y = dot(r3.xyz, r3.xyz);
	r0.y = rsqrt(r0.y);
	r0.y = 1 / r0.y;
	r0.y = r0.y * globalFogParams.z;
	r0.z = -abs(r0.x) + 0.0001;
	r0.w = r0.x * -1.442695;
	r0.w = exp2(r0.w);
	r2.w = r0.w + -65504;
	r0.w = -r0.w + 1;
	r0.w = (r2.w >= 0) ? -65503 : r0.w;
	r0.x = 1 / r0.x;
	r0.x = r0.x * r0.w;
	r0.x = r0.x * r0.y;
	r0.x = (r0.z >= 0) ? r0.y : r0.x;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = saturate(exp2(r0.x));
	r1.xyz = globalFogColorN.xyz;
	r3.xyz = r4.xyz * r2.zzz + -r1.xyz;
	r3.w = 0;
	r0 = r0.x * r3 + r1;
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r1.y = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r3.xyz = lerp(r1.yyy, r0.xyz, r1.xxx);
	r1.x = r1.y * ColorShift.w;
	r4.xyz = r1.xxx * ColorShift.xyz;
	r1.z = saturate(r1.x);
	r5.xyz = ColorShift.xyz * -r1.xxx + r3.xyz;
	r1.xzw = r1.zzz * r5.xyz + r4.xyz;
	r4.xyz = ColorCorrectBottomOffset.xyz;
	r4.xyz = r2.yyy * r4.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r1.xzw * r4.xyz;
	r1.x = r1.y * ColorCorrectBottomOffset.w;
	r1.yzw = r1.xxx * globalScalars4.yzw;
	r2.z = saturate(r1.x);
	r3.xyz = globalScalars4.yzw * -r1.xxx + r3.xyz;
	r1.xyz = r2.zzz * r3.xyz + r1.yzw;
	r3 = ColorCorrectTopScreenEdge;
	r3.xyz = r2.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r3.xyz;
	r1.xyz = r1.xyz * r3.xyz;
	r2.z = 1 / globalScreenSize.x;
	r2.x = r2.z * i.vpos.x;
	r2.xy = r2.xy + -0.5;
	r2.x = dot(r2.xy, r2.xy) + 0;
	r2.x = rsqrt(r2.x);
	r2.x = 1 / r2.x;
	r2.y = r3.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r2.y = (r2.y >= 0) ? -r2.y : -0;
	r2.x = r2.y + r2.x;
	r2.y = r2.y + ColorCorrectTopScreenEdge.w;
	r2.y = 1 / r2.y;
	r2.y = saturate(r2.y * r2.x);
	r2.x = (r2.x >= 0) ? r2.y : 0;
	r1.w = r0.w;
	r3 = lerp(r0, r1, r2.x);
	o = (ColorCorrectTopScreenEdge.w >= 0) ? r3 : r0;

	return o;
}
