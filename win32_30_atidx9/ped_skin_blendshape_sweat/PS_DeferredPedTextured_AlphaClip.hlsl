sampler2D BloodSampler : register(s2);
sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
float4 SkinParams : register(c218);
sampler2D SpecSampler : register(s5);
float4 SubColor : register(c196);
float SubScatWidth : register(c198);
float SubScatWrap : register(c197);
sampler2D SweatMapSampler : register(s7);
sampler3D VolumeSampler : register(s6);
float bumpiness : register(c203);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c211);
float fresnelRolloff : register(c202);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gBloodData : register(c210);
float4 gDirectionalLight : register(c19);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c209);
float reflectivePower : register(c200);
float4 specMapExpMask : register(c207);
float3 specMapIntMask : register(c206);
float3 specMapReflectMask : register(c201);
float specularFactor : register(c205);
float4 vNoiseParams : register(c217);
float4 vSkinSweat : register(c219);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color2 : COLOR2;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float3 r8;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.z, 0);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r2, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r2.w = dot(r2.xyz, specMapIntMask.xyz);
	r3.x = max(1, r0.w);
	r3.yzw = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r3.yzw;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r3.yzw = r0.www * r0.xyz;
	r4.xyw = float3(1, 2, 0);
	if (-reflectivePower.x < r4.w) {
		r4.z = saturate(r3.x * 0.015625);
		r5.w = r4.z * -4 + 4;
		r6.xyz = 1E-05 + i.texcoord3.xyz;
		r7.xyz = normalize(r6.xyz);
		r4.z = dot(-r7.xyz, r3.yzw);
		r4.z = r4.z + r4.z;
		r6.xyz = r3.yzw * -r4.zzz + -r7.xyz;
		r6.xyz = r6.xyz + 1E-05;
		r8 = normalize(r6.xyz);
		r4.z = saturate(r8.z);
		r4.z = r4.z + 1;
		r4.z = r4.z + r4.z;
		r4.z = 1 / r4.z;
		r6.xy = r8.xy * r4.zz + 0.5;
		r5.xy = -r6.xy + 1;
		r5.z = 0;
		r5 = tex2Dlod(DynamicEnvironmentSampler, r5);
		r5.xyz = r5.xyz * r5.xyz;
		r5.xyz = r5.xyz * 16;
		r3.y = saturate(dot(r7.xyz, r3.yzw));
		r3.z = r4.x + -fresnelRolloff.x;
		r3.y = -r3.y + 1.00001;
		r4.z = pow(r3.y, 5.00001);
		r3.y = fresnelRolloff.x * r4.z + r3.z;
		r3.yzw = r3.yyy * r5.xyz;
	} else {
		r3.yzw = 0;
	}
	r3.yzw = r3.yzw * reflectivePower.xxx;
	r2.x = dot(r2.xyz, specMapReflectMask.xyz);
	r3.yzw = r2.xxx * r3.yzw;
	r3.yzw = r3.yzw * ColorCorrectTopAndPedReflectScale.www;
	if (-gBloodData.w < r4.w) {
		r5 = tex2D(BloodSampler, i.texcoord.zw);
		r6.z = min(r5.y, r5.x);
		r2.x = saturate(r5.x * 0.5 + r5.w);
		r6.xy = r5.xy;
		r2.y = -r1.x + r6.x;
		r2.y = r2.y * r2.x;
		r5.xyz = lerp(r1.xyz, r6.xyz, r2.xxx);
		r2.x = dot(r5.xyz, float3(0.2125, 0.7154, 0.0721));
		r6.xyz = lerp(r2.xxx, r5.xyz, gAdrenoFXVars.yyy);
		r2.x = saturate(r2.y * gAmbientOcclusionEffect.z);
		r1.xyz = lerp(r5.xyz, r6.xyz, r2.xxx);
	}
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r5.xyz = r0.www * r0.xyz;
	r2.x = dot(gDirectionalLight.xyz, r5.xyz);
	r2.x = r2.x + SubScatWrap.x;
	r2.y = r4.x + SubScatWrap.x;
	r2.y = 1 / r2.y;
	r2.x = r2.y * r2.x;
	r4.z = max(r2.x, 0);
	r2.x = 1 / SubScatWidth.x;
	r2.x = saturate(r2.x * r4.z);
	r2.y = r2.x * -2 + 3;
	r2.x = r2.x * r2.x;
	r2.x = r2.x * r2.y;
	r2.y = SubScatWidth.x * -r4.y + r4.z;
	r4.y = 1 / -SubScatWidth.x;
	r2.y = saturate(r2.y * r4.y);
	r4.y = r2.y * -2 + 3;
	r2.y = r2.y * r2.y;
	r2.y = r2.y * r4.y;
	r2.x = r2.y * r2.x;
	r4.yzw = r2.xxx * SubColor.xyz;
	r4.yzw = r1.www * r4.yzw;
	r1.xyz = r4.yzw * 0.5 + r1.xyz;
	r1.xyz = r1.xyz * matMaterialColorScale.xxx;
	r3.yzw = r3.yzw * matMaterialColorScale.zzz;
	r1.w = r2.w * matMaterialColorScale.w;
	r2.x = r3.x * matMaterialColorScale.w;
	r4.yzw = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r4.yzw = r4.yzw + 1E-05;
	r6.xyz = normalize(r4.yzw);
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r7.xyz = normalize(r0.xyz);
	r0.x = dot(r6.xyz, r7.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.z = saturate(r1.w * 5);
	r0.y = r0.z * r0.y;
	r0.z = saturate(r2.x * -0.01 + 1);
	r0.y = r0.y * r0.z;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r2.w * matMaterialColorScale.w + r0.x;
	r0.y = r2.z * 16;
	r0.z = frac(r0.y);
	r0.y = r0.y + -r0.z;
	r0.z = (-r0.z >= 0) ? 0 : 1;
	r0.z = (r2.z >= 0) ? 0 : r0.z;
	r0.y = r0.z + r0.y;
	r6.xy = detailSettings.zw * i.texcoord.xy;
	r0.y = r0.y + 0.5;
	r6.z = r0.y * 0.0625;
	r6 = tex3D(VolumeSampler, r6.xyz);
	r0.yzw = r6.yzx * 2 + -1;
	r1.w = detailSettings.x * i.texcoord2.w;
	r0.w = r0.w * r1.w + 1;
	r2.yzw = r0.www * r1.xyz;
	r4.yzw = r0.zzz * i.texcoord5.xyz;
	r4.yzw = i.texcoord4.xyz * r0.yyy + r4.yzw;
	r4.yzw = r4.yzw * detailSettings.yyy;
	r4.yzw = r4.yzw * i.texcoord2.www + r5.xyz;
	r4.yzw = r4.yzw + 1E-05;
	r5.xyz = normalize(r4.yzw);
	r0.x = saturate(r0.w * r0.x);
	r3.x = vSkinSweat.x;
	r0.x = SkinParams.x * r3.x + r0.x;
	r6.y = SkinParams.y * r3.x + r2.x;
	r0.yz = r3.xx * vNoiseParams.zw;
	r0.y = r0.w * r0.y + r0.z;
	r6.x = r0.y + r0.x;
	r7 = tex2D(SweatMapSampler, i.texcoord.xy);
	r0.x = -r7.z + vSkinSweat.y;
	r0.yz = r7.zz + -vSkinSweat.zy;
	r1.w = 1 / vSkinSweat.w;
	r0.z = saturate(r0.z * r1.w);
	r4.yz = lerp(r6.xy, vNoiseParams.xy, r0.zz);
	r6.zw = r7.xy + -0.5;
	r6.zw = r6.zw * SkinParams.zz;
	r6.zw = r6.zw + r6.zw;
	r1.w = dot(r6.zw, -r6.zw) + 1;
	r2.x = max(r1.w, 0);
	r1.w = rsqrt(r2.x);
	r1.w = 1 / r1.w;
	r7.xyz = r6.zzz * i.texcoord4.xyz;
	r7.xyz = i.texcoord1.xyz * r1.www + r7.xyz;
	r7.xyz = r6.www * i.texcoord5.xyz + r7.xyz;
	r7.xyz = r7.xyz + 1E-05;
	r1.w = dot(r7.xyz, r7.xyz);
	r1.w = rsqrt(r1.w);
	r7.xyz = r7.xyz * r1.www + -r5.xyz;
	r7.xyz = r0.zzz * r7.xyz + r5.xyz;
	r7.xyz = r7.xyz + 1E-05;
	r8 = normalize(r7.xyz);
	r0.y = (r0.y >= 0) ? -0 : -1;
	r0.x = (r0.x >= 0) ? -0 : r0.y;
	r5.xyz = (r0.xxx >= 0) ? r5.xyz : r8.xyz;
	r0.xy = (r0.xx >= 0) ? r6.xy : r4.yz;
	r0.z = dot(r2.yzw, float3(0.2125, 0.7154, 0.0721));
	r4.z = 0.1;
	r1.w = saturate(r4.z + deSatContrastGamma.x);
	r1.w = 1 / r1.w;
	r1.w = r1.w * gAdrenoFXVars.z;
	r1.xyz = r1.xyz * r0.www + -r0.zzz;
	r1.xyz = r1.www * r1.xyz + r0.zzz;
	r4.xyz = saturate(r4.xxx + -ColorCorrectTopAndPedReflectScale.xyz);
	r4.xyz = r4.xyz * 0.25 + 1;
	r0.z = saturate(gAmbientOcclusionEffect.z);
	r1.xyz = r1.xyz * r4.xyz + -r2.yzw;
	o.color.xyz = r0.zzz * r1.xyz + r2.yzw;
	o.color2.z = saturate(r0.z + i.texcoord2.x);
	o.color1.xyz = r5.xyz * 0.5 + 0.5;
	r0.y = saturate(r0.y * 0.015625);
	r0.y = rsqrt(r0.y);
	o.color2.y = 1 / r0.y;
	r0.y = globalScalars.x * i.texcoord2.w;
	r1.xyz = saturate(r3.yzw * 0.0625);
	r0.z = rsqrt(r1.x);
	r0.w = rsqrt(r1.y);
	r1.x = rsqrt(r1.z);
	o.color3.x = 1 / r0.z;
	o.color3.y = 1 / r0.w;
	o.color3.z = 1 / r1.x;
	o.color.w = r0.y;
	o.color1.w = r0.y;
	o.color2.xw = r0.xy;
	o.color3.w = gStencil.x;

	return o;
}
