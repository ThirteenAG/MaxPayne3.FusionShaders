float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectBottomOffsetScreenEdge : register(c67);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorCorrectTopScreenEdge : register(c66);
float4 ColorShift : register(c45);
sampler2D DiffuseTexSampler : register(s0);
float HybridAdd : register(c197);
sampler2D NormalMapTexSampler : register(s1);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float gAmbientShadow : register(c213);
float4 gBloodLightingTuners : register(c96);
float gDiffuse : register(c204);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightAmbientDir0 : register(c72);
float4 gLightAmbientDir1 : register(c73);
float gLightIntensityClamp : register(c214);
float gNormalArc : register(c210);
float gSpecularExponent : register(c206);
float gSpecularIntensity : register(c205);
float gSuperAlpha : register(c209);
float gWrapBias : register(c203);
float gWrapScale : register(c202);
float4 globalScalars4 : register(c51);
float4 globalScreenSize : register(c41);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float2 vpos : VPOS;
	float4 texcoord2 : TEXCOORD2;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0 = tex2D(NormalMapTexSampler, i.texcoord1.xy);
	r0.xyz = r0.xyz * 2 + -1;
	r1 = tex2D(NormalMapTexSampler, i.texcoord1.zw);
	r1.xyz = r1.xyz * 2 + -1;
	r0.w = saturate(i.texcoord3.x);
	r2.xyz = lerp(r0.xyz, r1.xyz, r0.www);
	r2.w = -r2.y;
	r0.xyz = r2.xwz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0.x = r1.z * -2;
	r0.xyz = r1.xyz * -r0.xxx + float3(0, 0, -1);
	r0.x = saturate(dot(r0.xyz, -gDirectionalLight.xyz));
	r0.x = r0.x + 1E-05;
	r0.z = 1E-05;
	r0.y = r0.z + gSpecularExponent.x;
	r1.w = pow(r0.x, r0.y);
	r0.x = gWrapScale.x;
	r0.y = r1.w * r0.x + gWrapBias.x;
	r0.y = r0.y * gDirectionalColour.x;
	r0.y = r0.y * gDirectionalColour.w;
	r0.y = r0.y * gSpecularIntensity.x;
	r1.w = max(r0.y, 0);
	r0.y = dot(r1.xyz, -gDirectionalLight.xyz);
	r2.x = max(r0.y, -gLightIntensityClamp.x);
	r0.y = min(gLightIntensityClamp.x, r2.x);
	r0.z = -r0.y + 1;
	r0.y = gNormalArc.x * r0.z + r0.y;
	r0.x = r0.y * r0.x + gWrapBias.x;
	r0.x = r0.x * gDirectionalColour.x;
	r0.x = r0.x * gDirectionalColour.w;
	r0.x = r0.x * gDiffuse.x;
	r2.x = max(r0.x, gBloodLightingTuners.x);
	r0.x = min(gBloodLightingTuners.y, r2.x);
	r0.xyz = r0.xxx * i.texcoord.xyz;
	r2.xyz = max(r0.xyz, 0);
	r0.xyz = r1.www + r2.xyz;
	r1.w = dot(gLightAmbientDir0.xyz, r1.xyz);
	r1.x = dot(gLightAmbientDir1.xyz, r1.xyz);
	r1.xw = r1.xw + gLightAmbientDir0.ww;
	r1.xw = saturate(r1.xw * gLightAmbientDir1.ww);
	r1.xyz = r1.xxx * gLightAmbient1.xyz;
	r1.xyz = r1.xyz * gBloodLightingTuners.zzz;
	r2.xyz = r1.www * gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gBloodLightingTuners.zzz;
	r1.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r1.www * r1.xyz;
	r1.xyz = r2.xyz * r1.www + r1.xyz;
	r1.xyz = r1.xyz * i.texcoord.xyz;
	r2.xyz = r1.xyz * gAmbientShadow.xxx;
	r1.xyz = (r1.xyz >= 0) ? r2.xyz : 0;
	r1.xyz = r0.xyz + r1.xyz;
	r2 = tex2D(DiffuseTexSampler, i.texcoord1.xy);
	r3 = tex2D(DiffuseTexSampler, i.texcoord1.zw);
	r4 = lerp(r2, r3, r0.w);
	r1.w = saturate(gSuperAlpha.x * i.texcoord.w);
	r0 = r1 * r4;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = saturate(r0.w);
	r1.xyz = r1.xyz * r4.xyz + -r1.www;
	r1.xyz = i.texcoord2.zzz * r1.xyz + r1.www;
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r2.x = -0.99999 + i.texcoord2.w;
	r3.x = pow(r1.w, r2.x);
	r2.xyz = r1.xyz * r3.xxx;
	r1.xyz = r1.xyz * -r3.xxx + i.texcoord4.xyz;
	r1.xyz = i.texcoord4.www * r1.xyz + r2.xyz;
	r1.w = dot(r1.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r2.x = r2.x * deSatContrastGamma.x;
	r3.xyz = lerp(r1.www, r1.xyz, r2.xxx);
	r1.x = r1.w * ColorCorrectBottomOffset.w;
	r1.y = r1.w * ColorShift.w;
	r2.xyz = globalScalars4.yzw * -r1.xxx + r3.xyz;
	r3.xyz = ColorShift.xyz * -r1.yyy + r3.xyz;
	r4.xyz = r1.xxx * globalScalars4.yzw;
	r1.x = saturate(r1.x);
	r1.xzw = r1.xxx * r2.xyz + r4.xyz;
	r2.x = 1 / globalScreenSize.y;
	r2.y = r2.x * i.vpos.y;
	r4 = ColorCorrectTopScreenEdge;
	r4.xyz = r2.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r4.xyz;
	r5.xyz = r1.xzw * r4.xyz;
	r1.xzw = r1.yyy * ColorShift.xyz;
	r1.y = saturate(r1.y);
	r1.xyz = r1.yyy * r3.xyz + r1.xzw;
	r3.xyz = ColorCorrectBottomOffset.xyz;
	r3.xyz = r2.yyy * r3.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r1.xyz * r3.xyz;
	r5.w = r0.w;
	r1.x = 1 / globalScreenSize.x;
	r2.x = r1.x * i.vpos.x;
	r1.xy = r2.xy + -0.5;
	r1.x = dot(r1.xy, r1.xy) + 0;
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.y = r4.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r1.y = (r1.y >= 0) ? -r1.y : -0;
	r1.x = r1.y + r1.x;
	r1.y = r1.y + ColorCorrectTopScreenEdge.w;
	r1.y = 1 / r1.y;
	r1.y = saturate(r1.y * r1.x);
	r1.x = (r1.x >= 0) ? r1.y : 0;
	r2 = lerp(r0, r5, r1.x);
	r0 = (ColorCorrectTopScreenEdge.w >= 0) ? r2 : r0;
	r1.xyz = r0.www * r0.xyz;
	r1.w = r0.w;
	r2.x = abs(HybridAdd.x);
	r0 = (-r2.x >= 0) ? r0 : r1;
	r1 = max(r0, 0);
	o = min(r1, 32);

	return o;
}
