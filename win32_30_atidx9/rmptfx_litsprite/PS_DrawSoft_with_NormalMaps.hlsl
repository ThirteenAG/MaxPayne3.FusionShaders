float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectBottomOffsetScreenEdge : register(c67);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorCorrectTopScreenEdge : register(c66);
float4 ColorShift : register(c45);
sampler2D DepthMapTexSampler : register(s12);
sampler2D DiffuseTexSampler : register(s0);
float HybridAdd : register(c197);
sampler2D NormalMapTexSampler : register(s1);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float gAmbientAmount : register(c208);
float4 gAmbientOcclusionEffect : register(c63);
float gAmbientShadow : register(c213);
float gDiffuse : register(c204);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gInvScreenSize : register(c129);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float gLightIntensityClamp : register(c214);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float gNormalArc : register(c210);
float gSoftness : register(c196);
float gSpecularExponent : register(c206);
float gSpecularIntensity : register(c205);
float gSuperAlpha : register(c209);
row_major float4x4 gWorldView : register(c4);
float gWrapBias : register(c203);
float gWrapScale : register(c202);
float4 globalScalars4 : register(c51);
float4 globalScreenSize : register(c41);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord7 : TEXCOORD7;
	float4 texcoord1 : TEXCOORD1;
	float2 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float2 vpos : VPOS;
	float4 texcoord2 : TEXCOORD2;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0 = gLightPosX + -i.texcoord7.x;
	r1 = r0 * r0;
	r2 = gLightPosY + -i.texcoord7.y;
	r1 = r2 * r2 + r1;
	r3 = gLightPosZ + -i.texcoord7.z;
	r1 = r3 * r3 + r1;
	r4.zw = float2(1E-05, 1);
	r5 = saturate(r1 * -gLightFallOff + r4.w);
	r1 = r1 + 1E-05;
	r5 = r5 * r5;
	r5 = r5 * r5 + -0.1;
	r6 = r5 * 1.1111112;
	r5 = (r5 >= 0) ? r6 : 0;
	r6.x = rsqrt(r1.x);
	r6.y = rsqrt(r1.y);
	r6.z = rsqrt(r1.z);
	r6.w = rsqrt(r1.w);
	r1 = r2 * r6;
	r0 = r0 * r6;
	r2 = r3 * r6;
	r3 = tex2D(NormalMapTexSampler, i.texcoord1.xy);
	r3.xyz = r3.xyz * 2 + -1;
	r6 = tex2D(NormalMapTexSampler, i.texcoord1.zw);
	r4.xyw = r6.xyz * 2 + -1;
	r3.w = saturate(i.texcoord3.x);
	r6.xyz = lerp(r3.xyz, r4.xyw, r3.www);
	r6.w = -r6.y;
	r3.xyz = r6.xwz + 1E-05;
	r6.xyz = normalize(r3.xyz);
	r7 = r0 * r6.x;
	r7 = r1 * r6.y + r7;
	r7 = r2 * r6.z + r7;
	r8 = -r7 + 1;
	r7 = gNormalArc.x * r8 + r7;
	r5 = saturate(r5 * r7);
	r7 = r0 * -gLightDirX;
	r7 = r1 * -gLightDirY + r7;
	r7 = r2 * -gLightDirZ + r7;
	r8 = gLightConeScale;
	r7 = saturate(r7 * r8 + gLightConeOffset);
	r5 = r5 * r7;
	r3.x = r6.z * -2;
	r3.xyz = r6.xyz * -r3.xxx + float3(0, 0, -1);
	r0 = r0 * r3.x;
	r0 = r3.y * r1 + r0;
	r0 = saturate(r3.z * r2 + r0);
	r1.x = saturate(dot(r3.xyz, -gDirectionalLight.xyz));
	r1.x = r1.x + 1E-05;
	r0 = r0 + 1E-05;
	r2.x = log2(r0.x);
	r2.y = log2(r0.y);
	r2.z = log2(r0.z);
	r2.w = log2(r0.w);
	r0.x = r4.z + gSpecularExponent.x;
	r2 = r2 * r0.x;
	r3.x = pow(r1.x, r0.x);
	r0.x = gWrapScale.x;
	r0.y = r3.x * r0.x + gWrapBias.x;
	r0.y = r0.y * gDirectionalColour.x;
	r0.y = r0.y * gDirectionalColour.w;
	r0.y = r0.y * gSpecularIntensity.x;
	r1.x = max(r0.y, 0);
	r4.x = exp2(r2.x);
	r4.y = exp2(r2.y);
	r4.z = exp2(r2.z);
	r4.w = exp2(r2.w);
	r2 = r5 * r4;
	r3.x = dot(gLightColR, r2);
	r3.y = dot(gLightColG, r2);
	r3.z = dot(gLightColB, r2);
	r0.yzw = r3.xyz * gSpecularIntensity.xxx;
	r1.yzw = max(r0.yzw, 0);
	r2.x = dot(gLightColR, r5);
	r2.y = dot(gLightColG, r5);
	r2.z = dot(gLightColB, r5);
	r0.yzw = r2.xyz * i.texcoord.xyz;
	r2.xyz = max(r0.yzw, 0);
	r0.yzw = r1.yzw + r2.xyz;
	r1.y = dot(r6.xyz, -gDirectionalLight.xyz);
	r1.z = dot(r6.xyz, gWorldView[2].xyz);
	r1.z = saturate(r1.z * -0.5 + 0.5);
	r2.x = max(r1.y, -gLightIntensityClamp.x);
	r1.y = min(gLightIntensityClamp.x, r2.x);
	r1.w = -r1.y + 1;
	r1.y = gNormalArc.x * r1.w + r1.y;
	r0.x = r1.y * r0.x + gWrapBias.x;
	r0.x = r0.x * gDirectionalColour.x;
	r0.x = r0.x * gDirectionalColour.w;
	r0.x = r0.x * gDiffuse.x;
	r2.xyz = r0.xxx * i.texcoord.xyz;
	r3.xyz = max(r2.xyz, 0);
	r1.xyw = r1.xxx + r3.xyz;
	r0.xyz = r0.yzw + r1.xyw;
	r2.xyz = gLightAmbient0.xyz;
	r1.xyw = -r2.xyz + gLightAmbient1.xyz;
	r1.xyz = r1.zzz * r1.xyw + gLightAmbient0.xyz;
	r1.xyz = r1.xyz * gAmbientAmount.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = r1.xyz * i.texcoord.xyz;
	r2.xyz = r1.xyz * gAmbientShadow.xxx;
	r1.xyz = (r1.xyz >= 0) ? r2.xyz : 0;
	r0.xyz = r0.xyz + r1.xyz;
	r1.xy = i.vpos.xy * gInvScreenSize.xy + gInvScreenSize.zw;
	r1 = tex2D(DepthMapTexSampler, r1.xy);
	r1.x = r1.x + -i.texcoord3.y;
	r1.x = r1.x * r1.x;
	r1.x = saturate(r1.x * gSoftness.x);
	r1.y = saturate(gSuperAlpha.x * i.texcoord.w);
	r0.w = r1.x * r1.y;
	r1 = tex2D(DiffuseTexSampler, i.texcoord1.xy);
	r2 = tex2D(DiffuseTexSampler, i.texcoord1.zw);
	r4 = lerp(r1, r2, r3.w);
	r1 = r0 * r4;
	r0.w = dot(r1.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = saturate(r1.w);
	r0.xyz = r0.xyz * r4.xyz + -r0.www;
	r0.xyz = i.texcoord2.zzz * r0.xyz + r0.www;
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r2.x = -0.99999 + i.texcoord2.w;
	r3.x = pow(r0.w, r2.x);
	r2.xyz = r0.xyz * r3.xxx;
	r0.xyz = r0.xyz * -r3.xxx + i.texcoord4.xyz;
	r0.xyz = i.texcoord4.www * r0.xyz + r2.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r2.x = r2.x * deSatContrastGamma.x;
	r3.xyz = lerp(r0.www, r0.xyz, r2.xxx);
	r0.x = r0.w * ColorCorrectBottomOffset.w;
	r0.y = r0.w * ColorShift.w;
	r2.xyz = globalScalars4.yzw * -r0.xxx + r3.xyz;
	r3.xyz = ColorShift.xyz * -r0.yyy + r3.xyz;
	r4.xyz = r0.xxx * globalScalars4.yzw;
	r0.x = saturate(r0.x);
	r0.xzw = r0.xxx * r2.xyz + r4.xyz;
	r2.x = 1 / globalScreenSize.y;
	r2.y = r2.x * i.vpos.y;
	r4 = ColorCorrectTopScreenEdge;
	r4.xyz = r2.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r4.xyz;
	r5.xyz = r0.xzw * r4.xyz;
	r0.xzw = r0.yyy * ColorShift.xyz;
	r0.y = saturate(r0.y);
	r0.xyz = r0.yyy * r3.xyz + r0.xzw;
	r3.xyz = ColorCorrectBottomOffset.xyz;
	r3.xyz = r2.yyy * r3.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r1.xyz = r0.xyz * r3.xyz;
	r5.w = r1.w;
	r0.x = 1 / globalScreenSize.x;
	r2.x = r0.x * i.vpos.x;
	r0.xy = r2.xy + -0.5;
	r0.x = dot(r0.xy, r0.xy) + 0;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.y = r4.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r0.y = (r0.y >= 0) ? -r0.y : -0;
	r0.x = r0.y + r0.x;
	r0.y = r0.y + ColorCorrectTopScreenEdge.w;
	r0.y = 1 / r0.y;
	r0.y = saturate(r0.y * r0.x);
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r2 = lerp(r1, r5, r0.x);
	r0 = (ColorCorrectTopScreenEdge.w >= 0) ? r2 : r1;
	r1.xyz = r0.www * r0.xyz;
	r1.w = r0.w;
	r2.x = abs(HybridAdd.x);
	r0 = (-r2.x >= 0) ? r0 : r1;
	r1 = max(r0, 0);
	o = min(r1, 32);

	return o;
}
