sampler2D BumpSampler_layer0 : register(s1);
sampler2D BumpSampler_layer1 : register(s4);
sampler2D BumpSampler_layer2 : register(s6);
sampler2D BumpSampler_layer3 : register(s9);
float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectBottomOffsetScreenEdge : register(c67);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorCorrectTopScreenEdge : register(c66);
float4 ColorShift : register(c45);
sampler2D SpecSampler_layer01 : register(s2);
sampler2D SpecSampler_layer23 : register(s7);
sampler2D TextureSampler_layer0 : register(s0);
sampler2D TextureSampler_layer1 : register(s3);
sampler2D TextureSampler_layer2 : register(s5);
sampler2D TextureSampler_layer3 : register(s8);
float bumpiness : register(c8);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightAmbientDir0 : register(c72);
float4 gLightAmbientDir1 : register(c73);
float4 globalFogColor : register(c38);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 globalScalars4 : register(c51);
float4 globalScreenSize : register(c41);
float specularColorFactor : register(c1);
float specularColorFactor1 : register(c3);
float specularColorFactor2 : register(c5);
float specularColorFactor3 : register(c7);
float specularFactor : register(c0);
float specularFactor1 : register(c2);
float specularFactor2 : register(c4);
float specularFactor3 : register(c6);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 color : COLOR;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float2 vpos : VPOS;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color1 : COLOR1;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0 = float4(-512, 1E-05, 1E-05, 1E-05) + i.texcoord4.zxyz;
	r1 = r0.x;
	r2.xyz = normalize(r0.yzw);
	clip(r1);
	r0 = tex2D(BumpSampler_layer3, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(BumpSampler_layer2, i.texcoord.xy);
	r0.z = -r1.w + 1;
	r0.z = -r1.x + r0.z;
	r0.zw = (r0.zz >= 0) ? r1.wy : r1.xy;
	r1 = tex2D(BumpSampler_layer0, i.texcoord.xy);
	r1.z = -r1.w + 1;
	r1.z = -r1.x + r1.z;
	r1.xy = (r1.zz >= 0) ? r1.wy : r1.xy;
	r3 = tex2D(BumpSampler_layer1, i.texcoord.xy);
	r1.z = -r3.w + 1;
	r1.z = -r3.x + r1.z;
	r1.zw = (r1.zz >= 0) ? r3.wy : r3.xy;
	r3.xyz = 1 + -i.color.xyz;
	r2.w = r3.y * r3.x;
	r3.y = r2.w * i.color.z;
	r2.w = r3.z * r2.w;
	r1.zw = r1.zw * r3.yy;
	r1.xy = r1.xy * r2.ww + r1.zw;
	r1.z = r3.x * i.color.y;
	r1.w = r3.z * r1.z;
	r1.z = r1.z * i.color.z;
	r0.zw = r0.zw * r1.ww + r1.xy;
	r0.xy = r0.xy * r1.zz + r0.zw;
	r0.xy = r0.xy + -0.5;
	r0.xy = r0.xy * bumpiness.xx;
	r0.xy = r0.xy + r0.xy;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r1.x = max(r0.z, 0);
	r0.z = rsqrt(r1.x);
	r0.z = 1 / r0.z;
	r3.xzw = r0.xxx * i.texcoord5.xyz;
	r0.xzw = i.texcoord2.xyz * r0.zzz + r3.xzw;
	r0.xyz = r0.yyy * i.texcoord6.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r4.xyz = normalize(r0.xyz);
	r0.x = dot(r2.xyz, r4.xyz);
	r0.x = r0.x + r0.x;
	r0.xyz = r4.xyz * -r0.xxx + r2.xyz;
	r0.x = saturate(dot(-gDirectionalLight.xyz, r0.xyz));
	r0.x = r0.x + 1E-05;
	r5 = tex2D(SpecSampler_layer01, i.texcoord.xy);
	r1.x = r5.z * specularFactor1.x;
	r1.y = r5.w * specularColorFactor1.x;
	r0.yz = r3.yy * r1.xy;
	r1.x = r5.x * specularFactor.x;
	r1.y = r5.y * specularColorFactor.x;
	r0.yz = r1.xy * r2.ww + r0.yz;
	r5 = tex2D(SpecSampler_layer23, i.texcoord.xy);
	r1.x = r5.x * specularFactor2.x;
	r1.y = r5.y * specularColorFactor2.x;
	r0.yz = r1.xy * r1.ww + r0.yz;
	r1.x = r5.z * specularFactor3.x;
	r1.y = r5.w * specularColorFactor3.x;
	r0.yz = r1.xy * r1.zz + r0.yz;
	r0.y = r0.y + 1E-05;
	r1.x = pow(r0.x, r0.y);
	r0.xyw = gDirectionalColour.www * gDirectionalColour.xyz;
	r2.xyz = r1.xxx * r0.xyw;
	r2.xyz = r2.xyz * gDirectionalLight.www;
	r2.xyz = r0.zzz * r2.xyz;
	r0.z = dot(gLightAmbientDir0.xyz, r4.xyz);
	r0.z = r0.z + gLightAmbientDir0.w;
	r0.z = saturate(r0.z * gLightAmbientDir1.w);
	r3.xzw = r0.zzz * gLightAmbient0.xyz;
	r3.xzw = r3.xzw * i.texcoord3.xxx;
	r0.z = dot(gLightAmbientDir1.xyz, r4.xyz);
	r1.x = dot(r4.xyz, -gDirectionalLight.xyz);
	r1.x = r1.x + -0.25;
	r1.x = saturate(r1.x * 1.3333334);
	r0.z = r0.z + gLightAmbientDir0.w;
	r0.z = saturate(r0.z * gLightAmbientDir1.w);
	r4.xyz = r0.zzz * gLightAmbient1.xyz;
	r4.xyz = r4.xyz * i.texcoord3.xxx;
	r0.z = 1 / gAmbientOcclusionEffect.y;
	r4.xyz = r0.zzz * r4.xyz;
	r3.xzw = r3.xzw * r0.zzz + r4.xyz;
	r0.xyz = r0.xyw * r1.xxx + r3.xzw;
	r4 = i.texcoord.xyxx * float4(1, 1, 0, 0) + float4(0, 0, 0, -1.3);
	r5 = tex2Dbias(TextureSampler_layer1, r4);
	r3.xyz = r3.yyy * r5.xyz;
	r5 = tex2Dbias(TextureSampler_layer0, r4);
	r3.xyz = r5.xyz * r2.www + r3.xyz;
	r5 = tex2Dbias(TextureSampler_layer2, r4);
	r4 = tex2Dbias(TextureSampler_layer3, r4);
	r1.xyw = r5.xyz * r1.www + r3.xyz;
	r1.xyz = r4.xyz * r1.zzz + r1.xyw;
	r0.xyz = r1.xyz * r0.xyz + r2.xyz;
	r0.w = -globalFogParams.x + globalFogParams.y;
	r0.w = 1 / r0.w;
	r1.x = -globalFogParams.x + i.texcoord2.w;
	r0.w = saturate(r0.w * r1.x);
	r1.xyz = lerp(r0.xyz, globalFogColor.xyz, r0.www);
	r0.x = dot(r1.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r0.y = r2.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.xxx, r1.xyz, r0.yyy);
	r0.y = r0.x * ColorCorrectBottomOffset.w;
	r0.x = r0.x * ColorShift.w;
	r1.xyz = globalScalars4.yzw * -r0.yyy + r2.xyz;
	r2.xyz = ColorShift.xyz * -r0.xxx + r2.xyz;
	r3.xyz = r0.yyy * globalScalars4.yzw;
	r0.y = saturate(r0.y);
	r0.yzw = r0.yyy * r1.xyz + r3.xyz;
	r1.x = 1 / globalScreenSize.y;
	r1.y = r1.x * i.vpos.y;
	r3 = ColorCorrectTopScreenEdge;
	r3.xyz = r1.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r3.xyz;
	r4.xyz = r0.yzw * r3.xyz;
	r0.yzw = r0.xxx * ColorShift.xyz;
	r0.x = saturate(r0.x);
	r0.xyz = r0.xxx * r2.xyz + r0.yzw;
	r2.xyz = ColorCorrectBottomOffset.xyz;
	r2.xyz = r1.yyy * r2.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r0.xyz * r2.xyz;
	r1.z = 1 / globalScreenSize.x;
	r1.x = r1.z * i.vpos.x;
	r1.xy = r1.xy + -0.5;
	r1.x = dot(r1.xy, r1.xy) + 0;
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.y = r3.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r1.y = (r1.y >= 0) ? -r1.y : -0;
	r1.x = r1.y + r1.x;
	r1.y = r1.y + ColorCorrectTopScreenEdge.w;
	r1.y = 1 / r1.y;
	r1.y = saturate(r1.y * r1.x);
	r1.x = (r1.x >= 0) ? r1.y : 0;
	r1.y = globalScalars.x * globalScalars.x;
	r0.w = r1.y * i.texcoord3.w;
	r4.w = r0.w;
	r2 = lerp(r0, r4, r1.x);
	r0 = (ColorCorrectTopScreenEdge.w >= 0) ? r2 : r0;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.color.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.color.z = 1 / r0.y;
	o.color.y = 1 / r0.x;
	r0.x = 64 + -i.texcoord2.w;
	r0.x = saturate(r0.x * 0.25);
	o.color.w = r0.x * r0.w;
	r0 = i.texcoord2.w * float4(0.125, 0.125, 0.125, 0) + float4(0, 0, 0, 1);
	o.color1 = max(r0, 0);

	return o;
}
