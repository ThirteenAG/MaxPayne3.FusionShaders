sampler2D BloodSampler : register(s2);
sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
sampler2D SpecSampler : register(s5);
float4 SubColor : register(c196);
float SubScatWidth : register(c198);
float SubScatWrap : register(c197);
sampler3D VolumeSampler : register(s6);
sampler2D WrinkleMaskSampler_0 : register(s7);
sampler2D WrinkleMaskSampler_1 : register(s8);
sampler2D WrinkleSampler_A : register(s9);
sampler2D WrinkleSampler_B : register(s10);
float bumpiness : register(c203);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c211);
float fresnelRolloff : register(c202);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gBloodData : register(c210);
float4 gDirectionalLight : register(c19);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c209);
float reflectivePower : register(c200);
float4 specMapExpMask : register(c207);
float3 specMapIntMask : register(c206);
float3 specMapReflectMask : register(c201);
float specularFactor : register(c205);
float4 wrinkleMaskStrengths0 : register(c213);
float4 wrinkleMaskStrengths1 : register(c214);
float4 wrinkleMaskStrengths2 : register(c215);
float4 wrinkleMaskStrengths3 : register(c216);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	float3 r8;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.z = dot(r2, specMapExpMask);
	r0.z = r0.z * specularFactor.x;
	r0.w = dot(r2.xyz, specMapIntMask.xyz);
	r2.w = max(1, r0.z);
	r3.xyz = float3(1, 0, 2);
	if (-reflectivePower.x < r3.y) {
		r4.xy = r0.xy * 2 + -1;
		r4.xy = r4.xy * bumpiness.xx;
		r0.z = dot(r4.xy, -r4.xy) + 1;
		r3.w = max(r0.z, 0);
		r0.z = rsqrt(r3.w);
		r0.z = 1 / r0.z;
		r4.xzw = r4.xxx * i.texcoord4.xyz;
		r4.xzw = r0.zzz * i.texcoord1.xyz + r4.xzw;
		r4.xyz = r4.yyy * i.texcoord5.xyz + r4.xzw;
		r4.xyz = r4.xyz + 1E-05;
		r5.xyz = normalize(r4.xyz);
		r0.z = saturate(r2.w * 0.015625);
		r4.w = r0.z * -4 + 4;
		r6.xyz = 1E-05 + i.texcoord3.xyz;
		r7 = normalize(r6.xyz);
		r0.z = dot(-r7.xyz, r5.xyz);
		r0.z = r0.z + r0.z;
		r6.xyz = r5.xyz * -r0.zzz + -r7.xyz;
		r6.xyz = r6.xyz + 1E-05;
		r8 = normalize(r6.xyz);
		r0.z = saturate(r8.z);
		r0.z = r0.z + 1;
		r0.z = r0.z + r0.z;
		r0.z = 1 / r0.z;
		r6.xy = r8.xy * r0.zz + 0.5;
		r4.xy = -r6.xy + 1;
		r4.z = 0;
		r4 = tex2Dlod(DynamicEnvironmentSampler, r4);
		r4.xyz = r4.xyz * r4.xyz;
		r4.xyz = r4.xyz * 16;
		r0.z = saturate(dot(r7.xyz, r5.xyz));
		r3.w = r3.x + -fresnelRolloff.x;
		r0.z = -r0.z + 1.00001;
		r4.w = pow(r0.z, 5.00001);
		r0.z = fresnelRolloff.x * r4.w + r3.w;
		r4.xyz = r0.zzz * r4.xyz;
	} else {
		r4.xyz = 0;
	}
	r4.xyz = r4.xyz * reflectivePower.xxx;
	r0.z = dot(r2.xyz, specMapReflectMask.xyz);
	r4.xyz = r0.zzz * r4.xyz;
	r4.xyz = r4.xyz * ColorCorrectTopAndPedReflectScale.www;
	r5 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r6 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r0.z = dot(wrinkleMaskStrengths0, r5);
	r2.x = dot(wrinkleMaskStrengths1, r6);
	r0.z = r0.z + r2.x;
	r2.x = dot(wrinkleMaskStrengths2, r5);
	r2.y = dot(wrinkleMaskStrengths3, r6);
	r2.x = r2.y + r2.x;
	r0.xy = r0.xy + -0.5;
	r0.xy = r0.xy * bumpiness.xx;
	r0.xy = r0.xy + r0.xy;
	r5 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r2.y = -r5.w + 1;
	r2.y = -r5.x + r2.y;
	r5.xy = (r2.yy >= 0) ? r5.wy : r5.xy;
	r6 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r2.y = -r6.w + 1;
	r2.y = -r6.x + r2.y;
	r5.zw = (r2.yy >= 0) ? r6.wy : r6.xy;
	r5 = r5 + -0.5;
	r5.xy = r5.xy * 2 + -r0.xy;
	r0.xy = r0.zz * r5.xy + r0.xy;
	r5.xy = r5.zw * 2 + -r0.xy;
	r0.xy = r2.xx * r5.xy + r0.xy;
	r2.x = dot(r0.xy, -r0.xy) + 1;
	r3.w = max(r2.x, 0);
	r2.x = rsqrt(r3.w);
	r0.z = 1 / r2.x;
	r0.xyz = r0.xyz + 1E-05;
	r5.xyz = normalize(r0.xyz);
	r0.xyz = r5.xxx * i.texcoord4.xyz;
	r0.xyz = i.texcoord1.xyz * r5.zzz + r0.xyz;
	r0.xyz = i.texcoord5.xyz * r5.yyy + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r2.x = dot(r0.xyz, r0.xyz);
	r2.x = rsqrt(r2.x);
	if (-gBloodData.w < r3.y) {
		r5 = tex2D(BloodSampler, i.texcoord.zw);
		r6.z = min(r5.y, r5.x);
		r2.y = saturate(r5.x * 0.5 + r5.w);
		r6.xy = r5.xy;
		r3.y = -r1.x + r6.x;
		r3.y = r2.y * r3.y;
		r5.xyz = lerp(r1.xyz, r6.xyz, r2.yyy);
		r2.y = dot(r5.xyz, float3(0.2125, 0.7154, 0.0721));
		r6.xyz = lerp(r2.yyy, r5.xyz, gAdrenoFXVars.yyy);
		r2.y = saturate(r3.y * gAmbientOcclusionEffect.z);
		r1.xyz = lerp(r5.xyz, r6.xyz, r2.yyy);
	}
	r0.xyz = r0.xyz * r2.xxx + 1E-05;
	r2.x = dot(r0.xyz, r0.xyz);
	r2.x = rsqrt(r2.x);
	r5.xyz = r0.xyz * r2.xxx;
	r2.y = dot(gDirectionalLight.xyz, r5.xyz);
	r2.y = r2.y + SubScatWrap.x;
	r3.y = r3.x + SubScatWrap.x;
	r3.y = 1 / r3.y;
	r2.y = r2.y * r3.y;
	r3.y = max(r2.y, 0);
	r2.y = 1 / SubScatWidth.x;
	r2.y = saturate(r2.y * r3.y);
	r3.w = r2.y * -2 + 3;
	r2.y = r2.y * r2.y;
	r2.y = r2.y * r3.w;
	r3.y = SubScatWidth.x * -r3.z + r3.y;
	r3.z = 1 / -SubScatWidth.x;
	r3.y = saturate(r3.z * r3.y);
	r3.z = r3.y * -2 + 3;
	r3.y = r3.y * r3.y;
	r3.y = r3.y * r3.z;
	r2.y = r2.y * r3.y;
	r3.yzw = r2.yyy * SubColor.xyz;
	r3.yzw = r1.www * r3.yzw;
	r1.xyz = r3.yzw * 0.5 + r1.xyz;
	r1.xyz = r1.xyz * matMaterialColorScale.xxx;
	r3.yzw = r4.xyz * matMaterialColorScale.zzz;
	r1.w = r0.w * matMaterialColorScale.w;
	r2.y = r2.w * matMaterialColorScale.w;
	r4.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r4.xyz = r4.xyz + 1E-05;
	r6.xyz = normalize(r4.xyz);
	r0.xyz = r0.xyz * r2.xxx + 1E-05;
	r4.xyz = normalize(r0.xyz);
	r0.x = dot(r6.xyz, r4.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.z = saturate(r1.w * 5);
	r0.y = r0.z * r0.y;
	r2.x = r2.y * 0.015625;
	r0.z = saturate(r2.y * -0.01 + 1);
	r0.y = r0.y * r0.z;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r0.w * matMaterialColorScale.w + r0.x;
	r0.y = r2.z * 16;
	r0.z = frac(r0.y);
	r0.y = r0.y + -r0.z;
	r0.z = (-r0.z >= 0) ? 0 : 1;
	r0.z = (r2.z >= 0) ? 0 : r0.z;
	r0.y = r0.z + r0.y;
	r4.xy = detailSettings.zw * i.texcoord.xy;
	r0.y = r0.y + 0.5;
	r4.z = r0.y * 0.0625;
	r4 = tex3D(VolumeSampler, r4.xyz);
	r0.yzw = r4.yzx * 2 + -1;
	r1.w = detailSettings.x * i.texcoord2.w;
	r0.w = r0.w * r1.w + 1;
	r2.yzw = r0.www * r1.xyz;
	r4.xyz = r0.zzz * i.texcoord5.xyz;
	r4.xyz = i.texcoord4.xyz * r0.yyy + r4.xyz;
	r4.xyz = r4.xyz * detailSettings.yyy;
	r4.xyz = r4.xyz * i.texcoord2.www + r5.xyz;
	r4.xyz = r4.xyz + 1E-05;
	r5.xyz = normalize(r4.xyz);
	o.color2.x = saturate(r0.w * r0.x);
	r0.x = dot(r2.yzw, float3(0.2125, 0.7154, 0.0721));
	r0.z = 0.1;
	r0.y = saturate(r0.z + deSatContrastGamma.x);
	r0.y = 1 / r0.y;
	r0.y = r0.y * gAdrenoFXVars.z;
	r1.xyz = r1.xyz * r0.www + -r0.xxx;
	r0.xyz = r0.yyy * r1.xyz + r0.xxx;
	r1.xyz = saturate(r3.xxx + -ColorCorrectTopAndPedReflectScale.xyz);
	r1.xyz = r1.xyz * 0.25 + 1;
	r0.w = saturate(gAmbientOcclusionEffect.z);
	r0.xyz = r0.xyz * r1.xyz + -r2.yzw;
	o.color.xyz = r0.www * r0.xyz + r2.yzw;
	o.color2.z = saturate(r0.w + i.texcoord2.x);
	o.color1.xyz = r5.xyz * 0.5 + 0.5;
	r2.x = saturate(r2.x);
	r0.x = rsqrt(r2.x);
	o.color2.y = 1 / r0.x;
	r0.x = globalScalars.x * i.texcoord2.w;
	r0.yzw = saturate(r3.yzw * 0.0625);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	r0.w = rsqrt(r0.w);
	o.color3.x = 1 / r0.y;
	o.color3.y = 1 / r0.z;
	o.color3.z = 1 / r0.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3.w = gStencil.x;

	return o;
}
