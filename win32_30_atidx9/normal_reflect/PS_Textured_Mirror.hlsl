struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.x = r0.w * i.color.w;
	o.w = r1.x * globalScalars.x;
	r1.x = 1 / r1.x;
	r1.yzw = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r1.yzw = i.texcoord6.xxx * gShadowMatrix[0].xyz + r1.yzw;
	r1.yzw = i.texcoord6.zzz * gShadowMatrix[2].xyz + r1.yzw;
	r1.yzw = r1.yzw + gShadowMatrix[3].xyz;
	r2.xy = r1.yz + -gShadowParam18192021.zw;
	r3.xyz = r2.xxx + -gCascadeXMaxThresholds.xyz;
	r3.xyz = (r3.xyz >= 0) ? 1 : 0;
	r4.xyz = -r2.xxx + gCascadeXMinThresholds.xyz;
	r4.xyz = (r4.xyz >= 0) ? 1 : 0;
	r3.xyz = r3.xyz + r4.xyz;
	r4.xyz = r2.yyy + -gCascadeYMaxThresholds.xyz;
	r4.xyz = (r4.xyz >= 0) ? 1 : 0;
	r3.xyz = r3.xyz + r4.xyz;
	r4.xyz = -r2.yyy + gCascadeYMinThresholds.xyz;
	r4.xyz = (r4.xyz >= 0) ? 1 : 0;
	r3.yzw = saturate(r3.xyz + r4.xyz);
	r3.x = 1;
	r4.x = dot(r3, gShadowParam0123);
	r4.y = dot(r3, gShadowParam4567);
	r4.z = dot(r3, gCascadeZScales);
	r5.x = dot(r3, gShadowParam891113);
	r5.y = dot(r3, gShadowParam14151617);
	r5.z = dot(r3, gCascadeZOffsets);
	r1.yzw = r1.wyz * r4.zxy + r5.zxy;
	r1.y = saturate(r1.y);
	r4 = tex2D(gShadowZSamplerDir, r1.zw);
	r1.y = -r1.y + 1;
	r1.y = -r4.x + r1.y;
	r1.y = (r1.y >= 0) ? -1 : -0;
	r3.x = abs(gCascadeXMinThresholds.w);
	r3.y = abs(gCascadeYMinThresholds.w);
	r4.x = abs(gCascadeXMaxThresholds.w);
	r4.y = abs(gCascadeYMaxThresholds.w);
	r1.zw = max(r3.xy, r4.xy);
	r2.zw = r1.zw + -0.25;
	r1.zw = r1.zw + -r2.zw;
	r2.xy = -r2.zw + abs(r2.xy);
	r3.x = 1 / r1.z;
	r3.y = 1 / r1.w;
	r1.zw = saturate(r2.xy * r3.xy);
	r2.xy = r1.zw * -2 + 3;
	r1.zw = r1.zw * r1.zw;
	r1.zw = r1.zw * r2.xy;
	r2.x = max(r1.z, r1.w);
	r1.z = r3.w + r2.x;
	r1.y = r1.y + r1.z;
	r1.y = saturate(r1.y + 1);
	r2.xyz = gDirectionalColour.www * gDirectionalColour.xyz;
	r1.yzw = r1.yyy * r2.xyz;
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r2.z = -r2.w + 1;
	r2.z = -r2.x + r2.z;
	r2.xy = (r2.zz >= 0) ? r2.wy : r2.xy;
	r2.xy = r2.xy * 2 + -1;
	r2.xy = r2.xy * bumpiness.xx;
	r2.z = dot(r2.xy, -r2.xy) + 1;
	r3.x = max(r2.z, 0);
	r2.z = rsqrt(r3.x);
	r2.z = 1 / r2.z;
	r3.xyz = r2.xxx * i.texcoord4.xyz;
	r2.xzw = r2.zzz * i.texcoord1.xyz + r3.xyz;
	r2.xyz = r2.yyy * i.texcoord5.xyz + r2.xzw;
	r2.xyz = r2.xyz + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r2.x = dot(r3.xyz, -gDirectionalLight.xyz);
	r2.x = saturate(r2.x + -0.25);
	r2.x = r2.x * 1.3333334;
	r1.yzw = r1.yzw * r2.xxx;
	r2.xy = float2(0.15, 1);
	r2.x = saturate(AmbientLightingParams.x * -r2.x + r2.y);
	r2.x = saturate(r2.x + 0.2);
	r2.x = r2.x * AmbientLightingParams.y;
	r2.x = i.color.x * r2.x + -i.color.x;
	r2.x = gAmbientOcclusionEffect.x * r2.x + i.color.x;
	r4.xyz = gLightAmbient0.xyz;
	r2.yzw = -r4.xyz + gLightAmbient1.xyz;
	r3.w = saturate(r3.z * -0.5 + 0.5);
	r2.yzw = r3.www * r2.yzw + gLightAmbient0.xyz;
	r2.xyz = r2.xxx * r2.yzw;
	r2.w = 1 / gAmbientOcclusionEffect.y;
	r1.yzw = r2.xyz * r2.www + r1.yzw;
	r2 = gLightPosX + -i.texcoord6.x;
	r4 = r3.x * r2;
	r5 = gLightPosY + -i.texcoord6.y;
	r4 = r5 * r3.y + r4;
	r6 = gLightPosZ + -i.texcoord6.z;
	r4 = r6 * r3.z + r4;
	r7 = r2 * r2;
	r2 = r2 * -gLightDirX;
	r2 = r5 * -gLightDirY + r2;
	r5 = r5 * r5 + r7;
	r5 = r6 * r6 + r5;
	r2 = r6 * -gLightDirZ + r2;
	r6.x = 1;
	r7 = r5 * -gLightFallOff + r6.x;
	r5 = r5 + 1E-05;
	r8 = max(r7, 0);
	r7 = r8 * r8;
	r7 = r7 * r7 + -0.1;
	r8 = r7 * 1.1111112;
	r7 = (r7 >= 0) ? r8 : 0;
	r4 = r4 * r7;
	r7.x = rsqrt(r5.x);
	r7.y = rsqrt(r5.y);
	r7.z = rsqrt(r5.z);
	r7.w = rsqrt(r5.w);
	r4 = saturate(r4 * r7);
	r2 = r2 * r7;
	r5 = gLightConeScale;
	r2 = saturate(r2 * r5 + gLightConeOffset);
	r2 = r4 * r2;
	r4.x = dot(gLightColR, r2);
	r4.y = dot(gLightColG, r2);
	r4.z = dot(gLightColB, r2);
	r1.yzw = r1.yzw + r4.xyz;
	r2 = gLightPointPosX + -i.texcoord6.x;
	r4 = r3.x * r2;
	r5 = gLightPointPosY + -i.texcoord6.y;
	r4 = r5 * r3.y + r4;
	r7 = gLightPointPosZ + -i.texcoord6.z;
	r4 = r7 * r3.z + r4;
	r8 = r2 * r2;
	r2 = r2 * -gLightDir2X;
	r2 = r5 * -gLightDir2Y + r2;
	r5 = r5 * r5 + r8;
	r5 = r7 * r7 + r5;
	r2 = r7 * -gLightDir2Z + r2;
	r7 = r5 * -gLightPointFallOff + r6.x;
	r5 = r5 + 1E-05;
	r8 = max(r7, 0);
	r7 = r8 * r8;
	r7 = r7 * r7 + -0.1;
	r8 = r7 * 1.1111112;
	r7 = (r7 >= 0) ? r8 : 0;
	r4 = r4 * r7;
	r7.x = rsqrt(r5.x);
	r7.y = rsqrt(r5.y);
	r7.z = rsqrt(r5.z);
	r7.w = rsqrt(r5.w);
	r4 = saturate(r4 * r7);
	r2 = r2 * r7;
	r5 = gLightConeScale2;
	r2 = saturate(r2 * r5 + gLightConeOffset2);
	r2 = r4 * r2;
	r4.x = dot(gLightPointColR, r2);
	r4.y = dot(gLightPointColG, r2);
	r4.z = dot(gLightPointColB, r2);
	r1.yzw = r1.yzw + r4.xyz;
	r2.x = dot(r1.yzw, 0.33333334);
	r2.yzw = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r2.yzw);
	r2.y = dot(-r4.xyz, r3.xyz);
	r2.y = r2.y + r2.y;
	r2.yzw = r3.xyz * -r2.yyy + -r4.xyz;
	r3.x = saturate(dot(r4.xyz, r3.xyz));
	r3.x = -r3.x + 1.00001;
	r4.x = pow(r3.x, 5.00001);
	r2.yzw = r2.yzw + 1E-05;
	r2.z = dot(r2.yzw, r2.yzw);
	r2.z = rsqrt(r2.z);
	r2.yz = r2.yw * r2.zz + 1;
	r2.yz = r2.yz * -0.5;
	r3 = tex2D(EnvironmentSampler, r2.yz);
	r2.y = r6.x + -fresnelRolloff.x;
	r2.y = fresnelRolloff.x * r4.x + r2.y;
	r2.yzw = r2.yyy * r3.xyz;
	r2.yzw = r2.yzw * reflectivePower.xxx;
	r2.yzw = r2.yzw * globalScalars.www;
	r0.w = r0.w * i.color.w + -0.01;
	r0.xyz = r0.xyz * r0.xyz;
	r0.w = (r0.w >= 0) ? r1.x : 100;
	r2.yzw = r0.www * r2.yzw;
	r2.xyz = r2.xxx * r2.yzw;
	r0.xyz = r0.xyz * r1.yzw + r2.xyz;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;

	return o;
}
