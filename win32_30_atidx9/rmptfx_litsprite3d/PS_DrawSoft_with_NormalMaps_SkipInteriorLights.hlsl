float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectBottomOffsetScreenEdge : register(c67);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorCorrectTopScreenEdge : register(c66);
float4 ColorShift : register(c45);
sampler2D DepthMapTexSampler : register(s12);
sampler2D DiffuseTexSampler : register(s0);
float HybridAdd : register(c197);
float4 deSatContrastGamma : register(c46);
float4 gActiveUnit : register(c200);
float4 gAdrenoFXVars : register(c68);
float gAmbientAmount : register(c213);
float4 gAmbientOcclusionEffect : register(c63);
float gAmbientShadow : register(c218);
float gDiffuse : register(c209);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gInvScreenSize : register(c129);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float gLightIntensityClamp : register(c219);
float gNormalArc : register(c215);
float gSoftness : register(c196);
float gSpecularExponent : register(c211);
float gSpecularIntensity : register(c210);
float gSuperAlpha : register(c214);
float4 gTexCoordScaleOffset0 : register(c201);
float4 gTexCoordScaleOffset1 : register(c202);
float4 gTexCoordScaleOffset2 : register(c203);
float4 gTexCoordScaleOffset3 : register(c204);
row_major float4x4 gWorldView : register(c4);
float gWrapBias : register(c208);
float gWrapScale : register(c207);
float4 globalScalars4 : register(c51);
float4 globalScreenSize : register(c41);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord6 : TEXCOORD6;
	float2 vpos : VPOS;
	float2 texcoord3 : TEXCOORD3;
	float4 texcoord2 : TEXCOORD2;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0.xw = float2(0.57735026, 1E-05);
	r0.y = dot(r0.xxx, -gDirectionalLight.xyz);
	r1.x = max(r0.y, -gLightIntensityClamp.x);
	r0.y = min(gLightIntensityClamp.x, r1.x);
	r0.z = -r0.y + 1;
	r0.y = gNormalArc.x * r0.z + r0.y;
	r1.x = gWrapScale.x;
	r0.y = r0.y * r1.x + gWrapBias.x;
	r0.y = r0.y * gDirectionalColour.x;
	r0.y = r0.y * gDirectionalColour.w;
	r0.y = r0.y * gDiffuse.x;
	r1.yzw = r0.yyy * i.texcoord.xyz;
	r2.xyz = max(r1.yzw, 0);
	r3.xy = float2(0.6666667, -0.33333334);
	r0.y = saturate(dot(r3.xxy, -gDirectionalLight.xyz));
	r0.y = r0.y + 1E-05;
	r0.z = r0.w + gSpecularExponent.x;
	r1.y = pow(r0.y, r0.z);
	r0.y = r1.y * r1.x + gWrapBias.x;
	r0.y = r0.y * gDirectionalColour.x;
	r0.y = r0.y * gDirectionalColour.w;
	r0.y = r0.y * gSpecularIntensity.x;
	r1.x = max(r0.y, 0);
	r0.yzw = r1.xxx + r2.xyz;
	r0.x = dot(r0.xxx, gWorldView[2].xyz);
	r0.x = saturate(r0.x * -0.5 + 0.5);
	r1.xyz = gLightAmbient0.xyz;
	r1.xyz = -r1.xyz + gLightAmbient1.xyz;
	r1.xyz = r0.xxx * r1.xyz + gLightAmbient0.xyz;
	r1.xyz = r1.xyz * gAmbientAmount.xxx;
	r0.x = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r0.xxx * r1.xyz;
	r1.xyz = r1.xyz * i.texcoord.xyz;
	r2.xyz = r1.xyz * gAmbientShadow.xxx;
	r1.xyz = (r1.xyz >= 0) ? r2.xyz : 0;
	r0.xyz = r0.yzw + r1.xyz;
	r1.xy = i.vpos.xy * gInvScreenSize.xy + gInvScreenSize.zw;
	r1 = tex2D(DepthMapTexSampler, r1.xy);
	r1.x = r1.x + -i.texcoord3.y;
	r1.x = r1.x * r1.x;
	r1.x = saturate(r1.x * gSoftness.x);
	r1.y = saturate(gSuperAlpha.x * i.texcoord.w);
	r0.w = r1.x * r1.y;
	r1.xy = i.texcoord1.xy * gTexCoordScaleOffset2.xy + gTexCoordScaleOffset2.zw;
	r1 = tex2D(DiffuseTexSampler, r1.xy);
	r2.xy = i.texcoord1.xy * gTexCoordScaleOffset0.xy + gTexCoordScaleOffset0.zw;
	r2 = tex2D(DiffuseTexSampler, r2.xy);
	r3.xy = i.texcoord1.xy * gTexCoordScaleOffset1.xy + gTexCoordScaleOffset1.zw;
	r3 = tex2D(DiffuseTexSampler, r3.xy);
	r4 = gActiveUnit * i.texcoord6;
	r3 = r3 * r4.y;
	r2 = r4.x * r2 + r3;
	r1 = r4.z * r1 + r2;
	r2.xy = i.texcoord1.xy * gTexCoordScaleOffset3.xy + gTexCoordScaleOffset3.zw;
	r2 = tex2D(DiffuseTexSampler, r2.xy);
	r1 = r4.w * r2 + r1;
	r2 = r0 * r1;
	r0.w = dot(r2.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.w = saturate(r2.w);
	r0.xyz = r0.xyz * r1.xyz + -r0.www;
	r0.xyz = i.texcoord2.zzz * r0.xyz + r0.www;
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = -0.99999 + i.texcoord2.w;
	r3.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r3.xxx;
	r0.xyz = r0.xyz * -r3.xxx + i.texcoord4.xyz;
	r0.xyz = i.texcoord4.www * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r3.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	r0.x = r0.w * ColorCorrectBottomOffset.w;
	r0.y = r0.w * ColorShift.w;
	r1.xyz = globalScalars4.yzw * -r0.xxx + r3.xyz;
	r3.xyz = ColorShift.xyz * -r0.yyy + r3.xyz;
	r4.xyz = r0.xxx * globalScalars4.yzw;
	r0.x = saturate(r0.x);
	r0.xzw = r0.xxx * r1.xyz + r4.xyz;
	r1.x = 1 / globalScreenSize.y;
	r1.y = r1.x * i.vpos.y;
	r4 = ColorCorrectTopScreenEdge;
	r4.xyz = r1.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r4.xyz;
	r5.xyz = r0.xzw * r4.xyz;
	r0.xzw = r0.yyy * ColorShift.xyz;
	r0.y = saturate(r0.y);
	r0.xyz = r0.yyy * r3.xyz + r0.xzw;
	r3.xyz = ColorCorrectBottomOffset.xyz;
	r3.xyz = r1.yyy * r3.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r2.xyz = r0.xyz * r3.xyz;
	r5.w = r2.w;
	r0.x = 1 / globalScreenSize.x;
	r1.x = r0.x * i.vpos.x;
	r0.xy = r1.xy + -0.5;
	r0.x = dot(r0.xy, r0.xy) + 0;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.y = r4.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r0.y = (r0.y >= 0) ? -r0.y : -0;
	r0.x = r0.y + r0.x;
	r0.y = r0.y + ColorCorrectTopScreenEdge.w;
	r0.y = 1 / r0.y;
	r0.y = saturate(r0.y * r0.x);
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r1 = lerp(r2, r5, r0.x);
	r0 = (ColorCorrectTopScreenEdge.w >= 0) ? r1 : r2;
	r1.xyz = r0.www * r0.xyz;
	r1.w = r0.w;
	r2.x = abs(HybridAdd.x);
	r0 = (-r2.x >= 0) ? r0 : r1;
	r1 = max(r0, 0);
	o = min(r1, 32);

	return o;
}
