sampler2D PositionTexSampler : register(s2);
sampler2D VelocityTexSampler : register(s3);
float gAmbientAmount : register(c102);
float4 gAmbientOcclusionEffect : register(c63);
float4 gColorTint : register(c96);
float4 gColorTintPhase2 : register(c98);
float gDiffuse : register(c101);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float4 gRadius : register(c93);
float4 gTextureAnimation : register(c95);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float gWrapBias : register(c100);
float gWrapScale : register(c99);

struct VS_IN
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float3 r10;
	float4 r11;
	float4 r12;
	r0 = tex2Dlod(PositionTexSampler, i.position);
	r1 = tex2Dlod(VelocityTexSampler, i.position);
	if (-abs(r1.w) >= abs(r1.w)) {
		r2.xyz = float3(0.125, 0, 0.5);
		r1.w = r2.x * gRadius.x;
		r2.xyz = gRadius.xxx * r2.yyz + r0.xyz;
		r3.xy = float2(-0.5, -0.7) + i.texcoord.xy;
		r4 = normalize(r1.xyz);
		r1.xyz = -r2.xyz + gViewInverse[3].xyz;
		r5.xyz = r1.yzx * r4.zxy;
		r5.xyz = r4.yzx * r1.zxy + -r5.xyz;
		r6.xyz = normalize(r5.xyz);
		r5.xyz = r1.www * r6.xyz;
		r4 = r4.xyz * gRadius.xxx;
		r3.yzw = r3.yyy * r4.xyz;
		r3.xyz = r3.xxx * r5.xyz + r3.yzw;
		r4 = normalize(r1.xyz);
		r1.xyz = r2.xyz + r3.xyz;
		r2 = r1.y * gWorldViewProj[1];
		r2 = r1.x * gWorldViewProj[0] + r2;
		r1 = r1.z * gWorldViewProj[2] + r2;
		o.position = r1 + gWorldViewProj[3];
		r1.x = 0.05;
		r1.x = r1.x + gColorTint.w;
		r1.yzw = gColorTint.xyz;
		r2.x = i.texcoord.x;
	} else {
		r3.yz = float2(0, 0.5);
		r3 = gRadius.z * r3.yyzy + r0;
		r2.zw = -0.5 + i.texcoord.xy;
		r5.xyz = normalize(gViewInverse[0].xyz);
		r5.xyz = r5.xyz * gRadius.zzz;
		r6.xyz = normalize(-gViewInverse[1].xyz);
		r6.xyz = r6.xyz * gRadius.zzz;
		r6.xyz = r2.www * r6.xyz;
		r5.xyz = r2.zzz * r5.xyz + r6.xyz;
		r4 = normalize(r5.xyz);
		r3.xyz = r3.xyz + r5.xyz;
		r5 = r3.y * gWorldViewProj[1];
		r5 = r3.x * gWorldViewProj[0] + r5;
		r5 = r3.z * gWorldViewProj[2] + r5;
		o.position = r5 + gWorldViewProj[3];
		r0.w = r3.w * gTextureAnimation.x + -gTextureAnimation.y;
		r2.z = frac(r0.w);
		r2.w = r0.w + -r2.z;
		r0.w = (r0.w < -r0.w) ? 1 : 0;
		r2.z = (-r2.z < r2.z) ? 1 : 0;
		r0.w = r0.w * r2.z + r2.w;
		r0.w = saturate(r0.w * gTextureAnimation.z);
		r0.w = gTextureAnimation.z * i.texcoord.x + r0.w;
		r2.x = r0.w + -10;
		r2.z = 0.1;
		r1.x = r2.z + gColorTintPhase2.w;
		r1.yzw = gColorTintPhase2.xyz;
	}
	r3 = gLightPosX * gLightPosX;
	r3 = gLightPosY * gLightPosY + r3;
	r3 = gLightPosZ * gLightPosZ + r3;
	r5 = r3 + 1E-05;
	r6.x = rsqrt(r5.x);
	r6.y = rsqrt(r5.y);
	r6.z = rsqrt(r5.z);
	r6.w = rsqrt(r5.w);
	r5.x = 1;
	r3 = r3 * -gLightFallOff + r5.x;
	r3 = max(r3, 0);
	r3 = r3 * r3;
	r3 = r3 * r3 + -0.1;
	r3 = max(r3, 0);
	r3 = r3 * 1.1111112;
	r3 = min(r3, 1);
	r5.x = gLightPosX.x;
	r5.y = gLightPosY.x;
	r5.z = gLightPosZ.x;
	r5.xyz = r5.xyz + 1E-05;
	r7.xyz = normalize(r5.xyz);
	r5.x = gLightPosX.y;
	r5.y = gLightPosY.y;
	r5.z = gLightPosZ.y;
	r5.xyz = r5.xyz + 1E-05;
	r8.xyz = normalize(r5.xyz);
	r5.x = gLightPosX.z;
	r5.y = gLightPosY.z;
	r5.z = gLightPosZ.z;
	r5.xyz = r5.xyz + 1E-05;
	r9.xyz = normalize(r5.xyz);
	r5.x = gLightPosX.w;
	r5.y = gLightPosY.w;
	r5.z = gLightPosZ.w;
	r5.xyz = r5.xyz + 1E-05;
	r10 = normalize(r5.xyz);
	r5.x = r7.x;
	r5.y = r8.x;
	r5.z = r9.x;
	r5.w = r10.x;
	r11 = r5 * -gLightDirX;
	r12.x = r7.y;
	r12.y = r8.y;
	r12.z = r9.y;
	r12.w = r10.y;
	r11 = r12 * -gLightDirY + r11;
	r9.x = r7.z;
	r9.y = r8.z;
	r9.w = r10.z;
	r7 = r9 * -gLightDirZ + r11;
	r8 = gLightConeScale;
	r7 = saturate(r7 * r8 + gLightConeOffset);
	r3 = r3 * r7;
	r3 = r6 * r3;
	r5 = r3 * r5;
	r6 = r3 * r12;
	r7 = r3 * r9;
	r0.w = r3.x * gWrapBias.x;
	r2.z = dot(r4.xyz, -gDirectionalLight.xyz);
	r0.w = saturate(r2.z * gWrapScale.x + r0.w);
	r3.xyz = r0.www * gDirectionalColour.xyz;
	r5 = r4.x * r5;
	r5 = r4.y * r6 + r5;
	r5 = r4.z * r7 + r5;
	r5 = saturate(r5 + gWrapBias.x);
	r6.x = dot(gLightColR, r5);
	r6.y = dot(gLightColG, r5);
	r6.z = dot(gLightColB, r5);
	r3.xyz = r3.xyz * gDirectionalColour.www + r6.xyz;
	r0.w = dot(r4.xyz, gWorldView[2].xyz);
	r0.w = saturate(r0.w * -0.5 + 0.5);
	r4 = gLightAmbient0.xyz;
	r4 = -r4.xyz + gLightAmbient1.xyz;
	r4 = r0.www * r4.xyz + gLightAmbient0.xyz;
	r4 = r4.xyz * gAmbientAmount.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r3.xyz = r4.xyz * r0.www + r3.xyz;
	r3.xyz = r3.xyz * gDiffuse.xxx;
	o.color.xyz = r1.yzw * r3.xyz;
	r0.xyz = -r0.xyz + gViewInverse[3].xyz;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * 0.6666667;
	r0.y = r0.x * r0.x;
	r0.x = r0.x * r0.y;
	r0.x = min(r0.x, 1);
	o.color.w = r0.x * r1.x;
	r2.y = i.texcoord.y;
	o.texcoord = r2.xy;

	return o;
}
