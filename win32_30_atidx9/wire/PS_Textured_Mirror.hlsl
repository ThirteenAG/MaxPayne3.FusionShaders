	r2.y = 1 / r0.z;
	r0.yz = saturate(r1.xy * r2.xy);
	r1.xy = r0.yz * -2 + 3;
	r0.yz = r0.yz * r0.yz;
	r0.yz = r0.yz * r1.xy;
	r1.x = max(r0.y, r0.z);
	r0.y = r2.w + r1.x;
	r0.x = r0.x + r0.y;
	r0.x = saturate(r0.x + 1);
	r0.yzw = gDirectionalColour.www * gDirectionalColour.xyz;
	r0.xyz = r0.xxx * r0.yzw;
