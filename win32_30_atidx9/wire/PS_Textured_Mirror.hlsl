	r5 = r5 * r2.y + r8;
	r5 = r6 * r2.z + r5;
	r3 = r6 * -gLightDirZ + r3;
	r5 = r7 * r5;
	r6.x = rsqrt(r4.x);
	r6.y = rsqrt(r4.y);
	r6.z = rsqrt(r4.z);
	r6.w = rsqrt(r4.w);
