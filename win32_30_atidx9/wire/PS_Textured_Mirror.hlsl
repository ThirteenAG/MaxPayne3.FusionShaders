	r1.x = r1.x * AmbientLightingParams.y;
	r1.x = i.color.x * r1.x + -i.color.x;
	r1.x = gAmbientOcclusionEffect.x * r1.x + i.color.x;
	r3.xyz = gLightAmbient0.xyz;
	r3.xyz = -r3.xyz + gLightAmbient1.xyz;
	r1.y = saturate(r2.z * -0.5 + 0.5);
	r3.xyz = r1.yyy * r3.xyz + gLightAmbient0.xyz;
