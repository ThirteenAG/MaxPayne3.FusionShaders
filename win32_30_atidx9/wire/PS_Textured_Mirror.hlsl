	r4.z = dot(gLightColB, r3);
	r0.xyz = r0.xyz + r4.xyz;
	r3 = gLightPointPosX + -i.texcoord6.x;
	r4 = r2.x * r3;
	r5 = gLightPointPosY + -i.texcoord6.y;
	r4 = r5 * r2.y + r4;
	r6 = gLightPointPosZ + -i.texcoord6.z;
	r2 = r6 * r2.z + r4;
	r4 = r3 * r3;
	r3 = r3 * -gLightDir2X;
	r3 = r5 * -gLightDir2Y + r3;
	r4 = r5 * r5 + r4;
	r4 = r6 * r6 + r4;
	r3 = r6 * -gLightDir2Z + r3;
	r1 = r4 * -gLightPointFallOff + r1.z;
	r4 = r4 + 1E-05;
	r5 = max(r1, 0);
	r1 = r5 * r5;
	r1 = r1 * r1 + -0.1;
	r5 = r1 * 1.1111112;
	r1 = (r1 >= 0) ? r5 : 0;
	r1 = r1 * r2;
	r2.x = rsqrt(r4.x);
	r2.y = rsqrt(r4.y);
	r2.z = rsqrt(r4.z);
	r2.w = rsqrt(r4.w);
	r1 = saturate(r1 * r2);
	r2 = r2 * r3;
	r3 = gLightConeScale2;
	r2 = saturate(r2 * r3 + gLightConeOffset2);
	r1 = r1 * r2;
	r2.x = dot(gLightPointColR, r1);
	r2.y = dot(gLightPointColG, r1);
	r2.z = dot(gLightPointColB, r1);
	r0.xyz = r0.xyz + r2.xyz;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.xyz = r1.xyz * r1.xyz;
	r0.xyz = r0.xyz * r1.xyz;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;

	return o;
}
