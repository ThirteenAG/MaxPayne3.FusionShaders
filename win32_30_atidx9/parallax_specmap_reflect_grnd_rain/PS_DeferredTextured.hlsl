sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s4);
sampler2D PuddleMaskSampler : register(s2);
sampler2D SpecSampler : register(s3);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c205);
float bumpiness : register(c200);
float fresnelRolloff : register(c202);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
float4 gWaterGlobals : register(c64);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float parallaxScaleBias : register(c196);
float reflectivePower : register(c201);
float4 specMapExpMask : register(c199);
float3 specMapIntMask : register(c198);
float3 specMapReflectMask : register(c203);
float specularFactor : register(c197);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float2 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	r0 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r0, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r1.y = max(1, r0.w);
	r1.zw = WetDarken.ww * i.texcoord6.xy;
	r2 = tex2D(PuddleMaskSampler, r1.zw);
	r0.w = r2.x + gWaterGlobals.y;
	r0.w = saturate(r0.w + -i.color.y);
	r1.x = dot(r0.xyz, specMapIntMask.xyz);
	r0.x = dot(r0.xyz, specMapReflectMask.xyz);
	r2.xy = lerp(r1.xy, gWaterGlobals.zw, r0.ww);
	r0.yz = (-r0.ww >= 0) ? r1.xy : r2.xy;
	r0.yz = (-i.color.yy >= 0) ? r1.xy : r0.yz;
	r1.xyz = 1E-05 + i.texcoord7.xyz;
	r1.z = dot(r1.xyz, r1.xyz);
	r1.z = rsqrt(r1.z);
	r1.xy = r1.zz * r1.xy;
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r3.yw = float2(0.5, -1);
	r1.z = r3.y * parallaxScaleBias.x;
	r1.z = r2.w * parallaxScaleBias.x + -r1.z;
	r1.xy = r1.zz * r1.xy + i.texcoord.xy;
	r2 = tex2D(BumpSampler, r1.xy);
	r1 = tex2D(DiffuseSampler, r1.xy);
	r2.z = dot(r2.xy, r2.xy) + -0.002;
	r2.xy = r2.xy * 2 + -1;
	r3.xy = r2.xy * bumpiness.xx;
	r2.x = (r2.z >= 0) ? 1 : 0;
	o.color2.x = r0.y * r2.x;
	r0.y = saturate(r0.z * 0.0051020407);
	r0.y = rsqrt(r0.y);
	o.color2.y = 1 / r0.y;
	r2.yzw = r1.xyz * WetDarken.xyz + -r1.xyz;
	r0.y = saturate(gWaterGlobals.y);
	r2.yzw = r0.yyy * r2.yzw + r1.xyz;
	r4 = r1.xyz * WetDarken.xyz;
	r2.yzw = (-r0.www >= 0) ? r2.yzw : r4.xyz;
	r1.xyz = (-i.color.yyy >= 0) ? r1.xyz : r2.yzw;
	r0.y = r1.w * i.color.w;
	r2.yzw = r2.xxx * r1.xyz;
	r0.z = dot(r2.yzw, float3(0.2125, 0.7154, 0.0721));
	r4 = r1.xyz * r2.xxx + -r0.zzz;
	r4 = gAdrenoFXVars.xxx * r4.xyz + r0.zzz;
	r1.xyz = r1.xyz * -r2.xxx + r4.xyz;
	r0.z = saturate(gAmbientOcclusionEffect.z + gAmbientOcclusionEffect.z);
	r1.xyz = r0.zzz * r1.xyz + r2.yzw;
	r0.z = saturate(i.color.x * r2.x + -1);
	r1.w = r2.x * i.color.x;
	o.color2.z = r1.w;
	o.color.xyz = r0.zzz * globalScalars2.zzz + r1.xyz;
	r1.xy = 0.3 * i.texcoord6.xy;
	r1 = tex2D(WaterRainRippleNormalSampler, r1.xy);
	r1.xyz = r1.xyz * 2 + -1;
	r0.z = dot(r3.xy, -r3.xy) + 1;
	r1.w = max(r0.z, 0);
	r0.z = rsqrt(r1.w);
	r3.z = 1 / r0.z;
	r1.xyz = r1.xyz * i.texcoord1.zzz + -r3.xyz;
	r1.xyz = r0.www * r1.xyz + r3.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r1.xyz = (-r0.www >= 0) ? r3.xyz : r2.xyz;
	r1.xyz = (-i.color.yyy >= 0) ? r3.xyz : r1.xyz;
	r2.xyz = r1.xxx * i.texcoord4.xyz;
	r1.xzw = r1.zzz * i.texcoord1.xyz + r2.xyz;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r1.xzw;
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	o.color1.xyz = r2.xyz * 0.5 + 0.5;
	r1.xyz = 1E-05 + i.texcoord3.xyz;
	r3.xyz = normalize(r1.xyz);
	r0.z = dot(-r3.xyz, r2.xyz);
	r0.z = r0.z + r0.z;
	r1.xyz = r2.xyz * -r0.zzz + -r3.xyz;
	r0.z = saturate(dot(r3.xyz, r2.xyz));
	r0.z = -r0.z + 1.00001;
	r1.w = pow(r0.z, 5.00001);
	r1.xyz = r1.xyz + 1E-05;
	r0.z = dot(r1.xyz, r1.xyz);
	r0.z = rsqrt(r0.z);
	r0.zw = r1.xz * r0.zz + 1;
	r0.zw = r0.zw * -0.5;
	r2 = tex2D(EnvironmentSampler, r0.zw);
	r0.z = -r3.w + -fresnelRolloff.x;
	r0.z = fresnelRolloff.x * r1.w + r0.z;
	r1.xyz = r0.zzz * r2.xyz;
	r1.xyz = r1.xyz * reflectivePower.xxx;
	r0.xzw = r0.xxx * r1.xyz;
	r0 = r0 * globalScalars.wxww;
	r0.xzw = saturate(r0.xzw * 0.0625);
	r0.x = rsqrt(r0.x);
	o.color3.x = 1 / r0.x;
	r0.x = rsqrt(r0.z);
	r0.z = rsqrt(r0.w);
	o.color3.z = 1 / r0.z;
	o.color3.y = 1 / r0.x;
	o.color.w = r0.y;
	o.color1.w = r0.y;
	o.color2.w = r0.y;
	o.color3.w = gStencil.x;

	return o;
}
