sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s4);
sampler2D PuddleMaskSampler : register(s2);
sampler2D SpecSampler : register(s3);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c204);
float bumpiness : register(c199);
float fresnelRolloff : register(c201);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
float4 gWaterGlobals : register(c64);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float reflectivePower : register(c200);
float4 specMapExpMask : register(c198);
float3 specMapIntMask : register(c197);
float3 specMapReflectMask : register(c202);
float specularFactor : register(c196);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float2 texcoord6 : TEXCOORD6;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color2 : COLOR2;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float2 r4;
	r0.x = saturate(gWaterGlobals.y);
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.yzw = r1.xyz * WetDarken.xyz + -r1.xyz;
	r0.xyz = r0.xxx * r0.yzw + r1.xyz;
	r2.xy = WetDarken.ww * i.texcoord6.xy;
	r2 = tex2D(PuddleMaskSampler, r2.xy);
	r0.w = r2.x + gWaterGlobals.y;
	r0.w = saturate(r0.w + -i.color.y);
	r2.xyz = r1.xyz * WetDarken.xyz;
	r0.xyz = (-r0.www >= 0) ? r0.xyz : r2.xyz;
	r0.xyz = (-i.color.yyy >= 0) ? r1.xyz : r0.xyz;
	r1.x = r1.w * i.color.w;
	r1.x = r1.x * globalScalars.x;
	r1.y = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.xyz = lerp(r1.yyy, r0.xyz, gAdrenoFXVars.xxx);
	r1.y = saturate(gAmbientOcclusionEffect.z + gAmbientOcclusionEffect.z);
	r3.xyz = lerp(r0.xyz, r2.xyz, r1.yyy);
	r0.x = saturate(-1 + i.color.x);
	o.color.xyz = r0.xxx * globalScalars2.zzz + r3.xyz;
	r0.xy = 0.3 * i.texcoord6.xy;
	r2 = tex2D(WaterRainRippleNormalSampler, r0.xy);
	r0.xyz = r2.xyz * 2 + -1;
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r1.y = -r2.w + 1;
	r1.y = -r2.x + r1.y;
	r1.yz = (r1.yy >= 0) ? r2.wy : r2.xy;
	r1.yz = r1.yz * 2 + -1;
	r2.xy = r1.yz * bumpiness.xx;
	r1.y = dot(r2.xy, -r2.xy) + 1;
	r2.w = max(r1.y, 0);
	r1.y = rsqrt(r2.w);
	r2.z = 1 / r1.y;
	r0.xyz = r0.xyz * i.texcoord1.zzz + -r2.xyz;
	r0.xyz = r0.www * r0.xyz + r2.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r3.xyz = normalize(r0.xyz);
	r0.xyz = (-r0.www >= 0) ? r2.xyz : r3.xyz;
	r0.xyz = (-i.color.yyy >= 0) ? r2.xyz : r0.xyz;
	r1.yzw = r0.xxx * i.texcoord4.xyz;
	r1.yzw = r0.zzz * i.texcoord1.xyz + r1.yzw;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r1.yzw;
	r0.xyz = r0.xyz + 1E-05;
	r2.xyz = normalize(r0.xyz);
	o.color1.xyz = r2.xyz * 0.5 + 0.5;
	r3 = tex2D(SpecSampler, i.texcoord.xy);
	r0.x = dot(r3, specMapExpMask);
	r0.x = r0.x * specularFactor.x;
	r4.y = max(1, r0.x);
	r4.x = dot(r3.xyz, specMapIntMask.xyz);
	r0.x = dot(r3.xyz, specMapReflectMask.xyz);
	r1.yz = lerp(r4.xy, gWaterGlobals.zw, r0.ww);
	r0.yz = (-r0.ww >= 0) ? r4.xy : r1.yz;
	r0.yz = (-i.color.yy >= 0) ? r4.xy : r0.yz;
	r0.z = saturate(r0.z * 0.0051020407);
	o.color2.x = r0.y;
	r0.y = rsqrt(r0.z);
	o.color2.y = 1 / r0.y;
	r0.yzw = 1E-05 + i.texcoord3.xyz;
	r3.xyz = normalize(r0.yzw);
	r0.y = dot(-r3.xyz, r2.xyz);
	r0.y = r0.y + r0.y;
	r0.yzw = r2.xyz * -r0.yyy + -r3.xyz;
	r1.y = saturate(dot(r3.xyz, r2.xyz));
	r1.y = -r1.y + 1.00001;
	r2.x = pow(r1.y, 5.00001);
	r0.yzw = r0.yzw + 1E-05;
	r0.z = dot(r0.yzw, r0.yzw);
	r0.z = rsqrt(r0.z);
	r0.yz = r0.yw * r0.zz + 1;
	r0.yz = r0.yz * -0.5;
	r3 = tex2D(EnvironmentSampler, r0.yz);
	r4.x = 1;
	r0.y = r4.x + -fresnelRolloff.x;
	r0.y = fresnelRolloff.x * r2.x + r0.y;
	r0.yzw = r0.yyy * r3.xyz;
	r0.yzw = r0.yzw * reflectivePower.xxx;
	r0.xyz = r0.xxx * r0.yzw;
	r0.xyz = r0.xyz * globalScalars.www;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.color3.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.color3.z = 1 / r0.y;
	o.color3.y = 1 / r0.x;
	o.color.w = r1.x;
	o.color1.w = r1.x;
	o.color2.w = r1.x;
	o.color2.z = i.color.x;
	o.color3.w = gStencil.x;

	return o;
}
