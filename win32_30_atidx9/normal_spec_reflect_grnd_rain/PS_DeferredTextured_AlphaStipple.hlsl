sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s4);
sampler2D PuddleMaskSampler : register(s2);
sampler2D SpecSampler : register(s3);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c204);
float bumpiness : register(c199);
float fresnelRolloff : register(c201);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
float4 gWaterGlobals : register(c64);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float reflectivePower : register(c200);
float4 specMapExpMask : register(c198);
float3 specMapIntMask : register(c197);
float3 specMapReflectMask : register(c202);
float specularFactor : register(c196);
float4 stipplePattern : register(c62);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float2 texcoord6 : TEXCOORD6;
	float2 vpos : VPOS;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color2 : COLOR2;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.w = r0.w * i.color.w;
	r1.x = r0.w * globalScalars.x;
	r1.yz = 0.5 * i.vpos.xy;
	r1.yz = frac(abs(r1.yz));
	r1.yz = (i.vpos.xy >= 0) ? r1.yz : -r1.yz;
	r1.yz = r1.yz + r1.yz;
	r2.xy = frac(r1.yz);
	r1.yz = r1.yz + -r2.xy;
	r1.y = r1.z * 2 + r1.y;
	r2 = r1.y + float4(-0, -1, -2, -3);
	r2 = (-abs(r2) >= 0) ? 1 : 0;
	r1.y = dot(stipplePattern, r2);
	r0.w = r0.w * -globalScalars.x + r1.y;
	r2 = (r0.w >= 0) ? -1 : -0;
	clip(r2);
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r2.w + 1;
	r0.w = -r2.x + r0.w;
	r1.yz = (r0.ww >= 0) ? r2.wy : r2.xy;
	r1.yz = r1.yz * 2 + -1;
	r2.xy = r1.yz * bumpiness.xx;
	r0.w = dot(r2.xy, -r2.xy) + 1;
	r1.y = max(r0.w, 0);
	r0.w = rsqrt(r1.y);
	r2.z = 1 / r0.w;
	r3 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r3, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r4.x = dot(r3.xyz, specMapIntMask.xyz);
	r4.y = max(1, r0.w);
	r1.yz = WetDarken.ww * i.texcoord6.xy;
	r5 = tex2D(PuddleMaskSampler, r1.yz);
	r0.w = r5.x + gWaterGlobals.y;
	r0.w = saturate(r0.w + -i.color.y);
	r1.yzw = r0.xyz * WetDarken.xyz;
	r5.xy = lerp(r4.xy, gWaterGlobals.zw, r0.ww);
	r4.zw = 0.3 * i.texcoord6.xy;
	r6 = tex2D(WaterRainRippleNormalSampler, r4.zw);
	r6.xyz = r6.xyz * 2 + -1;
	r6.xyz = r6.xyz * i.texcoord1.zzz + -r2.xyz;
	r6.xyz = r0.www * r6.xyz + r2.xyz;
	r6.xyz = r6.xyz + 1E-05;
	r7 = normalize(r6.xyz);
	r2.w = saturate(gWaterGlobals.y);
	r6.xyz = r0.xyz * WetDarken.xyz + -r0.xyz;
	r6.xyz = r2.www * r6.xyz + r0.xyz;
	r1.yzw = (-r0.www >= 0) ? r6.xyz : r1.yzw;
	r6.xyz = (-r0.www >= 0) ? r2.xyz : r7.xyz;
	r4.zw = (-r0.ww >= 0) ? r4.xy : r5.xy;
	r2.xyz = (-i.color.yyy >= 0) ? r2.xyz : r6.xyz;
	r0.xyz = (-i.color.yyy >= 0) ? r0.xyz : r1.yzw;
	r1.yz = (-i.color.yy >= 0) ? r4.xy : r4.zw;
	r4.xyz = r2.xxx * i.texcoord4.xyz;
	r2.xzw = r2.zzz * i.texcoord1.xyz + r4.xyz;
	r2.xyz = r2.yyy * i.texcoord5.xyz + r2.xzw;
	r2.xyz = r2.xyz + 1E-05;
	r4.xyz = normalize(r2.xyz);
	r2.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r2.xyz);
	r0.w = dot(-r5.xyz, r4.xyz);
	r0.w = r0.w + r0.w;
	r2.xyz = r4.xyz * -r0.www + -r5.xyz;
	r2.xyz = r2.xyz + 1E-05;
	r0.w = dot(r2.xyz, r2.xyz);
	r0.w = rsqrt(r0.w);
	r2.xy = r2.xz * r0.ww + 1;
	r2.xy = r2.xy * -0.5;
	r2 = tex2D(EnvironmentSampler, r2.xy);
	r0.w = saturate(dot(r5.xyz, r4.xyz));
	r5.z = 1;
	r1.w = r5.z + -fresnelRolloff.x;
	r0.w = -r0.w + 1.00001;
	r2.w = pow(r0.w, 5.00001);
	r0.w = fresnelRolloff.x * r2.w + r1.w;
	r2.xyz = r0.www * r2.xyz;
	r2.xyz = r2.xyz * reflectivePower.xxx;
	r0.w = dot(r3.xyz, specMapReflectMask.xyz);
	r2.xyz = r0.www * r2.xyz;
	r2.xyz = r2.xyz * globalScalars.www;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r3.xyz = lerp(r0.www, r0.xyz, gAdrenoFXVars.xxx);
	r0.w = saturate(gAmbientOcclusionEffect.z + gAmbientOcclusionEffect.z);
	r5.xyz = lerp(r0.xyz, r3.xyz, r0.www);
	r0.x = saturate(-1 + i.color.x);
	o.color.xyz = r0.xxx * globalScalars2.zzz + r5.xyz;
	o.color1.xyz = r4.xyz * 0.5 + 0.5;
	r0.x = saturate(r1.z * 0.0051020407);
	r0.x = rsqrt(r0.x);
	o.color2.y = 1 / r0.x;
	r0.xyz = saturate(r2.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	o.color3.x = 1 / r0.x;
	o.color3.y = 1 / r0.y;
	o.color3.z = 1 / r0.z;
	o.color.w = r1.x;
	o.color1.w = r1.x;
	o.color2.z = i.color.x;
	o.color2.xw = r1.yx;
	o.color3.w = gStencil.x;

	return o;
}
