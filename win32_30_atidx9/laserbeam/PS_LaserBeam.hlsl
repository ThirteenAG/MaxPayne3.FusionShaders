sampler2D DepthMapTexSampler : register(s12);
sampler2D DiffuseTexSampler : register(s0);
sampler2D LaserSampler : register(s1);
float4 LaserVisibilityMinMax : register(c102);
float4 TexelSize : register(c96);
float4 globalScalars2 : register(c36);
float4 globalScreenSize : register(c41);

struct PS_IN
{
	float3 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float2 texcoord2 : TEXCOORD2;
	float4 texcoord4 : TEXCOORD4;
	float2 vpos : VPOS;
	float4 texcoord3 : TEXCOORD3;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0.xz = 1 / globalScreenSize.xx;
	r0.yw = 1 / globalScreenSize.yy;
	r0 = r0 * i.vpos.xyxy;
	r1.w = 0.25;
	r1 = r1.w * globalScreenSize.xyxy;
	r0 = r0 * r1 + 0.03;
	r2 = frac(r0.zwzw);
	r0 = r0 + -r2;
	r0 = r0 + 0.5;
	r2.xz = 1 / r1.zz;
	r2.yw = 1 / r1.ww;
	r0 = r0 * r2;
	r1 = tex2D(DepthMapTexSampler, r0.zw);
	r1.x = dot(r1.yzw, float3(255, 1, 0.003921569));
	r1.y = abs(-r1.x);
	r1.x = -r1.x + -15;
	r1.y = r1.y + 1E-05;
	r2.x = pow(r1.y, 0.25001);
	r1.y = r2.x + -1.1892169;
	r1.x = (r1.x >= 0) ? 0.7788265 : r1.y;
	r1.y = 1 / r1.x;
	r1.z = 1E-05 + abs(i.texcoord3.z);
	r2.x = pow(r1.z, 0.25001);
	r1.z = r2.x + -1.1892169;
	r1.y = saturate(r1.y * r1.z);
	r1.y = r1.y * 16;
	r1.z = frac(r1.y);
	r1.y = -r1.z + r1.y;
	r1.yz = r1.yy + float2(0, 1);
	r2.xy = (r1.yy >= 0) ? float2(4, 0.25) : float2(-4, -0.25);
	r1.w = r1.y * r2.y;
	r1.w = frac(r1.w);
	r1.w = r1.w * r2.x;
	r2.x = frac(r1.w);
	r2.y = (-r2.x >= 0) ? 0 : 1;
	r2.x = r1.w + -r2.x;
	r1.w = (r1.w >= 0) ? 0 : r2.y;
	r1.w = r1.w + r2.x;
	r2 = r1.w + float4(-0, -1, -2, -3);
	r3 = r1.w + float4(-1, -2, -3, -4);
	r3 = (r3 >= 0) ? -1 : -0;
	r2 = (r2 >= 0) ? 1 : 0;
	r2 = r3 + r2;
	r3.yz = float2(-0.5, 0.5);
	r4 = TexelSize.xyxy * r3.yyzy + r0.zwzw;
	r0 = TexelSize.xyxy * r3.yzzz + r0;
	r3 = tex2D(DiffuseTexSampler, r4.xy);
	r4 = tex2D(DiffuseTexSampler, r4.zw);
	r5.xy = r1.yz * 0.25;
	r5.zw = frac(r5.xy);
	r5.xy = r5.xy + -r5.zw;
	r1.w = (-r5.z >= 0) ? 0 : 1;
	r5.z = r5.w * 4;
	r1.w = (r1.y >= 0) ? 0 : r1.w;
	r1.xy = r1.xx * r1.yz;
	r1.xy = r1.xy * 0.0625 + 1.1892169;
	r1.xy = abs(r1.xy) + 1E-05;
	r1.z = r1.w + r5.x;
	r6 = r5.y + float4(-0, -1, -2, -3);
	r7 = r1.z + float4(-0, -1, -2, -3);
	r8 = (-abs(r7.x) >= 0) ? r3 : 0;
	r3 = (-abs(r6.x) >= 0) ? r3 : 0;
	r3 = (-abs(r6.y) >= 0) ? r4 : r3;
	r4 = (-abs(r7.y) >= 0) ? r4 : r8;
	r8 = tex2D(DiffuseTexSampler, r0.xy);
	r0 = tex2D(DiffuseTexSampler, r0.zw);
	r4 = (-abs(r7.z) >= 0) ? r8 : r4;
	r3 = (-abs(r6.z) >= 0) ? r8 : r3;
	r3 = (-abs(r6.w) >= 0) ? r0 : r3;
	r0 = (-abs(r7.w) >= 0) ? r0 : r4;
	r0.x = dot(r0, r2);
	r2.x = log2(r1.x);
	r2.y = log2(r1.y);
	r0.yz = r2.xy * 4.00001;
	r0.z = exp2(r0.z);
	r0.y = exp2(r0.y);
	r0.z = -r0.y + r0.z;
	r0.y = -r0.y + i.texcoord3.z;
	r0.z = 1 / r0.z;
	r0.y = saturate(r0.z * r0.y);
	r0.z = frac(r5.z);
	r0.z = r5.z + -r0.z;
	r1 = r0.z + float4(-0, -1, -2, -3);
	r2 = r0.z + float4(-1, -2, -3, -4);
	r2 = (r2 >= 0) ? -1 : -0;
	r1 = (r1 >= 0) ? 1 : 0;
	r1 = r2 + r1;
	r0.z = dot(r3, r1);
	r1.x = lerp(r0.x, r0.z, r0.y);
	r0.x = r1.x + globalScalars2.x;
	r0.y = i.texcoord3.z;
	r0.yz = r0.xy + i.texcoord2.xy;
	r1 = tex2D(LaserSampler, r0.yz);
	r0.y = r1.z * 2 + -1;
	r0.z = dot(i.texcoord.xyz, i.texcoord.xyz);
	r0.z = rsqrt(r0.z);
	r0.z = 1 / r0.z;
	r0.z = saturate(r0.z * 0.5);
	r0.w = r0.z * -2 + 3;
	r0.z = r0.z * r0.z;
	r0.z = r0.w * -r0.z + 1;
	r0.y = r0.z * r0.y + 1;
	r1.xyz = 1E-05 + i.texcoord.xyz;
	r2.xyz = normalize(r1.xyz);
	r0.z = dot(r2.xyz, i.texcoord1.xyz);
	r0.z = abs(r0.z) * 0.5 + 0.5;
	r0.y = r0.z * r0.y;
	r0.x = r0.x * r0.y;
	r1.x = max(r0.x, LaserVisibilityMinMax.x);
	r0.x = min(LaserVisibilityMinMax.y, r1.x);
	r0.y = abs(i.texcoord3.y) * -abs(i.texcoord3.y) + 1;
	r1 = r0.y * i.texcoord4;
	r0 = r0.x * r1;
	r1.x = dot(r0.xyz, r0.www);
	r0.xyz = r1.xxx * 0.5 + r0.xyz;
	r1.x = saturate(5 * i.texcoord3.w);
	o = r0 * r1.x;

	return o;
}
