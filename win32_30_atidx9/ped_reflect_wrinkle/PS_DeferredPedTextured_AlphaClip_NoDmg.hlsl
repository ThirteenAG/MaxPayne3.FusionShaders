sampler2D BumpSampler : register(s5);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s1);
sampler2D SpecSampler : register(s6);
sampler3D VolumeSampler : register(s7);
sampler2D WrinkleMaskSampler_0 : register(s8);
sampler2D WrinkleMaskSampler_1 : register(s9);
sampler2D WrinkleSampler_A : register(s10);
sampler2D WrinkleSampler_B : register(s11);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float4 detailSettings : register(c207);
float fresnelRolloff : register(c199);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float reflectivePower : register(c197);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c198);
float specularFactor : register(c202);
float4 wrinkleMaskStrengths0 : register(c210);
float4 wrinkleMaskStrengths1 : register(c211);
float4 wrinkleMaskStrengths2 : register(c212);
float4 wrinkleMaskStrengths3 : register(c213);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r0.z = -r1.w + 1;
	r0.z = -r1.x + r0.z;
	r0.zw = (r0.zz >= 0) ? r1.wy : r1.xy;
	r0 = r0 + -0.5;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r1.z = -r1.w + 1;
	r1.z = -r1.x + r1.z;
	r1.xy = (r1.zz >= 0) ? r1.wy : r1.xy;
	r1.zw = r1.xy + -0.5;
	r1.xy = r1.xy * 2 + -1;
	r1 = r1 * bumpiness.x;
	r1.zw = r1.zw + r1.zw;
	r0.zw = r0.zw * 2 + -r1.zw;
	r2 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r3.x = dot(wrinkleMaskStrengths0, r2);
	r2.x = dot(wrinkleMaskStrengths2, r2);
	r4 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r2.y = dot(wrinkleMaskStrengths1, r4);
	r2.z = dot(wrinkleMaskStrengths3, r4);
	r2.x = r2.z + r2.x;
	r2.y = r2.y + r3.x;
	r0.zw = r2.yy * r0.zw + r1.zw;
	r0.xy = r0.xy * 2 + -r0.zw;
	r0.xy = r2.xx * r0.xy + r0.zw;
	r0.w = dot(r0.xy, -r0.xy) + 1;
	r1.z = max(r0.w, 0);
	r0.w = rsqrt(r1.z);
	r0.z = 1 / r0.w;
	r0.xyz = r0.xyz + 1E-05;
	r2.xyz = normalize(r0.xyz);
	r0.xyz = r2.xxx * i.texcoord4.xyz;
	r0.xyz = i.texcoord1.xyz * r2.zzz + r0.xyz;
	r0.xyz = i.texcoord5.xyz * r2.yyy + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r2.xyz = r0.xyz * r0.www + 1E-05;
	r0.xyz = r0.www * r0.xyz;
	r3.xyz = normalize(r2.xyz);
	r2.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r2.xyz = r2.xyz + 1E-05;
	r4.xyz = normalize(r2.xyz);
	r0.w = dot(r4.xyz, r3.xyz);
	r1.z = r0.w * 1.5 + 1;
	r0.w = (-r0.w >= 0) ? r1.z : 1;
	r1.z = r0.w * i.texcoord2.y;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = saturate(dot(r2.xyz, specMapIntMask.xyz));
	r3.x = r1.w * matMaterialColorScale.w;
	r3.x = saturate(r3.x * 5);
	r1.z = r1.z * r3.x;
	r2.w = dot(r2, specMapExpMask);
	r2.w = r2.w * specularFactor.x;
	r3.x = max(1, r2.w);
	r2.w = r3.x * matMaterialColorScale.w;
	r3.x = saturate(r2.w * -0.01 + 1);
	r4.x = r2.w * 0.015625;
	r4.x = saturate(r4.x);
	r2.w = rsqrt(r4.x);
	o.color2.y = 1 / r2.w;
	r1.z = r1.z * r3.x;
	r0.w = (r0.w >= 0) ? r1.z : 0;
	r0.w = r1.w * matMaterialColorScale.w + r0.w;
	r1.z = r2.z * 16;
	r1.w = frac(r1.z);
	r1.z = r1.z + -r1.w;
	r1.w = (-r1.w >= 0) ? 0 : 1;
	r1.w = (r2.z >= 0) ? 0 : r1.w;
	r2.x = dot(r2.xyz, specMapReflectMask.xyz);
	r1.z = r1.w + r1.z;
	r1.z = r1.z + 0.5;
	r3.z = r1.z * 0.0625;
	r3.xy = detailSettings.zw * i.texcoord.xy;
	r3 = tex3D(VolumeSampler, r3.xyz);
	r2.yzw = r3.yzx * 2 + -1;
	r1.z = detailSettings.x * i.texcoord2.w;
	r1.z = r2.w * r1.z + 1;
	o.color2.x = saturate(r0.w * r1.z);
	r0.w = 0.1;
	r0.w = saturate(r0.w + deSatContrastGamma.x);
	r0.w = 1 / r0.w;
	r0.w = r0.w * gAdrenoFXVars.z;
	r3 = tex2D(DiffuseSampler, i.texcoord.xy);
	r3.xyz = r3.xyz * matMaterialColorScale.xxx;
	r1.w = r3.w * i.texcoord2.w;
	r1.w = r1.w * globalScalars.x;
	r4.xyz = r1.zzz * r3.xyz;
	r2.w = dot(r4.xyz, float3(0.2125, 0.7154, 0.0721));
	r3.xyz = r3.xyz * r1.zzz + -r2.www;
	r3.xyz = r0.www * r3.xyz + r2.www;
	r5.x = 1;
	r5.yzw = saturate(r5.xxx + -ColorCorrectTopAndPedReflectScale.xyz);
	r5.yzw = r5.yzw * 0.25 + 1;
	r3.xyz = r3.xyz * r5.yzw + -r4.xyz;
	r0.w = saturate(gAmbientOcclusionEffect.z);
	o.color.xyz = r0.www * r3.xyz + r4.xyz;
	o.color2.z = saturate(r0.w + i.texcoord2.x);
	r3.xyz = r2.zzz * i.texcoord5.xyz;
	r2.yzw = i.texcoord4.xyz * r2.yyy + r3.xyz;
	r2.yzw = r2.yzw * detailSettings.yyy;
	r0.xyz = r2.yzw * i.texcoord2.www + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r3.xyz = normalize(r0.xyz);
	o.color1.xyz = r3.xyz * 0.5 + 0.5;
	r0.x = dot(r1.xy, -r1.xy) + 1;
	r1.z = max(r0.x, 0);
	r0.x = rsqrt(r1.z);
	r0.x = 1 / r0.x;
	r0.yzw = r1.xxx * i.texcoord4.xyz;
	r0.xyz = r0.xxx * i.texcoord1.xyz + r0.yzw;
	r0.xyz = r1.yyy * i.texcoord5.xyz + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0.xyz = 1E-05 + i.texcoord3.xyz;
	r3.xyz = normalize(r0.xyz);
	r0.x = dot(-r3.xyz, r1.xyz);
	r0.x = r0.x + r0.x;
	r0.xyz = r1.xyz * -r0.xxx + -r3.xyz;
	r0.w = saturate(dot(r3.xyz, r1.xyz));
	r0.w = -r0.w + 1.00001;
	r1.x = pow(r0.w, 5.00001);
	r0.xyz = r0.xyz + 1E-05;
	r3.xyz = normalize(r0.xyz);
	r0.x = saturate(r3.z);
	r0.x = r0.x + 1;
	r0.x = r0.x + r0.x;
	r0.x = 1 / r0.x;
	r0.xy = r3.xy * r0.xx + 0.5;
	r0.xy = -r0.xy + 1;
	r0.zw = 0;
	r0 = tex2Dlod(EnvironmentSampler, r0);
	r0.xyz = r0.xyz * r0.xyz;
	r0.xyz = r0.xyz * 16;
	r0.w = r5.x + -fresnelRolloff.x;
	r0.w = fresnelRolloff.x * r1.x + r0.w;
	r0.xyz = r0.www * r0.xyz;
	r3 = tex2D(EnvironmentSampler, i.texcoord.xy);
	r0.xyz = r0.xyz * r3.www;
	r0.xyz = r0.xyz * reflectivePower.xxx;
	r0.xyz = r2.xxx * r0.xyz;
	r0.xyz = r0.xyz * ColorCorrectTopAndPedReflectScale.www;
	r0.xyz = r0.xyz * matMaterialColorScale.zzz;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.color3.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.color3.z = 1 / r0.y;
	o.color3.y = 1 / r0.x;
	o.color.w = r1.w;
	o.color1.w = r1.w;
	o.color2.w = r1.w;
	o.color3.w = gStencil.x;

	return o;
}
