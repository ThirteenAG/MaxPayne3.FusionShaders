	r2.y = r2.y * shaderVariables.x;
	r2.x = rsqrt(r2.x);
	r2.x = 1 / r2.x;
	r1.w = r2.y * r1.w + r2.x;
	r2.xzw = r1.xyz * r1.www;
	r2.xyz = r2.yyy * r3.xyz + -r2.xzw;
	r2.xyz = r2.xyz + 1E-05;
	r1.w = dot(r2.xyz, r2.xyz);
	r1.w = rsqrt(r1.w);
	r0 = r0 + gWorldViewProj[3].zxyw;
	r0.w = 1 / r0.w;
	r0.yz = r0.ww * r0.yz;
	r0.yz = r0.yz * float2(0.5, -0.5) + 0.5;
	r2.xyz = r2.xyz * r1.www + i.texcoord6.xyz;
	r2.yw = r2.yy * gWorldViewProj[1].xw;
	r2.xy = r2.xx * gWorldViewProj[0].xw + r2.yw;
	r2.xy = r2.zz * gWorldViewProj[2].xw + r2.xy;
	r2.xy = r2.xy + gWorldViewProj[3].xw;
	r0.w = 1 / r2.y;
	r0.w = r0.w * r2.x;
	r0.w = r0.w * 0.5 + 0.5;
	r2.x = -r0.y + r0.w;
	r2.y = 0;
	r0.w = -nearFarClip.x + nearFarClip.y;
	r0.w = 1 / r0.w;
	r1.w = r0.w * nearFarClip.y;
	r1.w = r1.w * -nearFarClip.x;
	r5 = float3(0, 1, 0.2);
	for (int i0 = 0; i0 < 5; i0++) {
		r2.zw = r5.zz * r2.xy + r0.yz;
		r6 = tex2D(DepthSampler, r2.zw);
		r2.z = nearFarClip.y * -r0.w + r6.x;
