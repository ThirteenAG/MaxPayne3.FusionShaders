	r2.z = r5.x + -0.2;
	r3.w = max(r2.z, 0);
	r0.yz = r3.ww * r2.xy + r0.yz;
	r2 = tex2D(DepthSampler, r0.yz);
	r0.w = nearFarClip.y * -r0.w + r2.x;
	r0.w = 1 / r0.w;
	r2.x = saturate(r4.z);
	r2.x = r2.x + 1;
	r2.x = r2.x + r2.x;
	r2.x = 1 / r2.x;
	r2.xy = r4.xy * r2.xx + 0.5;
	r2.xy = -r2.xy + 1;
	r2.zw = 0;
	r2 = tex2Dlod(ReflectanceSampler, r2);
	r2.xyz = r2.xyz * r2.xyz;
	r2.xyz = r2.xyz * 16;
	r4 = tex2D(RefractSampler, r0.yz);
	r0.x = r1.w * r0.w + -r0.x;
	r1.w = max(r0.x, 0.01);
	r0.x = r1.w * -waterColor.w;
	r0.x = r0.x * 1.442695;
	r0.x = exp2(r0.x);
	r0.y = r0.x + -65504;
	r0.x = -r0.x + 1;
	r0.x = (r0.y >= 0) ? -65503 : r0.x;
	r5 = lerp(r4.xyz, waterColor.xyz, r0.xxx);
	r0.w = waterColor.w;
	r0.x = r0.w * shaderVariables.w;
	r0.yzw = r2.xyz * waterColor.xyz + -r2.xyz;
	r0.xyz = r0.xxx * r0.yzw + r2.xyz;
	r0.w = dot(-r3.xyz, r1.xyz);
	r1.y = -1;
	r1.x = -r1.y + -shaderVariables.z;
	r0.w = saturate(-r0.w + 1);
	r0.w = r0.w + 1E-05;
	r1.y = pow(r0.w, 5.00001);
	r0.w = saturate(shaderVariables.z * r1.y + r1.x);
	r0.w = r0.w * shaderVariables.y;
	r1.xyz = lerp(r5.xyz, r0.xyz, r0.www);
	r0.x = 1 / globalScreenSize.y;
	r0.y = r0.x * i.vpos.y;
	r2.x = gAdrenoFXVars.x;
	r0.z = r2.x * deSatContrastGamma.x;
	r0.w = dot(r1.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.xyz = lerp(r0.www, r1.xyz, r0.zzz);
	r0.z = r0.w * ColorShift.w;
	r1.xyz = r0.zzz * ColorShift.xyz;
	r1.w = saturate(r0.z);
	r3.xyz = ColorShift.xyz * -r0.zzz + r2.xyz;
	r1.xyz = r1.www * r3.xyz + r1.xyz;
	r3.xyz = ColorCorrectBottomOffset.xyz;
	r3.xyz = r0.yyy * r3.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r1.xyz = r1.xyz * r3.xyz;
	r0.z = r0.w * ColorCorrectBottomOffset.w;
	r3.xyz = r0.zzz * globalScalars4.yzw;
	r0.w = saturate(r0.z);
	r2.xyz = globalScalars4.yzw * -r0.zzz + r2.xyz;
	r2.xyz = r0.www * r2.xyz + r3.xyz;
