	r0.x = r0.z * i.vpos.x;
	r0.xy = r0.xy + -0.5;
	r0.x = dot(r0.xy, r0.xy) + 0;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.y = r3.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r0.y = (r0.y >= 0) ? -r0.y : -0;
	r0.x = r0.y + r0.x;
	r0.y = r0.y + ColorCorrectTopScreenEdge.w;
	r0.y = 1 / r0.y;
	r0.y = saturate(r0.y * r0.x);
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r1.w = 1;
	r2.w = 1;
	r3 = lerp(r1, r2, r0.x);
	o = (ColorCorrectTopScreenEdge.w >= 0) ? r3 : r1;

	return o;
}
