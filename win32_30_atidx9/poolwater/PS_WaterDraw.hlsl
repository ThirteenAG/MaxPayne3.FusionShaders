	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float4 r6;
	r0 = tex2D(WaterSurfaceSampler, i.texcoord.xy);
	r0.xyz = r0.xyz * 2 + -1;
	r0.xyz = i.texcoord1.xyz * 20 + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
