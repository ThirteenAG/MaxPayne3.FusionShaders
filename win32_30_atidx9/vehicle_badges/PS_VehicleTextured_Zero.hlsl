struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r0.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r0.xyz;
	r0.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gShadowMatrix[3].xyz;
	r1.xy = r0.xy + -gShadowParam18192021.zw;
	r2.xyz = r1.xxx + -gCascadeXMaxThresholds.xyz;
	r2.xyz = (r2.xyz >= 0) ? 1 : 0;
	r3.xyz = -r1.xxx + gCascadeXMinThresholds.xyz;
	r3.xyz = (r3.xyz >= 0) ? 1 : 0;
	r2.xyz = r2.xyz + r3.xyz;
	r3.xyz = r1.yyy + -gCascadeYMaxThresholds.xyz;
	r3.xyz = (r3.xyz >= 0) ? 1 : 0;
	r2.xyz = r2.xyz + r3.xyz;
	r3.xyz = -r1.yyy + gCascadeYMinThresholds.xyz;
	r3.xyz = (r3.xyz >= 0) ? 1 : 0;
	r2.yzw = saturate(r2.xyz + r3.xyz);
	r2.x = 1;
	r3.x = dot(r2, gShadowParam0123);
	r3.y = dot(r2, gShadowParam4567);
	r3.z = dot(r2, gCascadeZScales);
	r4.x = dot(r2, gShadowParam891113);
	r4.y = dot(r2, gShadowParam14151617);
	r4.z = dot(r2, gCascadeZOffsets);
	r0.xyz = r0.zxy * r3.zxy + r4.zxy;
	r0.x = saturate(r0.x);
	r3 = tex2D(gShadowZSamplerDir, r0.yz);
	r0.x = -r0.x + 1;
	r0.x = -r3.x + r0.x;
	r0.x = (r0.x >= 0) ? -1 : -0;
	r2.x = abs(gCascadeXMinThresholds.w);
	r2.y = abs(gCascadeYMinThresholds.w);
	r3.x = abs(gCascadeXMaxThresholds.w);
	r3.y = abs(gCascadeYMaxThresholds.w);
	r0.yz = max(r2.xy, r3.xy);
	r1.zw = r0.yz + -0.25;
	r0.yz = r0.yz + -r1.zw;
	r1.xy = -r1.zw + abs(r1.xy);
	r2.x = 1 / r0.y;
	r2.y = 1 / r0.z;
	r0.yz = saturate(r1.xy * r2.xy);
	r1.xy = r0.yz * -2 + 3;
	r0.yz = r0.yz * r0.yz;
	r0.yz = r0.yz * r1.xy;
	r1.x = max(r0.y, r0.z);
	r0.y = r2.w + r1.x;
	r0.x = r0.x + r0.y;
	r0.x = saturate(r0.x + 1);
	r0.yzw = gDirectionalColour.www * gDirectionalColour.xyz;
	r0.xyz = r0.xxx * r0.yzw;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r1.w + 1;
	r0.w = -r1.x + r0.w;
	r1.xy = (r0.ww >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r0.w = dot(r1.xy, -r1.xy) + 1;
	r1.z = max(r0.w, 0);
	r0.w = rsqrt(r1.z);
	r0.w = 1 / r0.w;
	r1.xzw = r1.xxx * i.texcoord4.xyz;
	r1.xzw = r0.www * i.texcoord1.xyz + r1.xzw;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r1.xzw;
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r0.w = dot(r2.xyz, -gDirectionalLight.xyz);
	r1.x = saturate(r0.w + -0.25);
	r0.w = saturate(r0.w * 2 + -0.5);
	r1.x = r1.x * 1.3333334;
	r1.xyz = r0.xyz * r1.xxx;
	r1.w = saturate(r2.z * -0.5 + 0.5);
	r3.xyz = gLightAmbient0.xyz;
	r3.xyz = -r3.xyz + gLightAmbient1.xyz;
	r3.xyz = r1.www * r3.xyz + gLightAmbient0.xyz;
	r1.w = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r4.z = globalScalars.z;
	r2.w = r4.z * gAmbientOcclusionEffect.y;
	r1.w = r1.w * r2.w;
	r3.xyz = r1.www * r3.xyz;
	r1.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r3.xyz * r1.www + r1.xyz;
	r1.w = dot(r1.xyz, 0.33333334);
	r3.xyz = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r3.xyz);
	r2.w = dot(-r4.xyz, r2.xyz);
	r2.w = r2.w + r2.w;
	r3.xyz = r2.xyz * -r2.www + -r4.xyz;
	r2.x = saturate(dot(r4.xyz, r2.xyz));
	r2.x = -r2.x + 1.00001;
	r3.w = pow(r2.x, 5.00001);
	r2.xyz = r3.xyz + 1E-05;
	r2.w = saturate(dot(-gDirectionalLight.xyz, r3.xyz));
	r2.w = r2.w + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r2.x = saturate(r3.z);
	r2.x = r2.x + 1;
	r2.x = r2.x + r2.x;
	r2.x = 1 / r2.x;
	r2.xy = r3.xy * r2.xx + 0.5;
	r4.xy = -r2.xy + 1;
	r4.zw = 0;
	r4 = tex2Dlod(EnvironmentSampler, r4);
	r2.xyz = r4.xyz * r4.xyz;
	r2.xyz = r2.xyz * 16;
	r3.x = 1;
	r3.y = r3.x + -fresnelRolloff.x;
	r3.y = fresnelRolloff.x * r3.w + r3.y;
	r2.xyz = r2.xyz * r3.yyy;
	r3.y = saturate(r3.y);
	r2.xyz = r2.xyz * reflectivePower.xxx;
	r2.xyz = r2.xyz * globalFogColorN.www;
	r2.xyz = r3.yyy * r2.xyz;
	r2.xyz = r1.www * r2.xyz;
	r4 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r4, specMapExpMask);
	r3.y = dot(r4.xyz, specMapIntMask.xyz);
	r3.y = saturate(r3.y * specularColorFactor.x);
	r3.x = r1.w * -specularFactor.x + r3.x;
	r4.x = 1E-05;
	r1.w = r1.w * specularFactor.x + r4.x;
	r1.w = (r3.x >= 0) ? 1.00001 : r1.w;
	r3.x = pow(r2.w, r1.w);
	r0.w = r0.w * r3.x;
	r0.xyz = r0.www * r0.xyz;
	r0.xyz = r0.xyz * gDirectionalLight.www;
	r0.xyz = r0.xyz * r3.yyy + r2.xyz;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r3.xyz = r2.xyz * r2.xyz;
	r2.xyz = r3.xyz * matDiffuseColor.xyz;
	r2 = r2 * i.texcoord6;
	r0.xyz = r2.xyz * r1.xyz + r0.xyz;
	r1.w = r2.w * globalScalars.x;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r2.y = -r2.x + 1;
	r2.xy = r2.yy * gDepthFxParams.xy + r2.xx;
	r3.xyz = lerp(r0.www, r0.xyz, r2.xxx);
	r0.x = r0.w + 1E-05;
	r0.x = abs(r0.x) + 1E-05;
	r0.y = r2.y + -0.99999;
	r2.x = pow(r0.x, r0.y);
	r1.xyz = globalFogColorN.xyz;
	r0.xyz = r3.xyz * r2.xxx + -r1.xyz;
	r2.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r2.w = r2.z * globalFogParams.x;
	r2.x = dot(r2.xyz, r2.xyz);
	r2.x = rsqrt(r2.x);
	r2.x = 1 / r2.x;
	r2.x = r2.x * globalFogParams.z;
	r2.y = r2.w * -1.442695;
	r2.y = exp2(r2.y);
	r2.z = r2.y + -65504;
	r2.y = -r2.y + 1;
	r2.y = (r2.z >= 0) ? -65503 : r2.y;
	r2.z = 1 / r2.w;
	r2.w = -abs(r2.w) + 0.0001;
	r2.y = r2.z * r2.y;
	r2.y = r2.y * r2.x;
	r2.x = (r2.w >= 0) ? r2.x : r2.y;
	r2.x = r2.x * -globalFogParams.y;
	r2.x = r2.x * 1.442695;
	r2.x = saturate(exp2(r2.x));
	r0.w = 0;
	r0 = r2.x * r0 + r1;
	r1.w = r0.w;
	r2.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r3.x = gAdrenoFXVars.x;
	r2.y = r3.x * deSatContrastGamma.x;
	r3.xyz = lerp(r2.xxx, r0.xyz, r2.yyy);
	r2.y = r2.x * ColorCorrectBottomOffset.w;
	r2.x = r2.x * ColorShift.w;
	r4.xyz = globalScalars4.yzw * -r2.yyy + r3.xyz;
	r3.xyz = ColorShift.xyz * -r2.xxx + r3.xyz;
	r5.xyz = r2.yyy * globalScalars4.yzw;
	r2.y = saturate(r2.y);
	r2.yzw = r2.yyy * r4.xyz + r5.xyz;
	r3.w = 1 / globalScreenSize.y;
	r4.y = r3.w * i.vpos.y;
	r5 = ColorCorrectTopScreenEdge;
	r5.xyz = r4.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r5.xyz;
	r1.xyz = r2.yzw * r5.xyz;
	r2.yzw = r2.xxx * ColorShift.xyz;
	r2.x = saturate(r2.x);
	r2.xyz = r2.xxx * r3.xyz + r2.yzw;
	r3.xyz = ColorCorrectBottomOffset.xyz;
	r3.xyz = r4.yyy * r3.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r2.xyz * r3.xyz;
	r2.x = 1 / globalScreenSize.x;
	r4.x = r2.x * i.vpos.x;
	r2.xy = r4.xy + -0.5;
	r2.x = dot(r2.xy, r2.xy) + 0;
	r2.x = rsqrt(r2.x);
	r2.x = 1 / r2.x;
	r2.y = r5.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r2.y = (r2.y >= 0) ? -r2.y : -0;
	r2.x = r2.y + r2.x;
	r2.y = r2.y + ColorCorrectTopScreenEdge.w;
	r2.y = 1 / r2.y;
	r2.y = saturate(r2.y * r2.x);
	r2.x = (r2.x >= 0) ? r2.y : 0;
	r3 = lerp(r0, r1, r2.x);
	o = (ColorCorrectTopScreenEdge.w >= 0) ? r3 : r0;

	return o;
}
