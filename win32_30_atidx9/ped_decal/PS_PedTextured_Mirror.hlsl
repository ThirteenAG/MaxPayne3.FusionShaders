float3 AmbientLightingParams : register(c207);
sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s2);
float bumpiness : register(c200);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float specularFactor : register(c202);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float4 r10;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.w = r0.w * i.texcoord7.w;
	r0.xyz = r0.xyz * r0.xyz;
	o.w = r0.w * globalScalars.x;
	r1.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r1.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r1.xyz;
	r1.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r1.xyz;
	r1.xyz = r1.xyz + gShadowMatrix[3].xyz;
	r2.xy = r1.xy + -gShadowParam18192021.zw;
	r3.xyz = r2.xxx + -gCascadeXMaxThresholds.xyz;
	r3.xyz = (r3.xyz >= 0) ? 1 : 0;
	r4.xyz = -r2.xxx + gCascadeXMinThresholds.xyz;
	r4.xyz = (r4.xyz >= 0) ? 1 : 0;
	r3.xyz = r3.xyz + r4.xyz;
	r4.xyz = r2.yyy + -gCascadeYMaxThresholds.xyz;
	r4.xyz = (r4.xyz >= 0) ? 1 : 0;
	r3.xyz = r3.xyz + r4.xyz;
	r4.xyz = -r2.yyy + gCascadeYMinThresholds.xyz;
	r4.xyz = (r4.xyz >= 0) ? 1 : 0;
	r3.yzw = saturate(r3.xyz + r4.xyz);
	r3.x = 1;
	r4.x = dot(r3, gShadowParam0123);
	r4.y = dot(r3, gShadowParam4567);
	r4.z = dot(r3, gCascadeZScales);
	r5.x = dot(r3, gShadowParam891113);
	r5.y = dot(r3, gShadowParam14151617);
	r5.z = dot(r3, gCascadeZOffsets);
	r1.xyz = r1.zxy * r4.zxy + r5.zxy;
	r1.x = saturate(r1.x);
	r4 = tex2D(gShadowZSamplerDir, r1.yz);
	r0.w = -r1.x + 1;
	r0.w = -r4.x + r0.w;
	r0.w = (r0.w >= 0) ? -1 : -0;
	r1.x = abs(gCascadeXMinThresholds.w);
	r1.y = abs(gCascadeYMinThresholds.w);
	r3.x = abs(gCascadeXMaxThresholds.w);
	r3.y = abs(gCascadeYMaxThresholds.w);
	r2.zw = max(r1.xy, r3.xy);
	r1.xy = r2.zw + -0.25;
	r1.zw = -r1.xy + r2.zw;
	r1.xy = -r1.xy + abs(r2.xy);
	r2.x = 1 / r1.z;
	r2.y = 1 / r1.w;
	r1.xy = saturate(r1.xy * r2.xy);
	r1.zw = r1.xy * -2 + 3;
	r1.xy = r1.xy * r1.xy;
	r1.xy = r1.xy * r1.zw;
	r2.x = max(r1.x, r1.y);
	r1.x = r3.w + r2.x;
	r0.w = r0.w + r1.x;
	r0.w = saturate(r0.w + 1);
	r1.xyz = gDirectionalColour.www * gDirectionalColour.xyz;
	r1.xyz = r0.www * r1.xyz;
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r2.w + 1;
	r0.w = -r2.x + r0.w;
	r2.xy = (r0.ww >= 0) ? r2.wy : r2.xy;
	r2.xy = r2.xy * 2 + -1;
	r2.xy = r2.xy * bumpiness.xx;
	r0.w = dot(r2.xy, -r2.xy) + 1;
	r1.w = max(r0.w, 0);
	r0.w = rsqrt(r1.w);
	r0.w = 1 / r0.w;
	r2.xzw = r2.xxx * i.texcoord4.xyz;
	r2.xzw = r0.www * i.texcoord1.xyz + r2.xzw;
	r2.xyz = r2.yyy * i.texcoord5.xyz + r2.xzw;
	r2.xyz = r2.xyz + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r2.xyz = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r2.xyz);
	r0.w = dot(-r4.xyz, r3.xyz);
	r0.w = r0.w + r0.w;
	r2.xyz = r3.xyz * -r0.www + -r4.xyz;
	r0.w = saturate(dot(-gDirectionalLight.xyz, r2.xyz));
	r0.w = r0.w + 1E-05;
	r4 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r4, specMapExpMask);
	r2.w = dot(r4.xyz, specMapIntMask.xyz);
	r1.w = r1.w * specularFactor.x;
	r3.w = max(1, r1.w);
	r1.w = r3.w + 1E-05;
	r3.w = r3.w * 0.25 + 1E-05;
	r4.x = pow(r0.w, r1.w);
	r0.w = dot(r3.xyz, -gDirectionalLight.xyz);
	r0.w = saturate(r0.w + -0.25);
	r1.w = saturate(r0.w * 2 + -0.5);
	r0.w = r0.w * 1.3333334;
	r4.yzw = r0.www * r1.xyz;
	r0.w = r1.w * r4.x;
	r1.xyz = r0.www * r1.xyz;
	r5 = gLightPosX + -i.texcoord2.x;
	r6 = r5 * r5;
	r7 = gLightPosY + -i.texcoord2.y;
	r6 = r7 * r7 + r6;
	r8 = gLightPosZ + -i.texcoord2.z;
	r6 = r8 * r8 + r6;
	r9 = r6 + 1E-05;
	r4.x = 1;
	r6 = saturate(r6 * -gLightFallOff + r4.x);
	r6 = r6 * r6;
	r6 = r6 * r6 + -0.1;
	r10.x = rsqrt(r9.x);
	r10.y = rsqrt(r9.y);
	r10.z = rsqrt(r9.z);
	r10.w = rsqrt(r9.w);
	r5 = r5 * r10;
	r9 = r3.x * r5;
	r7 = r7 * r10;
	r8 = r8 * r10;
	r9 = r7 * r3.y + r9;
	r9 = r8 * r3.z + r9;
	r0.w = saturate(r3.z * -0.5 + 0.5);
	r10 = r6 * 1.1111112;
	r6 = (r6 >= 0) ? r10 : 0;
	r6 = saturate(r6 * r9);
	r9 = r5 * -gLightDirX;
	r5 = r2.x * r5;
	r5 = r2.y * r7 + r5;
	r5 = saturate(r2.z * r8 + r5);
	r5 = r5 + 1E-05;
	r7 = r7 * -gLightDirY + r9;
	r7 = r8 * -gLightDirZ + r7;
	r8 = gLightConeScale;
	r7 = saturate(r7 * r8 + gLightConeOffset);
	r6 = r6 * r7;
	r7.x = log2(r5.x);
	r7.y = log2(r5.y);
	r7.z = log2(r5.z);
	r7.w = log2(r5.w);
	r3 = r3.w * r7;
	r5.x = exp2(r3.x);
	r5.y = exp2(r3.y);
	r5.z = exp2(r3.z);
	r5.w = exp2(r3.w);
	r3 = r6 * r5;
	r2.x = dot(gLightColR, r3);
	r2.y = dot(gLightColG, r3);
	r2.z = dot(gLightColB, r3);
	r1.xyz = r1.xyz * gDirectionalLight.www + r2.xyz;
	r1.xyz = r2.www * r1.xyz;
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r2.xyz = r0.www * r2.xyz + gLightAmbient0.xyz;
	r3.yz = float2(0.15, 1);
	r0.w = saturate(AmbientLightingParams.x * -r3.y + r3.z);
	r0.w = saturate(r0.w + 0.2);
	r0.w = r0.w * AmbientLightingParams.y;
	r0.w = i.texcoord7.x * r0.w + -i.texcoord7.x;
	r0.w = gAmbientOcclusionEffect.x * r0.w + i.texcoord7.x;
	r2.xyz = r0.www * r2.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r2.xyz = r2.xyz * r0.www + r4.yzw;
	r3.x = dot(gLightColR, r6);
	r3.y = dot(gLightColG, r6);
	r3.z = dot(gLightColB, r6);
	r2.xyz = r2.xyz + r3.xyz;
	r0.xyz = r0.xyz * r2.xyz + r1.xyz;
	r0.xyz = r0.xyz * matMaterialColorScale.xxx;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;

	return o;
}
