float4 ColorCorrectBottomOffset : register(c44);
float4 ColorCorrectBottomOffsetScreenEdge : register(c67);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
float4 ColorCorrectTopScreenEdge : register(c66);
float4 ColorShift : register(c45);
sampler2D TextureSampler_layer0 : register(s0);
sampler2D TextureSampler_layer1 : register(s3);
sampler2D TextureSampler_layer2 : register(s5);
sampler2D TextureSampler_layer3 : register(s8);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gDepthFxParams : register(c18);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 globalScalars4 : register(c51);
float4 globalScreenSize : register(c41);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 color : COLOR;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord3 : TEXCOORD3;
	float2 vpos : VPOS;
	float4 texcoord2 : TEXCOORD2;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	float4 r5;
	r0.xyz = -gViewInverse[3].xyz + i.texcoord1.xyz;
	r0.w = r0.z * globalFogParams.x;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * globalFogParams.z;
	r0.y = r0.w * -1.442695;
	r0.y = exp2(r0.y);
	r0.z = r0.y + -65504;
	r0.y = -r0.y + 1;
	r0.y = (r0.z >= 0) ? -65503 : r0.y;
	r0.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r0.y = r0.z * r0.y;
	r0.y = r0.y * r0.x;
	r0.x = (r0.w >= 0) ? r0.x : r0.y;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = saturate(exp2(r0.x));
	r1 = i.texcoord.xyxx * float4(1, 1, 0, 0) + float4(0, 0, 0, -1.3);
	r1 = tex2Dbias(TextureSampler_layer0, r1);
	r0.yzw = 1 + -i.color.xyz;
	r0.z = r0.z * r0.y;
	r1.w = r0.w * r0.z;
	r0.yz = r0.yz * i.color.yz;
	r2 = i.texcoord.zwxx * float4(1, 1, 0, 0) + float4(0, 0, 0, -1.3);
	r3 = tex2Dbias(TextureSampler_layer1, r2);
	r3.xyz = r0.zzz * r3.xyz;
	r1.xyz = r1.xyz * r1.www + r3.xyz;
	r0.z = r0.w * r0.y;
	r0.y = r0.y * i.color.z;
	r3 = tex2Dbias(TextureSampler_layer2, r2);
	r2 = tex2Dbias(TextureSampler_layer3, r2);
	r1.xyz = r3.xyz * r0.zzz + r1.xyz;
	r1.xyz = r2.xyz * r0.yyy + r1.xyz;
	r2.w = globalScalars.x * i.texcoord3.w;
	r1.w = 1;
	r2.xyz = i.texcoord3.xyz;
	r3 = r1 * r2;
	r0.y = dot(r3.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.xyz = r2.xyz * r1.xyz + -r0.yyy;
	r0.z = saturate(-i.texcoord2.w * gDepthFxParams.z + gDepthFxParams.w);
	r0.w = -r0.z + 1;
	r0.zw = r0.ww * gDepthFxParams.xy + r0.zz;
	r1.xyz = r0.zzz * r1.xyz + r0.yyy;
	r0.y = r0.y + 1E-05;
	r0.y = abs(r0.y) + 1E-05;
	r0.z = r0.w + -0.99999;
	r1.w = pow(r0.y, r0.z);
	r3.xyz = globalFogColorN.xyz;
	r1.xyz = r1.xyz * r1.www + -r3.xyz;
	r1.w = 0;
	r0 = r0.x * r1 + r3;
	r1.w = r0.w;
	r2.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r3.x = gAdrenoFXVars.x;
	r2.y = r3.x * deSatContrastGamma.x;
	r3.xyz = lerp(r2.xxx, r0.xyz, r2.yyy);
	r2.y = r2.x * ColorCorrectBottomOffset.w;
	r2.x = r2.x * ColorShift.w;
	r4 = globalScalars4.yzw * -r2.yyy + r3.xyz;
	r3.xyz = ColorShift.xyz * -r2.xxx + r3.xyz;
	r5.xyz = r2.yyy * globalScalars4.yzw;
	r2.y = saturate(r2.y);
	r2.yzw = r2.yyy * r4.xyz + r5.xyz;
	r3.w = 1 / globalScreenSize.y;
	r4.y = r3.w * i.vpos.y;
	r5 = ColorCorrectTopScreenEdge;
	r5.xyz = r4.yyy * ColorCorrectBottomOffsetScreenEdge.xyz + r5.xyz;
	r1.xyz = r2.yzw * r5.xyz;
	r2.yzw = r2.xxx * ColorShift.xyz;
	r2.x = saturate(r2.x);
	r2.xyz = r2.xxx * r3.xyz + r2.yzw;
	r3.xyz = ColorCorrectBottomOffset.xyz;
	r3.xyz = r4.yyy * r3.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r0.xyz = r2.xyz * r3.xyz;
	r2.x = 1 / globalScreenSize.x;
	r4.x = r2.x * i.vpos.x;
	r2.xy = r4.xy + -0.5;
	r2.x = dot(r2.xy, r2.xy) + 0;
	r2.x = rsqrt(r2.x);
	r2.x = 1 / r2.x;
	r2.y = r5.w + -ColorCorrectBottomOffsetScreenEdge.w;
	r2.y = (r2.y >= 0) ? -r2.y : -0;
	r2.x = r2.y + r2.x;
	r2.y = r2.y + ColorCorrectTopScreenEdge.w;
	r2.y = 1 / r2.y;
	r2.y = saturate(r2.y * r2.x);
	r2.x = (r2.x >= 0) ? r2.y : 0;
	r3 = lerp(r0, r1, r2.x);
	o = (ColorCorrectTopScreenEdge.w >= 0) ? r3 : r0;

	return o;
}
