	r3.xy = asint(i.sv_position.xy / globalScreenSize.xy);
	r4.xyz = asfloat(r3.yyy) * ColorCorrectBottomOffsetScreenEdge.xyz + ColorCorrectTopScreenEdge.xyz;
	r2.xyz = asint(asfloat(r2.xyz) * r4.xyz);
	r2.w = r0.w;
	r3.xz = asint(asfloat(r3.xy) + float2(-0.5, -0.5));
	r4.xyz = asfloat(r3.yyy) * ColorCorrectBottomOffset.xyz + ColorCorrectTopAndPedReflectScale.xyz;
	r3.x = asint(dot(asfloat(r3.xz), asfloat(r3.xz)));
	r3.x = asint(sqrt(asfloat(r3.x)));
	r3.y = asint(ColorCorrectTopScreenEdge.w + -(ColorCorrectBottomOffsetScreenEdge.w));
	r3.y = asint(max(asfloat(r3.y), 0));
	r3.z = asint(-(asfloat(r3.y)) + asfloat(r3.x));
	r3.x = (asfloat(r3.x) < asfloat(r3.y)) ? -1 : 0;
	r3.y = asint(-(asfloat(r3.y)) + ColorCorrectTopScreenEdge.w);
	r3.y = asint(saturate(asfloat(r3.z) / asfloat(r3.y)));
	r3.x = (r3.x != 0) ? 0 : r3.y;
	r2 = asint(asfloat(r2) * asfloat(r3.x));
	r3.x = asint(-(asfloat(r3.x)) + 1);
	r3.yzw = asint(asfloat(r1.xxx) * ColorShift.xyz);
	r1.x = asint(saturate(asfloat(r1.x)));
	r1.xyz = asint(asfloat(r1.xxx) * asfloat(r1.yzw) + asfloat(r3.yzw));
	r0.xyz = asint(r4.xyz * asfloat(r1.xyz));
	r1 = asint(asfloat(r0) * asfloat(r3.x) + asfloat(r2));
	r2.x = (ColorCorrectTopScreenEdge.w >= 0) ? -1 : 0;
	o = (r2.x != 0) ? asfloat(r1) : asfloat(r0);

	return o;
}
