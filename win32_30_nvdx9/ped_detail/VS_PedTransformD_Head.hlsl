float4 AirResist : register(c214);
sampler2D BloodSamplerVS : register(s1);
float WindStr : register(c215);
float4 gAmbientOcclusionEffect : register(c63);
float4 gBloodData : register(c205);
row_major float4x4 gViewInverse : register(c12);
float4 gWindParams : register(c213);
row_major float4x4 gWorld : register(c0);
row_major float4x4 gWorldViewProj : register(c8);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float4 globalScalars3 : register(c49);
float4 globalScalars4 : register(c51);

struct VS_IN
{
	float4 position : POSITION;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 normal : NORMAL;
	float4 tangent : TANGENT;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float3 r3;
	float3 r4;
	float2 r5;
	float2 r6;
	r0.xyz = gWorld[1].xyz * i.tangent.yyy;
	r0.xyz = i.tangent.xxx * gWorld[0].xyz + r0.xyz;
	r0.xyz = i.tangent.zzz * gWorld[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0 = float4(1, 1, 0, 0) * i.texcoord.zwzz;
	r0 = tex2Dlod(BloodSamplerVS, r0);
	r0.xyw = i.texcoord1.xyz * float3(1, -1, 1) + float3(0, 1, 0);
	r0.xyz = r0.zzz * r0.xyw;
	r0.xyz = r0.xyz * gBloodData.xxx + i.position.xyz;
	r2.xyz = r0.yyy * gWorld[1].xyz;
	r2.xyz = r0.xxx * gWorld[0].xyz + r2.xyz;
	r2.xyz = r0.zzz * gWorld[2].xyz + r2.xyz;
	r2.xyz = r2.xyz + gWorld[3].xyz;
	r3 = -r2.xyz + gViewInverse[3].xyz;
	o.texcoord7 = r2.xyz;
	o.texcoord6.x = dot(r1.xyz, r3.xyz);
	r2.xyz = gWorld[1].xyz * i.normal.yyy;
	r2.xyz = i.normal.xxx * gWorld[0].xyz + r2.xyz;
	r2.xyz = i.normal.zzz * gWorld[2].xyz + r2.xyz;
	r2.xyz = r2.xyz + 1E-05;
	r4 = normalize(r2.xyz);
	r2.xyz = r1.zxy * r4.yzx;
	r2.xyz = r1.yzx * r4.zxy + -r2.xyz;
	o.texcoord4 = r1.xyz;
	r1.xyz = r2.xyz * i.tangent.www;
	o.texcoord6.y = dot(r1.xyz, r3.xyz);
	o.texcoord5.xyz = r1.xyz;
	o.texcoord6.z = dot(r4.xyz, r3.xyz);
	o.texcoord2.y = globalScalars2.w * i.color.y;
	r1.xzw = float3(1, -1, 1E-05);
	r0.w = i.color.x * globalScalars.z + r1.z;
	r0.w = gAmbientOcclusionEffect.y * r0.w + r1.x;
	r1.y = 1 / gAmbientOcclusionEffect.y;
	r0.w = r0.w * r1.y;
	o.texcoord2.x = min(r0.w, 1);
	r2.xyz = r0.xxz * float3(6, 10, 10);
	r0.w = r2.z + r2.y;
	r0.w = r0.y * 10 + r0.w;
	r2.w = AirResist.w;
	r1.yz = r2.ww * float2(4, 1.5) + 1;
	r2.y = r1.z * globalScalars3.y;
	r0.w = r2.y * gWindParams.z + r0.w;
	r2.y = r2.y * gWindParams.w;
	r2.y = r0.y * 4 + r2.y;
	r2.y = r2.y * 0.15915494 + 0.5;
	r2.y = frac(r2.y);
	r2.y = r2.y * 6.2831855 + -3.1415927;
	r3.y = sin(r2.y);
	r0.w = r0.w * 0.15915494 + 0.5;
	r0.w = frac(r0.w);
	r0.w = r0.w * 6.2831855 + -3.1415927;
	r5.y = sin(r0.w);
	r0.w = globalScalars3.y * r1.z + r2.x;
	r2.xyz = r1.yyy * i.color1.xxz;
	r2.xyz = -r2.xyz * i.normal.xyz;
	r0.w = r0.w * 0.15915494 + 0.5;
	r0.w = frac(r0.w);
	r0.w = r0.w * 6.2831855 + -3.1415927;
	r6.y = sin(r0.w);
	r0.w = saturate(WindStr.x);
	r0.w = abs(r6.y) * r0.w;
	r0.w = abs(r5.y) * r0.w;
	r0.w = abs(r3.y) * r0.w;
	r1.y = saturate(dot(AirResist.xzy, r4.xyz));
	o.texcoord1.xyz = r4.xyz;
	r1.y = -r1.y + 1;
	r1.x = r1.y * -AirResist.w + r1.x;
	r1.y = (0.8 < r1.x) ? 1 : 0;
	r2.w = lerp(r1.x, 1, r1.y);
	r1.xyz = r2.www * r2.xyz;
	r2.x = r1.w + globalScalars3.z;
	r2.y = r1.w + globalScalars4.z;
	r2.z = 1E-05;
	r3 = normalize(r2.xyz);
	r1.w = dot(r3.xyz, i.normal.xyz);
	r1.w = max(r1.w, 0.25);
	r1.w = min(r1.w, 1);
	r1.xyz = r1.www * r1.xyz;
	r0.xyz = r1.xyz * r0.www + r0.xyz;
	r1 = r0.y * gWorldViewProj[1];
	r1 = r0.x * gWorldViewProj[0] + r1;
	r0 = r0.z * gWorldViewProj[2] + r1;
	r0 = r0 + gWorldViewProj[3];
	o.position = r0;
	o.texcoord1.w = r0.w;
	o.texcoord = i.texcoord;
	o.texcoord2.zw = i.color.zw;
	o.texcoord5.w = i.tangent.w;

	return o;
}
