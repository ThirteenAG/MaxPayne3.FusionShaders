sampler2D BumpSampler_layer0 : register(s1);
sampler2D BumpSampler_layer1 : register(s3);
sampler2D TextureSampler_layer0 : register(s0);
sampler2D TextureSampler_layer1 : register(s2);
float bumpiness : register(c2);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightAmbientDir0 : register(c72);
float4 gLightAmbientDir1 : register(c73);
float4 globalFogColor : register(c38);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float specularColorFactor : register(c1);
float specularFactor : register(c0);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 color : COLOR;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float3 r2;
	float4 r3;
	float4 r4;
	r0 = float4(-512, 1E-05, 1E-05, 1E-05) + i.texcoord4.zxyz;
	r1 = r0.x;
	r2 = normalize(r0.yzw);
	clip(r1);
	r0 = tex2D(BumpSampler_layer0, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(BumpSampler_layer1, i.texcoord.xy);
	r0.z = -r1.w + 1;
	r0.z = -r1.x + r0.z;
	r0.zw = (r0.zz >= 0) ? r1.wy : r1.xy;
	r1.xyz = 1 + -i.color.xyz;
	r1.x = r1.y * r1.x;
	r1.y = r1.z * r1.x;
	r1.x = r1.x * i.color.z;
	r0.zw = r0.zw * r1.xx;
	r0.xy = r0.xy * r1.yy + r0.zw;
	r0.xy = r0.xy + -0.5;
	r0.xy = r0.xy * bumpiness.xx;
	r0.xy = r0.xy + r0.xy;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r1.z = max(r0.z, 0);
	r0.z = rsqrt(r1.z);
	r0.z = 1 / r0.z;
	r3.xyz = r0.xxx * i.texcoord5.xyz;
	r0.xzw = i.texcoord2.xyz * r0.zzz + r3.xyz;
	r0.xyz = r0.yyy * i.texcoord6.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r3.xyz = normalize(r0.xyz);
	r0.x = dot(r2.xyz, r3.xyz);
	r0.x = r0.x + r0.x;
	r0.xyz = r3.xyz * -r0.xxx + r2.xyz;
	r0.x = saturate(dot(-gDirectionalLight.xyz, r0.xyz));
	r0.x = r0.x + 1E-05;
	r0.y = 1E-05;
	r0.y = r0.y + specularFactor.x;
	r1.z = pow(r0.x, r0.y);
	r0.xyz = r1.zzz * gDirectionalColour.xyz;
	r0.xyz = r0.xyz * gDirectionalLight.www;
	r0.xyz = r0.xyz * specularColorFactor.xxx;
	r0.w = dot(gLightAmbientDir1.xyz, r3.xyz);
	r0.w = saturate(r0.w + gLightAmbientDir0.w);
	r2 = r0.www * gLightAmbient1.xyz;
	r0.w = dot(gLightAmbientDir0.xyz, r3.xyz);
	r1.z = dot(r3.xyz, -gDirectionalLight.xyz);
	r1.z = r1.z + -0.25;
	r1.z = saturate(r1.z * 1.3333334);
	r3.xyz = r1.zzz * gDirectionalColour.xyz;
	r0.w = saturate(r0.w + gLightAmbientDir0.w);
	r2 = r0.www * gLightAmbient0.xyz + r2.xyz;
	r2 = r2.xyz * i.texcoord3.xxx + r3.xyz;
	r3 = i.texcoord.xyxx * float4(1, 1, 0, 0) + float4(0, 0, 0, -1.3);
	r4 = tex2Dbias(TextureSampler_layer1, r3);
	r3 = tex2Dbias(TextureSampler_layer0, r3);
	r1.xzw = r1.xxx * r4.xyz;
	r1.xyz = r3.xyz * r1.yyy + r1.xzw;
	r0.xyz = r1.xyz * r2.xyz + r0.xyz;
	r0.w = -globalFogParams.x + globalFogParams.y;
	r0.w = 1 / r0.w;
	r1.x = -globalFogParams.x + i.texcoord2.w;
	r0.w = saturate(r0.w * r1.x);
	r1.xyz = lerp(r0.xyz, globalFogColor.xyz, r0.www);
	r0.x = dot(r1.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r0.y = r2.x * deSatContrastGamma.x;
	r2 = lerp(r0.xxx, r1.xyz, r0.yyy);
	r0.xyz = saturate(r2.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;
	r0.x = globalScalars.x * globalScalars.x;
	r0.x = r0.x * i.texcoord3.w;
	r0.y = 64 + -i.texcoord2.w;
	r0.y = saturate(r0.y * 0.25);
	o.w = r0.y * r0.x;

	return o;
}
