float4 AirResist : register(c215);
float WindStr : register(c216);
float4 gAmbientOcclusionEffect : register(c63);
row_major float3x4 gBoneMtx[40] : register(c76);
row_major float4x4 gViewInverse : register(c12);
float4 gWindParams : register(c214);
row_major float4x4 gWorld : register(c0);
row_major float4x4 gWorldViewProj : register(c8);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float4 globalScalars3 : register(c49);
float4 globalScalars4 : register(c51);

struct VS_IN
{
	float4 position : POSITION;
	float4 blendweight : BLENDWEIGHT;
	float4 blendindices : BLENDINDICES;
	float4 texcoord : TEXCOORD;
	float4 normal : NORMAL;
	float4 tangent : TANGENT;
	float4 color : COLOR;
	float4 color1 : COLOR1;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	int4 a0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	r0 = 765.00586 * i.blendindices;
	a0 = r0.yxzw;
	r1 = i.blendweight.y * gBoneMtx[a0.x / 3][1];
	r1 = gBoneMtx[a0.y / 3][1] * i.blendweight.x + r1;
	r0 = gBoneMtx[a0.z / 3][1] * i.blendweight.z + r1;
	r0 = gBoneMtx[a0.w / 3][1] * i.blendweight.w + r0;
	r1.x = dot(r0.xyz, i.tangent.xyz);
	r1.xyz = r1.xxx * gWorld[1].xyz;
	r2 = i.blendweight.y * gBoneMtx[a0.x / 3][0];
	r3 = i.blendweight.y * gBoneMtx[a0.x / 3][2];
	r3 = gBoneMtx[a0.y / 3][2] * i.blendweight.x + r3;
	r2 = gBoneMtx[a0.y / 3][0] * i.blendweight.x + r2;
	r2 = gBoneMtx[a0.z / 3][0] * i.blendweight.z + r2;
	r3 = gBoneMtx[a0.z / 3][2] * i.blendweight.z + r3;
	r3 = gBoneMtx[a0.w / 3][2] * i.blendweight.w + r3;
	r2 = gBoneMtx[a0.w / 3][0] * i.blendweight.w + r2;
	r1.w = dot(r2.xyz, i.tangent.xyz);
	r1.xyz = r1.www * gWorld[0].xyz + r1.xyz;
	r1.w = dot(r3.xyz, i.tangent.xyz);
	r1.xyz = r1.www * gWorld[2].xyz + r1.xyz;
	r4 = i.position.xyzx * float4(1, 1, 1, 0) + float4(0, 0, 0, 1);
	r5.x = dot(r2, r4);
	r1.w = dot(r2.xyz, i.normal.xyz);
	r5.y = dot(r0, r4);
	r0.x = dot(r0.xyz, i.normal.xyz);
	r0.xyz = r0.xxx * gWorld[1].xyz;
	r0.xyz = r1.www * gWorld[0].xyz + r0.xyz;
	r5.z = dot(r3, r4);
	r0.w = dot(r3.xyz, i.normal.xyz);
	r0.xyz = r0.www * gWorld[2].xyz + r0.xyz;
	r2.xyz = r5.yyy * gWorld[1].xyz;
	r2.xyz = r5.xxx * gWorld[0].xyz + r2.xyz;
	r2.xyz = r5.zzz * gWorld[2].xyz + r2.xyz;
	r2.xyz = r2.xyz + gWorld[3].xyz;
	r3.xyz = -r2.xyz + gViewInverse[3].xyz;
	o.texcoord7 = r2.xyz;
	o.texcoord6.x = dot(r1.xyz, r3.xyz);
	r2.xyz = r0.yzx * r1.zxy;
	r2.xyz = r1.yzx * r0.zxy + -r2.xyz;
	o.texcoord4 = r1.xyz;
	r1.xyz = r2.xyz * i.tangent.www;
	o.texcoord6.y = dot(r1.xyz, r3.xyz);
	o.texcoord5.xyz = r1.xyz;
	o.texcoord6.z = dot(r0.xyz, r3.xyz);
	o.texcoord3 = r3.xyz;
	o.texcoord2.y = globalScalars2.w * i.color.y;
	r1.y = 1;
	r0.w = i.color.x * globalScalars.z + -r1.y;
	r0.w = gAmbientOcclusionEffect.y * r0.w + r1.y;
	r1.x = 1 / gAmbientOcclusionEffect.y;
	r0.w = r0.w * r1.x;
	o.texcoord2.x = min(r0.w, 1);
	r1.xzw = r5.xxz * float3(6, 10, 10);
	r2 = float4(4, 1.5, 1, 1E-05);
	r2.xy = AirResist.ww * r2.xy + r2.zz;
	r0.w = globalScalars3.y * r2.y + r1.x;
	r1.x = r1.w + r1.z;
	r1.x = r5.y * 10 + r1.x;
	r0.w = r0.w * 0.15915494 + 0.5;
	r0.w = frac(r0.w);
	r0.w = r0.w * 6.2831855 + -3.1415927;
	r3.y = sin(r0.w);
	r0.w = saturate(WindStr.x);
	r0.w = abs(r3.y) * r0.w;
	r1.z = r2.y * globalScalars3.y;
	r2.xyz = r2.xxx * i.color1.xxz;
	r2.xyz = -r2.xyz * i.normal.xyz;
	r1.x = r1.z * gWindParams.z + r1.x;
	r1.x = r1.x * 0.15915494 + 0.5;
	r1.x = frac(r1.x);
	r1.x = r1.x * 6.2831855 + -3.1415927;
	r3.y = sin(r1.x);
	r0.w = r0.w * abs(r3.y);
	r1.x = r5.y * 4;
	r1.x = r1.z * gWindParams.w + r1.x;
	r1.x = r1.x * 0.15915494 + 0.5;
	r1.x = frac(r1.x);
	r1.x = r1.x * 6.2831855 + -3.1415927;
	r3.y = sin(r1.x);
	r0.w = r0.w * abs(r3.y);
	r1.x = saturate(dot(AirResist.xyz, r0.xyz));
	o.texcoord1.xyz = r0.xyz;
	r0.x = -r1.x + 1;
	r0.x = r0.x * -AirResist.w + r1.y;
	r0.y = (0.8 < r0.x) ? 1 : 0;
	r1.x = lerp(r0.x, 1, r0.y);
	r0.xyz = r1.xxx * r2.xyz;
	r1.x = r2.w + globalScalars3.z;
	r1.y = r2.w + globalScalars4.z;
	r1.z = 1E-05;
	r2.xyz = normalize(r1.xyz);
	r1.x = dot(r2.xyz, i.normal.xyz);
	r1.x = max(r1.x, 0.25);
	r1.x = min(r1.x, 1);
	r0.xyz = r0.xyz * r1.xxx;
	r0.xyz = r0.xyz * r0.www + r5.xyz;
	r1 = r0.y * gWorldViewProj[1];
	r1 = r0.x * gWorldViewProj[0] + r1;
	r0 = r0.z * gWorldViewProj[2] + r1;
	r0 = r0 + gWorldViewProj[3];
	o.position = r0;
	o.texcoord1.w = r0.w;
	o.texcoord = i.texcoord;
	o.texcoord2.zw = i.color.zw;
	o.texcoord5.w = i.tangent.w;

	return o;
}
