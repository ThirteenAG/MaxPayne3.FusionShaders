sampler2D BloodSamplerVS : register(s1);
sampler2D clothVertexSampler : register(s2);
float4 gAmbientOcclusionEffect : register(c63);
float4 gBloodData : register(c203);
row_major float3x4 gBoneMtx[40] : register(c76);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorld : register(c0);
row_major float4x4 gWorldViewProj : register(c8);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float4 invVertexBufferSize : register(c208);

struct VS_IN
{
	float4 position : POSITION;
	float4 blendweight : BLENDWEIGHT;
	float4 blendindices : BLENDINDICES;
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 normal : NORMAL;
	float4 tangent : TANGENT;
	float4 color : COLOR;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	int2 a0;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float3 r10;
	float3 r11;
	float3 r12;
	r0 = float4(1, 1, 0, 0) * i.texcoord.zwzz;
	r0 = tex2Dlod(BloodSamplerVS, r0);
	r0.xyw = i.texcoord1.xyz * float3(1, -1, 1) + float3(0, 1, 0);
	r0.xyz = r0.zzz * r0.xyw;
	r0.xyw = r0.xyz * gBloodData.xxx + i.position.xyz;
	r1 = 765.00586 * i.blendindices;
	a0 = r1.xy;
	r2 = i.blendweight.y * gBoneMtx[a0.y / 3][0];
	r3 = i.blendweight.y * gBoneMtx[a0.y / 3][1];
	r4 = i.blendweight.y * gBoneMtx[a0.y / 3][2];
	r2 = gBoneMtx[a0.x / 3][0] * i.blendweight.x + r2;
	r3 = gBoneMtx[a0.x / 3][1] * i.blendweight.x + r3;
	r4 = gBoneMtx[a0.x / 3][2] * i.blendweight.x + r4;
	a0.x = r1.z;
	r2 = gBoneMtx[a0.x / 3][0] * i.blendweight.z + r2;
	r3 = gBoneMtx[a0.x / 3][1] * i.blendweight.z + r3;
	r4 = gBoneMtx[a0.x / 3][2] * i.blendweight.z + r4;
	a0.x = r1.w;
	r1 = gBoneMtx[a0.x / 3][0] * i.blendweight.w + r2;
	r2 = gBoneMtx[a0.x / 3][1] * i.blendweight.w + r3;
	r3 = gBoneMtx[a0.x / 3][2] * i.blendweight.w + r4;
	r4.x = (0.9960708 < i.blendindices.x) ? 1 : 0;
	r5 = lerp(r1, gBoneMtx[0][0], r4.x);
	r1 = lerp(r2, gBoneMtx[0][1], r4.x);
	r2 = lerp(r3, gBoneMtx[0][2], r4.x);
	r0.z = 1;
	r3.x = dot(r5.xywz, r0);
	r3.y = dot(r1.xywz, r0);
	r3.z = dot(r2.xywz, r0);
	r4.xyz = r3.yyy * gWorld[1].xyz;
	r4.xyz = r3.xxx * gWorld[0].xyz + r4.xyz;
	r4.xyz = r3.zzz * gWorld[2].xyz + r4.xyz;
	r4.xyz = r4.xyz + gWorld[3].xyz;
	r6 = -r4.xyz + gViewInverse[3].xyz;
	r1.w = dot(r5.xyz, i.tangent.xyz);
	r2.w = dot(r1.xyz, i.tangent.xyz);
	r3.w = dot(r2.xyz, i.tangent.xyz);
	r7.xyz = r2.www * gWorld[1].xyz;
	r7.xyz = r1.www * gWorld[0].xyz + r7.xyz;
	r0.xyz = r3.www * gWorld[2].xyz + r7.xyz;
	if (0.9960708 < i.blendindices.x) {
		r7.xyz = i.blendindices.yzw * 255.00195 + 0.5;
		r7.xyz = r7.xyz * invVertexBufferSize.xxx;
		r7.w = 0;
		r8 = tex2Dlod(clothVertexSampler, r7.xwww);
		r9 = tex2Dlod(clothVertexSampler, r7.ywww);
		r7 = tex2Dlod(clothVertexSampler, r7.zwww);
		r10.x = dot(gWorld[0].xyz, r8.xyz);
		r10.y = dot(gWorld[1].xyz, r8.xyz);
		r10.z = dot(gWorld[2].xyz, r8.xyz);
		r8.x = dot(gWorld[0].xyz, r9.xyz);
		r8.y = dot(gWorld[1].xyz, r9.xyz);
		r8.z = dot(gWorld[2].xyz, r9.xyz);
		r9.x = dot(gWorld[0].xyz, r7.xyz);
		r9.y = dot(gWorld[1].xyz, r7.xyz);
		r9.z = dot(gWorld[2].xyz, r7.xyz);
		r7.xyz = -r8.zxy + r10.zxy;
		r11 = -r8.yzx + r9.yzx;
		r12 = r7.xyz * r11.xyz;
		r7.xyz = r7.zxy * r11.yzx + -r12.xyz;
		r11 = normalize(r7.xyz);
		r7.xyz = r8.xyz * i.blendweight.yyy;
		r7.xyz = i.blendweight.zzz * r10.xyz + r7.xyz;
		r7.xyz = i.blendweight.xxx * r9.xyz + r7.xyz;
		r1.w = -0.5 + i.blendweight.w;
		r1.w = r1.w * 0.1;
		r3.xyz = r1.www * r11.xyz + r7.xyz;
		r7.xyz = r3.yyy * gWorld[1].xyz;
		r7.xyz = r3.xxx * gWorld[0].xyz + r7.xyz;
		r7.xyz = r3.zzz * gWorld[2].xyz + r7.xyz;
		o.texcoord7 = r7.xyz + gWorld[3].xyz;
		r7.xyz = -r11.yyy * gWorld[1].xyz;
		r7.xyz = -r11.xxx * gWorld[0].xyz + r7.xyz;
		r7.xyz = -r11.zzz * gWorld[2].xyz + r7.xyz;
		r8.xyz = normalize(r7.xyz);
		r7.xyz = normalize(r0.xyz);
		r9.xyz = r8.yzx * r7.zxy;
		r9.xyz = r7.yzx * r8.zxy + -r9.xyz;
		r9.xyz = r9.xyz * i.tangent.www;
		r0.xyz = r7.xyz;
	} else {
		r1.w = dot(r5.xyz, i.normal.xyz);
		r1.x = dot(r1.xyz, i.normal.xyz);
		r1.y = dot(r2.xyz, i.normal.xyz);
		r2.xyz = r1.xxx * gWorld[1].xyz;
		r1.xzw = r1.www * gWorld[0].xyz + r2.xyz;
		r8.xyz = r1.yyy * gWorld[2].xyz + r1.xzw;
		r1.xyz = r0.zxy * r8.yzx;
		r1.xyz = r0.yzx * r8.zxy + -r1.xyz;
		r9.xyz = r1.xyz * i.tangent.www;
		o.texcoord7 = r4.xyz;
	}
	o.texcoord6.x = dot(r0.xyz, r6.xyz);
	o.texcoord6.y = dot(r9.xyz, r6.xyz);
	o.texcoord6.z = dot(r8.xyz, r6.xyz);
	r1 = r3.y * gWorldViewProj[1];
	r1 = r3.x * gWorldViewProj[0] + r1;
	r1 = r3.z * gWorldViewProj[2] + r1;
	r1 = r1 + gWorldViewProj[3];
	o.texcoord2.y = globalScalars2.w * i.color.y;
	r2.xz = float2(1, -1);
	r2.y = i.color.x * globalScalars.z + r2.z;
	r2.x = gAmbientOcclusionEffect.y * r2.y + r2.x;
	r2.y = 1 / gAmbientOcclusionEffect.y;
	r2.x = r2.y * r2.x;
	o.texcoord2.x = min(r2.x, 1);
	o.position = r1;
	o.texcoord = i.texcoord;
	r8.w = r1.w;
	o.texcoord1 = r8;
	o.texcoord2.zw = i.color.zw;
	o.texcoord4 = r0;
	r9.w = i.tangent.w;
	o.texcoord5 = r9;

	return o;
}
