sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
float gDeferredLightConeAngle : register(c211);
float gDeferredLightConeOffset : register(c212);
float3 gDeferredLightDirection : register(c204);
sampler2D gDeferredLightSampler : register(s0);
float3 gDeferredLightTangent : register(c205);
float gDeferredLightType : register(c202);
float4 gDeferredProjParams : register(c216);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float2 vpos : VPOS;
	float4 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float3 r3;
	float3 r4;
	float4 r5;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r1.xyz = r1.wxy * 255 + 0.5;
	r2.xyz = frac(r1.xyz);
	r1.xyz = r1.xyz + -r2.xyz;
	r0.z = dot(r1.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r0.z = r0.z * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord.xyz * -r0.zzz + 1E-05;
	r2.xyz = i.texcoord.xyz * -r0.zzz + gViewInverse[3].xyz;
	r3 = normalize(r1.xyz);
	r1 = tex2D(GBufferTextureSampler1, r0.xy);
	r1.xyz = r1.xyz * 2 + -1;
	r4 = normalize(r1.xyz);
	r0.z = dot(r3.xyz, r4.xyz);
	r0.z = r0.z + r0.z;
	r1.xyz = r4.xyz * -r0.zzz + r3.xyz;
	r3 = -r2.xyz + i.texcoord2.xyz;
	r2.xyz = r2.xyz + -i.texcoord2.xyz;
	r5.xyz = r3.xyz + 1E-05;
	r0.z = dot(r3.xyz, r3.xyz);
	r0.z = saturate(r0.z * -i.texcoord1.y + 1);
	r0.z = r0.z + 1E-05;
	r1.w = pow(r0.z, 4.00001);
	r0.z = r1.w + -0.1;
	r3 = normalize(r5.xyz);
	r0.w = saturate(dot(r3.xyz, r1.xyz));
	r0.w = r0.w + 2E-05;
	r1 = tex2D(GBufferTextureSampler2, r0.xy);
	r5 = tex2D(GBufferTextureSampler0, r0.xy);
	r5.xyz = r5.xyz * r5.xyz;
	r0.x = r1.y * r1.y;
	r0.x = r0.x * r0.x;
	r0.x = r0.x * 196 + 1E-05;
	r1.y = pow(r0.w, r0.x);
	r0.x = r0.z * 1.1111112;
	r0.y = dot(r3.xyz, i.texcoord3.xyz);
	r0.w = saturate(dot(r3.xyz, r4.xyz));
	r0.y = saturate(r0.y * i.texcoord1.w + i.texcoord1.z);
	r0.x = r0.y * r0.x;
	r3 = r0.xxx * i.texcoord4.xyz;
	r0.xyz = (r0.zzz >= 0) ? r3.xyz : 0;
	r1.yzw = r1.yyy * r0.xyz;
	r0.xyz = r0.www * r0.xyz;
	r0.w = saturate(r0.w * 2 + -0.5);
	r1.yzw = r0.www * r1.yzw;
	r1.xyz = r1.xxx * r1.yzw;
	r0.w = dot(r2.xyz, r2.xyz);
	r0.w = rsqrt(r0.w);
	r1.w = dot(-gDeferredLightDirection.xyz, r2.xyz);
	r2.w = r1.w * -r0.w + 1;
	r0.w = 1 / r0.w;
	r0.w = r2.w * r0.w;
	r0.w = 1 / r0.w;
	r3 = gDeferredLightDirection.xyz;
	r4 = -r3.zxy * gDeferredLightTangent.yzx;
	r3 = -r3.yzx * gDeferredLightTangent.zxy + -r4.xyz;
	r3.x = dot(r3.xyz, r2.xyz);
	r3.y = dot(gDeferredLightTangent.xyz, r2.xyz);
	r2.xy = r0.ww * r3.xy;
	r0.w = abs(gDeferredLightConeOffset.x);
	r0.w = r0.w + 60;
	r0.w = 1 / r0.w;
	r0.w = r0.w * gDeferredLightConeAngle.x;
	r0.w = r0.w * 120;
	r0.w = r0.w * r0.w;
	r0.w = r1.w * r0.w;
	r0.w = 1 / r0.w;
	r2.zw = -r0.ww * r3.xy;
	r0.w = -2;
	r0.w = r0.w + gDeferredLightType.x;
	r2.xy = (-abs(r0.ww) >= 0) ? r2.zw : r2.xy;
	r2.xy = r2.xy * 0.5 + 0.5;
	r2.zw = 0;
	r2 = tex2Dlod(gDeferredLightSampler, r2);
	r2.xyz = r2.xyz * r5.xyz;
	o.xyz = r2.xyz * r0.xyz + r1.xyz;
	o.w = 1;

	return o;
}
