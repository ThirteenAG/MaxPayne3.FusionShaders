float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r1.xyz = r1.wxy * 255 + 0.5;
	r2.xyz = frac(r1.xyz);
	r1.xyz = r1.xyz + -r2.xyz;
	r0.z = dot(r1.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r0.z = r0.z * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2 = r1.y * gShadowMatrix[1];
	r2 = r1.x * gShadowMatrix[0] + r2;
	r2 = r1.z * gShadowMatrix[2] + r2;
	r1.xyz = -r1.xyz + i.texcoord2.xyz;
	r2 = r2 + gShadowMatrix[3];
	r0.z = 1 / r2.w;
	r0.w = r2.z * r0.z + -gShadowParam0123.x;
	r2.xy = r2.xy * r0.zz + 1;
	r3.xy = r2.xy * 0.5;
	r3.z = r2.y * -0.5 + 1;
	r3.w = -r3.y;
	r2.xyz = float3(0, -1, 1);
	r4 = gShadowParam0123.z * r2.yxzx + r2.xzxz;
	r4 = r3.xwxw + r4;
	r5 = tex2D(gShadowZSamplerDir, r4.xy);
	r4 = tex2D(gShadowZSamplerDir, r4.zw);
	r4.xyz = r4.wxy * 255 + 0.5;
	r5.xyz = r5.wxy * 255 + 0.5;
	r6.xyz = frac(r5.xyz);
	r5.xyz = r5.xyz + -r6.xyz;
	r5.x = dot(r5.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r6.xyz = frac(r4.xyz);
	r4.xyz = r4.xyz + -r6.xyz;
	r5.z = dot(r4.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r4 = tex2D(gShadowZSamplerDir, r3.xz);
	r4.xyz = r4.wxy * 255 + 0.5;
	r6.xyz = frac(r4.xyz);
	r4.xyz = r4.xyz + -r6.xyz;
	r5.y = dot(r4.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r4.xyz = -r0.www + r5.xyz;
	r4.xyz = (r4.xyz >= 0) ? 1 : 0;
	r5.x = 1 / gShadowParam0123.z;
	r5.y = 1 / gShadowParam0123.w;
	r3.yw = r3.xz * r5.xy;
	r5.xy = frac(r3.yw);
	r5.zw = r5.xx * float2(-1, 0) + 1;
	r0.z = dot(r4.zxy, r5.xzw);
	r4.xyz = r5.xwx * float3(-1, 1, 1) + float3(1, 0, 0);
	r3.yw = r3.xz + -gShadowParam0123.zw;
	r6 = tex2D(gShadowZSamplerDir, r3.yw);
	r5.xzw = r6.wxy * 255 + 0.5;
	r6.xyz = frac(r5.xzw);
	r5.xzw = r5.xzw + -r6.xyz;
	r6.x = dot(r5.xzw, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r7 = gShadowParam0123.wwzw * r2.xyzy + r3.xzxz;
	r8 = tex2D(gShadowZSamplerDir, r7.xy);
	r7 = tex2D(gShadowZSamplerDir, r7.zw);
	r5.xzw = r7.wxy * 255 + 0.5;
	r7.xyz = r8.wxy * 255 + 0.5;
	r8.xyz = frac(r7.xyz);
	r7.xyz = r7.xyz + -r8.xyz;
	r6.y = dot(r7.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r7.xyz = frac(r5.xzw);
	r5.xzw = r5.xzw + -r7.xyz;
	r6.z = dot(r5.xzw, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r5.xzw = -r0.www + r6.xyz;
	r5.xzw = (r5.xzw >= 0) ? 1 : 0;
	r1.w = dot(r5.xzw, r4.xyz);
	r2.w = -r5.y + 1;
	r0.z = r1.w * r2.w + r0.z;
	r3.yw = r3.xz + gShadowParam0123.zw;
	r2 = gShadowParam0123.zwww * r2.yzxz + r3.xzxz;
	r3 = tex2D(gShadowZSamplerDir, r3.yw);
	r3.xyz = r3.wxy * 255 + 0.5;
	r5.xzw = frac(r3.xyz);
	r3.xyz = r3.xyz + -r5.xzw;
	r3.z = dot(r3.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r6 = tex2D(gShadowZSamplerDir, r2.xy);
	r2 = tex2D(gShadowZSamplerDir, r2.zw);
	r2.xyz = r2.wxy * 255 + 0.5;
	r5.xzw = r6.wxy * 255 + 0.5;
	r6.xyz = frac(r5.xzw);
	r5.xzw = r5.xzw + -r6.xyz;
	r3.x = dot(r5.xzw, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r5.xzw = frac(r2.xyz);
	r2.xyz = r2.xyz + -r5.xzw;
	r3.y = dot(r2.xyz, float3(0.0039062505, 1.525879E-05, 5.960465E-08));
	r2.xyz = -r0.www + r3.xyz;
	r2.xyz = (r2.xyz >= 0) ? 1 : 0;
	r0.w = dot(r2.xyz, r4.xyz);
	r0.z = r0.w * r5.y + r0.z;
	r0.z = r0.z * 0.33333334;
	r0.w = 1;
	r1.w = lerp(gShadowParam0123.y, r0.w, r0.z);
	r2 = tex2D(GBufferTextureSampler1, r0.xy);
	r0 = tex2D(GBufferTextureSampler0, r0.xy);
	r0.xyz = r0.xyz * r0.xyz;
	r2.xyz = r2.xyz * 2 + -1;
	r3.xyz = normalize(r2.xyz);
	r2.xyz = r1.xyz + 1E-05;
	r0.w = dot(r1.xyz, r1.xyz);
	r0.w = saturate(r0.w * -i.texcoord1.y + 1);
	r0.w = r0.w + 1E-05;
	r1.x = pow(r0.w, 2.00001);
	r0.w = r1.x + -0.33333334;
	r1.xyz = normalize(r2.xyz);
	r2.x = dot(r3.xyz, r1.xyz);
	r1.x = dot(r1.xyz, i.texcoord3.xyz);
	r1.x = saturate(r1.x * i.texcoord1.w + i.texcoord1.z);
	r1.y = r2.x + -0.33333334;
	r1.y = saturate(r1.y * 1.5);
	r1.z = r0.w * 1.5;
	r1.x = r1.x * r1.z;
	r1.x = r1.y * r1.x;
	r0.w = (r0.w >= 0) ? r1.x : 0;
	r0.w = r1.w * r0.w;
	r1.xyz = r0.www * i.texcoord4.xyz;
	o.xyz = r0.xyz * r1.xyz;
	o.w = 1;

	return o;
}
