row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float4 vCustomData[4] : register(c130);

struct VS_OUT
{
	float4 position : POSITION;
	float4 color : COLOR;
};

VS_OUT main(float4 position : POSITION)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float3 r3;
	float4 r4;
	float2 r5;
	float2 r6;
	r0.z = gWorldView[1].x;
	r0.x = gWorldView[2].x;
	r0.y = gWorldView[0].x;
	r1.y = gWorldView[2].y;
	r1.z = gWorldView[0].y;
	r1.x = gWorldView[1].y;
	r2.xyz = r0.xyz * r1.xyz;
	r0.xyz = r0.zxy * r1.yzx + -r2.xyz;
	r1.xyz = gWorldView[1].xyz;
	r2.xyz = r1.zxy * gWorldView[2].yzx;
	r1.xyz = r1.yzx * gWorldView[2].zxy + -r2.xyz;
	r0.w = dot(r1.xyz, gWorldView[0].xyz);
	r0.w = 1 / r0.w;
	r0.xyz = r0.www * r0.xyz;
	r1.xyz = r0.yzx * float3(1, 0, 0);
	r1.xyz = r0.zxy * float3(0, 1, 0) + -r1.xyz;
	r0.xyz = r0.zzz * -r0.xyz + float3(0, 0, 1);
	r2.xyz = normalize(r0.xyz);
	r0.x = dot(r1.xyz, r1.xyz);
	r0.x = rsqrt(r0.x);
	r0 = r0.x * r1.xyyx;
	r0 = r0 * float4(1, 0, 1, 0);
	r1.xyz = r0.zzw * float3(1, 0, 1);
	r0.xyz = r0.zxy * float3(0, 1, 1) + -r1.xyz;
	r1.xyz = normalize(r0.xyz);
	r0.xz = float2(-0.5, 0.5);
	r0.y = r0.z + vCustomData[0].w;
	r0.w = -0.009765625 + position.z;
	r0.w = max(r0.w, 0);
	r3.z = min(r0.w, 0.030273438);
	r4.xzw = float3(0, 1, 33.032257);
	r4.xyz = vCustomData[0].xxx * r4.zzx + r4.xxw;
	r5 = r3.zz * r4.zz + float2(-0.5, -1);
	r0.w = -r5.x + -0.5;
	r0.w = r0.w * 3.1415925;
	r6.y = sin(r0.w);
	r0.w = r6.y + 1;
	r1.w = pow(r0.w, 1.2);
	r0.w = r1.w + -1;
	r0.y = r0.w * -r0.y + -0.5;
	r0.z = r0.z + -vCustomData[0].w;
	r0.w = r5.y * 3.1415925;
	r1.w = (0 < r5.x) ? 1 : 0;
	r5.y = sin(r0.w);
	r0.w = r5.y + 1;
	r2.w = pow(r0.w, 1.2);
	r0.w = r2.w + -1;
	r0.z = r0.w * r0.z + 0.5;
	r2.w = lerp(r0.y, r0.z, r1.w);
	r0.y = r3.z * r4.z + r2.w;
	r0.y = r0.y + 0.5;
	r3.xy = position.xy;
	r4.xyz = r3.xyz * r4.xyz;
	r0.z = r3.z * 103.773895;
	r3.y = sin(r0.z);
	r0.z = -r3.y + 1;
	r0.z = r0.z * -r0.z + 1;
	r0.y = r0.y * 0.5 + -r4.z;
	r0.x = (r0.x < vCustomData[0].w) ? 1 : 0;
	r0.x = r0.x * r0.y + r4.z;
	r3.z = r0.x * vCustomData[1].z;
	r4.w = 0;
	r0.x = dot(r4.xyw, r1.xyz);
	r3.xy = r4.xy;
	r0.yw = r4.zz * vCustomData[1].xy;
	r0.yw = r0.yw * 0.15915494 + 0.5;
	r0.yw = frac(r0.yw);
	r0.yw = r0.yw * 6.2831855 + -3.1415927;
	r1.xyz = r0.xxx * -r1.xyz + r3.xyz;
	r1.xyz = r0.xxx * r2.xyz + r1.xyz;
	r2.y = sin(r0.w);
	r3.y = sin(r0.y);
	r0.x = r2.y * vCustomData[2].x;
	r0.x = r3.y * vCustomData[1].w + r0.x;
	r0.x = r0.z * r0.x;
	r0.yz = float2(0.15915494, 0.5);
	r0.y = vCustomData[3].z * r0.y + r0.z;
	r0.y = frac(r0.y);
	r0.y = r0.y * 6.2831855 + -3.1415927;
	sincos(r0.y, r2.y, r2.x);
	r0.xy = r0.xx * r2.xy;
	r0.z = 0;
	r0.xyz = r0.xyz + r1.xyz;
	r1 = r0.y * gWorldViewProj[1];
	r1 = r0.x * gWorldViewProj[0] + r1;
	r0 = r0.z * gWorldViewProj[2] + r1;
	o.position = r0 + gWorldViewProj[3];
	r0.xyz = float3(1, 256, 65536);
	r0.xyz = r0.xyz * vCustomData[2].yyy;
	r0.xyz = frac(r0.xyz);
	o.color.xyz = r0.xyz * vCustomData[0].zzz;
	o.color.w = 1;

	return o;
}
