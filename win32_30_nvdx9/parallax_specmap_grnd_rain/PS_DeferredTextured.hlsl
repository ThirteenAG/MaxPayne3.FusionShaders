sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
sampler2D PuddleMaskSampler : register(s2);
sampler2D SpecSampler : register(s3);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c205);
float bumpiness : register(c200);
float fresnelRolloff : register(c202);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
float4 gWaterGlobals : register(c64);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float parallaxScaleBias : register(c196);
float reflectivePower : register(c201);
float4 specMapExpMask : register(c199);
float3 specMapIntMask : register(c198);
float3 specMapReflectMask : register(c203);
float specularFactor : register(c197);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float2 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float4 r7;
	float3 r8;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.xyz = 1E-05 + i.texcoord7.xyz;
	r0.z = dot(r0.xyz, r0.xyz);
	r0.z = rsqrt(r0.z);
	r0.xy = r0.zz * r0.xy;
	r1.yw = float2(0.5, -1);
	r0.z = r1.y * parallaxScaleBias.x;
	r0.z = r0.w * parallaxScaleBias.x + -r0.z;
	r0.xy = r0.zz * r0.xy + i.texcoord.xy;
	r2 = tex2D(BumpSampler, r0.xy);
	r0 = tex2D(DiffuseSampler, r0.xy);
	r1.xy = r2.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r2.z = dot(r1.xy, -r1.xy) + 1;
	r3.x = max(r2.z, 0);
	r2.z = rsqrt(r3.x);
	r1.z = 1 / r2.z;
	r3 = tex2D(SpecSampler, i.texcoord.xy);
	r2.z = dot(r3, specMapExpMask);
	r2.z = r2.z * specularFactor.x;
	r4.x = dot(r3.xyz, specMapIntMask.xyz);
	r4.y = max(1, r2.z);
	r2.zw = WetDarken.ww * i.texcoord6.xy;
	r5 = tex2D(PuddleMaskSampler, r2.zw);
	r2.z = r5.x + gWaterGlobals.y;
	r2.z = saturate(r2.z + -i.color.y);
	r5.xyz = r0.xyz * WetDarken.xyz;
	r6.xy = lerp(r4.xy, gWaterGlobals.zw, r2.zz);
	r4.zw = 0.3 * i.texcoord6.xy;
	r7 = tex2D(WaterRainRippleNormalSampler, r4.zw);
	r7.xyz = r7.xyz * 2 + -1;
	r7.xyz = r7.xyz * i.texcoord1.zzz + -r1.xyz;
	r7.xyz = r2.zzz * r7.xyz + r1.xyz;
	r7.xyz = r7.xyz + 1E-05;
	r8 = normalize(r7.xyz);
	r2.w = saturate(gWaterGlobals.y);
	r7.xyz = r0.xyz * WetDarken.xyz + -r0.xyz;
	r7.xyz = r2.www * r7.xyz + r0.xyz;
	r5.xyz = (-r2.zzz >= 0) ? r7.xyz : r5.xyz;
	r7.xyz = (-r2.zzz >= 0) ? r1.xyz : r8.xyz;
	r2.zw = (-r2.zz >= 0) ? r4.xy : r6.xy;
	r1.xyz = (-i.color.yyy >= 0) ? r1.xyz : r7.xyz;
	r0.xyz = (-i.color.yyy >= 0) ? r0.xyz : r5.xyz;
	r2.zw = (-i.color.yy >= 0) ? r4.xy : r2.zw;
	r4.xyz = r1.xxx * i.texcoord4.xyz;
	r4.xyz = r1.zzz * i.texcoord1.xyz + r4.xyz;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r4.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r4.xyz = normalize(r1.xyz);
	r1.x = 0;
	if (-reflectivePower.x < r1.x) {
		r1.x = saturate(r2.w * 0.015625);
		r5.w = r1.x * -4 + 4;
		r1.xyz = 1E-05 + i.texcoord3.xyz;
		r6 = normalize(r1.xyz);
		r1.x = dot(-r6.xyz, r4.xyz);
		r1.x = r1.x + r1.x;
		r1.xyz = r4.xyz * -r1.xxx + -r6.xyz;
		r1.xyz = r1.xyz + 1E-05;
		r7.xyz = normalize(r1.xyz);
		r1.x = saturate(r7.z);
		r1.x = r1.x + 1;
		r1.x = r1.x + r1.x;
		r1.x = 1 / r1.x;
		r1.xy = r7.xy * r1.xx + 0.5;
		r5.xy = -r1.xy + 1;
		r5.z = 0;
		r5 = tex2Dlod(DynamicEnvironmentSampler, r5);
		r1.xyz = r5.xyz * r5.xyz;
		r1.xyz = r1.xyz * 16;
		r3.w = saturate(dot(r6.xyz, r4.xyz));
		r1.w = -r1.w + -fresnelRolloff.x;
		r3.w = -r3.w + 1.00001;
		r4.w = r3.w * r3.w;
		r4.w = r4.w * r4.w;
		r3.w = r3.w * r4.w;
		r1.w = fresnelRolloff.x * r3.w + r1.w;
		r1.xyz = r1.www * r1.xyz;
	} else {
		r1.xyz = 0;
	}
	r1.xyz = r1.xyz * reflectivePower.xxx;
	r1.w = dot(r3.xyz, specMapReflectMask.xyz);
	r1.xyz = r1.www * r1.xyz;
	r1.xyz = r1.xyz * globalScalars.www;
	r1.w = dot(r2.xy, r2.xy) + -0.002;
	r1.w = (r1.w >= 0) ? 1 : 0;
	r2.x = r1.w * i.color.x;
	o.color2.x = r1.w * r2.z;
	r0.w = r0.w * i.color.w;
	r2.y = saturate(i.color.x * r1.w + -1);
	r2.y = r2.y * globalScalars2.z;
	o.color.xyz = r0.xyz * r1.www + r2.yyy;
	o.color1.xyz = r4.xyz * 0.5 + 0.5;
	r0.x = saturate(r2.w * 0.0051020407);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = rsqrt(r0.x);
	o.color2.y = 1 / r0.x;
	o.color2.z = r2.x * gAmbientOcclusionEffect.w;
	r0.x = r0.w * globalScalars.x;
	r0.yzw = saturate(r1.xyz * 0.0625);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	r0.w = rsqrt(r0.w);
	o.color3.x = 1 / r0.y;
	o.color3.y = 1 / r0.z;
	o.color3.z = 1 / r0.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3.w = gStencil.x;

	return o;
}
