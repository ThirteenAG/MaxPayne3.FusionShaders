float HybridAdd : register(c89);
float4 NearFarPlane : register(c128);
float gAmbientAmount : register(c99);
float4 gAmbientOcclusionEffect : register(c63);
float4 gAspectRatio : register(c17);
float gBiasToCamera : register(c93);
float gDiffuse : register(c96);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float gNormalArc : register(c101);
float gScaleFade : register(c102);
float gSuperAlpha : register(c100);
float4 gTexCoordScaleOffset0 : register(c106);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float gWrapBias : register(c95);
float gWrapScale : register(c94);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0.zw = 0;
	r1.x = i.normal.z * 0.15915494 + 0.5;
	r1.x = frac(r1.x);
	r1.x = r1.x * 6.2831855 + -3.1415927;
	sincos(r1.x, r2.y, r2.x);
	r1.x = (1E-06 >= i.color.w) ? 1 : 0;
	r1.y = 1 / gScaleFade.x;
	r3.xw = float2(0.1, 0.5);
	r1.z = r3.x * gBiasToCamera.x;
	r3.xyz = lerp(i.position.xyz, gViewInverse[3].xyz, r1.zzz);
	r4 = r3.y * gWorldViewProj[1];
	r4 = r3.x * gWorldViewProj[0] + r4;
	r4 = r3.z * gWorldViewProj[2] + r4;
	r4 = r4 + gWorldViewProj[3];
	r1.z = r4.w + -NearFarPlane.x;
	r1.y = saturate(r1.y * r1.z);
	r1.x = r1.x * -r1.y + r1.y;
	r5 = r1.x * i.normal.xyxy;
	r1.x = r1.x * i.color.w;
	o.texcoord.w = saturate(r1.x * gSuperAlpha.x);
	r1.xyz = r2.yyx * r5.yzw;
	r0.x = r5.x * r2.x + -r1.x;
	r0.y = r1.z + r1.y;
	o.position = r0 * gAspectRatio + r4;
	r0.zw = r0.xy * gAspectRatio.xy;
	r1.w = 1E-05;
	r0.xy = r0.xy * gAspectRatio.xy + r1.ww;
	r0.zw = r0.zw * r0.zw;
	r0.z = r0.w + r0.z;
	r0.z = rsqrt(r0.z);
	r0.z = 1 / r0.z;
	r0.z = (-r0.z < r0.z) ? 1 : 0;
	r1.xy = r0.xy * r0.xy;
	r0.w = r1.y + r1.x;
	r0.w = rsqrt(r0.w);
	r0.xy = r0.ww * r0.xy;
	r0.xy = r0.xy * r0.zz;
	r1.xyz = r3.yyy * gWorldView[1].xyz;
	r1.xyz = r3.xxx * gWorldView[0].xyz + r1.xyz;
	r1.xyz = r3.zzz * gWorldView[2].xyz + r1.xyz;
	r1.xyz = r1.xyz + gWorldView[3].xyz;
	r2.xyz = -r1.xyz + 1E-05;
	r4.xyz = normalize(r2.xyz);
	r2.xyz = r4.zxy * float3(-1, 0, 0);
	r2.xyz = r4.yzx * float3(0, 0, -1) + -r2.xyz;
	r2.xyz = r2.xyz + 1E-05;
	r5.xyz = normalize(r2.xyz);
	r2.xyz = r4.zxy * r5.yzx;
	r2.xyz = r4.yzx * r5.zxy + -r2.xyz;
	r0.yzw = r0.yyy * r2.xyz;
	r0.xyz = r5.xyz * r0.xxx + r0.yzw;
	r0.xyz = r4.xyz * gNormalArc.xxx + r0.xyz;
	r2.xyz = r0.xyz + 1E-05;
	r0.w = dot(r2.xyz, r2.xyz);
	r0.w = rsqrt(r0.w);
	r2.xyz = lerp(-r0.xyz, 1E-05, r0.www);
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r0.w = 1 / r0.w;
	r0.w = (-r0.w < r0.w) ? 1 : 0;
	r0.xyz = r0.www * r2.xyz + r0.xyz;
	r2 = -r1.x + gLightPosX;
	r4 = r2 * -gLightDirX;
	r5 = -r1.y + gLightPosY;
	r1 = -r1.z + gLightPosZ;
	r4 = r5 * -gLightDirY + r4;
	r4 = r1 * -gLightDirZ + r4;
	r6 = r2 * r2;
	r6 = r5 * r5 + r6;
	r6 = r1 * r1 + r6;
	r7 = r6 + 1E-05;
	r8.z = 1;
	r6 = r6 * -gLightFallOff + r8.z;
	r6 = max(r6, 0);
	r6 = r6 * r6;
	r6 = r6 * r6 + -0.1;
	r6 = max(r6, 0);
	r8.x = rsqrt(r7.x);
	r8.y = rsqrt(r7.y);
	r8.z = rsqrt(r7.z);
	r8.w = rsqrt(r7.w);
	r4 = r4 * r8;
	r7 = gLightConeScale;
	r4 = saturate(r4 * r7 + gLightConeOffset);
	r6 = r6 * r8;
	r6 = r6 * 1.1111112;
	r6 = min(r6, 1);
	r4 = r4 * r6;
	r4 = r8 * r4;
	r2 = r2 * r4;
	r2 = r0.x * r2;
	r5 = r4 * r5;
	r2 = r0.y * r5 + r2;
	r1 = r1 * r4;
	r0.w = r4.x * gWrapBias.x;
	r1 = saturate(r0.z * r1 + r2);
	r2.x = dot(gLightColR, r1);
	r2.y = dot(gLightColG, r1);
	r2.z = dot(gLightColB, r1);
	r1.x = dot(r0.xyz, -gDirectionalLight.xyz);
	r0.x = dot(r0.xyz, gWorldView[2].xyz);
	r0.x = saturate(r0.x * -0.5 + 0.5);
	r0.y = saturate(r1.x * gWrapScale.x + r0.w);
	r0.yzw = r0.yyy * gDirectionalColour.xyz;
	r0.yzw = r0.yzw * gDirectionalColour.www + r2.xyz;
	r1.xyz = gLightAmbient0.xyz;
	r1.xyz = -r1.xyz + gLightAmbient1.xyz;
	r1.xyz = r0.xxx * r1.xyz + gLightAmbient0.xyz;
	r1.xyz = r1.xyz * gAmbientOcclusionEffect.yyy;
	r1.xyz = r1.xyz * gAmbientAmount.xxx;
	r0.x = 1 / gAmbientOcclusionEffect.y;
	r0.xyz = r1.xyz * r0.xxx + r0.yzw;
	r0.xyz = r0.xyz * gDiffuse.xxx;
	o.texcoord.xyz = r0.xyz * i.color.xyz;
	r0.xyz = r3.xyz + -gViewInverse[3].xyz;
	r0.w = r0.z * globalFogParams.x;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * globalFogParams.z;
	r0.y = r0.w * -1.442695;
	r0.y = exp2(r0.y);
	r0.y = min(r0.y, 65504);
	r0.y = -r0.y + 1;
	r0.z = 1 / r0.w;
	r0.w = (0.0001 < abs(r0.w)) ? 1 : 0;
	r0.y = r0.z * r0.y;
	r0.y = r0.x * r0.y + -r0.x;
	r0.x = r0.w * r0.y + r0.x;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = exp2(r0.x);
	r0.x = min(r0.x, 65504);
	o.texcoord4.w = -r0.x + 1;
	r0.x = (r3.w < HybridAdd.x) ? 1 : 0;
	o.texcoord3.z = r0.x * -i.texcoord3.x + 1;
	r0 = r3.y * gWorldView[1];
	r0 = r3.x * gWorldView[0] + r0;
	r0 = r3.z * gWorldView[2] + r0;
	o.texcoord7 = r0 + gWorldView[3];
	o.texcoord1 = i.texcoord * gTexCoordScaleOffset0.xyxy + gTexCoordScaleOffset0.zwzw;
	o.texcoord3.xy = float2(1, 0) * i.texcoord2.zz;
	o.texcoord3.w = i.texcoord3.y;
	o.texcoord4.xyz = globalFogColorN.xyz;

	return o;
}
