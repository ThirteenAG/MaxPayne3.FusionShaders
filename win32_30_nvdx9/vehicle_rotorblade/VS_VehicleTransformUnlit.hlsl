float BoundRadius : register(c196);
sampler2D DamageSampler : register(s1);
float3 droopParams : register(c198);
row_major float4x4 gWorldViewProj : register(c8);
float2 gravityDroop : register(c199);
bool switchOn : register(b8);

struct VS_IN
{
	float4 position : POSITION;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
};

struct VS_OUT
{
	float4 position : POSITION;
	float2 texcoord : TEXCOORD;
	float4 texcoord2 : TEXCOORD2;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float2 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	r0.xyz = float3(1, 1, 0) * i.position.xyx;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.y = r0.x * droopParams.x;
	r0.y = r0.y * gravityDroop.x;
	r1.z = r0.y * -0.01 + i.position.z;
	r1.xy = i.position.xy;
	r0.yzw = r1.xyz + 1E-05;
	r2.xyz = normalize(r0.yzw);
	r0.y = dot(r2.xzy, float3(0.70710677, 0.70710677, 7.070997E-06));
	r0.z = 0.01;
	r0.z = r0.z * droopParams.y;
	r0.x = r0.x * gravityDroop.x;
	r0.x = r0.z * r0.x;
	r0.y = r0.y + gravityDroop.y;
	r0.y = r0.y * droopParams.z;
	r0.y = r0.y * 0.15915494 + 0.5;
	r0.y = frac(r0.y);
	r0.y = r0.y * 6.2831855 + -3.1415927;
	r2.y = sin(r0.y);
	r0.z = r0.x * -r2.y + r1.z;
	if (switchOn) {
		r0.xy = i.position.xy;
		r0.w = dot(r0.xyz, r0.xyz);
		r0.w = rsqrt(r0.w);
		r1.x = 1 / r0.w;
		r1.y = r0.z * -r0.w + 1;
		r1.y = r1.y * 0.5;
		r1.zw = r0.xy * r0.ww + 1E-05;
		r2.xy = r1.zw * r1.zw;
		r0.w = r2.y + r2.x;
		r0.w = rsqrt(r0.w);
		r1.zw = r0.ww * r1.zw;
		r1.yz = r1.yy * r1.zw;
		r2.xy = r1.yz * 0.5 + 0.5;
		r1.yz = r2.xy * 126.73267;
		r3.xy = frac(abs(r1.yz));
		r1.yz = (r1.yz >= -r1.yz) ? 1 : 0;
		r4 = lerp(-r3.xy, r3.xy, r1.yz);
		r2.zw = 0;
		r3 = tex2Dlod(DamageSampler, r2);
		r2 = r4.xyxx * -0.007890625 + r2.xyxx;
		r5 = r2.wywy + float4(0.007890625, 0, 0, 0.007890625);
		r6 = r5.xyxx * float4(1, 1, 0, 0);
		r6 = tex2Dlod(DamageSampler, r6);
		r5 = r5.zwxx * float4(1, 1, 0, 0);
		r5 = tex2Dlod(DamageSampler, r5);
		r2 = r2 * float4(1, 1, 0, 0) + float4(0.007890625, 0.007890625, 0, 0);
		r2 = tex2Dlod(DamageSampler, r2);
		r0.w = r3.x * 1.5258789E-05;
		r1.y = frac(r0.w);
		r1.z = r0.w + -r1.y;
		r0.w = (r0.w < -r0.w) ? 1 : 0;
		r1.y = (-r1.y < r1.y) ? 1 : 0;
		r7.z = r0.w * r1.y + r1.z;
		r0.w = r7.z * -65536 + r3.x;
		r1.y = r0.w * 0.00390625;
		r1.z = frac(r1.y);
		r1.w = r1.y + -r1.z;
		r1.y = (r1.y < -r1.y) ? 1 : 0;
		r1.z = (-r1.z < r1.z) ? 1 : 0;
		r7.y = r1.y * r1.z + r1.w;
		r7.x = r7.y * -256 + r0.w;
		r0.w = r6.x * 1.5258789E-05;
		r1.y = frac(r0.w);
		r1.z = r0.w + -r1.y;
		r0.w = (r0.w < -r0.w) ? 1 : 0;
		r1.y = (-r1.y < r1.y) ? 1 : 0;
		r3.z = r0.w * r1.y + r1.z;
		r0.w = r3.z * -65536 + r6.x;
		r1.y = r0.w * 0.00390625;
		r1.z = frac(r1.y);
		r1.w = r1.y + -r1.z;
		r1.y = (r1.y < -r1.y) ? 1 : 0;
		r1.z = (-r1.z < r1.z) ? 1 : 0;
		r3.y = r1.y * r1.z + r1.w;
		r3.x = r3.y * -256 + r0.w;
		r0.w = r5.x * 1.5258789E-05;
		r1.y = frac(r0.w);
		r1.z = r0.w + -r1.y;
		r0.w = (r0.w < -r0.w) ? 1 : 0;
		r1.y = (-r1.y < r1.y) ? 1 : 0;
		r6.z = r0.w * r1.y + r1.z;
		r0.w = r6.z * -65536 + r5.x;
		r1.y = r0.w * 0.00390625;
		r1.z = frac(r1.y);
		r1.w = r1.y + -r1.z;
		r1.y = (r1.y < -r1.y) ? 1 : 0;
		r1.z = (-r1.z < r1.z) ? 1 : 0;
		r6.y = r1.y * r1.z + r1.w;
		r6.x = r6.y * -256 + r0.w;
		r0.w = r2.x * 1.5258789E-05;
		r1.y = frac(r0.w);
		r1.z = r0.w + -r1.y;
		r0.w = (r0.w < -r0.w) ? 1 : 0;
		r1.y = (-r1.y < r1.y) ? 1 : 0;
		r5.z = r0.w * r1.y + r1.z;
		r0.w = r5.z * -65536 + r2.x;
		r1.y = r0.w * 0.00390625;
		r1.z = frac(r1.y);
		r1.w = r1.y + -r1.z;
		r1.y = (r1.y < -r1.y) ? 1 : 0;
		r1.z = (-r1.z < r1.z) ? 1 : 0;
		r5.y = r1.y * r1.z + r1.w;
		r5.x = r5.y * -256 + r0.w;
		r1.yz = -r4.xy + 1;
		r2.xyz = r1.yyy * r7.xyz;
		r3.xyz = r4.xxx * r3.xyz;
		r3.xyz = r1.zzz * r3.xyz;
		r2.xyz = r2.xyz * r1.zzz + r3.xyz;
		r1.yzw = r1.yyy * r6.xyz;
		r1.yzw = r1.yzw * r4.yyy + r2.xyz;
		r2.xyz = r4.xxx * r5.xyz;
		r1.yzw = r2.xyz * r4.yyy + r1.yzw;
		r1.yzw = r1.yzw + -128;
		r2.xyz = r1.yzw * 0.0078125;
		r1.yzw = (r1.yzw < -102.4) ? 1 : 0;
		r0.w = r1.z * r1.y;
		r0.w = r1.w * r0.w;
		r1.yzw = r0.www * -r2.xyz + r2.xyz;
		r0.w = 1 / BoundRadius.x;
		r0.w = r0.w * r1.x;
		r0.w = min(r0.w, 1);
		r1.xyz = r0.www * r1.yzw;
		r1.xyz = r1.xyz * 0.5 + r0.xyz;
	} else {
		r1.xy = i.position.xy;
		r1.z = r0.z;
	}
	r0.xy = i.position.xy;
	r0.xyz = -r1.xyz + r0.xyz;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r2 = r1.y * gWorldViewProj[1];
	r2 = r1.x * gWorldViewProj[0] + r2;
	r1 = r1.z * gWorldViewProj[2] + r2;
	o.position = r1 + gWorldViewProj[3];
	r0.x = min(r0.x, 0.04);
	o.texcoord2 = r0.x * 6 + i.color;
	o.texcoord = i.texcoord.xy;

	return o;
}
