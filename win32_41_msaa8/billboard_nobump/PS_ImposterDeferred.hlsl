PS_OUT main(PS_IN i)
{
	PS_OUT o;

	int4 r0;
	int4 r1;
	int4 r2;
	int4 r3;
	int4 r4;
	int4 r5;
	float2 r6;
	r0 = asint(ddx(i.texcoord.xyxy));
	r1 = asint(ddy(i.texcoord.xyxy));
	r2 = asint(asfloat(r1.zwzw) * float4(-0.1875, -0.1875, 0.1875, 0.1875));
	r2 = asint(asfloat(r0.zwzw) * float4(0.0625, 0.0625, -0.0625, -0.0625) + asfloat(r2));
	r2 = asint(asfloat(r2) + i.texcoord.xyxy);
	r3 = asint(imposterSampler_tex.Sample(imposterSampler, asfloat(r2.xy)).xwyz);
	r2.x = asint(asfloat(r3.y) + -0.5);
	r2.x = (asfloat(r2.x) >= 0) ? -1 : 0;
	r4.xyz = asint(asfloat(r3.yyy) * asfloat(r3.xzw));
	r4.xyz = r2.xxx & r4.xyz;
	r3.x = 1;
	r3.xy = r2.xx & r3.xy;
	r5 = asint(imposterSampler_tex.Sample(imposterSampler, asfloat(r2.zw)));
	r2.y = asint(asfloat(r5.w) + -0.5);
	r2.y = (asfloat(r2.y) >= 0) ? -1 : 0;
	r6.x = (r2.x != 0) ? 3 : 2;
	r2.xzw = asint(asfloat(r5.xyz) * asfloat(r5.www) + asfloat(r4.xyz));
	r6.y = asfloat(r3.y) + asfloat(r5.w);
	r2.xzw = (r2.yyy != 0) ? r2.xzw : r4.xyz;
	r3.xy = (r2.yy != 0) ? asint(r6.xy) : r3.xy;
	r4 = asint(asfloat(r1.zwzw) * float4(0.0625, 0.0625, -0.3125, -0.3125));
	r4 = asint(asfloat(r0.zwzw) * float4(0.3125, 0.3125, -0.1875, -0.1875) + asfloat(r4));
	r4 = asint(asfloat(r4) + i.texcoord.xyxy);
	r5 = asint(imposterSampler_tex.Sample(imposterSampler, asfloat(r4.xy)));
	r2.y = asint(asfloat(r5.w) + -0.5);
	r2.y = (asfloat(r2.y) >= 0) ? -1 : 0;
	r4.x = r3.x + 4;
	r5.xyz = asint(asfloat(r5.xyz) * asfloat(r5.www) + asfloat(r2.xzw));
	r4.y = asint(asfloat(r3.y) + asfloat(r5.w));
	r2.xzw = (r2.yyy != 0) ? r5.xyz : r2.xzw;
	r3.xy = (r2.yy != 0) ? r4.xy : r3.xy;
	r4 = asint(imposterSampler_tex.Sample(imposterSampler, asfloat(r4.zw)));
	r2.y = asint(asfloat(r4.w) + -0.5);
	r2.y = (asfloat(r2.y) >= 0) ? -1 : 0;
	r5.x = r3.x + 8;
	r4.xyz = asint(asfloat(r4.xyz) * asfloat(r4.www) + asfloat(r2.xzw));
	r5.y = asint(asfloat(r3.y) + asfloat(r4.w));
	r2.xzw = (r2.yyy != 0) ? r4.xyz : r2.xzw;
	r3.xy = (r2.yy != 0) ? r5.xy : r3.xy;
	r4 = asint(asfloat(r1.zwzw) * float4(0.3125, 0.3125, -0.0625, -0.0625));
	r4 = asint(asfloat(r0.zwzw) * float4(-0.3125, -0.3125, -0.4375, -0.4375) + asfloat(r4));
	r4 = asint(asfloat(r4) + i.texcoord.xyxy);
	r5 = asint(imposterSampler_tex.Sample(imposterSampler, asfloat(r4.xy)));
	r2.y = asint(asfloat(r5.w) + -0.5);
	r2.y = (asfloat(r2.y) >= 0) ? -1 : 0;
	r4.x = r3.x + 16;
	r5.xyz = asint(asfloat(r5.xyz) * asfloat(r5.www) + asfloat(r2.xzw));
	r4.y = asint(asfloat(r3.y) + asfloat(r5.w));
	r2.xzw = (r2.yyy != 0) ? r5.xyz : r2.xzw;
	r3.xy = (r2.yy != 0) ? r4.xy : r3.xy;
	r4 = asint(imposterSampler_tex.Sample(imposterSampler, asfloat(r4.zw)));
	r2.y = asint(asfloat(r4.w) + -0.5);
	r2.y = (asfloat(r2.y) >= 0) ? -1 : 0;
	r5.x = r3.x + 32;
	r4.xyz = asint(asfloat(r4.xyz) * asfloat(r4.www) + asfloat(r2.xzw));
	r5.y = asint(asfloat(r3.y) + asfloat(r4.w));
	r2.xzw = (r2.yyy != 0) ? r4.xyz : r2.xzw;
	r3.xy = (r2.yy != 0) ? r5.xy : r3.xy;
	r1 = asint(asfloat(r1) * float4(0.4375, 0.4375, -0.4375, -0.4375));
	r0 = asint(asfloat(r0) * float4(0.1875, 0.1875, 0.4375, 0.4375) + asfloat(r1));
	r0 = asint(asfloat(r0) + i.texcoord.xyxy);
	r1 = asint(imposterSampler_tex.Sample(imposterSampler, asfloat(r0.xy)));
	r0.x = asint(asfloat(r1.w) + -0.5);
	r0.x = (asfloat(r0.x) >= 0) ? -1 : 0;
	r4.x = r3.x + 64;
	r1.xyz = asint(asfloat(r1.xyz) * asfloat(r1.www) + asfloat(r2.xzw));
	r4.y = asint(asfloat(r1.w) + asfloat(r3.y));
	r1.xyz = (r0.xxx != 0) ? r1.xyz : r2.xzw;
	r0.xy = (r0.xx != 0) ? r4.xy : r3.xy;
	r2 = asint(imposterSampler_tex.Sample(imposterSampler, asfloat(r0.zw)));
	r0.z = asint(asfloat(r2.w) + -0.5);
	r0.z = (asfloat(r0.z) >= 0) ? -1 : 0;
	r3.x = r0.x + 128;
	r2.xyz = asint(asfloat(r2.xyz) * asfloat(r2.www) + asfloat(r1.xyz));
	r3.y = asint(asfloat(r0.y) + asfloat(r2.w));
	r1.xyz = (r0.zzz != 0) ? r2.xyz : r1.xyz;
	r0.xy = (r0.zz != 0) ? r3.xy : r0.xy;
	r1.xyz = asint(asfloat(r1.xyz) / asfloat(r0.yyy));
	r1.w = r0.y;
	r2 = asint(asfloat(r1) * float4(15.9377499, 15.9377499, 15.9377499, 15.9377499));
	r2 = asint(frac(asfloat(r2)));
	r2 = asint(asfloat(r2) * float4(16, 16, 16, 16));
	r1 = asint(asfloat(r1) * float4(255.003998, 255.003998, 255.003998, 255.003998) + -(asfloat(r2)));
	r1 = asint(asfloat(r1) * float4(0.0625, 0.0625, 0.0625, 0.0625));
	r0.y = asint(dot(asfloat(r2), i.texcoord1));
	r0.z = asint(dot(asfloat(r1), i.texcoord2));
	r0.y = asint(asfloat(r0.z) + asfloat(r0.y));
	r0.z = asint(dot(asfloat(r2), i.texcoord3));
	r0.w = asint(dot(asfloat(r1), i.texcoord4));
	r0.z = asint(asfloat(r0.w) + asfloat(r0.z));
	r0.w = asint(saturate(asfloat(r0.y)));
	r1.x = asint(saturate(asfloat(r0.z)));
	r1.x = asint(asfloat(r1.x) * i.texcoord.w);
	r0.w = asint(asfloat(r0.w) * i.texcoord.z + asfloat(r1.x));
	r0.w = asint(asfloat(r0.w) * i.color.w);
	r1.x = (asfloat(r0.w) < 0.5) ? -1 : 0;
	if (r1.x != 0) discard;
	r1.xyz = asint(imposterSampler_tex.Sample(imposterSampler, float2(0.9921875, 0.0078125)).xyz);
	r0.y = asint(floor(asfloat(r0.y)));
	r2.x = asint(asfloat(r0.y) * 0.0625);
	r2.yw = int2(1056964608, 1056964608);
	r3.xyz = asint(blitSampler_tex.Sample(blitSampler, asfloat(r2.xy)).xyz);
	r3.xyz = asint(asfloat(r3.xyz) * float3(2, 2, 2) + float3(-1, -1, -1));
	r0.y = asint(floor(asfloat(r0.z)));
	r2.z = asint(asfloat(r0.y) * 0.0625);
	r2.xyz = asint(blitSampler_tex.Sample(blitSampler, asfloat(r2.zw)).xyz);
	r2.xyz = asint(asfloat(r2.xyz) * float3(2, 2, 2) + float3(-1, -1, -1));
	r2.xyz = asint(asfloat(r2.xyz) * i.texcoord.www);
	r2.xyz = asint(asfloat(r3.xyz) * i.texcoord.zzz + asfloat(r2.xyz));
	r2.xyz = asint(asfloat(r2.xyz) + float3(0.00000999999975, 0.00000999999975, 0.00000999999975));
	r0.y = asint(dot(asfloat(r2.xyz), asfloat(r2.xyz)));
	r0.y = asint(rsqrt(asfloat(r0.y)));
	r2.xyz = asint(asfloat(r0.yyy) * asfloat(r2.xyz));
	r3.xyz = asint(asfloat(r2.yyy) * i.texcoord6.xyz);
	r2.xyw = asint(i.texcoord5.xyz * asfloat(r2.xxx) + asfloat(r3.xyz));
	r2.xyz = asint(i.texcoord7.xyz * asfloat(r2.zzz) + asfloat(r2.xyw));
	o.sv_target1.xyz = asfloat(r2.xyz) * float3(0.5, 0.5, 0.5) + float3(0.5, 0.5, 0.5);
	r0.yz = asint(frac(i.sv_position.xy));
	r0.yz = asint(asfloat(r0.yz) + float2(-0.5, -0.5));
	o.sv_target2.w = dot(abs(asfloat(r0.yz)), float2(1000, 1000));
	o.sv_target.xyz = asfloat(r1.xyz);
	o.sv_target.w = asfloat(r0.w);
	o.sv_target1.w = 0;
	o.sv_target2.xyz = float3(0, 0.5, 0.5);
	o.sv_target3.xyz = float3(0, 0, 0);
	o.sv_target3.w = asfloat(r0.w);
