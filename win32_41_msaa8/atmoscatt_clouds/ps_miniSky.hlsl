cbuffer _Globals : register(b1)
{
	float4 SunDirection : packoffset(c132);
	float3 SkyColor : packoffset(c133);
	float3 AzimuthColor : packoffset(c134);
	float3 SunColor : packoffset(c135);
	float UnderLightStrength : packoffset(c136);
	float3 gtaSkyDomeFade : packoffset(c137);
	float3 gtaWaterColor : packoffset(c138);
	float MoonGlow : packoffset(c139);
	float2 SunAxias : packoffset(c140);
	float3 AzimuthColorEast : packoffset(c141);
	float AzimuthHeight : packoffset(c142);
	float4 CloudColor : packoffset(c143);
	float4 SunsetColor : packoffset(c144);
	float AzimuthStrength : packoffset(c145);
	float CloudThreshold : packoffset(c146);
	float CloudBias : packoffset(c147);
	float CloudFadeOut : packoffset(c148);
	float TopCloudHeight : packoffset(c149);
	float TopCloudDetail : packoffset(c150);
	float TopCloudThreshold : packoffset(c151);
	float4 TopCloudBiasDetailThresholdHeight : packoffset(c152);
	float3 TopCloudColor : packoffset(c153);
	float TopCloudLight : packoffset(c154);
	float CloudShadowStrength : packoffset(c155);
	float CloudShadowOffset : packoffset(c156);
	float4 CloudThicknessEdgeSmoothDetailScaleStrength : packoffset(c157);
	float CloudInscatteringRange : packoffset(c158);
	float4 StarFieldBrightness : packoffset(c159);
	float StarFieldUVRepeat : packoffset(c160);
	float2 GalaxyOffset : packoffset(c161);
	float4 MoonTexPosition : packoffset(c162);
	float4 MoonLight : packoffset(c163);
	float StarThreshold : packoffset(c164);
	float MoonVisiblity : packoffset(c165);
	float4 MoonColorConstant : packoffset(c166);
	float3 MoonPosition : packoffset(c167);
	float3 MoonXVector : packoffset(c168);
	float3 MoonYVector : packoffset(c169);
	float2 DetailOffset : packoffset(c170);
	float SunSize : packoffset(c171);
	float TimeOfDay : packoffset(c172);
	float HDRExposure : packoffset(c173);
	float3 HDRSunExposure : packoffset(c174);
	float3 HDRExposureClamp : packoffset(c175);
};

cbuffer Sun : register(b4)
{
	float3 SunCentre : packoffset(c0);
};

SamplerState GalaxySampler : register(s5);
SamplerState PerlinNoiseSampler : register(s6);
SamplerState HighDetailNoiseSampler : register(s7);
Texture2D GalaxySampler_tex : register(t5);
Texture2D PerlinNoiseSampler_tex : register(t6);
Texture2D HighDetailNoiseSampler_tex : register(t7);

struct PS_IN
{
	float4 sv_position : SV_Position;
	float2 texcoord : TEXCOORD;
};

float4 main(PS_IN i) : SV_Target
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	r0.xy = i.texcoord.xy + float2(-0.5, -0.5);
	r0.zw = r0.xy * float2(2, 2) + float2(0.00000999999975, 0.00000999999975);
	r0.xy = r0.xy + r0.xy;
	r0.x = dot(r0.xy, r0.xy);
	r0.y = dot(r0.zw, r0.zw);
	r0.y = rsqrt(r0.y);
	r0.yz = r0.yy * r0.zw;
	r0.yz = r0.yz * r0.xx;
	r0.x = sqrt(r0.x);
	r0.x = -(r0.x) + 1;
	r1.xyz = r0.yxz * float3(4000, 4000, 4000);
	r0.xyz = r1.xyz + float3(0.00000999999975, 0.00000999999975, 0.00000999999975);
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r0.xyz = r0.www * r0.xyz;
	r0.w = saturate(r0.y * AzimuthHeight);
	r0.w = -(r0.w) + 1;
	r0.w = r0.w * AzimuthStrength;
	r1.x = r0.x * 0.5 + 0.5;
	r1.yzw = AzimuthColor.xyz + -(AzimuthColorEast.xyz);
	r1.xyz = r1.xxx * r1.yzw + AzimuthColorEast.xyz;
	r1.xyz = r1.xyz * r0.www + SkyColor.xyz;
	r0.x = dot(r0.xyz, SunDirection.xyz);
	r0.y = saturate(r0.y * 4 + -(CloudFadeOut));
	r2 = r0.x * float4(12.5799999, -0.0625, 0.5, 0.25) + float4(-11.6163721, 0.9375, 0.5, 0.349999994);
	r0.x = r0.x * r0.x;
	r2.xyz = saturate(r2.xyz);
	r0.z = r2.y * r2.y;
	r0.z = r0.z * r2.y;
	r0.w = log2(r2.x);
	r0.w = r0.w * 32;
	r0.w = exp2(r0.w);
	r1.w = saturate(0.600000024 + SunDirection.w);
	r0.z = -(r0.z) * r1.w + r0.w;
	r0.z = r2.z * SunSize + r0.z;
	r0.w = r2.z + -(SunCentre.x);
	r0.z = saturate(r0.z * 0.5);
	r1.w = -(SunCentre.x) + SunCentre.y;
	r1.w = 1 / r1.w;
	r0.w = saturate(r0.w * r1.w);
	r1.w = r0.w * -2 + 3;
	r0.w = r0.w * r0.w;
	r0.w = r0.w * r1.w;
	r0.w = r0.w * SunCentre.z;
	r0.z = r0.z * 4 + r0.w;
	r2.xyz = r0.zzz * SunColor.xyz;
	r2.xyz = abs(r2.xyz) + float3(0.00000999999975, 0.00000999999975, 0.00000999999975);
	r2.xyz = log2(r2.xyz);
	r2.xyz = r2.xyz * float3(4.00001001, 4.00001001, 4.00001001);
	r2.xyz = exp2(r2.xyz);
	r3.xyz = r0.zzz * SunColor.xyz + r2.xyz;
	r3.w = saturate(-(r0.z) + 1);
	r3 = r3 * HDRSunExposure.x;
	r1.xyz = saturate(r1.xyz * r3.www);
	r2.xyz = min(r3.xyz, HDRExposureClamp.xyz);
	r1.xyz = r1.xyz + r2.xyz;
	r2.xyz = GalaxySampler_tex.Sample(GalaxySampler, i.texcoord.xy).xyz;
	r1.xyz = r2.xyz * StarFieldBrightness.yyy + r1.xyz;
	r0.zw = i.texcoord.xy * CloudThicknessEdgeSmoothDetailScaleStrength.zz;
	r0.z = HighDetailNoiseSampler_tex.Sample(HighDetailNoiseSampler, r0.zw).x;
	r0.z = r0.z * CloudThicknessEdgeSmoothDetailScaleStrength.w;
	r2.xyz = PerlinNoiseSampler_tex.Sample(PerlinNoiseSampler, i.texcoord.xy).xyz;
	r0.z = r0.z * 0.200000003 + r2.x;
	r0.z = CloudThreshold * r0.z + -(CloudBias);
	r0.z = saturate(r0.z * CloudShadowStrength);
	r0.w = -(r0.z) + 1;
	r1.w = 0.00000999999975 + CloudThicknessEdgeSmoothDetailScaleStrength.x;
	r3.x = HighDetailNoiseSampler_tex.Sample(HighDetailNoiseSampler, i.texcoord.xy).x;
	r3.x = r3.x + -0.5;
	r2.x = r3.x * CloudThicknessEdgeSmoothDetailScaleStrength.w + r2.x;
	r2.x = saturate(CloudThreshold * r2.x + -(CloudBias));
	r3.y = r2.x + 0.00000999999975;
	r2.x = saturate(r2.x * CloudThicknessEdgeSmoothDetailScaleStrength.y);
	r3.y = log2(r3.y);
	r1.w = r1.w * r3.y;
	r1.w = exp2(r1.w);
	r3.y = r2.x * r1.w;
	r1.w = -(r1.w) * r2.x + 1;
	r0.w = r0.w * r3.y;
	r2.x = saturate(r3.x * 0.200000003 + r2.z);
	r2.z = r3.x * CloudThicknessEdgeSmoothDetailScaleStrength.w;
	r2.y = r2.z * TopCloudBiasDetailThresholdHeight.y + r2.y;
	r2.y = saturate(TopCloudBiasDetailThresholdHeight.z * r2.y + -(TopCloudBiasDetailThresholdHeight.x));
	r2.y = r2.y * i.texcoord.x;
	r2.y = r1.w * r2.y;
	r0.w = r0.w * r2.x + r2.x;
	r0.w = r2.w * r0.w;
	r2.x = -(r0.z) * 0.5 + r1.w;
	r1.w = r1.w * r2.y + r3.y;
	r0.y = r0.y * r1.w;
	r1.w = max(r2.x, 0);
	r0.x = r0.x * r1.w;
	r0.x = r0.x * CloudInscatteringRange + 1;
	r2.xzw = saturate(r0.xxx * CloudColor.xyz + -(r0.zzz));
	r0.xzw = SunsetColor.xyz * r0.www + r2.xzw;
	r2.xzw = -(r0.xzw) + TopCloudColor.xyz;
	r0.xzw = r2.yyy * r2.xzw + r0.xzw;
	r0.xzw = -(r1.xyz) + r0.xzw;
	r0.xyz = r0.yyy * r0.xzw + r1.xyz;
	r0.xyz = r0.xyz * HDRExposure;
	o.xyz = min(r0.xyz, HDRExposureClamp.xyz);
	o.w = 1;

	return o;
}
