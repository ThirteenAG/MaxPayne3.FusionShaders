struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord7 : TEXCOORD7;
	float2 texcoord1 : TEXCOORD1;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord6 : TEXCOORD6;
	float3 texcoord3 : TEXCOORD3;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	r0 = gLightPosX + -i.texcoord7.x;
	r1 = r0 * r0;
	r2 = gLightPosY + -i.texcoord7.y;
	r1 = r2 * r2 + r1;
	r3 = gLightPosZ + -i.texcoord7.z;
	r1 = r3 * r3 + r1;
	r4 = r1 + 1E-05;
	r5.xyw = float3(0.57735026, 1, 1E-05);
	r1 = saturate(r1 * -gLightFallOff + r5.y);
	r1 = r1 * r1;
	r1 = r1 * r1 + -0.1;
	r6.x = rsqrt(r4.x);
	r6.y = rsqrt(r4.y);
	r6.z = rsqrt(r4.z);
	r6.w = rsqrt(r4.w);
	r0 = r0 * r6;
	r4 = r0 * 0.57735026;
	r2 = r2 * r6;
	r3 = r3 * r6;
	r4 = r2 * 0.57735026 + r4;
	r4 = r3 * 0.57735026 + r4;
	r6 = -r4 + 1;
	r4 = gNormalArc.x * r6 + r4;
	r6 = r1 * 1.1111112;
	r4 = saturate(r4 * r6);
	r6 = r0 * -gLightDirX;
	r0 = r0 * 0.6666667;
	r0 = r2 * 0.6666667 + r0;
	r2 = r2 * -gLightDirY + r6;
	r2 = r3 * -gLightDirZ + r2;
	r0 = saturate(r3 * -0.33333334 + r0);
	r0 = r0 + 1E-05;
	r3 = gLightConeScale;
	r2 = saturate(r2 * r3 + gLightConeOffset);
	r2 = r4 * r2;
	r1 = (r1 >= 0) ? r2 : 0;
	r2.x = log2(r0.x);
	r2.y = log2(r0.y);
	r2.z = log2(r0.z);
	r2.w = log2(r0.w);
	r0.x = r5.w + gSpecularExponent.x;
	r2 = r2 * r0.x;
	r3.x = exp2(r2.x);
	r3.y = exp2(r2.y);
	r3.z = exp2(r2.z);
	r3.w = exp2(r2.w);
	r2 = r1 * r3;
	r3.x = dot(gLightColR, r2);
	r3.y = dot(gLightColG, r2);
	r3.z = dot(gLightColB, r2);
	r0.yzw = r3.xyz * gSpecularIntensity.xxx;
	r2.xyz = max(r0.yzw, 0);
	r3.x = dot(gLightColR, r1);
	r3.y = dot(gLightColG, r1);
	r3.z = dot(gLightColB, r1);
	r0.yzw = r3.xyz * i.texcoord.xyz;
	r1.xyz = max(r0.yzw, 0);
	r0.yzw = r2.xyz + r1.xyz;
	r1.xy = float2(0.6666667, -0.33333334);
	r1.x = saturate(dot(r1.xxy, -gDirectionalLight.xyz));
	r1.x = r1.x + 1E-05;
	r2.x = pow(r1.x, r0.x);
	r0.x = gWrapScale.x;
	r1.x = r2.x * r0.x + gWrapBias.x;
	r1.x = r1.x * gDirectionalColour.x;
	r1.x = r1.x * gSpecularIntensity.x;
	r2.x = max(r1.x, 0);
	r1.x = dot(r5.xxx, -gDirectionalLight.xyz);
	r2.y = max(r1.x, -gLightIntensityClamp.x);
	r1.x = min(gLightIntensityClamp.x, r2.y);
	r1.y = -r1.x + 1;
	r1.x = gNormalArc.x * r1.y + r1.x;
	r0.x = r1.x * r0.x + gWrapBias.x;
	r0.x = r0.x * gDirectionalColour.x;
	r0.x = r0.x * gDiffuse.x;
	r1.xyz = r0.xxx * i.texcoord.xyz;
	r2.yzw = max(r1.xyz, 0);
	r1.xyz = r2.xxx + r2.yzw;
	r0.xyz = r0.yzw + r1.xyz;
	r0.w = dot(r5.xxx, gWorldView[2].xyz);
	r0.w = saturate(r0.w * -0.5 + 0.5);
	r1.xyz = gLightAmbient0.xyz;
	r1.xyz = -r1.xyz + gLightAmbient1.xyz;
	r1.xyz = r0.www * r1.xyz + gLightAmbient0.xyz;
	r1.xyz = r1.xyz * gAmbientOcclusionEffect.yyy;
	r1.xyz = r1.xyz * gAmbientAmount.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = r1.xyz * i.texcoord.xyz;
	r2.xyz = r1.xyz * gAmbientShadow.xxx;
	r1.xyz = (r1.xyz >= 0) ? r2.xyz : 0;
	r0.xyz = r0.xyz + r1.xyz;
	r1.xy = i.texcoord1.xy * gTexCoordScaleOffset2.xy + gTexCoordScaleOffset2.zw;
	r1 = tex2D(DiffuseTexSampler, r1.xy);
	r2.xy = i.texcoord1.xy * gTexCoordScaleOffset0.xy + gTexCoordScaleOffset0.zw;
	r2 = tex2D(DiffuseTexSampler, r2.xy);
	r3.xy = i.texcoord1.xy * gTexCoordScaleOffset1.xy + gTexCoordScaleOffset1.zw;
	r3 = tex2D(DiffuseTexSampler, r3.xy);
	r4 = gActiveUnit * i.texcoord6;
	r3 = r3 * r4.y;
	r2 = r4.x * r2 + r3;
	r1 = r4.z * r1 + r2;
	r2.xy = i.texcoord1.xy * gTexCoordScaleOffset3.xy + gTexCoordScaleOffset3.zw;
	r2 = tex2D(DiffuseTexSampler, r2.xy);
	r1 = r4.w * r2 + r1;
	r0.w = saturate(gSuperAlpha.x * i.texcoord.w);
	r2 = r0.wxyz * r1.wxyz;
	r0.w = dot(r2.yzw, float3(0.2125, 0.7154, 0.0721));
	r2.x = saturate(r2.x);
	r0.xyz = r0.xyz * r1.xyz + -r0.www;
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r0.xyz = r1.xxx * r0.xyz + r0.www;
	r1.xyz = lerp(r0.xyz, i.texcoord4.xyz, i.texcoord4.www);
	r0.x = (-HybridAdd.x >= 0) ? r5.y : r2.x;
	o.w = r2.x * i.texcoord3.z;
	o.xyz = r0.xxx * r1.xyz;

	return o;
}
