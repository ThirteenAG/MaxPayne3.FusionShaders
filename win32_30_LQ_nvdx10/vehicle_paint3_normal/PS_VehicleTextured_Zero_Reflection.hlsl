sampler2D BumpSampler : register(s4);
sampler2D DiffuseSampler : register(s0);
sampler2D DiffuseSampler2 : register(s2);
sampler2D DirtSampler : register(s3);
sampler2D SpecSampler : register(s5);
float bumpiness : register(c209);
float4 deSatContrastGamma : register(c46);
float3 dirtColor : register(c200);
float dirtLevel : register(c199);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float3 matDiffuseColor : register(c197);
float4 matDiffuseColor2 : register(c198);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float specularColorFactor : register(c202);
float specularFactor : register(c201);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = tex2D(DiffuseSampler2, i.texcoord.zw);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r3.x = max(r0.z, 0);
	r0.z = rsqrt(r3.x);
	r0.z = 1 / r0.z;
	r3 = tex2D(SpecSampler, i.texcoord.zw);
	r0.w = dot(r3, specMapExpMask);
	r3.x = dot(r3.xyz, specMapIntMask.xyz);
	r3.x = r3.x * specularColorFactor.x;
	r4.xw = float2(1, 0);
	r3.y = r0.w * -specularFactor.x + r4.x;
	r5.xyz = r0.xxx * i.texcoord4.xyz;
	r5.xyz = r0.zzz * i.texcoord1.xyz + r5.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r5.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r5.xyz = normalize(r0.xyz);
	r0.xyz = r1.xyz * r1.xyz;
	r0.xyz = r0.xyz * matDiffuseColor.xyz;
	r2.w = r2.w * matDiffuseColor2.w;
	r2.xyz = r2.xyz * matDiffuseColor2.xyz + -r0.xyz;
	r1.xyz = r2.www * r2.xyz + r0.xyz;
	r1 = r1 * i.texcoord6;
	r0.x = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.y = gAmbientOcclusionEffect.y;
	r0.y = r0.y * globalScalars.z;
	r0.x = r0.y * r0.x;
	if (-dirtLevel.x < r4.w) {
		r2 = tex2D(DirtSampler, i.texcoord.xy);
		r0.y = r2.x * dirtLevel.x;
		r4.x = r2.x * -dirtLevel.x + r4.x;
		r4.yzw = lerp(r1.xyz, dirtColor.xyz, r0.yyy);
		r6 = r1.xxyz * float4(0, 1, 1, 1) + float4(1, 0, 0, 0);
		r2 = (-r2.x >= 0) ? r6 : r4;
		r1.xyz = r2.yzw;
	} else {
		r2.x = 1;
	}
	r0.y = r2.x * r3.x;
	r2.xyz = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r2.xyz);
	r0.z = saturate(r5.z * -0.5 + 0.5);
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r2.xyz = r0.zzz * r2.xyz + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r0.xxx * r2.xyz;
	r0.x = 1 / gAmbientOcclusionEffect.y;
	r0.z = dot(-r4.xyz, r5.xyz);
	r0.z = r0.z + r0.z;
	r3.xzw = r5.xyz * -r0.zzz + -r4.xyz;
	r0.z = dot(r5.xyz, -gDirectionalLight.xyz);
	r2.w = saturate(r0.z + -0.25);
	r2.w = r2.w * 1.3333334;
	r3.x = saturate(dot(-gDirectionalLight.xyz, r3.xzw));
	r3.x = r3.x + 1E-05;
	r4.x = 1E-05;
	r0.w = r0.w * specularFactor.x + r4.x;
	r0.w = (r3.y >= 0) ? 1.00001 : r0.w;
	r4.x = pow(r3.x, r0.w);
	r0.z = saturate(r0.z * 2 + -0.5);
	r0.z = r0.z * r4.x;
	r3.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r3.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r3.xyz;
	r3.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r3.xyz;
	r3.xyz = r3.xyz + gShadowMatrix[3].xyz;
	r4.xy = r3.xy + -gShadowParam18192021.zw;
	r4.zw = r4.xx + -gCascadeXMaxThresholds.xy;
	r4.zw = (r4.zw >= 0) ? 1 : 0;
	r5.xy = -r4.xx + gCascadeXMinThresholds.xy;
	r5.zw = r4.yy + -gCascadeYMaxThresholds.xy;
	r5 = (r5 >= 0) ? 1 : 0;
	r6.xy = -r4.yy + gCascadeYMinThresholds.xy;
	r6.xy = (r6.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r5.xy;
	r4.zw = r5.zw + r4.zw;
	r5.yz = saturate(r6.xy + r4.zw);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r3.xyz = r3.zxy * r6.zxy + r7.zxy;
	r3.x = saturate(r3.x);
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r4.xy = saturate(abs(r4.xy) * 4 + r5.xy);
	r0.w = max(r4.x, r4.y);
	r3.x = -r3.x + 1;
	r4 = tex2D(gShadowZSamplerDir, r3.yz);
	r3.x = r3.x + -r4.x;
	r3.x = (r3.x >= 0) ? -1 : -0;
	r0.w = r0.w + r3.x;
	r0.w = saturate(r0.w + 1);
	r3.xyz = r0.www * gDirectionalColour.xyz;
	r4.xyz = r0.zzz * r3.xyz;
	r3.xyz = r2.www * r3.xyz;
	r4.xyz = r4.xyz * gDirectionalLight.www;
	r0.xzw = r2.xyz * r0.xxx + r3.xyz;
	r2.xyz = r0.yyy * r4.xyz;
	r0.xyz = r1.xyz * r0.xzw + r2.xyz;
	o.w = r1.w * globalScalars.x;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.z = -r1.z + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.xyz = lerp(r1.xxx, r0.xyz, r0.www);
	r0.xyz = saturate(r2.xyz * 0.000625);
	r0.x = rsqrt(r0.x);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	o.x = 1 / r0.x;
	o.y = 1 / r0.y;
	o.z = 1 / r0.z;

	return o;
}
