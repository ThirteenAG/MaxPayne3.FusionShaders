sampler2D AnisoNoiseSpecSampler : register(s3);
sampler2D BumpSampler : register(s1);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
sampler2D SpecSampler : register(s2);
sampler3D VolumeSampler : register(s4);
float2 WetAnisotropicSpecular : register(c221);
float4 WetAnisotropicSpecularColour : register(c220);
float4 anisotropicSpecularColour : register(c211);
float2 anisotropicSpecularExponent : register(c210);
float2 anisotropicSpecularIntensity : register(c209);
float bumpiness : register(c202);
float4 detailSettings : register(c213);
float fresnelRolloff : register(c201);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c207);
float reflectivePower : register(c199);
float4 specMapExpMask : register(c206);
float3 specMapIntMask : register(c205);
float3 specMapReflectMask : register(c200);
float specularFactor : register(c204);
float4 specularNoiseMapUVScaleFactor : register(c212);
float4 stipplePattern : register(c62);
float4 vHairParams : register(c222);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
	float2 vpos : VPOS;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float4 r7;
	float3 r8;
	float3 r9;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.z, 0);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r2, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r2.w = max(1, r0.w);
	r3.xyz = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r3.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r3.xyz = r0.www * r0.xyz;
	r4.xw = float2(1, 0);
	if (-reflectivePower.x < r4.w) {
		r3.w = saturate(r2.w * 0.015625);
		r5.w = r3.w * -4 + 4;
		r4.yzw = 1E-05 + i.texcoord3.xyz;
		r6 = normalize(r4.yzw);
		r3.w = dot(-r6.xyz, r3.xyz);
		r3.w = r3.w + r3.w;
		r4.yzw = r3.xyz * -r3.www + -r6.xyz;
		r4.yzw = r4.yzw + 1E-05;
		r7.xyz = normalize(r4.yzw);
		r3.w = saturate(r7.z);
		r3.w = r3.w + 1;
		r3.w = r3.w + r3.w;
		r3.w = 1 / r3.w;
		r4.yz = r7.xy * r3.ww + 0.5;
		r5.xy = -r4.yz + 1;
		r5.z = 0;
		r5 = tex2Dlod(DynamicEnvironmentSampler, r5);
		r4.yzw = r5.xyz * r5.xyz;
		r4.yzw = r4.yzw * 16;
		r3.w = saturate(dot(r6.xyz, r3.xyz));
		r4.x = r4.x + -fresnelRolloff.x;
		r3.w = -r3.w + 1.00001;
		r5.x = r3.w * r3.w;
		r5.x = r5.x * r5.x;
		r3.w = r3.w * r5.x;
		r3.w = fresnelRolloff.x * r3.w + r4.x;
		r4.xyz = r3.www * r4.yzw;
	} else {
		r4.xyz = 0;
	}
	r5.xy = 0.5 * i.vpos.xy;
	r5.xy = frac(abs(r5.xy));
	r5.xy = (i.vpos.xy >= 0) ? r5.xy : -r5.xy;
	r5.xy = r5.xy + r5.xy;
	r5.zw = frac(r5.xy);
	r5.xy = -r5.zw + r5.xy;
	r3.w = r5.y * 2 + r5.x;
	r5 = r3.w + float4(-0, -1, -2, -3);
	r5 = (-abs(r5) >= 0) ? 1 : 0;
	r3.w = dot(stipplePattern, r5);
	r3.w = -r1.w + r3.w;
	r5 = (r3.w >= 0) ? -1 : -0;
	clip(r5);
	r3.w = dot(r2.xyz, specMapIntMask.xyz);
	r4.xyz = r4.xyz * reflectivePower.xxx;
	r2.x = dot(r2.xyz, specMapReflectMask.xyz);
	r4.xyz = r2.xxx * r4.xyz;
	r4.xyz = r4.xyz * ColorCorrectTopAndPedReflectScale.www;
	r1.w = r1.w * i.texcoord2.w;
	r1.xyz = r1.xyz * matMaterialColorScale.xxx;
	r4.xyz = r4.xyz * matMaterialColorScale.zzz;
	r2.x = r3.w * matMaterialColorScale.w;
	r2.y = r2.w * matMaterialColorScale.w;
	r5.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r5.xyz = r5.xyz + 1E-05;
	r6 = normalize(r5.xyz);
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r5.xyz = normalize(r0.xyz);
	r0.x = dot(r6.xyz, r5.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.z = saturate(r2.x * 5);
	r0.y = r0.z * r0.y;
	r2.x = r2.y * 0.0051020407;
	r0.z = saturate(r2.y * -0.01 + 1);
	r0.y = r0.y * r0.z;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r3.w * matMaterialColorScale.w + r0.x;
	r0.y = r2.z * 16;
	r0.z = frac(r0.y);
	r0.y = r0.y + -r0.z;
	r0.z = (-r0.z >= 0) ? 0 : 1;
	r0.z = (r2.z >= 0) ? 0 : r0.z;
	r0.y = r0.z + r0.y;
	r5.xy = detailSettings.zw * i.texcoord.xy;
	r0.y = r0.y + 0.5;
	r5.z = r0.y * 0.0625;
	r5 = tex3D(VolumeSampler, r5.xyz);
	r0.yzw = r5.yzx * 2 + -1;
	r2.y = detailSettings.x * i.texcoord2.w;
	r0.w = r0.w * r2.y + 1;
	r2.yzw = r0.zzz * i.texcoord5.xyz;
	r2.yzw = i.texcoord4.xyz * r0.yyy + r2.yzw;
	r2.yzw = r2.yzw * detailSettings.yyy;
	r2.yzw = r2.yzw * i.texcoord2.www + r3.xyz;
	r2.yzw = r2.yzw + 1E-05;
	r3.xyz = normalize(r2.yzw);
	r0.x = saturate(r0.w * r0.x);
	r2.yzw = gViewInverse[3].xyz + -i.texcoord7.xyz;
	r5.xyz = 1E-05 + i.texcoord4.xyz;
	r6 = normalize(r5.xyz);
	r5 = specularNoiseMapUVScaleFactor * i.texcoord.xyxy;
	r7 = tex2D(AnisoNoiseSpecSampler, r5.xy);
	r5 = tex2D(AnisoNoiseSpecSampler, r5.zw);
	r2.yzw = r2.yzw + 1E-05;
	r8 = normalize(r2.yzw);
	r9.x = 1E-05;
	r2.yzw = r9.xxx + gViewInverse[2].xyz;
	r9 = normalize(r2.yzw);
	r0.yz = r5.xy * 2 + -1;
	r2.yzw = r0.yyy * i.texcoord1.xyz;
	r2.yzw = r2.yzw * 0.1 + r6.xyz;
	r2.yzw = r2.yzw + 1E-05;
	r5.xyz = normalize(r2.yzw);
	r0.y = dot(r8.xyz, r5.xyz);
	r2.y = dot(r9.xyz, r5.xyz);
	r2.z = r0.y * -r0.y + 1;
	r3.w = max(r2.z, 0);
	r2.z = rsqrt(r3.w);
	r2.z = 1 / r2.z;
	r2.w = r2.y * -r2.y + 1;
	r3.w = max(r2.w, 0);
	r2.w = rsqrt(r3.w);
	r2.w = 1 / r2.w;
	r0.y = r0.y * r2.y;
	r0.y = r2.z * r2.w + -r0.y;
	r0.y = abs(r0.y) + 1E-05;
	r5.xy = anisotropicSpecularExponent.xy;
	r2.yz = -r5.xy + WetAnisotropicSpecular.xy;
	r2.yz = vHairParams.xx * r2.yz + r5.xy;
	r2.yz = r2.yz + float2(8.00001, 16.00001);
	r3.w = pow(r0.y, r2.y);
	r5.xyz = i.texcoord1.xyz * r0.zzz + r6.xyz;
	r5.xyz = r5.xyz + 1E-05;
	r6 = normalize(r5.xyz);
	r0.y = dot(r8.xyz, r6.xyz);
	r0.z = dot(r9.xyz, r6.xyz);
	r2.y = r0.y * -r0.y + 1;
	r4.w = max(r2.y, 0);
	r2.y = rsqrt(r4.w);
	r2.y = 1 / r2.y;
	r2.w = r0.z * -r0.z + 1;
	r4.w = max(r2.w, 0);
	r2.w = rsqrt(r4.w);
	r2.w = 1 / r2.w;
	r0.y = r0.z * r0.y;
	r0.y = r2.y * r2.w + -r0.y;
	r0.y = abs(r0.y) + 1E-05;
	r4.w = pow(r0.y, r2.z);
	r0.y = r3.w + r4.w;
	r0.x = r0.y * r0.x;
	r5.x = 0.2;
	r0.y = r5.x + anisotropicSpecularIntensity.x;
	r0.x = r0.y * r0.x;
	o.color2.x = r7.x * r0.x;
	r0.xyz = anisotropicSpecularColour.xyz;
	r2.yzw = -r0.xyz + WetAnisotropicSpecularColour.xyz;
	r0.xyz = vHairParams.xxx * r2.yzw + r0.xyz;
	r0.xyz = r4.www * r0.xyz;
	r0.xyz = r0.xyz * 0.5;
	r0.xyz = r1.xyz * r0.www + r0.xyz;
	r0.w = 1.5 * i.texcoord2.x;
	o.color.xyz = r0.www * r0.xyz;
	r0.x = saturate(r1.w * 1.7);
	r0.y = saturate(gAmbientOcclusionEffect.z);
	r0.y = saturate(r0.y + i.texcoord2.x);
	o.color1.xyz = r3.xyz * 0.5 + 0.5;
	r2.x = saturate(r2.x);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r0.z = rsqrt(r0.z);
	o.color2.y = 1 / r0.z;
	o.color2.z = r0.y * gAmbientOcclusionEffect.w;
	r0.x = r0.x * globalScalars.x;
	r0.yzw = saturate(r4.xyz * 0.0625);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	r0.w = rsqrt(r0.w);
	o.color3.x = 1 / r0.y;
	o.color3.y = 1 / r0.z;
	o.color3.z = 1 / r0.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3.w = gStencil.x;

	return o;
}
