sampler2D BumpSampler : register(s2);
sampler2D DiffuseSampler : register(s0);
float bumpiness : register(c201);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float parallaxScaleBias : register(c197);
float specularColorFactor : register(c200);
float specularFactor : register(c199);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0.xyz = 1E-05 + i.texcoord7.xyz;
	r0.z = dot(r0.xyz, r0.xyz);
	r0.z = rsqrt(r0.z);
	r0.xy = r0.zz * r0.xy;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r2.yw = float2(0.5, -1);
	r0.z = r2.y * parallaxScaleBias.x;
	r0.z = r1.w * parallaxScaleBias.x + -r0.z;
	r0.xy = saturate(r0.zz * r0.xy + i.texcoord.xy);
	r1 = tex2D(BumpSampler, r0.xy);
	r0 = tex2D(DiffuseSampler, r0.xy);
	r1.zw = r1.xy * 2 + -1;
	r1.x = dot(r1.xy, r1.xy) + -0.002;
	r1.x = (r1.x >= 0) ? 1 : 0;
	r1.yz = r1.zw * bumpiness.xx;
	r1.w = dot(r1.yz, -r1.yz) + 1;
	r2.x = max(r1.w, 0);
	r1.w = rsqrt(r2.x);
	r1.w = 1 / r1.w;
	r2.xyz = r1.yyy * i.texcoord4.xyz;
	r2.xyz = r1.www * i.texcoord1.xyz + r2.xyz;
	r1.yzw = r1.zzz * i.texcoord5.xyz + r2.xyz;
	r1.yzw = r1.yzw + 1E-05;
	r2.xyz = normalize(r1.yzw);
	r3 = gLightPosX + -i.texcoord6.x;
	r4 = r3 * r3;
	r5 = gLightPosY + -i.texcoord6.y;
	r4 = r5 * r5 + r4;
	r6 = gLightPosZ + -i.texcoord6.z;
	r4 = r6 * r6 + r4;
	r7 = r4 + 1E-05;
	r4 = saturate(r4 * -gLightFallOff + -r2.w);
	r4 = r4 * r4;
	r4 = r4 * r4 + -0.1;
	r8.x = rsqrt(r7.x);
	r8.y = rsqrt(r7.y);
	r8.z = rsqrt(r7.z);
	r8.w = rsqrt(r7.w);
	r3 = r3 * r8;
	r7 = r2.x * r3;
	r5 = r5 * r8;
	r6 = r6 * r8;
	r7 = r5 * r2.y + r7;
	r7 = r6 * r2.z + r7;
	r8 = r4 * 1.1111112;
	r4 = (r4 >= 0) ? r8 : 0;
	r4 = saturate(r4 * r7);
	r7 = r3 * -gLightDirX;
	r7 = r5 * -gLightDirY + r7;
	r7 = r6 * -gLightDirZ + r7;
	r8 = gLightConeScale;
	r7 = saturate(r7 * r8 + gLightConeOffset);
	r4 = r4 * r7;
	r1.yzw = 1E-05 + i.texcoord3.xyz;
	r7.xyz = normalize(r1.yzw);
	r1.y = dot(-r7.xyz, r2.xyz);
	r1.y = r1.y + r1.y;
	r1.yzw = r2.xyz * -r1.yyy + -r7.xyz;
	r3 = r3 * r1.y;
	r3 = r1.z * r5 + r3;
	r3 = saturate(r1.w * r6 + r3);
	r1.y = saturate(dot(-gDirectionalLight.xyz, r1.yzw));
	r1.y = r1.y + 1E-05;
	r3 = r3 + 1E-05;
	r5.x = log2(r3.x);
	r5.y = log2(r3.y);
	r5.z = log2(r3.z);
	r5.w = log2(r3.w);
	r1.z = max(-r2.w, specularFactor.x);
	r1.w = r1.z * 0.25 + 1E-05;
	r1.z = r1.z + 1E-05;
	r2.w = pow(r1.y, r1.z);
	r3 = r5 * r1.w;
	r5.x = exp2(r3.x);
	r5.y = exp2(r3.y);
	r5.z = exp2(r3.z);
	r5.w = exp2(r3.w);
	r3 = r4 * r5;
	r5.x = dot(gLightColR, r3);
	r5.y = dot(gLightColG, r3);
	r5.z = dot(gLightColB, r3);
	r1.y = dot(r2.xyz, -gDirectionalLight.xyz);
	r1.z = saturate(r2.z * -0.5 + 0.5);
	r1.w = saturate(r1.y * 2 + -0.5);
	r1.y = saturate(r1.y + -0.25);
	r1.y = r1.y * 1.3333334;
	r1.w = r1.w * r2.w;
	r2.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r2.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r2.xyz;
	r2.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r2.xyz;
	r2.xyz = r2.xyz + gShadowMatrix[3].xyz;
	r3.xy = r2.xy + -gShadowParam18192021.zw;
	r3.zw = r3.xx + -gCascadeXMaxThresholds.xy;
	r3.zw = (r3.zw >= 0) ? 1 : 0;
	r6.xy = -r3.xx + gCascadeXMinThresholds.xy;
	r6.xy = (r6.xy >= 0) ? 1 : 0;
	r3.zw = r3.zw + r6.xy;
	r6.xy = r3.yy + -gCascadeYMaxThresholds.xy;
	r6.xy = (r6.xy >= 0) ? 1 : 0;
	r3.zw = r3.zw + r6.xy;
	r6.xy = -r3.yy + gCascadeYMinThresholds.xy;
	r6.xy = (r6.xy >= 0) ? 1 : 0;
	r6.yz = saturate(r3.zw + r6.xy);
	r6.x = 1;
	r7.x = dot(r6.xyz, gShadowParam0123.xyz);
	r7.y = dot(r6.xyz, gShadowParam4567.xyz);
	r7.z = dot(r6.xyz, gCascadeZScales.xyz);
	r8.x = dot(r6.xyz, gShadowParam891113.xyz);
	r8.y = dot(r6.xyz, gShadowParam14151617.xyz);
	r8.z = dot(r6.xyz, gCascadeZOffsets.xyz);
	r2.xyz = r2.zxy * r7.zxy + r8.zxy;
	r2.x = saturate(r2.x);
	r6 = tex2D(gShadowZSamplerDir, r2.yz);
	r2.x = -r2.x + 1;
	r2.x = -r6.x + r2.x;
	r2.x = (r2.x >= 0) ? -1 : -0;
	r6.x = -gCascadeXMinThresholds.w;
	r6.y = -gCascadeXMaxThresholds.w;
	r2.yz = saturate(abs(r3.xy) * 4 + r6.xy);
	r3.x = max(r2.y, r2.z);
	r2.x = r2.x + r3.x;
	r2.x = saturate(r2.x + 1);
	r2.xyz = r2.xxx * gDirectionalColour.xyz;
	r3.xyz = r1.www * r2.xyz;
	r2.xyz = r1.yyy * r2.xyz;
	r3.xyz = r3.xyz * gDirectionalLight.www + r5.xyz;
	r1.y = r1.x * specularColorFactor.x;
	r3.xyz = r1.yyy * r3.xyz;
	r5.xyz = gLightAmbient0.xyz;
	r5.xyz = -r5.xyz + gLightAmbient1.xyz;
	r1.yzw = r1.zzz * r5.xyz + gLightAmbient0.xyz;
	r1.yzw = r1.yzw * gAmbientOcclusionEffect.yyy;
	r2.w = r1.x * i.color.x;
	r0.xyz = r0.xyz * r1.xxx;
	r0.w = r0.w * i.color.w;
	r5.w = r0.w * globalScalars.x;
	r0.xyz = r0.xyz * r0.xyz;
	r1.xyz = r1.yzw * r2.www;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r1.xyz * r0.www + r2.xyz;
	r2.x = dot(gLightColR, r4);
	r2.y = dot(gLightColG, r4);
	r2.z = dot(gLightColB, r4);
	r1.xyz = r1.xyz + r2.xyz;
	r0.xyz = r0.xyz * r1.xyz + r3.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r5.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o = min(r5, float4(8, 8, 8, 1));

	return o;
}
