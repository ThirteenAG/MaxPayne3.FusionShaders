float HybridAdd : register(c88);
float gAmbientAmount : register(c104);
float4 gAmbientOcclusionEffect : register(c63);
float gAmbientShadow : register(c109);
float4 gAspectRatio : register(c17);
float gBiasToCamera : register(c96);
float gDiffuse : register(c102);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float gExtraLights : register(c103);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float gLightIntensityClamp : register(c110);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float gNormalArc : register(c106);
float gSuperAlpha : register(c105);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float gWrapBias : register(c101);
float gWrapScale : register(c98);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars4 : register(c51);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	r0.x = i.normal.z * 0.15915494 + 0.5;
	r0.x = frac(r0.x);
	r0.x = r0.x * 6.2831855 + -3.1415927;
	sincos(r0.x, r1.y, r1.x);
	r0.xyz = r1.yyx * i.normal.yxy;
	r1.x = i.normal.x * r1.x + -r0.x;
	r1.y = r0.z + r0.y;
	r1.zw = 0;
	r0.xz = float2(0.1, 0.5);
	r0.x = r0.x * gBiasToCamera.x;
	r2.xyz = lerp(i.position.xyz, gViewInverse[3].xyz, r0.xxx);
	r3 = r2.y * gWorldViewProj[1];
	r3 = r2.x * gWorldViewProj[0] + r3;
	r3 = r2.z * gWorldViewProj[2] + r3;
	r3 = r3 + gWorldViewProj[3];
	o.position = r1 * gAspectRatio + r3;
	r0.xy = r1.xy * gAspectRatio.xy;
	o.texcoord.w = saturate(gSuperAlpha.x * i.color.w);
	r1.xyz = r2.xyz + -gViewInverse[3].xyz;
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = r0.w * -1.442695;
	r1.y = exp2(r1.y);
	r1.y = -r1.y + 1;
	r1.z = 1 / r0.w;
	r0.w = (0.0001 < abs(r0.w)) ? 1 : 0;
	r1.y = r1.z * r1.y;
	r1.y = r1.x * r1.y + -r1.x;
	r0.w = r0.w * r1.y + r1.x;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = exp2(r0.w);
	o.texcoord4.w = -r0.w + 1;
	r0.z = (r0.z < HybridAdd.x) ? 1 : 0;
	o.texcoord3.z = r0.z * -i.texcoord3.x + 1;
	r1.x = 1 / gAspectRatio.x;
	r1.y = 1 / gAspectRatio.y;
	r0.xy = r0.xy * r1.xy;
	r0.z = 0;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0.xyz = r2.yyy * gWorldView[1].xyz;
	r0.xyz = r2.xxx * gWorldView[0].xyz + r0.xyz;
	r0.xyz = r2.zzz * gWorldView[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gWorldView[3].xyz;
	r3 = -r0.x + gLightPosX;
	r4 = r1.x * r3;
	r5 = -r0.y + gLightPosY;
	r0 = -r0.z + gLightPosZ;
	r4 = r5 * r1.y + r4;
	r4 = r0 * r1.z + r4;
	r6 = r3 * r3;
	r3 = r3 * -gLightDirX;
	r3 = r5 * -gLightDirY + r3;
	r5 = r5 * r5 + r6;
	r5 = r0 * r0 + r5;
	r3 = r0 * -gLightDirZ + r3;
	r6.x = 1;
	r6 = r5 * -gLightFallOff + r6.x;
	r5 = r5 + 1E-05;
	r6 = max(r6, 0);
	r6 = r6 * r6;
	r6 = r6 * r6 + -0.1;
	r6 = max(r6, 0);
	r6 = r6 * 1.1111112;
	r4 = r4 * r6;
	r0 = r0 * r6;
	r6.x = rsqrt(r5.x);
	r6.y = rsqrt(r5.y);
	r6.z = rsqrt(r5.z);
	r6.w = rsqrt(r5.w);
	r4 = saturate(r4 * r6);
	r3 = r3 * r6;
	r0 = saturate(r0 * r6);
	r5 = gLightConeScale;
	r3 = saturate(r3 * r5 + gLightConeOffset);
	r4 = r4 * r3;
	r0 = r0 * r3;
	r1.z = dot(gLightColR, r4);
	r2.w = dot(gLightColR, r0);
	r3.x = r2.w * 0.25 + r1.z;
	r1.z = dot(gLightColG, r4);
	r2.w = dot(gLightColB, r4);
	r3.w = dot(gLightColG, r0);
	r0.x = dot(gLightColB, r0);
	r3.z = r0.x * 0.25 + r2.w;
	r3.y = r3.w * 0.25 + r1.z;
	r0.xyz = r3.xyz * i.color.xyz;
	r0.xyz = r0.xyz * gExtraLights.xxx;
	r0.xyz = max(r0.xyz, 0);
	r0.w = saturate(-gDirectionalLight.z);
	r1.w = r0.w * 0.375;
	r0.w = dot(r1.xyw, -gDirectionalLight.xyz);
	r1.x = saturate(r1.y * -0.5 + 0.5);
	r0.w = max(r0.w, -gLightIntensityClamp.x);
	r0.w = min(r0.w, gLightIntensityClamp.x);
	r1.y = -r0.w + 1;
	r0.w = gNormalArc.x * r1.y + r0.w;
	r3.x = gWrapScale.x;
	r0.w = r0.w * r3.x + gWrapBias.x;
	r0.w = r0.w * gDirectionalColour.x;
	r0.w = r0.w * gDiffuse.x;
	r1.yzw = r0.www * i.color.xyz;
	r1.yzw = max(r1.yzw, 0);
	r1.yzw = r1.yzw + i.color.xyz;
	r0.xyz = r0.xyz + r1.yzw;
	r3.xyz = gLightAmbient0.xyz;
	r1.yzw = -r3.xyz + gLightAmbient1.xyz;
	r1.xyz = r1.xxx * r1.yzw + gLightAmbient0.xyz;
	r1.xyz = r1.xyz * gAmbientOcclusionEffect.yyy;
	r1.xyz = r1.xyz * gAmbientAmount.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = r1.xyz * i.color.xyz;
	r1.xyz = max(r1.xyz, 0);
	r0.xyz = r1.xyz * gAmbientShadow.xxx + r0.xyz;
	r0.w = globalScalars4.x * i.texcoord3.y;
	o.texcoord.xyz = r0.www * r0.xyz;
	r0 = r2.y * gWorldView[1];
	r0 = r2.x * gWorldView[0] + r0;
	r0 = r2.z * gWorldView[2] + r0;
	o.texcoord7 = r0 + gWorldView[3];
	o.texcoord1 = i.texcoord;
	o.texcoord3.xy = float2(1, 0) * i.texcoord2.zz;
	o.texcoord3.w = i.texcoord3.y;
	o.texcoord4.xyz = globalFogColorN.xyz;

	return o;
}
