sampler2D DiffuseSampler : register(s0);
sampler2D TextureSamplerDiffPal : register(s4);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c198);
float paletteSelector : register(c200);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float4 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.x = r0.w * 255.01;
	r1.y = frac(r1.x);
	r1.x = -r1.y + r1.x;
	r1.y = -r1.x + 160;
	r1.x = r1.x + -32;
	r1.y = (r1.y >= 0) ? -1 : -0;
	r1.y = (r1.x >= 0) ? r1.y : -0;
	r2.x = r1.x * 0.0078125;
	r2.y = paletteSelector.x;
	r2 = tex2D(TextureSamplerDiffPal, r2.xy);
	r0.xyz = r0.xyz * r0.xyz;
	r3.xyz = lerp(r0.xyz, r2.xyz, r2.www);
	r3.w = 1;
	r0 = (r1.y >= 0) ? r0 : r3;
	r0.w = r0.w * i.texcoord7.w;
	o.w = r0.w * globalScalars.x;
	r1.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r1.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r1.xyz;
	r1.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r1.xyz;
	r1.xyz = r1.xyz + gShadowMatrix[3].xyz;
	r2.xy = r1.xy + -gShadowParam18192021.zw;
	r2.zw = r2.xx + -gCascadeXMaxThresholds.xy;
	r2.zw = (r2.zw >= 0) ? 1 : 0;
	r3.xy = -r2.xx + gCascadeXMinThresholds.xy;
	r3.xy = (r3.xy >= 0) ? 1 : 0;
	r2.zw = r2.zw + r3.xy;
	r3.xy = r2.yy + -gCascadeYMaxThresholds.xy;
	r3.xy = (r3.xy >= 0) ? 1 : 0;
	r2.zw = r2.zw + r3.xy;
	r3.xy = -r2.yy + gCascadeYMinThresholds.xy;
	r3.xy = (r3.xy >= 0) ? 1 : 0;
	r3.yz = saturate(r2.zw + r3.xy);
	r3.x = 1;
	r4.x = dot(r3.xyz, gShadowParam0123.xyz);
	r4.y = dot(r3.xyz, gShadowParam4567.xyz);
	r4.z = dot(r3.xyz, gCascadeZScales.xyz);
	r5.x = dot(r3.xyz, gShadowParam891113.xyz);
	r5.y = dot(r3.xyz, gShadowParam14151617.xyz);
	r5.z = dot(r3.xyz, gCascadeZOffsets.xyz);
	r1.xyz = r1.zxy * r4.zxy + r5.zxy;
	r1.x = saturate(r1.x);
	r3 = tex2D(gShadowZSamplerDir, r1.yz);
	r0.w = -r1.x + 1;
	r0.w = -r0.w + r3.x;
	r0.w = (r0.w >= 0) ? 0 : 0.33333334;
	r1.x = -gCascadeXMinThresholds.w;
	r1.y = -gCascadeXMaxThresholds.w;
	r1.xy = saturate(abs(r2.xy) * 4 + r1.xy);
	r2.x = max(r1.x, r1.y);
	r0.w = r0.w + r2.x;
	r0.w = r0.w + -0.4;
	r0.w = saturate(r0.w * 1.6666666);
	r1.x = r0.w * -2 + 3;
	r0.w = r0.w * r0.w;
	r0.w = r0.w * r1.x;
	r1.xyz = r0.www * gDirectionalColour.xyz;
	r2.xyz = 1E-05 + i.texcoord1.xyz;
	r3.xyz = normalize(r2.xyz);
	r0.w = dot(r3.xyz, -gDirectionalLight.xyz);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r1.xyz = r0.www * r1.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r1.w = saturate(r3.z * -0.5 + 0.5);
	r2.xyz = r1.www * r2.xyz + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r2.xyz * i.texcoord7.xxx;
	r1.xyz = r2.xyz * r0.www + r1.xyz;
	r2 = gLightPosX + -i.texcoord2.x;
	r4 = r3.x * r2;
	r5 = gLightPosY + -i.texcoord2.y;
	r4 = r5 * r3.y + r4;
	r6 = gLightPosZ + -i.texcoord2.z;
	r3 = r6 * r3.z + r4;
	r4 = r2 * r2;
	r2 = r2 * -gLightDirX;
	r2 = r5 * -gLightDirY + r2;
	r4 = r5 * r5 + r4;
	r4 = r6 * r6 + r4;
	r2 = r6 * -gLightDirZ + r2;
	r0.w = 1;
	r5 = r4 * -gLightFallOff + r0.w;
	r4 = r4 + 1E-05;
	r6 = max(r5, 0);
	r5 = r6 * r6;
	r5 = r5 * r5 + -0.1;
	r6 = r5 * 1.1111112;
	r5 = (r5 >= 0) ? r6 : 0;
	r3 = r3 * r5;
	r5.x = rsqrt(r4.x);
	r5.y = rsqrt(r4.y);
	r5.z = rsqrt(r4.z);
	r5.w = rsqrt(r4.w);
	r3 = saturate(r3 * r5);
	r2 = r2 * r5;
	r4 = gLightConeScale;
	r2 = saturate(r2 * r4 + gLightConeOffset);
	r2 = r3 * r2;
	r3.x = dot(gLightColR, r2);
	r3.y = dot(gLightColG, r2);
	r3.z = dot(gLightColB, r2);
	r1.xyz = r1.xyz + r3.xyz;
	r0.xyz = r0.xyz * r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.y = -r1.x + 1;
	r1.x = r1.y * gDepthFxParams.y + r1.x;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = r0.w * -1.442695;
	r1.y = exp2(r1.y);
	r1.y = -r1.y + 1;
	r1.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r1.y = r1.z * r1.y;
	r1.y = r1.y * r1.x;
	r0.w = (r0.w >= 0) ? r1.x : r1.y;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o.xyz = r2.xyz * matMaterialColorScale.xxx;

	return o;
}
