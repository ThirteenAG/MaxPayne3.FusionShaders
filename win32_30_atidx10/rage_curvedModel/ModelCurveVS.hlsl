float MotionBlurAmt : register(c53);
float SegmentSize : register(c50);
float4 approxTangent[21] : register(c85);
float4 curveCoeffs[60] : register(c148);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorld : register(c0);
row_major float4x4 gWorldViewProj : register(c8);
float radius : register(c52);
float3 uvScales : register(c51);
float4 velocity[21] : register(c106);

struct VS_IN
{
	float4 position : POSITION;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
	float4 normal : NORMAL;
	float4 tangent : TANGENT;
};

struct VS_OUT
{
	float4 position : POSITION;
	float3 texcoord : TEXCOORD;
	float2 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	int2 a0;
	float4 r2;
	float3 r3;
	float4 r4;
	float3 r5;
	r0.x = SegmentSize.x * i.position.y;
	r0.y = frac(r0.x);
	r0.z = r0.x + -r0.y;
	r0.y = (-r0.y < r0.y) ? 1 : 0;
	r0.x = (r0.x < -r0.x) ? 1 : 0;
	r0.x = r0.x * r0.y + r0.z;
	r0.y = r0.x * 3;
	r1.y = i.position.y * SegmentSize.x + -r0.x;
	a0 = r0.yx;
	r0.x = r1.y + 0.001;
	r2.z = r0.x * r0.x;
	r2.w = r0.x * r2.z;
	r1.x = 1;
	r2.xy = r1.xy + float2(0, 0.001);
	r0.z = dot(curveCoeffs[a0.x], r2);
	r0.x = dot(curveCoeffs[a0.x + 1], r2);
	r0.y = dot(curveCoeffs[a0.x + 2], r2);
	r1.z = r1.y * r1.y;
	r1.w = r1.y * r1.z;
	r2.x = dot(curveCoeffs[a0.x], r1);
	r2.y = dot(curveCoeffs[a0.x + 1], r1);
	r2.z = dot(curveCoeffs[a0.x + 2], r1);
	r0.xyz = r0.xyz + -r2.yzx;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r0.xyz = r0.www * r0.xyz;
	r0.w = -r1.y + 1;
	r1.xzw = r1.yyy * approxTangent[a0.y + 1].zxy;
	r1.xzw = approxTangent[a0.y].zxy * r0.www + r1.xzw;
	r3 = r0.zxy * r1.xzw;
	r1.xzw = r0.yzx * r1.zwx + -r3.xyz;
	r2.w = dot(r1.xzw, r1.xzw);
	r2.w = rsqrt(r2.w);
	r1.xzw = r1.xzw * r2.www;
	r3 = r0.yzx * r1.wxz;
	r3 = r1.zwx * r0.zxy + -r3.xyz;
	r2.w = dot(r3.xyz, r3.xyz);
	r2.w = rsqrt(r2.w);
	r3 = r2.www * r3.xyz;
	r4.xyz = r3.zxy * i.position.xxx;
	r5 = r1.wxz * i.position.zzz;
	r5 = r5.xyz * radius.xxx;
	r4.xyz = r4.xyz * radius.xxx + r5.xyz;
	r2.xyz = r2.xyz + r4.xyz;
	r4 = r1.y * velocity[a0.y + 1];
	r4 = velocity[a0.y] * r0.w + r4;
	r5 = r1.zwx * i.normal.zzz;
	r1.xzw = r1.xzw * i.tangent.zzz;
	r1.xzw = r3.xyz * i.tangent.xxx + r1.xzw;
	r3 = r3.yzx * i.normal.xxx + r5.xyz;
	r3 = r0.yzx * i.normal.yyy + r3.xyz;
	r0.xyz = r0.xyz * i.tangent.yyy + r1.xzw;
	r0.w = dot(r3.yzx, r4.xyz);
	r0.w = (0 < r0.w) ? 1 : 0;
	r1.xzw = r0.www * r4.xyz;
	o.texcoord3.w = r4.w;
	r1.xzw = r1.xzw * MotionBlurAmt.xxx + r2.xyz;
	r2 = r1.z * gWorldViewProj[1];
	r2 = r1.x * gWorldViewProj[0] + r2;
	r2 = r1.w * gWorldViewProj[2] + r2;
	o.position = r2 + gWorldViewProj[3];
	r2.xyz = r3.zzz * gWorld[1].xyz;
	r2.xyz = r3.yyy * gWorld[0].xyz + r2.xyz;
	r2.xyz = r3.xxx * gWorld[2].xyz + r2.xyz;
	r0.w = dot(r2.xyz, r2.xyz);
	r0.w = rsqrt(r0.w);
	o.texcoord2 = r0.www * r2.xyz;
	r2.xyz = r0.xxx * gWorld[1].xyz;
	r2.xyz = r0.zzz * gWorld[0].xyz + r2.xyz;
	r2.xyz = r0.yyy * gWorld[2].xyz + r2.xyz;
	r0.w = dot(r2.xyz, r2.xyz);
	r0.w = rsqrt(r0.w);
	o.texcoord4 = r0.www * r2.xyz;
	r2.xyz = r0.xyz * r3.xyz;
	r0.xyz = r3.zxy * r0.yzx + -r2.xyz;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	o.texcoord5 = r0.www * r0.xyz;
	o.texcoord1.x = uvScales.x * i.texcoord.x;
	r0.w = approxTangent[a0.y].w;
	r0.x = -r0.w + approxTangent[a0.y + 1].w;
	r0.x = r1.y * r0.x + approxTangent[a0.y].w;
	r0.x = r0.x * uvScales.z;
	o.texcoord1.y = i.texcoord.y * uvScales.y + r0.x;
	r0.xyz = r1.zzz * gWorld[1].xyz;
	r0.xyz = r1.xxx * gWorld[0].xyz + r0.xyz;
	r0.xyz = r1.www * gWorld[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gWorld[3].xyz;
	r1.xyz = -r0.xyz + gViewInverse[3].xyz;
	o.texcoord = r0.xyz;
	r0.x = dot(r1.xyz, r1.xyz);
	r0.x = rsqrt(r0.x);
	o.texcoord6 = r0.xxx * r1.xyz;
	o.texcoord3.xyz = i.color.xyz;

	return o;
}
