float HybridAdd : register(c89);
float4 NearFarPlane : register(c128);
float gAmbientAmount : register(c99);
float4 gAmbientOcclusionEffect : register(c63);
float gAmbientShadow : register(c104);
float4 gAspectRatio : register(c17);
float gDiffuse : register(c96);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float gExtraLights : register(c98);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float gLightIntensityClamp : register(c105);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float gNormalArc : register(c101);
float gScaleFade : register(c102);
float gSuperAlpha : register(c100);
float4 gTexCoordScaleOffset0 : register(c106);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float gWrapBias : register(c95);
float gWrapScale : register(c94);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars4 : register(c51);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	r0.zw = 0;
	r1.x = i.normal.z * 0.15915494 + 0.5;
	r1.x = frac(r1.x);
	r1.x = r1.x * 6.2831855 + -3.1415927;
	sincos(r1.x, r2.y, r2.x);
	r1.x = (1E-06 >= i.color.w) ? 1 : 0;
	r1.y = 1 / gScaleFade.x;
	r3.xyz = gViewInverse[3].xyz + -i.position.xyz;
	r3.xyz = r3.xyz * 0.048 + i.position.xyz;
	r4 = r3.y * gWorldViewProj[1];
	r4 = r3.x * gWorldViewProj[0] + r4;
	r4 = r3.z * gWorldViewProj[2] + r4;
	r4 = r4 + gWorldViewProj[3];
	r1.z = r4.w + -NearFarPlane.x;
	r1.y = saturate(r1.y * r1.z);
	r1.x = r1.x * -r1.y + r1.y;
	r5 = r1.x * i.normal.xyxy;
	r1.x = r1.x * i.color.w;
	o.texcoord.w = saturate(r1.x * gSuperAlpha.x);
	r1.xyz = r2.yyx * r5.yzw;
	r0.x = r5.x * r2.x + -r1.x;
	r0.y = r1.z + r1.y;
	o.position = r0 * gAspectRatio + r4;
	r0.xy = r0.xy * gAspectRatio.xy;
	o.texcoord3.y = r4.w;
	r1.xyz = r3.xyz + -gViewInverse[3].xyz;
	r0.z = r1.z * globalFogParams.x;
	r0.w = dot(r1.xyz, r1.xyz);
	r0.w = rsqrt(r0.w);
	r0.w = 1 / r0.w;
	r0.w = r0.w * globalFogParams.z;
	r1.x = r0.z * -1.442695;
	r1.x = exp2(r1.x);
	r1.x = -r1.x + 1;
	r1.y = 1 / r0.z;
	r0.z = (0.0001 < abs(r0.z)) ? 1 : 0;
	r1.x = r1.y * r1.x;
	r1.x = r0.w * r1.x + -r0.w;
	r0.z = r0.z * r1.x + r0.w;
	r0.z = r0.z * -globalFogParams.y;
	r0.z = r0.z * 1.442695;
	r0.z = exp2(r0.z);
	o.texcoord4.w = -r0.z + 1;
	r0.w = 0.5;
	r0.z = (r0.w < HybridAdd.x) ? 1 : 0;
	o.texcoord3.z = r0.z * -i.texcoord3.x + 1;
	r1.x = 1 / gAspectRatio.x;
	r1.y = 1 / gAspectRatio.y;
	r0.xy = r0.xy * r1.xy;
	r0.z = 0;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0.xyz = r3.yyy * gWorldView[1].xyz;
	r0.xyz = r3.xxx * gWorldView[0].xyz + r0.xyz;
	r0.xyz = r3.zzz * gWorldView[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gWorldView[3].xyz;
	r2 = -r0.x + gLightPosX;
	r4 = r1.x * r2;
	r5 = -r0.y + gLightPosY;
	r0 = -r0.z + gLightPosZ;
	r4 = r5 * r1.y + r4;
	r4 = r0 * r1.z + r4;
	r6 = r2 * r2;
	r2 = r2 * -gLightDirX;
	r2 = r5 * -gLightDirY + r2;
	r5 = r5 * r5 + r6;
	r5 = r0 * r0 + r5;
	r2 = r0 * -gLightDirZ + r2;
	r6.y = 1;
	r6 = r5 * -gLightFallOff + r6.y;
	r5 = r5 + 1E-05;
	r6 = max(r6, 0);
	r6 = r6 * r6;
	r6 = r6 * r6 + -0.1;
	r6 = max(r6, 0);
	r6 = r6 * 1.1111112;
	r4 = r4 * r6;
	r0 = r0 * r6;
	r6.x = rsqrt(r5.x);
	r6.y = rsqrt(r5.y);
	r6.z = rsqrt(r5.z);
	r6.w = rsqrt(r5.w);
	r4 = saturate(r4 * r6);
	r2 = r2 * r6;
	r0 = saturate(r0 * r6);
	r5 = gLightConeScale;
	r2 = saturate(r2 * r5 + gLightConeOffset);
	r4 = r4 * r2;
	r0 = r0 * r2;
	r1.z = dot(gLightColR, r4);
	r2.x = dot(gLightColR, r0);
	r2.x = r2.x * 0.25 + r1.z;
	r1.z = dot(gLightColG, r4);
	r2.w = dot(gLightColB, r4);
	r3.w = dot(gLightColG, r0);
	r0.x = dot(gLightColB, r0);
	r2.z = r0.x * 0.25 + r2.w;
	r2.y = r3.w * 0.25 + r1.z;
	r0.xyz = r2.xyz * i.color.xyz;
	r0.xyz = r0.xyz * gExtraLights.xxx;
	r0.xyz = max(r0.xyz, 0);
	r0.w = saturate(-gDirectionalLight.z);
	r1.w = r0.w * 0.375;
	r0.w = dot(r1.xyw, -gDirectionalLight.xyz);
	r1.x = saturate(r1.y * -0.5 + 0.5);
	r0.w = max(r0.w, -gLightIntensityClamp.x);
	r0.w = min(r0.w, gLightIntensityClamp.x);
	r1.y = -r0.w + 1;
	r0.w = gNormalArc.x * r1.y + r0.w;
	r2.x = gWrapScale.x;
	r0.w = r0.w * r2.x + gWrapBias.x;
	r0.w = r0.w * gDirectionalColour.x;
	r0.w = r0.w * gDiffuse.x;
	r1.yzw = r0.www * i.color.xyz;
	r1.yzw = max(r1.yzw, 0);
	r1.yzw = r1.yzw + i.color.xyz;
	r0.xyz = r0.xyz + r1.yzw;
	r2.xyz = gLightAmbient0.xyz;
	r1.yzw = -r2.xyz + gLightAmbient1.xyz;
	r1.xyz = r1.xxx * r1.yzw + gLightAmbient0.xyz;
	r1.xyz = r1.xyz * gAmbientOcclusionEffect.yyy;
	r1.xyz = r1.xyz * gAmbientAmount.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = r1.xyz * i.color.xyz;
	r1.xyz = max(r1.xyz, 0);
	r0.xyz = r1.xyz * gAmbientShadow.xxx + r0.xyz;
	r0.w = globalScalars4.x * i.texcoord3.y;
	o.texcoord.xyz = r0.www * r0.xyz;
	r0 = r3.y * gWorldView[1];
	r0 = r3.x * gWorldView[0] + r0;
	r0 = r3.z * gWorldView[2] + r0;
	o.texcoord7 = r0 + gWorldView[3];
	o.texcoord1 = i.texcoord * gTexCoordScaleOffset0.xyxy + gTexCoordScaleOffset0.zwzw;
	o.texcoord3.x = i.texcoord2.z;
	o.texcoord3.w = i.texcoord3.y;
	o.texcoord4.xyz = globalFogColorN.xyz;

	return o;
}
