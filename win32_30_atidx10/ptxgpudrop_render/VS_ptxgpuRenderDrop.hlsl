float gAmbientAmount : register(c101);
float4 gAmbientOcclusionEffect : register(c63);
float4 gColour : register(c105);
float4 gColourSplash : register(c106);
float gDiffuse : register(c100);
float gDirectional : register(c110);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float2 gFadeInOut : register(c108);
float2 gFadeNearFar : register(c111);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float4 gSizeMinMax : register(c103);
float2 gSplashFrames : register(c107);
float2 gSplashSizeMinMax : register(c104);
float2 gTextureRowsCols : register(c102);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float gWrapBias : register(c99);
float gWrapScale : register(c98);

struct VS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float4 r10;
	r0.x = (i.texcoord1.w >= 10000) ? 1 : 0;
	r0.y = frac(i.texcoord1.w);
	r0.z = r0.y * 1000;
	r0.z = frac(r0.z);
	if (i.texcoord1.w >= 10000) {
		r1.x = lerp(gSplashSizeMinMax.x, gSplashSizeMinMax.y, r0.z);
		r0.w = frac(i.texcoord.w);
		r1.y = -r0.w + i.texcoord.w;
		r1.y = r1.y * 0.01;
		r0.w = r0.w * 100;
		r1.zw = -0.5 + i.texcoord2.xy;
		r2.xyz = normalize(-gViewInverse[1].xyz);
		r3.xyz = normalize(gViewInverse[0].xyz);
		r2.xyz = r1.xxx * r2.xyz;
		r3.xyz = r1.xxx * r3.xyz;
		r2.xyz = r1.www * r2.xyz;
		r1.xzw = r1.zzz * r3.xyz + r2.xyz;
		r2.xyz = normalize(r1.xzw);
		r1.xzw = r1.xzw + i.texcoord.xyz;
		r3 = r1.z * gWorldViewProj[1];
		r3 = r1.x * gWorldViewProj[0] + r3;
		r3 = r1.w * gWorldViewProj[2] + r3;
		o.position = r3 + gWorldViewProj[3];
		r2.w = 1 / r0.w;
		r2.w = r1.y * r2.w;
		r2.w = r2.w * gSplashFrames.x;
		r3.x = frac(r2.w);
		r2.w = r2.w + -r3.x;
		r3.x = gSplashFrames.y * i.texcoord2.x;
		r2.w = r2.w * gSplashFrames.y + r3.x;
		o.texcoord.x = r2.w + -10;
		r3.xyz = gColourSplash.xyz;
		o.texcoord.y = i.texcoord2.y;
		r2.w = gColourSplash.w;
		r3.w = r2.y;
		r4.x = r2.z;
	} else {
		r4.yz = lerp(gSizeMinMax.xy, gSizeMinMax.zw, r0.zz);
		r0.z = frac(i.texcoord.w);
		r4.w = -r0.z + i.texcoord.w;
		r1.y = r4.w * 0.01;
		r0.w = r0.z * 100;
		r5.xy = -0.5 + i.texcoord2.xy;
		r6.y = 0;
		if (r6.y < gDirectional.x) {
			r6.xyz = gViewInverse[3].yzx + -i.texcoord.yzx;
			r7.xyz = normalize(i.texcoord1.xyz);
			r0.z = dot(r6.xyz, r6.xyz);
			r0.z = rsqrt(r0.z);
			r6.xyz = r0.zzz * r6.xyz;
			r8.xyz = r6.xyz * r7.zxy;
			r6.xyz = r7.yzx * r6.yzx + -r8.xyz;
			r8.xyz = normalize(r6.xyz);
			r6.xyz = r4.zzz * r7.xyz;
			r7.xyz = r4.yyy * r8.xyz;
			r0.z = 0.7 + -i.texcoord2.y;
			r6.xyz = -r6.xyz * r0.zzz;
			r6.xyz = r5.xxx * r7.xyz + r6.xyz;
		} else {
			r7.xyz = normalize(-gViewInverse[1].xyz);
			r8.xyz = normalize(gViewInverse[0].xyz);
			r7.xyz = r4.zzz * r7.xyz;
			r4.yzw = r4.yyy * r8.xyz;
			r5.yzw = r5.yyy * r7.xyz;
			r6.xyz = r5.xxx * r4.yzw + r5.yzw;
		}
		r2.xyz = normalize(r6.xyz);
		r1.xzw = r6.xyz + i.texcoord.xyz;
		r5 = r1.z * gWorldViewProj[1];
		r5 = r1.x * gWorldViewProj[0] + r5;
		r5 = r1.w * gWorldViewProj[2] + r5;
		o.position = r5 + gWorldViewProj[3];
		r0.z = gTextureRowsCols.y * gTextureRowsCols.x;
		r0.y = r0.z * r0.y;
		r0.y = r0.y * 99.9;
		r0.z = frac(r0.y);
		r0.y = -r0.z + r0.y;
		r5.x = 1 / gTextureRowsCols.y;
		r0.y = r0.y * r5.x;
		r0.z = frac(abs(r0.y));
		r4.y = (r0.y >= -r0.y) ? 1 : 0;
		r5.z = lerp(-r0.z, r0.z, r4.y);
		r6.x = r5.z * gTextureRowsCols.y;
		r0.z = frac(r0.y);
		r6.y = -r0.z + r0.y;
		r5.y = 1 / gTextureRowsCols.x;
		r0.yz = r6.xy + i.texcoord2.xy;
		o.texcoord = r5.xy * r0.yz;
		r3.xyz = gColour.xyz;
		r2.w = gColour.w;
		r3.w = r2.y;
		r4.x = r2.z;
	}
	r4.yzw = r3.www * gWorldView[1].xyz;
	r2.xyz = r2.xxx * gWorldView[0].xyz + r4.yzw;
	r2.xyz = r4.xxx * gWorldView[2].xyz + r2.xyz;
	r4.xyz = r1.zzz * gWorldView[1].xyz;
	r4.xyz = r1.xxx * gWorldView[0].xyz + r4.xyz;
	r1.xzw = r1.www * gWorldView[2].xyz + r4.xyz;
	r1.xzw = r1.xzw + gWorldView[3].xyz;
	r4 = -r1.x + gLightPosX;
	r5 = -r1.z + gLightPosY;
	r6 = -r1.w + gLightPosZ;
	r7 = r4 * r4;
	r7 = r5 * r5 + r7;
	r7 = r6 * r6 + r7;
	r8 = r7 + 1E-05;
	r9.x = rsqrt(r8.x);
	r9.y = rsqrt(r8.y);
	r9.z = rsqrt(r8.z);
	r9.w = rsqrt(r8.w);
	r0.z = 1;
	r7 = r7 * -gLightFallOff + r0.z;
	r7 = max(r7, 0);
	r7 = r7 * r7;
	r7 = r7 * r7 + -0.1;
	r7 = max(r7, 0);
	r7 = r7 * r9;
	r7 = r7 * 1.1111112;
	r7 = min(r7, 1);
	r8 = r4 * -gLightDirX;
	r8 = r5 * -gLightDirY + r8;
	r8 = r6 * -gLightDirZ + r8;
	r8 = r9 * r8;
	r10 = gLightConeScale;
	r8 = saturate(r8 * r10 + gLightConeOffset);
	r7 = r7 * r8;
	r7 = r9 * r7;
	r4 = r4 * r7;
	r5 = r5 * r7;
	r6 = r6 * r7;
	r0.y = r7.x * gWrapBias.x;
	r0.z = dot(r2.xyz, -gDirectionalLight.xyz);
	r0.y = saturate(r0.z * gWrapScale.x + r0.y);
	r4 = r2.x * r4;
	r4 = r2.y * r5 + r4;
	r4 = r2.z * r6 + r4;
	r4 = saturate(gWrapBias.x * r7.x + r4);
	r5.x = dot(gLightColR, r4);
	r5.y = dot(gLightColG, r4);
	r5.z = dot(gLightColB, r4);
	r1.xzw = r0.yyy * gDirectionalColour.xyz + r5.xyz;
	r0.y = dot(r2.xyz, gWorldView[2].xyz);
	r0.y = saturate(r0.y * -0.5 + 0.5);
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r2.xyz = r0.yyy * r2.xyz + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r2.xyz * gAmbientAmount.xxx;
	r0.y = 1 / gAmbientOcclusionEffect.y;
	r1.xzw = r2.xyz * r0.yyy + r1.xzw;
	r1.xzw = r1.xzw * gDiffuse.xxx;
	o.color.xyz = r1.xzw * r3.xyz;
	r1.xzw = gViewInverse[3].xyz + -i.texcoord.xyz;
	r0.y = dot(r1.xzw, r1.xzw);
	r0.y = rsqrt(r0.y);
	r0.y = 1 / r0.y;
	r0.z = 1 / gFadeNearFar.y;
	r0.z = r0.z * r0.y;
	r1.x = r0.z * r0.z;
	r0.z = saturate(r0.z * r1.x);
	r0.z = -r0.z + 1;
	r0.z = r0.z * r2.w;
	r1.x = 1 / gFadeNearFar.x;
	r0.y = r0.y * r1.x;
	r1.x = r0.y * r0.y;
	r0.y = saturate(r0.y * r1.x);
	r0.y = r0.y * r0.z;
	r0.z = -r1.y + r0.w;
	r0.w = 1 / gFadeInOut.x;
	r0.z = saturate(r0.w * r0.z);
	r0.w = 1 / gFadeInOut.y;
	r0.w = saturate(r0.w * r1.y);
	r0.z = r0.w * r0.z;
	r0.z = r0.y * r0.z + -r0.y;
	o.color.w = r0.x * r0.z + r0.y;

	return o;
}
