float3 cloudBaseColour : register(c147);
float4 cloudConstants1 : register(c151);
float4 cloudConstants2 : register(c152);
float4 cloudDetailConstants : register(c150);
float3 cloudMidColour : register(c148);
float3 cloudShadowColour : register(c149);
sampler2D ditherSampler : register(s4);
float4 effectsConstants : register(c156);
float hdrIntensity : register(c137);
sampler2D highDetailSampler : register(s2);
float3 moonColor : register(c164);
float3 moonDirection : register(c160);
sampler2D moonSampler : register(s5);
sampler2D perlinSampler : register(s1);
float3 smallCloudColorXHdrIntensity : register(c155);
float4 smallCloudConstants : register(c154);
sampler2D starFieldSampler : register(s3);
float starfieldIntensity : register(c159);
float3 sunColor : register(c141);
float4 sunConstants : register(c144);
float3 sunDirection : register(c145);
float sunHdrIntensity : register(c143);

struct PS_IN
{
	half4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	half4 texcoord3 : TEXCOORD3;
	half2 texcoord4 : TEXCOORD4;
	half2 texcoord5 : TEXCOORD5;
	half2 texcoord6 : TEXCOORD6;
	half2 texcoord7 : TEXCOORD7;
};

half4 main(PS_IN i) : COLOR
{
	half4 o;

	float4 r0;
	float4 r1;
	float3 r2;
	float4 r3;
	float4 r4;
	r0 = half4(tex2D(highDetailSampler, i.texcoord3.xy));
	r0.x = r0.x + -0.5;
	r0.x = r0.x * cloudDetailConstants.x;
	r1 = half4(tex2D(highDetailSampler, i.texcoord5.xy));
	r0.z = r1.x + -0.5;
	r0.y = r0.z * smallCloudConstants.y;
	r1 = half4(tex2D(highDetailSampler, i.texcoord3.zw));
	r0.z = r1.x + -0.5;
	r1 = half4(tex2D(perlinSampler, i.texcoord.zw));
	r0.w = half(r0.z * cloudConstants2.z + r1.x);
	r2.x = half(r0.z * cloudDetailConstants.z);
	r0.z = half(r0.w * cloudConstants1.x);
	r3 = half4(tex2D(perlinSampler, i.texcoord.xy));
	r0.z = half(r0.z * r3.x);
	r0.w = saturate(r0.z * -2 + 1);
	r0.xy = r0.ww * r0.xy;
	r0.w = half(-r3.z + 1);
	r2.y = half(r0.w * smallCloudConstants.y);
	r0.xy = half2(r0.xy * r3.zz + r2.xy);
	r0.yw = half2(r3.xx * float2(1, 0) + r0.xy);
	r0.x = r0.x + r1.y;
	r0.x = r0.x * cloudConstants2.x;
	r1.xyz = half3(cloudBaseColour.xyz);
	r1.xyz = -r1.xyz + cloudShadowColour.xyz;
	r1.xyz = r0.xxx * r1.xyz + cloudBaseColour.xyz;
	r2 = half3(lerp(cloudMidColour.xyz, r1.xyz, r0.zzz));
	r1.x = half(r0.y * cloudConstants1.y);
	r1.y = half(r0.w * smallCloudConstants.z);
	r0.x = saturate(r0.y * -1.36 + 1);
	r3.y = half(-smallCloudConstants.w);
	r3.xz = half2(-cloudConstants1.zw);
	r0.yz = half2(saturate(r1.xy + r3.xy));
	r0.yz = half2(r0.yz * r0.yz);
	r1.xyz = 1E-05 + i.texcoord1.xyz;
	r4.xyz = half3(normalize(r1.xyz));
	r0.w = half(saturate(r4.z * 5 + r3.z));
	r0.yz = half2(r0.ww * r0.yz);
	r1.x = dot(r4.xyz, -sunDirection.xyz);
	r1.y = half(dot(r4.xyz, moonDirection.xyz));
	r0.w = sunConstants.x * -r1.x + sunConstants.y;
	r0.w = abs(r0.w) + 1E-05;
	r1.z = pow(r0.w, 1.50001);
	r0.w = 1 / r1.z;
	r1.z = r1.x * r1.x + 1;
	r1.x = half(saturate(-r1.x));
	r1.xy = half2(-r1.xy + 1);
	r0.w = r0.w * r1.z;
	r0.w = half(saturate(r0.w * sunConstants.z));
	r3.xyz = half3(sunColor.xyz);
	r3.xyz = r3.xyz * sunHdrIntensity.xxx + -i.texcoord2.xyz;
	r3.xyz = r0.www * r3.xyz + i.texcoord2.xyz;
	r4.xyz = lerp(r3.xyz, smallCloudColorXHdrIntensity.xyz, r0.zzz);
	r2 = r2.xyz * cloudConstants2.www + -r4.xyz;
	r2 = r0.yyy * r2.xyz + r4.xyz;
	r3 = half4(tex2D(ditherSampler, i.texcoord4.xy));
	r0.w = r3.x + -0.5;
	r2 = r0.www * i.texcoord2.www + r2.xyz;
	r0.w = half(r0.z * 0.3);
	r1.z = r0.z * -0.3 + 1;
	r0.w = half(r0.y * r1.z + r0.w);
	r0.y = half(r0.z + r0.y);
	o.w = -r0.y + 1;
	r0.y = half(-r0.w + 1);
	r3 = half4(tex2D(starFieldSampler, i.texcoord6.xy));
	r3.xyz = r3.xyz * starfieldIntensity.xxx;
	r3.xyz = r0.yyy * r3.xyz;
	r4 = half4(tex2D(moonSampler, i.texcoord7.xy));
	r0.y = -r4.w + 1;
	r2 = r3.xyz * r0.yyy + r2.xyz;
	r3.x = 1 / effectsConstants.x;
	r3.y = 1 / effectsConstants.z;
	r0.yz = half2(r1.xy * r3.xy);
	r0.yz = half2(saturate(r0.yz * 100));
	r0.yz = half2(-r0.yz + 1);
	r0.yz = half2(r0.ww * r0.yz);
	r0.xy = half2(r0.xx * r0.yz);
	r0.xy = half2(r0.xy * r0.xy);
	r0.xy = half2(r0.xy * effectsConstants.yw);
	r0.yzw = half3(r0.yyy * moonColor.xyz);
	r0.xyz = half3(sunColor.xyz * r0.xxx + r0.yzw);
	o.xyz = r0.xyz * hdrIntensity.xxx + r2.xyz;

	return o;
}
