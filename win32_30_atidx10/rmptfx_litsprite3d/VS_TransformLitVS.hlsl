float HybridAdd : register(c197);
float4 NearFarPlane : register(c128);
float4 gActiveUnit : register(c200);
float gAmbientAmount : register(c213);
float4 gAmbientOcclusionEffect : register(c63);
float gAmbientShadow : register(c218);
float4 gAspectRatio : register(c17);
float gBiasToCamera : register(c206);
float gDiffuse : register(c209);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gInterpolationFactor : register(c221);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float gLightIntensityClamp : register(c219);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float gNormalArc : register(c215);
float4 gPositionOffset : register(c222);
float4 gPositionScale : register(c223);
float gScaleFade : register(c216);
float gSuperAlpha : register(c214);
float4 gTextureAngleRads : register(c220);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float gWrapBias : register(c208);
float gWrapScale : register(c207);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars4 : register(c51);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord6 : TEXCOORD6;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0.x = abs(gViewInverse[2].z);
	r0.y = r0.x * -0.0187293 + 0.074261;
	r0.y = r0.y * r0.x + -0.2121144;
	r0.y = r0.y * r0.x + 1.5707288;
	r0.x = -r0.x + 1;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * r0.y;
	r0.y = r0.x * -2 + 3.1415927;
	r0.z = (gViewInverse[2].z < -gViewInverse[2].z) ? 1 : 0;
	r0.x = r0.y * r0.z + r0.x;
	r0.x = -r0.x + 1.5707964;
	r0 = abs(r0.x) + -gTextureAngleRads;
	r0 = r0 * 0.15915494 + 0.5;
	r0 = frac(r0);
	r0 = r0 * 6.2831855 + -3.1415927;
	r0 = r0 * r0;
	r1 = r0 * -2.523985E-07 + 2.47609E-05;
	r1 = r0 * r1 + -0.0013888397;
	r1 = r0 * r1 + 0.04166664;
	r1 = r0 * r1 + -0.5;
	r0 = r0 * r1 + 1;
	r0 = abs(r0) + 1E-05;
	r1.x = log2(r0.x);
	r1.y = log2(r0.y);
	r1.z = log2(r0.z);
	r1.w = log2(r0.w);
	r0.y = 1E-05;
	r2 = r0.y + gInterpolationFactor;
	r1 = r1 * r2;
	r2.x = exp2(r1.x);
	r2.y = exp2(r1.y);
	r2.z = exp2(r1.z);
	r2.w = exp2(r1.w);
	r0 = r2 * gActiveUnit + r0.y;
	r1.x = dot(r0, r0);
	r1.x = rsqrt(r1.x);
	r0 = r0 * r1.x;
	r1.x = dot(r0, gPositionScale);
	r2.z = dot(r0, gPositionOffset);
	o.texcoord6 = r0;
	r2.xy = 0;
	r0.xy = float2(0.1, 1);
	r0.x = r0.x * gBiasToCamera.x;
	r1.yzw = lerp(i.position.xyz, gViewInverse[3].xyz, r0.xxx);
	r0.xzw = r2.xyz + r1.yzw;
	r2 = r0.z * gWorldViewProj[1];
	r2 = r0.x * gWorldViewProj[0] + r2;
	r2 = r0.w * gWorldViewProj[2] + r2;
	r2 = r2 + gWorldViewProj[3];
	r0.x = r2.w + -NearFarPlane.x;
	r0.z = 1 / gScaleFade.x;
	r0.x = saturate(r0.z * r0.x);
	r0.z = (1E-06 >= i.color.w) ? 1 : 0;
	r0.x = r0.z * -r0.x + r0.x;
	r3 = r0.x * i.normal.xyxy;
	r0.x = r0.x * i.color.w;
	o.texcoord.w = saturate(r0.x * gSuperAlpha.x);
	r3 = r1.x * r3;
	r0.x = i.normal.z * 0.15915494 + 0.5;
	r0.x = frac(r0.x);
	r0.x = r0.x * 6.2831855 + -3.1415927;
	sincos(r0.x, r4.y, r4.x);
	r0.xzw = r3.yzw * r4.yyx;
	r3.x = r3.x * r4.x + -r0.x;
	r3.y = r0.w + r0.z;
	r3.zw = 0;
	o.position = r3 * gAspectRatio + r2;
	r0.xzw = r1.yzw + -gViewInverse[3].xyz;
	r1.x = r0.w * globalFogParams.x;
	r0.x = dot(r0.xzw, r0.xzw);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * globalFogParams.z;
	r0.z = r1.x * -1.442695;
	r0.z = exp2(r0.z);
	r0.z = -r0.z + 1;
	r0.w = 1 / r1.x;
	r1.x = (0.0001 < abs(r1.x)) ? 1 : 0;
	r0.z = r0.w * r0.z;
	r0.z = r0.x * r0.z + -r0.x;
	r0.x = r1.x * r0.z + r0.x;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = exp2(r0.x);
	o.texcoord4.w = -r0.x + 1;
	r0.z = 0.5;
	r0.x = (r0.z < HybridAdd.x) ? 1 : 0;
	o.texcoord3.z = r0.x * -i.texcoord3.x + 1;
	r0.xzw = r1.zzz * gWorldView[1].xyz;
	r0.xzw = r1.yyy * gWorldView[0].xyz + r0.xzw;
	r0.xzw = r1.www * gWorldView[2].xyz + r0.xzw;
	r0.xzw = r0.xzw + gWorldView[3].xyz;
	r2 = -r0.x + gLightPosX;
	r3 = r2 * -gLightDirX;
	r2 = r2 * r2;
	r4 = -r0.z + gLightPosY;
	r5 = -r0.w + gLightPosZ;
	r3 = r4 * -gLightDirY + r3;
	r2 = r4 * r4 + r2;
	r2 = r5 * r5 + r2;
	r3 = r5 * -gLightDirZ + r3;
	r4 = r2 + 1E-05;
	r0 = r2 * -gLightFallOff + r0.y;
	r0 = max(r0, 0);
	r0 = r0 * r0;
	r0 = r0 * r0 + -0.1;
	r0 = max(r0, 0);
	r0 = r0 * r5;
	r2.x = rsqrt(r4.x);
	r2.y = rsqrt(r4.y);
	r2.z = rsqrt(r4.z);
	r2.w = rsqrt(r4.w);
	r3 = r2 * r3;
	r0 = r0 * r2;
	r0 = saturate(r0 * 1.1111112);
	r2 = gLightConeScale;
	r2 = saturate(r3 * r2 + gLightConeOffset);
	r0 = r0 * r2;
	r1.x = dot(gLightColR, r0);
	r2.x = r1.x * i.color.x;
	r1.x = dot(gLightColG, r0);
	r0.x = dot(gLightColB, r0);
	r2.z = r0.x * i.color.z;
	r2.y = r1.x * i.color.y;
	r0.xyz = r2.xyz * 1.25;
	r0.xyz = max(r0.xyz, 0);
	r1.x = gLightIntensityClamp.x;
	r0.w = max(-r1.x, -gDirectionalLight.z);
	r0.w = min(r0.w, gLightIntensityClamp.x);
	r1.x = -r0.w + 1;
	r0.w = gNormalArc.x * r1.x + r0.w;
	r1.x = gWrapScale.x;
	r0.w = r0.w * r1.x + gWrapBias.x;
	r0.w = r0.w * gDirectionalColour.x;
	r0.w = r0.w * gDiffuse.x;
	r2.xyz = r0.www * i.color.xyz;
	r2.xyz = max(r2.xyz, 0);
	r2.xyz = r2.xyz + i.color.xyz;
	r0.xyz = r0.xyz + r2.xyz;
	r2.zw = float2(-0.5, 0.5);
	r0.w = saturate(gWorldView[2].z * r2.z + r2.w);
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r2.xyz = r0.www * r2.xyz + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r2.xyz * gAmbientAmount.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r2.xyz = r0.www * r2.xyz;
	r2.xyz = r2.xyz * i.color.xyz;
	r2.xyz = max(r2.xyz, 0);
	r0.xyz = r2.xyz * gAmbientShadow.xxx + r0.xyz;
	r0.w = globalScalars4.x * i.texcoord3.y;
	o.texcoord.xyz = r0.www * r0.xyz;
	r0 = r1.z * gWorldView[1];
	r0 = r1.y * gWorldView[0] + r0;
	r0 = r1.w * gWorldView[2] + r0;
	o.texcoord7 = r0 + gWorldView[3];
	o.texcoord1 = i.texcoord;
	o.texcoord3.xy = float2(1, 0) * i.texcoord2.zz;
	o.texcoord3.w = i.texcoord3.y;
	o.texcoord4.xyz = globalFogColorN.xyz;

	return o;
}
