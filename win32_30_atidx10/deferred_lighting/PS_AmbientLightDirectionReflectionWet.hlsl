sampler2D GBufferStencilTextureSampler : register(s11);
sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
float4 dReflectionParams : register(c132);
sampler2D gDeferredLightSampler0P : register(s3);
float4 gDeferredProjParams : register(c216);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightAmbientDir0 : register(c72);
float4 gLightAmbientDir1 : register(c73);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);
sampler2D materialIdSampler : register(s9);

struct PS_IN
{
	float4 texcoord1 : TEXCOORD1;
	float2 vpos : VPOS;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r0.z = r1.x * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord1.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord1.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2.xyz = i.texcoord1.xyz * -r0.zzz + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r1.xyz = -r1.xyz + gViewInverse[3].xyz;
	r2.xyz = normalize(r1.xyz);
	r1 = tex2D(GBufferTextureSampler1, r0.xy);
	r1.xyz = r1.xyz * 2 + -1;
	r4.xyz = normalize(r1.xyz);
	r0.z = dot(r2.xyz, r4.xyz);
	r0.z = -abs(r0.z) + 1.00001;
	r1.x = max(1E-05, r0.z);
	r0.z = r1.x * r1.x;
	r0.z = r0.z * r0.z;
	r0.z = r0.z * r1.x;
	r0.z = r0.z * 0.8 + 0.2;
	r1 = tex2D(GBufferStencilTextureSampler, r0.xy);
	r2 = tex2D(materialIdSampler, r1.ww);
	r0.w = r2.y * 64;
	r1.x = -r2.z + 1;
	r1.xyz = r1.xxx * gDirectionalColour.xyz;
	r0.w = r1.w * 255 + -r0.w;
	r0.w = -r0.w + 0.1;
	r1.w = saturate(r4.z * 4);
	r1.w = r1.w * dReflectionParams.y;
	r0.w = (r0.w >= 0) ? r1.w : 0;
	r2 = tex2D(GBufferTextureSampler2, r0.xy);
	r1.w = r2.y * r2.y;
	r1.w = r1.w * r1.w;
	r2.y = r1.w * -196 + 512;
	r1.w = r1.w * 196;
	r2.w = r0.w * r2.y;
	r2.w = r2.w * 0.001953125;
	r2.y = (r2.y >= 0) ? r2.w : 0;
	r2.y = r0.z * r2.y;
	r1.w = r2.y * 512 + r1.w;
	r1.w = r1.w + 1E-05;
	r2.y = dot(r3.xyz, r4.xyz);
	r2.y = r2.y + r2.y;
	r3.xyz = r4.xyz * -r2.yyy + r3.xyz;
	r2.y = saturate(dot(-gDirectionalLight.xyz, r3.xyz));
	r2.y = r2.y + 1E-05;
	r3.x = pow(r2.y, r1.w);
	r1.w = dot(r4.xyz, -gDirectionalLight.xyz);
	r2.y = saturate(r1.w * 2 + -0.5);
	r1.w = saturate(r1.w + -0.25);
	r1.w = r1.w * 1.3333334;
	r3.yzw = r1.www * r1.xyz;
	r1.w = r2.y * r3.x;
	r1.xyz = r1.www * r1.xyz;
	r1.w = saturate(-r2.x + 1);
	r0.w = r0.w * r1.w;
	r0.z = r0.w * r0.z + r2.x;
	r0.w = dot(gLightAmbientDir1.xyz, r4.xyz);
	r1.w = dot(gLightAmbientDir0.xyz, r4.xyz);
	r1.w = saturate(r1.w + gLightAmbientDir0.w);
	r0.w = saturate(r0.w + gLightAmbientDir0.w);
	r2.xyw = r0.www * gLightAmbient1.xyz;
	r2.xyw = r1.www * gLightAmbient0.xyz + r2.xyw;
	r2.xyw = r2.zzz * r2.xyw;
	r0.w = rsqrt(r2.z);
	r0.w = 1 / r0.w;
	r2.xyz = r3.yzw * r0.www + r2.xyw;
	r0.w = dot(r2.xyz, 0.33333334);
	r0.w = r0.w + 0.015;
	r3 = tex2D(gDeferredLightSampler0P, r0.xy);
	r4 = tex2D(GBufferTextureSampler0, r0.xy);
	r4.xyz = r4.xyz * r4.xyz;
	r3.xyz = r3.xyz * r3.xyz;
	r3.xyz = r3.xyz * 16;
	r0.xyw = r0.www * r3.xyz;
	r0.xyz = r1.xyz * r0.zzz + r0.xyw;
	o.xyz = r4.xyz * r2.xyz + r0.xyz;
	o.w = 1;

	return o;
}
