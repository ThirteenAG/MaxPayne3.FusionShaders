sampler2D BumpSampler : register(s4);
float4 ClothDarken : register(c212);
float4 ClothDarkenColor : register(c214);
float4 ClothSweatSpec : register(c213);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s5);
sampler3D VolumeSampler : register(s6);
float bumpiness : register(c197);
float4 detailSettings : register(c204);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c202);
float4 specMapExpMask : register(c201);
float3 specMapIntMask : register(c200);
float specularFactor : register(c199);
float4 vSweatParams : register(c211);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color2 : COLOR2;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float3 r6;
	float3 r7;
	r0.x = 1 / ClothDarken.w;
	r0.y = 1 / vSweatParams.w;
	r0.z = vSweatParams.z + -i.texcoord4.w;
	r0.y = saturate(r0.y * r0.z);
	r0.y = r0.y * vSweatParams.y;
	r0.y = (r0.z >= 0) ? r0.y : 0;
	r0.z = -r0.y + ClothDarken.w;
	r0.x = r0.x * r0.z;
	r1.xw = float2(1, 0);
	r2.xyz = lerp(ClothDarken.xyz, r1.xxx, r0.xxx);
	r0.xzw = (r0.zzz >= 0) ? r2.xyz : ClothDarken.xyz;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r3.xyz = lerp(ClothDarkenColor.xyz, r2.xyz, r0.xzw);
	r0.x = r2.w * i.texcoord2.w;
	r0.x = r0.x * globalScalars.x;
	r2.xyz = r3.xyz * matMaterialColorScale.xxx;
	r3 = tex2D(SpecSampler, i.texcoord.xy);
	r0.z = r3.z * 16;
	r0.w = frac(r0.z);
	r0.z = r0.z + -r0.w;
	r0.w = (-r0.w >= 0) ? 0 : 1;
	r0.w = (r3.z >= 0) ? 0 : r0.w;
	r0.z = r0.w + r0.z;
	r0.z = r0.z + 0.5;
	r4.z = r0.z * 0.0625;
	r4.xy = detailSettings.zw * i.texcoord.xy;
	r4 = tex3D(VolumeSampler, r4.xyz);
	r4.xyz = r4.yzx * 2 + -1;
	r0.z = detailSettings.x * i.texcoord2.w;
	r0.z = r4.z * r0.z + 1;
	o.color.xyz = r0.zzz * r2.xyz;
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r2.w + 1;
	r0.w = -r2.x + r0.w;
	r1.yz = (r0.ww >= 0) ? r2.wy : r2.xy;
	r1.yz = r1.yz * 2 + -1;
	r1.yz = r1.yz * bumpiness.xx;
	r0.w = dot(r1.yz, -r1.yz) + 1;
	r2.x = max(r0.w, 0);
	r0.w = rsqrt(r2.x);
	r0.w = 1 / r0.w;
	r2.xyz = r1.yyy * i.texcoord4.xyz;
	r2.xyz = r0.www * i.texcoord1.xyz + r2.xyz;
	r2.xyz = r1.zzz * i.texcoord5.xyz + r2.xyz;
	r2.xyz = r2.xyz + 1E-05;
	r0.w = dot(r2.xyz, r2.xyz);
	r0.w = rsqrt(r0.w);
	r5 = r2.xyz * r0.www + 1E-05;
	r2.xyz = r0.www * r2.xyz;
	r6 = normalize(r5.xyz);
	r5 = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r5 = r5.xyz + 1E-05;
	r7 = normalize(r5.xyz);
	r0.w = dot(r7.xyz, r6.xyz);
	r1.y = r0.w * 1.5 + 1;
	r0.w = (-r0.w >= 0) ? r1.y : 1;
	r1.y = r0.w * i.texcoord2.y;
	r1.z = dot(r3.xyz, specMapIntMask.xyz);
	r2.w = dot(r3, specMapExpMask);
	r2.w = r2.w * specularFactor.x;
	r3.x = max(1, r2.w);
	r2.w = lerp(r3.x, ClothSweatSpec.y, r0.y);
	r3.x = lerp(r1.z, ClothSweatSpec.x, r0.y);
	r0.y = r2.w * matMaterialColorScale.w;
	r1.z = r3.x * matMaterialColorScale.w;
	r1.z = saturate(r1.z * 5);
	r1.y = r1.z * r1.y;
	r1.z = saturate(r0.y * -0.01 + 1);
	r5.x = r0.y * 0.0051020407;
	r5.x = saturate(r5.x);
	r0.y = rsqrt(r5.x);
	r0.y = 1 / r0.y;
	r0.y = rsqrt(r0.y);
	o.color2.y = 1 / r0.y;
	r0.y = r1.y * r1.z;
	r0.y = (r0.w >= 0) ? r0.y : 0;
	r0.y = r3.x * matMaterialColorScale.w + r0.y;
	o.color2.x = saturate(r0.z * r0.y);
	r0.yzw = r4.yyy * i.texcoord5.xyz;
	r0.yzw = i.texcoord4.xyz * r4.xxx + r0.yzw;
	r0.yzw = r0.yzw * detailSettings.yyy;
	r0.yzw = r0.yzw * i.texcoord2.www + r2.xyz;
	r0.yzw = r0.yzw + 1E-05;
	r2.xyz = normalize(r0.yzw);
	o.color1.xyz = r2.xyz * 0.5 + 0.5;
	r0.y = saturate(gAmbientOcclusionEffect.z);
	r0.y = saturate(r0.y + i.texcoord2.x);
	o.color2.z = r0.y * gAmbientOcclusionEffect.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3 = r1.wwwx * gStencil.x;

	return o;
}
