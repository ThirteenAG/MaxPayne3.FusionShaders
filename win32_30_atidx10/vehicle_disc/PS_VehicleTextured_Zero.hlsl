struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.xyz = r0.xyz * r0.xyz;
	r0.xyz = r1.xyz * matDiffuseColor.xyz;
	r0 = r0 * i.texcoord6;
	o.w = r0.w * globalScalars.x;
	r1.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r1.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r1.xyz;
	r1.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r1.xyz;
	r1.xyz = r1.xyz + gShadowMatrix[3].xyz;
	r2.xy = r1.xy + -gShadowParam18192021.zw;
	r2.zw = r2.xx + -gCascadeXMaxThresholds.xy;
	r2.zw = (r2.zw >= 0) ? 1 : 0;
	r3.xy = -r2.xx + gCascadeXMinThresholds.xy;
	r3.xy = (r3.xy >= 0) ? 1 : 0;
	r2.zw = r2.zw + r3.xy;
	r3.xy = r2.yy + -gCascadeYMaxThresholds.xy;
	r3.xy = (r3.xy >= 0) ? 1 : 0;
	r2.zw = r2.zw + r3.xy;
	r3.xy = -r2.yy + gCascadeYMinThresholds.xy;
	r3.xy = (r3.xy >= 0) ? 1 : 0;
	r3.yz = saturate(r2.zw + r3.xy);
	r3.x = 1;
	r4.x = dot(r3.xyz, gShadowParam0123.xyz);
	r4.y = dot(r3.xyz, gShadowParam4567.xyz);
	r4.z = dot(r3.xyz, gCascadeZScales.xyz);
	r5.x = dot(r3.xyz, gShadowParam891113.xyz);
	r5.y = dot(r3.xyz, gShadowParam14151617.xyz);
	r5.z = dot(r3.xyz, gCascadeZOffsets.xyz);
	r1.xyz = r1.zxy * r4.zxy + r5.zxy;
	r3 = tex2D(gShadowZSamplerDir, r1.yz);
	r3.y = r3.x;
	r4.xzw = float3(1, -1, 0);
	r5 = gShadowParam18192021.xyxy * r4.zwxw + r1.yzyz;
	r6 = tex2D(gShadowZSamplerDir, r5.xy);
	r5 = tex2D(gShadowZSamplerDir, r5.zw);
	r3.z = r5.x;
	r3.x = r6.x;
	r1.x = saturate(r1.x);
	r0.w = -r1.x + 0.9999995;
	r3.xyz = -r0.www + r3.xyz;
	r3.xyz = (r3.xyz >= 0) ? 1 : 0;
	r5.x = 1 / gShadowParam18192021.x;
	r5.y = 1 / gShadowParam18192021.y;
	r1.xw = r1.yz * r5.xy;
	r5.xy = frac(r1.xw);
	r5.zw = r5.xx * float2(-1, 0) + 1;
	r1.x = dot(r3.zxy, r5.xzw);
	r3.xyz = r5.xwx * float3(-1, 1, 1) + float3(1, 0, 0);
	r2.zw = r1.yz + -gShadowParam18192021.xy;
	r6 = tex2D(gShadowZSamplerDir, r2.zw);
	r7 = gShadowParam18192021.yyxy * r4.wzxz + r1.yzyz;
	r8 = tex2D(gShadowZSamplerDir, r7.xy);
	r7 = tex2D(gShadowZSamplerDir, r7.zw);
	r6.z = r7.x;
	r6.y = r8.x;
	r5.xzw = -r0.www + r6.xyz;
	r5.xzw = (r5.xzw >= 0) ? 1 : 0;
	r1.w = dot(r5.xzw, r3.xyz);
	r2.z = -r5.y + 1;
	r1.x = r1.w * r2.z + r1.x;
	r2.zw = r1.yz + gShadowParam18192021.xy;
	r6 = gShadowParam18192021.xyyy * r4.zxwx + r1.yzyz;
	r7 = tex2D(gShadowZSamplerDir, r2.zw);
	r7.z = r7.x;
	r8 = tex2D(gShadowZSamplerDir, r6.xy);
	r6 = tex2D(gShadowZSamplerDir, r6.zw);
	r7.y = r6.x;
	r7.x = r8.x;
	r1.yzw = -r0.www + r7.xyz;
	r1.yzw = (r1.yzw >= 0) ? 1 : 0;
	r0.w = dot(r1.yzw, r3.xyz);
	r0.w = r0.w * r5.y + r1.x;
	r1.x = -gCascadeXMinThresholds.w;
	r1.y = -gCascadeXMaxThresholds.w;
	r1.xy = saturate(abs(r2.xy) * 4 + r1.xy);
	r2.x = max(r1.x, r1.y);
	r0.w = r0.w * 0.33333334 + r2.x;
	r0.w = r0.w + -0.4;
	r0.w = saturate(r0.w * 1.6666666);
	r1.x = r0.w * -2 + 3;
	r0.w = r0.w * r0.w;
	r0.w = r0.w * r1.x;
	r1.xyz = r0.www * gDirectionalColour.xyz;
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r2.w + 1;
	r0.w = -r2.x + r0.w;
	r2.xy = (r0.ww >= 0) ? r2.wy : r2.xy;
	r2.xy = r2.xy * 2 + -1;
	r2.xy = r2.xy * bumpiness.xx;
	r0.w = dot(r2.xy, -r2.xy) + 1;
	r1.w = max(r0.w, 0);
	r0.w = rsqrt(r1.w);
	r0.w = 1 / r0.w;
	r2.xzw = r2.xxx * i.texcoord4.xyz;
	r2.xzw = r0.www * i.texcoord1.xyz + r2.xzw;
	r2.xyz = r2.yyy * i.texcoord5.xyz + r2.xzw;
	r2.xyz = r2.xyz + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r2.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r2.xyz);
	r0.w = dot(-r5.xyz, r3.xyz);
	r0.w = r0.w + r0.w;
	r2.xyz = r3.xyz * -r0.www + -r5.xyz;
	r0.w = saturate(dot(-gDirectionalLight.xyz, r2.xyz));
	r0.w = r0.w + 1E-05;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r2, specMapExpMask);
	r2.x = dot(r2.xyz, specMapIntMask.xyz);
	r2.x = r2.x * specularColorFactor.x;
	r2.y = r1.w * -specularFactor.x + r4.x;
	r4.x = 1E-05;
	r1.w = r1.w * specularFactor.x + r4.x;
	r1.w = (r2.y >= 0) ? 1.00001 : r1.w;
	r2.y = pow(r0.w, r1.w);
	r0.w = dot(r3.xyz, -gDirectionalLight.xyz);
	r1.w = saturate(r3.z * -0.5 + 0.5);
	r2.z = saturate(r0.w * 2 + -0.5);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r3.xyz = r0.www * r1.xyz;
	r0.w = r2.z * r2.y;
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = r1.xyz * gDirectionalLight.www;
	r1.xyz = r2.xxx * r1.xyz;
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r2.xyz = r1.www * r2.xyz + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r0.w = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r4.y = gAmbientOcclusionEffect.y;
	r1.w = r4.y * globalScalars.z;
	r0.w = r0.w * r1.w;
	r2.xyz = r0.www * r2.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r2.xyz = r2.xyz * r0.www + r3.xyz;
	r0.xyz = r0.xyz * r2.xyz + r1.xyz;
	r1.xyz = float3(98, 25, 0);
	r0.xyz = DiskBrakeGlow.xxx * r1.xyz + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.y = -r1.x + 1;
	r1.x = r1.y * gDepthFxParams.y + r1.x;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = r0.w * -1.442695;
	r1.y = exp2(r1.y);
	r1.y = -r1.y + 1;
	r1.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r1.y = r1.z * r1.y;
	r1.y = r1.y * r1.x;
	r0.w = (r0.w >= 0) ? r1.x : r1.y;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.xyz = -r0.www + r0.xyz;
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	o.xyz = r1.xxx * r0.xyz + r0.www;

	return o;
}
