sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s1);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float4 specMapExpMask : register(c198);
float3 specMapIntMask : register(c197);
float specularFactor : register(c196);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float3 r7;
	r0 = gLightPosX + -i.texcoord6.x;
	r1 = r0 * r0;
	r2 = gLightPosY + -i.texcoord6.y;
	r1 = r2 * r2 + r1;
	r3 = gLightPosZ + -i.texcoord6.z;
	r1 = r3 * r3 + r1;
	r4 = r1 + 1E-05;
	r5.y = 1;
	r1 = saturate(r1 * -gLightFallOff + r5.y);
	r1 = r1 * r1;
	r1 = r1 * r1 + -0.1;
	r5.x = rsqrt(r4.x);
	r5.y = rsqrt(r4.y);
	r5.z = rsqrt(r4.z);
	r5.w = rsqrt(r4.w);
	r0 = r0 * r5;
	r4 = r0 * -gLightDirX;
	r2 = r2 * r5;
	r3 = r3 * r5;
	r4 = r2 * -gLightDirY + r4;
	r4 = r3 * -gLightDirZ + r4;
	r5 = gLightConeScale;
	r4 = saturate(r4 * r5 + gLightConeOffset);
	r5 = r1 * 1.1111112;
	r1 = (r1 >= 0) ? r5 : 0;
	r5.xyz = 1E-05 + i.texcoord1.xyz;
	r6 = normalize(r5.xyz);
	r5 = r0 * r6.x;
	r5 = r2 * r6.y + r5;
	r5 = r3 * r6.z + r5;
	r1 = saturate(r1 * r5);
	r1 = r1 * r4;
	r4.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r4.xyz);
	r4.x = dot(-r5.xyz, r6.xyz);
	r4.x = r4.x + r4.x;
	r4.xyz = r6.xyz * -r4.xxx + -r5.xyz;
	r0 = r0 * r4.x;
	r0 = r4.y * r2 + r0;
	r0 = saturate(r4.z * r3 + r0);
	r2.x = saturate(dot(-gDirectionalLight.xyz, r4.xyz));
	r2.x = r2.x + 1E-05;
	r0 = r0 + 1E-05;
	r3.x = log2(r0.x);
	r3.y = log2(r0.y);
	r3.z = log2(r0.z);
	r3.w = log2(r0.w);
	r0 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r0, specMapExpMask);
	r0.x = dot(r0.xyz, specMapIntMask.xyz);
	r0.y = r0.w * specularFactor.x;
	r2.y = max(1, r0.y);
	r0.y = r2.y * 0.25 + 1E-05;
	r0.z = r2.y + 1E-05;
	r4.x = pow(r2.x, r0.z);
	r2 = r3 * r0.y;
	r3.x = exp2(r2.x);
	r3.y = exp2(r2.y);
	r3.z = exp2(r2.z);
	r3.w = exp2(r2.w);
	r2 = r1 * r3;
	r3.x = dot(gLightColR, r2);
	r3.y = dot(gLightColG, r2);
	r3.z = dot(gLightColB, r2);
	r0.y = dot(r6.xyz, -gDirectionalLight.xyz);
	r0.z = saturate(r6.z * -0.5 + 0.5);
	r0.w = saturate(r0.y * 2 + -0.5);
	r0.y = saturate(r0.y + -0.25);
	r0.y = r0.y * 1.3333334;
	r0.w = r0.w * r4.x;
	r2.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r2.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r2.xyz;
	r2.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r2.xyz;
	r2.xyz = r2.xyz + gShadowMatrix[3].xyz;
	r4.xy = r2.xy + -gShadowParam18192021.zw;
	r4.zw = r4.xx + -gCascadeXMaxThresholds.xy;
	r4.zw = (r4.zw >= 0) ? 1 : 0;
	r5.xy = -r4.xx + gCascadeXMinThresholds.xy;
	r5.xy = (r5.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r5.xy;
	r5.xy = r4.yy + -gCascadeYMaxThresholds.xy;
	r5.xy = (r5.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r5.xy;
	r5.xy = -r4.yy + gCascadeYMinThresholds.xy;
	r5.xy = (r5.xy >= 0) ? 1 : 0;
	r5.yz = saturate(r4.zw + r5.xy);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r2.xyz = r2.zxy * r6.zxy + r7.zxy;
	r2.x = saturate(r2.x);
	r5 = tex2D(gShadowZSamplerDir, r2.yz);
	r2.x = -r2.x + 1;
	r2.x = -r5.x + r2.x;
	r2.x = (r2.x >= 0) ? -1 : -0;
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r2.yz = saturate(abs(r4.xy) * 4 + r5.xy);
	r3.w = max(r2.y, r2.z);
	r2.x = r2.x + r3.w;
	r2.x = saturate(r2.x + 1);
	r2.xyz = r2.xxx * gDirectionalColour.xyz;
	r4.xyz = r0.www * r2.xyz;
	r2.xyz = r0.yyy * r2.xyz;
	r3.xyz = r4.xyz * gDirectionalLight.www + r3.xyz;
	r0.xyw = r0.xxx * r3.xyz;
	r3.xyz = gLightAmbient0.xyz;
	r3.xyz = -r3.xyz + gLightAmbient1.xyz;
	r3.xyz = r0.zzz * r3.xyz + gLightAmbient0.xyz;
	r3.xyz = r3.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r3.xyz * i.color.xxx + r2.xyz;
	r3.x = dot(gLightColR, r1);
	r3.y = dot(gLightColG, r1);
	r3.z = dot(gLightColB, r1);
	r1.xyz = r2.xyz + r3.xyz;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2.xyz = r2.xyz * r2.xyz;
	r0.z = r2.w * i.color.w;
	r3.w = r0.z * globalScalars.x;
	r0.xyz = r2.xyz * r1.xyz + r0.xyw;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r3.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o = min(r3, float4(8, 8, 8, 1));

	return o;
}
