sampler2D BumpSampler : register(s2);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s4);
sampler2D SpecSampler : register(s3);
float bumpiness : register(c203);
float4 deSatContrastGamma : register(c46);
float fresnelRolloff : register(c205);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float3 matDiffuseColor : register(c197);
float reflectivePower : register(c204);
float4 specMapExpMask : register(c202);
float3 specMapIntMask : register(c201);
float specularColorFactor : register(c200);
float specularFactor : register(c199);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float3 r7;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.xyz = r0.xyz * r0.xyz;
	r0.xyz = r1.xyz * matDiffuseColor.xyz;
	r0 = r0 * i.texcoord6;
	o.w = r0.w * globalScalars.x;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r1.w + 1;
	r0.w = -r1.x + r0.w;
	r1.xy = (r0.ww >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r0.w = dot(r1.xy, -r1.xy) + 1;
	r1.z = max(r0.w, 0);
	r0.w = rsqrt(r1.z);
	r0.w = 1 / r0.w;
	r1.xzw = r1.xxx * i.texcoord4.xyz;
	r1.xzw = r0.www * i.texcoord1.xyz + r1.xzw;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r1.xzw;
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r1.xyz = 1E-05 + i.texcoord3.xyz;
	r3.xyz = normalize(r1.xyz);
	r0.w = dot(-r3.xyz, r2.xyz);
	r0.w = r0.w + r0.w;
	r1.xyz = r2.xyz * -r0.www + -r3.xyz;
	r0.w = saturate(dot(r3.xyz, r2.xyz));
	r0.w = -r0.w + 1.00001;
	r3.xyz = r1.xyz + 1E-05;
	r1.x = saturate(dot(-gDirectionalLight.xyz, r1.xyz));
	r1.x = r1.x + 1E-05;
	r4.xyz = normalize(r3.xyz);
	r1.y = saturate(r4.z);
	r1.y = r1.y + 1;
	r1.y = r1.y + r1.y;
	r1.y = 1 / r1.y;
	r1.yz = r4.xy * r1.yy + 0.5;
	r3.xy = -r1.yz + 1;
	r3.zw = 0;
	r3 = tex2Dlod(EnvironmentSampler, r3);
	r1.yzw = r3.xyz * r3.xyz;
	r1.yzw = r1.yzw * 16;
	r2.w = r0.w * r0.w;
	r2.w = r2.w * r2.w;
	r0.w = r0.w * r2.w;
	r3.x = 1;
	r2.w = r3.x + -fresnelRolloff.x;
	r0.w = fresnelRolloff.x * r0.w + r2.w;
	r1.yzw = r0.www * r1.yzw;
	r0.w = saturate(r0.w);
	r1.yzw = r1.yzw * reflectivePower.xxx;
	r1.yzw = r1.yzw * globalFogColorN.www;
	r1.yzw = r0.www * r1.yzw;
	r0.w = saturate(r2.z * -0.5 + 0.5);
	r2.x = dot(r2.xyz, -gDirectionalLight.xyz);
	r4.xyz = gLightAmbient0.xyz;
	r2.yzw = -r4.xyz + gLightAmbient1.xyz;
	r2.yzw = r0.www * r2.yzw + gLightAmbient0.xyz;
	r2.yzw = r2.yzw * gAmbientOcclusionEffect.yyy;
	r0.w = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r3.y = gAmbientOcclusionEffect.y;
	r3.y = r3.y * globalScalars.z;
	r0.w = r0.w * r3.y;
	r2.yzw = r0.www * r2.yzw;
	r0.w = saturate(r2.x + -0.25);
	r2.x = saturate(r2.x * 2 + -0.5);
	r0.w = r0.w * 1.3333334;
	r3.yzw = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r3.yzw = i.texcoord2.xxx * gShadowMatrix[0].xyz + r3.yzw;
	r3.yzw = i.texcoord2.zzz * gShadowMatrix[2].xyz + r3.yzw;
	r3.yzw = r3.yzw + gShadowMatrix[3].xyz;
	r4.xy = r3.yz + -gShadowParam18192021.zw;
	r4.zw = r4.xx + -gCascadeXMaxThresholds.xy;
	r4.zw = (r4.zw >= 0) ? 1 : 0;
	r5.xy = -r4.xx + gCascadeXMinThresholds.xy;
	r5.xy = (r5.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r5.xy;
	r5.xy = r4.yy + -gCascadeYMaxThresholds.xy;
	r5.xy = (r5.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r5.xy;
	r5.xy = -r4.yy + gCascadeYMinThresholds.xy;
	r5.xy = (r5.xy >= 0) ? 1 : 0;
	r5.yz = saturate(r4.zw + r5.xy);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r3.yzw = r3.wyz * r6.zxy + r7.zxy;
	r3.y = saturate(r3.y);
	r5 = tex2D(gShadowZSamplerDir, r3.zw);
	r3.y = -r3.y + 1;
	r3.y = -r5.x + r3.y;
	r3.y = (r3.y >= 0) ? -1 : -0;
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r3.zw = saturate(abs(r4.xy) * 4 + r5.xy);
	r4.x = max(r3.z, r3.w);
	r3.y = r3.y + r4.x;
	r3.y = saturate(r3.y + 1);
	r3.yzw = r3.yyy * gDirectionalColour.xyz;
	r4.xyz = r0.www * r3.yzw;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r2.yzw = r2.yzw * r0.www + r4.xyz;
	r0.w = dot(r2.yzw, 0.33333334);
	r0.w = r0.w + 0.015;
	r1.yzw = r0.www * r1.yzw;
	r4 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r4, specMapExpMask);
	r4.x = dot(r4.xyz, specMapIntMask.xyz);
	r4.x = saturate(r4.x * specularColorFactor.x);
	r3.x = r0.w * -specularFactor.x + r3.x;
	r5.x = 1E-05;
	r0.w = r0.w * specularFactor.x + r5.x;
	r0.w = (r3.x >= 0) ? 1.00001 : r0.w;
	r3.x = pow(r1.x, r0.w);
	r0.w = r2.x * r3.x;
	r3.xyz = r0.www * r3.yzw;
	r3.xyz = r3.xyz * gDirectionalLight.www;
	r1.xyz = r3.xyz * r4.xxx + r1.yzw;
	r0.xyz = r0.xyz * r2.yzw + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.y = -r1.x + 1;
	r1.x = r1.y * gDepthFxParams.y + r1.x;
	r1.x = r1.x + -0.99999;
	r2.x = pow(r0.w, r1.x);
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = r0.w * -1.442695;
	r1.y = exp2(r1.y);
	r1.y = -r1.y + 1;
	r1.z = 1 / r0.w;
	r0.w = -abs(r0.w) + 0.0001;
	r1.y = r1.z * r1.y;
	r1.y = r1.y * r1.x;
	r0.w = (r0.w >= 0) ? r1.x : r1.y;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	r0.xyz = saturate(r2.xyz * 0.000625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;

	return o;
}
