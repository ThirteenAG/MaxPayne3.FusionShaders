sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s4);
sampler2D PuddleMaskSampler : register(s2);
sampler2D SpecSampler : register(s3);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c205);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float fresnelRolloff : register(c202);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 gWaterGlobals : register(c64);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float parallaxScaleBias : register(c196);
float reflectivePower : register(c201);
float4 specMapExpMask : register(c199);
float3 specMapIntMask : register(c198);
float3 specMapReflectMask : register(c203);
float specularFactor : register(c197);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float4 r7;
	r0.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r0.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r0.xyz;
	r0.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gShadowMatrix[3].xyz;
	r1.xy = r0.xy + -gShadowParam18192021.zw;
	r1.zw = r1.xx + -gCascadeXMaxThresholds.xy;
	r1.zw = (r1.zw >= 0) ? 1 : 0;
	r2.xy = -r1.xx + gCascadeXMinThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r1.zw = r1.zw + r2.xy;
	r2.xy = r1.yy + -gCascadeYMaxThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r1.zw = r1.zw + r2.xy;
	r2.xy = -r1.yy + gCascadeYMinThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r2.yz = saturate(r1.zw + r2.xy);
	r2.x = 1;
	r3.x = dot(r2.xyz, gShadowParam0123.xyz);
	r3.y = dot(r2.xyz, gShadowParam4567.xyz);
	r3.z = dot(r2.xyz, gCascadeZScales.xyz);
	r4.x = dot(r2.xyz, gShadowParam891113.xyz);
	r4.y = dot(r2.xyz, gShadowParam14151617.xyz);
	r4.z = dot(r2.xyz, gCascadeZOffsets.xyz);
	r0.xyz = r0.zxy * r3.zxy + r4.zxy;
	r0.x = saturate(r0.x);
	r2 = tex2D(gShadowZSamplerDir, r0.yz);
	r0.x = -r0.x + 1;
	r0.x = -r2.x + r0.x;
	r0.x = (r0.x >= 0) ? -1 : -0;
	r2.x = -gCascadeXMinThresholds.w;
	r2.y = -gCascadeXMaxThresholds.w;
	r0.yz = saturate(abs(r1.xy) * 4 + r2.xy);
	r1.x = max(r0.y, r0.z);
	r0.x = r0.x + r1.x;
	r0.x = saturate(r0.x + 1);
	r0.xyz = r0.xxx * gDirectionalColour.xyz;
	r1.xy = 0.3 * i.texcoord6.xy;
	r1 = tex2D(WaterRainRippleNormalSampler, r1.xy);
	r1.xyz = r1.xyz * 2 + -1;
	r2.xyz = 1E-05 + i.texcoord7.xyz;
	r0.w = dot(r2.xyz, r2.xyz);
	r0.w = rsqrt(r0.w);
	r2.xy = r0.ww * r2.xy;
	r3 = tex2D(BumpSampler, i.texcoord.xy);
	r4.yw = float2(0.5, -1);
	r0.w = r4.y * parallaxScaleBias.x;
	r0.w = r3.w * parallaxScaleBias.x + -r0.w;
	r2.xy = r0.ww * r2.xy + i.texcoord.xy;
	r3 = tex2D(BumpSampler, r2.xy);
	r2 = tex2D(DiffuseSampler, r2.xy);
	r3.zw = r3.xy * 2 + -1;
	r0.w = dot(r3.xy, r3.xy) + -0.002;
	r0.w = (r0.w >= 0) ? 1 : 0;
	r3.xy = r3.zw * bumpiness.xx;
	r1.w = dot(r3.xy, -r3.xy) + 1;
	r3.w = max(r1.w, 0);
	r1.w = rsqrt(r3.w);
	r3.z = 1 / r1.w;
	r1.xyz = r1.xyz * i.texcoord1.zzz + -r3.xyz;
	r4.xy = WetDarken.ww * i.texcoord6.xy;
	r5 = tex2D(PuddleMaskSampler, r4.xy);
	r1.w = r5.x + gWaterGlobals.y;
	r1.w = saturate(r1.w + -i.color.y);
	r1.xyz = r1.www * r1.xyz + r3.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r4.xyz = normalize(r1.xyz);
	r1.xyz = (-r1.www >= 0) ? r3.xyz : r4.xyz;
	r1.xyz = (-i.color.yyy >= 0) ? r3.xyz : r1.xyz;
	r3.xyz = r1.xxx * i.texcoord4.xyz;
	r3.xyz = r1.zzz * i.texcoord1.xyz + r3.xyz;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r3.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r3.xyz = normalize(r1.xyz);
	r1.xyz = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r1.xyz);
	r1.x = dot(-r4.xyz, r3.xyz);
	r1.x = r1.x + r1.x;
	r1.xyz = r3.xyz * -r1.xxx + -r4.xyz;
	r3.w = saturate(dot(r4.xyz, r3.xyz));
	r3.w = -r3.w + 1.00001;
	r4.x = saturate(dot(-gDirectionalLight.xyz, r1.xyz));
	r1.xyz = r1.xyz + 1E-05;
	r4.x = r4.x + 1E-05;
	r5 = tex2D(SpecSampler, i.texcoord.xy);
	r4.y = dot(r5, specMapExpMask);
	r4.y = r4.y * specularFactor.x;
	r6.y = max(1, r4.y);
	r6.x = dot(r5.xyz, specMapIntMask.xyz);
	r4.y = dot(r5.xyz, specMapReflectMask.xyz);
	r5.xy = lerp(r6.xy, gWaterGlobals.zw, r1.ww);
	r5.xy = (-r1.ww >= 0) ? r6.xy : r5.xy;
	r5.xy = (-i.color.yy >= 0) ? r6.xy : r5.xy;
	r4.z = r5.y + 1E-05;
	r5.x = r0.w * r5.x;
	r5.y = pow(r4.x, r4.z);
	r3.x = dot(r3.xyz, -gDirectionalLight.xyz);
	r3.y = saturate(r3.z * -0.5 + 0.5);
	r3.z = saturate(r3.x * 2 + -0.5);
	r3.x = saturate(r3.x + -0.25);
	r3.x = r3.x * 1.3333334;
	r6 = r0.xyz * r3.xxx;
	r3.x = r3.z * r5.y;
	r0.xyz = r0.xyz * r3.xxx;
	r0.xyz = r0.xyz * gDirectionalLight.www;
	r1.y = dot(r1.xyz, r1.xyz);
	r1.y = rsqrt(r1.y);
	r1.xy = r1.xz * r1.yy + 1;
	r1.xy = r1.xy * -0.5;
	r7 = tex2D(EnvironmentSampler, r1.xy);
	r1.x = r3.w * r3.w;
	r1.x = r1.x * r1.x;
	r1.x = r1.x * r3.w;
	r1.y = -r4.w + -fresnelRolloff.x;
	r1.x = fresnelRolloff.x * r1.x + r1.y;
	r1.xyz = r1.xxx * r7.xyz;
	r1.xyz = r1.xyz * reflectivePower.xxx;
	r1.xyz = r4.yyy * r1.xyz;
	r1.xyz = r1.xyz * globalScalars.www;
	r3.x = r2.w * i.color.w + -0.01;
	r2.w = r2.w * i.color.w;
	r3.z = 1 / r2.w;
	r4.w = r2.w * globalScalars.x;
	r2.w = (r3.x >= 0) ? r3.z : 100;
	r1.xyz = r1.xyz * r2.www;
	r7.xyz = gLightAmbient0.xyz;
	r3.xzw = -r7.xyz + gLightAmbient1.xyz;
	r3.xyz = r3.yyy * r3.xzw + gLightAmbient0.xyz;
	r3.xyz = r3.xyz * gAmbientOcclusionEffect.yyy;
	r2.w = r0.w * i.color.x;
	r3.xyz = r2.www * r3.xyz;
	r2.w = 1 / gAmbientOcclusionEffect.y;
	r3.xyz = r3.xyz * r2.www + r6.xyz;
	r2.w = dot(r3.xyz, 0.33333334);
	r2.w = r2.w + 0.015;
	r1.xyz = r1.xyz * r2.www;
	r0.xyz = r0.xyz * r5.xxx + r1.xyz;
	r1.xyz = r2.xyz * WetDarken.xyz + -r2.xyz;
	r2.w = saturate(gWaterGlobals.y);
	r1.xyz = r2.www * r1.xyz + r2.xyz;
	r5.xyz = r2.xyz * WetDarken.xyz;
	r1.xyz = (-r1.www >= 0) ? r1.xyz : r5.xyz;
	r1.xyz = (-i.color.yyy >= 0) ? r2.xyz : r1.xyz;
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = r1.xyz * r1.xyz;
	r0.xyz = r1.xyz * r3.xyz + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r4.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o = min(r4, float4(8, 8, 8, 1));

	return o;
}
