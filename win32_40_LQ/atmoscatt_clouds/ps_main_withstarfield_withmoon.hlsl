struct PS_IN
{
	float4 sv_position : SV_Position;
	float3 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
};

float4 main(PS_IN i) : SV_Target
{
	float4 o;

	int4 r0;
	int4 r1;
	int4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	r0.xyz = asint(i.texcoord1.xyz + float3(0.00000999999975, 0.00000999999975, 0.00000999999975));
	r0.w = asint(dot(asfloat(r0.xyz), asfloat(r0.xyz)));
	r0.w = asint(rsqrt(asfloat(r0.w)));
	r1.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz));
	r1.w = asint(saturate(1 + -(HDRSunExposure.y)));
	r2.y = asint(dot(asfloat(r1.xyz), SunDirection.xyz));
	r2.x = asint(asfloat(r1.w) * asfloat(r2.y));
	r3.x = asfloat(r1.w) * -11.6163721;
	r3.yz = float2(0.9375, 0.5);
	r1.xzw = asint(saturate(asfloat(r2.xyy) * float3(12.5799999, -0.0625, 0.5) + r3.xyz));
	r1.xz = asint(asfloat(r1.xz) + float2(0.00000999999975, 0.00000999999975));
	r1.xz = asint(log2(asfloat(r1.xz)));
	r1.xz = asint(asfloat(r1.xz) * float2(32.0000114, 3.00001001));
	r1.xz = asint(exp2(asfloat(r1.xz)));
	r2.x = asint(saturate(0.600000024 + SunDirection.w));
	r1.x = asint(-(asfloat(r1.z)) * asfloat(r2.x) + asfloat(r1.x));
	r1.x = asint(asfloat(r1.w) * SunSize + asfloat(r1.x));
	r1.x = asint(saturate(asfloat(r1.x) * 0.5));
	r1.z = asint(saturate(asfloat(r1.w) * SunCentre.y + SunCentre.x));
	r1.w = asint(asfloat(r1.z) * asfloat(r1.z));
	r1.z = asint(asfloat(r1.z) * -2 + 3);
	r1.z = asint(asfloat(r1.z) * asfloat(r1.w));
	r1.z = asint(asfloat(r1.z) * SunCentre.z);
	r1.x = asint(asfloat(r1.x) * 4 + asfloat(r1.z));
	r1.z = asint(saturate(-(asfloat(r1.x)) + 1));
	r2.xzw = asint(asfloat(r1.xxx) * SunColor.xyz);
	r2.xzw = asint(abs(asfloat(r2.xzw)) + float3(0.00000999999975, 0.00000999999975, 0.00000999999975));
	r2.xzw = asint(log2(asfloat(r2.xzw)));
	r2.xzw = asint(asfloat(r2.xzw) * float3(4.00001001, 4.00001001, 4.00001001));
	r2.xzw = asint(exp2(asfloat(r2.xzw)));
	r2.xzw = asint(asfloat(r1.xxx) * SunColor.xyz + asfloat(r2.xzw));
	r1.x = asint(asfloat(r1.z) * HDRSunExposure.x);
	r3 = PerlinNoiseSampler_tex.Sample(PerlinNoiseSampler, i.texcoord.xy);
	r4 = HighDetailNoiseSampler_tex.Sample(HighDetailNoiseSampler, i.texcoord2.zw);
	r1.z = asint(r4.x + -0.5);
	r1.w = asint(asfloat(r1.z) * CloudThicknessEdgeSmoothDetailScaleStrength.w);
	r3.x = asfloat(r1.z) * CloudThicknessEdgeSmoothDetailScaleStrength.w + r3.x;
	r3.x = saturate(CloudThreshold * r3.x + -(CloudBias));
	r3.y = r3.x + 0.00000999999975;
	r3.w = 0.00000999999975 + CloudThicknessEdgeSmoothDetailScaleStrength.x;
	r3.y = log2(r3.y);
	r3.y = r3.y * r3.w;
	r3.y = exp2(r3.y);
	r3.x = saturate(r3.x * CloudThicknessEdgeSmoothDetailScaleStrength.y);
	r3.w = r3.x * r3.y;
	r4 = PerlinNoiseSampler_tex.Sample(PerlinNoiseSampler, i.texcoord2.xy);
	r4.yz = i.texcoord2.xy * CloudThicknessEdgeSmoothDetailScaleStrength.zz;
	r5 = HighDetailNoiseSampler_tex.Sample(HighDetailNoiseSampler, r4.yz);
	r4.y = r5.x * CloudThicknessEdgeSmoothDetailScaleStrength.w;
	r4.x = r4.y * 0.200000003 + r4.x;
	r4.x = CloudThreshold * r4.x + -(CloudBias);
	r4.x = saturate(r4.x * CloudShadowStrength);
	r5 = PerlinNoiseSampler_tex.Sample(PerlinNoiseSampler, i.texcoord4.xy);
	r1.w = asint(asfloat(r1.w) * TopCloudBiasDetailThresholdHeight.y + r5.y);
	r1.w = asint(saturate(TopCloudBiasDetailThresholdHeight.z * asfloat(r1.w) + -(TopCloudBiasDetailThresholdHeight.x)));
	r1.w = asint(asfloat(r1.w) * i.texcoord4.z);
	r4.y = asfloat(r2.y) * asfloat(r2.y);
	r3.x = -(r3.y) * r3.x + 1;
	r3.y = -(r4.x) * 0.5 + r3.x;
	r3.y = max(r3.y, 0);
	r3.y = r3.y * r4.y;
	r3.y = r3.y * CloudInscatteringRange + 1;
	r1.z = asint(saturate(asfloat(r1.z) * 0.200000003 + r3.z));
	r3.z = -(r4.x) + 1;
	r3.z = r3.w * r3.z;
	r1.z = asint(r3.z * asfloat(r1.z) + asfloat(r1.z));
	r2.y = asint(asfloat(r2.y) * 0.25 + 0.349999994);
	r1.z = asint(asfloat(r1.z) * asfloat(r2.y));
	r4.xyz = saturate(r3.yyy * CloudColor.xyz + -(r4.xxx));
	r4.xyz = SunsetColor.xyz * asfloat(r1.zzz) + r4.xyz;
	r1.z = asint(asfloat(r1.w) * r3.x);
	r5.xyz = -(r4.xyz) + TopCloudColor.xyz;
	r4.xyz = asfloat(r1.zzz) * r5.xyz + r4.xyz;
	r1.z = asint(r3.x * asfloat(r1.z) + r3.w);
	r3.xyz = saturate(asfloat(r1.xxx) * i.texcoord5.xyz);
	r2.xyz = asint(asfloat(r2.xzw) * HDRSunExposure.xxx + r3.xyz);
	r3 = StarFieldSampler_tex.Sample(StarFieldSampler, i.texcoord3.xy);
	r3.xyz = r3.xyz * StarFieldBrightness.xxx + -(StarFieldBrightness.zzz);
	r5 = GalaxySampler_tex.Sample(GalaxySampler, i.texcoord3.zw);
	r6.xyz = r5.xyz * StarFieldBrightness.yyy;
	r1.x = asint(dot(r6.xyz, float3(1.20000005, 1.20000005, 1.20000005)));
	r3.xyz = r3.xyz * asfloat(r1.xxx) + r3.xyz;
	r3.xyz = saturate(r5.xyz * StarFieldBrightness.yyy + r3.xyz);
	r0.xyz = asint(asfloat(r0.xyz) * asfloat(r0.www) + -(MoonPosition.xyz));
	r0.xyz = asint(asfloat(r0.xyz) + -(MoonXVector.xyz));
	r0.xyz = asint(asfloat(r0.xyz) + -(MoonYVector.xyz));
	r5.x = dot(MoonXVector.xyz, asfloat(r0.xyz));
	r5.y = dot(MoonYVector.xyz, asfloat(r0.xyz));
	r0.xy = asint(r5.xy + float2(-0.5, -0.5));
	r0.xy = asint(asfloat(r0.xy) * float2(0.899999976, 0.899999976) + float2(0.5, 0.5));
	r0.zw = (asfloat(r0.xy) < float2(0.00999999978, 0.00999999978)) ? -1 : 0;
	r1.xw = (float2(0.990000010, 0.990000010) < asfloat(r0.xy)) ? -1 : 0;
	r0.zw = r0.zw | r1.xw;
	r0.zw = r0.zw & int2(1065353216, 1065353216);
	r0.xy = asint(asfloat(r0.xy) * MoonLight.xy + MoonLight.zw);
	r0.z = asint(asfloat(r0.w) + asfloat(r0.z));
	r0.z = (asfloat(r0.z) == 0) ? -1 : 0;
	r1.xw = asint(r5.xy * MoonLight.xy + MoonLight.zw);
	r6 = MoonSampler_tex.Sample(MoonSampler, asfloat(r1.xw));
	r7 = MoonGlowSampler_tex.Sample(MoonGlowSampler, asfloat(r0.xy));
	if (r0.z != 0) {
		r0.xy = (float2(1, 1) < r5.xy) ? -1 : 0;
		r0.zw = (r5.xy < float2(0, 0)) ? -1 : 0;
		r0.xy = r0.zw | r0.xy;
		r0.xy = r0.xy & int2(1065353216, 1065353216);
		r0.x = asint(asfloat(r0.y) + asfloat(r0.x));
		r0.x = asint(min(asfloat(r0.x), 1));
		r0.x = asint(-(asfloat(r0.x)) + 1);
		r0 = asint(asfloat(r0.x) * r6);
		r5.xyz = asfloat(r0.www) * MoonColorConstant.xyz;
		r6.xyz = float3(1, 1, 1) + MoonColorConstant.xyz;
		r6.xyz = r6.xyz * r7.xxx;
		r6.xyz = r6.xyz * MoonGlow;
		r0.xyz = asint(asfloat(r0.xyz) * r5.xyz + r6.xyz);
		r1.x = asint(saturate(64 * MoonColorConstant.w));
		r0.w = asint(-(asfloat(r0.w)) * asfloat(r1.x) + 1);
		r3.xyz = asfloat(r0.www) * r3.xyz;
		r0.w = asint(dot(asfloat(r2.xyz), float3(0.300000012, 0.699999988, 0.170000002)));
		r0.w = asint(saturate(-(asfloat(r0.w)) * MoonVisiblity + 1));
		r0.w = asint(asfloat(r0.w) * asfloat(r0.w));
		r1.xw = asint(-(asfloat(r1.zz)) + float2(1, 1.39999998));
		r0.w = asint(asfloat(r0.w) * asfloat(r1.x));
		r5.xyz = asfloat(r0.www) * r6.xyz;
		r5.xyz = r5.xyz * asfloat(r1.www) + float3(1, 1, 1);
		r4.xyz = r4.xyz * r5.xyz;
		r2.xyz = asint(asfloat(r0.xyz) * asfloat(r0.www) + asfloat(r2.xyz));
	}
	r0.xyz = asint(asfloat(r2.xyz) + r3.xyz);
	r0.w = asint(saturate(asfloat(r1.y) * 4 + -(CloudFadeOut)));
	r0.w = asint(asfloat(r0.w) * asfloat(r1.z));
	r1.xyz = asint(-(asfloat(r0.xyz)) + r4.xyz);
	r0.xyz = asint(asfloat(r0.www) * asfloat(r1.xyz) + asfloat(r0.xyz));
	r0.xyz = asint(asfloat(r0.xyz) * HDRExposure);
	r0.xyz = asint(min(asfloat(r0.xyz), HDRExposureClamp.xyz));
	r0.xyz = asint(min(asfloat(r0.xyz), HDRExposureClamp.xyz));
	r1.xyz = asint(abs(asfloat(r0.xyz)) + float3(0.00000999999975, 0.00000999999975, 0.00000999999975));
	r1.xyz = asint(log2(asfloat(r1.xyz)));
	r1.xyz = asint(asfloat(r1.xyz) * float3(0.250010014, 0.250010014, 0.250010014));
	r1.xyz = asint(exp2(asfloat(r1.xyz)));
	r2.xyz = (asfloat(r0.xyz) < float3(1, 1, 1)) ? -1 : 0;
	r0.xyz = (r2.xyz != 0) ? r1.xyz : r0.xyz;
	r0.w = asint(-(i.texcoord1.y) + gtaSkyDomeFade.x);
	r0.w = asint(saturate(asfloat(r0.w) * gtaSkyDomeFade.y));
	r1.xyz = asint(-(asfloat(r0.xyz)) + gtaWaterColor.xyz);
	o.xyz = asfloat(r0.www) * asfloat(r1.xyz) + asfloat(r0.xyz);
	o.w = 1;

	return o;
}
