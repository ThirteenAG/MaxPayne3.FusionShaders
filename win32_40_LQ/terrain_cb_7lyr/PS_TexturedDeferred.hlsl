cbuffer CacheTerrainCB : register(b1)
{
	float specularFactor : packoffset(c0);
	float specularColorFactor : packoffset(c0.y);
	float bumpiness : packoffset(c0.z);
};

cbuffer rage_globals : register(b5)
{
	float4 globalScalars : packoffset(c0);
	float4 globalScalars2 : packoffset(c1);
	float4 globalScalars3 : packoffset(c2);
	float4 globalScalars4 : packoffset(c3);
	float4 globalFogParams : packoffset(c4);
	float4 globalFogColor : packoffset(c5);
	float4 globalFogOffsetN : packoffset(c6);
	float4 globalFogColorN : packoffset(c7);
	float4 globalScreenSize : packoffset(c8);
	float4 globalDayNightEffects : packoffset(c9);
	float4 ColorCorrectTopAndPedReflectScale : packoffset(c10);
	float4 ColorCorrectBottomOffset : packoffset(c11);
	float4 ColorShift : packoffset(c12);
	float4 deSatContrastGamma : packoffset(c13);
	float4 deSatContrastGammaIFX : packoffset(c14);
	float4 colorize : packoffset(c15);
	float4 globalUmScalars : packoffset(c16);
	float4 gToneMapScalers : packoffset(c17);
	float4 gAmbientOcclusionEffect : packoffset(c18);
};

SamplerState TextureSampler_layer0 : register(s0);
SamplerState BumpSampler_layer0 : register(s1);
SamplerState TextureSampler_layer1 : register(s2);
SamplerState BumpSampler_layer1 : register(s3);
SamplerState TextureSampler_layer2 : register(s4);
SamplerState BumpSampler_layer2 : register(s5);
SamplerState TextureSampler_layer3 : register(s6);
SamplerState BumpSampler_layer3 : register(s7);
SamplerState TextureSampler_layer4 : register(s8);
SamplerState BumpSampler_layer4 : register(s9);
SamplerState TextureSampler_layer5 : register(s10);
SamplerState BumpSampler_layer5 : register(s11);
SamplerState TextureSampler_layer6 : register(s12);
SamplerState BumpSampler_layer6 : register(s13);
SamplerState lookupSampler : register(s14);
Texture2D TextureSampler_layer0_tex : register(t0);
Texture2D BumpSampler_layer0_tex : register(t1);
Texture2D TextureSampler_layer1_tex : register(t2);
Texture2D BumpSampler_layer1_tex : register(t3);
Texture2D TextureSampler_layer2_tex : register(t4);
Texture2D BumpSampler_layer2_tex : register(t5);
Texture2D TextureSampler_layer3_tex : register(t6);
Texture2D BumpSampler_layer3_tex : register(t7);
Texture2D TextureSampler_layer4_tex : register(t8);
Texture2D BumpSampler_layer4_tex : register(t9);
Texture2D TextureSampler_layer5_tex : register(t10);
Texture2D BumpSampler_layer5_tex : register(t11);
Texture2D TextureSampler_layer6_tex : register(t12);
Texture2D BumpSampler_layer6_tex : register(t13);
Texture2D lookupSampler_tex : register(t14);

struct PS_IN
{
	float4 sv_position : SV_Position;
	float4 texcoord : TEXCOORD;
	float3 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
};

struct PS_OUT
{
	float4 sv_target : SV_Target;
	float4 sv_target1 : SV_Target1;
	float4 sv_target2 : SV_Target2;
	float4 sv_target3 : SV_Target3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	int4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	r0 = asint(TextureSampler_layer5_tex.SampleBias(TextureSampler_layer5, i.texcoord.xy, -1.29999995));
	r1 = TextureSampler_layer4_tex.SampleBias(TextureSampler_layer4, i.texcoord.xy, -1.29999995);
	r2 = TextureSampler_layer3_tex.SampleBias(TextureSampler_layer3, i.texcoord.xy, -1.29999995);
	r3 = TextureSampler_layer2_tex.SampleBias(TextureSampler_layer2, i.texcoord.xy, -1.29999995);
	r4 = TextureSampler_layer0_tex.SampleBias(TextureSampler_layer0, i.texcoord.xy, -1.29999995);
	r5 = TextureSampler_layer1_tex.SampleBias(TextureSampler_layer1, i.texcoord.xy, -1.29999995);
	r6 = lookupSampler_tex.Sample(lookupSampler, i.texcoord.zw);
	r7 = -(r6.xyz) + float3(1, 1, 1);
	r0.w = asint(r7.y * r7.x);
	r1.w = r6.z * asfloat(r0.w);
	r0.w = asint(r7.z * asfloat(r0.w));
	r5.xyz = r1.www * r5.xyz;
	r4.xyz = r4.xyz * asfloat(r0.www) + r5.xyz;
	r5.xy = r6.yx * r7.xy;
	r5.zw = r7.zz * r5.xy;
	r5.xy = r6.zz * r5.yx;
	r2.w = r6.y * r6.x;
	r2.w = r7.z * r2.w;
	r3.xyz = r3.xyz * r5.zzz + r4.xyz;
	r2.xyz = r2.xyz * r5.yyy + r3.xyz;
	r1.xyz = r1.xyz * r5.www + r2.xyz;
	r0.xyz = asint(asfloat(r0.xyz) * r5.xxx + r1.xyz);
	r3 = TextureSampler_layer6_tex.SampleBias(TextureSampler_layer6, i.texcoord.xy, -1.29999995);
	r0.xyz = asint(r3.xyz * r2.www + asfloat(r0.xyz));
	r1.x = saturate(i.texcoord3.w + -1);
	r1.x = r1.x * globalScalars2.z;
	o.sv_target.xyz = asfloat(r0.xyz) * i.texcoord3.xyz + r1.xxx;
	o.sv_target.w = 0;
	r3 = BumpSampler_layer1_tex.Sample(BumpSampler_layer1, i.texcoord.xy);
	r0.x = asint(-(r3.w) + 1);
	r0.x = (asfloat(r0.x) < r3.x) ? -1 : 0;
	r0.x = r0.x & 1065353216;
	r0.yz = asint(-(r3.wy) + r3.xy);
	r0.xy = asint(asfloat(r0.xx) * asfloat(r0.yz) + r3.wy);
	r0.xy = asint(r1.ww * asfloat(r0.xy));
	r1 = BumpSampler_layer0_tex.Sample(BumpSampler_layer0, i.texcoord.xy);
	r0.z = asint(-(r1.w) + 1);
	r0.z = (asfloat(r0.z) < r1.x) ? -1 : 0;
	r0.z = r0.z & 1065353216;
	r1.xz = -(r1.wy) + r1.xy;
	r1.xy = asfloat(r0.zz) * r1.xz + r1.wy;
	r0.xy = asint(r1.xy * asfloat(r0.ww) + asfloat(r0.xy));
	r1 = BumpSampler_layer2_tex.Sample(BumpSampler_layer2, i.texcoord.xy);
	r0.z = asint(-(r1.w) + 1);
	r0.z = (asfloat(r0.z) < r1.x) ? -1 : 0;
	r0.z = r0.z & 1065353216;
	r1.xz = -(r1.wy) + r1.xy;
	r0.zw = asint(asfloat(r0.zz) * r1.xz + r1.wy);
	r0.xy = asint(asfloat(r0.zw) * r5.zz + asfloat(r0.xy));
	r1 = BumpSampler_layer3_tex.Sample(BumpSampler_layer3, i.texcoord.xy);
	r0.z = asint(-(r1.w) + 1);
	r0.z = (asfloat(r0.z) < r1.x) ? -1 : 0;
	r0.z = r0.z & 1065353216;
	r1.xz = -(r1.wy) + r1.xy;
	r0.zw = asint(asfloat(r0.zz) * r1.xz + r1.wy);
	r0.xy = asint(asfloat(r0.zw) * r5.yy + asfloat(r0.xy));
	r1 = BumpSampler_layer4_tex.Sample(BumpSampler_layer4, i.texcoord.xy);
	r0.z = asint(-(r1.w) + 1);
	r0.z = (asfloat(r0.z) < r1.x) ? -1 : 0;
	r0.z = r0.z & 1065353216;
	r1.xz = -(r1.wy) + r1.xy;
	r0.zw = asint(asfloat(r0.zz) * r1.xz + r1.wy);
	r0.xy = asint(asfloat(r0.zw) * r5.ww + asfloat(r0.xy));
	r1 = BumpSampler_layer5_tex.Sample(BumpSampler_layer5, i.texcoord.xy);
	r0.z = asint(-(r1.w) + 1);
	r0.z = (asfloat(r0.z) < r1.x) ? -1 : 0;
	r0.z = r0.z & 1065353216;
	r1.xz = -(r1.wy) + r1.xy;
	r0.zw = asint(asfloat(r0.zz) * r1.xz + r1.wy);
	r0.xy = asint(asfloat(r0.zw) * r5.xx + asfloat(r0.xy));
	r1 = BumpSampler_layer6_tex.Sample(BumpSampler_layer6, i.texcoord.xy);
	r0.z = asint(-(r1.w) + 1);
	r0.z = (asfloat(r0.z) < r1.x) ? -1 : 0;
	r0.z = r0.z & 1065353216;
	r1.xz = -(r1.wy) + r1.xy;
	r0.zw = asint(asfloat(r0.zz) * r1.xz + r1.wy);
	r0.xy = asint(asfloat(r0.zw) * r2.ww + asfloat(r0.xy));
	r0.xy = asint(asfloat(r0.xy) + float2(-0.5, -0.5));
	r0.xy = asint(asfloat(r0.xy) * bumpiness);
	r0.xy = asint(asfloat(r0.xy) + asfloat(r0.xy));
	r1.xyz = asfloat(r0.xxx) * i.texcoord4.xyz;
	r0.x = asint(dot(asfloat(r0.xy), asfloat(r0.xy)));
	r0.x = asint(-(asfloat(r0.x)) + 1);
	r0.x = asint(max(asfloat(r0.x), 0));
	r0.x = asint(sqrt(asfloat(r0.x)));
	r0.xzw = asint(i.texcoord2.xyz * asfloat(r0.xxx) + r1.xyz);
	r0.xyz = asint(asfloat(r0.yyy) * i.texcoord5.xyz + asfloat(r0.xzw));
	r0.xyz = asint(asfloat(r0.xyz) + float3(0.00000999999975, 0.00000999999975, 0.00000999999975));
	r0.w = asint(dot(asfloat(r0.xyz), asfloat(r0.xyz)));
	r0.w = asint(rsqrt(asfloat(r0.w)));
	r0.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz));
	o.sv_target1.xyz = asfloat(r0.xyz) * float3(0.5, 0.5, 0.5) + float3(0.5, 0.5, 0.5);
	o.sv_target1.w = globalScalars.x;
	r0.x = asint(saturate(specularFactor * 0.00510204071));
	r0.x = asint(sqrt(asfloat(r0.x)));
	o.sv_target2.y = sqrt(asfloat(r0.x));
	o.sv_target2.z = i.texcoord3.w * gAmbientOcclusionEffect.w;
	o.sv_target2.x = specularColorFactor;
	o.sv_target2.w = globalScalars.x;
	o.sv_target3.xyz = float3(0, 0, 0);
	o.sv_target3.w = globalScalars.x;

	return o;
}
