	r0.w = asint(asfloat(r1.z) * asfloat(r0.w));
	r0.xyz = asint(asfloat(r0.xyz) / asfloat(r1.zzz));
	r0.xyz = asint(-(waterColour.xyz) * asfloat(r2.xyz) + asfloat(r0.xyz));
	r0.xyz = asint(asfloat(r0.www) * asfloat(r0.xyz) + asfloat(r4.xyz));
	o.xyz = asfloat(r0.xyz) * globalScalars.yyy;
	o.w = (r1.x != 0) ? 0 : asfloat(r1.z);

	return o;
}
