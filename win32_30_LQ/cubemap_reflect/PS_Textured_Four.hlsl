sampler2D DiffuseSampler : register(s0);
samplerCUBE EnvironmentSampler : register(s1);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float reflectivePower : register(c196);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	r0.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r0.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r0.xyz;
	r0.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gShadowMatrix[3].xyz;
	r1.xy = r0.xy + -gShadowParam18192021.zw;
	r1.zw = r1.xx + -gCascadeXMaxThresholds.xy;
	r1.zw = (r1.zw >= 0) ? 1 : 0;
	r2.xy = -r1.xx + gCascadeXMinThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r1.zw = r1.zw + r2.xy;
	r2.xy = r1.yy + -gCascadeYMaxThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r1.zw = r1.zw + r2.xy;
	r2.xy = -r1.yy + gCascadeYMinThresholds.xy;
	r2.xy = (r2.xy >= 0) ? 1 : 0;
	r2.yz = saturate(r1.zw + r2.xy);
	r2.x = 1;
	r3.x = dot(r2.xyz, gShadowParam0123.xyz);
	r3.y = dot(r2.xyz, gShadowParam4567.xyz);
	r3.z = dot(r2.xyz, gCascadeZScales.xyz);
	r4.x = dot(r2.xyz, gShadowParam891113.xyz);
	r4.y = dot(r2.xyz, gShadowParam14151617.xyz);
	r4.z = dot(r2.xyz, gCascadeZOffsets.xyz);
	r0.xyz = r0.zxy * r3.zxy + r4.zxy;
	r0.x = saturate(r0.x);
	r2 = tex2D(gShadowZSamplerDir, r0.yz);
	r0.x = -r0.x + 1;
	r0.x = -r2.x + r0.x;
	r0.x = (r0.x >= 0) ? -1 : -0;
	r2.x = -gCascadeXMinThresholds.w;
	r2.y = -gCascadeXMaxThresholds.w;
	r0.yz = saturate(abs(r1.xy) * 4 + r2.xy);
	r1.x = max(r0.y, r0.z);
	r0.x = r0.x + r1.x;
	r0.x = saturate(r0.x + 1);
	r0.xyz = r0.xxx * gDirectionalColour.xyz;
	r1.xyz = 1E-05 + i.texcoord1.xyz;
	r2.xyz = normalize(r1.xyz);
	r0.w = dot(r2.xyz, -gDirectionalLight.xyz);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r0.xyz = r0.www * r0.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = gLightAmbient0.xyz;
	r1.xyz = -r1.xyz + gLightAmbient1.xyz;
	r1.w = saturate(r2.z * -0.5 + 0.5);
	r1.xyz = r1.www * r1.xyz + gLightAmbient0.xyz;
	r1.xyz = r1.xyz * gAmbientOcclusionEffect.yyy;
	r1.xyz = r1.xyz * i.color.xxx;
	r0.xyz = r1.xyz * r0.www + r0.xyz;
	r1 = gLightPosX + -i.texcoord6.x;
	r3 = r1 * r1;
	r4 = gLightPosY + -i.texcoord6.y;
	r3 = r4 * r4 + r3;
	r5 = gLightPosZ + -i.texcoord6.z;
	r3 = r5 * r5 + r3;
	r6.y = 1;
	r6 = r3 * -gLightFallOff + r6.y;
	r3 = r3 + 1E-05;
	r7 = max(r6, 0);
	r6 = r7 * r7;
	r6 = r6 * r6 + -0.1;
	r7 = r6 * 1.1111112;
	r6 = (r6 >= 0) ? r7 : 0;
	r7 = r2.x * r1;
	r1 = r1 * -gLightDirX;
	r1 = r4 * -gLightDirY + r1;
	r4 = r4 * r2.y + r7;
	r4 = r5 * r2.z + r4;
	r1 = r5 * -gLightDirZ + r1;
	r4 = r6 * r4;
	r5.x = rsqrt(r3.x);
	r5.y = rsqrt(r3.y);
	r5.z = rsqrt(r3.z);
	r5.w = rsqrt(r3.w);
	r3 = saturate(r4 * r5);
	r1 = r1 * r5;
	r4 = gLightConeScale;
	r1 = saturate(r1 * r4 + gLightConeOffset);
	r1 = r3 * r1;
	r3.x = dot(gLightColR, r1);
	r3.y = dot(gLightColG, r1);
	r3.z = dot(gLightColB, r1);
	r0.xyz = r0.xyz + r3.xyz;
	r0.w = dot(r0.xyz, 0.33333334);
	r0.w = r0.w + 0.015;
	r1.xyz = 1E-05 + i.texcoord3.xzy;
	r1.w = dot(r1.xyz, r1.xyz);
	r1.w = rsqrt(r1.w);
	r1.xyz = r1.www * r1.xyz;
	r1.w = dot(-r1.xzy, r2.xyz);
	r1.w = r1.w + r1.w;
	r1.xyz = r2.xzy * -r1.www + -r1.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r1.w = dot(r1.xyz, r1.xyz);
	r1.w = rsqrt(r1.w);
	r1.xyz = r1.www * r1.xyz;
	r1 = texCUBE(EnvironmentSampler, r1.xyz);
	r1.xyz = r1.xyz * reflectivePower.xxx;
	r1.xyz = r1.xyz * globalScalars.www;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.w = r2.w * i.color.w + -0.01;
	r2.w = r2.w * i.color.w;
	r2.xyz = r2.xyz * r2.xyz;
	r3.x = 1 / r2.w;
	r4.w = r2.w * globalScalars.x;
	r1.w = (r1.w >= 0) ? r3.x : 100;
	r1.xyz = r1.www * r1.xyz;
	r1.xyz = r0.www * r1.xyz;
	r0.xyz = r2.xyz * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r4.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o = min(r4, float4(8, 8, 8, 1));

	return o;
}
