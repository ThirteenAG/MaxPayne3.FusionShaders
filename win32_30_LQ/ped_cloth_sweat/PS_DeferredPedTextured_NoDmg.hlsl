sampler2D BumpSampler : register(s1);
float4 ClothDarken : register(c211);
float4 ClothDarkenColor : register(c213);
sampler2D ClothSweatMapSampler : register(s4);
float4 ClothSweatSpec : register(c212);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s2);
sampler3D VolumeSampler : register(s3);
float bumpiness : register(c197);
float4 detailSettings : register(c203);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c202);
float4 specMapExpMask : register(c201);
float3 specMapIntMask : register(c200);
float specularFactor : register(c199);
float4 vSweatParams : register(c210);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color2 : COLOR2;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float3 r6;
	r0.x = 1 / vSweatParams.w;
	r0.y = vSweatParams.z + -i.texcoord4.w;
	r0.x = saturate(r0.x * r0.y);
	r0.x = r0.x * vSweatParams.y;
	r0.x = (r0.y >= 0) ? r0.x : 0;
	r1 = tex2D(ClothSweatMapSampler, i.texcoord.xy);
	r0.y = -r1.y + vSweatParams.x;
	r1.y = saturate(max(r0.y, r0.x));
	r0.x = -r1.y + ClothDarken.w;
	r0.y = 1 / ClothDarken.w;
	r0.y = r0.y * r0.x;
	r2.xw = float2(1, 0);
	r3.xyz = lerp(ClothDarken.xyz, r2.xxx, r0.yyy);
	r0.xyz = (r0.xxx >= 0) ? r3.xyz : ClothDarken.xyz;
	r3 = tex2D(DiffuseSampler, i.texcoord.xy);
	r4.xyz = lerp(ClothDarkenColor.xyz, r3.xyz, r0.xyz);
	r0.x = r3.w * i.texcoord2.w;
	r0.x = r0.x * globalScalars.x;
	r0.yzw = r4.xyz * matMaterialColorScale.xxx;
	r3 = tex2D(SpecSampler, i.texcoord.xy);
	r1.z = r3.z * 16;
	r1.w = frac(r1.z);
	r1.z = r1.z + -r1.w;
	r1.w = (-r1.w >= 0) ? 0 : 1;
	r1.w = (r3.z >= 0) ? 0 : r1.w;
	r1.z = r1.w + r1.z;
	r1.z = r1.z + 0.5;
	r4.z = r1.z * 0.0625;
	r4.xy = detailSettings.zw * i.texcoord.xy;
	r4 = tex3D(VolumeSampler, r4.xyz);
	r4.xyz = r4.yzx * 2 + -1;
	r1.z = detailSettings.x * i.texcoord2.w;
	r1.z = r4.z * r1.z + 1;
	o.color.xyz = r0.yzw * r1.zzz;
	r0.y = dot(r3.xyz, specMapIntMask.xyz);
	r0.z = dot(r3, specMapExpMask);
	r0.z = r0.z * specularFactor.x;
	r1.w = max(1, r0.z);
	r0.z = lerp(r1.w, ClothSweatSpec.y, r1.y);
	r0.w = r1.x * ClothSweatSpec.x + -r0.y;
	r0.y = r1.y * r0.w + r0.y;
	r0.zw = r0.zy * matMaterialColorScale.ww;
	r0.w = saturate(r0.w * 5);
	r3 = tex2D(BumpSampler, i.texcoord.xy);
	r1.x = -r3.w + 1;
	r1.x = -r3.x + r1.x;
	r1.xy = (r1.xx >= 0) ? r3.wy : r3.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r1.w = dot(r1.xy, -r1.xy) + 1;
	r2.y = max(r1.w, 0);
	r1.w = rsqrt(r2.y);
	r1.w = 1 / r1.w;
	r3.xyz = r1.xxx * i.texcoord4.xyz;
	r3.xyz = r1.www * i.texcoord1.xyz + r3.xyz;
	r1.xyw = r1.yyy * i.texcoord5.xyz + r3.xyz;
	r1.xyw = r1.xyw + 1E-05;
	r2.y = dot(r1.xyw, r1.xyw);
	r2.y = rsqrt(r2.y);
	r3.xyz = r1.xyw * r2.yyy + 1E-05;
	r1.xyw = r1.xyw * r2.yyy;
	r5 = normalize(r3.xyz);
	r3.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r3.xyz = r3.xyz + 1E-05;
	r6 = normalize(r3.xyz);
	r2.y = dot(r6.xyz, r5.xyz);
	r2.z = r2.y * 1.5 + 1;
	r2.y = (-r2.y >= 0) ? r2.z : 1;
	r2.z = r2.y * i.texcoord2.y;
	r0.w = r0.w * r2.z;
	r2.z = saturate(r0.z * -0.01 + 1);
	r3.x = r0.z * 0.0051020407;
	r3.x = saturate(r3.x);
	r0.z = rsqrt(r3.x);
	r0.z = 1 / r0.z;
	r0.z = rsqrt(r0.z);
	o.color2.y = 1 / r0.z;
	r0.z = r0.w * r2.z;
	r0.z = (r2.y >= 0) ? r0.z : 0;
	r0.y = r0.y * matMaterialColorScale.w + r0.z;
	o.color2.x = saturate(r1.z * r0.y);
	r0.yzw = r4.yyy * i.texcoord5.xyz;
	r0.yzw = i.texcoord4.xyz * r4.xxx + r0.yzw;
	r0.yzw = r0.yzw * detailSettings.yyy;
	r0.yzw = r0.yzw * i.texcoord2.www + r1.xyw;
	r0.yzw = r0.yzw + 1E-05;
	r1.xyz = normalize(r0.yzw);
	o.color1.xyz = r1.xyz * 0.5 + 0.5;
	r0.y = saturate(gAmbientOcclusionEffect.z);
	r0.y = saturate(r0.y + i.texcoord2.x);
	o.color2.z = r0.y * gAmbientOcclusionEffect.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3 = r2.wwwx * gStencil.x;

	return o;
}
