float4 gDeferredLightColourAndIntensity : register(c214);
sampler2D gDeferredLightSampler : register(s0);
sampler2D gDeferredLightSampler1 : register(s1);
float4 gooDeferredLightScreenSize : register(c215);

float4 main(float2 vpos : VPOS) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float4 r7;
	float4 r8;
	r0.xy = gDeferredLightColourAndIntensity.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r0 = tex2D(gDeferredLightSampler, r0.xy);
	r0.xyz = r0.xyz * 2 + -1;
	r1.xyz = frac(abs(r0.xyz));
	r2.xyz = abs(r0.xyz) + -r1.xyz;
	r0.xyz = (r0.xyz >= 0) ? 12 : 10;
	r3.xyz = r2.xyz * 0.010001;
	r4.xyz = frac(r3.xyz);
	r3.xyz = r3.xyz + -r4.xyz;
	r4.xyz = (-abs(r3.xyz) >= 0) ? -1 : -0;
	r2.xyz = r3.xyz * -100 + r2.xyz;
	r5.xyz = r2.xyz * 0.10001;
	r6 = frac(r5.xyz);
	r5.xyz = r5.xyz + -r6.xyz;
	r4.xyz = (-abs(r5.xyz) >= 0) ? r4.xyz : -0;
	r4.xyz = (r4.xyz >= 0) ? r5.xyz : r0.xyz;
	r6 = (-abs(r5.xyz) >= 0) ? 12 : r0.xyz;
	r0.xyz = (-abs(r3.xyz) >= 0) ? 12 : r0.xyz;
	r3.xyz = (-abs(r3.xyz) >= 0) ? r6.xyz : r3.xyz;
	r2.xyz = r5.xyz * -10 + r2.xyz;
	r5.xyz = -gDeferredLightColourAndIntensity.xyy + vpos.xyy;
	r5.xyz = r5.xyz * float3(0.09090909, 0.0625, 0.0625);
	r6 = frac(r5.xzz);
	r5.xyz = r5.xyz + -r6.xyz;
	r5.xyw = r5.xyz + float3(10, 2, 1);
	r7.y = (-abs(r5.z) >= 0) ? r6.z : 0;
	r0.xyz = (-r5.xxx >= 0) ? 12 : r0.xyz;
	r8 = -r5.x + float4(1, 2, 3, 4);
	r0.xyz = (r8.xxx >= 0) ? r0.xyz : r3.xyz;
	r0.xyz = (r8.yyy >= 0) ? r0.xyz : r4.xyz;
	r0.xyz = (r8.zzz >= 0) ? r0.xyz : r2.xyz;
	r0.xyz = (r8.www >= 0) ? r0.xyz : 11;
	r2.xyz = r1.xyz * 10;
	r3.xyz = frac(r2.xyz);
	r2.xyz = r2.xyz + -r3.xyz;
	r3 = -r5.x + float4(5, 6, 7, 8);
	r4.xy = (-abs(r5.yw) >= 0) ? r6.zz : 0;
	r0.xyz = (r3.xxx >= 0) ? r0.xyz : r2.xyz;
	r1.xyz = r2.xyz * -0.1 + r1.xyz;
	r2.xyz = r1.xyz * 100;
	r5.xyz = frac(r2.xyz);
	r2.xyz = r2.xyz + -r5.xyz;
	r0.xyz = (r3.yyy >= 0) ? r0.xyz : r2.xyz;
	r1.xyz = r2.xyz * -0.01 + r1.xyz;
	r1.xyz = r1.xyz * 1000;
	r2.xyz = frac(r1.xyz);
	r1.xyz = r1.xyz + -r2.xyz;
	r0.xyz = (r3.zzz >= 0) ? r0.xyz : r1.xyz;
	r0.xyz = (r3.www >= 0) ? r0.xyz : 12;
	r0.xyz = r6.xxx + r0.xyz;
	r0.xyz = r0.xyz * 0.0859375;
	r4.zw = r0.xx * float2(1, 0);
	r1 = tex2Dlod(gDeferredLightSampler1, r4.zxww);
	r2.x = gooDeferredLightScreenSize.z * vpos.x;
	r3.x = 1;
	r2.z = vpos.y * -gooDeferredLightScreenSize.w + r3.x;
	r2 = tex2D(gDeferredLightSampler, r2.xz);
	r3 = lerp(r2, r1, r1.w);
	r4.xzw = r0.yxx * float3(1, 0, 0);
	r7.xzw = r0.zxx * float3(1, 0, 0);
	r0 = tex2Dlod(gDeferredLightSampler1, r7);
	r1 = tex2Dlod(gDeferredLightSampler1, r4);
	r2 = lerp(r3, r1, r1.w);
	r1 = r0 + -r2;
	o = r0.w * r1 + r2;

	return o;
}
