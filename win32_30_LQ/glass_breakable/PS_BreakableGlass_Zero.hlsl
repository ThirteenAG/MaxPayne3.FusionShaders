	r1.x = dot(i.texcoord2.xy, CrackMatrix.xy) + r0.x;
	r1.y = dot(i.texcoord2.xy, CrackMatrix.zw) + r0.x;
	r0.yz = r1.xy + CrackOffset.xy;
	r0.w = saturate(3 * i.color1.x);
	r1 = tex2D(CrackSampler, r0.yz);
	r0.y = r0.w * r1.x;
	r0.z = 0.5 + -i.color1.y;
	r1 = BrokenGlassTileScale * i.texcoord.xyxy;
	r1.xy = (r0.zz >= 0) ? r1.xy : r1.zw;
	r2.xyz = 1E-05 + i.texcoord1.xyz;
	r3.xyz = normalize(r2.xyz);
	r2 = tex2D(BrokenBumpSampler, r1.xy);
	r2.xy = r2.xy * 2 + r3.xy;
	r2.z = r3.z;
	r2.xyz = r2.xyz + float3(-0.99999, -0.99999, 1E-05);
	r1.z = dot(r2.xyz, r2.xyz);
	r1.z = rsqrt(r1.z);
	r2.xyz = r2.xyz * r1.zzz + -r3.xyz;
	r2.xyz = r0.yyy * r2.xyz + r3.xyz;
	r2.xyz = r2.xyz + 1E-05;
	r1.z = dot(r2.xyz, r2.xyz);
	r1.z = rsqrt(r1.z);
	r3 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2.xyz = r2.xyz * r1.zzz + 1E-05;
	r4.xyz = normalize(r2.xyz);
	r1.w = 1;
	r2.x = max(r1.w, specularFactor.x);
	if (-reflectivePower.x < r0.x) {
		r0.x = saturate(r2.x * 0.015625);
		r5.w = r0.x * -4 + 4;
		r2.yzw = 1E-05 + i.texcoord3.xyz;
