	r5.x = r1.w * specularFactor.x;
	r5.y = dot(r1.xyz, specMapIntMask.xyz);
	r0.x = r1.w * specularFactor.x + -r2.x;
	r1.x = r0.y * r0.x + r2.x;
	r1.y = lerp(specularColorFactor.x, r5.y, r0.y);
	r3 = (r0.z >= 0) ? r3 : r6;
	r0.xy = (r0.zz >= 0) ? r1.xy : r5.xy;
	r0.z = r7.w * specularFactor.x;
	r1.x = max(r0.x, r0.z);
	r0.x = dot(r7.xyz, specMapIntMask.xyz);
	r1.y = max(r0.y, r0.x);
	r0.xyz = r3.xyz * r3.xyz;
	r0.w = r3.w * i.color.w;
	r3.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r3.xyz);
	r1.z = saturate(r4.z * -0.5 + 0.5);
	r3.xyz = gLightAmbient0.xyz;
	r3.xyz = -r3.xyz + gLightAmbient1.xyz;
	r3.xyz = r1.zzz * r3.xyz + gLightAmbient0.xyz;
	r3.xyz = r3.xyz * gAmbientOcclusionEffect.yyy;
	r1.z = dot(-r5.xyz, r4.xyz);
	r1.z = r1.z + r1.z;
	r5.xyz = r4.xyz * -r1.zzz + -r5.xyz;
	r1.z = dot(r4.xyz, -gDirectionalLight.xyz);
	r1.w = saturate(r1.z + -0.25);
	r1.w = r1.w * 1.3333334;
	r2.x = saturate(dot(-gDirectionalLight.xyz, r5.xyz));
	r2.x = r2.x + 1E-05;
	r1.x = r1.x + 1E-05;
	r4.x = pow(r2.x, r1.x);
	r1.x = saturate(r1.z * 2 + -0.5);
	r1.x = r1.x * r4.x;
	r4.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r4.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r4.xyz;
	r4.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r4.xyz;
	r4.xyz = r4.xyz + gShadowMatrix[3].xyz;
	r5.xy = r4.xy + -gShadowParam18192021.zw;
	r5.zw = r5.xx + -gCascadeXMaxThresholds.xy;
	r5.zw = (r5.zw >= 0) ? 1 : 0;
	r6.xy = -r5.xx + gCascadeXMinThresholds.xy;
	r6.zw = r5.yy + -gCascadeYMaxThresholds.xy;
	r6 = (r6 >= 0) ? 1 : 0;
	r7.xy = -r5.yy + gCascadeYMinThresholds.xy;
	r7.xy = (r7.xy >= 0) ? 1 : 0;
	r5.zw = r5.zw + r6.xy;
	r5.zw = r6.zw + r5.zw;
	r6.yz = saturate(r7.xy + r5.zw);
	r6.x = 1;
	r7.x = dot(r6.xyz, gShadowParam0123.xyz);
	r7.y = dot(r6.xyz, gShadowParam4567.xyz);
	r7.z = dot(r6.xyz, gCascadeZScales.xyz);
	r8.x = dot(r6.xyz, gShadowParam891113.xyz);
	r8.y = dot(r6.xyz, gShadowParam14151617.xyz);
	r8.z = dot(r6.xyz, gCascadeZOffsets.xyz);
	r4.xyz = r4.zxy * r7.zxy + r8.zxy;
	r4.x = saturate(r4.x);
	r6.x = -gCascadeXMinThresholds.w;
	r6.y = -gCascadeXMaxThresholds.w;
	r5.xy = saturate(abs(r5.xy) * 4 + r6.xy);
	r1.z = max(r5.x, r5.y);
	r2.x = -r4.x + 1;
	r4 = tex2D(gShadowZSamplerDir, r4.yz);
	r2.x = r2.x + -r4.x;
	r2.x = (r2.x >= 0) ? -1 : -0;
	r1.z = r1.z + r2.x;
	r1.z = saturate(r1.z + 1);
	r4.xyz = r1.zzz * gDirectionalColour.xyz;
	r5.xyz = r1.xxx * r4.xyz;
	r1.xzw = r1.www * r4.xyz;
	r4.xyz = r5.xyz * gDirectionalLight.www;
	r1.xzw = r3.xyz * i.color.xxx + r1.xzw;
	r2.x = r3.w * i.color.w + -0.01;
	r3.x = 1 / r0.w;
	r2.x = (r2.x >= 0) ? r3.x : 100;
	r2.x = r0.w * r2.x;
	r2.xyz = r2.xxx * r2.yzw;
	r2.w = dot(r1.xzw, 0.33333334);
	r2.w = r2.w + 0.015;
	r2.xyz = r2.www * r2.xyz;
	r2.xyz = r4.xyz * r1.yyy + r2.xyz;
	r0.xyz = r0.xyz * r1.xzw + r2.xyz;
	r0.w = r0.w * globalScalars.x;
	r1.x = r0.w * i.color1.x;
	r0.w = (-i.color1.y >= 0) ? r0.w : r1.x;
	o.w = r0.w * i.color1.z;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r0.xyz = -r0.www + r0.xyz;
	o.xyz = r1.xxx * r0.xyz + r0.www;

	return o;
}
