sampler2D DiffuseSampler : register(s0);
sampler2D DirtSampler : register(s2);
sampler2D EnvironmentSampler : register(s4);
sampler2D SpecSampler : register(s3);
float4 deSatContrastGamma : register(c46);
float3 dirtColor : register(c201);
float dirtLevel : register(c200);
float emissiveMultiplier : register(c199);
float fresnelRolloff : register(c207);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float3 matDiffuseColor : register(c197);
float reflectivePower : register(c206);
float4 specMapExpMask : register(c205);
float3 specMapIntMask : register(c204);
float specularColorFactor : register(c203);
float specularFactor : register(c202);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float4 texcoord6 : TEXCOORD6;
	float2 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.xyz = 1E-05 + i.texcoord1.xyz;
	r2.xyz = normalize(r1.xyz);
	r1 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r1, specMapExpMask);
	r1.x = dot(r1.xyz, specMapIntMask.xyz);
	r1.x = saturate(r1.x * specularColorFactor.x);
	r3.xyw = float3(1E-05, 1, 0);
	r1.y = r1.w * -specularFactor.x + r3.y;
	r4.xyz = 1E-05 + i.texcoord3.xyz;
	r5 = normalize(r4.xyz);
	r1.z = dot(-r5.xyz, r2.xyz);
	r1.z = r1.z + r1.z;
	r4.xyz = r2.xyz * -r1.zzz + -r5.xyz;
	r6.xyz = r4.xyz + 1E-05;
	r7.xyz = normalize(r6.xyz);
	r1.z = saturate(r7.z);
	r1.z = r1.z + 1;
	r1.z = r1.z + r1.z;
	r1.z = 1 / r1.z;
	r6.xy = r7.xy * r1.zz + 0.5;
	r6.xy = -r6.xy + 1;
	r6.zw = 0;
	r6 = tex2Dlod(EnvironmentSampler, r6);
	r6.xyz = r6.xyz * r6.xyz;
	r6.xyz = r6.xyz * 16;
	r1.z = saturate(dot(r5.xyz, r2.xyz));
	r2.w = r3.y + -fresnelRolloff.x;
	r1.z = -r1.z + 1.00001;
	r3.z = r1.z * r1.z;
	r3.z = r3.z * r3.z;
	r1.z = r1.z * r3.z;
	r1.z = fresnelRolloff.x * r1.z + r2.w;
	r5 = r1.zzz * r6.xyz;
	r5 = r5.xyz * reflectivePower.xxx;
	r5 = r5.xyz * globalFogColorN.www;
	r6.xyz = r0.xyz * r0.xyz;
	r0.xyz = r6.xyz * matDiffuseColor.xyz;
	r6 = r0 * i.texcoord6;
	r7.y = gAmbientOcclusionEffect.y;
	r2.w = r7.y * globalScalars.z;
	if (-dirtLevel.x < r3.w) {
		r7 = tex2D(DirtSampler, i.texcoord7.xy);
		r3.z = r7.x * dirtLevel.x;
		r8.x = r7.x * -dirtLevel.x + r3.y;
		r8.yzw = lerp(r0.xyz, dirtColor.xyz, r3.zzz);
		r9 = r0.xxyz * float4(0, 1, 1, 1) + float4(1, 0, 0, 0);
		r0 = (-r7.x >= 0) ? r9.yzwx : r8.yzwx;
	} else {
		r0.w = 1;
	}
	r0.w = r0.w * r1.x;
	r1.x = saturate(r2.z * -0.5 + 0.5);
	r7.xyz = gLightAmbient0.xyz;
	r3.yzw = -r7.xyz + gLightAmbient1.xyz;
	r3.yzw = r1.xxx * r3.yzw + gLightAmbient0.xyz;
	r3.yzw = r3.yzw * gAmbientOcclusionEffect.yyy;
	r3.yzw = r2.www * r3.yzw;
	r1.x = 1 / gAmbientOcclusionEffect.y;
	r2.x = dot(r2.xyz, -gDirectionalLight.xyz);
	r2.y = saturate(r2.x + -0.25);
	r2.y = r2.y * 1.3333334;
	r2.z = saturate(dot(-gDirectionalLight.xyz, r4.xyz));
	r2.z = r2.z + 1E-05;
	r1.w = r1.w * specularFactor.x + r3.x;
	r1.y = (r1.y >= 0) ? 1.00001 : r1.w;
	r3.x = pow(r2.z, r1.y);
	r1.y = saturate(r2.x * 2 + -0.5);
	r1.y = r1.y * r3.x;
	r2.xzw = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r2.xzw = i.texcoord2.xxx * gShadowMatrix[0].xyz + r2.xzw;
	r2.xzw = i.texcoord2.zzz * gShadowMatrix[2].xyz + r2.xzw;
	r2.xzw = r2.xzw + gShadowMatrix[3].xyz;
	r4.xy = r2.xz + -gShadowParam18192021.zw;
	r4.zw = r4.xx + -gCascadeXMaxThresholds.xy;
	r4.zw = (r4.zw >= 0) ? 1 : 0;
	r7.xy = -r4.xx + gCascadeXMinThresholds.xy;
	r7.zw = r4.yy + -gCascadeYMaxThresholds.xy;
	r7 = (r7 >= 0) ? 1 : 0;
	r8.xy = -r4.yy + gCascadeYMinThresholds.xy;
	r8.xy = (r8.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r7.xy;
	r4.zw = r7.zw + r4.zw;
	r7.yz = saturate(r8.xy + r4.zw);
	r7.x = 1;
	r8.x = dot(r7.xyz, gShadowParam0123.xyz);
	r8.y = dot(r7.xyz, gShadowParam4567.xyz);
	r8.z = dot(r7.xyz, gCascadeZScales.xyz);
	r9.x = dot(r7.xyz, gShadowParam891113.xyz);
	r9.y = dot(r7.xyz, gShadowParam14151617.xyz);
	r9.z = dot(r7.xyz, gCascadeZOffsets.xyz);
	r2.xzw = r2.wxz * r8.zxy + r9.zxy;
	r2.x = saturate(r2.x);
	r7.x = -gCascadeXMinThresholds.w;
	r7.y = -gCascadeXMaxThresholds.w;
	r4.xy = saturate(abs(r4.xy) * 4 + r7.xy);
	r1.w = max(r4.x, r4.y);
	r2.x = -r2.x + 1;
	r4 = tex2D(gShadowZSamplerDir, r2.zw);
	r2.x = -r2.x + r4.x;
	r2.x = (r2.x >= 0) ? 0 : 0.33333334;
	r1.w = r1.w + r2.x;
	r1.w = r1.w + -0.4;
	r1.w = saturate(r1.w * 1.6666666);
	r2.x = r1.w * -2 + 3;
	r1.w = r1.w * r1.w;
	r1.w = r1.w * r2.x;
	r2.xzw = r1.www * gDirectionalColour.xyz;
	r4.xyz = r1.yyy * r2.xzw;
	r2.xyz = r2.yyy * r2.xzw;
	r4.xyz = r4.xyz * gDirectionalLight.www;
	r1.xyw = r3.yzw * r1.xxx + r2.xyz;
	r1.z = saturate(r1.z);
	r2.xyz = r1.zzz * r5.xyz;
	r1.z = dot(r1.xyw, 0.33333334);
	r1.z = r1.z + 0.015;
	r2.xyz = r1.zzz * r2.xyz;
	r2.xyz = r4.xyz * r0.www + r2.xyz;
	r0.xyz = r0.xyz * r1.xyw + r2.xyz;
	r0.xyz = r6.xyz * emissiveMultiplier.xxx + r0.xyz;
	o.w = r6.w * globalScalars.x;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.z = -r1.z + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.xyz = r0.xyz + -r1.xxx;
	o.xyz = r0.www * r0.xyz + r1.xxx;

	return o;
}
