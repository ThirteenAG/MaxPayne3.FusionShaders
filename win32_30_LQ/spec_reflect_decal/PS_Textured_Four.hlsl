struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float3 r9;
	float3 r10;
	r0 = gLightPosX + -i.texcoord6.x;
	r1 = r0 * r0;
	r2 = gLightPosY + -i.texcoord6.y;
	r1 = r2 * r2 + r1;
	r3 = gLightPosZ + -i.texcoord6.z;
	r1 = r3 * r3 + r1;
	r4 = r1 + 1E-05;
	r5.y = 1;
	r1 = saturate(r1 * -gLightFallOff + r5.y);
	r1 = r1 * r1;
	r1 = r1 * r1 + -0.1;
	r6.x = rsqrt(r4.x);
	r6.y = rsqrt(r4.y);
	r6.z = rsqrt(r4.z);
	r6.w = rsqrt(r4.w);
	r0 = r0 * r6;
	r4 = r0 * -gLightDirX;
	r2 = r2 * r6;
	r3 = r3 * r6;
	r4 = r2 * -gLightDirY + r4;
	r4 = r3 * -gLightDirZ + r4;
	r6 = gLightConeScale;
	r4 = saturate(r4 * r6 + gLightConeOffset);
	r6 = r1 * 1.1111112;
	r1 = (r1 >= 0) ? r6 : 0;
	r5.xzw = 1E-05 + i.texcoord1.xyz;
	r6.xyz = normalize(r5.xzw);
	r7 = r0 * r6.x;
	r7 = r2 * r6.y + r7;
	r7 = r3 * r6.z + r7;
	r1 = saturate(r1 * r7);
	r1 = r1 * r4;
	r4.xyz = 1E-05 + i.texcoord3.xyz;
	r7.xyz = normalize(r4.xyz);
	r4.x = dot(-r7.xyz, r6.xyz);
	r4.x = r4.x + r4.x;
	r4.xyz = r6.xyz * -r4.xxx + -r7.xyz;
	r4.w = saturate(dot(r7.xyz, r6.xyz));
	r4.w = -r4.w + 1.00001;
	r0 = r0 * r4.x;
	r0 = r4.y * r2 + r0;
	r0 = saturate(r4.z * r3 + r0);
	r0 = r0 + 1E-05;
	r2.x = log2(r0.x);
	r2.y = log2(r0.y);
	r2.z = log2(r0.z);
	r2.w = log2(r0.w);
	r0 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r0, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r3.x = max(1, r0.w);
	r0.w = r3.x * 0.25 + 1E-05;
	r3.x = r3.x + 1E-05;
	r2 = r2 * r0.w;
	r7.x = exp2(r2.x);
	r7.y = exp2(r2.y);
	r7.z = exp2(r2.z);
	r7.w = exp2(r2.w);
	r2 = r1 * r7;
	r7.x = dot(gLightColR, r2);
	r7.y = dot(gLightColG, r2);
	r7.z = dot(gLightColB, r2);
	r2.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r2.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r2.xyz;
	r2.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r2.xyz;
	r2.xyz = r2.xyz + gShadowMatrix[3].xyz;
	r3.yz = r2.xy + -gShadowParam18192021.zw;
	r5.xz = r3.yy + -gCascadeXMaxThresholds.xy;
	r5.xz = (r5.xz >= 0) ? 1 : 0;
	r8.xy = -r3.yy + gCascadeXMinThresholds.xy;
	r8.xy = (r8.xy >= 0) ? 1 : 0;
	r5.xz = r5.xz + r8.xy;
	r8.xy = r3.zz + -gCascadeYMaxThresholds.xy;
	r8.xy = (r8.xy >= 0) ? 1 : 0;
	r5.xz = r5.xz + r8.xy;
	r8.xy = -r3.zz + gCascadeYMinThresholds.xy;
	r8.xy = (r8.xy >= 0) ? 1 : 0;
	r8.yz = saturate(r5.xz + r8.xy);
	r8.x = 1;
	r9.x = dot(r8.xyz, gShadowParam0123.xyz);
	r9.y = dot(r8.xyz, gShadowParam4567.xyz);
	r9.z = dot(r8.xyz, gCascadeZScales.xyz);
	r10.x = dot(r8.xyz, gShadowParam891113.xyz);
	r10.y = dot(r8.xyz, gShadowParam14151617.xyz);
	r10.z = dot(r8.xyz, gCascadeZOffsets.xyz);
	r2.xyz = r2.zxy * r9.zxy + r10.zxy;
	r2.x = saturate(r2.x);
	r8 = tex2D(gShadowZSamplerDir, r2.yz);
	r0.w = -r2.x + 1;
	r0.w = -r8.x + r0.w;
	r0.w = (r0.w >= 0) ? -1 : -0;
	r2.x = -gCascadeXMinThresholds.w;
	r2.y = -gCascadeXMaxThresholds.w;
	r2.xy = saturate(abs(r3.yz) * 4 + r2.xy);
	r3.y = max(r2.x, r2.y);
	r0.w = r0.w + r3.y;
	r0.w = saturate(r0.w + 1);
	r2.xyz = r0.www * gDirectionalColour.xyz;
	r0.w = saturate(dot(-gDirectionalLight.xyz, r4.xyz));
	r3.yzw = r4.xyz + 1E-05;
	r0.w = r0.w + 1E-05;
	r2.w = pow(r0.w, r3.x);
	r0.w = dot(r6.xyz, -gDirectionalLight.xyz);
	r3.x = saturate(r6.z * -0.5 + 0.5);
	r4.x = saturate(r0.w * 2 + -0.5);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r5.xzw = r0.www * r2.xyz;
	r0.w = r2.w * r4.x;
	r2.xyz = r0.www * r2.xyz;
	r2.xyz = r2.xyz * gDirectionalLight.www + r7.xyz;
	r4.xyz = gLightAmbient0.xyz;
	r4.xyz = -r4.xyz + gLightAmbient1.xyz;
	r4.xyz = r3.xxx * r4.xyz + gLightAmbient0.xyz;
	r4.xyz = r4.xyz * gAmbientOcclusionEffect.yyy;
	r4.xyz = r4.xyz * i.color.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r4.xyz = r4.xyz * r0.www + r5.xzw;
	r6.x = dot(gLightColR, r1);
	r6.y = dot(gLightColG, r1);
	r6.z = dot(gLightColB, r1);
	r1.xyz = r4.xyz + r6.xyz;
	r0.w = dot(r1.xyz, 0.33333334);
	r0.w = r0.w + 0.015;
	r1.w = r4.w * r4.w;
	r1.w = r1.w * r1.w;
	r1.w = r1.w * r4.w;
	r2.w = r5.y + -fresnelRolloff.x;
	r1.w = fresnelRolloff.x * r1.w + r2.w;
	r2.w = dot(r3.yzw, r3.yzw);
	r2.w = rsqrt(r2.w);
	r3.xy = r3.yw * r2.ww + 1;
	r3.xy = r3.xy * -0.5;
	r3 = tex2D(EnvironmentSampler, r3.xy);
	r3.xyz = r1.www * r3.xyz;
	r3.xyz = r3.xyz * reflectivePower.xxx;
	r1.w = dot(r0.xyz, specMapReflectMask.xyz);
	r0.x = dot(r0.xyz, specMapIntMask.xyz);
	r3.xyz = r1.www * r3.xyz;
	r3.xyz = r3.xyz * globalScalars.www;
	r4 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.y = r4.w * i.color.w + -0.01;
	r0.z = r4.w * i.color.w;
	r4.xyz = r4.xyz * r4.xyz;
	r1.w = 1 / r0.z;
	r5.w = r0.z * globalScalars.x;
	r0.y = (r0.y >= 0) ? r1.w : 100;
	r3.xyz = r0.yyy * r3.xyz;
	r0.yzw = r0.www * r3.xyz;
	r0.xyz = r2.xyz * r0.xxx + r0.yzw;
	r0.xyz = r4.xyz * r1.xyz + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r5.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o = min(r5, float4(8, 8, 8, 1));

	return o;
}
