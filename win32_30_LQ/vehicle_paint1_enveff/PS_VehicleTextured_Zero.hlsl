sampler2D DiffuseSampler : register(s0);
sampler2D DirtSampler : register(s3);
sampler2D DynamicEnvironmentSampler : register(s13);
sampler2D SpecSampler : register(s4);
float4 deSatContrastGamma : register(c46);
float3 dirtColor : register(c200);
float dirtLevel : register(c199);
float fresnelRolloff : register(c210);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float3 matDiffuseColor : register(c197);
float reflectivePower : register(c209);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c211);
float specularColorFactor : register(c202);
float specularFactor : register(c201);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float4 texcoord6 : TEXCOORD6;
	float2 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float3 r9;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.xyz = 1E-05 + i.texcoord1.xyz;
	r2.xyz = normalize(r1.xyz);
	r1 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r1, specMapExpMask);
	r2.w = dot(r1.xyz, specMapIntMask.xyz);
	r2.w = r2.w * specularColorFactor.x;
	r3.xyz = float3(1E-05, 1, 0);
	r3.w = r1.w * -specularFactor.x + r3.y;
	if (-reflectivePower.x < r3.z) {
		r4.xyz = 1E-05 + i.texcoord3.xyz;
		r5.xyz = normalize(r4.xyz);
		r4.x = dot(-r5.xyz, r2.xyz);
		r4.x = r4.x + r4.x;
		r4.xyz = r2.xyz * -r4.xxx + -r5.xyz;
		r4.xyz = r4.xyz + 1E-05;
		r6.xyz = normalize(r4.xyz);
		r4.x = saturate(r6.z);
		r4.x = r4.x + 1;
		r4.x = r4.x + r4.x;
		r4.x = 1 / r4.x;
		r4.xy = r6.xy * r4.xx + 0.5;
		r4.xy = -r4.xy + 1;
		r4.zw = 0;
		r4 = tex2Dlod(DynamicEnvironmentSampler, r4);
		r4.xyz = r4.xyz * r4.xyz;
		r4.xyz = r4.xyz * 16;
		r4.w = saturate(dot(r5.xyz, r2.xyz));
		r5.x = r3.y + -fresnelRolloff.x;
		r4.w = -r4.w + 1.00001;
		r5.y = r4.w * r4.w;
		r5.y = r5.y * r5.y;
		r4.w = r4.w * r5.y;
		r4.w = fresnelRolloff.x * r4.w + r5.x;
		r4.xyz = r4.www * r4.xyz;
	} else {
		r4.xyz = 0;
	}
	r4.xyz = r4.xyz * reflectivePower.xxx;
	r1.x = dot(r1.xyz, specMapReflectMask.xyz);
	r1.xyz = r1.xxx * r4.xyz;
	r1.xyz = r1.xyz * globalFogColorN.www;
	r4.xyz = r0.xyz * r0.xyz;
	r0.xyz = r4.xyz * matDiffuseColor.xyz;
	r0 = r0 * i.texcoord6;
	r4.x = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r4.y = gAmbientOcclusionEffect.y;
	r4.y = r4.y * globalScalars.z;
	r4.x = r4.y * r4.x;
	if (-dirtLevel.x < r3.z) {
		r5 = tex2D(DirtSampler, i.texcoord7.xy);
		r3.z = r5.x * dirtLevel.x;
		r6.x = r5.x * -dirtLevel.x + r3.y;
		r6.yzw = lerp(r0.xyz, dirtColor.xyz, r3.zzz);
		r7 = r0.xxyz * float4(0, 1, 1, 1) + float4(1, 0, 0, 0);
		r5 = (-r5.x >= 0) ? r7 : r6;
		r0.xyz = r5.yzw;
	} else {
		r5.x = 1;
	}
	r2.w = r2.w * r5.x;
	r4.yzw = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r4.yzw);
	r3.z = saturate(r2.z * -0.5 + 0.5);
	r6.xyz = gLightAmbient0.xyz;
	r4.yzw = -r6.xyz + gLightAmbient1.xyz;
	r4.yzw = r3.zzz * r4.yzw + gLightAmbient0.xyz;
	r4.yzw = r4.yzw * gAmbientOcclusionEffect.yyy;
	r4.xyz = r4.xxx * r4.yzw;
	r3.z = 1 / gAmbientOcclusionEffect.y;
	r4.w = dot(-r5.xyz, r2.xyz);
	r4.w = r4.w + r4.w;
	r6.xyz = r2.xyz * -r4.www + -r5.xyz;
	r4.w = dot(r2.xyz, -gDirectionalLight.xyz);
	r5.w = saturate(r4.w + -0.25);
	r5.w = r5.w * 1.3333334;
	r6.x = saturate(dot(-gDirectionalLight.xyz, r6.xyz));
	r6.x = r6.x + 1E-05;
	r1.w = r1.w * specularFactor.x + r3.x;
	r1.w = (r3.w >= 0) ? 1.00001 : r1.w;
	r3.x = pow(r6.x, r1.w);
	r1.w = saturate(r4.w * 2 + -0.5);
	r1.w = r1.w * r3.x;
	r6.xyz = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r6.xyz = i.texcoord2.xxx * gShadowMatrix[0].xyz + r6.xyz;
	r6.xyz = i.texcoord2.zzz * gShadowMatrix[2].xyz + r6.xyz;
	r6.xyz = r6.xyz + gShadowMatrix[3].xyz;
	r3.xw = r6.xy + -gShadowParam18192021.zw;
	r7.xy = r3.xx + -gCascadeXMaxThresholds.xy;
	r7.zw = -r3.xx + gCascadeXMinThresholds.xy;
	r7 = (r7 >= 0) ? 1 : 0;
	r8.xy = r3.ww + -gCascadeYMaxThresholds.xy;
	r8.zw = -r3.ww + gCascadeYMinThresholds.xy;
	r8 = (r8 >= 0) ? 1 : 0;
	r7.xy = r7.zw + r7.xy;
	r7.xy = r8.xy + r7.xy;
	r7.yz = saturate(r8.zw + r7.xy);
	r7.x = 1;
	r8.x = dot(r7.xyz, gShadowParam0123.xyz);
	r8.y = dot(r7.xyz, gShadowParam4567.xyz);
	r8.z = dot(r7.xyz, gCascadeZScales.xyz);
	r9.x = dot(r7.xyz, gShadowParam891113.xyz);
	r9.y = dot(r7.xyz, gShadowParam14151617.xyz);
	r9.z = dot(r7.xyz, gCascadeZOffsets.xyz);
	r6.xyz = r6.zxy * r8.zxy + r9.zxy;
	r6.x = saturate(r6.x);
	r7.x = -gCascadeXMinThresholds.w;
	r7.y = -gCascadeXMaxThresholds.w;
	r3.xw = saturate(abs(r3.xw) * 4 + r7.xy);
	r4.w = max(r3.x, r3.w);
	r3.x = -r6.x + 1;
	r6 = tex2D(gShadowZSamplerDir, r6.yz);
	r3.x = -r3.x + r6.x;
	r3.x = (r3.x >= 0) ? 0 : 0.33333334;
	r3.x = r4.w + r3.x;
	r3.x = r3.x + -0.4;
	r3.x = saturate(r3.x * 1.6666666);
	r3.w = r3.x * -2 + 3;
	r3.x = r3.x * r3.x;
	r3.x = r3.x * r3.w;
	r6.xyz = r3.xxx * gDirectionalColour.xyz;
	r7.xyz = r1.www * r6.xyz;
	r6.xyz = r5.www * r6.xyz;
	r7.xyz = r7.xyz * gDirectionalLight.www;
	r3.xzw = r4.xyz * r3.zzz + r6.xyz;
	r1.w = saturate(dot(r5.xyz, r2.xyz));
	r2.x = r3.y + -fresnelRolloff.x;
	r1.w = -r1.w + 1.00001;
	r2.y = r1.w * r1.w;
	r2.y = r2.y * r2.y;
	r1.w = r1.w * r2.y;
	r1.w = saturate(fresnelRolloff.x * r1.w + r2.x);
	r1.xyz = r1.www * r1.xyz;
	r1.w = dot(r3.xzw, 0.33333334);
	r1.w = r1.w + 0.015;
	r1.xyz = r1.www * r1.xyz;
	r1.xyz = r7.xyz * r2.www + r1.xyz;
	r0.xyz = r0.xyz * r3.xzw + r1.xyz;
	o.w = r0.w * globalScalars.x;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.z = -r1.z + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.xyz = r0.xyz + -r1.xxx;
	o.xyz = r0.www * r0.xyz + r1.xxx;

	return o;
}
