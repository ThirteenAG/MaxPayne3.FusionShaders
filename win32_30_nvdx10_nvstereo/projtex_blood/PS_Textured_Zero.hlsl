sampler2D DynamicEnvironmentSampler : register(s13);
float4 EnvBloodData : register(c203);
sampler2D EnvBloodSampler : register(s2);
float4 deSatContrastGamma : register(c46);
float fresnelRolloff : register(c202);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float reflectivePower : register(c201);
float specularColorFactor : register(c199);
float specularFactor : register(c198);

struct PS_IN
{
	float4 color : COLOR;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord7 : TEXCOORD7;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	float3 r8;
	r0.xyz = 1E-05 + i.texcoord1.xyz;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r1.yz = float2(0, 1);
	if (-EnvBloodData.w < r1.y) {
		r2 = tex2D(EnvBloodSampler, 0);
		r2.xyz = r2.xyy;
		r3.x = r2.w;
	} else {
		r2.xyz = 0;
		r3.x = 0;
	}
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r4.xyz = r0.www * r0.xyz;
	r2.w = max(r1.z, specularFactor.x);
	if (-reflectivePower.x < r1.y) {
		r1.x = saturate(r2.w * 0.015625);
		r5.w = r1.x * -4 + 4;
		r6.xyz = 1E-05 + i.texcoord3.xyz;
		r7 = normalize(r6.xyz);
		r1.x = dot(-r7.xyz, r4.xyz);
		r1.x = r1.x + r1.x;
		r6.xyz = r4.xyz * -r1.xxx + -r7.xyz;
		r6.xyz = r6.xyz + 1E-05;
		r8 = normalize(r6.xyz);
		r1.x = saturate(r8.z);
		r1.x = r1.x + 1;
		r1.x = r1.x + r1.x;
		r1.x = 1 / r1.x;
		r1.xw = r8.xy * r1.xx + 0.5;
		r5.xy = -r1.xw + 1;
		r5.z = 0;
		r5 = tex2Dlod(DynamicEnvironmentSampler, r5);
		r5.xyz = r5.xyz * r5.xyz;
		r5.xyz = r5.xyz * 16;
		r1.x = saturate(dot(r7.xyz, r4.xyz));
		r1.z = r1.z + -fresnelRolloff.x;
		r1.x = -r1.x + 1.00001;
		r1.w = r1.x * r1.x;
		r1.w = r1.w * r1.w;
		r1.x = r1.w * r1.x;
		r1.x = fresnelRolloff.x * r1.x + r1.z;
		r1.xzw = r1.xxx * r5.xyz;
	} else {
		r1.xzw = 0;
	}
	r1.xzw = r1.xzw * reflectivePower.xxx;
	r1.xzw = r1.xzw * globalScalars.www;
	if (-EnvBloodData.w < r1.y) {
		r4 = tex2D(EnvBloodSampler, i.texcoord7.xy);
		r5.xy = saturate(i.texcoord7.xy);
		r1.y = r5.y + r5.x;
		r1.y = r1.y + -i.texcoord7.x;
		r1.y = r1.y + -i.texcoord7.y;
		r1.y = -abs(r1.y) + 0.001;
		r3.xyz = (r1.yyy >= 0) ? r4.wxy : 0;
		r1.y = r3.y * 0.001;
		r3 = r3.xyzz;
	} else {
		r3.yzw = r2.xyz * r2.xyz;
		r1.y = 0;
	}
	r1.y = r1.y + specularColorFactor.x;
	r0.xyz = r0.xyz * r0.www + 1E-05;
	r2.xyz = normalize(r0.xyz);
	r0.x = r3.x * i.color.w;
	r0.yzw = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r0.yzw);
	r0.y = saturate(r2.z * -0.5 + 0.5);
	r5.xyz = gLightAmbient0.xyz;
	r5.xyz = -r5.xyz + gLightAmbient1.xyz;
	r0.yzw = r0.yyy * r5.xyz + gLightAmbient0.xyz;
	r0.yzw = r0.yzw * gAmbientOcclusionEffect.yyy;
	r0.yzw = r0.yzw * i.color.xxx;
	r4.w = 1 / gAmbientOcclusionEffect.y;
	r5.x = dot(-r4.xyz, r2.xyz);
	r5.x = r5.x + r5.x;
	r4.xyz = r2.xyz * -r5.xxx + -r4.xyz;
	r2.x = dot(r2.xyz, -gDirectionalLight.xyz);
	r2.y = saturate(r2.x + -0.25);
	r2.y = r2.y * 1.3333334;
	r2.z = saturate(dot(-gDirectionalLight.xyz, r4.xyz));
	r2.z = r2.z + 1E-05;
	r2.w = r2.w + 1E-05;
	r4.x = pow(r2.z, r2.w);
	r2.x = saturate(r2.x * 2 + -0.5);
	r2.x = r2.x * r4.x;
	r4.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r4.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r4.xyz;
	r4.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r4.xyz;
	r4.xyz = r4.xyz + gShadowMatrix[3].xyz;
	r2.zw = r4.xy + -gShadowParam18192021.zw;
	r5.xy = r2.zz + -gCascadeXMaxThresholds.xy;
	r5.zw = -r2.zz + gCascadeXMinThresholds.xy;
	r5 = (r5 >= 0) ? 1 : 0;
	r6.xy = r2.ww + -gCascadeYMaxThresholds.xy;
	r6.zw = -r2.ww + gCascadeYMinThresholds.xy;
	r6 = (r6 >= 0) ? 1 : 0;
	r5.xy = r5.zw + r5.xy;
	r5.xy = r6.xy + r5.xy;
	r5.yz = saturate(r6.zw + r5.xy);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r4.xyz = r4.zxy * r6.zxy + r7.zxy;
	r4.x = saturate(r4.x);
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r2.zw = saturate(abs(r2.zw) * 4 + r5.xy);
	r5.x = max(r2.z, r2.w);
	r2.z = -r4.x + 1;
	r6 = tex2D(gShadowZSamplerDir, r4.yz);
	r2.z = r2.z + -r6.x;
	r2.z = (r2.z >= 0) ? -1 : -0;
	r2.z = r2.z + r5.x;
	r2.z = saturate(r2.z + 1);
	r4.xyz = r2.zzz * gDirectionalColour.xyz;
	r2.xzw = r2.xxx * r4.xyz;
	r4.xyz = r2.yyy * r4.xyz;
	r2.xyz = r2.xzw * gDirectionalLight.www;
	r0.yzw = r0.yzw * r4.www + r4.xyz;
	r2.w = r3.x * i.color.w + -0.01;
	r3.x = 1 / r0.x;
	r2.w = (r2.w >= 0) ? r3.x : 100;
	r1.xzw = r1.xzw * r2.www;
	r2.w = dot(r0.yzw, 0.33333334);
	r2.w = r2.w + 0.015;
	r1.xzw = r1.xzw * r2.www;
	r1.xyz = r2.xyz * r1.yyy + r1.xzw;
	r0.yzw = r3.yzw * r0.yzw + r1.xyz;
	r1.w = r0.x * globalScalars.x;
	r0.x = dot(r0.yzw, float3(0.2125, 0.7154, 0.0721));
	r0.x = r0.x + 1E-05;
	r0.x = abs(r0.x) + 1E-05;
	r2.x = 1E-05 + i.texcoord9.y;
	r3.x = pow(r0.x, r2.x);
	r2.xyz = r0.yzw * r3.xxx;
	r0.xyz = r0.yzw * -r3.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r2.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r2.x = r2.x * deSatContrastGamma.x;
	r1.xyz = lerp(r0.www, r0.xyz, r2.xxx);
	o = min(r1, float4(8, 8, 8, 1));

	return o;
}
