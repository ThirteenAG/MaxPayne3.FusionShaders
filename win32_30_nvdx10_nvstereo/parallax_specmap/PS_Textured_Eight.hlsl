	r9 = gLightPosZ + -i.texcoord6.z;
	r7 = r9 * r9 + r7;
	r10 = r7 + 1E-05;
	r7 = saturate(r7 * -gLightFallOff + -r3.w);
	r7 = r7 * r7;
	r7 = r7 * r7 + -0.1;
	r11.x = rsqrt(r10.x);
	r11.y = rsqrt(r10.y);
	r11.z = rsqrt(r10.z);
	r11.w = rsqrt(r10.w);
	r6 = r6 * r11;
	r10 = r3.x * r6;
	r8 = r8 * r11;
	r9 = r9 * r11;
	r10 = r8 * r3.y + r10;
	r10 = r9 * r3.z + r10;
	r11 = r7 * 1.1111112;
	r7 = (r7 >= 0) ? r11 : 0;
	r7 = saturate(r7 * r10);
	r10 = r6 * -gLightDirX;
	r6 = r2.y * r6;
	r6 = r2.z * r8 + r6;
	r8 = r8 * -gLightDirY + r10;
	r8 = r9 * -gLightDirZ + r8;
	r6 = saturate(r2.w * r9 + r6);
	r6 = r6 + 1E-05;
	r9 = gLightConeScale;
	r8 = saturate(r8 * r9 + gLightConeOffset);
	r7 = r7 * r8;
	r8.x = log2(r6.x);
	r8.y = log2(r6.y);
	r8.z = log2(r6.z);
	r8.w = log2(r6.w);
	r6 = r1.y * r8;
	r8.x = exp2(r6.x);
	r8.y = exp2(r6.y);
	r8.z = exp2(r6.z);
	r8.w = exp2(r6.w);
	r6 = r7 * r8;
	r8.x = dot(gLightColR, r6);
	r8.y = dot(gLightColG, r6);
	r8.z = dot(gLightColB, r6);
	r0.xyz = r0.xyz * gDirectionalLight.www + r8.xyz;
	r6 = gLightPointPosX + -i.texcoord6.x;
	r8 = r6 * r6;
	r9 = gLightPointPosY + -i.texcoord6.y;
	r8 = r9 * r9 + r8;
	r10 = gLightPointPosZ + -i.texcoord6.z;
	r8 = r10 * r10 + r8;
	r11 = r8 + 1E-05;
	r8 = saturate(r8 * -gLightPointFallOff + -r3.w);
	r8 = r8 * r8;
	r8 = r8 * r8 + -0.1;
	r12.x = rsqrt(r11.x);
	r12.y = rsqrt(r11.y);
	r12.z = rsqrt(r11.z);
	r12.w = rsqrt(r11.w);
	r6 = r6 * r12;
	r11 = r3.x * r6;
	r9 = r9 * r12;
	r10 = r10 * r12;
	r11 = r9 * r3.y + r11;
	r11 = r10 * r3.z + r11;
	r0.w = saturate(r3.z * -0.5 + 0.5);
	r3 = r8 * 1.1111112;
	r3 = (r8 >= 0) ? r3 : 0;
	r3 = saturate(r3 * r11);
	r8 = r6 * -gLightDir2X;
	r6 = r2.y * r6;
	r6 = r2.z * r9 + r6;
	r6 = saturate(r2.w * r10 + r6);
	r6 = r6 + 1E-05;
	r8 = r9 * -gLightDir2Y + r8;
	r8 = r10 * -gLightDir2Z + r8;
	r9 = gLightConeScale2;
	r8 = saturate(r8 * r9 + gLightConeOffset2);
	r3 = r3 * r8;
	r8.x = log2(r6.x);
	r8.y = log2(r6.y);
	r8.z = log2(r6.z);
	r8.w = log2(r6.w);
	r6 = r1.y * r8;
	r8.x = exp2(r6.x);
	r8.y = exp2(r6.y);
	r8.z = exp2(r6.z);
	r8.w = exp2(r6.w);
	r6 = r3 * r8;
	r8.x = dot(gLightPointColR, r6);
	r8.y = dot(gLightPointColG, r6);
	r8.z = dot(gLightPointColB, r6);
	r0.xyz = r0.xyz + r8.xyz;
	r1.x = r1.x * r2.x;
	r0.xyz = r0.xyz * r1.xxx;
	r1.xyz = gLightAmbient0.xyz;
	r1.xyz = -r1.xyz + gLightAmbient1.xyz;
	r1.xyz = r0.www * r1.xyz + gLightAmbient0.xyz;
	r1.xyz = r1.xyz * gAmbientOcclusionEffect.yyy;
	r0.w = r2.x * i.color.x;
	r2.xyz = r2.xxx * r4.xyz;
	r1.w = r4.w * i.color.w;
	r4.w = r1.w * globalScalars.x;
	r2.xyz = r2.xyz * r2.xyz;
	r1.xyz = r0.www * r1.xyz;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r1.xyz = r1.xyz * r0.www + r5.yzw;
	r5.x = dot(gLightColR, r7);
	r5.y = dot(gLightColG, r7);
	r5.z = dot(gLightColB, r7);
	r1.xyz = r1.xyz + r5.xyz;
	r5.x = dot(gLightPointColR, r3);
	r5.y = dot(gLightPointColG, r3);
	r5.z = dot(gLightPointColB, r3);
	r1.xyz = r1.xyz + r5.xyz;
	r0.xyz = r2.xyz * r1.xyz + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
