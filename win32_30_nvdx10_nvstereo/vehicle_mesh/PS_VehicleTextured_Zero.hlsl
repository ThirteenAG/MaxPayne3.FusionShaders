	r6.zw = r5.yy + -gCascadeYMaxThresholds.xy;
	r6 = (r6 >= 0) ? 1 : 0;
	r7.xy = -r5.yy + gCascadeYMinThresholds.xy;
	r7.xy = (r7.xy >= 0) ? 1 : 0;
	r5.zw = r5.zw + r6.xy;
	r5.zw = r6.zw + r5.zw;
	r6.yz = saturate(r7.xy + r5.zw);
	r6.x = 1;
	r7.x = dot(r6.xyz, gShadowParam0123.xyz);
	r7.y = dot(r6.xyz, gShadowParam4567.xyz);
	r7.z = dot(r6.xyz, gCascadeZScales.xyz);
	r8.x = dot(r6.xyz, gShadowParam891113.xyz);
	r8.y = dot(r6.xyz, gShadowParam14151617.xyz);
	r8.z = dot(r6.xyz, gCascadeZOffsets.xyz);
	r4.xyz = r4.zxy * r7.zxy + r8.zxy;
	r4.x = saturate(r4.x);
	r6.x = -gCascadeXMinThresholds.w;
	r6.y = -gCascadeXMaxThresholds.w;
	r5.xy = saturate(abs(r5.xy) * 4 + r6.xy);
	r0.w = max(r5.x, r5.y);
	r2.y = -r4.x + 0.9999995;
	r5.x = 1 / gShadowParam18192021.x;
	r5.y = 1 / gShadowParam18192021.y;
	r4.xw = r4.yz * r5.xy;
	r5.xy = frac(r4.xw);
	r4.x = -r5.y + 1;
	r6.xy = r4.yz + -gShadowParam18192021.xy;
	r6 = tex2D(gShadowZSamplerDir, r6.xy);
	r7 = gShadowParam18192021.yyxy * r3.wzxz + r4.yzyz;
	r8 = tex2D(gShadowZSamplerDir, r7.xy);
	r7 = tex2D(gShadowZSamplerDir, r7.zw);
	r9 = gShadowParam18192021.xyxy * r3.zwxw + r4.yzyz;
	r10 = tex2D(gShadowZSamplerDir, r9.xy);
	r11 = tex2D(gShadowZSamplerDir, r4.yz);
	r9 = tex2D(gShadowZSamplerDir, r9.zw);
	r12 = gShadowParam18192021.xyyy * r3.zxwx + r4.yzyz;
	r13 = tex2D(gShadowZSamplerDir, r12.xy);
	r12 = tex2D(gShadowZSamplerDir, r12.zw);
	r3.xz = r4.yz + gShadowParam18192021.xy;
	r14 = tex2D(gShadowZSamplerDir, r3.xz);
	r10.y = r11.x;
	r10.z = r9.x;
	r3.xzw = -r2.yyy + r10.xyz;
	r3.xzw = (r3.xzw >= 0) ? 1 : 0;
	r5.zw = r5.xx * float2(-1, 0) + 1;
	r3.x = dot(r3.wxz, r5.xzw);
	r6.y = r8.x;
	r6.z = r7.x;
	r4.yzw = -r2.yyy + r6.xyz;
	r4.yzw = (r4.yzw >= 0) ? 1 : 0;
	r5.xzw = r5.xwx * float3(-1, 1, 1) + float3(1, 0, 0);
	r3.z = dot(r4.yzw, r5.xzw);
	r3.x = r3.z * r4.x + r3.x;
	r13.y = r12.x;
	r13.z = r14.x;
	r4.xyz = -r2.yyy + r13.xyz;
	r4.xyz = (r4.xyz >= 0) ? 1 : 0;
	r2.y = dot(r4.xyz, r5.xzw);
	r2.y = r2.y * r5.y + r3.x;
	r0.w = r2.y * 0.33333334 + r0.w;
	r0.w = r0.w + -0.4;
	r0.w = saturate(r0.w * 1.6666666);
	r2.y = r0.w * -2 + 3;
	r0.w = r0.w * r0.w;
	r0.w = r0.w * r2.y;
	r3.xzw = r0.www * gDirectionalColour.xyz;
	r4.xyz = r0.zzz * r3.xzw;
	r3.xyz = r3.yyy * r3.xzw;
	r4.xyz = r4.xyz * gDirectionalLight.www;
	r0.xzw = r2.xzw * r0.xxx + r3.xyz;
	r2.xyz = r0.yyy * r4.xyz;
	r0.xyz = r1.xyz * r0.xzw + r2.xyz;
	o.w = r1.w * globalScalars.x;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.z = -r1.z + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.xyz = r0.xyz + -r1.xxx;
	o.xyz = r0.www * r0.xyz + r1.xxx;

	return o;
}
