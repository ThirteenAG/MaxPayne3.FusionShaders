sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s3);
sampler2D SpecSampler : register(s2);
float bumpiness : register(c203);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float goldFactor : register(c210);
float goldFresnelRolloff : register(c207);
float3 goldReflectColorBase : register(c211);
float3 goldReflectColorOverlay : register(c212);
float goldReflectivePower : register(c205);
float3 goldSpecMapIntMask : register(c201);
float goldSpecularFactor : register(c199);
float normFresnelRolloff : register(c206);
float normReflectivePower : register(c204);
float3 normSpecMapIntMask : register(c200);
float normSpecularFactor : register(c198);
float4 specMapExpMask : register(c202);
float3 specMapReflectMask : register(c209);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float3 r3;
	r0.xyz = normSpecMapIntMask.xyz;
	r1.xyz = -r0.xyz + goldSpecMapIntMask.xyz;
	r0.xyz = goldFactor.xxx * r1.xyz + r0.xyz;
	r1 = tex2D(SpecSampler, i.texcoord.xy);
	r2 = -r1 + 1;
	r1 = goldFactor.x * r2 + r1;
	o.color2.x = dot(r1.xyz, r0.xyz);
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2.xyz = -r0.xyz + goldReflectColorBase.xyz;
	r0.xyz = goldFactor.xxx * r2.xyz + r0.xyz;
	r0.w = r0.w * i.color.w;
	r0.w = r0.w * globalScalars.x;
	r2.x = saturate(-1 + i.color.x);
	o.color.xyz = r2.xxx * globalScalars2.zzz + r0.xyz;
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r0.x = -r2.w + 1;
	r0.x = -r2.x + r0.x;
	r0.xy = (r0.xx >= 0) ? r2.wy : r2.xy;
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.z, 0);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r2.xyz = r0.xxx * i.texcoord4.xyz;
	r2.xyz = r0.zzz * i.texcoord1.xyz + r2.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r2.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r2.xyz = normalize(r0.xyz);
	o.color1.xyz = r2.xyz * 0.5 + 0.5;
	r0.x = dot(r1, specMapExpMask);
	r0.y = dot(r1.xyz, specMapReflectMask.xyz);
	r1.x = normSpecularFactor.x;
	r0.z = -r1.x + goldSpecularFactor.x;
	r0.z = goldFactor.x * r0.z + r1.x;
	r1.x = r0.z * r0.x;
	r0.x = r0.x * -r0.z + 1;
	r0.z = saturate(r1.x * 0.0051020407);
	r0.z = rsqrt(r0.z);
	r0.z = 1 / r0.z;
	r0.z = rsqrt(r0.z);
	r0.z = 1 / r0.z;
	o.color2.y = (r0.x >= 0) ? 0.26726124 : r0.z;
	o.color2.z = gAmbientOcclusionEffect.w * i.color.x;
	r1.xyz = 1E-05 + i.texcoord3.xyz;
	r3 = normalize(r1.xyz);
	r0.x = dot(-r3.xyz, r2.xyz);
	r0.x = r0.x + r0.x;
	r1.xyz = r2.xyz * -r0.xxx + -r3.xyz;
	r0.x = saturate(dot(r3.xyz, r2.xyz));
	r0.x = -r0.x + 1.00001;
	r1.xyz = r1.xyz + 1E-05;
	r0.z = dot(r1.xyz, r1.xyz);
	r0.z = rsqrt(r0.z);
	r1.xy = r1.xz * r0.zz + 1;
	r1.xy = r1.xy * -0.5;
	r1 = tex2D(EnvironmentSampler, r1.xy);
	r2.xyz = r1.xyz * goldReflectColorOverlay.xyz + -r1.xyz;
	r1.xyz = goldFactor.xxx * r2.xyz + r1.xyz;
	r0.z = r0.x * r0.x;
	r0.z = r0.z * r0.z;
	r0.x = r0.z * r0.x;
	r2.x = normFresnelRolloff.x;
	r0.z = -r2.x + goldFresnelRolloff.x;
	r0.z = goldFactor.x * r0.z + r2.x;
	r1.w = -r0.z + 1;
	r0.x = r0.z * r0.x + r1.w;
	r1.xyz = r0.xxx * r1.xyz;
	r0.x = normReflectivePower.x;
	r0.z = -r0.x + goldReflectivePower.x;
	r0.x = goldFactor.x * r0.z + r0.x;
	r1.xyz = r0.xxx * r1.xyz;
	r0.xyz = r0.yyy * r1.xyz;
	r1.x = 1;
	r2.x = goldFactor.x;
	r3.x = lerp(globalScalars.w, r1.x, r2.x);
	r0.xyz = r0.xyz * r3.xxx;
	r0.xyz = saturate(r0.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.color3.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.color3.z = 1 / r0.y;
	o.color3.y = 1 / r0.x;
	o.color.w = r0.w;
	o.color1.w = r0.w;
	o.color2.w = r0.w;
	o.color3.w = gStencil.x;

	return o;
}
