sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
sampler2D PuddleMaskSampler : register(s2);
sampler2D SpecSampler : register(s3);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c205);
float bumpiness : register(c200);
float4 deSatContrastGamma : register(c46);
float fresnelRolloff : register(c202);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 gWaterGlobals : register(c64);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float parallaxScaleBias : register(c196);
float reflectivePower : register(c201);
float4 specMapExpMask : register(c199);
float3 specMapIntMask : register(c198);
float3 specMapReflectMask : register(c203);
float specularFactor : register(c197);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float3 r8;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.xyz = 1E-05 + i.texcoord7.xyz;
	r0.z = dot(r0.xyz, r0.xyz);
	r0.z = rsqrt(r0.z);
	r0.xy = r0.zz * r0.xy;
	r1.yw = float2(0.5, -1);
	r0.z = r1.y * parallaxScaleBias.x;
	r0.z = r0.w * parallaxScaleBias.x + -r0.z;
	r0.xy = r0.zz * r0.xy + i.texcoord.xy;
	r2 = tex2D(BumpSampler, r0.xy);
	r0 = tex2D(DiffuseSampler, r0.xy);
	r1.xy = r2.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r2.z = dot(r1.xy, -r1.xy) + 1;
	r3.x = max(r2.z, 0);
	r2.z = rsqrt(r3.x);
	r1.z = 1 / r2.z;
	r3 = tex2D(SpecSampler, i.texcoord.xy);
	r2.z = dot(r3, specMapExpMask);
	r2.z = r2.z * specularFactor.x;
	r4.x = dot(r3.xyz, specMapIntMask.xyz);
	r4.y = max(1, r2.z);
	r2.zw = WetDarken.ww * i.texcoord6.xy;
	r5 = tex2D(PuddleMaskSampler, r2.zw);
	r2.z = r5.x + gWaterGlobals.y;
	r2.z = saturate(r2.z + -i.color.y);
	r5.xyz = r0.xyz * WetDarken.xyz;
	r6.xy = lerp(r4.xy, gWaterGlobals.zw, r2.zz);
	r4.zw = 0.3 * i.texcoord6.xy;
	r7 = tex2D(WaterRainRippleNormalSampler, r4.zw);
	r7.xyz = r7.xyz * 2 + -1;
	r7.xyz = r7.xyz * i.texcoord1.zzz + -r1.xyz;
	r7.xyz = r2.zzz * r7.xyz + r1.xyz;
	r7.xyz = r7.xyz + 1E-05;
	r8 = normalize(r7.xyz);
	r2.w = saturate(gWaterGlobals.y);
	r7.xyz = r0.xyz * WetDarken.xyz + -r0.xyz;
	r7.xyz = r2.www * r7.xyz + r0.xyz;
	r5.xyz = (-r2.zzz >= 0) ? r7.xyz : r5.xyz;
	r7.xyz = (-r2.zzz >= 0) ? r1.xyz : r8.xyz;
	r2.zw = (-r2.zz >= 0) ? r4.xy : r6.xy;
	r1.xyz = (-i.color.yyy >= 0) ? r1.xyz : r7.xyz;
	r0.xyz = (-i.color.yyy >= 0) ? r0.xyz : r5.xyz;
	r2.zw = (-i.color.yy >= 0) ? r4.xy : r2.zw;
	r4.xyz = r1.xxx * i.texcoord4.xyz;
	r4.xyz = r1.zzz * i.texcoord1.xyz + r4.xyz;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r4.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r4.xyz = normalize(r1.xyz);
	r1.x = 0;
	if (-reflectivePower.x < r1.x) {
		r1.x = saturate(r2.w * 0.015625);
		r5.w = r1.x * -4 + 4;
		r1.xyz = 1E-05 + i.texcoord3.xyz;
		r6.xyz = normalize(r1.xyz);
		r1.x = dot(-r6.xyz, r4.xyz);
		r1.x = r1.x + r1.x;
		r1.xyz = r4.xyz * -r1.xxx + -r6.xyz;
		r1.xyz = r1.xyz + 1E-05;
		r7.xyz = normalize(r1.xyz);
		r1.x = saturate(r7.z);
		r1.x = r1.x + 1;
		r1.x = r1.x + r1.x;
		r1.x = 1 / r1.x;
		r1.xy = r7.xy * r1.xx + 0.5;
		r5.xy = -r1.xy + 1;
		r5.z = 0;
		r5 = tex2Dlod(DynamicEnvironmentSampler, r5);
		r1.xyz = r5.xyz * r5.xyz;
		r1.xyz = r1.xyz * 16;
		r3.w = saturate(dot(r6.xyz, r4.xyz));
		r1.w = -r1.w + -fresnelRolloff.x;
		r3.w = -r3.w + 1.00001;
		r4.w = r3.w * r3.w;
		r4.w = r4.w * r4.w;
		r3.w = r3.w * r4.w;
		r1.w = fresnelRolloff.x * r3.w + r1.w;
		r1.xyz = r1.www * r1.xyz;
	} else {
		r1.xyz = 0;
	}
	r1.xyz = r1.xyz * reflectivePower.xxx;
	r1.w = dot(r3.xyz, specMapReflectMask.xyz);
	r1.xyz = r1.www * r1.xyz;
	r1.xyz = r1.xyz * globalScalars.www;
	r1.w = dot(r2.xy, r2.xy) + -0.002;
	r1.w = (r1.w >= 0) ? 1 : 0;
	r0.xyz = r0.xyz * r1.www;
	r2.x = r1.w * i.color.x;
	r1.w = r1.w * r2.z;
	r0.xyz = r0.xyz * r0.xyz;
	r2.y = r0.w * i.color.w;
	r3.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r3.xyz);
	r2.z = saturate(r4.z * -0.5 + 0.5);
	r3.xyz = gLightAmbient0.xyz;
	r3.xyz = -r3.xyz + gLightAmbient1.xyz;
	r3.xyz = r2.zzz * r3.xyz + gLightAmbient0.xyz;
	r3.xyz = r3.xyz * gAmbientOcclusionEffect.yyy;
	r3.xyz = r2.xxx * r3.xyz;
	r2.x = 1 / gAmbientOcclusionEffect.y;
	r2.z = dot(-r5.xyz, r4.xyz);
	r2.z = r2.z + r2.z;
	r5.xyz = r4.xyz * -r2.zzz + -r5.xyz;
	r2.z = dot(r4.xyz, -gDirectionalLight.xyz);
	r3.w = saturate(r2.z + -0.25);
	r3.w = r3.w * 1.3333334;
	r4.x = saturate(dot(-gDirectionalLight.xyz, r5.xyz));
	r4.x = r4.x + 1E-05;
	r2.w = r2.w + 1E-05;
	r5.x = pow(r4.x, r2.w);
	r2.z = saturate(r2.z * 2 + -0.5);
	r2.z = r2.z * r5.x;
	r4.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r4.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r4.xyz;
	r4.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r4.xyz;
	r4.xyz = r4.xyz + gShadowMatrix[3].xyz;
	r5.xy = r4.xy + -gShadowParam18192021.zw;
	r5.zw = r5.xx + -gCascadeXMaxThresholds.xy;
	r5.zw = (r5.zw >= 0) ? 1 : 0;
	r6.xy = -r5.xx + gCascadeXMinThresholds.xy;
	r6.zw = r5.yy + -gCascadeYMaxThresholds.xy;
	r6 = (r6 >= 0) ? 1 : 0;
	r7.xy = -r5.yy + gCascadeYMinThresholds.xy;
	r7.xy = (r7.xy >= 0) ? 1 : 0;
	r5.zw = r5.zw + r6.xy;
	r5.zw = r6.zw + r5.zw;
	r6.yz = saturate(r7.xy + r5.zw);
	r6.x = 1;
	r7.x = dot(r6.xyz, gShadowParam0123.xyz);
	r7.y = dot(r6.xyz, gShadowParam4567.xyz);
	r7.z = dot(r6.xyz, gCascadeZScales.xyz);
	r8.x = dot(r6.xyz, gShadowParam891113.xyz);
	r8.y = dot(r6.xyz, gShadowParam14151617.xyz);
	r8.z = dot(r6.xyz, gCascadeZOffsets.xyz);
	r4.xyz = r4.zxy * r7.zxy + r8.zxy;
	r4.x = saturate(r4.x);
	r6.x = -gCascadeXMinThresholds.w;
	r6.y = -gCascadeXMaxThresholds.w;
	r5.xy = saturate(abs(r5.xy) * 4 + r6.xy);
	r2.w = max(r5.x, r5.y);
	r4.x = -r4.x + 1;
	r5 = tex2D(gShadowZSamplerDir, r4.yz);
	r4.x = r4.x + -r5.x;
	r4.x = (r4.x >= 0) ? -1 : -0;
	r2.w = r2.w + r4.x;
	r2.w = saturate(r2.w + 1);
	r4.xyz = r2.www * gDirectionalColour.xyz;
	r5.xyz = r2.zzz * r4.xyz;
	r4.xyz = r3.www * r4.xyz;
	r5.xyz = r5.xyz * gDirectionalLight.www;
	r2.xzw = r3.xyz * r2.xxx + r4.xyz;
	r0.w = r0.w * i.color.w + -0.01;
	r3.x = 1 / r2.y;
	r0.w = (r0.w >= 0) ? r3.x : 100;
	r1.xyz = r0.www * r1.xyz;
	r0.w = dot(r2.xzw, 0.33333334);
	r0.w = r0.w + 0.015;
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = r5.xyz * r1.www + r1.xyz;
	r0.xyz = r0.xyz * r2.xzw + r1.xyz;
	r1.w = r2.y * globalScalars.x;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r2.x = 1E-05 + i.texcoord9.y;
	r3.x = pow(r0.w, r2.x);
	r2.xyz = r0.xyz * r3.xxx;
	r0.xyz = r0.xyz * -r3.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r2.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r2.x = r2.x * deSatContrastGamma.x;
	r1.xyz = lerp(r0.www, r0.xyz, r2.xxx);
	o = min(r1, float4(8, 8, 8, 1));

	return o;
}
