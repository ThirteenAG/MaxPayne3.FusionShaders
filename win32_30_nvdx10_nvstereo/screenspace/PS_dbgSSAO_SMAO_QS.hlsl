	r1.yz = r1.yz + r1.yz;
	r5.xy = r1.xw + -0.5;
	r6 = tex2D(deferredLightDownsampleDepthSampler, r1.xw);
	r5.yz = r5.xy * gDeferredProjParams.xy;
	r5.x = 0.5;
	r2.yzw = r5.xyz * r6.xxx + -r2.yzw;
