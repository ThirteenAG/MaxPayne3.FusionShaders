sampler2D DiffuseSampler : register(s0);
float SpecExp : register(c52);
float SpecIntensity : register(c53);
float3 SubsurfaceColor : register(c62);
float SubsurfaceIntensity : register(c64);
float SubsurfaceRollOff : register(c63);
float ambientOcclusionContrast : register(c61);
float diffuseMod : register(c49);
float4 gLightColor[4] : register(c39);
float4 gLightPosDir[4] : register(c16);
row_major float4x4 gViewInverse : register(c12);
float rimAmount : register(c60);
float rimPower : register(c59);
float specFresnelExp : register(c55);
float specFresnelMax : register(c57);
float specFresnelMin : register(c56);
float wrapAmount : register(c58);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float4 color : COLOR;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	r0.xyz = gLightPosDir[0].xyz + -i.texcoord2.xyz;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	r1.x = 1 / r0.w;
	r0.xyz = r0.www * r0.xyz;
	r0.w = 1 / gLightPosDir[0].w;
	r1.y = r1.x * r0.w + -1;
	r0.w = saturate(r1.x * -r0.w + 1);
	r0.w = (r1.y >= 0) ? 0 : r0.w;
	r1.xyz = normalize(i.texcoord.xyz);
	r1.w = dot(r1.xyz, r0.xyz);
	r2.xw = float2(1E-05, 1);
	r3.x = lerp(wrapAmount.x, r2.w, r1.w);
	r3.yzw = r3.xxx * gLightColor[0].xyz;
	r3.yzw = r0.www * r3.yzw;
	r3.yzw = r3.yzw * -gLightColor[0].www;
	r3.yzw = (r3.xxx >= 0) ? r3.yzw : 0;
	r2.z = -2;
	r0.w = SubsurfaceRollOff.x * r2.z + r3.x;
	r1.w = 1 / -SubsurfaceRollOff.x;
	r0.w = saturate(r0.w * r1.w);
	r2.y = r0.w * -2 + 3;
	r0.w = r0.w * r0.w;
	r0.w = r0.w * r2.y;
	r2.y = 1 / SubsurfaceRollOff.x;
	r4.x = saturate(r2.y * r3.x);
	r4.y = r4.x * -2 + 3;
	r4.x = r4.x * r4.x;
	r4.x = r4.x * r4.y;
	r5.x = SubsurfaceIntensity.x;
	r4.yzw = r5.xxx * SubsurfaceColor.xyz;
	r5.xyz = r4.xxx * r4.yzw;
	r3.yzw = r5.xyz * r0.www + r3.yzw;
	r5.xyz = gLightPosDir[1].xyz + -i.texcoord2.xyz;
	r0.w = dot(r5.xyz, r5.xyz);
	r0.w = rsqrt(r0.w);
	r5.xyz = r0.www * r5.xyz;
	r0.w = 1 / r0.w;
	r4.x = dot(r1.xyz, r5.xyz);
	r5.w = lerp(wrapAmount.x, r2.w, r4.x);
	r2.z = SubsurfaceRollOff.x * r2.z + r5.w;
	r1.w = saturate(r1.w * r2.z);
	r2.z = r1.w * -2 + 3;
	r1.w = r1.w * r1.w;
	r1.w = r1.w * r2.z;
	r2.y = saturate(r2.y * r5.w);
	r2.z = r2.y * -2 + 3;
	r2.y = r2.y * r2.y;
	r2.y = r2.y * r2.z;
	r2.yzw = r2.yyy * r4.yzw;
	r2.yzw = r2.yzw * r1.www + r3.yzw;
	r1.w = 1 / gLightPosDir[1].w;
	r3.y = r0.w * r1.w + -1;
	r0.w = saturate(r0.w * -r1.w + 1);
	r0.w = (r3.y >= 0) ? 0 : r0.w;
	r3.yzw = r5.www * gLightColor[1].xyz;
	r3.yzw = r0.www * r3.yzw;
	r3.yzw = r3.yzw * -gLightColor[1].www;
	r3.yzw = (r5.www >= 0) ? r3.yzw : 0;
	r4.xyz = r2.yzw + r3.yzw;
	r2.yzw = saturate(r2.yzw * r3.yzw);
	r2.yzw = -r2.yzw + r4.xyz;
	r0.w = 1E-05 + abs(i.color.w);
	r1.w = r2.x + ambientOcclusionContrast.x;
	r3.y = pow(r0.w, r1.w);
	r0.w = r3.y * i.texcoord3.w;
	r3.yzw = r0.www * r2.yzw;
	r2.yzw = r2.yzw * r0.www + i.texcoord3.xyz;
	r3.yzw = saturate(r3.yzw * i.texcoord3.xyz);
	r2.yzw = r2.yzw + -r3.yzw;
	r4.x = 1.8;
	r1.w = r4.x * diffuseMod.x;
	r2.yzw = r1.www * r2.yzw;
	r4.x = i.texcoord.w;
	r4.y = i.texcoord2.w;
	r4 = tex2D(DiffuseSampler, r4.xy);
	r3.yzw = r2.yzw * r4.xyz;
	r6.xyz = gViewInverse[3].xyz + -i.texcoord2.xyz;
	r1.w = dot(r6.xyz, r6.xyz);
	r1.w = rsqrt(r1.w);
	r0.xyz = r6.xyz * r1.www + r0.xyz;
	r7 = normalize(r0.xyz);
	r0.x = saturate(dot(r7.xyz, r1.xyz));
	r0.x = r0.x + 1E-05;
	r0.y = r2.x + SpecExp.x;
	r6.w = pow(r0.x, r0.y);
	r7 = r6.www * gLightColor[0].xyz;
	r0.x = saturate(r3.x * 16);
	r7 = r0.xxx * r7.xyz;
	r7 = (-r3.xxx >= 0) ? 0 : r7.xyz;
	r5.xyz = r6.xyz * r1.www + r5.xyz;
	r6.xyz = r1.www * r6.xyz;
	r0.x = dot(r6.xyz, r1.xyz);
	r6.xyz = normalize(r5.xyz);
	r0.z = saturate(dot(r6.xyz, r1.xyz));
	r0.z = r0.z + 1E-05;
	r1.x = pow(r0.z, r0.y);
	r1.xyz = r1.xxx * gLightColor[1].xyz;
	r0.y = saturate(r5.w * 16);
	r1.xyz = r1.xyz * r0.yyy + r7.xyz;
	r1.xyz = (-r5.www >= 0) ? r7.xyz : r1.xyz;
	r0.y = saturate(abs(r0.x));
	r0.y = -r0.y + 1.00001;
	r0.z = r2.x + specFresnelExp.x;
	r1.w = pow(r0.y, r0.z);
	r3.x = specFresnelMin.x;
	r0.y = -r3.x + specFresnelMax.x;
	r0.y = r1.w * r0.y + specFresnelMin.x;
	r0.z = r4.w * r0.y;
	r0.z = r0.w * r0.z;
	r0.z = r0.z * SpecIntensity.x;
	r1.xyz = r0.zzz * r1.xyz;
	r3.xyz = saturate(r1.xyz * r3.yzw);
	r1.xyz = r4.xyz * r2.yzw + r1.xyz;
	r1.xyz = -r3.xyz + r1.xyz;
	r0.z = -r0.x + 1;
	r0.z = abs(r0.z) + 1E-05;
	r0.z = log2(r0.z);
	r0.x = (r0.x >= 0) ? r0.z : 1.4426878E-05;
	r0.z = r2.x + rimPower.x;
	r0.x = r0.x * r0.z;
	r0.x = exp2(r0.x);
	r0.x = r0.x * rimAmount.x;
	r0.x = r0.w * r0.x;
	r0.z = r0.y * r0.x;
	r0.xyw = r0.xxx * r0.yyy + r1.xyz;
	r1.xyz = saturate(r0.zzz * r1.xyz);
	o.xyz = r0.xyw + -r1.xyz;
	o.w = 1;

	return o;
}
