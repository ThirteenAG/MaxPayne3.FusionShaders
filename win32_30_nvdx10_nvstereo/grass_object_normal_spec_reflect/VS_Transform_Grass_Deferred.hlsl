float4 WindGlobalParams : register(c204);
float4 deSatContrastGamma : register(c46);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorld : register(c0);
row_major float4x4 gWorldViewProj : register(c8);
float g_fCollisionSqScale : register(c205);
float g_fEnableSpringForces : register(c209);
float g_fGrassSpringRigidity : register(c206);
float g_fGrassSpringScale : register(c207);
float2 g_vCollisionParams : register(c73);
float4 g_vCollisionSpheres[5] : register(c210);
float3 g_vPlayerPosition : register(c71);
float4 globalScalars2 : register(c36);
float4 globalUmScalars : register(c48);
float4 umGlobalParams : register(c203);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 texcoord : TEXCOORD;
	float4 tangent : TANGENT;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float3 r3;
	float4 r4;
	r0.x = globalUmScalars.x * i.color1.x;
	r0.xy = r0.xx * umGlobalParams.xx;
	r0.w = 1 + -i.color1.z;
	r1.x = r0.w * globalUmScalars.y;
	r0.z = r1.x * umGlobalParams.y;
	r1.x = 6.2831855 * i.color1.y;
	r1.zw = umGlobalParams.zw;
	r1.yzw = r1.zzw * globalUmScalars.zzw;
	r1.xyz = globalScalars2.yyy * r1.yzw + r1.xxx;
	r1.xyz = r1.xyz * 0.15915494 + 0.25;
	r1.xyz = frac(r1.xyz);
	r1.xyz = r1.xyz * 6.2831855 + -3.1415927;
	r1.xyz = r1.xyz * r1.xyz;
	r2.xyz = r1.yyz * -2.523985E-07 + 2.47609E-05;
	r2.xyz = r1.yyz * r2.xyz + -0.0013888397;
	r2.xyz = r1.yyz * r2.xyz + 0.04166664;
	r2.xyz = r1.yyz * r2.xyz + -0.5;
	r1.xyz = r1.xyz * r2.xyz + 1;
	r0.xyz = r1.xyz * r0.xyz + i.position.xyz;
	r1.x = r0.z * deSatContrastGamma.w;
	r0.w = r0.w * WindGlobalParams.x;
	r0.xy = r1.xx * r0.ww + r0.xy;
	r1.xyz = gWorld[3].xyz;
	r2.xyz = -r1.xyz + g_vPlayerPosition.xyz;
	r3.x = dot(gWorld[0].xyz, r2.xyz);
	r3.y = dot(gWorld[1].xyz, r2.xyz);
	r3.z = dot(gWorld[2].xyz, r2.xyz);
	r2.xyz = r0.xyz + -r3.xyz;
	r0.w = dot(r2.xyz, r2.xyz);
	r0.w = -r0.w + g_vCollisionParams.x;
	r0.w = max(r0.w, 0);
	r2.xyz = r2.xyz + 1E-05;
	r1.w = dot(r2.xyz, r2.xyz);
	r1.w = rsqrt(r1.w);
	r2.xy = r1.ww * r2.xy;
	r2.xy = r2.xy * i.color1.xx;
	r2.xy = r0.ww * r2.xy;
	r2.xy = r2.xy * g_fCollisionSqScale.xx + r0.xy;
	r0.w = 0;
	if (r0.w < g_fEnableSpringForces.x) {
		r0.x = dot(r0.xyz, r0.xyz);
		r0.x = r0.x * 10;
		r0.y = globalScalars2.y;
		r0.x = r0.y * g_fGrassSpringRigidity.x + r0.x;
		r0.x = r0.x * 0.15915494 + 0.5;
		r0.x = frac(r0.x);
		r0.x = r0.x * 6.2831855 + -3.1415927;
		r3.y = sin(r0.x);
		r0.x = r3.y * g_fGrassSpringScale.x;
		r3 = -r1.xyz + g_vCollisionSpheres[0].xyz;
		r4.x = dot(gWorld[0].xyz, r3.xyz);
		r4.y = dot(gWorld[1].xyz, r3.xyz);
		r4.z = dot(gWorld[2].xyz, r3.xyz);
		r2.z = r0.z;
		r3 = r2.xyz + -r4.xyz;
		r0.y = dot(r3.xyz, r3.xyz);
		r0.y = rsqrt(r0.y);
		r0.y = 1 / r0.y;
		r0.y = -r0.y + g_vCollisionSpheres[0].w;
		r0.y = max(r0.y, 0);
		r0.y = r0.y * r0.x;
		r3 = r3.xyz + 1E-05;
		r0.w = dot(r3.xyz, r3.xyz);
		r0.w = rsqrt(r0.w);
		r3.xy = r0.ww * r3.xy;
		r3.xy = r3.xy * i.color1.xx;
		r0.yw = r0.yy * r3.xy;
		r3 = -r1.xyz + g_vCollisionSpheres[1].xyz;
		r4.x = dot(gWorld[0].xyz, r3.xyz);
		r4.y = dot(gWorld[1].xyz, r3.xyz);
		r4.z = dot(gWorld[2].xyz, r3.xyz);
		r3 = r2.xyz + -r4.xyz;
		r1.w = dot(r3.xyz, r3.xyz);
		r1.w = rsqrt(r1.w);
		r1.w = 1 / r1.w;
		r1.w = -r1.w + g_vCollisionSpheres[1].w;
		r1.w = max(r1.w, 0);
		r1.w = r0.x * r1.w;
		r3 = r3.xyz + 1E-05;
		r2.w = dot(r3.xyz, r3.xyz);
		r2.w = rsqrt(r2.w);
		r3.xy = r2.ww * r3.xy;
		r3.xy = r3.xy * i.color1.xx;
		r3.xy = r1.ww * r3.xy;
		r3.xy = r3.xy * g_fCollisionSqScale.xx;
		r0.yw = r0.yw * g_fCollisionSqScale.xx + r3.xy;
		r3 = -r1.xyz + g_vCollisionSpheres[2].xyz;
		r4.x = dot(gWorld[0].xyz, r3.xyz);
		r4.y = dot(gWorld[1].xyz, r3.xyz);
		r4.z = dot(gWorld[2].xyz, r3.xyz);
		r3 = r2.xyz + -r4.xyz;
		r1.w = dot(r3.xyz, r3.xyz);
		r1.w = rsqrt(r1.w);
		r1.w = 1 / r1.w;
		r1.w = -r1.w + g_vCollisionSpheres[2].w;
		r1.w = max(r1.w, 0);
		r1.w = r0.x * r1.w;
		r3 = r3.xyz + 1E-05;
		r2.w = dot(r3.xyz, r3.xyz);
		r2.w = rsqrt(r2.w);
		r3.xy = r2.ww * r3.xy;
		r3.xy = r3.xy * i.color1.xx;
		r3.xy = r1.ww * r3.xy;
		r0.yw = r3.xy * g_fCollisionSqScale.xx + r0.yw;
		r3 = -r1.xyz + g_vCollisionSpheres[3].xyz;
		r4.x = dot(gWorld[0].xyz, r3.xyz);
		r4.y = dot(gWorld[1].xyz, r3.xyz);
		r4.z = dot(gWorld[2].xyz, r3.xyz);
		r3 = r2.xyz + -r4.xyz;
		r1.w = dot(r3.xyz, r3.xyz);
		r1.w = rsqrt(r1.w);
		r1.w = 1 / r1.w;
		r1.w = -r1.w + g_vCollisionSpheres[3].w;
		r1.w = max(r1.w, 0);
		r1.w = r0.x * r1.w;
		r3 = r3.xyz + 1E-05;
		r2.w = dot(r3.xyz, r3.xyz);
		r2.w = rsqrt(r2.w);
		r3.xy = r2.ww * r3.xy;
		r3.xy = r3.xy * i.color1.xx;
		r3.xy = r1.ww * r3.xy;
		r0.yw = r3.xy * g_fCollisionSqScale.xx + r0.yw;
		r1.xyz = -r1.xyz + g_vCollisionSpheres[4].xyz;
		r3.x = dot(gWorld[0].xyz, r1.xyz);
		r3.y = dot(gWorld[1].xyz, r1.xyz);
		r3.z = dot(gWorld[2].xyz, r1.xyz);
		r1.xyz = r2.xyz + -r3.xyz;
		r1.w = dot(r1.xyz, r1.xyz);
		r1.w = rsqrt(r1.w);
		r1.w = 1 / r1.w;
		r1.w = -r1.w + g_vCollisionSpheres[4].w;
		r1.w = max(r1.w, 0);
		r0.x = r0.x * r1.w;
		r1.xyz = r1.xyz + 1E-05;
		r1.z = dot(r1.xyz, r1.xyz);
		r1.z = rsqrt(r1.z);
		r1.xy = r1.zz * r1.xy;
		r1.xy = r1.xy * i.color1.xx;
		r1.xy = r0.xx * r1.xy;
		r0.xy = r1.xy * g_fCollisionSqScale.xx + r0.yw;
		r2.xy = r0.xy + r2.xy;
	}
	r0.xyw = r2.yyy * gWorld[1].xyz;
	r0.xyw = r2.xxx * gWorld[0].xyz + r0.xyw;
	r0.xyw = r0.zzz * gWorld[2].xyz + r0.xyw;
	r0.xyw = r0.xyw + gWorld[3].xyz;
	o.texcoord3 = -r0.xyw + gViewInverse[3].xyz;
	r0.xyw = gWorld[1].xyz * i.normal.yyy;
	r0.xyw = i.normal.xxx * gWorld[0].xyz + r0.xyw;
	r0.xyw = i.normal.zzz * gWorld[2].xyz + r0.xyw;
	r0.xyw = r0.xyw + 1E-05;
	r1.xyz = normalize(r0.xyw);
	r0.xyw = gWorld[1].xyz * i.tangent.yyy;
	r0.xyw = i.tangent.xxx * gWorld[0].xyz + r0.xyw;
	r0.xyw = i.tangent.zzz * gWorld[2].xyz + r0.xyw;
	r0.xyw = r0.xyw + 1E-05;
	r3 = normalize(r0.xyw);
	r0.xyw = r1.yzx * r3.zxy;
	r0.xyw = r3.yzx * r1.zxy + -r0.xyw;
	o.texcoord5 = r0.xyw * i.tangent.www;
	r4 = r2.y * gWorldViewProj[1];
	r2 = r2.x * gWorldViewProj[0] + r4;
	r0 = r0.z * gWorldViewProj[2] + r2;
	r0 = r0 + gWorldViewProj[3];
	r2 = gWorld[1] * i.position.y;
	r2 = i.position.x * gWorld[0] + r2;
	r2 = i.position.z * gWorld[2] + r2;
	o.texcoord6 = r2 + gWorld[3];
	o.position = r0;
	o.color = i.color;
	o.texcoord = i.texcoord.xy;
	o.texcoord1.w = r0.w;
	o.texcoord1.xyz = r1.xyz;
	o.texcoord4 = r3.xyz;

	return o;
}
