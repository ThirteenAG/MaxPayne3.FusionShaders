sampler2D GBufferTextureSampler0 : register(s8);
sampler2D GBufferTextureSampler1 : register(s12);
sampler2D GBufferTextureSampler2 : register(s13);
sampler2D GBufferTextureSamplerDepth : register(s10);
row_major float4x4 dShadowMatrix : register(c197);
float4 dShadowParam0123 : register(c196);
float4 gDeferredLightRadiusProjShearParams : register(c206);
float4 gDeferredProjParams : register(c216);
sampler2D gShadowZSamplerCache : register(s14);
row_major float4x4 gViewInverse : register(c12);
float4 gooDeferredLightScreenSize : register(c215);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float2 vpos : VPOS;
	float4 texcoord1 : TEXCOORD1;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	float4 r5;
	float4 r6;
	float3 r7;
	float4 r8;
	float4 r9;
	float3 r10;
	float4 r11;
	r0.xy = 0.51 + i.vpos.xy;
	r0.xy = r0.xy * gooDeferredLightScreenSize.zw;
	r1 = tex2D(GBufferTextureSamplerDepth, r0.xy);
	r0.z = r1.x * gDeferredProjParams.z + -gDeferredProjParams.w;
	r0.z = r0.z * i.texcoord.w;
	r0.z = 1 / r0.z;
	r1.xyz = i.texcoord.xyz * -r0.zzz + gViewInverse[3].xyz;
	r2.xyz = i.texcoord.xyz * -r0.zzz + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r2 = tex2D(GBufferTextureSampler1, r0.xy);
	r2.xyz = r2.xyz * 2 + -1;
	r4 = normalize(r2.xyz);
	r2.xyz = r4.xyz * 0.1 + r1.xyz;
	r1.xyz = -r1.xyz + i.texcoord2.xyz;
	r5.xyz = r2.yyy * dShadowMatrix[1].xyz;
	r2.xyw = r2.xxx * dShadowMatrix[0].xyz + r5.xyz;
	r2.xyz = r2.zzz * dShadowMatrix[2].xyz + r2.xyw;
	r2.xyz = r2.xyz + dShadowMatrix[3].xyz;
	r2.w = -abs(r2.z);
	r0.z = dot(r2.xyw, r2.xyw);
	r0.z = rsqrt(r0.z);
	r0.z = 1 / r0.z;
	r0.w = abs(r2.z) + r0.z;
	r0.w = 1 / r0.w;
	r2.xy = r0.ww * r2.xy;
	r2.zw = (-r2.zz >= 0) ? float2(1, 0) : float2(0, 1);
	r5.xy = r2.xy * float2(0.5, -0.5);
	r5.zw = r2.yx * float2(-0.5, 0.5) + 0.5;
	r6 = r2.xyxy * float4(0.5, -0.5, 0.5, -0.5) + float4(0.5, 0.5, 0.5, 0);
	r7.yz = dShadowParam0123.yz;
	r2.xy = r7.yy * float2(0, -1) + float2(0.5, 0);
	r2.xy = r2.xy + r5.xz;
	r8 = tex2D(gShadowZSamplerCache, r2.xy);
	r8.y = dot(r8.xy, r2.zw) + 0;
	r2.xy = r6.xy + -dShadowParam0123.yy;
	r9 = tex2D(gShadowZSamplerCache, r2.xy);
	r8.x = dot(r9.xy, r2.zw) + 0;
	r2.xy = r7.yy * float2(1, -1) + r6.xy;
	r9 = tex2D(gShadowZSamplerCache, r2.xy);
	r8.z = dot(r9.xy, r2.zw) + 0;
	r8.xyz = r0.zzz * dShadowParam0123.www + r8.xyz;
	r8.xyz = (r8.xyz >= 0) ? 1 : 0;
	r0.w = 1 / dShadowParam0123.y;
	r2.xy = r0.ww * r6.xy;
	r9.xy = frac(r2.xy);
	r9.zw = r9.xx * float2(-1, 0) + 1;
	r10 = r9.xwx * float3(-1, 1, 1) + float3(1, 0, 0);
	r0.w = dot(r8.xyz, r10.xyz);
	r8 = r7.y * float4(-1, 0, 1, 0) + float4(0, 0.5, 0, 0.5);
	r2.xy = r5.wy + r8.xy;
	r5.yw = r6.zw + r8.zw;
	r8 = tex2D(gShadowZSamplerCache, r5.yw);
	r8.z = dot(r8.xy, r2.zw) + 0;
	r11 = tex2D(gShadowZSamplerCache, r2.xy);
	r8.x = dot(r11.xy, r2.zw) + 0;
	r11 = tex2D(gShadowZSamplerCache, r6.xy);
	r8.y = dot(r11.xy, r2.zw) + 0;
	r8.xyz = r0.zzz * dShadowParam0123.www + r8.xyz;
	r8.xyz = (r8.xyz >= 0) ? 1 : 0;
	r1.w = dot(r8.zxy, r9.xzw);
	r2.x = -r9.y + 1;
	r0.w = r0.w * r2.x + r1.w;
	r2.xy = r7.yy * float2(0, 1) + float2(0.5, 0);
	r2.xy = r2.xy + r5.xz;
	r5 = tex2D(gShadowZSamplerCache, r2.xy);
	r5.y = dot(r5.xy, r2.zw) + 0;
	r2.xy = r7.yy * float2(-1, 1) + r6.xy;
	r6.xy = r6.xy + dShadowParam0123.yy;
	r6 = tex2D(gShadowZSamplerCache, r6.xy);
	r5.z = dot(r6.xy, r2.zw) + 0;
	r6 = tex2D(gShadowZSamplerCache, r2.xy);
	r5.x = dot(r6.xy, r2.zw) + 0;
	r2.xyz = r0.zzz * dShadowParam0123.www + r5.xyz;
	r2.xyz = (r2.xyz >= 0) ? 1 : 0;
	r0.z = dot(r2.xyz, r10.xyz);
	r0.z = r0.z * r9.y + r0.w;
	r0.z = r0.z * 0.33333334;
	r0.w = -r7.z + 1;
	r0.z = r0.z * r0.w + dShadowParam0123.z;
	r0.w = dot(r1.xyz, r1.xyz);
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	r0.w = rsqrt(r0.w);
	r0.w = 1 / r0.w;
	r1.z = -1;
	r0.w = saturate(r0.w * -gDeferredLightRadiusProjShearParams.y + -r1.z);
	r1.xyz = r0.www * i.texcoord4.xyz;
	r0.w = dot(r2.xyz, i.texcoord3.xyz);
	r0.w = saturate(r0.w * i.texcoord1.w + i.texcoord1.z);
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = r0.zzz * r1.xyz;
	r0.z = dot(r3.xyz, r4.xyz);
	r0.z = r0.z + r0.z;
	r3.xyz = r4.xyz * -r0.zzz + r3.xyz;
	r0.z = dot(r2.xyz, r4.xyz);
	r0.w = saturate(dot(r2.xyz, r3.xyz));
	r0.w = r0.w + 1E-05;
	r2 = tex2D(GBufferTextureSampler2, r0.xy);
	r3 = tex2D(GBufferTextureSampler0, r0.xy);
	r3.xyz = r3.xyz * r3.xyz;
	r0.x = r2.y * r2.y;
	r0.x = r0.x * r0.x;
	r0.x = r0.x * 196 + 1E-05;
	r1.w = pow(r0.w, r0.x);
	r0.x = saturate(r0.z);
	r0.y = r0.z + 0.5;
	r0.y = saturate(r0.y * 0.25);
	r0.y = r0.x + r0.y;
	r0.x = saturate(r0.x * 2 + -0.5);
	r0.x = r0.x * r1.w;
	r0.xzw = r0.xxx * r1.xyz;
	r1.xyz = r0.yyy * r1.xyz;
	r0.xyz = r0.xzw * r2.xxx;
	o.xyz = r3.xyz * r1.xyz + r0.xyz;
	o.w = 1;

	return o;
}
