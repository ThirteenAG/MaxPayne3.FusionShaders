sampler2D BumpSampler_layer0 : register(s1);
sampler2D BumpSampler_layer1 : register(s3);
sampler2D BumpSampler_layer2 : register(s5);
sampler2D BumpSampler_layer3 : register(s7);
sampler2D TextureSampler_layer0 : register(s0);
sampler2D TextureSampler_layer1 : register(s2);
sampler2D TextureSampler_layer2 : register(s4);
sampler2D TextureSampler_layer3 : register(s6);
float bumpiness : register(c2);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightAmbientDir0 : register(c72);
float4 gLightAmbientDir1 : register(c73);
float4 globalFogColor : register(c38);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float specularColorFactor : register(c1);
float specularFactor : register(c0);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 color : COLOR;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float3 r3;
	float4 r4;
	float4 r5;
	r0.x = globalScalars.x * globalScalars.x;
	o.w = r0.x * i.texcoord3.w;
	r0 = tex2D(BumpSampler_layer3, i.texcoord.zw);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(BumpSampler_layer2, i.texcoord.zw);
	r0.z = -r1.w + 1;
	r0.z = -r1.x + r0.z;
	r0.zw = (r0.zz >= 0) ? r1.wy : r1.xy;
	r1 = tex2D(BumpSampler_layer0, i.texcoord.xy);
	r1.z = -r1.w + 1;
	r1.z = -r1.x + r1.z;
	r1.xy = (r1.zz >= 0) ? r1.wy : r1.xy;
	r2 = tex2D(BumpSampler_layer1, i.texcoord.zw);
	r1.z = -r2.w + 1;
	r1.z = -r2.x + r1.z;
	r1.zw = (r1.zz >= 0) ? r2.wy : r2.xy;
	r2.xyz = 1 + -i.color.xyz;
	r2.y = r2.y * r2.x;
	r2.w = r2.y * i.color.z;
	r2.y = r2.z * r2.y;
	r1.zw = r1.zw * r2.ww;
	r1.xy = r1.xy * r2.yy + r1.zw;
	r1.z = r2.x * i.color.y;
	r1.w = r2.z * r1.z;
	r1.z = r1.z * i.color.z;
	r0.zw = r0.zw * r1.ww + r1.xy;
	r0.xy = r0.xy * r1.zz + r0.zw;
	r0.xy = r0.xy + -0.5;
	r0.xy = r0.xy * bumpiness.xx;
	r0.xy = r0.xy + r0.xy;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r1.x = max(r0.z, 0);
	r0.z = rsqrt(r1.x);
	r0.z = 1 / r0.z;
	r3 = r0.xxx * i.texcoord5.xyz;
	r0.xzw = i.texcoord2.xyz * r0.zzz + r3.xyz;
	r0.xyz = r0.yyy * i.texcoord6.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r3 = normalize(r0.xyz);
	r0.x = dot(gLightAmbientDir1.xyz, r3.xyz);
	r0.x = saturate(r0.x + gLightAmbientDir0.w);
	r0.xyz = r0.xxx * gLightAmbient1.xyz;
	r0.w = dot(gLightAmbientDir0.xyz, r3.xyz);
	r0.w = saturate(r0.w + gLightAmbientDir0.w);
	r0.xyz = r0.www * gLightAmbient0.xyz + r0.xyz;
	r0.w = dot(r3.xyz, -gDirectionalLight.xyz);
	r0.w = r0.w + -0.25;
	r0.w = saturate(r0.w * 1.3333334);
	r4.xyz = r0.www * gDirectionalColour.xyz;
	r0.xyz = r0.xyz * i.texcoord3.xxx + r4.xyz;
	r4.xyz = 1E-05 + i.texcoord4.xyz;
	r5.xyz = normalize(r4.xyz);
	r0.w = dot(r5.xyz, r3.xyz);
	r0.w = r0.w + r0.w;
	r3 = r3.xyz * -r0.www + r5.xyz;
	r0.w = saturate(dot(-gDirectionalLight.xyz, r3.xyz));
	r0.w = r0.w + 1E-05;
	r1.x = 1E-05;
	r1.x = r1.x + specularFactor.x;
	r2.x = pow(r0.w, r1.x);
	r3 = r2.xxx * gDirectionalColour.xyz;
	r3 = r3.xyz * gDirectionalLight.www;
	r3 = r3.xyz * specularColorFactor.xxx;
	r4 = i.texcoord.zwxx * float4(1, 1, 0, 0) + float4(0, 0, 0, -1.3);
	r5 = tex2Dbias(TextureSampler_layer1, r4);
	r2.xzw = r2.www * r5.xyz;
	r5 = i.texcoord.xyxx * float4(1, 1, 0, 0) + float4(0, 0, 0, -1.3);
	r5 = tex2Dbias(TextureSampler_layer0, r5);
	r2.xyz = r5.xyz * r2.yyy + r2.xzw;
	r5 = tex2Dbias(TextureSampler_layer2, r4);
	r4 = tex2Dbias(TextureSampler_layer3, r4);
	r1.xyw = r5.xyz * r1.www + r2.xyz;
	r1.xyz = r4.xyz * r1.zzz + r1.xyw;
	r0.xyz = r1.xyz * r0.xyz + r3.xyz;
	r0.w = -globalFogParams.x + globalFogParams.y;
	r0.w = 1 / r0.w;
	r1.x = -globalFogParams.x + i.texcoord2.w;
	r0.w = saturate(r0.w * r1.x);
	r1.xyz = lerp(r0.xyz, globalFogColor.xyz, r0.www);
	r0.x = dot(r1.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r0.y = r2.x * deSatContrastGamma.x;
	r2.xyz = lerp(r0.xxx, r1.xyz, r0.yyy);
	r0.xyz = saturate(r2.xyz * 0.0625);
	r0.x = rsqrt(r0.x);
	o.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.z);
	o.z = 1 / r0.y;
	o.y = 1 / r0.x;

	return o;
}
