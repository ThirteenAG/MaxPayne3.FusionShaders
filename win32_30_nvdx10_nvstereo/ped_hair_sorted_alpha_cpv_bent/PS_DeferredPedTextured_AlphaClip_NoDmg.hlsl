sampler2D AnisoNoiseSpecSampler : register(s3);
sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D SpecSampler : register(s2);
sampler3D VolumeSampler : register(s4);
float4 anisotropicSpecularColour : register(c207);
float2 anisotropicSpecularExponent : register(c206);
float2 anisotropicSpecularIntensity : register(c205);
float bumpiness : register(c199);
float4 detailSettings : register(c210);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c204);
float4 specMapExpMask : register(c203);
float3 specMapIntMask : register(c202);
float specularFactor : register(c201);
float4 specularNoiseMapUVScaleFactor : register(c209);
float4 stipplePattern : register(c62);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
	float2 vpos : VPOS;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float4 r6;
	float4 r7;
	float3 r8;
	float3 r9;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.xy = 0.5 * i.vpos.xy;
	r1.xy = frac(abs(r1.xy));
	r1.xy = (i.vpos.xy >= 0) ? r1.xy : -r1.xy;
	r1.xy = r1.xy + r1.xy;
	r1.zw = frac(r1.xy);
	r1.xy = -r1.zw + r1.xy;
	r1.x = r1.y * 2 + r1.x;
	r1 = r1.x + float4(-0, -1, -2, -3);
	r1 = (-abs(r1) >= 0) ? 1 : 0;
	r1.x = dot(stipplePattern, r1);
	r1.x = -r0.w + r1.x;
	r1 = (r1.x >= 0) ? -1 : -0;
	clip(r1);
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r1.z = -r1.w + 1;
	r1.z = -r1.x + r1.z;
	r1.xy = (r1.zz >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r1.z = dot(r1.xy, -r1.xy) + 1;
	r2.x = max(r1.z, 0);
	r1.z = rsqrt(r2.x);
	r1.z = 1 / r1.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r2, specMapExpMask);
	r1.w = r1.w * specularFactor.x;
	r2.x = dot(r2.xyz, specMapIntMask.xyz);
	r2.y = max(1, r1.w);
	r3.xyz = r1.xxx * i.texcoord4.xyz;
	r1.xzw = r1.zzz * i.texcoord1.xyz + r3.xyz;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r1.xzw;
	r1.xyz = r1.xyz + 1E-05;
	r1.w = dot(r1.xyz, r1.xyz);
	r1.w = rsqrt(r1.w);
	r3.xyz = r1.www * r1.xyz;
	r0.w = r0.w * i.texcoord2.w;
	r0.xyz = r0.xyz * matMaterialColorScale.xxx;
	r2.yw = r2.yx * matMaterialColorScale.ww;
	r4.xyz = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r4.xyz = r4.xyz + 1E-05;
	r5 = normalize(r4.xyz);
	r1.xyz = r1.xyz * r1.www + 1E-05;
	r4.xyz = normalize(r1.xyz);
	r1.x = dot(r5.xyz, r4.xyz);
	r1.y = r1.x * 1.5 + 1;
	r1.x = (-r1.x >= 0) ? r1.y : 1;
	r1.y = r1.x * i.texcoord2.y;
	r1.z = saturate(r2.w * 5);
	r1.y = r1.z * r1.y;
	r4.x = r2.y * 0.0051020407;
	r1.z = saturate(r2.y * -0.01 + 1);
	r1.y = r1.y * r1.z;
	r1.x = (r1.x >= 0) ? r1.y : 0;
	r1.x = r2.x * matMaterialColorScale.w + r1.x;
	r1.y = r2.z * 16;
	r1.z = frac(r1.y);
	r1.y = r1.y + -r1.z;
	r1.z = (-r1.z >= 0) ? 0 : 1;
	r1.z = (r2.z >= 0) ? 0 : r1.z;
	r1.y = r1.z + r1.y;
	r2.xy = detailSettings.zw * i.texcoord.xy;
	r1.y = r1.y + 0.5;
	r2.z = r1.y * 0.0625;
	r2 = tex3D(VolumeSampler, r2.xyz);
	r1.yzw = r2.yzx * 2 + -1;
	r2.x = detailSettings.x * i.texcoord2.w;
	r1.w = r1.w * r2.x + 1;
	r2.xyz = r1.zzz * i.texcoord5.xyz;
	r2.xyz = i.texcoord4.xyz * r1.yyy + r2.xyz;
	r2.xyz = r2.xyz * detailSettings.yyy;
	r2.xyz = r2.xyz * i.texcoord2.www + r3.xyz;
	r2.xyz = r2.xyz + 1E-05;
	r3.xyz = normalize(r2.xyz);
	r1.x = saturate(r1.w * r1.x);
	r2.xyz = gViewInverse[3].xyz + -i.texcoord7.xyz;
	r4.yzw = 1E-05 + i.texcoord4.xyz;
	r5 = normalize(r4.yzw);
	r6 = specularNoiseMapUVScaleFactor * i.texcoord.xyxy;
	r7 = tex2D(AnisoNoiseSpecSampler, r6.xy);
	r6 = tex2D(AnisoNoiseSpecSampler, r6.zw);
	r2.xyz = r2.xyz + 1E-05;
	r8 = normalize(r2.xyz);
	r1.z = 1E-05;
	r2.xyz = r1.zzz + gViewInverse[2].xyz;
	r9 = normalize(r2.xyz);
	r1.yz = r6.xy * 2 + -1;
	r2.xyz = r1.yyy * i.texcoord1.xyz;
	r2.xyz = r2.xyz * 0.1 + r5.xyz;
	r2.xyz = r2.xyz + 1E-05;
	r6.xyz = normalize(r2.xyz);
	r1.y = dot(r8.xyz, r6.xyz);
	r2.x = dot(r9.xyz, r6.xyz);
	r2.y = r1.y * -r1.y + 1;
	r3.w = max(r2.y, 0);
	r2.y = rsqrt(r3.w);
	r2.y = 1 / r2.y;
	r2.z = r2.x * -r2.x + 1;
	r3.w = max(r2.z, 0);
	r2.z = rsqrt(r3.w);
	r2.z = 1 / r2.z;
	r1.y = r1.y * r2.x;
	r1.y = r2.y * r2.z + -r1.y;
	r1.y = abs(r1.y) + 1E-05;
	r2.xy = float2(8.00001, 16.00001);
	r2.xy = r2.xy + anisotropicSpecularExponent.xy;
	r3.w = pow(r1.y, r2.x);
	r2.xzw = i.texcoord1.xyz * r1.zzz + r5.xyz;
	r2.xzw = r2.xzw + 1E-05;
	r5 = normalize(r2.xzw);
	r1.y = dot(r8.xyz, r5.xyz);
	r1.z = dot(r9.xyz, r5.xyz);
	r2.x = r1.y * -r1.y + 1;
	r4.y = max(r2.x, 0);
	r2.x = rsqrt(r4.y);
	r2.x = 1 / r2.x;
	r2.z = r1.z * -r1.z + 1;
	r4.y = max(r2.z, 0);
	r2.z = rsqrt(r4.y);
	r2.z = 1 / r2.z;
	r1.y = r1.z * r1.y;
	r1.y = r2.x * r2.z + -r1.y;
	r1.y = abs(r1.y) + 1E-05;
	r4.y = pow(r1.y, r2.y);
	r1.y = r3.w + r4.y;
	r1.x = r1.y * r1.x;
	r2.w = 0.2;
	r1.y = r2.w + anisotropicSpecularIntensity.x;
	r1.x = r1.y * r1.x;
	o.color2.x = r7.x * r1.x;
	r1.xyz = r4.yyy * anisotropicSpecularColour.xyz;
	r1.xyz = r1.xyz * 0.5;
	r0.xyz = r0.xyz * r1.www + r1.xyz;
	r1.x = 1.5 * i.texcoord2.x;
	o.color.xyz = r0.xyz * r1.xxx;
	r0.x = saturate(r0.w * 1.7);
	r0.y = saturate(gAmbientOcclusionEffect.z);
	r0.y = saturate(r0.y + i.texcoord2.x);
	o.color1.xyz = r3.xyz * 0.5 + 0.5;
	r4.x = saturate(r4.x);
	r0.z = rsqrt(r4.x);
	r0.z = 1 / r0.z;
	r0.z = rsqrt(r0.z);
	o.color2.y = 1 / r0.z;
	o.color2.z = r0.y * gAmbientOcclusionEffect.w;
	r0.x = r0.x * globalScalars.x;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	r0.zw = float2(1, 0);
	o.color3 = r0.wwwz * gStencil.x;

	return o;
}
