float CloudBias : register(c147);
float4 CloudColor : register(c143);
float CloudFadeOut : register(c148);
float CloudInscatteringRange : register(c158);
float CloudShadowStrength : register(c155);
float4 CloudThicknessEdgeSmoothDetailScaleStrength : register(c157);
float CloudThreshold : register(c146);
sampler2D GalaxySampler : register(s5);
float HDRExposure : register(c173);
float3 HDRExposureClamp : register(c175);
float3 HDRSunExposure : register(c174);
sampler2D HighDetailNoiseSampler : register(s7);
sampler2D PerlinNoiseSampler : register(s6);
float4 StarFieldBrightness : register(c159);
float3 SunCentre : register(c130);
float3 SunColor : register(c135);
float4 SunDirection : register(c132);
float SunSize : register(c171);
float4 SunsetColor : register(c144);
float4 TopCloudBiasDetailThresholdHeight : register(c152);
float3 TopCloudColor : register(c153);
float3 gtaSkyDomeFade : register(c137);
float3 gtaWaterColor : register(c138);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord3 : TEXCOORD3;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0.w = SunDirection.w;
	r0.x = saturate(r0.w + 0.6);
	r1.yz = float2(0.9375, 0.5);
	r2.xy = float2(1E-05, 1);
	r0.y = saturate(r2.y + -HDRSunExposure.y);
	r1.x = r0.y * -11.616372;
	r3.xyz = 1E-05 + i.texcoord1.xyz;
	r4.xyz = normalize(r3.xyz);
	r3.y = dot(r4.xyz, SunDirection.xyz);
	r4.x = 4;
	r0.z = saturate(r4.y * r4.x + -CloudFadeOut.x);
	r3.x = r0.y * r3.y;
	r1.xyz = saturate(r3.xyy * float3(12.58, -0.0625, 0.5) + r1.xyz);
	r0.yw = r1.xy + 1E-05;
	r1.x = pow(r0.y, 32.00001);
	r1.y = pow(r0.w, 3.00001);
	r0.x = r1.y * -r0.x + r1.x;
	r0.x = r1.z * SunSize.x + r0.x;
	r0.y = saturate(r1.z * SunCentre.y + SunCentre.x);
	r0.x = saturate(r0.x * 0.5);
	r0.w = r0.y * r0.y;
	r0.y = r0.y * -2 + 3;
	r0.y = r0.y * r0.w;
	r0.y = r0.y * SunCentre.z;
	r0.x = r0.x * 4 + r0.y;
	r1.xyz = r0.xxx * SunColor.xyz;
	r1.xyz = abs(r1.xyz) + 1E-05;
	r4.x = log2(r1.x);
	r4.y = log2(r1.y);
	r4.z = log2(r1.z);
	r1.xyz = r4.xyz * 4.00001;
	r4.x = exp2(r1.x);
	r4.y = exp2(r1.y);
	r4.z = exp2(r1.z);
	r1.xyz = r0.xxx * SunColor.xyz + r4.xyz;
	r0.x = saturate(-r0.x + 1);
	r0.x = r0.x * HDRSunExposure.x;
	r0.xyw = saturate(r0.xxx * i.texcoord5.xyz);
	r0.xyw = r1.xyz * HDRSunExposure.xxx + r0.xyw;
	r1 = tex2D(GalaxySampler, i.texcoord3.zw);
	r0.xyw = r1.xyz * StarFieldBrightness.yyy + r0.xyw;
	r1.x = r3.y * 0.25 + 0.35;
	r1.y = r3.y * r3.y;
	r1.zw = CloudThicknessEdgeSmoothDetailScaleStrength.zz * i.texcoord2.xy;
	r3 = tex2D(HighDetailNoiseSampler, r1.zw);
	r1.z = r3.x * CloudThicknessEdgeSmoothDetailScaleStrength.w;
	r3 = tex2D(PerlinNoiseSampler, i.texcoord2.xy);
	r1.z = r1.z * 0.2 + r3.x;
	r3.x = CloudThreshold.x;
	r1.z = r3.x * r1.z + -CloudBias.x;
	r1.z = saturate(r1.z * CloudShadowStrength.x);
	r1.w = -r1.z + 1;
	r2.x = r2.x + CloudThicknessEdgeSmoothDetailScaleStrength.x;
	r4 = tex2D(PerlinNoiseSampler, i.texcoord.xy);
	r5 = tex2D(HighDetailNoiseSampler, i.texcoord2.zw);
	r2.z = r5.x + -0.5;
	r2.w = r2.z * CloudThicknessEdgeSmoothDetailScaleStrength.w + r4.x;
	r3.y = saturate(r2.z * 0.2 + r4.z);
	r2.z = r2.z * CloudThicknessEdgeSmoothDetailScaleStrength.w;
	r2.w = saturate(r3.x * r2.w + -CloudBias.x);
	r3.x = r2.w + 1E-05;
	r2.w = saturate(r2.w * CloudThicknessEdgeSmoothDetailScaleStrength.y);
	r4.x = pow(r3.x, r2.x);
	r2.x = r2.w * r4.x;
	r2.w = r4.x * -r2.w + 1;
	r1.w = r1.w * r2.x;
	r1.w = r1.w * r3.y + r3.y;
	r1.x = r1.x * r1.w;
	r1.w = r1.z * -0.5 + r2.w;
	r3.x = max(r1.w, 0);
	r1.y = r1.y * r3.x;
	r1.y = r1.y * CloudInscatteringRange.x + r2.y;
	r1.yzw = saturate(r1.yyy * CloudColor.xyz + -r1.zzz);
	r1.xyz = SunsetColor.xyz * r1.xxx + r1.yzw;
	r3 = tex2D(PerlinNoiseSampler, i.texcoord4.xy);
	r1.w = r2.z * TopCloudBiasDetailThresholdHeight.y + r3.y;
	r1.w = saturate(TopCloudBiasDetailThresholdHeight.z * r1.w + -TopCloudBiasDetailThresholdHeight.x);
	r1.w = r1.w * i.texcoord4.z;
	r1.w = r2.w * r1.w;
	r2.x = r2.w * r1.w + r2.x;
	r2.yzw = lerp(r1.xyz, TopCloudColor.xyz, r1.www);
	r0.z = r0.z * r2.x;
	r1.xyz = half3(lerp(r0.xyw, r2.yzw, r0.zzz));
	r0.xyz = r1.xyz * HDRExposure.xxx;
	r1.xyz = min(r0.xyz, HDRExposureClamp.xyz);
	r0.xyz = min(HDRExposureClamp.xyz, r1.xyz);
	r1.xyz = r0.xyz + -1;
	r2.xyz = abs(r0.xyz) + 1E-05;
	r3.x = log2(r2.x);
	r3.y = log2(r2.y);
	r3.z = log2(r2.z);
	r2.xyz = r3.xyz * 0.25001;
	r3.x = exp2(r2.x);
	r3.y = exp2(r2.y);
	r3.z = exp2(r2.z);
	r0.xyz = (r1.xyz >= 0) ? r0.xyz : r3.xyz;
	r1.xyz = -r0.xyz + gtaWaterColor.xyz;
	r0.w = gtaSkyDomeFade.x + -i.texcoord1.y;
	r0.w = saturate(r0.w * gtaSkyDomeFade.y);
	o.xyz = r0.www * r1.xyz + r0.xyz;
	o.w = 1;

	return o;
}
