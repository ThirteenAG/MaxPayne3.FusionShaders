sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
sampler2D SpecSampler : register(s2);
float bumpiness : register(c201);
float4 deSatContrastGamma : register(c46);
float fresnelRolloff : register(c203);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float reflectivePower : register(c202);
float4 specMapExpMask : register(c200);
float3 specMapIntMask : register(c199);
float3 specMapReflectMask : register(c204);
float specularFactor : register(c198);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float4 r10;
	float4 r11;
	float4 r12;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.z, 0);
	r0.z = rsqrt(r2.x);
	r0.z = 1 / r0.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r2, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r2.w = dot(r2.xyz, specMapIntMask.xyz);
	r3.x = max(1, r0.w);
	r3.yzw = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r3.yzw;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r4.xyz = normalize(r0.xyz);
	r0.xw = float2(1, 0);
	if (-reflectivePower.x < r0.w) {
		r0.y = saturate(r3.x * 0.015625);
		r5.w = r0.y * -4 + 4;
		r0.yzw = 1E-05 + i.texcoord3.xyz;
		r6.xyz = normalize(r0.yzw);
		r0.y = dot(-r6.xyz, r4.xyz);
		r0.y = r0.y + r0.y;
		r0.yzw = r4.xyz * -r0.yyy + -r6.xyz;
		r0.yzw = r0.yzw + 1E-05;
		r7.xyz = normalize(r0.yzw);
		r0.y = saturate(r7.z);
		r0.y = r0.y + 1;
		r0.y = r0.y + r0.y;
		r0.y = 1 / r0.y;
		r0.yz = r7.xy * r0.yy + 0.5;
		r5.xy = -r0.yz + 1;
		r5.z = 0;
		r5 = tex2Dlod(DynamicEnvironmentSampler, r5);
		r0.yzw = r5.xyz * r5.xyz;
		r0.yzw = r0.yzw * 16;
		r3.y = saturate(dot(r6.xyz, r4.xyz));
		r3.z = r0.x + -fresnelRolloff.x;
		r3.y = -r3.y + 1.00001;
		r3.w = r3.y * r3.y;
		r3.w = r3.w * r3.w;
		r3.y = r3.w * r3.y;
		r3.y = fresnelRolloff.x * r3.y + r3.z;
		r0.yzw = r0.yzw * r3.yyy;
	} else {
		r0.yzw = 0;
	}
	r0.yzw = r0.yzw * reflectivePower.xxx;
	r2.x = dot(r2.xyz, specMapReflectMask.xyz);
	r0.yzw = r0.yzw * r2.xxx;
	r0.yzw = r0.yzw * globalScalars.www;
	r1.xyz = r1.xyz * r1.xyz;
	r2.x = r1.w * i.color.w;
	r3.yzw = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r3.yzw);
	r2.y = saturate(r4.z * -0.5 + 0.5);
	r6.xyz = gLightAmbient0.xyz;
	r3.yzw = -r6.xyz + gLightAmbient1.xyz;
	r3.yzw = r2.yyy * r3.yzw + gLightAmbient0.xyz;
	r3.yzw = r3.yzw * gAmbientOcclusionEffect.yyy;
	r3.yzw = r3.yzw * i.color.xxx;
	r2.y = 1 / gAmbientOcclusionEffect.y;
	r2.z = dot(-r5.xyz, r4.xyz);
	r2.z = r2.z + r2.z;
	r5.xyz = r4.xyz * -r2.zzz + -r5.xyz;
	r2.z = dot(r4.xyz, -gDirectionalLight.xyz);
	r4.w = saturate(r2.z + -0.25);
	r4.w = r4.w * 1.3333334;
	r5.w = saturate(dot(-gDirectionalLight.xyz, r5.xyz));
	r5.w = r5.w + 1E-05;
	r6.x = r3.x + 1E-05;
	r7.x = pow(r5.w, r6.x);
	r2.z = saturate(r2.z * 2 + -0.5);
	r2.z = r2.z * r7.x;
	r6.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r6.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r6.xyz;
	r6.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r6.xyz;
	r6.xyz = r6.xyz + gShadowMatrix[3].xyz;
	r7.xy = r6.xy + -gShadowParam18192021.zw;
	r7.zw = r7.xx + -gCascadeXMaxThresholds.xy;
	r7.zw = (r7.zw >= 0) ? 1 : 0;
	r8.xy = -r7.xx + gCascadeXMinThresholds.xy;
	r8.zw = r7.yy + -gCascadeYMaxThresholds.xy;
	r8 = (r8 >= 0) ? 1 : 0;
	r9.xy = -r7.yy + gCascadeYMinThresholds.xy;
	r9.xy = (r9.xy >= 0) ? 1 : 0;
	r7.zw = r7.zw + r8.xy;
	r7.zw = r8.zw + r7.zw;
	r8.yz = saturate(r9.xy + r7.zw);
	r8.x = 1;
	r9.x = dot(r8.xyz, gShadowParam0123.xyz);
	r9.y = dot(r8.xyz, gShadowParam4567.xyz);
	r9.z = dot(r8.xyz, gCascadeZScales.xyz);
	r10.x = dot(r8.xyz, gShadowParam891113.xyz);
	r10.y = dot(r8.xyz, gShadowParam14151617.xyz);
	r10.z = dot(r8.xyz, gCascadeZOffsets.xyz);
	r6.xyz = r6.zxy * r9.zxy + r10.zxy;
	r6.x = saturate(r6.x);
	r8.x = -gCascadeXMinThresholds.w;
	r8.y = -gCascadeXMaxThresholds.w;
	r7.xy = saturate(abs(r7.xy) * 4 + r8.xy);
	r5.w = max(r7.x, r7.y);
	r6.x = -r6.x + 1;
	r7 = tex2D(gShadowZSamplerDir, r6.yz);
	r6.x = r6.x + -r7.x;
	r6.x = (r6.x >= 0) ? -1 : -0;
	r5.w = r5.w + r6.x;
	r5.w = saturate(r5.w + 1);
	r6.xyz = r5.www * gDirectionalColour.xyz;
	r7.xyz = r2.zzz * r6.xyz;
	r6.xyz = r4.www * r6.xyz;
	r3.yzw = r3.yzw * r2.yyy + r6.xyz;
	r6 = gLightPosX + -i.texcoord6.x;
	r8 = gLightPosY + -i.texcoord6.y;
	r9 = gLightPosZ + -i.texcoord6.z;
	r10 = r6 * r6;
	r10 = r8 * r8 + r10;
	r10 = r9 * r9 + r10;
	r11 = r10 + 1E-05;
	r12.x = rsqrt(r11.x);
	r12.y = rsqrt(r11.y);
	r12.z = rsqrt(r11.z);
	r12.w = rsqrt(r11.w);
	r6 = r6 * r12;
	r8 = r8 * r12;
	r9 = r9 * r12;
	r10 = saturate(r10 * -gLightFallOff + r0.x);
	r10 = r10 * r10;
	r10 = r10 * r10 + -0.1;
	r11 = r10 * 1.1111112;
	r10 = (r10 >= 0) ? r11 : 0;
	r11 = r4.x * r6;
	r11 = r8 * r4.y + r11;
	r4 = r9 * r4.z + r11;
	r4 = saturate(r10 * r4);
	r10 = r6 * -gLightDirX;
	r10 = r8 * -gLightDirY + r10;
	r10 = r9 * -gLightDirZ + r10;
	r11 = gLightConeScale;
	r10 = saturate(r10 * r11 + gLightConeOffset);
	r4 = r4 * r10;
	r6 = r5.x * r6;
	r6 = r5.y * r8 + r6;
	r5 = saturate(r5.z * r9 + r6);
	r5 = r5 + 1E-05;
	r0.x = r3.x * 0.25 + 1E-05;
	r6.x = log2(r5.x);
	r6.y = log2(r5.y);
	r6.z = log2(r5.z);
	r6.w = log2(r5.w);
	r5 = r0.x * r6;
	r6.x = exp2(r5.x);
	r6.y = exp2(r5.y);
	r6.z = exp2(r5.z);
	r6.w = exp2(r5.w);
	r5 = r4 * r6;
	r6.x = dot(gLightColR, r4);
	r6.y = dot(gLightColG, r4);
	r6.z = dot(gLightColB, r4);
	r4.x = dot(gLightColR, r5);
	r4.y = dot(gLightColG, r5);
	r4.z = dot(gLightColB, r5);
	r3.xyz = r3.yzw + r6.xyz;
	r4.xyz = r7.xyz * gDirectionalLight.www + r4.xyz;
	r0.x = r1.w * i.color.w + -0.01;
	r1.w = 1 / r2.x;
	r0.x = (r0.x >= 0) ? r1.w : 100;
	r0.xyz = r0.xxx * r0.yzw;
	r0.w = dot(r3.xyz, 0.33333334);
	r0.w = r0.w + 0.015;
	r0.xyz = r0.www * r0.xyz;
	r0.xyz = r4.xyz * r2.www + r0.xyz;
	r0.xyz = r1.xyz * r3.xyz + r0.xyz;
	r1.w = r2.x * globalScalars.x;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r2.x = 1E-05 + i.texcoord9.y;
	r3.x = pow(r0.w, r2.x);
	r2.xyz = r0.xyz * r3.xxx;
	r0.xyz = r0.xyz * -r3.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r2.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r2.x = r2.x * deSatContrastGamma.x;
	r1.xyz = lerp(r0.www, r0.xyz, r2.xxx);
	o = min(r1, float4(8, 8, 8, 1));

	return o;
}
