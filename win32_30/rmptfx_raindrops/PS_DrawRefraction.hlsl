sampler2D DiffuseTexSampler : register(s0);
sampler2D FrameMapTexSampler : register(s1);
sampler2D NormalMapTexSampler : register(s2);
float SpecularPower : register(c108);
float gBlurAmount : register(c105);
float gDiffuse : register(c102);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float gLightIntensityClamp : register(c101);
float gNormalArc : register(c98);
float gNormalHeight : register(c107);
float gRefraction : register(c106);
float gShadowAmount : register(c109);
float4 globalScreenSize : register(c41);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float2 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0.x = i.texcoord3.z * 0.15915494 + 0.5;
	r0.x = frac(r0.x);
	r0.x = r0.x * 6.2831855 + -3.1415927;
	sincos(r0.x, r1.y, r1.x);
	r0 = tex2D(NormalMapTexSampler, i.texcoord2.xy);
	r0.xyz = r0.xyz * 2 + -1;
	r0.w = r1.y * r0.y;
	r2.x = r0.x * r1.x + -r0.w;
	r2.y = dot(r0.xy, r1.yx) + 0;
	r0.w = 10;
	r0.x = r0.w * gRefraction.x;
	r0.yw = r0.xx * r2.xy;
	r1.x = r0.z * gNormalHeight.x;
	r2.z = r0.z;
	r1.yzw = r0.xxx * r2.xyz;
	r0.x = 1E-05;
	r1.yzw = r1.yzw * gNormalHeight.xxx + r0.xxx;
	r2.xyz = normalize(r1.yzw);
	r0.z = dot(r2.xyz, -gDirectionalLight.xyz);
	r1.y = max(r0.z, -gLightIntensityClamp.x);
	r0.z = min(gLightIntensityClamp.x, r1.y);
	r0.yw = r0.yw * r1.xx;
	r0.y = r0.y * globalScreenSize.z;
	r1.xy = 1 + i.texcoord3.xy;
	r2.x = r1.x * 0.5 + r0.y;
	r0.y = r1.y * -0.5 + 1;
	r2.y = r0.w * globalScreenSize.w + r0.y;
	r1 = tex2D(FrameMapTexSampler, r2.xy);
	r3.x = gBlurAmount.x;
	r4 = r3.x * float4(-0.00326212, -0.0040581, -0.00695914, 0.00457137) + r2.xyxy;
	r5 = tex2D(FrameMapTexSampler, r4.xy);
	r4 = tex2D(FrameMapTexSampler, r4.zw);
	r1.xyz = r1.xyz + r5.xyz;
	r1.xyz = r4.xyz + r1.xyz;
	r4 = r3.x * float4(-0.00203345, 0.00620716, 0.0096234, -0.00194983) + r2.xyxy;
	r5 = tex2D(FrameMapTexSampler, r4.xy);
	r4 = tex2D(FrameMapTexSampler, r4.zw);
	r1.xyz = r1.xyz + r5.xyz;
	r1.xyz = r4.xyz + r1.xyz;
	r4 = r3.x * float4(0.00519456, 0.00767022, 0.00185461, -0.00893124) + r2.xyxy;
	r2 = r3.x * float4(0.0089642, 0.00412458, -0.00791559, -0.0059771) + r2.xyxy;
	r3 = tex2D(FrameMapTexSampler, r4.xy);
	r4 = tex2D(FrameMapTexSampler, r4.zw);
	r1.xyz = r1.xyz + r3.xyz;
	r1.xyz = r4.xyz + r1.xyz;
	r3 = tex2D(FrameMapTexSampler, r2.xy);
	r2 = tex2D(FrameMapTexSampler, r2.zw);
	r1.xyz = r1.xyz + r3.xyz;
	r1.xyz = r2.xyz + r1.xyz;
	r1.xyz = r1.xyz * i.texcoord.xyz;
	r0.y = -r0.z + 1;
	r0.y = gNormalArc.x * r0.y + r0.z;
	r0.z = abs(r0.y) + 1E-05;
	r0.y = r0.y * gDirectionalColour.x;
	r0.y = r0.y * gShadowAmount.x;
	r1.w = min(r0.y, 0);
	r0.x = r0.x + SpecularPower.x;
	r2.x = pow(r0.z, r0.x);
	r0.x = r2.x * gDirectionalColour.x;
	r0.x = r0.x * gDiffuse.x;
	r0.xyz = r1.xyz * 0.125 + r0.xxx;
	r0.xyz = r1.www + r0.xyz;
	r1 = tex2D(DiffuseTexSampler, i.texcoord1.xy);
	r2 = tex2D(DiffuseTexSampler, i.texcoord1.zw);
	r1.x = saturate(i.texcoord3.x);
	r3.x = lerp(r1.w, r2.w, r1.x);
	r0.w = saturate(r3.x * i.texcoord.w);
	o = max(r0, 0);

	return o;
}
