float HybridAdd : register(c197);
float4 NearFarPlane : register(c128);
float4 gActiveUnit : register(c200);
float4 gAspectRatio : register(c17);
float gBiasToCamera : register(c202);
float4 gInterpolationFactor : register(c217);
float4 gPositionOffset : register(c218);
float4 gPositionScale : register(c219);
float gScaleFade : register(c212);
float gSuperAlpha : register(c210);
float4 gTextureAngleRads : register(c216);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars4 : register(c51);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
	float4 texcoord6 : TEXCOORD6;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	r0.x = abs(gViewInverse[2].z);
	r0.y = r0.x * -0.0187293 + 0.074261;
	r0.y = r0.y * r0.x + -0.2121144;
	r0.y = r0.y * r0.x + 1.5707288;
	r0.x = -r0.x + 1;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * r0.y;
	r0.y = r0.x * -2 + 3.1415927;
	r0.z = (gViewInverse[2].z < -gViewInverse[2].z) ? 1 : 0;
	r0.x = r0.y * r0.z + r0.x;
	r0.x = -r0.x + 1.5707964;
	r0 = abs(r0.x) + -gTextureAngleRads;
	r0 = r0 * 0.15915494 + 0.5;
	r0 = frac(r0);
	r0 = r0 * 6.2831855 + -3.1415927;
	r0 = r0 * r0;
	r1 = r0 * -2.523985E-07 + 2.47609E-05;
	r1 = r0 * r1 + -0.0013888397;
	r1 = r0 * r1 + 0.04166664;
	r1 = r0 * r1 + -0.5;
	r0 = r0 * r1 + 1;
	r0 = abs(r0) + 1E-05;
	r1.x = log2(r0.x);
	r1.y = log2(r0.y);
	r1.z = log2(r0.z);
	r1.w = log2(r0.w);
	r0.y = 1E-05;
	r2 = r0.y + gInterpolationFactor;
	r1 = r1 * r2;
	r2.x = exp2(r1.x);
	r2.y = exp2(r1.y);
	r2.z = exp2(r1.z);
	r2.w = exp2(r1.w);
	r0 = r2 * gActiveUnit + r0.y;
	r1.x = dot(r0, r0);
	r1.x = rsqrt(r1.x);
	r0 = r0 * r1.x;
	r1.x = dot(r0, gPositionScale);
	r2.z = dot(r0, gPositionOffset);
	o.texcoord6 = r0;
	r2.xy = 0;
	r0.x = 0.1;
	r0.x = r0.x * gBiasToCamera.x;
	r1.yzw = lerp(i.position.xyz, gViewInverse[3].xyz, r0.xxx);
	r0.xyz = r2.xyz + r1.yzw;
	r2 = r0.y * gWorldViewProj[1];
	r2 = r0.x * gWorldViewProj[0] + r2;
	r0 = r0.z * gWorldViewProj[2] + r2;
	r0 = r0 + gWorldViewProj[3];
	r2.x = r0.w + -NearFarPlane.x;
	r2.y = 1 / gScaleFade.x;
	r2.x = saturate(r2.y * r2.x);
	r2.y = (1E-06 >= i.color.w) ? 1 : 0;
	r2.x = r2.y * -r2.x + r2.x;
	r3 = r2.x * i.normal.xyxy;
	r2.x = r2.x * i.color.w;
	o.texcoord.w = saturate(r2.x * gSuperAlpha.x);
	r2 = r1.x * r3;
	r1.x = i.normal.z * 0.15915494 + 0.5;
	r1.x = frac(r1.x);
	r1.x = r1.x * 6.2831855 + -3.1415927;
	sincos(r1.x, r3.y, r3.x);
	r2.yzw = r2.yzw * r3.yyx;
	r3.x = r2.x * r3.x + -r2.y;
	r3.y = r2.w + r2.z;
	r3.zw = 0;
	o.position = r3 * gAspectRatio + r0;
	o.texcoord3.y = r0.w;
	r0.xyz = r1.yzw + -gViewInverse[3].xyz;
	r0.w = r0.z * globalFogParams.x;
	r0.x = dot(r0.xyz, r0.xyz);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * globalFogParams.z;
	r0.y = r0.w * -1.442695;
	r0.y = exp2(r0.y);
	r0.y = -r0.y + 1;
	r0.z = 1 / r0.w;
	r0.w = (0.0001 < abs(r0.w)) ? 1 : 0;
	r0.y = r0.z * r0.y;
	r0.y = r0.x * r0.y + -r0.x;
	r0.x = r0.w * r0.y + r0.x;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = exp2(r0.x);
	o.texcoord4.w = -r0.x + 1;
	r0.z = 0.5;
	r0.x = (r0.z < HybridAdd.x) ? 1 : 0;
	o.texcoord3.z = r0.x * -i.texcoord3.x + 1;
	r0.x = globalScalars4.x * i.texcoord3.y;
	o.texcoord.xyz = r0.xxx * i.color.xyz;
	r0 = r1.z * gWorldView[1];
	r0 = r1.y * gWorldView[0] + r0;
	r0 = r1.w * gWorldView[2] + r0;
	o.texcoord7 = r0 + gWorldView[3];
	o.texcoord1 = i.texcoord;
	o.texcoord3.x = i.texcoord2.z;
	o.texcoord3.w = i.texcoord3.y;
	o.texcoord4.xyz = globalFogColorN.xyz;

	return o;
}
