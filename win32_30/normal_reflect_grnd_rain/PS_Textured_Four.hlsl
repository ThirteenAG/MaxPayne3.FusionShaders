struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float3 r8;
	float3 r9;
	r0.xy = 0.3 * i.texcoord6.xy;
	r0 = tex2D(WaterRainRippleNormalSampler, r0.xy);
	r0.xyz = r0.xyz * 2 + -1;
	r1 = tex2D(BumpSampler, i.texcoord.xy);
	r0.w = -r1.w + 1;
	r0.w = -r1.x + r0.w;
	r1.xy = (r0.ww >= 0) ? r1.wy : r1.xy;
	r1.xy = r1.xy * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r0.w = dot(r1.xy, -r1.xy) + 1;
	r1.w = max(r0.w, 0);
	r0.w = rsqrt(r1.w);
	r1.z = 1 / r0.w;
	r0.xyz = r0.xyz * i.texcoord1.zzz + -r1.xyz;
	r2.xy = WetDarken.ww * i.texcoord6.xy;
	r2 = tex2D(PuddleMaskSampler, r2.xy);
	r0.w = r2.x + gWaterGlobals.y;
	r0.w = saturate(r0.w + -i.color.y);
	r0.xyz = r0.www * r0.xyz + r1.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r2.xyz = normalize(r0.xyz);
	r0.xyz = (-r0.www >= 0) ? r1.xyz : r2.xyz;
	r0.xyz = (-i.color.yyy >= 0) ? r1.xyz : r0.xyz;
	r1.xyz = r0.xxx * i.texcoord4.xyz;
	r1.xyz = r0.zzz * i.texcoord1.xyz + r1.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r1.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r2 = gLightPosX + -i.texcoord6.x;
	r3 = r2 * r2;
	r4 = gLightPosY + -i.texcoord6.y;
	r3 = r4 * r4 + r3;
	r5 = gLightPosZ + -i.texcoord6.z;
	r3 = r5 * r5 + r3;
	r6 = r3 + 1E-05;
	r0.x = 1;
	r3 = saturate(r3 * -gLightFallOff + r0.x);
	r3 = r3 * r3;
	r3 = r3 * r3 + -0.1;
	r7.x = rsqrt(r6.x);
	r7.y = rsqrt(r6.y);
	r7.z = rsqrt(r6.z);
	r7.w = rsqrt(r6.w);
	r2 = r2 * r7;
	r6 = r1.x * r2;
	r4 = r4 * r7;
	r5 = r5 * r7;
	r6 = r4 * r1.y + r6;
	r6 = r5 * r1.z + r6;
	r7 = r3 * 1.1111112;
	r3 = (r3 >= 0) ? r7 : 0;
	r3 = saturate(r3 * r6);
	r6 = r2 * -gLightDirX;
	r6 = r4 * -gLightDirY + r6;
	r6 = r5 * -gLightDirZ + r6;
	r7 = gLightConeScale;
	r6 = saturate(r6 * r7 + gLightConeOffset);
	r3 = r3 * r6;
	r0.z = gWaterGlobals.z;
	r6.x = lerp(specularColorFactor.x, r0.z, r0.w);
	r7.y = max(r0.x, specularFactor.x);
	r6.y = lerp(r7.y, gWaterGlobals.w, r0.w);
	r7.x = specularColorFactor.x;
	r0.yz = (-r0.ww >= 0) ? r7.xy : r6.xy;
	r0.yz = (-i.color.yy >= 0) ? r7.xy : r0.yz;
	r1.w = r0.z * 0.25 + 1E-05;
	r6.xyz = 1E-05 + i.texcoord3.xyz;
	r7.xyz = normalize(r6.xyz);
	r6.x = dot(-r7.xyz, r1.xyz);
	r6.x = r6.x + r6.x;
	r6.xyz = r1.xyz * -r6.xxx + -r7.xyz;
	r6.w = saturate(dot(r7.xyz, r1.xyz));
	r6.w = -r6.w + 1.00001;
	r2 = r2 * r6.x;
	r2 = r6.y * r4 + r2;
	r2 = saturate(r6.z * r5 + r2);
	r2 = r2 + 1E-05;
	r4.x = log2(r2.x);
	r4.y = log2(r2.y);
	r4.z = log2(r2.z);
	r4.w = log2(r2.w);
	r2 = r1.w * r4;
	r4.x = exp2(r2.x);
	r4.y = exp2(r2.y);
	r4.z = exp2(r2.z);
	r4.w = exp2(r2.w);
	r2 = r3 * r4;
	r4.x = dot(gLightColR, r2);
	r4.y = dot(gLightColG, r2);
	r4.z = dot(gLightColB, r2);
	r2.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r2.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r2.xyz;
	r2.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r2.xyz;
	r2.xyz = r2.xyz + gShadowMatrix[3].xyz;
	r5.xy = r2.xy + -gShadowParam18192021.zw;
	r5.zw = r5.xx + -gCascadeXMaxThresholds.xy;
	r5.zw = (r5.zw >= 0) ? 1 : 0;
	r7.xy = -r5.xx + gCascadeXMinThresholds.xy;
	r7.xy = (r7.xy >= 0) ? 1 : 0;
	r5.zw = r5.zw + r7.xy;
	r7.xy = r5.yy + -gCascadeYMaxThresholds.xy;
	r7.xy = (r7.xy >= 0) ? 1 : 0;
	r5.zw = r5.zw + r7.xy;
	r7.xy = -r5.yy + gCascadeYMinThresholds.xy;
	r7.xy = (r7.xy >= 0) ? 1 : 0;
	r7.yz = saturate(r5.zw + r7.xy);
	r7.x = 1;
	r8.x = dot(r7.xyz, gShadowParam0123.xyz);
	r8.y = dot(r7.xyz, gShadowParam4567.xyz);
	r8.z = dot(r7.xyz, gCascadeZScales.xyz);
	r9.x = dot(r7.xyz, gShadowParam891113.xyz);
	r9.y = dot(r7.xyz, gShadowParam14151617.xyz);
	r9.z = dot(r7.xyz, gCascadeZOffsets.xyz);
	r2.xyz = r2.zxy * r8.zxy + r9.zxy;
	r2.x = saturate(r2.x);
	r7 = tex2D(gShadowZSamplerDir, r2.yz);
	r1.w = -r2.x + 1;
	r1.w = -r7.x + r1.w;
	r1.w = (r1.w >= 0) ? -1 : -0;
	r2.x = -gCascadeXMinThresholds.w;
	r2.y = -gCascadeXMaxThresholds.w;
	r2.xy = saturate(abs(r5.xy) * 4 + r2.xy);
	r4.w = max(r2.x, r2.y);
	r1.w = r1.w + r4.w;
	r1.w = saturate(r1.w + 1);
	r2.xyz = r1.www * gDirectionalColour.xyz;
	r1.w = saturate(dot(-gDirectionalLight.xyz, r6.xyz));
	r5.xyz = r6.xyz + 1E-05;
	r1.w = r1.w + 1E-05;
	r0.z = r0.z + 1E-05;
	r2.w = pow(r1.w, r0.z);
	r0.z = dot(r1.xyz, -gDirectionalLight.xyz);
	r1.x = saturate(r1.z * -0.5 + 0.5);
	r1.y = saturate(r0.z * 2 + -0.5);
	r0.z = saturate(r0.z + -0.25);
	r0.z = r0.z * 1.3333334;
	r6.xyz = r0.zzz * r2.xyz;
	r0.z = r1.y * r2.w;
	r1.yzw = r0.zzz * r2.xyz;
	r1.yzw = r1.yzw * gDirectionalLight.www + r4.xyz;
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r2.xyz = r1.xxx * r2.xyz + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r2.xyz * i.color.xxx;
	r0.z = 1 / gAmbientOcclusionEffect.y;
	r2.xyz = r2.xyz * r0.zzz + r6.xyz;
	r4.x = dot(gLightColR, r3);
	r4.y = dot(gLightColG, r3);
	r4.z = dot(gLightColB, r3);
	r2.xyz = r2.xyz + r4.xyz;
	r0.z = dot(r2.xyz, 0.33333334);
	r0.z = r0.z + 0.015;
	r1.x = dot(r5.xyz, r5.xyz);
	r1.x = rsqrt(r1.x);
	r3.xy = r5.xz * r1.xx + 1;
	r3.xy = r3.xy * -0.5;
	r3 = tex2D(EnvironmentSampler, r3.xy);
	r1.x = r6.w * r6.w;
	r1.x = r1.x * r1.x;
	r1.x = r1.x * r6.w;
	r0.x = r0.x + -fresnelRolloff.x;
	r0.x = fresnelRolloff.x * r1.x + r0.x;
	r3.xyz = r0.xxx * r3.xyz;
	r3.xyz = r3.xyz * reflectivePower.xxx;
	r3.xyz = r3.xyz * globalScalars.www;
	r4 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.x = r4.w * i.color.w;
	r1.x = 1 / r0.x;
	r5.w = r0.x * globalScalars.x;
	r0.x = r4.w * i.color.w + -0.01;
	r0.x = (r0.x >= 0) ? r1.x : 100;
	r3.xyz = r0.xxx * r3.xyz;
	r3.xyz = r0.zzz * r3.xyz;
	r0.xyz = r1.yzw * r0.yyy + r3.xyz;
	r1.x = saturate(gWaterGlobals.y);
	r1.yzw = r4.xyz * WetDarken.xyz + -r4.xyz;
	r1.xyz = r1.xxx * r1.yzw + r4.xyz;
	r3.xyz = r4.xyz * WetDarken.xyz;
	r1.xyz = (-r0.www >= 0) ? r1.xyz : r3.xyz;
	r1.xyz = (-i.color.yyy >= 0) ? r4.xyz : r1.xyz;
	r1.xyz = r1.xyz * r1.xyz;
	r0.xyz = r1.xyz * r2.xyz + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r5.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o = min(r5, float4(8, 8, 8, 1));

	return o;
}
