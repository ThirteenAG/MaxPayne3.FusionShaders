float4 AirResist : register(c221);
float WindStr : register(c222);
row_major float3x4 gBoneMtx[40] : register(c76);
float4 gWindParams : register(c220);
row_major float4x4 gWorld : register(c0);
row_major float4x4 gWorldViewProj : register(c8);
float4 globalScalars2 : register(c36);
float4 globalScalars3 : register(c49);
float4 globalScalars4 : register(c51);

struct VS_IN
{
	float4 position : POSITION;
	float4 blendweight : BLENDWEIGHT;
	float4 blendindices : BLENDINDICES;
	float4 texcoord : TEXCOORD;
	float4 normal : NORMAL;
	float4 tangent : TANGENT;
	float4 color : COLOR;
	float4 color1 : COLOR1;
};

struct VS_OUT
{
	float4 position : POSITION;
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	int4 a0;
	float4 r1;
	float3 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	r0 = 765.00586 * i.blendindices;
	a0 = r0.yxzw;
	r1 = i.blendweight.y * gBoneMtx[a0.x / 3][1];
	r1 = gBoneMtx[a0.y / 3][1] * i.blendweight.x + r1;
	r0 = gBoneMtx[a0.z / 3][1] * i.blendweight.z + r1;
	r0 = gBoneMtx[a0.w / 3][1] * i.blendweight.w + r0;
	r1 = i.position.xyzx * float4(1, 1, 1, 0) + float4(0, 0, 0, 1);
	r2.y = dot(r0, r1);
	r3.xyz = r2.yyy * gWorld[1].xyz;
	r4 = i.blendweight.y * gBoneMtx[a0.x / 3][0];
	r5 = i.blendweight.y * gBoneMtx[a0.x / 3][2];
	r5 = gBoneMtx[a0.y / 3][2] * i.blendweight.x + r5;
	r4 = gBoneMtx[a0.y / 3][0] * i.blendweight.x + r4;
	r4 = gBoneMtx[a0.z / 3][0] * i.blendweight.z + r4;
	r5 = gBoneMtx[a0.z / 3][2] * i.blendweight.z + r5;
	r5 = gBoneMtx[a0.w / 3][2] * i.blendweight.w + r5;
	r4 = gBoneMtx[a0.w / 3][0] * i.blendweight.w + r4;
	r2.x = dot(r4, r1);
	r2.z = dot(r5, r1);
	r1.xyz = r2.xxx * gWorld[0].xyz + r3.xyz;
	r1.xyz = r2.zzz * gWorld[2].xyz + r1.xyz;
	o.texcoord7 = r1.xyz + gWorld[3].xyz;
	r0.w = dot(r0.xyz, i.tangent.xyz);
	r0.x = dot(r0.xyz, i.normal.xyz);
	r0.xyz = r0.xxx * gWorld[1].xyz;
	r1.xyz = r0.www * gWorld[1].xyz;
	r0.w = dot(r4.xyz, i.tangent.xyz);
	r1.w = dot(r4.xyz, i.normal.xyz);
	r0.xyz = r1.www * gWorld[0].xyz + r0.xyz;
	r1.xyz = r0.www * gWorld[0].xyz + r1.xyz;
	r0.w = dot(r5.xyz, i.tangent.xyz);
	r1.w = dot(r5.xyz, i.normal.xyz);
	r3.xyz = r1.www * gWorld[2].xyz + r0.xyz;
	r0.xyz = r0.www * gWorld[2].xyz + r1.xyz;
	r1.xyz = r3.yzx * r0.zxy;
	r1.xyz = r0.yzx * r3.zxy + -r1.xyz;
	o.texcoord4 = r0.xyz;
	o.texcoord5.xyz = r1.xyz * i.tangent.www;
	r0.x = -r3.z + 1;
	r0.x = r0.x * r0.x;
	r0.x = r0.x * -0.02 + 1;
	r3.w = max(r0.x, r3.z);
	r0.xyz = r3.xyw + 1E-05;
	r0.w = dot(r0.xyz, r0.xyz);
	r0.w = rsqrt(r0.w);
	o.texcoord1.xyz = r0.www * r0.xyz;
	o.texcoord2.y = globalScalars2.w * i.color.y;
	r0.xyz = r2.xxz * float3(6, 10, 10);
	r1.yw = float2(1, 0.01);
	r0.w = AirResist.w * r1.w + r1.y;
	r0.x = globalScalars3.y * r0.w + r0.x;
	r0.y = r0.z + r0.y;
	r0.y = r2.y * 10 + r0.y;
	r0.z = r0.w * globalScalars3.y;
	r0.x = r0.x * 0.15915494 + 0.5;
	r0.x = frac(r0.x);
	r0.x = r0.x * 6.2831855 + -3.1415927;
	r1.y = sin(r0.x);
	r0.x = saturate(WindStr.x);
	r0.x = abs(r1.y) * r0.x;
	r0.y = r0.z * gWindParams.z + r0.y;
	r0.y = r0.y * 0.15915494 + 0.5;
	r0.y = frac(r0.y);
	r0.y = r0.y * 6.2831855 + -3.1415927;
	r1.y = sin(r0.y);
	r0.x = r0.x * abs(r1.y);
	r0.y = r2.y * 4;
	r0.y = r0.z * gWindParams.w + r0.y;
	r0.y = r0.y * 0.15915494 + 0.5;
	r0.y = frac(r0.y);
	r0.y = r0.y * 6.2831855 + -3.1415927;
	r1.y = sin(r0.y);
	r0.x = r0.x * abs(r1.y);
	r1.x = 1E-05;
	r3.x = r1.x + globalScalars3.z;
	r3.y = r1.x + globalScalars4.z;
	r3.z = 1E-05;
	r1.xyz = normalize(r3.xyz);
	r0.y = dot(r1.xyz, i.normal.xyz);
	r0.y = max(r0.y, 0.25);
	r0.y = min(r0.y, 1);
	r0.z = AirResist.w * i.color1.z;
	r0.z = r0.z * 5;
	r1.z = -r0.z;
	r1.xy = -i.color1.xx;
	r1.xyz = r1.xyz * i.normal.xyz;
	r0.yzw = r0.yyy * r1.xyz;
	r0.xyz = r0.yzw * r0.xxx + r2.xyz;
	r1 = r0.y * gWorldViewProj[1];
	r1 = r0.x * gWorldViewProj[0] + r1;
	r0 = r0.z * gWorldViewProj[2] + r1;
	r0 = r0 + gWorldViewProj[3];
	o.position = r0;
	o.texcoord1.w = r0.w;
	o.texcoord = i.texcoord.xy;
	o.texcoord2.xzw = i.color.xzw;
	o.texcoord5.w = i.tangent.w;

	return o;
}
