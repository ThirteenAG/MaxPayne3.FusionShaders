sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
sampler2D SpecSampler : register(s5);
sampler3D VolumeSampler : register(s6);
float bumpiness : register(c200);
float4 detailSettings : register(c207);
float fresnelRolloff : register(c199);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float reflectivePower : register(c197);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c198);
float specularFactor : register(c202);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color2 : COLOR2;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float3 r7;
	float3 r8;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r0.z = dot(i.texcoord2.xyz, float3(0.3, 0.6, 0.1));
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = i.texcoord2.xyzx * float4(1, 1, 1, 0) + float4(0, 0, 0, 1);
	r1 = r1 * r2;
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.w = dot(r0.xy, -r0.xy) + 1;
	r2.x = max(r0.w, 0);
	r0.w = rsqrt(r2.x);
	r0.w = 1 / r0.w;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r2.w = dot(r2, specMapExpMask);
	r2.w = r2.w * specularFactor.x;
	r3.x = dot(r2.xyz, specMapIntMask.xyz);
	r3.y = max(1, r2.w);
	r4.xyz = r0.xxx * i.texcoord4.xyz;
	r4.xyz = r0.www * i.texcoord1.xyz + r4.xyz;
	r0.xyw = r0.yyy * i.texcoord5.xyz + r4.xyz;
	r0.xyw = r0.xyw + 1E-05;
	r2.w = dot(r0.xyw, r0.xyw);
	r2.w = rsqrt(r2.w);
	r4.xyz = r0.xyw * r2.www;
	r5.y = 0;
	if (-reflectivePower.x < r5.y) {
		r3.z = saturate(r3.y * 0.015625);
		r5.w = r3.z * -4 + 4;
		r6 = 1E-05 + i.texcoord3.xyz;
		r7 = normalize(r6.xyz);
		r3.z = dot(-r7.xyz, r4.xyz);
		r3.z = r3.z + r3.z;
		r6 = r4.xyz * -r3.zzz + -r7.xyz;
		r6 = r6.xyz + 1E-05;
		r8 = normalize(r6.xyz);
		r3.z = saturate(r8.z);
		r3.z = r3.z + 1;
		r3.z = r3.z + r3.z;
		r3.z = 1 / r3.z;
		r3.zw = r8.xy * r3.zz + 0.5;
		r5.xy = -r3.zw + 1;
		r5.z = 0;
		r5 = tex2Dlod(DynamicEnvironmentSampler, r5);
		r5.xyz = r5.xyz * r5.xyz;
		r5.xyz = r5.xyz * 16;
		r3.z = saturate(dot(r7.xyz, r4.xyz));
		r6.x = 1;
		r3.w = r6.x + -fresnelRolloff.x;
		r3.z = -r3.z + 1.00001;
		r4.w = r3.z * r3.z;
		r4.w = r4.w * r4.w;
		r3.z = r3.z * r4.w;
		r3.z = fresnelRolloff.x * r3.z + r3.w;
		r5.xyz = r3.zzz * r5.xyz;
	} else {
		r5.xyz = 0;
	}
	r5.xyz = r5.xyz * reflectivePower.xxx;
	r2.x = dot(r2.xyz, specMapReflectMask.xyz);
	r5.xyz = r2.xxx * r5.xyz;
	r5.xyz = r5.xyz * ColorCorrectTopAndPedReflectScale.www;
	r1.w = r1.w * i.texcoord2.w;
	r2.x = 1;
	r0.z = r0.z * globalScalars.z + -r2.x;
	r0.z = gAmbientOcclusionEffect.x * r0.z + r2.x;
	r1.xyz = r1.xyz * matMaterialColorScale.xxx;
	r5.xyz = r5.xyz * matMaterialColorScale.zzz;
	r2.xy = r3.xy * matMaterialColorScale.ww;
	r3.yzw = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r3.yzw = r3.yzw + 1E-05;
	r6 = normalize(r3.yzw);
	r0.xyw = r0.xyw * r2.www + 1E-05;
	r7 = normalize(r0.xyw);
	r0.x = dot(r6.xyz, r7.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.w = saturate(r2.x * 5);
	r0.y = r0.w * r0.y;
	r2.x = r2.y * 0.0051020407;
	r0.w = saturate(r2.y * -0.01 + 1);
	r0.y = r0.y * r0.w;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r3.x * matMaterialColorScale.w + r0.x;
	r0.y = r2.z * 16;
	r0.w = frac(r0.y);
	r0.y = r0.y + -r0.w;
	r0.w = (-r0.w >= 0) ? 0 : 1;
	r0.w = (r2.z >= 0) ? 0 : r0.w;
	r0.y = r0.w + r0.y;
	r3.xy = detailSettings.zw * i.texcoord.xy;
	r0.y = r0.y + 0.5;
	r3.z = r0.y * 0.0625;
	r3 = tex3D(VolumeSampler, r3.xyz);
	r2.yzw = r3.yzx * 2 + -1;
	r0.y = detailSettings.x * i.texcoord2.w;
	r0.y = r2.w * r0.y + 1;
	o.color.xyz = r0.yyy * r1.xyz;
	r1.xyz = r2.zzz * i.texcoord5.xyz;
	r1.xyz = i.texcoord4.xyz * r2.yyy + r1.xyz;
	r1.xyz = r1.xyz * detailSettings.yyy;
	r1.xyz = r1.xyz * i.texcoord2.www + r4.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r3.xyz = normalize(r1.xyz);
	o.color2.x = saturate(r0.y * r0.x);
	r0.x = saturate(gAmbientOcclusionEffect.z);
	r0.x = saturate(r0.x + r0.z);
	o.color1.xyz = r3.xyz * 0.5 + 0.5;
	r2.x = saturate(r2.x);
	r0.y = rsqrt(r2.x);
	r0.y = 1 / r0.y;
	r0.y = rsqrt(r0.y);
	o.color2.y = 1 / r0.y;
	o.color2.z = r0.x * gAmbientOcclusionEffect.w;
	r0.x = r1.w * globalScalars.x;
	r0.yzw = saturate(r5.xyz * 0.0625);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	r0.w = rsqrt(r0.w);
	o.color3.x = 1 / r0.y;
	o.color3.y = 1 / r0.z;
	o.color3.z = 1 / r0.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3.w = gStencil.x;

	return o;
}
