float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float4 r10;
	float4 r11;
	float4 r12;
	float4 r13;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.xyz = 1E-05 + i.texcoord1.xyz;
	r2.xyz = normalize(r1.xyz);
	r1 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r1, specMapExpMask);
	r1.x = dot(r1.xyz, specMapIntMask.xyz);
	r1.x = r1.x * specularColorFactor.x;
	r3.xyz = float3(1E-05, 1, 0);
	r1.y = r1.w * -specularFactor.x + r3.y;
	r4.xyz = r0.xyz * r0.xyz;
	r0.xyz = r4.xyz * matDiffuseColor.xyz;
	r0 = r0 * i.texcoord6;
	r1.z = dot(i.texcoord6.xyz, float3(0.2125, 0.7154, 0.0721));
	r4.y = gAmbientOcclusionEffect.y;
	r2.w = r4.y * globalScalars.z;
	r1.z = r1.z * r2.w;
	if (-dirtLevel.x < r3.z) {
		r4 = tex2D(DirtSampler, i.texcoord.xy);
		r2.w = r4.x * dirtLevel.x;
		r5.x = r4.x * -dirtLevel.x + r3.y;
		r5.yzw = lerp(r0.xyz, dirtColor.xyz, r2.www);
		r6 = r0.xxyz * float4(0, 1, 1, 1) + float4(1, 0, 0, 0);
		r4 = (-r4.x >= 0) ? r6 : r5;
		r0.xyz = r4.yzw;
	} else {
		r4.x = 1;
	}
	r1.x = r1.x * r4.x;
	r3.yzw = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r3.yzw);
	r2.w = saturate(r2.z * -0.5 + 0.5);
	r5.xyz = gLightAmbient0.xyz;
	r3.yzw = -r5.xyz + gLightAmbient1.xyz;
	r3.yzw = r2.www * r3.yzw + gLightAmbient0.xyz;
	r3.yzw = r3.yzw * gAmbientOcclusionEffect.yyy;
	r3.yzw = r1.zzz * r3.yzw;
