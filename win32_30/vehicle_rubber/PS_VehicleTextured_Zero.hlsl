	r5.xy = -r4.xx + gCascadeXMinThresholds.xy;
	r5.zw = r4.yy + -gCascadeYMaxThresholds.xy;
	r5 = (r5 >= 0) ? 1 : 0;
	r6.xy = -r4.yy + gCascadeYMinThresholds.xy;
	r6.xy = (r6.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r5.xy;
	r4.zw = r5.zw + r4.zw;
	r5.yz = saturate(r6.xy + r4.zw);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r2.xzw = r2.wxz * r6.zxy + r7.zxy;
	r2.x = saturate(r2.x);
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r4.xy = saturate(abs(r4.xy) * 4 + r5.xy);
	r1.w = max(r4.x, r4.y);
	r2.x = -r2.x + 0.9999995;
	r4.x = 1 / gShadowParam18192021.x;
	r4.y = 1 / gShadowParam18192021.y;
	r4.xy = r2.zw * r4.xy;
	r4.xy = frac(r4.xy);
	r3.x = -r4.y + 1;
	r5.xy = r2.zw + -gShadowParam18192021.xy;
	r5 = tex2D(gShadowZSamplerDir, r5.xy);
	r6.xyz = float3(0, -1, 1);
	r7 = gShadowParam18192021.yyxy * r6.xyzy + r2.zwzw;
	r8 = tex2D(gShadowZSamplerDir, r7.xy);
	r7 = tex2D(gShadowZSamplerDir, r7.zw);
	r9 = gShadowParam18192021.xyxy * r6.yxzx + r2.zwzw;
	r10 = tex2D(gShadowZSamplerDir, r9.xy);
	r11 = tex2D(gShadowZSamplerDir, r2.zw);
	r9 = tex2D(gShadowZSamplerDir, r9.zw);
	r6 = gShadowParam18192021.xyyy * r6.yzxz + r2.zwzw;
	r12 = tex2D(gShadowZSamplerDir, r6.xy);
	r6 = tex2D(gShadowZSamplerDir, r6.zw);
	r2.zw = r2.zw + gShadowParam18192021.xy;
	r13 = tex2D(gShadowZSamplerDir, r2.zw);
	r10.y = r11.x;
	r10.z = r9.x;
	r6.yzw = -r2.xxx + r10.xyz;
	r6.yzw = (r6.yzw >= 0) ? 1 : 0;
	r4.zw = r4.xx * float2(-1, 0) + 1;
	r2.z = dot(r6.wyz, r4.xzw);
	r5.y = r8.x;
	r5.z = r7.x;
	r5.xyz = -r2.xxx + r5.xyz;
	r5.xyz = (r5.xyz >= 0) ? 1 : 0;
	r4.xzw = r4.xwx * float3(-1, 1, 1) + float3(1, 0, 0);
	r2.w = dot(r5.xyz, r4.xzw);
	r2.z = r2.w * r3.x + r2.z;
	r12.y = r6.x;
	r12.z = r13.x;
	r5.xyz = -r2.xxx + r12.xyz;
	r5.xyz = (r5.xyz >= 0) ? 1 : 0;
	r2.x = dot(r5.xyz, r4.xzw);
	r2.x = r2.x * r4.y + r2.z;
	r1.w = r2.x * 0.33333334 + r1.w;
	r1.w = r1.w + -0.4;
	r1.w = saturate(r1.w * 1.6666666);
	r2.x = r1.w * -2 + 3;
	r1.w = r1.w * r1.w;
	r1.w = r1.w * r2.x;
	r2.xzw = r1.www * gDirectionalColour.xyz;
	r4.xyz = r1.yyy * r2.xzw;
	r2.xyz = r2.yyy * r2.xzw;
	r4.xyz = r4.xyz * gDirectionalLight.www;
	r1.yzw = r3.yzw * r1.zzz + r2.xyz;
	r2.xyz = r1.xxx * r4.xyz;
	r0.xyz = r0.xyz * r1.yzw + r2.xyz;
	o.w = r0.w * globalScalars.x;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.z = -r1.z + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.xyz = r0.xyz + -r1.xxx;
	o.xyz = r0.www * r0.xyz + r1.xxx;

	return o;
}
