sampler2D DensitySampler : register(s0);
sampler2D DepthSampler : register(s6);
sampler2D DetailDensity2Sampler : register(s4);
sampler2D DetailDensitySampler : register(s2);
sampler2D DetailNormal2Sampler : register(s5);
sampler2D DetailNormalSampler : register(s3);
float3 EastColor : register(c22);
sampler2D NormalSampler : register(s1);
float3 SkyColor : register(c21);
float3 WestColor : register(c23);
float3 gAmbientColor : register(c27);
float3 gAnimBlendWeights : register(c37);
float3 gAnimCombine : register(c35);
float3 gAnimSculpt : register(c36);
float3 gBounceColor : register(c28);
float3 gCloudColor : register(c26);
float2 gDensityShiftScale : register(c29);
float gHDRExposure : register(c34);
float4 gNearFarQMult : register(c90);
float4 gPiercingLightPower_Strength_NormalStrength_Thickness : register(c31);
float3 gScaleDiffuseFillAmbient : register(c32);
float gSoftParticleRange : register(c98);
float3 gSunColor : register(c25);
float3 gSunDirection : register(c24);
float2 gWrapLighting : register(c33);

struct PS_IN
{
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float2 texcoord4 : TEXCOORD4;
	float4 texcoord5 : TEXCOORD5;
	float4 texcoord6 : TEXCOORD6;
	float4 texcoord7 : TEXCOORD7;
	float3 texcoord8 : TEXCOORD8;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	r0.x = 1 / i.texcoord6.w;
	r0.xy = r0.xx * i.texcoord6.xy;
	r0 = tex2D(DepthSampler, r0.xy);
	r0.y = r0.x + -gNearFarQMult.z;
	r0.x = r0.x + -1;
	r0.y = 1 / r0.y;
	r0.y = gNearFarQMult.w * r0.y + -i.texcoord6.w;
	r0.z = 1 / gSoftParticleRange.x;
	r0.y = saturate(r0.z * r0.y);
	r0.x = (r0.x >= 0) ? 1 : r0.y;
	r1 = tex2D(DensitySampler, i.texcoord4.xy);
	r1.x = r1.y;
	r2 = tex2D(DetailDensitySampler, i.texcoord5.xy);
	r1.y = r2.y;
	r2 = tex2D(DetailDensity2Sampler, i.texcoord5.zw);
	r1.z = r2.y;
	r0.yzw = r1.xyz * -r1.xyz + 1;
	r0.yzw = r0.yzw * gAnimBlendWeights.xyz;
	r1.xy = r0.yz * gAnimSculpt.xy;
	r1.x = r1.y + r1.x;
	r1.x = r0.w * gAnimSculpt.z + r1.x;
	r0.yzw = r0.yzw * gAnimCombine.xyz;
	r1.y = max(r0.z, r0.w);
	r2.x = max(r0.y, r1.y);
	r1.y = -r2.x + 1;
	r1.x = r1.y * -r1.x + r2.x;
	r1.x = r1.x + -gDensityShiftScale.x;
	r1.x = saturate(r1.x * gDensityShiftScale.y);
	o.w = r0.x * r1.x;
	r0.x = -r1.x + 1;
	r1 = tex2D(DetailNormalSampler, i.texcoord5.xy);
	r1.xy = r1.wy * 2 + -1;
	r1.w = r1.x * -r1.x + 1;
	r1.w = r1.y * -r1.y + r1.w;
	r2.x = max(r1.w, 0);
	r1.w = rsqrt(r2.x);
	r1.z = 1 / r1.w;
	r1.xyz = r0.zzz * r1.xyz;
	r2 = tex2D(NormalSampler, i.texcoord4.xy);
	r2.xy = r2.wy * 2 + -1;
	r0.z = r2.x * -r2.x + 1;
	r0.z = r2.y * -r2.y + r0.z;
	r1.w = max(r0.z, 0);
	r0.z = rsqrt(r1.w);
	r2.z = 1 / r0.z;
	r1.xyz = r2.xyz * r0.yyy + r1.xyz;
	r2 = tex2D(DetailNormal2Sampler, i.texcoord5.zw);
	r2.xy = r2.wy * 2 + -1;
	r0.y = r2.x * -r2.x + 1;
	r0.y = r2.y * -r2.y + r0.y;
	r1.w = max(r0.y, 0);
	r0.y = rsqrt(r1.w);
	r2.z = 1 / r0.y;
	r0.yzw = r2.xyz * r0.www + r1.xyz;
	r0.yzw = r0.yzw + 1E-05;
	r1.xyz = normalize(r0.yzw);
	r0.yzw = r1.yyy * i.texcoord3.xyz;
	r0.yzw = r1.xxx * i.texcoord2.xyz + r0.yzw;
	r0.yzw = r1.zzz * i.texcoord1.xyz + r0.yzw;
	r0.yzw = r0.yzw + 1E-05;
	r1.x = dot(r0.yzw, r0.yzw);
	r1.x = rsqrt(r1.x);
	r1.yz = r0.wy * r1.xx + 1;
	r2.xy = r0.wy * -r1.xx + 1;
	r0.yzw = r0.yzw * r1.xxx;
	r1.x = r1.y + r2.x;
	r1.x = r1.z + r1.x;
	r1.x = r2.y + r1.x;
	r1.x = r1.x + 1E-05;
	r1.x = 1 / r1.x;
	r2 = r0.wwyy * float4(1, -1, 1, -1) + 1;
	r1 = r1.x * r2;
	r2.xyz = r1.yyy * gBounceColor.xyz;
	r2.xyz = SkyColor.xyz * r1.xxx + r2.xyz;
	r1.xyz = EastColor.xyz * r1.zzz + r2.xyz;
	r1.xyz = WestColor.xyz * r1.www + r1.xyz;
	r1.w = dot(r0.yzw, gSunDirection.xyz);
	r0.y = saturate(dot(r0.yzw, i.texcoord7.xyz));
	r0.y = r0.y * gPiercingLightPower_Strength_NormalStrength_Thickness.z;
	r0.z = saturate(r1.w * gWrapLighting.x + gWrapLighting.y);
	r2.xyz = r0.zzz * gSunColor.xyz;
	r2.xyz = r2.xyz * gScaleDiffuseFillAmbient.xxx;
	r1.xyz = r1.xyz * gScaleDiffuseFillAmbient.yyy + r2.xyz;
	r0.z = gScaleDiffuseFillAmbient.z;
	r1.xyz = gAmbientColor.xyz * r0.zzz + r1.xyz;
	r2.x = 1;
	r0.z = r2.x + -gPiercingLightPower_Strength_NormalStrength_Thickness.w;
	r0.x = saturate(r0.x * gPiercingLightPower_Strength_NormalStrength_Thickness.w + r0.z);
	r2.xyz = r0.xxx * i.texcoord8.xyz;
	r1.xyz = gCloudColor.xyz * r1.xyz + r2.xyz;
	r0.z = r0.y * i.texcoord7.w;
	r0.y = r0.y * -i.texcoord7.w + i.texcoord7.w;
	r0.y = i.texcoord7.w * r0.y + r0.z;
	r0.x = r0.x * r0.y;
	r0.xyz = r0.xxx * gSunColor.xyz;
	r0.xyz = r0.xyz * gPiercingLightPower_Strength_NormalStrength_Thickness.yyy + r1.xyz;
	o.xyz = r0.xyz * gHDRExposure.xxx;

	return o;
}
