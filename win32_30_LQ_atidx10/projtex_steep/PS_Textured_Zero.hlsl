sampler2D BumpSampler : register(s2);
sampler2D DiffuseSampler : register(s0);
float bumpiness : register(c201);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float parallaxScaleBias : register(c197);
float specularColorFactor : register(c200);
float specularFactor : register(c199);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float3 r7;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r1.xyz = 1E-05 + i.texcoord7.xyz;
	r0.z = dot(r1.xyz, r1.xyz);
	r0.z = rsqrt(r0.z);
	r1.xy = r0.zz * r1.xy;
	r1.xy = -r1.xy * parallaxScaleBias.xx;
	r1.zw = i.texcoord.xy;
	r2.yz = r0.xy;
	r2.x = -1;
	r2.w = -r0.w;
	for (int i0 = 0; i0 < 2; i0++) {
		r0.z = -r2.w + r2.x;
		r3.x = r2.x + 0.5;
		r4.xy = r1.xy * 0.5 + r1.zw;
		r5 = tex2D(BumpSampler, r4.xy);
		r1.zw = (r0.zz >= 0) ? r1.zw : r4.xy;
		r3.yzw = r5.xyw * float3(1, 1, -1);
		r2 = (r0.z >= 0) ? r2 : r3;
	}
	r0 = tex2D(DiffuseSampler, r1.zw);
	r1.xy = r2.yz * 2 + -1;
	r1.xy = r1.xy * bumpiness.xx;
	r1.z = dot(r1.xy, -r1.xy) + 1;
	r2.x = max(r1.z, 0);
	r1.z = rsqrt(r2.x);
	r1.z = 1 / r1.z;
	r3.xz = float2(1E-05, -1);
	r1.w = -r3.z + -specularFactor.x;
	r3.yzw = r1.xxx * i.texcoord4.xyz;
	r3.yzw = r1.zzz * i.texcoord1.xyz + r3.yzw;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r3.yzw;
	r1.xyz = r1.xyz + 1E-05;
	r4.xyz = normalize(r1.xyz);
	r1.x = dot(r2.yz, r2.yz) + -0.002;
	r1.x = (r1.x >= 0) ? 1 : 0;
	r0.xyz = r0.xyz * r1.xxx;
	r1.y = r1.x * i.color.x;
	r1.x = r1.x * specularColorFactor.x;
	r0.xyz = r0.xyz * r0.xyz;
	r0.w = r0.w * i.color.w;
	r2.xyz = 1E-05 + i.texcoord3.xyz;
	r5.xyz = normalize(r2.xyz);
	r1.z = saturate(r4.z * -0.5 + 0.5);
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r2.xyz = r1.zzz * r2.xyz + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r1.yyy * r2.xyz;
	r1.y = 1 / gAmbientOcclusionEffect.y;
	r1.z = dot(-r5.xyz, r4.xyz);
	r1.z = r1.z + r1.z;
	r3.yzw = r4.xyz * -r1.zzz + -r5.xyz;
	r1.z = dot(r4.xyz, -gDirectionalLight.xyz);
	r2.w = saturate(r1.z + -0.25);
	r2.w = r2.w * 1.3333334;
	r3.y = saturate(dot(-gDirectionalLight.xyz, r3.yzw));
	r3.y = r3.y + 1E-05;
	r3.x = r3.x + specularFactor.x;
	r1.w = (r1.w >= 0) ? 1.00001 : r3.x;
	r4.x = pow(r3.y, r1.w);
	r1.z = saturate(r1.z * 2 + -0.5);
	r1.z = r1.z * r4.x;
	r3.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r3.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r3.xyz;
	r3.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r3.xyz;
	r3.xyz = r3.xyz + gShadowMatrix[3].xyz;
	r4.xy = r3.xy + -gShadowParam18192021.zw;
	r4.zw = r4.xx + -gCascadeXMaxThresholds.xy;
	r4.zw = (r4.zw >= 0) ? 1 : 0;
	r5.xy = -r4.xx + gCascadeXMinThresholds.xy;
	r5.zw = r4.yy + -gCascadeYMaxThresholds.xy;
	r5 = (r5 >= 0) ? 1 : 0;
	r6.xy = -r4.yy + gCascadeYMinThresholds.xy;
	r6.xy = (r6.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r5.xy;
	r4.zw = r5.zw + r4.zw;
	r5.yz = saturate(r6.xy + r4.zw);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r3.xyz = r3.zxy * r6.zxy + r7.zxy;
	r3.x = saturate(r3.x);
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r4.xy = saturate(abs(r4.xy) * 4 + r5.xy);
	r1.w = max(r4.x, r4.y);
	r3.x = -r3.x + 1;
	r4 = tex2D(gShadowZSamplerDir, r3.yz);
	r3.x = r3.x + -r4.x;
	r3.x = (r3.x >= 0) ? -1 : -0;
	r1.w = r1.w + r3.x;
	r1.w = saturate(r1.w + 1);
	r3.xyz = r1.www * gDirectionalColour.xyz;
	r4.xyz = r1.zzz * r3.xyz;
	r3.xyz = r2.www * r3.xyz;
	r4.xyz = r4.xyz * gDirectionalLight.www;
	r1.yzw = r2.xyz * r1.yyy + r3.xyz;
	r2.xyz = r1.xxx * r4.xyz;
	r0.xyz = r0.xyz * r1.yzw + r2.xyz;
	r1.w = r0.w * globalScalars.x;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r2.x = 1E-05 + i.texcoord9.y;
	r3.x = pow(r0.w, r2.x);
	r2.xyz = r0.xyz * r3.xxx;
	r0.xyz = r0.xyz * -r3.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r2.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r2.x = r2.x * deSatContrastGamma.x;
	r1.xyz = lerp(r0.www, r0.xyz, r2.xxx);
	o = min(r1, float4(8, 8, 8, 1));

	return o;
}
