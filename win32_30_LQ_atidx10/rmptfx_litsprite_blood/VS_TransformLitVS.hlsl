float HybridAdd : register(c196);
float gAmbientShadow : register(c212);
float4 gAspectRatio : register(c17);
float gBiasToCamera : register(c200);
float4 gBloodLightingTuners : register(c96);
float gDiffuse : register(c203);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightAmbientDir0 : register(c72);
float4 gLightAmbientDir1 : register(c73);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float gLightIntensityClamp : register(c213);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
float gNormalArc : register(c209);
float gSuperAlpha : register(c208);
float4 gTexCoordScaleOffset0 : register(c214);
row_major float4x4 gViewInverse : register(c12);
row_major float4x4 gWorldView : register(c4);
row_major float4x4 gWorldViewProj : register(c8);
float gWrapBias : register(c202);
float gWrapScale : register(c201);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars4 : register(c51);

struct VS_IN
{
	float4 position : POSITION;
	float4 normal : NORMAL;
	float4 color : COLOR;
	float4 texcoord : TEXCOORD;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
};

struct VS_OUT
{
	float4 position : POSITION;
	float4 texcoord : TEXCOORD;
	float4 texcoord7 : TEXCOORD7;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord3 : TEXCOORD3;
	float4 texcoord4 : TEXCOORD4;
};

VS_OUT main(VS_IN i)
{
	VS_OUT o;

	float4 r0;
	float4 r1;
	float3 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	r0.x = i.normal.z * 0.15915494 + 0.5;
	r0.x = frac(r0.x);
	r0.x = r0.x * 6.2831855 + -3.1415927;
	sincos(r0.x, r1.y, r1.x);
	r0.xyz = r1.yyx * i.normal.yxy;
	r1.x = i.normal.x * r1.x + -r0.x;
	r1.y = r0.z + r0.y;
	r1.zw = 0;
	r0.xz = float2(0.1, 0.5);
	r0.x = r0.x * gBiasToCamera.x;
	r2 = lerp(i.position.xyz, gViewInverse[3].xyz, r0.xxx);
	r3 = r2.y * gWorldViewProj[1];
	r3 = r2.x * gWorldViewProj[0] + r3;
	r3 = r2.z * gWorldViewProj[2] + r3;
	r3 = r3 + gWorldViewProj[3];
	o.position = r1 * gAspectRatio + r3;
	o.texcoord.w = saturate(gSuperAlpha.x * i.color.w);
	r0.xyw = r2.xyz + -gViewInverse[3].xyz;
	r1.x = r0.w * globalFogParams.x;
	r0.x = dot(r0.xyw, r0.xyw);
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = r0.x * globalFogParams.z;
	r0.y = r1.x * -1.442695;
	r0.y = exp2(r0.y);
	r0.y = -r0.y + 1;
	r0.w = 1 / r1.x;
	r1.x = (0.0001 < abs(r1.x)) ? 1 : 0;
	r0.y = r0.w * r0.y;
	r0.y = r0.x * r0.y + -r0.x;
	r0.x = r1.x * r0.y + r0.x;
	r0.x = r0.x * -globalFogParams.y;
	r0.x = r0.x * 1.442695;
	r0.x = exp2(r0.x);
	o.texcoord4.w = -r0.x + 1;
	r0.x = (r0.z < HybridAdd.x) ? 1 : 0;
	o.texcoord3.z = r0.x * -i.texcoord3.x + 1;
	r0.xyz = r2.yyy * gWorldView[1].xyz;
	r0.xyz = r2.xxx * gWorldView[0].xyz + r0.xyz;
	r0.xyz = r2.zzz * gWorldView[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gWorldView[3].xyz;
	r1 = -r0.x + gLightPosX;
	r3 = r1 * -gLightDirX;
	r1 = r1 * r1;
	r4 = -r0.y + gLightPosY;
	r0 = -r0.z + gLightPosZ;
	r3 = r4 * -gLightDirY + r3;
	r1 = r4 * r4 + r1;
	r1 = r0 * r0 + r1;
	r3 = r0 * -gLightDirZ + r3;
	r4 = r1 + 1E-05;
	r5.z = 1;
	r1 = r1 * -gLightFallOff + r5.z;
	r1 = max(r1, 0);
	r1 = r1 * r1;
	r1 = r1 * r1 + -0.1;
	r1 = max(r1, 0);
	r0 = r0 * r1;
	r1.x = rsqrt(r4.x);
	r1.y = rsqrt(r4.y);
	r1.z = rsqrt(r4.z);
	r1.w = rsqrt(r4.w);
	r3 = r1 * r3;
	r0 = r0 * r1;
	r0 = saturate(r0 * 1.1111112);
	r1 = gLightConeScale;
	r1 = saturate(r3 * r1 + gLightConeOffset);
	r0 = r0 * r1;
	r1.x = dot(gLightColR, r0);
	r1.w = dot(gLightColG, r0);
	r0.x = dot(gLightColB, r0);
	r1.z = r0.x * 1.25;
	r1.xy = r1.xw * 1.25;
	r0.xyz = max(r1.xyz, gBloodLightingTuners.xxx);
	r0.xyz = min(r0.xyz, gBloodLightingTuners.yyy);
	r0.xyz = r0.xyz * i.color.xyz;
	r0.xyz = max(r0.xyz, 0);
	r1.x = gLightIntensityClamp.x;
	r0.w = max(-r1.x, -gDirectionalLight.z);
	r0.w = min(r0.w, gLightIntensityClamp.x);
	r1.x = -r0.w + 1;
	r0.w = gNormalArc.x * r1.x + r0.w;
	r1.x = gWrapScale.x;
	r0.w = r0.w * r1.x + gWrapBias.x;
	r0.w = r0.w * gDirectionalColour.x;
	r0.w = r0.w * gDiffuse.x;
	r0.w = max(r0.w, gBloodLightingTuners.x);
	r0.w = min(r0.w, gBloodLightingTuners.y);
	r1.xyz = r0.www * i.color.xyz;
	r1.xyz = max(r1.xyz, 0);
	r1.xyz = r1.xyz + i.color.xyz;
	r0.xyz = r0.xyz + r1.xyz;
	r0.w = gLightAmbientDir0.w;
	r0.w = saturate(r0.w + gLightAmbientDir1.z);
	r1.xyz = r0.www * gLightAmbient1.xyz;
	r0.w = saturate(gLightAmbientDir0.w + gLightAmbientDir0.z);
	r1.xyz = r0.www * gLightAmbient0.xyz + r1.xyz;
	r1.xyz = r1.xyz * gBloodLightingTuners.zzz;
	r1.xyz = r1.xyz * i.color.xyz;
	r1.xyz = max(r1.xyz, 0);
	r0.xyz = r1.xyz * gAmbientShadow.xxx + r0.xyz;
	r0.w = globalScalars4.x * i.texcoord3.y;
	o.texcoord.xyz = r0.www * r0.xyz;
	r0 = r2.y * gWorldView[1];
	r0 = r2.x * gWorldView[0] + r0;
	r0 = r2.z * gWorldView[2] + r0;
	o.texcoord7 = r0 + gWorldView[3];
	o.texcoord1 = i.texcoord * gTexCoordScaleOffset0.xyxy + gTexCoordScaleOffset0.zwzw;
	o.texcoord3.xy = float2(1, 0) * i.texcoord2.zz;
	o.texcoord3.w = i.texcoord3.y;
	o.texcoord4.xyz = globalFogColorN.xyz;

	return o;
}
