sampler2D BumpSampler : register(s1);
sampler2D DiffuseSampler : register(s0);
sampler2D EnvironmentSampler : register(s3);
sampler2D PuddleMaskSampler : register(s2);
sampler2D WaterRainRippleNormalSampler : register(s14);
float4 WetDarken : register(c203);
float bumpiness : register(c199);
float fresnelRolloff : register(c201);
float4 gAmbientOcclusionEffect : register(c63);
float4 gStencil : register(c61);
float4 gWaterGlobals : register(c64);
float4 globalScalars : register(c35);
float4 globalScalars2 : register(c36);
float parallaxScaleBias : register(c196);
float reflectivePower : register(c200);
float specularColorFactor : register(c198);
float specularFactor : register(c197);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float2 texcoord6 : TEXCOORD6;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color2 : COLOR2;
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float3 r4;
	r0.z = gWaterGlobals.z;
	r0.xy = WetDarken.ww * i.texcoord6.xy;
	r1 = tex2D(PuddleMaskSampler, r0.xy);
	r0.x = r1.x + gWaterGlobals.y;
	r0.x = saturate(r0.x + -i.color.y);
	r1.x = lerp(specularColorFactor.x, r0.z, r0.x);
	r2.x = specularColorFactor.x;
	r0.yw = float2(0.5, -1);
	r2.y = max(-r0.w, specularFactor.x);
	r1.y = lerp(r2.y, gWaterGlobals.w, r0.x);
	r1.xy = (-r0.xx >= 0) ? r2.xy : r1.xy;
	r1.xy = (-i.color.yy >= 0) ? r2.xy : r1.xy;
	r2.xyz = 1E-05 + i.texcoord7.xyz;
	r0.z = dot(r2.xyz, r2.xyz);
	r0.z = rsqrt(r0.z);
	r1.zw = r0.zz * r2.xy;
	r2 = tex2D(BumpSampler, i.texcoord.xy);
	r0.y = r0.y * parallaxScaleBias.x;
	r0.y = r2.w * parallaxScaleBias.x + -r0.y;
	r0.yz = r0.yy * r1.zw + i.texcoord.xy;
	r2 = tex2D(BumpSampler, r0.yz);
	r3 = tex2D(DiffuseSampler, r0.yz);
	r0.y = dot(r2.xy, r2.xy) + -0.002;
	r1.zw = r2.xy * 2 + -1;
	r2.xy = r1.zw * bumpiness.xx;
	r0.y = (r0.y >= 0) ? 1 : 0;
	o.color2.x = r0.y * r1.x;
	r0.z = saturate(r1.y * 0.0051020407);
	r0.z = rsqrt(r0.z);
	r0.z = 1 / r0.z;
	r0.z = rsqrt(r0.z);
	o.color2.y = 1 / r0.z;
	r1.xyz = r3.xyz * WetDarken.xyz + -r3.xyz;
	r0.z = saturate(gWaterGlobals.y);
	r1.xyz = r0.zzz * r1.xyz + r3.xyz;
	r4 = r3.xyz * WetDarken.xyz;
	r1.xyz = (-r0.xxx >= 0) ? r1.xyz : r4.xyz;
	r1.xyz = (-i.color.yyy >= 0) ? r3.xyz : r1.xyz;
	r0.z = r3.w * i.color.w;
	r1.w = saturate(i.color.x * r0.y + -1);
	r1.w = r1.w * globalScalars2.z;
	o.color.xyz = r1.xyz * r0.yyy + r1.www;
	r0.y = r0.y * i.color.x;
	o.color2.z = r0.y * gAmbientOcclusionEffect.w;
	r1.xy = 0.3 * i.texcoord6.xy;
	r1 = tex2D(WaterRainRippleNormalSampler, r1.xy);
	r1.xyz = r1.xyz * 2 + -1;
	r0.y = dot(r2.xy, -r2.xy) + 1;
	r1.w = max(r0.y, 0);
	r0.y = rsqrt(r1.w);
	r2.z = 1 / r0.y;
	r1.xyz = r1.xyz * i.texcoord1.zzz + -r2.xyz;
	r1.xyz = r0.xxx * r1.xyz + r2.xyz;
	r1.xyz = r1.xyz + 1E-05;
	r3.xyz = normalize(r1.xyz);
	r1.xyz = (-r0.xxx >= 0) ? r2.xyz : r3.xyz;
	r1.xyz = (-i.color.yyy >= 0) ? r2.xyz : r1.xyz;
	r2.xyz = r1.xxx * i.texcoord4.xyz;
	r1.xzw = r1.zzz * i.texcoord1.xyz + r2.xyz;
	r1.xyz = r1.yyy * i.texcoord5.xyz + r1.xzw;
	r1.xyz = r1.xyz + 1E-05;
	r2.xyz = normalize(r1.xyz);
	o.color1.xyz = r2.xyz * 0.5 + 0.5;
	r1.xyz = 1E-05 + i.texcoord3.xyz;
	r3.xyz = normalize(r1.xyz);
	r0.x = dot(-r3.xyz, r2.xyz);
	r0.x = r0.x + r0.x;
	r1.xyz = r2.xyz * -r0.xxx + -r3.xyz;
	r0.x = saturate(dot(r3.xyz, r2.xyz));
	r0.x = -r0.x + 1.00001;
	r1.xyz = r1.xyz + 1E-05;
	r0.y = dot(r1.xyz, r1.xyz);
	r0.y = rsqrt(r0.y);
	r1.xy = r1.xz * r0.yy + 1;
	r1.xy = r1.xy * -0.5;
	r1 = tex2D(EnvironmentSampler, r1.xy);
	r0.y = r0.x * r0.x;
	r0.y = r0.y * r0.y;
	r0.x = r0.y * r0.x;
	r0.y = -r0.w + -fresnelRolloff.x;
	r0.x = fresnelRolloff.x * r0.x + r0.y;
	r0.xyw = r0.xxx * r1.xyz;
	r0.xyw = r0.xyw * reflectivePower.xxx;
	r0 = r0 * globalScalars.wwxw;
	r0.xyw = saturate(r0.xyw * 0.0625);
	r0.x = rsqrt(r0.x);
	o.color3.x = 1 / r0.x;
	r0.x = rsqrt(r0.y);
	r0.y = rsqrt(r0.w);
	o.color3.z = 1 / r0.y;
	o.color3.y = 1 / r0.x;
	o.color.w = r0.z;
	o.color1.w = r0.z;
	o.color2.w = r0.z;
	o.color3.w = gStencil.x;

	return o;
}
