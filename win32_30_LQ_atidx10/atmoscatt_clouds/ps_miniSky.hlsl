float3 AzimuthColor : register(c134);
float3 AzimuthColorEast : register(c141);
float AzimuthHeight : register(c142);
float AzimuthStrength : register(c145);
float CloudBias : register(c147);
float4 CloudColor : register(c143);
float CloudFadeOut : register(c148);
float CloudInscatteringRange : register(c158);
float CloudShadowStrength : register(c155);
float4 CloudThicknessEdgeSmoothDetailScaleStrength : register(c157);
float CloudThreshold : register(c146);
sampler2D GalaxySampler : register(s5);
float HDRExposure : register(c173);
float3 HDRExposureClamp : register(c175);
float3 HDRSunExposure : register(c174);
sampler2D HighDetailNoiseSampler : register(s7);
sampler2D PerlinNoiseSampler : register(s6);
float3 SkyColor : register(c133);
float4 StarFieldBrightness : register(c159);
float3 SunCentre : register(c130);
float3 SunColor : register(c135);
float4 SunDirection : register(c132);
float SunSize : register(c171);
float4 SunsetColor : register(c144);
float4 TopCloudBiasDetailThresholdHeight : register(c152);
float3 TopCloudColor : register(c153);

half4 main(float2 texcoord : TEXCOORD) : COLOR
{
	half4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	r0.xy = -0.5 + texcoord.xy;
	r0.zw = r0.xy * 2 + 1E-05;
	r0.xy = r0.xy + r0.xy;
	r0.x = dot(r0.xy, r0.xy) + 0;
	r0.y = dot(r0.zw, r0.zw) + 0;
	r0.y = rsqrt(r0.y);
	r0.yz = r0.yy * r0.zw;
	r0.yz = r0.yz * r0.xx;
	r0.x = rsqrt(r0.x);
	r0.x = 1 / r0.x;
	r0.x = -r0.x + 1;
	r1.xyz = r0.yxz * 4000;
	r0.xyz = r1.xyz + 1E-05;
	r1.xyz = normalize(r0.xyz);
	r0.x = saturate(r1.y * AzimuthHeight.x);
	r0.x = -r0.x + 1;
	r0.x = r0.x * AzimuthStrength.x;
	r0.y = r1.x * 0.5 + 0.5;
	r2.xyz = AzimuthColorEast.xyz;
	r2.xyz = -r2.xyz + AzimuthColor.xyz;
	r0.yzw = r0.yyy * r2.xyz + AzimuthColorEast.xyz;
	r0.xyz = r0.yzw * r0.xxx + SkyColor.xyz;
	r0.w = dot(r1.xyz, SunDirection.xyz);
	r1.z = 4;
	r1.x = saturate(r1.y * r1.z + -CloudFadeOut.x);
	r2 = float4(12.58, -0.0625, 0.5, 0.25);
	r2 = r0.w * r2 + float4(-11.616372, 0.9375, 0.5, 0.35);
	r0.w = r0.w * r0.w;
	r2.xyz = saturate(r2.xyz);
	r1.y = r2.y * r2.y;
	r1.y = r1.y * r2.y;
	r1.z = pow(r2.x, 32);
	r3.yw = float2(1E-05, 0.6);
	r1.w = saturate(r3.w + SunDirection.w);
	r1.y = r1.y * -r1.w + r1.z;
	r1.y = r2.z * SunSize.x + r1.y;
	r1.z = r2.z + -SunCentre.x;
	r1.y = saturate(r1.y * 0.5);
	r1.w = -SunCentre.x + SunCentre.y;
	r1.w = 1 / r1.w;
	r1.z = saturate(r1.w * r1.z);
	r1.w = r1.z * -2 + 3;
	r1.z = r1.z * r1.z;
	r1.z = r1.z * r1.w;
	r1.z = r1.z * SunCentre.z;
	r1.y = r1.y * 4 + r1.z;
	r2.xyz = r1.yyy * SunColor.xyz;
	r2.xyz = abs(r2.xyz) + 1E-05;
	r4.x = log2(r2.x);
	r4.y = log2(r2.y);
	r4.z = log2(r2.z);
	r2.xyz = r4.xyz * 4.00001;
	r4.x = exp2(r2.x);
	r4.y = exp2(r2.y);
	r4.z = exp2(r2.z);
	r4.xyz = r1.yyy * SunColor.xyz + r4.xyz;
	r4.w = saturate(-r1.y + 1);
	r4 = r4 * HDRSunExposure.x;
	r0.xyz = saturate(r0.xyz * r4.www);
	r1.yzw = min(HDRExposureClamp.xyz, r4.xyz);
	r0.xyz = r0.xyz + r1.yzw;
	r4 = tex2D(GalaxySampler, texcoord.xy);
	r0.xyz = r4.xyz * StarFieldBrightness.yyy + r0.xyz;
	r1.yz = CloudThicknessEdgeSmoothDetailScaleStrength.zz * texcoord.xy;
	r4 = tex2D(HighDetailNoiseSampler, r1.yz);
	r1.y = r4.x * CloudThicknessEdgeSmoothDetailScaleStrength.w;
	r4 = tex2D(PerlinNoiseSampler, texcoord.xy);
	r1.y = r1.y * 0.2 + r4.x;
	r2.x = CloudThreshold.x;
	r1.y = r2.x * r1.y + -CloudBias.x;
	r1.y = saturate(r1.y * CloudShadowStrength.x);
	r1.z = -r1.y + 1;
	r1.w = r3.y + CloudThicknessEdgeSmoothDetailScaleStrength.x;
	r3 = tex2D(HighDetailNoiseSampler, texcoord.xy);
	r2.y = r3.x + -0.5;
	r2.z = r2.y * CloudThicknessEdgeSmoothDetailScaleStrength.w + r4.x;
	r2.x = saturate(r2.x * r2.z + -CloudBias.x);
	r2.z = r2.x + 1E-05;
	r2.x = saturate(r2.x * CloudThicknessEdgeSmoothDetailScaleStrength.y);
	r3.x = pow(r2.z, r1.w);
	r1.w = r2.x * r3.x;
	r2.x = r3.x * -r2.x + 1;
	r1.z = r1.w * r1.z;
	r2.z = saturate(r2.y * 0.2 + r4.z);
	r2.y = r2.y * CloudThicknessEdgeSmoothDetailScaleStrength.w;
	r2.y = r2.y * TopCloudBiasDetailThresholdHeight.y + r4.y;
	r2.y = saturate(TopCloudBiasDetailThresholdHeight.z * r2.y + -TopCloudBiasDetailThresholdHeight.x);
	r2.y = r2.y * texcoord.x;
	r2.y = r2.x * r2.y;
	r1.z = r1.z * r2.z + r2.z;
	r1.z = r2.w * r1.z;
	r2.z = r1.y * -0.5 + r2.x;
	r1.w = r2.x * r2.y + r1.w;
	r1.x = r1.x * r1.w;
	r1.w = max(r2.z, 0);
	r0.w = r0.w * r1.w;
	r2.z = 1;
	r0.w = r0.w * CloudInscatteringRange.x + r2.z;
	r2.xzw = saturate(r0.www * CloudColor.xyz + -r1.yyy);
	r1.yzw = SunsetColor.xyz * r1.zzz + r2.xzw;
	r3.xyz = lerp(r1.yzw, TopCloudColor.xyz, r2.yyy);
	r2.xyz = half3(lerp(r0.xyz, r3.xyz, r1.xxx));
	r0.xyz = half3(r2.xyz * HDRExposure.xxx);
	o.xyz = min(r0.xyz, HDRExposureClamp.xyz);
	o.w = 1;

	return o;
}
