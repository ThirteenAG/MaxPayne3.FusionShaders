sampler2D BloodSampler : register(s2);
sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
sampler2D SpecSampler : register(s5);
sampler3D VolumeSampler : register(s6);
float bumpiness : register(c200);
float4 detailSettings : register(c207);
float fresnelRolloff : register(c199);
float4 gAmbientOcclusionEffect : register(c63);
float4 gBloodData : register(c206);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float reflectivePower : register(c197);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float3 specMapReflectMask : register(c198);
float specularFactor : register(c202);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color2 : COLOR2;
	float4 color1 : COLOR1;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float3 r8;
	float3 r9;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r0.z = dot(i.texcoord2.xyz, float3(0.3, 0.6, 0.1));
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = i.texcoord2.xyzx * float4(1, 1, 1, 0) + float4(0, 0, 0, 1);
	r3 = r1 * r2;
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.w = dot(r0.xy, -r0.xy) + 1;
	r1.w = max(r0.w, 0);
	r0.w = rsqrt(r1.w);
	r0.w = 1 / r0.w;
	r4 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r4, specMapExpMask);
	r1.w = r1.w * specularFactor.x;
	r2.w = dot(r4.xyz, specMapIntMask.xyz);
	r4.w = max(1, r1.w);
	r5.xyz = r0.xxx * i.texcoord4.xyz;
	r5.xyz = r0.www * i.texcoord1.xyz + r5.xyz;
	r0.xyw = r0.yyy * i.texcoord5.xyz + r5.xyz;
	r0.xyw = r0.xyw + 1E-05;
	r1.w = dot(r0.xyw, r0.xyw);
	r1.w = rsqrt(r1.w);
	r5.xyz = r0.xyw * r1.www;
	r6.y = 0;
	if (-reflectivePower.x < r6.y) {
		r5.w = saturate(r4.w * 0.015625);
		r7.w = r5.w * -4 + 4;
		r6.xzw = 1E-05 + i.texcoord3.xyz;
		r8 = normalize(r6.xzw);
		r5.w = dot(-r8.xyz, r5.xyz);
		r5.w = r5.w + r5.w;
		r6.xzw = r5.xyz * -r5.www + -r8.xyz;
		r6.xzw = r6.xzw + 1E-05;
		r9 = normalize(r6.xzw);
		r5.w = saturate(r9.z);
		r5.w = r5.w + 1;
		r5.w = r5.w + r5.w;
		r5.w = 1 / r5.w;
		r6.xz = r9.xy * r5.ww + 0.5;
		r7.xy = -r6.xz + 1;
		r7.z = 0;
		r7 = tex2Dlod(DynamicEnvironmentSampler, r7);
		r6.xzw = r7.xyz * r7.xyz;
		r6.xzw = r6.xzw * 16;
		r5.x = saturate(dot(r8.xyz, r5.xyz));
		r7.x = 1;
		r5.y = r7.x + -fresnelRolloff.x;
		r5.x = -r5.x + 1.00001;
		r5.z = r5.x * r5.x;
		r5.z = r5.z * r5.z;
		r5.x = r5.z * r5.x;
		r5.x = fresnelRolloff.x * r5.x + r5.y;
		r5.xyz = r5.xxx * r6.xzw;
	} else {
		r5.xyz = 0;
	}
	r5.xyz = r5.xyz * reflectivePower.xxx;
	r4.x = dot(r4.xyz, specMapReflectMask.xyz);
	r5.xyz = r4.xxx * r5.xyz;
	r5.xyz = r5.xyz * ColorCorrectTopAndPedReflectScale.www;
	if (-gBloodData.w < r6.y) {
		r6 = tex2D(BloodSampler, i.texcoord.zw);
		r7.z = min(r6.y, r6.x);
		r4.x = saturate(r6.x * 0.5 + r6.w);
		r7.xy = r6.xy;
		r1.xyz = r2.xyz * -r1.xyz + r7.xyz;
		r3.xyz = r4.xxx * r1.xyz + r3.xyz;
	}
	r0.xyw = r0.xyw * r1.www + 1E-05;
	r1.x = dot(r0.xyw, r0.xyw);
	r1.x = rsqrt(r1.x);
	r1.yzw = r0.xyw * r1.xxx;
	r2.x = r3.w * i.texcoord2.w;
	r4.x = 1;
	r0.z = r0.z * globalScalars.z + -r4.x;
	r0.z = gAmbientOcclusionEffect.x * r0.z + r4.x;
	r3.xyz = r3.xyz * matMaterialColorScale.xxx;
	r5.xyz = r5.xyz * matMaterialColorScale.zzz;
	r2.y = r2.w * matMaterialColorScale.w;
	r2.z = r4.w * matMaterialColorScale.w;
	r4.xyw = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r4.xyw = r4.xyw + 1E-05;
	r6.xyz = normalize(r4.xyw);
	r0.xyw = r0.xyw * r1.xxx + 1E-05;
	r7.xyz = normalize(r0.xyw);
	r0.x = dot(r6.xyz, r7.xyz);
	r0.y = r0.x * 1.5 + 1;
	r0.x = (-r0.x >= 0) ? r0.y : 1;
	r0.y = r0.x * i.texcoord2.y;
	r0.w = saturate(r2.y * 5);
	r0.y = r0.w * r0.y;
	r1.x = r2.z * 0.0051020407;
	r0.w = saturate(r2.z * -0.01 + 1);
	r0.y = r0.y * r0.w;
	r0.x = (r0.x >= 0) ? r0.y : 0;
	r0.x = r2.w * matMaterialColorScale.w + r0.x;
	r0.y = r4.z * 16;
	r0.w = frac(r0.y);
	r0.y = r0.y + -r0.w;
	r0.w = (-r0.w >= 0) ? 0 : 1;
	r0.w = (r4.z >= 0) ? 0 : r0.w;
	r0.y = r0.w + r0.y;
	r4.xy = detailSettings.zw * i.texcoord.xy;
	r0.y = r0.y + 0.5;
	r4.z = r0.y * 0.0625;
	r4 = tex3D(VolumeSampler, r4.xyz);
	r2.yzw = r4.yzx * 2 + -1;
	r0.y = detailSettings.x * i.texcoord2.w;
	r0.y = r2.w * r0.y + 1;
	o.color.xyz = r0.yyy * r3.xyz;
	r3.xyz = r2.zzz * i.texcoord5.xyz;
	r2.yzw = i.texcoord4.xyz * r2.yyy + r3.xyz;
	r2.yzw = r2.yzw * detailSettings.yyy;
	r1.yzw = r2.yzw * i.texcoord2.www + r1.yzw;
	r1.yzw = r1.yzw + 1E-05;
	r3.xyz = normalize(r1.yzw);
	o.color2.x = saturate(r0.y * r0.x);
	r0.x = saturate(gAmbientOcclusionEffect.z);
	r0.x = saturate(r0.x + r0.z);
	o.color1.xyz = r3.xyz * 0.5 + 0.5;
	r1.x = saturate(r1.x);
	r0.y = rsqrt(r1.x);
	r0.y = 1 / r0.y;
	r0.y = rsqrt(r0.y);
	o.color2.y = 1 / r0.y;
	o.color2.z = r0.x * gAmbientOcclusionEffect.w;
	r0.x = r2.x * globalScalars.x;
	r0.yzw = saturate(r5.xyz * 0.0625);
	r0.y = rsqrt(r0.y);
	r0.z = rsqrt(r0.z);
	r0.w = rsqrt(r0.w);
	o.color3.x = 1 / r0.y;
	o.color3.y = 1 / r0.z;
	o.color3.z = 1 / r0.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.w = r0.x;
	o.color3.w = gStencil.x;

	return o;
}
