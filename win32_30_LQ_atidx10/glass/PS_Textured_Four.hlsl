sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
float4 deSatContrastGamma : register(c46);
float fresnelRolloff : register(c199);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float reflectivePower : register(c198);
float specularColorFactor : register(c197);
float specularFactor : register(c196);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float4 r8;
	float4 r9;
	float4 r10;
	float4 r11;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1.xyz = 1E-05 + i.texcoord1.xyz;
	r2.xyz = normalize(r1.xyz);
	r1.yz = float2(1, 0);
	r2.w = max(r1.y, specularFactor.x);
	if (-reflectivePower.x < r1.z) {
		r1.x = saturate(r2.w * 0.015625);
		r3.w = r1.x * -4 + 4;
		r1.xzw = 1E-05 + i.texcoord3.xyz;
		r4.xyz = normalize(r1.xzw);
		r1.x = dot(-r4.xyz, r2.xyz);
		r1.x = r1.x + r1.x;
		r1.xzw = r2.xyz * -r1.xxx + -r4.xyz;
		r1.xzw = r1.xzw + 1E-05;
		r5.xyz = normalize(r1.xzw);
		r1.x = saturate(r5.z);
		r1.x = r1.x + 1;
		r1.x = r1.x + r1.x;
		r1.x = 1 / r1.x;
		r1.xz = r5.xy * r1.xx + 0.5;
		r3.xy = -r1.xz + 1;
		r3.z = 0;
		r3 = tex2Dlod(DynamicEnvironmentSampler, r3);
		r1.xzw = r3.xyz * r3.xyz;
		r1.xzw = r1.xzw * 16;
		r3.x = saturate(dot(r4.xyz, r2.xyz));
		r3.y = r1.y + -fresnelRolloff.x;
		r3.x = -r3.x + 1.00001;
		r3.z = r3.x * r3.x;
		r3.z = r3.z * r3.z;
		r3.x = r3.z * r3.x;
		r3.x = fresnelRolloff.x * r3.x + r3.y;
		r1.xzw = r1.xzw * r3.xxx;
	} else {
		r1.xzw = 0;
	}
	r1.xzw = r1.xzw * reflectivePower.xxx;
	r3.x = saturate(globalScalars.w);
	r1.xzw = r1.xzw * r3.xxx;
	r0.xyz = r0.xyz * r0.xyz;
	r3.x = r0.w * i.color.w;
	r3.yzw = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r3.yzw);
	r3.y = saturate(r2.z * -0.5 + 0.5);
	r5.xyz = gLightAmbient0.xyz;
	r5.xyz = -r5.xyz + gLightAmbient1.xyz;
	r3.yzw = r3.yyy * r5.xyz + gLightAmbient0.xyz;
	r3.yzw = r3.yzw * gAmbientOcclusionEffect.yyy;
	r4.w = dot(-r4.xyz, r2.xyz);
	r4.w = r4.w + r4.w;
	r4.xyz = r2.xyz * -r4.www + -r4.xyz;
	r4.w = dot(r2.xyz, -gDirectionalLight.xyz);
	r5.x = saturate(r4.w + -0.25);
	r5.x = r5.x * 1.3333334;
	r5.y = saturate(dot(-gDirectionalLight.xyz, r4.xyz));
	r5.y = r5.y + 1E-05;
	r5.z = r2.w + 1E-05;
	r6.x = pow(r5.y, r5.z);
	r4.w = saturate(r4.w * 2 + -0.5);
	r4.w = r4.w * r6.x;
	r5.yzw = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r5.yzw = i.texcoord6.xxx * gShadowMatrix[0].xyz + r5.yzw;
	r5.yzw = i.texcoord6.zzz * gShadowMatrix[2].xyz + r5.yzw;
	r5.yzw = r5.yzw + gShadowMatrix[3].xyz;
	r6.xy = r5.yz + -gShadowParam18192021.zw;
	r6.zw = r6.xx + -gCascadeXMaxThresholds.xy;
	r6.zw = (r6.zw >= 0) ? 1 : 0;
	r7.xy = -r6.xx + gCascadeXMinThresholds.xy;
	r7.zw = r6.yy + -gCascadeYMaxThresholds.xy;
	r7 = (r7 >= 0) ? 1 : 0;
	r8.xy = -r6.yy + gCascadeYMinThresholds.xy;
	r8.xy = (r8.xy >= 0) ? 1 : 0;
	r6.zw = r6.zw + r7.xy;
	r6.zw = r7.zw + r6.zw;
	r7.yz = saturate(r8.xy + r6.zw);
	r7.x = 1;
	r8.x = dot(r7.xyz, gShadowParam0123.xyz);
	r8.y = dot(r7.xyz, gShadowParam4567.xyz);
	r8.z = dot(r7.xyz, gCascadeZScales.xyz);
	r9.x = dot(r7.xyz, gShadowParam891113.xyz);
	r9.y = dot(r7.xyz, gShadowParam14151617.xyz);
	r9.z = dot(r7.xyz, gCascadeZOffsets.xyz);
	r5.yzw = r5.wyz * r8.zxy + r9.zxy;
	r5.y = saturate(r5.y);
	r7.x = -gCascadeXMinThresholds.w;
	r7.y = -gCascadeXMaxThresholds.w;
	r6.xy = saturate(abs(r6.xy) * 4 + r7.xy);
	r7.x = max(r6.x, r6.y);
	r5.y = -r5.y + 1;
	r6 = tex2D(gShadowZSamplerDir, r5.zw);
	r5.y = r5.y + -r6.x;
	r5.y = (r5.y >= 0) ? -1 : -0;
	r5.y = r5.y + r7.x;
	r5.y = saturate(r5.y + 1);
	r5.yzw = r5.yyy * gDirectionalColour.xyz;
	r6.xyz = r4.www * r5.yzw;
	r5.xyz = r5.xxx * r5.yzw;
	r3.yzw = r3.yzw * i.color.xxx + r5.xyz;
	r5 = gLightPosX + -i.texcoord6.x;
	r7 = gLightPosY + -i.texcoord6.y;
	r8 = gLightPosZ + -i.texcoord6.z;
	r9 = r5 * r5;
	r9 = r7 * r7 + r9;
	r9 = r8 * r8 + r9;
	r10 = r9 + 1E-05;
	r11.x = rsqrt(r10.x);
	r11.y = rsqrt(r10.y);
	r11.z = rsqrt(r10.z);
	r11.w = rsqrt(r10.w);
	r5 = r5 * r11;
	r7 = r7 * r11;
	r8 = r8 * r11;
	r9 = saturate(r9 * -gLightFallOff + r1.y);
	r9 = r9 * r9;
	r9 = r9 * r9 + -0.1;
	r10 = r9 * 1.1111112;
	r9 = (r9 >= 0) ? r10 : 0;
	r10 = r2.x * r5;
	r10 = r7 * r2.y + r10;
	r10 = r8 * r2.z + r10;
	r9 = saturate(r9 * r10);
	r10 = r5 * -gLightDirX;
	r10 = r7 * -gLightDirY + r10;
	r10 = r8 * -gLightDirZ + r10;
	r11 = gLightConeScale;
	r10 = saturate(r10 * r11 + gLightConeOffset);
	r9 = r9 * r10;
	r5 = r4.x * r5;
	r5 = r4.y * r7 + r5;
	r4 = saturate(r4.z * r8 + r5);
	r4 = r4 + 1E-05;
	r1.y = r2.w * 0.25 + 1E-05;
	r2.x = log2(r4.x);
	r2.y = log2(r4.y);
	r2.z = log2(r4.z);
	r2.w = log2(r4.w);
	r2 = r1.y * r2;
	r4.x = exp2(r2.x);
	r4.y = exp2(r2.y);
	r4.z = exp2(r2.z);
	r4.w = exp2(r2.w);
	r2 = r9 * r4;
	r4.x = dot(gLightColR, r9);
	r4.y = dot(gLightColG, r9);
	r4.z = dot(gLightColB, r9);
	r5.x = dot(gLightColR, r2);
	r5.y = dot(gLightColG, r2);
	r5.z = dot(gLightColB, r2);
	r2.xyz = r3.yzw + r4.xyz;
	r3.yzw = r6.xyz * gDirectionalLight.www + r5.xyz;
	r0.w = r0.w * i.color.w + -0.01;
	r1.y = 1 / r3.x;
	r0.w = (r0.w >= 0) ? r1.y : 100;
	r1.xyz = r0.www * r1.xzw;
	r0.w = dot(r2.xyz, 0.33333334);
	r0.w = r0.w + 0.015;
	r1.xyz = r0.www * r1.xyz;
	r1.xyz = r3.yzw * specularColorFactor.xxx + r1.xyz;
	r0.xyz = r0.xyz * r2.xyz + r1.xyz;
	r1.w = r3.x * globalScalars.x;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r2.x = 1E-05 + i.texcoord9.y;
	r3.x = pow(r0.w, r2.x);
	r2.xyz = r0.xyz * r3.xxx;
	r0.xyz = r0.xyz * -r3.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r2.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.x = gAdrenoFXVars.x;
	r2.x = r2.x * deSatContrastGamma.x;
	r1.xyz = lerp(r0.www, r0.xyz, r2.xxx);
	o = min(r1, float4(8, 8, 8, 1));

	return o;
}
