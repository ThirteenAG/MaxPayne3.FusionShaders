sampler2D DiffuseSampler : register(s0);
float4 colorize : register(c47);
float4 deSatContrastGamma : register(c46);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
float4 gLightColB : register(c32);
float4 gLightColG : register(c31);
float4 gLightColR : register(c30);
float4 gLightConeOffset : register(c29);
float4 gLightConeScale : register(c28);
float4 gLightDirX : register(c24);
float4 gLightDirY : register(c25);
float4 gLightDirZ : register(c26);
float4 gLightFallOff : register(c27);
float4 gLightPosX : register(c21);
float4 gLightPosY : register(c22);
float4 gLightPosZ : register(c23);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
float4 globalFogColorN : register(c50);
float4 globalScalars : register(c35);
float specularColorFactor : register(c199);
float specularFactor : register(c198);

struct PS_IN
{
	float4 color : COLOR;
	float2 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord6 : TEXCOORD6;
	float2 texcoord9 : TEXCOORD9;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float4 r6;
	float4 r7;
	float3 r8;
	r0 = gLightPosX + -i.texcoord6.x;
	r1 = r0 * r0;
	r2 = gLightPosY + -i.texcoord6.y;
	r1 = r2 * r2 + r1;
	r3 = gLightPosZ + -i.texcoord6.z;
	r1 = r3 * r3 + r1;
	r4 = r1 + 1E-05;
	r5.y = 1;
	r1 = saturate(r1 * -gLightFallOff + r5.y);
	r1 = r1 * r1;
	r1 = r1 * r1 + -0.1;
	r6.x = rsqrt(r4.x);
	r6.y = rsqrt(r4.y);
	r6.z = rsqrt(r4.z);
	r6.w = rsqrt(r4.w);
	r0 = r0 * r6;
	r4 = r0 * -gLightDirX;
	r2 = r2 * r6;
	r3 = r3 * r6;
	r4 = r2 * -gLightDirY + r4;
	r4 = r3 * -gLightDirZ + r4;
	r6 = gLightConeScale;
	r4 = saturate(r4 * r6 + gLightConeOffset);
	r6 = r1 * 1.1111112;
	r1 = (r1 >= 0) ? r6 : 0;
	r5.xzw = 1E-05 + i.texcoord1.xyz;
	r6.xyz = normalize(r5.xzw);
	r7 = r0 * r6.x;
	r7 = r2 * r6.y + r7;
	r7 = r3 * r6.z + r7;
	r1 = saturate(r1 * r7);
	r1 = r1 * r4;
	r4.xyz = 1E-05 + i.texcoord3.xyz;
	r7.xyz = normalize(r4.xyz);
	r4.x = dot(-r7.xyz, r6.xyz);
	r4.x = r4.x + r4.x;
	r4.xyz = r6.xyz * -r4.xxx + -r7.xyz;
	r0 = r0 * r4.x;
	r0 = r4.y * r2 + r0;
	r0 = saturate(r4.z * r3 + r0);
	r2.x = saturate(dot(-gDirectionalLight.xyz, r4.xyz));
	r2.x = r2.x + 1E-05;
	r0 = r0 + 1E-05;
	r3.x = log2(r0.x);
	r3.y = log2(r0.y);
	r3.z = log2(r0.z);
	r3.w = log2(r0.w);
	r0.x = max(r5.y, specularFactor.x);
	r0.y = r0.x * 0.25 + 1E-05;
	r0.x = r0.x + 1E-05;
	r4.x = pow(r2.x, r0.x);
	r0 = r3 * r0.y;
	r2.x = exp2(r0.x);
	r2.y = exp2(r0.y);
	r2.z = exp2(r0.z);
	r2.w = exp2(r0.w);
	r0 = r1 * r2;
	r2.x = dot(gLightColR, r0);
	r2.y = dot(gLightColG, r0);
	r2.z = dot(gLightColB, r0);
	r0.xyz = gShadowMatrix[1].xyz * i.texcoord6.yyy;
	r0.xyz = i.texcoord6.xxx * gShadowMatrix[0].xyz + r0.xyz;
	r0.xyz = i.texcoord6.zzz * gShadowMatrix[2].xyz + r0.xyz;
	r0.xyz = r0.xyz + gShadowMatrix[3].xyz;
	r3.xy = r0.xy + -gShadowParam18192021.zw;
	r3.zw = r3.xx + -gCascadeXMaxThresholds.xy;
	r3.zw = (r3.zw >= 0) ? 1 : 0;
	r4.yz = -r3.xx + gCascadeXMinThresholds.xy;
	r4.yz = (r4.yz >= 0) ? 1 : 0;
	r3.zw = r3.zw + r4.yz;
	r4.yz = r3.yy + -gCascadeYMaxThresholds.xy;
	r4.yz = (r4.yz >= 0) ? 1 : 0;
	r3.zw = r3.zw + r4.yz;
	r4.yz = -r3.yy + gCascadeYMinThresholds.xy;
	r4.yz = (r4.yz >= 0) ? 1 : 0;
	r5.yz = saturate(r3.zw + r4.yz);
	r5.x = 1;
	r7.x = dot(r5.xyz, gShadowParam0123.xyz);
	r7.y = dot(r5.xyz, gShadowParam4567.xyz);
	r7.z = dot(r5.xyz, gCascadeZScales.xyz);
	r8.x = dot(r5.xyz, gShadowParam891113.xyz);
	r8.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r8.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r0.xyz = r0.zxy * r7.zxy + r8.zxy;
	r0.x = saturate(r0.x);
	r5 = tex2D(gShadowZSamplerDir, r0.yz);
	r0.x = -r0.x + 1;
	r0.x = -r5.x + r0.x;
	r0.x = (r0.x >= 0) ? -1 : -0;
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r0.yz = saturate(abs(r3.xy) * 4 + r5.xy);
	r2.w = max(r0.y, r0.z);
	r0.x = r0.x + r2.w;
	r0.x = saturate(r0.x + 1);
	r0.xyz = r0.xxx * gDirectionalColour.xyz;
	r0.w = dot(r6.xyz, -gDirectionalLight.xyz);
	r2.w = saturate(r6.z * -0.5 + 0.5);
	r3.x = saturate(r0.w * 2 + -0.5);
	r0.w = saturate(r0.w + -0.25);
	r0.w = r0.w * 1.3333334;
	r3.yzw = r0.www * r0.xyz;
	r0.w = r3.x * r4.x;
	r0.xyz = r0.www * r0.xyz;
	r0.xyz = r0.xyz * gDirectionalLight.www + r2.xyz;
	r0.xyz = r0.xyz * specularColorFactor.xxx;
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r2.xyz = r2.www * r2.xyz + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r2.xyz * i.color.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r2.xyz = r2.xyz * r0.www + r3.yzw;
	r3.x = dot(gLightColR, r1);
	r3.y = dot(gLightColG, r1);
	r3.z = dot(gLightColB, r1);
	r1.xyz = r2.xyz + r3.xyz;
	r2 = tex2D(DiffuseSampler, i.texcoord.xy);
	r2 = r2 * colorize;
	r2.xyz = r2.xyz * r2.xyz;
	r0.w = r2.w * i.color.w;
	r3.w = r0.w * globalScalars.x;
	r0.xyz = r2.xyz * r1.xyz + r0.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r0.w = r0.w + 1E-05;
	r0.w = abs(r0.w) + 1E-05;
	r1.x = 1E-05 + i.texcoord9.y;
	r2.x = pow(r0.w, r1.x);
	r1.xyz = r0.xyz * r2.xxx;
	r0.xyz = r0.xyz * -r2.xxx + globalFogColorN.xyz;
	r0.xyz = i.texcoord9.xxx * r0.xyz + r1.xyz;
	r0.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.x = gAdrenoFXVars.x;
	r1.x = r1.x * deSatContrastGamma.x;
	r3.xyz = lerp(r0.www, r0.xyz, r1.xxx);
	o = min(r3, float4(8, 8, 8, 1));

	return o;
}
