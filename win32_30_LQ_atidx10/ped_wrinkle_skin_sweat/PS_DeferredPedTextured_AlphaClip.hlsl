sampler2D BloodSampler : register(s2);
sampler2D BumpSampler : register(s4);
sampler2D DiffuseSampler : register(s0);
float4 SkinParams : register(c215);
sampler2D SpecSampler : register(s5);
float4 SubColor : register(c196);
float SubScatWidth : register(c198);
float SubScatWrap : register(c197);
sampler2D SweatMapSampler : register(s11);
sampler3D VolumeSampler : register(s6);
sampler2D WrinkleMaskSampler_0 : register(s7);
sampler2D WrinkleMaskSampler_1 : register(s8);
sampler2D WrinkleSampler_A : register(s9);
sampler2D WrinkleSampler_B : register(s10);
float bumpiness : register(c200);
float4 detailSettings : register(c207);
float4 gAmbientOcclusionEffect : register(c63);
float4 gBloodData : register(c206);
float4 gDirectionalLight : register(c19);
float4 gStencil : register(c61);
row_major float4x4 gViewInverse : register(c12);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c205);
float4 specMapExpMask : register(c204);
float3 specMapIntMask : register(c203);
float specularFactor : register(c202);
float4 vNoiseParams : register(c214);
float4 vSkinSweat : register(c216);
float4 wrinkleMaskStrengths0 : register(c210);
float4 wrinkleMaskStrengths1 : register(c211);
float4 wrinkleMaskStrengths2 : register(c212);
float4 wrinkleMaskStrengths3 : register(c213);

struct PS_IN
{
	float4 texcoord : TEXCOORD;
	float3 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float3 texcoord7 : TEXCOORD7;
};

struct PS_OUT
{
	float4 color : COLOR;
	float4 color1 : COLOR1;
	float4 color2 : COLOR2;
	float4 color3 : COLOR3;
};

PS_OUT main(PS_IN i)
{
	PS_OUT o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float3 r5;
	float3 r6;
	r0 = tex2D(DiffuseSampler, i.texcoord.xy);
	r1 = tex2D(SpecSampler, i.texcoord.xy);
	r1.w = dot(r1, specMapExpMask);
	r1.w = r1.w * specularFactor.x;
	r1.x = dot(r1.xyz, specMapIntMask.xyz);
	r2.x = max(1, r1.w);
	r3 = tex2D(WrinkleMaskSampler_0, i.texcoord.xy);
	r4 = tex2D(WrinkleMaskSampler_1, i.texcoord.xy);
	r1.y = dot(wrinkleMaskStrengths0, r3);
	r1.w = dot(wrinkleMaskStrengths1, r4);
	r1.y = r1.w + r1.y;
	r1.w = dot(wrinkleMaskStrengths2, r3);
	r2.y = dot(wrinkleMaskStrengths3, r4);
	r1.w = r1.w + r2.y;
	r3 = tex2D(BumpSampler, i.texcoord.xy);
	r2.y = -r3.w + 1;
	r2.y = -r3.x + r2.y;
	r2.yz = (r2.yy >= 0) ? r3.wy : r3.xy;
	r2.yz = r2.yz + -0.5;
	r2.yz = r2.yz * bumpiness.xx;
	r2.yz = r2.yz + r2.yz;
	r3 = tex2D(WrinkleSampler_A, i.texcoord.xy);
	r2.w = -r3.w + 1;
	r2.w = -r3.x + r2.w;
	r3.xy = (r2.ww >= 0) ? r3.wy : r3.xy;
	r4 = tex2D(WrinkleSampler_B, i.texcoord.xy);
	r2.w = -r4.w + 1;
	r2.w = -r4.x + r2.w;
	r3.zw = (r2.ww >= 0) ? r4.wy : r4.xy;
	r3 = r3 + -0.5;
	r3.xy = r3.xy * 2 + -r2.yz;
	r2.yz = r1.yy * r3.xy + r2.yz;
	r3.xy = r3.zw * 2 + -r2.yz;
	r3.xy = r1.ww * r3.xy + r2.yz;
	r1.y = dot(r3.xy, -r3.xy) + 1;
	r2.y = max(r1.y, 0);
	r1.y = rsqrt(r2.y);
	r3.z = 1 / r1.y;
	r2.yzw = r3.xyz + 1E-05;
	r3.xyz = normalize(r2.yzw);
	r2.yzw = r3.xxx * i.texcoord4.xyz;
	r2.yzw = i.texcoord1.xyz * r3.zzz + r2.yzw;
	r2.yzw = i.texcoord5.xyz * r3.yyy + r2.yzw;
	r2.yzw = r2.yzw + 1E-05;
	r1.y = dot(r2.yzw, r2.yzw);
	r1.y = rsqrt(r1.y);
	r3.xzw = float3(1, 2, 0);
	if (-gBloodData.w < r3.w) {
		r4 = tex2D(BloodSampler, i.texcoord.zw);
		r5.z = min(r4.y, r4.x);
		r1.w = saturate(r4.x * 0.5 + r4.w);
		r5.xy = r4.xy;
		r4.xyz = lerp(r0.xyz, r5.xyz, r1.www);
		r0.xyz = r4.xyz;
	}
	r2.yzw = r2.yzw * r1.yyy + 1E-05;
	r1.y = dot(r2.yzw, r2.yzw);
	r1.y = rsqrt(r1.y);
	r4.xyz = r1.yyy * r2.yzw;
	r1.w = dot(gDirectionalLight.xyz, r4.xyz);
	r1.w = r1.w + SubScatWrap.x;
	r3.y = r3.x + SubScatWrap.x;
	r3.y = 1 / r3.y;
	r1.w = r1.w * r3.y;
	r3.y = max(r1.w, 0);
	r1.w = 1 / SubScatWidth.x;
	r1.w = saturate(r1.w * r3.y);
	r4.w = r1.w * -2 + 3;
	r1.w = r1.w * r1.w;
	r1.w = r1.w * r4.w;
	r3.y = SubScatWidth.x * -r3.z + r3.y;
	r3.z = 1 / -SubScatWidth.x;
	r3.y = saturate(r3.z * r3.y);
	r3.z = r3.y * -2 + 3;
	r3.y = r3.y * r3.y;
	r3.y = r3.y * r3.z;
	r1.w = r1.w * r3.y;
	r5 = r1.www * SubColor.xyz;
	r5 = r0.www * r5.xyz;
	r0.xyz = r5.xyz * 0.5 + r0.xyz;
	r0.xyz = r0.xyz * matMaterialColorScale.xxx;
	r0.w = r1.x * matMaterialColorScale.w;
	r1.w = r2.x * matMaterialColorScale.w;
	r5 = -gViewInverse[3].xyz + i.texcoord7.xyz;
	r5 = r5.xyz + 1E-05;
	r6 = normalize(r5.xyz);
	r2.xyz = r2.yzw * r1.yyy + 1E-05;
	r5 = normalize(r2.xyz);
	r1.y = dot(r6.xyz, r5.xyz);
	r2.x = r1.y * 1.5 + 1;
	r1.y = (-r1.y >= 0) ? r2.x : 1;
	r2.x = r1.y * i.texcoord2.y;
	r0.w = saturate(r0.w * 5);
	r0.w = r0.w * r2.x;
	r2.x = saturate(r1.w * -0.01 + 1);
	r0.w = r0.w * r2.x;
	r0.w = (r1.y >= 0) ? r0.w : 0;
	r0.w = r1.x * matMaterialColorScale.w + r0.w;
	r1.x = r1.z * 16;
	r1.y = frac(r1.x);
	r1.x = r1.x + -r1.y;
	r1.y = (-r1.y >= 0) ? 0 : 1;
	r1.y = (r1.z >= 0) ? 0 : r1.y;
	r1.x = r1.y + r1.x;
	r2.xy = detailSettings.zw * i.texcoord.xy;
	r1.x = r1.x + 0.5;
	r2.z = r1.x * 0.0625;
	r2 = tex3D(VolumeSampler, r2.xyz);
	r1.xyz = r2.yzx * 2 + -1;
	r2.x = detailSettings.x * i.texcoord2.w;
	r1.z = r1.z * r2.x + 1;
	o.color.xyz = r0.xyz * r1.zzz;
	r0.xyz = r1.yyy * i.texcoord5.xyz;
	r0.xyz = i.texcoord4.xyz * r1.xxx + r0.xyz;
	r0.xyz = r0.xyz * detailSettings.yyy;
	r0.xyz = r0.xyz * i.texcoord2.www + r4.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r2.xyz = normalize(r0.xyz);
	r0.x = saturate(r0.w * r1.z);
	r1.x = vSkinSweat.x;
	r0.x = SkinParams.x * r1.x + r0.x;
	r4.y = SkinParams.y * r1.x + r1.w;
	r0.yz = r1.xx * vNoiseParams.zw;
	r0.y = r1.z * r0.y + r0.z;
	r4.x = r0.y + r0.x;
	r0 = tex2D(SweatMapSampler, i.texcoord.xy);
	r0.w = -r0.z + vSkinSweat.y;
	r1.xy = r0.zz + -vSkinSweat.zy;
	r0.z = 1 / vSkinSweat.w;
	r0.z = saturate(r0.z * r1.y);
	r1.yz = lerp(r4.xy, vNoiseParams.xy, r0.zz);
	r0.xy = r0.xy + -0.5;
	r0.xy = r0.xy * SkinParams.zz;
	r0.xy = r0.xy + r0.xy;
	r1.w = dot(r0.xy, -r0.xy) + 1;
	r2.w = max(r1.w, 0);
	r1.w = rsqrt(r2.w);
	r1.w = 1 / r1.w;
	r5 = r0.xxx * i.texcoord4.xyz;
	r5 = i.texcoord1.xyz * r1.www + r5.xyz;
	r5 = r0.yyy * i.texcoord5.xyz + r5.xyz;
	r5 = r5.xyz + 1E-05;
	r0.x = dot(r5.xyz, r5.xyz);
	r0.x = rsqrt(r0.x);
	r5 = r5.xyz * r0.xxx + -r2.xyz;
	r0.xyz = r0.zzz * r5.xyz + r2.xyz;
	r0.xyz = r0.xyz + 1E-05;
	r5 = normalize(r0.xyz);
	r0.x = (r1.x >= 0) ? -0 : -1;
	r0.x = (r0.w >= 0) ? -0 : r0.x;
	r0.yzw = (r0.xxx >= 0) ? r2.xyz : r5.xyz;
	r1.xy = (r0.xx >= 0) ? r4.xy : r1.yz;
	r0.x = saturate(gAmbientOcclusionEffect.z);
	r0.x = saturate(r0.x + i.texcoord2.x);
	o.color1.xyz = r0.yzw * 0.5 + 0.5;
	r0.y = saturate(r1.y * 0.0051020407);
	r0.y = rsqrt(r0.y);
	r0.y = 1 / r0.y;
	r0.y = rsqrt(r0.y);
	o.color2.y = 1 / r0.y;
	o.color2.z = r0.x * gAmbientOcclusionEffect.w;
	r0.x = globalScalars.x * i.texcoord2.w;
	o.color.w = r0.x;
	o.color1.w = r0.x;
	o.color2.x = r1.x;
	o.color2.w = r0.x;
	o.color3 = r3.wwwx * gStencil.x;

	return o;
}
