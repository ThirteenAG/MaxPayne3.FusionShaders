sampler2D BumpSampler : register(s4);
float4 ColorCorrectTopAndPedReflectScale : register(c43);
sampler2D DiffuseSampler : register(s0);
sampler2D DynamicEnvironmentSampler : register(s13);
sampler2D SpecSampler : register(s5);
float bumpiness : register(c203);
float4 deSatContrastGamma : register(c46);
float fresnelRolloff : register(c202);
float4 gAdrenoFXVars : register(c68);
float4 gAmbientOcclusionEffect : register(c63);
float4 gCascadeXMaxThresholds : register(c95);
float4 gCascadeXMinThresholds : register(c94);
float4 gCascadeYMaxThresholds : register(c100);
float4 gCascadeYMinThresholds : register(c99);
float4 gCascadeZOffsets : register(c93);
float4 gCascadeZScales : register(c92);
float4 gDepthFxParams : register(c18);
float4 gDirectionalColour : register(c20);
float4 gDirectionalLight : register(c19);
float4 gLightAmbient0 : register(c33);
float4 gLightAmbient1 : register(c34);
row_major float4x4 gShadowMatrix : register(c57);
float4 gShadowParam0123 : register(c54);
float4 gShadowParam14151617 : register(c53);
float4 gShadowParam18192021 : register(c49);
float4 gShadowParam4567 : register(c55);
float4 gShadowParam891113 : register(c56);
sampler2D gShadowZSamplerDir : register(s15);
row_major float4x4 gViewInverse : register(c12);
float4 globalFogColorN : register(c50);
float4 globalFogParams : register(c37);
float4 globalScalars : register(c35);
float4 matMaterialColorScale : register(c209);
float reflectivePower : register(c200);
float4 specMapExpMask : register(c207);
float3 specMapIntMask : register(c206);
float3 specMapReflectMask : register(c201);
float specularFactor : register(c205);

struct PS_IN
{
	float2 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float3 texcoord2 : TEXCOORD2;
	float3 texcoord3 : TEXCOORD3;
	float3 texcoord4 : TEXCOORD4;
	float3 texcoord5 : TEXCOORD5;
	float4 texcoord7 : TEXCOORD7;
};

float4 main(PS_IN i) : COLOR
{
	float4 o;

	float4 r0;
	float4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	float3 r7;
	r0 = tex2D(BumpSampler, i.texcoord.xy);
	r0.z = -r0.w + 1;
	r0.z = -r0.x + r0.z;
	r0.xy = (r0.zz >= 0) ? r0.wy : r0.xy;
	r1 = tex2D(DiffuseSampler, i.texcoord.xy);
	r0.xy = r0.xy * 2 + -1;
	r0.xy = r0.xy * bumpiness.xx;
	r0.z = dot(r0.xy, -r0.xy) + 1;
	r1.w = max(r0.z, 0);
	r0.z = rsqrt(r1.w);
	r0.z = 1 / r0.z;
	r2 = tex2D(SpecSampler, i.texcoord.xy);
	r0.w = dot(r2, specMapExpMask);
	r0.w = r0.w * specularFactor.x;
	r1.w = dot(r2.xyz, specMapIntMask.xyz);
	r2.w = max(1, r0.w);
	r3.xyz = r0.xxx * i.texcoord4.xyz;
	r0.xzw = r0.zzz * i.texcoord1.xyz + r3.xyz;
	r0.xyz = r0.yyy * i.texcoord5.xyz + r0.xzw;
	r0.xyz = r0.xyz + 1E-05;
	r3.xyz = normalize(r0.xyz);
	r0.xw = float2(1, 0);
	if (-reflectivePower.x < r0.w) {
		r0.y = saturate(r2.w * 0.015625);
		r4.w = r0.y * -4 + 4;
		r0.yzw = 1E-05 + i.texcoord3.xyz;
		r5.xyz = normalize(r0.yzw);
		r0.y = dot(-r5.xyz, r3.xyz);
		r0.y = r0.y + r0.y;
		r0.yzw = r3.xyz * -r0.yyy + -r5.xyz;
		r0.yzw = r0.yzw + 1E-05;
		r6 = normalize(r0.yzw);
		r0.y = saturate(r6.z);
		r0.y = r0.y + 1;
		r0.y = r0.y + r0.y;
		r0.y = 1 / r0.y;
		r0.yz = r6.xy * r0.yy + 0.5;
		r4.xy = -r0.yz + 1;
		r4.z = 0;
		r4 = tex2Dlod(DynamicEnvironmentSampler, r4);
		r0.yzw = r4.xyz * r4.xyz;
		r0.yzw = r0.yzw * 16;
		r3.w = saturate(dot(r5.xyz, r3.xyz));
		r0.x = r0.x + -fresnelRolloff.x;
		r3.w = -r3.w + 1.00001;
		r4.x = r3.w * r3.w;
		r4.x = r4.x * r4.x;
		r3.w = r3.w * r4.x;
		r0.x = fresnelRolloff.x * r3.w + r0.x;
		r0.xyz = r0.xxx * r0.yzw;
	} else {
		r0.xyz = 0;
	}
	r0.xyz = r0.xyz * reflectivePower.xxx;
	r0.w = dot(r2.xyz, specMapReflectMask.xyz);
	r0.xyz = r0.www * r0.xyz;
	r0.xyz = r0.xyz * ColorCorrectTopAndPedReflectScale.www;
	r1.xyz = r1.xyz * r1.xyz;
	r2.xyz = 1E-05 + i.texcoord3.xyz;
	r4.xyz = normalize(r2.xyz);
	r0.w = saturate(r3.z * -0.5 + 0.5);
	r2.xyz = gLightAmbient0.xyz;
	r2.xyz = -r2.xyz + gLightAmbient1.xyz;
	r2.xyz = r0.www * r2.xyz + gLightAmbient0.xyz;
	r2.xyz = r2.xyz * gAmbientOcclusionEffect.yyy;
	r2.xyz = r2.xyz * i.texcoord7.xxx;
	r0.w = 1 / gAmbientOcclusionEffect.y;
	r3.w = dot(-r4.xyz, r3.xyz);
	r3.w = r3.w + r3.w;
	r4.xyz = r3.xyz * -r3.www + -r4.xyz;
	r3.x = dot(r3.xyz, -gDirectionalLight.xyz);
	r3.y = saturate(r3.x + -0.25);
	r3.y = r3.y * 1.3333334;
	r3.z = saturate(dot(-gDirectionalLight.xyz, r4.xyz));
	r3.z = r3.z + 1E-05;
	r2.w = r2.w + 1E-05;
	r4.x = pow(r3.z, r2.w);
	r2.w = saturate(r3.x * 2 + -0.5);
	r2.w = r2.w * r4.x;
	r3.xzw = gShadowMatrix[1].xyz * i.texcoord2.yyy;
	r3.xzw = i.texcoord2.xxx * gShadowMatrix[0].xyz + r3.xzw;
	r3.xzw = i.texcoord2.zzz * gShadowMatrix[2].xyz + r3.xzw;
	r3.xzw = r3.xzw + gShadowMatrix[3].xyz;
	r4.xy = r3.xz + -gShadowParam18192021.zw;
	r4.zw = r4.xx + -gCascadeXMaxThresholds.xy;
	r4.zw = (r4.zw >= 0) ? 1 : 0;
	r5.xy = -r4.xx + gCascadeXMinThresholds.xy;
	r5.zw = r4.yy + -gCascadeYMaxThresholds.xy;
	r5 = (r5 >= 0) ? 1 : 0;
	r6.xy = -r4.yy + gCascadeYMinThresholds.xy;
	r6.xy = (r6.xy >= 0) ? 1 : 0;
	r4.zw = r4.zw + r5.xy;
	r4.zw = r5.zw + r4.zw;
	r5.yz = saturate(r6.xy + r4.zw);
	r5.x = 1;
	r6.x = dot(r5.xyz, gShadowParam0123.xyz);
	r6.y = dot(r5.xyz, gShadowParam4567.xyz);
	r6.z = dot(r5.xyz, gCascadeZScales.xyz);
	r7.x = dot(r5.xyz, gShadowParam891113.xyz);
	r7.y = dot(r5.xyz, gShadowParam14151617.xyz);
	r7.z = dot(r5.xyz, gCascadeZOffsets.xyz);
	r3.xzw = r3.wxz * r6.zxy + r7.zxy;
	r3.x = saturate(r3.x);
	r5.x = -gCascadeXMinThresholds.w;
	r5.y = -gCascadeXMaxThresholds.w;
	r4.xy = saturate(abs(r4.xy) * 4 + r5.xy);
	r5.x = max(r4.x, r4.y);
	r3.x = -r3.x + 1;
	r4 = tex2D(gShadowZSamplerDir, r3.zw);
	r3.x = -r3.x + r4.x;
	r3.x = (r3.x >= 0) ? 0 : 0.33333334;
	r3.x = r5.x + r3.x;
	r3.x = r3.x + -0.4;
	r3.x = saturate(r3.x * 1.6666666);
	r3.z = r3.x * -2 + 3;
	r3.x = r3.x * r3.x;
	r3.x = r3.x * r3.z;
	r3.xzw = r3.xxx * gDirectionalColour.xyz;
	r4.xyz = r2.www * r3.xzw;
	r3.xyz = r3.yyy * r3.xzw;
	r4.xyz = r4.xyz * gDirectionalLight.www;
	r2.xyz = r2.xyz * r0.www + r3.xyz;
	r0.w = dot(r2.xyz, 0.33333334);
	r0.w = r0.w + 0.015;
	r0.xyz = r0.www * r0.xyz;
	r0.xyz = r4.xyz * r1.www + r0.xyz;
	r0.xyz = r1.xyz * r2.xyz + r0.xyz;
	o.w = globalScalars.x * i.texcoord7.w;
	r1.xyz = -gViewInverse[3].xyz + i.texcoord2.xyz;
	r0.w = saturate(-i.texcoord1.w * gDepthFxParams.z + gDepthFxParams.w);
	r1.w = -r0.w + 1;
	r0.w = r1.w * gDepthFxParams.y + r0.w;
	r1.w = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r1.w = r1.w + 1E-05;
	r1.w = abs(r1.w) + 1E-05;
	r0.w = r0.w + -0.99999;
	r2.x = pow(r1.w, r0.w);
	r0.w = r1.z * globalFogParams.x;
	r1.x = dot(r1.xyz, r1.xyz);
	r1.x = rsqrt(r1.x);
	r1.x = 1 / r1.x;
	r1.x = r1.x * globalFogParams.z;
	r1.y = -abs(r0.w) + 0.0001;
	r1.z = r0.w * -1.442695;
	r1.z = exp2(r1.z);
	r1.z = -r1.z + 1;
	r0.w = 1 / r0.w;
	r0.w = r0.w * r1.z;
	r0.w = r0.w * r1.x;
	r0.w = (r1.y >= 0) ? r1.x : r0.w;
	r0.w = r0.w * -globalFogParams.y;
	r0.w = r0.w * 1.442695;
	r0.w = saturate(exp2(r0.w));
	r0.xyz = r0.xyz * r2.xxx + -globalFogColorN.xyz;
	r0.xyz = r0.www * r0.xyz + globalFogColorN.xyz;
	r1.x = gAdrenoFXVars.x;
	r0.w = r1.x * deSatContrastGamma.x;
	r1.x = dot(r0.xyz, float3(0.2125, 0.7154, 0.0721));
	r2.xyz = lerp(r1.xxx, r0.xyz, r0.www);
	o.xyz = r2.xyz * matMaterialColorScale.xxx;

	return o;
}
