cbuffer rage_matrices : register(b0)
{
	row_major float4x4 gWorld : packoffset(c0);
	row_major float4x4 gWorldView : packoffset(c4);
	row_major float4x4 gWorldViewProj : packoffset(c8);
	row_major float4x4 gViewInverse : packoffset(c12);
};

cbuffer rage_lighting : register(b2)
{
	float4 gLightPosDir[4] : packoffset(c0);
	float4 gLightDir[4] : packoffset(c4);
	float4 gLightColor[4] : packoffset(c8);
};

cbuffer CharacterCommon : register(b4)
{
	float diffuseMod : packoffset(c0);
	float ambientMod : packoffset(c0.y);
	float SpecMapExp : packoffset(c0.z);
	float SpecExp : packoffset(c0.w);
	float SpecIntensity : packoffset(c1);
	float SpecMapIntensity : packoffset(c1.y);
	float specFresnelExp : packoffset(c1.z);
	float specFresnelMin : packoffset(c1.w);
	float specFresnelMax : packoffset(c2);
	float wrapAmount : packoffset(c2.y);
	float rimPower : packoffset(c2.z);
	float rimAmount : packoffset(c2.w);
	float ambientOcclusionContrast : packoffset(c3);
	float3 SubsurfaceColor : packoffset(c3.y);
	float SubsurfaceRollOff : packoffset(c4);
	float SubsurfaceIntensity : packoffset(c4.y);
};

SamplerState DiffuseSampler : register(s0);
Texture2D DiffuseSampler_tex : register(t0);

struct PS_IN
{
	float4 sv_position : SV_Position;
	float4 texcoord : TEXCOORD;
	float4 texcoord1 : TEXCOORD1;
	float4 texcoord2 : TEXCOORD2;
	float4 texcoord3 : TEXCOORD3;
	float4 color : COLOR;
};

float4 main(PS_IN i) : SV_Target
{
	float4 o;

	int4 r0;
	int4 r1;
	float4 r2;
	float4 r3;
	float4 r4;
	float4 r5;
	float3 r6;
	int3 r7;
	r0.xyz = asint(-(i.texcoord2.xyz) + gLightPosDir[0].xyz);
	r0.w = asint(dot(asfloat(r0.xyz), asfloat(r0.xyz)));
	r0.w = asint(sqrt(asfloat(r0.w)));
	r1.x = asint(asfloat(r0.w) / gLightPosDir[0].w);
	r0.xyz = asint(asfloat(r0.xyz) / asfloat(r0.www));
	r0.w = asint(min(asfloat(r1.x), 1));
	r0.w = asint(-(asfloat(r0.w)) + 1);
	r0.w = asint(min(asfloat(r0.w), 1));
	r1.x = asint(dot(i.texcoord.xyz, i.texcoord.xyz));
	r1.x = asint(rsqrt(asfloat(r1.x)));
	r1.xyz = asint(asfloat(r1.xxx) * i.texcoord.xyz);
	r1.w = asint(dot(asfloat(r1.xyz), asfloat(r0.xyz)));
	r2.x = -(wrapAmount) + 1;
	r1.w = asint(asfloat(r1.w) * r2.x + wrapAmount);
	r2.y = max(asfloat(r1.w), 0);
	r2.yzw = r2.yyy * gLightColor[0].xyz;
	r2.yzw = asfloat(r0.www) * r2.yzw;
	r2.yzw = r2.yzw * -(gLightColor[0].www);
	r0.w = asint(-(SubsurfaceRollOff) * 2 + asfloat(r1.w));
	r3.x = 1 / -(SubsurfaceRollOff);
	r0.w = asint(saturate(asfloat(r0.w) * r3.x));
	r3.y = asfloat(r0.w) * -2 + 3;
	r0.w = asint(asfloat(r0.w) * asfloat(r0.w));
	r0.w = asint(asfloat(r0.w) * r3.y);
	r3.y = 1 / SubsurfaceRollOff;
	r3.z = saturate(asfloat(r1.w) * r3.y);
	r3.w = r3.z * -2 + 3;
	r3.z = r3.z * r3.z;
	r3.z = r3.z * r3.w;
	r4.xyz = SubsurfaceColor.xyz * SubsurfaceIntensity;
	r5.xyz = r3.zzz * r4.xyz;
	r2.yzw = r5.xyz * asfloat(r0.www) + r2.yzw;
	r5.xyz = -(i.texcoord2.xyz) + gLightPosDir[1].xyz;
	r0.w = asint(dot(r5.xyz, r5.xyz));
	r0.w = asint(sqrt(asfloat(r0.w)));
	r5.xyz = r5.xyz / asfloat(r0.www);
	r0.w = asint(asfloat(r0.w) / gLightPosDir[1].w);
	r0.w = asint(min(asfloat(r0.w), 1));
	r0.w = asint(-(asfloat(r0.w)) + 1);
	r0.w = asint(min(asfloat(r0.w), 1));
	r3.z = dot(asfloat(r1.xyz), r5.xyz);
	r2.x = r3.z * r2.x + wrapAmount;
	r3.z = -(SubsurfaceRollOff) * 2 + r2.x;
	r3.x = saturate(r3.x * r3.z);
	r3.z = r3.x * -2 + 3;
	r3.x = r3.x * r3.x;
	r3.x = r3.x * r3.z;
	r3.y = saturate(r3.y * r2.x);
	r3.z = r3.y * -2 + 3;
	r3.y = r3.y * r3.y;
	r3.y = r3.y * r3.z;
	r3.yzw = r3.yyy * r4.xyz;
	r2.yzw = r3.yzw * r3.xxx + r2.yzw;
	r3.x = max(r2.x, 0);
	r3.xyz = r3.xxx * gLightColor[1].xyz;
	r3.xyz = asfloat(r0.www) * r3.xyz;
	r4.xyz = r3.xyz * -(gLightColor[1].www);
	r3.xyz = r3.xyz * -(gLightColor[1].www) + r2.yzw;
	r2.yzw = saturate(r2.yzw * r4.xyz);
	r2.yzw = -(r2.yzw) + r3.xyz;
	r0.w = asint(abs(i.color.w) + 0.00000999999975);
	r0.w = asint(log2(asfloat(r0.w)));
	r3.x = ambientOcclusionContrast + 0.00000999999975;
	r0.w = asint(asfloat(r0.w) * r3.x);
	r0.w = asint(exp2(asfloat(r0.w)));
	r0.w = asint(asfloat(r0.w) * i.texcoord3.w);
	r3.xyz = asfloat(r0.www) * r2.yzw;
	r2.yzw = r2.yzw * asfloat(r0.www) + i.texcoord3.xyz;
	r3.xyz = saturate(r3.xyz * i.texcoord3.xyz);
	r2.yzw = r2.yzw + -(r3.xyz);
	r3.x = diffuseMod * 1.79999995;
	r2.yzw = r2.yzw * r3.xxx;
	r3.x = i.texcoord.w;
	r3.y = i.texcoord2.w;
	r3 = DiffuseSampler_tex.Sample(DiffuseSampler, r3.xy);
	r4.xyz = r2.yzw * r3.xyz;
	r6 = -(i.texcoord2.xyz) + gViewInverse[3].xyz;
	r4.w = dot(r6.xyz, r6.xyz);
	r4.w = rsqrt(r4.w);
	r0.xyz = asint(r6.xyz * r4.www + asfloat(r0.xyz));
	r5.w = dot(asfloat(r0.xyz), asfloat(r0.xyz));
	r5.w = rsqrt(r5.w);
	r0.xyz = asint(asfloat(r0.xyz) * r5.www);
	r0.x = asint(saturate(dot(asfloat(r0.xyz), asfloat(r1.xyz))));
	r0.x = asint(asfloat(r0.x) + 0.00000999999975);
	r0.x = asint(log2(asfloat(r0.x)));
	r0.y = asint(SpecExp + 0.00000999999975);
	r0.x = asint(asfloat(r0.x) * asfloat(r0.y));
	r0.x = asint(exp2(asfloat(r0.x)));
	r7 = asint(asfloat(r0.xxx) * gLightColor[0].xyz);
	r0.x = asint(saturate(asfloat(r1.w) * 16));
	r0.z = (0 < asfloat(r1.w)) ? -1 : 0;
	r7 = asint(asfloat(r0.xxx) * asfloat(r7.xyz));
	r7 = r0.zzz & r7.xyz;
	r5.xyz = r6.xyz * r4.www + r5.xyz;
	r6 = r4.www * r6.xyz;
	r0.x = asint(dot(r6.xyz, asfloat(r1.xyz)));
	r0.z = asint(dot(r5.xyz, r5.xyz));
	r0.z = asint(rsqrt(asfloat(r0.z)));
	r5.xyz = asfloat(r0.zzz) * r5.xyz;
	r0.z = asint(saturate(dot(r5.xyz, asfloat(r1.xyz))));
	r0.z = asint(asfloat(r0.z) + 0.00000999999975);
	r0.z = asint(log2(asfloat(r0.z)));
	r0.y = asint(asfloat(r0.z) * asfloat(r0.y));
	r0.y = asint(exp2(asfloat(r0.y)));
	r1.xyz = asint(asfloat(r0.yyy) * gLightColor[1].xyz);
	r0.y = asint(saturate(r2.x * 16));
	r0.z = (0 < r2.x) ? -1 : 0;
	r1.xyz = asint(asfloat(r1.xyz) * asfloat(r0.yyy) + asfloat(r7.xyz));
	r1.xyz = (r0.zzz != 0) ? r1.xyz : r7.xyz;
	r0.y = asint(min(abs(asfloat(r0.x)), 1));
	r0.x = asint(max(asfloat(r0.x), 0));
	r0.x = asint(-(asfloat(r0.x)) + 1);
	r0.x = asint(abs(asfloat(r0.x)) + 0.00000999999975);
	r0.x = asint(log2(asfloat(r0.x)));
	r0.y = asint(-(asfloat(r0.y)) + 1.00001001);
	r0.y = asint(log2(asfloat(r0.y)));
	r0.z = asint(specFresnelExp + 0.00000999999975);
	r0.y = asint(asfloat(r0.y) * asfloat(r0.z));
	r0.y = asint(exp2(asfloat(r0.y)));
	r0.z = asint(-(specFresnelMin) + specFresnelMax);
	r0.y = asint(asfloat(r0.y) * asfloat(r0.z) + specFresnelMin);
	r0.z = asint(r3.w * asfloat(r0.y));
	r0.z = asint(asfloat(r0.w) * asfloat(r0.z));
	r0.z = asint(asfloat(r0.z) * SpecIntensity);
	r1.xyz = asint(asfloat(r0.zzz) * asfloat(r1.xyz));
	r4.xyz = saturate(asfloat(r1.xyz) * r4.xyz);
	r1.xyz = asint(r3.xyz * r2.yzw + asfloat(r1.xyz));
	r1.xyz = asint(-(r4.xyz) + asfloat(r1.xyz));
	r0.z = asint(rimPower + 0.00000999999975);
	r0.x = asint(asfloat(r0.x) * asfloat(r0.z));
	r0.x = asint(exp2(asfloat(r0.x)));
	r0.x = asint(asfloat(r0.x) * rimAmount);
	r0.x = asint(asfloat(r0.w) * asfloat(r0.x));
	r0.z = asint(asfloat(r0.y) * asfloat(r0.x));
	r0.xyw = asint(asfloat(r0.xxx) * asfloat(r0.yyy) + asfloat(r1.xyz));
	r1.xyz = asint(saturate(asfloat(r0.zzz) * asfloat(r1.xyz)));
	o.xyz = asfloat(r0.xyw) + -(asfloat(r1.xyz));
	o.w = 1;

	return o;
}
